        factor = 0

    action = 4.6 * pole_angle + 2.8 * pole_angular_velocity + 0.7 * cart_position + 4.6 * pole_angle * factor
    action = max(-3.0, min(3.0, action))
    
    return action if abs(pole_angle) < 0.2 and abs(cart_velocity) < float('inf') and abs(cart_position) < float('inf') and abs(pole_angular_velocity) < float('inf') else random.uniform(-3, 3)

