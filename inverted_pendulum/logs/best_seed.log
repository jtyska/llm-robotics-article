def compute_action(pole_angle, angular_velocity, cart_position):
    # Define the threshold and factor for critical moments
    angle_threshold = 0.12
    velocity_threshold = 0.3
    
    # Compute the basic action
    base_action = 2.5 * pole_angle + 1.5 * angular_velocity + 0.4 * cart_position
    
    # Check if we are in a critical moment
    if abs(pole_angle) > angle_threshold or abs(angular_velocity) > velocity_threshold:
        factor = (abs(pole_angle) - angle_threshold) / (angle_threshold * 0.5)
        factor = min(factor, 1.0)
        adjustment = 3.0 * pole_angle * factor
        action = base_action + adjustment
    else:
        action = base_action
    
    # Smooth the action to avoid overcorrection
    smoothed_action = 0.8 * action + 0.2 * previous_action
    
    # Ensure the action is within bounds
    action = max(-3.0, min(3.0, smoothed_action))
    
    return action

# Initialize previous_action
