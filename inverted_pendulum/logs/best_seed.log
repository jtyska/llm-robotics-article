import random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if abs(pole_angle) > 0.1 or abs(pole_angular_velocity) > 0.25:
        angle_factor = (abs(pole_angle) - 0.1) / (0.1 * 0.25)
        velocity_factor = (abs(pole_angular_velocity) - 0.25) / (0.25 * 0.25)
        factor = min(angle_factor + velocity_factor, 2.5)
    else:
        factor = 0

    action = 4.5 * pole_angle + 3.0 * pole_angular_velocity + 1.0 * cart_position + 4.5 * pole_angle * factor
    action = max(-3.0, min(3.0, action))
    
    return action if -3.0 <= action <= 3.0 else random.uniform(-3, 3)

