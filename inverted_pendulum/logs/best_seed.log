# Define initial parameters
angle_threshold = 0.1
velocity_threshold = 0.25
smoothing_factor = 0.8  # Introduce a smoothing factor to gradually adjust actions

# Define weights
pole_angle_weight = 4.5
angular_velocity_weight = 2.7
cart_position_weight = 0.6
corrective_factor_weight = 4.5

def calculate_action(pole_angle, angular_velocity, cart_position, prev_action):
    # Determine if corrective action is needed
    if abs(pole_angle) > angle_threshold or abs(angular_velocity) > velocity_threshold:
        angle_factor = (abs(pole_angle) - angle_threshold) / (angle_threshold * 0.3)
        velocity_factor = (abs(angular_velocity) - velocity_threshold) / (velocity_threshold * 0.3)
        factor = min(angle_factor + velocity_factor, 2.5)
    else:
        factor = 0

    # Calculate the base action
    base_action = pole_angle_weight * pole_angle + angular_velocity_weight * angular_velocity + cart_position_weight * cart_position + corrective_factor_weight * pole_angle * factor

    # Apply smoothing to the action
    smoothed_action = prev_action * (1 - smoothing_factor) + base_action * smoothing_factor

    # Ensure the action is within the allowed range
    action = max(-3.0, min(3.0, smoothed_action))
    
    return action

# Initialize previous action
