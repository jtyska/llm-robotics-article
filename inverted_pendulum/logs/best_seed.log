def updated_strategy(cart_position, pole_angle, angular_velocity):
    # Constants for force calculation
    k_pole = 2.5  # Proportional gain for pole angle
    k_ang_vel = 1.5  # Proportional gain for angular velocity
    k_cart = 0.5  # Proportional gain for cart position
    
    # Thresholds for aggressive action
    threshold_angle = 0.12
    threshold_angular_velocity = 0.3
    
    # Determine the force based on current state
    if abs(pole_angle) > threshold_angle or abs(angular_velocity) > threshold_angular_velocity:
        # Apply maximum force to counteract large deviations
        return -3.0 if pole_angle < 0 else 3.0
    else:
        # Calculate a linear combination of the current state
        force = k_pole * pole_angle + k_ang_vel * angular_velocity + k_cart * cart_position
        # Ensure the force is within the allowed range
        return max(-3.0, min(3.0, force))
```

