import random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if abs(pole_angle) > 0.15 or abs(pole_angular_velocity) > 0.3:
        angle_factor = (abs(pole_angle) - 0.15) / (0.15 * 0.3)
        velocity_factor = (abs(pole_angular_velocity) - 0.3) / (0.3 * 0.3)
        factor = min(angle_factor + velocity_factor, 2.8)
    else:
        factor = 0

    action = 4.4 * pole_angle + 2.6 * pole_angular_velocity + 0.7 * cart_position + 4.4 * pole_angle * factor
    action = max(-3.0, min(3.0, action))
    
    return action if abs(pole_angle) < 0.2 and abs(cart_velocity) < float('inf') and abs(cart_position) < float('inf') and abs(pole_angular_velocity) < float('inf') else random.uniform(-3, 3)

