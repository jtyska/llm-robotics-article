        smooth_factor = min(1, max(0, (abs(pole_angle) - 0.12) / 0.05 + (abs(pole_angular_velocity) - 0.3) / 0.1))
        action = base_force * (1 + smooth_factor)
    action = max(-3.0, min(3.0, action))
    return action

