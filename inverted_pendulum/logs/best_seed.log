import random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if abs(pole_angle) > 0.1 or abs(pole_angular_velocity) > 0.2:
        factor = (abs(pole_angle) - 0.1) / (0.1 * 0.5)
        factor = min(factor, 1.0)
        action = 3.0 * pole_angle + 1.5 * pole_angular_velocity + 0.5 * cart_position + 2.0 * pole_angle * factor
    else:
        action = 3.0 * pole_angle + 1.5 * pole_angular_velocity + 0.5 * cart_position

    action = max(-3.0, min(3.0, action))
    return action if action is not None else random.uniform(-3, 3)

