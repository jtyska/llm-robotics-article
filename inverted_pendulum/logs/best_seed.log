import random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if pole_angle > 0.05 and pole_angular_velocity > 0:
        action = -2.0 * (abs(pole_angle) + abs(pole_angular_velocity) / 4)
    elif pole_angle < -0.05 and pole_angular_velocity < 0:
        action = 2.0 * (abs(pole_angle) + abs(pole_angular_velocity) / 4)
    elif cart_position > 0.3:
        action = -1.0
    elif cart_position < -0.3:
        action = 1.0
    else:
        action = 0.5 * (pole_angle + pole_angular_velocity / 2)
    return action if action is not None else random.uniform(-3, 3)

