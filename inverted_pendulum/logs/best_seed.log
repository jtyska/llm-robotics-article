import random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if abs(pole_angle) > 0.15 or abs(pole_angular_velocity) > 0.7:
        if pole_angle > 0:
            return -3.0
        else:
            return 3.0
    else:
        force = 2.5 * pole_angle + 1.2 * pole_angular_velocity + 0.6 * cart_position
        if force < -3.0:
            return -3.0
        elif force > 3.0:
            return 3.0
        else:
            return force
    return random.uniform(-3, 3)

