import random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if abs(pole_angle) > 0.1 or abs(pole_angular_velocity) > 0.3:
        angle_factor = (abs(pole_angle) - 0.1) / (0.1 * 0.3)
        velocity_factor = (abs(pole_angular_velocity) - 0.3) / (0.3 * 0.3)
        factor = min(angle_factor + velocity_factor, 2.5)
    else:
        factor = 0

    action = 4.5 * pole_angle + 2.5 * pole_angular_velocity + 0.6 * cart_position + 4.5 * pole_angle * factor
    bias = 0.1 if abs(cart_position) > 1.0 else 0.0
    action += bias
    action = max(-3.0, min(3.0, action))
    
    return action

