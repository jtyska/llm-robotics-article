import random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if abs(pole_angle) > 0.12 or abs(pole_angular_velocity) > 0.3:
        factor = (abs(pole_angle) - 0.12) / (0.12 * 0.75)
        factor = min(factor, 1.0)
        action = 2.0 * pole_angle + 1.0 * pole_angular_velocity + 0.3 * cart_position + 2.0 * pole_angle * factor
    else:
        action = 2.0 * pole_angle + 1.0 * pole_angular_velocity + 0.3 * cart_position

    action = max(-3.0, min(3.0, action))
    return action if action is not None else random.uniform(-3, 3)

