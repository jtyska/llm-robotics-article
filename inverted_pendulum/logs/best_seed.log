import numpy as np
import random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if abs(pole_angle) > 0.15 or abs(pole_angular_velocity) > 0.3:
        angle_factor = (abs(pole_angle) - 0.15) / (0.15 * 0.3)
        velocity_factor = (abs(pole_angular_velocity) - 0.3) / (0.3 * 0.3)
        factor = min(angle_factor + velocity_factor, 2.0)
    else:
        factor = 0

    bias = 0.1 * np.sign(pole_angle)
    damping = -0.05 * pole_angular_velocity

    action = 3.7 * pole_angle + 2.2 * pole_angular_velocity + 0.2 * cart_position + 3.7 * pole_angle * factor + bias + damping
    action = max(-3.0, min(3.0, action))
    
    return action if np.isfinite(action) else random.uniform(-3, 3)

