import random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if abs(pole_angle) > 0.12 or abs(pole_angular_velocity) > 0.3:
        action = -3.0 if pole_angle < 0 else 3.0
    else:
        force = 2.5 * pole_angle + 1.5 * pole_angular_velocity + 0.4 * cart_position
        action = max(-3.0, min(3.0, force))
    return action if abs(pole_angle) < 0.2 and all(isinstance(x, (int, float)) and x == x for x in [cart_position, pole_angle, cart_velocity, pole_angular_velocity]) else random.uniform(-3, 3)

