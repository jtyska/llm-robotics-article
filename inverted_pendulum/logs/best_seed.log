import numpy as np
import random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if abs(pole_angle) > 0.15 or abs(pole_angular_velocity) > 0.3:
        angle_factor = (abs(pole_angle) - 0.15) / (0.15 * 0.3)
        velocity_factor = (abs(pole_angular_velocity) - 0.3) / (0.3 * 0.3)
        factor = min(angle_factor + velocity_factor, 2.5)
    else:
        factor = 0

    bias = 0.1 * np.sign(pole_angle)
    cart_position_penalty = 0.1 * cart_position

    action = 3.5 * pole_angle + 2.0 * pole_angular_velocity + 3.5 * pole_angle * factor + bias + cart_position_penalty
    action += 0.1 * cart_position  # Damping for cart position
    action += -0.05 * abs(cart_position)  # Additional penalty for extreme cart positions

    return max(-3.0, min(3.0, action))

