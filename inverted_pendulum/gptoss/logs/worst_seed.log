import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Helper clamp
    def clamp(val, low, high):
        return max(low, min(high, val))
    
    # Check finiteness
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if abs(theta) <= 0.02:
        u_cart = -(0.8 * x + 0.4 * x_dot)
        u_angle = -(0.5 * theta + 0.2 * theta_dot)
        u_raw = u_cart + u_angle
        action = clamp(3 * math.tanh(u_raw / 3), -3.0, 3.0)
        return action
    else:
        scale = 1 + (abs(theta) - 0.02) / (0.20 - 0.02) * (3 - 1)
        scale = clamp(scale, 1.0, 3.0)
        K_theta = 1.0 * scale
        K_theta_dot = 0.5 * scale
        u_angle = -(K_theta * theta + K_theta_dot * theta_dot)
        u_cart = -(0.8 * x + 0.4 * x_dot) - 0.001 * x
        u_raw = u_angle + u_cart
        action = clamp(3 * math.tanh(u_raw / 3), -3.0, 3.0)
        return action

    # Default random action (should not be reached)
    return random.uniform(-3, 3)
