def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    if abs(theta) >= 0.18:
        return -3.0 * (1 if theta > 0 else -1 if theta < 0 else 0)

    if abs(theta) <= 0.02:
        raw = -(1.0 * x + 0.5 * x_dot)
        return max(-3.0, min(3.0, raw))

    alpha = (abs(theta) - 0.02) / (0.18 - 0.02)
    force = -3.0 * (1 if theta > 0 else -1 if theta < 0 else 0) * alpha
    if math.isfinite(force):
        return force

    return random.uniform(-3, 3)
