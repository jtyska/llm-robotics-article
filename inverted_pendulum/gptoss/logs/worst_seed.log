import random, math

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0
    elif abs(theta) >= 0.15:
        return -3.0 * (1 if theta > 0 else -1)
    elif abs(theta) <= 0.02:
        raw = -(1.0 * x + 0.5 * x_dot)
        return max(min(raw, 3.0), -3.0)
    else:
        scale = 1.0 + (abs(theta) - 0.02) / (0.15 - 0.02) * 1.5
        base = -(1.0 * x + 0.5 * x_dot)
        pole = -(8.0 * theta + 4.0 * theta_dot)
        raw = scale * (base + pole)
        return max(min(raw, 3.0), -3.0)

    return random.uniform(-3.0, 3.0)
