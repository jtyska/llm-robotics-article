import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Constants
    Kθ = 12.0
    Kθdot = 2.0
    Kx = 0.8
    Kxdot = 0.5
    θ_small = 0.01
    θ_mid = 0.05
    θ_limit = 0.18
    scale_min = 1.0
    scale_max = 2.5
    scale_slope = (scale_max - scale_min) / (θ_limit - θ_mid)
    force_deadzone = 0.05

    def clip(val, lo, hi):
        return max(lo, min(hi, val))

    def sign(v):
        return 1.0 if v > 0 else -1.0 if v < 0 else 0.0

    # Rule 1: Non‑finite state
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Rule 2: Hard stop
    if abs(pole_angle) >= θ_limit:
        return -sign(pole_angle) * 3.0

    # Rule 3: Very small angle (pure position control)
    if abs(pole_angle) <= θ_small:
        u = -(Kx * cart_position + Kxdot * cart_velocity)
        force = clip(u, -3.0, 3.0)
        if abs(force) < force_deadzone:
            force = 0.0
        return force

    # Rule 4: Small‑to‑moderate angle (mixed control)
    if θ_small < abs(pole_angle) <= θ_mid:
        u_angle = -(Kθ * pole_angle + Kθdot * pole_angular_velocity)
        u_pos = -(Kx * cart_position + Kxdot * cart_velocity) * 0.3
        u = u_angle + u_pos
        force = clip(u, -3.0, 3.0)
        if abs(force) < force_deadzone:
            force = 0.0
        return force

    # Rule 5: Moderate‑to‑large angle (scaled angle PD)
    if θ_mid < abs(pole_angle) < θ_limit:
        u_angle = -(Kθ * pole_angle + Kθdot * pole_angular_velocity)
        scale = scale_min + scale_slope * (abs(pole_angle) - θ_mid)
        scale = clip(scale, scale_min, scale_max)
        u_pos = -(Kx * cart_position + Kxdot * cart_velocity) * 0.05
        u = scale * u_angle + u_pos
        force = clip(u, -3.0, 3.0)
        if abs(force) < force_deadzone:
            force = 0.0
        return force

    # Default random action
    return random.uniform(-3.0, 3.0)
