// ------------------------------------------------------------------
// Parameters (tuned empirically)
// ------------------------------------------------------------------
Kθ          = 12.0      // angle proportional gain
Kθdot       = 2.0       // angle derivative gain
Kx          = 0.8       // cart‑position proportional gain
Kxdot       = 0.5       // cart‑velocity proportional gain

θ_small     = 0.01      // rad  – pure position control zone
θ_mid       = 0.05      // rad  – mixed control zone
θ_limit     = 0.18      // rad  – hard stop (bang‑bang)

