import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Initialize force as None to detect if no rule applies
    force = None

    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    else:
        abs_theta = abs(pole_angle)

        if abs_theta <= 0.05:
            tilt_norm = 0.0
        elif abs_theta >= 0.20:
            tilt_norm = 1.0
        else:
            tilt_norm = (abs_theta - 0.05) / (0.20 - 0.05)

        blend = tilt_norm * tilt_norm

        Kp_cart = 0.30 + (1.20 - 0.30) * blend
        Kd_cart = 0.45 + (2.00 - 0.45) * blend
        Kp_pole = 2.00 + (9.00 - 2.00) * blend
        Kd_pole = 0.80 + (5.00 - 0.80) * blend

        pole_pd = -(Kp_pole * pole_angle + Kd_pole * pole_angular_velocity)
        cart_pd = -(Kp_cart * cart_position + Kd_cart * cart_velocity)
        gravity_ff = 9.81 * math.sin(pole_angle)

        u_raw = pole_pd + cart_pd + gravity_ff
        u_soft = 3.0 * math.tanh(u_raw / 3.0)

        if u_soft > 3.0:
            force = 3.0
        elif u_soft < -3.0:
            force = -3.0
        else:
            force = u_soft

        if abs(force) < 0.02:
            force = 0.0

    if force is None:
        return random.uniform(-3.0, 3.0)
    return force
