import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    if abs(theta) >= 0.20:
        if theta > 0:
            sign = 1.0
        elif theta < 0:
            sign = -1.0
        else:
            sign = 0.0
        return -3.0 * sign

    # compute gains
    g_theta = 1.0
    if abs(theta) > 0.02:
        g_theta = 1.0 + (abs(theta) - 0.02) / (0.18 - 0.02)

    g_cart = 1.0
    if abs(theta) > 0.02:
        g_cart = 1.0 - 0.7 * (abs(theta) - 0.02) / (0.18 - 0.02)

    pole_term = g_theta * (10.0 * theta + 2.5 * theta_dot)
    cart_term = g_cart * (1.0 * x + 0.5 * x_dot)
    raw_force = -(pole_term + cart_term)

    force = max(-3.0, min(3.0, raw_force))
    return force

    # default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
