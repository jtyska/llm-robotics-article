import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    if abs(pole_angle) >= 0.20:
        sign = 1.0 if pole_angle > 0 else -1.0 if pole_angle < 0 else 0.0
        return -sign * 3.0
    theta = pole_angle
    theta_dot = pole_angular_velocity
    x = cart_position
    x_dot = cart_velocity

    theta_abs = abs(theta)
    scale_angle = 1.0 + theta_abs * (1.0 / 0.18)
    if scale_angle < 1.0:
        scale_angle = 1.0
    if scale_angle > 2.0:
        scale_angle = 2.0

    u_angle = -(30.0 * theta + 10.0 * theta_dot)
    u_cart = -(1.0 * x + 0.5 * x_dot)

    force_raw = scale_angle * u_angle + u_cart
    force = 3.0 * math.tanh(force_raw / 3.0)
    return force
    return random.uniform(-3, 3)
