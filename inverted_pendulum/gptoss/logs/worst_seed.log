import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # initialize persistent integral term
    if not hasattr(get_action, "theta_int"):
        get_action.theta_int = 0.0

    # finite check
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # tilt_raw computation
    denom = 0.18 - 0.05
    tilt_raw = (abs(theta) - 0.05) / denom
    if tilt_raw < 0:
        tilt_raw = 0.0
    elif tilt_raw > 1:
        tilt_raw = 1.0

    g = tilt_raw * tilt_raw

    Kp_theta = 12.0 + 30.0 * g
    Kd_theta = 5.0 + 15.0 * g

    # integral update with clamping
    get_action.theta_int = (1.0 - 0.003) * get_action.theta_int + 0.003 * theta
    if get_action.theta_int > 0.2:
        get_action.theta_int = 0.2
    elif get_action.theta_int < -0.2:
        get_action.theta_int = -0.2

    Ki_theta = 0.6 * g
    int_effort = -Ki_theta * get_action.theta_int

    pole_effort = -Kp_theta * theta - Kd_theta * theta_dot + int_effort

    Kp_cart = 0.12 * (1.0 - g)
    Kd_cart = 0.025 * (1.0 - g)
    cart_effort = -Kp_cart * x - Kd_cart * x_dot

    centre_bias = -0.05 * tilt_raw * x

    force_raw = pole_effort + cart_effort + centre_bias

    if force_raw > 3.0:
        force = 3.0
    elif force_raw < -3.0:
        force = -3.0
    else:
        force = force_raw

    return force if math.isfinite(force) else random.uniform(-3.0, 3.0)
