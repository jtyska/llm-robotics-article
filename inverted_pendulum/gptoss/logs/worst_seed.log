import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    def is_finite(x):
        return math.isfinite(x)
    def clamp(v, lo, hi):
        return max(min(v, hi), lo)
    def sign(x):
        return 1.0 if x > 0 else -1.0 if x < 0 else 0.0

    if not (is_finite(cart_position) and is_finite(cart_velocity) and is_finite(pole_angle) and is_finite(pole_angular_velocity)):
        return 0.0
    elif abs(pole_angle) >= 0.18:
        force = clamp(-sign(pole_angle) * 3.0, -3.0, 3.0)
        return force
    elif abs(pole_angle) <= 0.02:
        raw = -(1.0 * cart_position + 0.5 * cart_velocity)
        force = clamp(raw, -3.0, 3.0)
        return force
    else:
        u_angle = -(10.0 * pole_angle + 2.5 * pole_angular_velocity)
        scale = 1.0 + (abs(pole_angle) - 0.02) / (0.18 - 0.02)
        raw = scale * u_angle
        force = clamp(raw, -3.0, 3.0)
        return force
    # default random action
    return random.uniform(-3.0, 3.0)
