import math, random

def clamp(value, low, high):
    return max(low, min(high, value))

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(theta) and math.isfinite(x_dot) and math.isfinite(theta_dot)):
        return 0.0

    if abs(theta) >= 0.18:
        sign = -1 if theta > 0 else (1 if theta < 0 else 0)
        force = clamp(-sign * 3.0, -3.0, 3.0)
        return force

    if abs(theta) <= 0.02:
        force = clamp(-(0.9 * x + 0.3 * x_dot), -3.0, 3.0)
        return force

    if 0.02 < abs(theta) < 0.18:
        u_angle = -(12.0 * theta + 3.0 * theta_dot) - 0.2 * x_dot
        scale = 1.0 + (abs(theta) - 0.02) / (0.18 - 0.02)
        scale = clamp(scale, 1.0, 2.5)
        force = clamp(scale * u_angle, -3.0, 3.0)
        return force

    return random.uniform(-3, 3)
