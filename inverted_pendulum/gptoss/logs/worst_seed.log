import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    tilt_raw = (abs(theta) - 0.04) / (0.20 - 0.04)
    if tilt_raw < 0.0:
        tilt_norm = 0.0
    elif tilt_raw > 1.0:
        tilt_norm = 1.0
    else:
        tilt_norm = tilt_raw

    gain_factor = tilt_norm * tilt_norm

    Kp_theta = 8.0 + (35.0 - 8.0) * gain_factor
    Kd_theta = 1.0 + (5.0 - 1.0) * gain_factor
    Kp_x = 0.2 + (1.0 - 0.2) * gain_factor
    Kd_x = 0.05 + (0.2 - 0.05) * gain_factor

    if x > 0.5:
        center_bias = 0.5 * 0.3
    elif x < -0.5:
        center_bias = -0.5 * 0.3
    else:
        center_bias = x * 0.3

    u = -(Kp_theta * theta
          + Kd_theta * theta_dot
          + Kp_x * (x + center_bias)
          + Kd_x * x_dot)

    if u > 3.0:
        force = 3.0
    elif u < -3.0:
        force = -3.0
    else:
        force = u

    return force

    # fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
