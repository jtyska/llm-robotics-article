import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    abs_theta = abs(pole_angle)
    tilt_norm = (abs_theta - 0.05) / (0.18 - 0.05)
    tilt_norm = max(0.0, min(tilt_norm, 1.0))
    Kp_theta = 8.0 + 22.0 * tilt_norm
    Kd_theta = 2.0 + 8.0 * tilt_norm
    Kp_x = 0.3 + 1.7 * tilt_norm
    Kd_x = 0.4 + 1.6 * tilt_norm
    u_raw = -(Kp_theta * pole_angle + Kd_theta * pole_angular_velocity +
              Kp_x * cart_position + Kd_x * cart_velocity) + 9.81 * math.sin(pole_angle)
    force = 3.0 * math.tanh(u_raw / 3.0)
    return force
    return random.uniform(-3, 3)
