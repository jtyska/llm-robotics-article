def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    if not hasattr(get_action, "theta_int"):
        get_action.theta_int = 0.0
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity
    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0
    tilt_raw = (abs(theta) - 0.05) / (0.20 - 0.05)
    tilt_raw = max(0.0, min(tilt_raw, 1.0))
    if tilt_raw <= 0.5:
        g_low = tilt_raw * tilt_raw
        g_high = 0.0
    else:
        g_low = 0.25
        g_high = (tilt_raw - 0.5) * (tilt_raw - 0.5)
    Kp_theta = 8.0 + 32.0 * g_low + 80.0 * g_high
    Kd_theta = 1.5 + 8.0 * g_low + 20.0 * g_high
    Ki_theta = 0.4 * g_low
    theta_dot_s = theta_dot
    if abs(theta) < 0.12:
        get_action.theta_int = get_action.theta_int + theta * 0.003
        get_action.theta_int = max(-0.2, min(get_action.theta_int, 0.2))
    int_effort = -Ki_theta * get_action.theta_int
    pole_effort = -Kp_theta * theta - Kd_theta * theta_dot_s + int_effort
    Kp_cart = 0.10 * (1.0 - tilt_raw)
    Kd_cart = 0.025 * (1.0 - tilt_raw)
    cart_effort = -Kp_cart * x - Kd_cart * x_dot
    centre_bias = -0.07 * tilt_raw * x
    if abs(theta) > 0.15:
        pole_effort = pole_effort * 1.5
    force_raw = pole_effort + cart_effort + centre_bias
    scale = 3.0 / 12.0
    force = 3.0 * math.tanh(force_raw * scale)
    force = max(-3.0, min(force, 3.0))
    return force
    return random.uniform(-3.0, 3.0)
