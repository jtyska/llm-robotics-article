import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0
    elif abs(theta) >= 0.20:
        sign = 1.0 if theta > 0 else -1.0
        return -3.0 * sign
    else:
        raw = -(12.0 * theta + 8.0 * theta_dot + 1.0 * x + 0.5 * x_dot)
        if abs(raw) < 0.05:
            raw = 0.0
        force = max(min(raw, 3.0), -3.0)
        return force

    return random.uniform(-3.0, 3.0)
