def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        force = 0.0
    else:
        raw = -(1.0 * x + 0.5 * x_dot + 10.0 * theta + 2.5 * theta_dot)
        scale = 1.0 + 0.5 * (abs(theta) / 0.18)
        if scale > 1.5:
            scale = 1.5
        raw = raw * scale
        if abs(theta) > 0.15:
            raw = raw - 1.5 * (1 if theta > 0 else -1 if theta < 0 else 0)
        if raw > 3.0:
            force = 3.0
        elif raw < -3.0:
            force = -3.0
        else:
            force = raw

    if 'force' in locals():
        return force
    return random.uniform(-3, 3)
