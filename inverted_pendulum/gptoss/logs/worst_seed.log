def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    if not hasattr(get_action, "x_int"):
        get_action.x_int = 0.0
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    theta = pole_angle
    theta_dot = pole_angular_velocity
    x = cart_position
    x_dot = cart_velocity
    abs_theta = abs(theta)
    if abs_theta <= 0.05:
        tilt_norm = 0.0
    elif abs_theta >= 0.18:
        tilt_norm = 1.0
    else:
        tilt_norm = (abs_theta - 0.05) / (0.18 - 0.05)
    Kp_theta = 4.0 + 3.0 * tilt_norm
    Kd_theta = 2.5 + 2.0 * tilt_norm
    pole_effort = -(Kp_theta * math.sin(theta) + Kd_theta * theta_dot)
    get_action.x_int = max(min(get_action.x_int + x * 0.02, 2.0), -2.0)
    cart_effort = -(0.20 * x + 0.05 * get_action.x_int)
    vel_damp = -0.03 * x_dot
    gravity_ff = 0.5 * 9.81 * math.sin(theta)
    raw_force = pole_effort + cart_effort + vel_damp + gravity_ff
    force = 3.0 * math.tanh(0.45 * raw_force)
    if force > 3.0:
        force = 3.0
    if force < -3.0:
        force = -3.0
    return force
    return random.uniform(-3, 3)
