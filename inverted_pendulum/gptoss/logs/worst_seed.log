### **New Strategy (Full‑state PD with gain‑scheduling & constant cart term)**

```
IF NOT (isfinite(x) AND isfinite(xdot) AND isfinite(theta) AND isfinite(thetadot))
    THEN F = 0
ELSE
    # ----- 1.  Dead‑zone for the pole (almost upright) -----
    IF abs(theta) <= 0.02
        THEN
            # keep the cart centred with a very small force
            kp_x   = 0.5
            kd_x   = 0.2
            F = -(kp_x * x + kd_x * xdot)          # magnitude < 0.5 N normally
    ELSE
        # ----- 2.  Gain‑scheduling factor (keep command inside limits) -----
        # Desired pole PD gain (large when pole is near vertical, reduced when far)
        kp_theta_base = 15.0
        kd_theta_base = 3.5

        # Scale down proportionally to the angle magnitude (max gain at |θ|=0.02)
        g = min(1.0, 0.04 / abs(theta))           # 0.04 rad ≈ 2× dead‑zone

        kp_theta = kp_theta_base * g
        kd_theta = kd_theta_base * g

        # ----- 3.  Full‑state PD (pole + cart) -----
        kp_x   = 0.8
        kd_x   = 0.4

        F_angle = -(kp_theta * theta + kd_theta * thetadot)
        F_cart  = -(kp_x * x + kd_x * xdot)

        # ----- 4.  Small bias to keep the cart from drifting far -----
        # If the cart is already >0.25 m from centre we add a stronger pull
        IF abs(x) > 0.25
            THEN extra = 0.6 * sign(x) * (abs(x) - 0.25)
            ELSE extra = 0
        ENDIF

        F = F_angle + 0.3 * F_cart - extra
    ENDIF
ENDIF

# ----- 5.  Clip to the actuator limits -----
IF F > 3.0  THEN F = 3.0
IF F < -3.0 THEN F = -3.0
```

