import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(theta) and math.isfinite(x_dot) and math.isfinite(theta_dot)):
        return 0.0

    if abs(theta) >= 0.18:
        sign = 1.0 if theta > 0 else -1.0 if theta < 0 else 0.0
        return -sign * 3.0

    if abs(theta) <= 0.02:
        scale = 1.0
    else:
        scale = 1.0 + (abs(theta) - 0.02) * (2.0 - 1.0) / (0.18 - 0.02)

    if scale > 2.0:
        scale = 2.0
    if scale < 1.0:
        scale = 1.0

    u_angle = -(12.0 * theta + 4.0 * theta_dot)
    u_cart = -(1.0 * x + 0.5 * x_dot)
    raw_force = scale * u_angle + u_cart
    force = 3.0 * math.tanh(raw_force / 3.0)
    return force

    # default random action (unreachable with current rules)
    return random.uniform(-3.0, 3.0)
