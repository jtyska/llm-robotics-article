import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    xdot = cart_velocity
    thetadot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(xdot) and math.isfinite(theta) and math.isfinite(thetadot)):
        return 0.0

    F = None
    if abs(theta) <= 0.02 and abs(x) <= 0.02:
        F = 0.0
    elif abs(theta) <= 0.07:
        F = -(0.9 * x + 0.4 * xdot)
    elif abs(theta) <= 0.12:
        F = -(10.0 * theta + 2.5 * thetadot) - (0.6 * x + 0.3 * xdot)
    else:
        F = -(14.0 * theta + 3.5 * thetadot) - (0.8 * x + 0.4 * xdot)

    if F is not None:
        if F > 3.0:
            F = 3.0
        if F < -3.0:
            F = -3.0
        return F

    return random.uniform(-3.0, 3.0)
