import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non-finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Helper for sign
    def sign(x):
        return 1.0 if x > 0 else -1.0 if x < 0 else 0.0

    # Rule: large angle deviation
    if abs(pole_angle) >= 0.20:
        return -3.0 * sign(pole_angle)

    # Rule: near upright
    if abs(pole_angle) <= 0.02:
        raw_force = -(0.5 * cart_position + 0.1 * cart_velocity)
        return max(-3.0, min(3.0, raw_force))

    # General case
    raw_force = -(8.0 * pole_angle + 2.0 * pole_angular_velocity +
                  0.5 * cart_position + 0.1 * cart_velocity)
    return max(-3.0, min(3.0, raw_force))

    # Fallback random action (should never be reached)
    return random.uniform(-3.0, 3.0)
