def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity
    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0
    tilt_norm = (abs(theta) - 0.05) / (0.18 - 0.05)
    if tilt_norm < 0.0:
        tilt_norm = 0.0
    elif tilt_norm > 1.0:
        tilt_norm = 1.0
    Kp_pole = 2.0 + (7.0 - 2.0) * tilt_norm
    Kd_pole = 0.8 + (4.0 - 0.8) * tilt_norm
    Kp_cart = 0.30
    Kd_cart = 0.45
    pole_pd = -(Kp_pole * math.sin(theta) + Kd_pole * theta_dot)
    cart_pd = -(Kp_cart * x + Kd_cart * x_dot)
    gravity_ff = 9.81 * math.sin(theta)
    u_raw = pole_pd + cart_pd + gravity_ff
    force_raw = 3.0 * math.tanh(u_raw / 3.0)
    if force_raw > 3.0:
        force = 3.0
    elif force_raw < -3.0:
        force = -3.0
    else:
        force = force_raw
    return force
    return random.uniform(-3, 3)
