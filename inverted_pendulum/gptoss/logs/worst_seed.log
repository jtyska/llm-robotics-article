def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    dt = 0.02
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    tilt_norm = (abs(pole_angle) - 0.05) / (0.18 - 0.05)
    if tilt_norm < 0.0:
        tilt_norm = 0.0
    elif tilt_norm > 1.0:
        tilt_norm = 1.0
    Kp_pole = 2.0 + (7.0 - 2.0) * tilt_norm
    Kd_pole = 0.8 + (4.0 - 0.8) * tilt_norm
    Kp_cart = 0.30 + (0.90 - 0.30) * tilt_norm
    Kd_cart = 0.45 + (1.20 - 0.45) * tilt_norm
    Ki_pole = 0.05
    if not hasattr(get_action, "integral_theta"):
        get_action.integral_theta = 0.0
    get_action.integral_theta = max(-0.5, min(0.5, get_action.integral_theta + pole_angle * dt))
    gravity_ff = 9.81 * math.sin(pole_angle)
    pole_pd = -(Kp_pole * math.sin(pole_angle) + Kd_pole * pole_angular_velocity + Ki_pole * get_action.integral_theta)
    cart_pd = -(Kp_cart * cart_position + Kd_cart * cart_velocity)
    u_raw = pole_pd + cart_pd + gravity_ff
    force_soft = 3.0 * math.tanh(u_raw / 3.0)
    force_clipped = max(-3.0, min(3.0, force_soft))
    if abs(force_clipped) < 0.01:
        force = 0.0
    else:
        force = force_clipped
    return force if force is not None else random.uniform(-3, 3)
