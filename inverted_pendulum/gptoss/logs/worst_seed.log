def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # Check for non-finite inputs
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0

    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity

    abs_theta = abs(theta)
    if abs_theta <= 0.05:
        t = 0.0
    elif abs_theta >= 0.18:
        t = 1.0
    else:
        t = (abs_theta - 0.05) / (0.18 - 0.05)

    Kp_theta = 6.0 + (55.0 - 6.0) * t
    Kd_theta = 0.8 + (12.0 - 0.8) * t
    Kp_x = 0.05
    Kd_x = 0.05

    u = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * x + Kd_x * x_dot) + 0.02
    Fmax = 0.5 + 2.5 * t

    force_raw = math.tanh(u / Fmax) * Fmax

    if force_raw > 3.0:
        force = 3.0
    elif force_raw < -3.0:
        force = -3.0
    else:
        force = force_raw

    return force
    # Default random action if no rule applies (unreachable in current logic)
    return random.uniform(-3.0, 3.0)
