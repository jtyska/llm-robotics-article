import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    if abs(theta) < 0.02:
        return 0.0

    tilt_raw = (abs(theta) - 0.05) / 0.13
    tilt = max(0.0, min(tilt_raw, 1.0))

    gain_factor = tilt ** 3

    Kp_theta = 10.0 + 250.0 * gain_factor
    Kd_theta = 3.0  + 40.0  * gain_factor
    Kp_cart  = 0.8  + 3.0   * gain_factor
    Kd_cart  = 0.2  + 1.0   * gain_factor
    ff_gain  = 0.5  + 1.5   * gain_factor

    force_raw = (Kp_theta * (-theta) +
                 Kd_theta * (-theta_dot) +
                 Kp_cart  * (-x) +
                 Kd_cart  * (-x_dot) +
                 ff_gain  * (-theta_dot))

    force = max(-3.0, min(force_raw, 3.0))
    return force

    # fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
