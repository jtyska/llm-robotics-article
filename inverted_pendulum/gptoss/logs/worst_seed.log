import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non‑finite values
    if (not math.isfinite(cart_position) or
        not math.isfinite(pole_angle) or
        not math.isfinite(cart_velocity) or
        not math.isfinite(pole_angular_velocity)):
        return 0.0

    theta = pole_angle
    th_dot = pole_angular_velocity
    x = cart_position
    x_dot = cart_velocity

    # Failure condition on angle
    if abs(theta) >= 0.20:
        return 0.0

    # Gains
    K_theta = 12.0
    K_thdot = 5.0
    K_x = 0.8
    K_xdot = 0.4

    # Base control terms
    u_angle = -(K_theta * theta + K_thdot * th_dot)
    u_cart = -(K_x * x + K_xdot * x_dot)

    # Cart‑bias factor
    if abs(theta) <= 0.02:
        cart_factor = 1.0
    elif abs(theta) < 0.08:
        cart_factor = 1.0 - (abs(theta) - 0.02) / (0.08 - 0.02)
    else:
        cart_factor = 0.0

    # Scaling factor
    if abs(theta) <= 0.02:
        scale = 1.0
    else:
        scale = 1.0 + (abs(theta) - 0.02) * (2.0 - 1.0) / (0.20 - 0.02)
        if scale > 2.0:
            scale = 2.0

    # Raw command
    raw_force = scale * (u_angle + cart_factor * u_cart)

    # Saturate to actuator limits
    if raw_force > 3.0:
        force = 3.0
    elif raw_force < -3.0:
        force = -3.0
    else:
        force = raw_force

    return force

    # Default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
