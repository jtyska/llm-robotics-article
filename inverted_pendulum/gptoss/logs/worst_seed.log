def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # Check for finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # 1️⃣ Normalise tilt
    theta = pole_angle
    theta_abs = abs(theta)
    if theta_abs <= 0.05:
        tilt_norm = 0.0
    elif theta_abs >= 0.20:
        tilt_norm = 1.0
    else:
        tilt_norm = (theta_abs - 0.05) / (0.20 - 0.05)

    # 2️⃣ Gain‑schedule (sigmoid)
    tau = 1.0 / (1.0 + math.exp(-10.0 * (tilt_norm - 0.5)))

    Kp_theta = (1 - tau) * 80.0 + tau * 180.0
    Kd_theta = (1 - tau) * 12.0 + tau * 30.0

    Kp_x = (1 - tau) * 2.0 + tau * 4.5
    Kd_x = (1 - tau) * 0.8 + tau * 1.5
    Ki_x = (1 - tau) * 0.3 + tau * 0.7

    # 3️⃣ Integral on cart position (slow leak)
    if not hasattr(get_action, "integ_x"):
        get_action.integ_x = 0.0
    get_action.integ_x = 0.999 * get_action.integ_x + 0.001 * cart_position

    # 4️⃣ Raw control law
    u_raw = -(Kp_theta * theta +
              Kd_theta * pole_angular_velocity +
              Kp_x * cart_position +
              Kd_x * cart_velocity +
              Ki_x * get_action.integ_x)

    # 5️⃣ Smooth saturation (tanh)
    force_raw = 3.0 * math.tanh(u_raw / 3.0)

    # 6️⃣ Hard clipping to action limits
    if force_raw > 3.0:
        force = 3.0
    elif force_raw < -3.0:
        force = -3.0
    else:
        force = force_raw

    return force

