import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    abs_theta = abs(pole_angle)
    tilt_norm_raw = (abs_theta - 0.05) / (0.18 - 0.05)
    if tilt_norm_raw < 0.0:
        tilt_norm = 0.0
    elif tilt_norm_raw > 1.0:
        tilt_norm = 1.0
    else:
        tilt_norm = tilt_norm_raw

    Kp_theta = 8.0 + 12.0 * tilt_norm
    Kd_theta = 2.0 + 10.0 * tilt_norm
    Kp_x = 0.2 + 0.8 * tilt_norm
    Kd_x = 0.3 + 0.7 * tilt_norm

    u_raw = -(Kp_theta * pole_angle +
              Kd_theta * pole_angular_velocity +
              Kp_x * cart_position +
              Kd_x * cart_velocity) + 9.81 * math.sin(pole_angle)

    force_raw = 3.0 * math.tanh(u_raw / 3.0)

    if abs(force_raw) < 0.02:
        force = 0.0
    else:
        force = force_raw

    return force

    # Default random action (unreachable in current logic)
    return random.uniform(-3, 3)
