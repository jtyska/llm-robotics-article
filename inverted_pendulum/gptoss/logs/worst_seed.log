import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    if abs(pole_angle) >= 0.20:
        return 0.0

    abs_theta = abs(pole_angle)
    if abs_theta <= 0.02:
        scale = 1.0
    elif abs_theta >= 0.18:
        scale = 2.0
    else:
        scale = 1.0 + (abs_theta - 0.02) * (2.0 - 1.0) / (0.18 - 0.02)

    u_angle = -(30.0 * pole_angle + 10.0 * pole_angular_velocity)
    u_cart = -(1.0 * cart_position + 0.2 * cart_velocity)
    force_raw = scale * u_angle + u_cart
    force = 3.0 * math.tanh(force_raw / 3.0)
    return force

    # Default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
