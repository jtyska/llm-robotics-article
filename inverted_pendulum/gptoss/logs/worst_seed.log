def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random

    # helper for sign
    def sign(x):
        if x > 0:
            return 1.0
        if x < 0:
            return -1.0
        return 0.0

    # check for non‑finite values
    if (not math.isfinite(cart_position) or not math.isfinite(cart_velocity) or
        not math.isfinite(pole_angle) or not math.isfinite(pole_angular_velocity)):
        return 0.0

    theta = pole_angle
    theta_dot = pole_angular_velocity
    x = cart_position
    x_dot = cart_velocity

    # angle beyond limits
    if abs(theta) >= 0.20:
        return -sign(theta) * 3.0

    # near‑upright region
    if abs(theta) <= 0.02:
        u_angle = -(22.0 * theta + 3.5 * theta_dot)
        u_cart = -(0.85 * x + 0.12 * x_dot)
        raw_force = u_angle + u_cart
        force = 3.0 * math.tanh(raw_force / 3.0)
        return force

    # intermediate angles
    rel = (abs(theta) - 0.02) / (0.19 - 0.02)  # denominator = 0.17
    scale = 1.0 + 1.5 * rel
    if scale > 2.5:
        scale = 2.5

    u_angle = -(22.0 * theta + 3.5 * theta_dot)
    raw_force = scale * u_angle
    force = 3.0 * math.tanh(raw_force / 3.0)
    return force

    # fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
