```python
def cartpole_policy(state):
    x, theta, x_dot, theta_dot = state

    # 1. safety
    if not (np.isfinite(x) and np.isfinite(theta) and
            np.isfinite(x_dot) and np.isfinite(theta_dot)):
        return 0.0

    # 2. normalised tilt (0 = safe, 1 = near failure)
    tilt_norm = np.clip((abs(theta) - 0.05) / (0.20 - 0.05), 0.0, 1.0)

    # 3. gain scheduling
    Kp = 4.0 + 6.0 * tilt_norm          # pole‑position gain
    Kd = 2.0 + 4.0 * tilt_norm          # pole‑velocity gain

    # 4. pole PD (use sin(theta) for smoother linearisation)
    pole_pd = -(Kp * np.sin(theta) + Kd * theta_dot)

    # 5. gravity feed‑forward
    gravity_ff = 0.95 * 9.81 * np.sin(theta)

    # 6. cart PD (stronger centering)
    cart_pd = -(0.05 * x + 0.08 * x_dot)

    # 7. small bias toward centre
    bias = -0.02 * x

    # 8. raw control signal
    u_raw = pole_pd + gravity_ff + cart_pd + bias

    # 9. mild extra scaling when we are already close to vertical
    alpha = 1.0 + 0.5 * tilt_norm

    # 10. squash and respect actuator limits
    force = np.clip(3.0 * np.tanh(alpha * u_raw), -3.0, 3.0)

    return float(force)
```

