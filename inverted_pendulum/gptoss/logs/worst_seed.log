import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    Kθ = 13.5
    Kθ_dot = 2.8
    Kx = 0.9
    Kx_dot = 0.4
    θ_dead = 0.02
    θ_max = 0.18

    x = cart_position
    θ = pole_angle
    x_dot = cart_velocity
    θ_dot = pole_angular_velocity

    def clamp(v, lo, hi):
        return max(min(v, hi), lo)

    # Rule: non‑finite values
    if not (math.isfinite(x) and math.isfinite(θ) and math.isfinite(x_dot) and math.isfinite(θ_dot)):
        force = 0.0
    elif abs(θ) >= θ_max:
        force = -3.0 * math.copysign(1.0, θ)
    elif abs(θ) <= θ_dead:
        raw = -(Kx * x + Kx_dot * x_dot)
        force = clamp(raw, -3.0, 3.0)
    else:
        u_angle = -(Kθ * θ + Kθ_dot * θ_dot)
        pos_corr = -(Kx * x + Kx_dot * x_dot) * 0.15
        α = (abs(θ) - θ_dead) / (θ_max - θ_dead)  # 0 … 1
        scale = 1.0 + α
        if scale > 2.0:
            scale = 2.0
        raw_force = scale * u_angle + pos_corr
        force = clamp(raw_force, -3.0, 3.0)

    # Dead‑zone to suppress jitter
    if abs(force) < 0.01:
        force = 0.0

    # Default random action if no rule applied (should not occur)
    if force is None:
        return random.uniform(-3.0, 3.0)
    return force
