def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # Check for finite values
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0

    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity

    # Compute tilt_norm
    if abs(theta) <= 0.05:
        tilt_norm = 0.0
    elif abs(theta) >= 0.20:
        tilt_norm = 1.0
    else:
        tilt_norm = (abs(theta) - 0.05) / (0.20 - 0.05)

    # Gains
    Kp_theta = 4.0 + 26.0 * tilt_norm
    Kd_theta = 2.0 + 10.0 * tilt_norm
    Kp_cart = 0.02 + 0.08 * tilt_norm
    Kd_cart = 0.03 + 0.09 * tilt_norm

    # Components
    gravity_ff = 0.85 * 9.81 * math.sin(theta)
    pole_pd = -(Kp_theta * math.sin(theta) + Kd_theta * theta_dot)
    cart_pd = -(Kp_cart * x + Kd_cart * x_dot)
    centre_bias = -0.07 * x

    u_raw = pole_pd + gravity_ff + cart_pd + centre_bias

    alpha = 0.8 + 0.8 * tilt_norm
    force_tanh = 3.0 * math.tanh(alpha * u_raw)

    if force_tanh > 3.0:
        force = 3.0
    elif force_tanh < -3.0:
        force = -3.0
    else:
        force = force_tanh

    return force if force is not None else random.uniform(-3, 3)
