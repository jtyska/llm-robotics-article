import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Initialize action as None for fallback
    action = None

    # Check for non-finite values
    if (not math.isfinite(cart_position) or not math.isfinite(cart_velocity) or
        not math.isfinite(pole_angle) or not math.isfinite(pole_angular_velocity)):
        action = 0.0
    else:
        theta = pole_angle
        theta_dot = pole_angular_velocity
        x = cart_position
        x_dot = cart_velocity

        # Compute cart component
        if abs(theta) < 0.01:
            u_cart = -(0.8 * x + 0.4 * x_dot)
        else:
            u_cart = 0.0

        # Determine gains based on angle magnitude
        abs_theta = abs(theta)
        if abs_theta <= 0.02:
            K_theta = 0.8
            K_theta_d = 0.30
        elif abs_theta >= 0.20:
            K_theta = 3.0
            K_theta_d = 1.2
        else:
            f = (abs_theta - 0.02) / (0.20 - 0.02)
            K_theta = 0.8 + f * (3.0 - 0.8)
            K_theta_d = 0.30 + f * (1.2 - 0.30)

        # Compute angle component
        u_angle = -(K_theta * theta + K_theta_d * theta_dot)

        # Combine components
        u_raw = u_cart + u_angle

        # Clamp to action limits
        if u_raw > 3.0:
            action = 3.0
        elif u_raw < -3.0:
            action = -3.0
        else:
            action = u_raw

    # Fallback random action if somehow no rule set action
    if action is None:
        action = random.uniform(-3.0, 3.0)

    return action
