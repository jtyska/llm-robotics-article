import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(theta) and math.isfinite(x_dot) and math.isfinite(theta_dot)):
        return 0.0

    abs_theta = abs(theta)
    if abs_theta <= 0.05:
        scale = 1.0
    elif abs_theta >= 0.18:
        scale = 3.0
    else:
        scale = 1.0 + 2.0 * (abs_theta - 0.05) / (0.18 - 0.05)

    w_angle = 1.0 - math.exp(-abs_theta / 0.05)
    w_cart = 1.0 - w_angle

    u_angle = -scale * (20.0 * theta + 6.0 * theta_dot)
    u_cart = -(0.5 * x + 0.1 * x_dot)

    raw_force = w_angle * u_angle + w_cart * u_cart

    if raw_force > 3.0:
        force = 3.0
    elif raw_force < -3.0:
        force = -3.0
    else:
        force = raw_force

    return force

    # Default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
