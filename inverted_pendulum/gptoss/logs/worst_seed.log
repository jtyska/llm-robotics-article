import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    theta_abs = abs(pole_angle)

    if theta_abs > 0.05:
        if theta_abs >= 0.20:
            tilt_norm = 1.0
        else:
            tilt_norm = (theta_abs - 0.05) / (0.20 - 0.05)
    else:
        tilt_norm = 0.0

    Kp_theta = (1 - tilt_norm) * 12.0 + tilt_norm * 6.0
    Kd_theta = (1 - tilt_norm) * 6.0 + tilt_norm * 12.0
    Kp_x = (1 - tilt_norm) * 0.08 + tilt_norm * 0.25
    Kd_x = (1 - tilt_norm) * 0.08 + tilt_norm * 0.30

    u_raw = -(Kp_theta * pole_angle + Kd_theta * pole_angular_velocity +
              Kp_x * cart_position + Kd_x * cart_velocity)

    force_raw = 3.0 * math.tanh(u_raw / 0.9)

    if abs(force_raw) < 0.02:
        force = 0.0
    else:
        force = force_raw

    return force

    # fallback (should never be reached)
    return random.uniform(-3, 3)
