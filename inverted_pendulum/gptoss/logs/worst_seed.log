import random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    theta = pole_angle
    theta_dot = pole_angular_velocity
    x = cart_position
    x_dot = cart_velocity

    theta1 = 0.15
    theta_dot1 = 0.05
    x1 = 0.4
    x_dot1 = 0.15

    K_theta = -9.0
    K_theta_dot = -4.0
    K_x = -2.0
    K_x_dot = -1.2
    K_v = -1.0

    F = None

    if abs(theta) > theta1:
        F = K_theta * theta + K_theta_dot * theta_dot + K_x * x + K_x_dot * x_dot
    elif abs(theta) <= theta1 and abs(theta_dot) > theta_dot1:
        F = K_v * theta_dot
    elif abs(theta) <= theta1 and abs(theta_dot) <= theta_dot1 and abs(x) > x1:
        F = K_x * x + K_x_dot * x_dot
    elif abs(theta) <= theta1 and abs(theta_dot) <= theta_dot1 and abs(x) <= x1 and abs(x_dot) > x_dot1:
        F = K_x_dot * x_dot
    else:
        F = 0.0

    if F is None:
        return random.uniform(-3.0, 3.0)

    action = max(-3.0, min(3.0, F))
    return action
