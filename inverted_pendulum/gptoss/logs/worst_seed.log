import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    if theta <= -0.20 or theta >= 0.20:
        return 0.0

    dead_zone = 0.03
    full_angle = 0.20
    tilt_raw = (abs(theta) - dead_zone) / (full_angle - dead_zone)
    if tilt_raw < 0.0:
        tilt = 0.0
    elif tilt_raw > 1.0:
        tilt = 1.0
    else:
        tilt = tilt_raw

    Kp_pole = 4.0 + 28.0 * tilt * tilt
    Kd_pole = 1.0 + 6.0 * tilt * tilt
    Kp_cart = 0.08 + 0.32 * tilt * tilt
    Kd_cart = 0.02 + 0.08 * tilt * tilt

    pole_pd = -Kp_pole * theta - Kd_pole * theta_dot
    cart_pd = -Kp_cart * x - Kd_cart * x_dot

    ff_gain = 0.6 * tilt
    if theta_dot > 0:
        sign_theta_dot = 1
    elif theta_dot < 0:
        sign_theta_dot = -1
    else:
        sign_theta_dot = 0
    feed_fwd = -ff_gain * sign_theta_dot

    raw_force = pole_pd + cart_pd + feed_fwd

    if raw_force > 3.0:
        force = 3.0
    elif raw_force < -3.0:
        force = -3.0
    else:
        force = raw_force

    return force

    # fallback (should never be reached)
    return random.uniform(-3, 3)
