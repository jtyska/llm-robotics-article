def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    force = None
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    else:
        x = cart_position
        x_dot = cart_velocity
        theta = pole_angle
        theta_dot = pole_angular_velocity

        if abs(x) > 1.0:
            excess = min(max(abs(x) - 1.0, 0.0), 0.2)
            sign = 1 if x > 0 else -1 if x < 0 else 0
            cart_force = -sign * 1.0 * excess / 0.2
        else:
            cart_force = 0.0

        tilt_raw = min(max((abs(theta) - 0.05) / (0.20 - 0.05), 0.0), 1.0)
        tilt = tilt_raw * tilt_raw

        Kp_theta = 30.0 + 120.0 * tilt
        Kd_theta = 2.0 + 8.0 * tilt
        Kp_x = 0.005 + 0.015 * tilt
        Kd_x = 0.001 + 0.006 * tilt

        ff_grav = 0.45 * math.sin(theta)

        u = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * x + Kd_x * x_dot + ff_grav) + cart_force
        force = max(min(u, 3.0), -3.0)

    if force is None:
        return random.uniform(-3.0, 3.0)
    return force
