import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(theta) and math.isfinite(x_dot) and math.isfinite(theta_dot)):
        return 0.0

    if abs(theta) >= 0.18:
        sign = 1.0 if theta > 0 else -1.0 if theta < 0 else 0.0
        raw = -sign * (1.5 + 1.5 * (abs(theta) - 0.18) / 0.02)
        force = max(min(raw, 3.0), -3.0)
        return force

    if abs(theta) <= 0.02:
        raw = -(0.8 * x + 0.4 * x_dot)
        force = max(min(raw, 3.0), -3.0)
        return force

    blend = (abs(theta) - 0.02) / (0.20 - 0.02)
    raw_angle = -(10.0 * theta + 3.0 * theta_dot)
    raw_cart = -(0.8 * x + 0.4 * x_dot)
    raw = (1 - blend) * raw_cart + blend * raw_angle
    force = 3.0 * math.tanh(raw / 3.0)
    return force

    # fallback random action
    return random.uniform(-3.0, 3.0)
