def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # Check for non‑finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity

    # Normalised tilt
    if abs(theta) <= 0.05:
        tilt_norm = 0.0
    elif abs(theta) >= 0.20:
        tilt_norm = 1.0
    else:
        tilt_norm = (abs(theta) - 0.05) / (0.20 - 0.05)

    # Inverse gain‑schedule
    Kp_theta = (1 - tilt_norm) * 12.0 + tilt_norm * 6.0
    Kd_theta = (1 - tilt_norm) * 6.0 + tilt_norm * 12.0
    Kp_x = (1 - tilt_norm) * 0.10 + tilt_norm * 0.30
    Kd_x = (1 - tilt_norm) * 0.10 + tilt_norm * 0.30

    # PD control law
    u_raw = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * x + Kd_x * x_dot)

    # Smooth saturation
    force_raw = 3.0 * math.tanh(u_raw / 0.9)

    if abs(force_raw) < 0.02:
        force = 0.0
    else:
        force = force_raw

    return force
    # Default random action if no rule applies (should never be reached)
    return random.uniform(-3.0, 3.0)
