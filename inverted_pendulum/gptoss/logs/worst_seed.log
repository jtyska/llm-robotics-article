import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    force = None
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    else:
        x = cart_position
        x_dot = cart_velocity
        theta = pole_angle
        theta_dot = pole_angular_velocity

        abs_theta = abs(theta)
        if abs_theta <= 0.05:
            tilt_norm = 0.0
        elif abs_theta >= 0.18:
            tilt_norm = 1.0
        else:
            tilt_norm = (abs_theta - 0.05) / (0.18 - 0.05)

        Kp = 5.0 + 2.0 * tilt_norm
        Kd = 3.0 + 1.5 * tilt_norm

        pole_effort = -(Kp * theta + Kd * theta_dot)
        centre_bias = -0.15 * x
        vel_damp = -0.03 * x_dot

        raw_force = pole_effort + centre_bias + vel_damp
        force = 3.0 * math.tanh(0.45 * raw_force)

        if force > 3.0:
            force = 3.0
        if force < -3.0:
            force = -3.0

    if force is None:
        return random.uniform(-3, 3)
    return force
