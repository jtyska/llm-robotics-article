def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # Check for finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    theta = pole_angle
    theta_abs = abs(theta)

    # Normalised tilt
    if theta_abs <= 0.05:
        tilt_norm = 0.0
    elif theta_abs >= 0.18:
        tilt_norm = 1.0
    else:
        tilt_norm = (theta_abs - 0.05) / (0.18 - 0.05)

    # Smooth gain‑schedule
    tau = 1.0 / (1.0 + math.exp(-8.0 * (tilt_norm - 0.5)))

    # Adaptive PD gains for pole
    Kp_theta = (1 - tau) * 80.0 + tau * 150.0
    Kd_theta = (1 - tau) * 12.0 + tau * 25.0

    # Cart‑position gains (constant)
    Kp_x = 0.8
    Kd_x = 0.5

    # Integral on cart position (persistent across calls)
    if not hasattr(get_action, "integ_x"):
        get_action.integ_x = 0.0
    get_action.integ_x = 0.99 * get_action.integ_x + 0.01 * cart_position
    Ki_x = 0.2

    # Raw control law
    u_raw = -(Kp_theta * theta +
              Kd_theta * pole_angular_velocity +
              Kp_x * cart_position +
              Kd_x * cart_velocity +
              Ki_x * get_action.integ_x)

    # Soft saturation via tanh
    force_raw = 3.0 * math.tanh(u_raw / 2.5)

    # Final hard clipping
    if force_raw > 3.0:
        force = 3.0
    elif force_raw < -3.0:
        force = -3.0
    else:
        force = force_raw

    return force

    # Default random action (fallback, should never be reached)
    return random.uniform(-3.0, 3.0)
