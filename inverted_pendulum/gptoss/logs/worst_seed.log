def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    force = None
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    else:
        tilt_raw = abs(pole_angle) / 0.20
        tilt_raw = max(0.0, min(tilt_raw, 1.0))
        tilt = tilt_raw * tilt_raw
        Kp_theta = 30.0 + 70.0 * tilt
        Kd_theta = 2.0 + 8.0 * tilt
        ff_grav = 0.45 * math.sin(pole_angle)
        if tilt_raw < 0.25:
            cart_center = -(0.006 * cart_position + 0.0015 * cart_velocity)
        else:
            cart_center = 0.0
        u = -(Kp_theta * pole_angle + Kd_theta * pole_angular_velocity + ff_grav) + cart_center
        force = max(-3.0, min(u, 3.0))
    if force is None:
        return random.uniform(-3.0, 3.0)
    return force
