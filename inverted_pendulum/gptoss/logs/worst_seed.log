#  CART‑POLE BALANCING CONTROLLER (v2.0)
# -------------------------------------------------
IF not finite(x) OR not finite(x_dot) OR not finite(theta) OR not finite(theta_dot)
THEN
    action = 0.0
ELSE IF abs(theta) > 0.20               # failure condition – do nothing
THEN
    action = 0.0
ELSE
    # ----- normalised tilt (0 = perfectly upright, 1 = limit) -----
    theta_abs = abs(theta)
