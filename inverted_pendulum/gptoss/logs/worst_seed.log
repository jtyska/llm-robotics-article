def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0
    pole_angle_abs = abs(pole_angle)
    if pole_angle_abs <= 0.05:
        tilt_norm = 0.0
    elif pole_angle_abs >= 0.20:
        tilt_norm = 1.0
    else:
        tilt_norm = (pole_angle_abs - 0.05) / 0.15
    tau = 1.0 / (1.0 + math.exp(-15.0 * (tilt_norm - 0.5)))
    Kp_theta = (1.0 - tau) * 80.0 + tau * 180.0
    Kd_theta = (1.0 - tau) * 12.0 + tau * 30.0
    Kp_x = (1.0 - tau) * 2.0 + tau * 4.5
    Kd_x = (1.0 - tau) * 0.8 + tau * 1.5
    Ki_x = (1.0 - tau) * 0.3 + tau * 0.7
    if not hasattr(get_action, "integral_x"):
        get_action.integral_x = 0.0
    get_action.integral_x = 0.995 * get_action.integral_x + 0.005 * cart_position
    integral_x = get_action.integral_x
    u_raw = -(Kp_theta * pole_angle + Kd_theta * pole_angular_velocity + Kp_x * cart_position + Kd_x * cart_velocity + Ki_x * integral_x)
    force_soft = 3.0 * math.tanh(u_raw / 3.0)
    if force_soft > 3.0:
        action = 3.0
    elif force_soft < -3.0:
        action = -3.0
    else:
        action = force_soft
    return action
    # default fallback (unreachable)
    return random.uniform(-3.0, 3.0)
