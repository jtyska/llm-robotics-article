import random, math

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non-finite values
    if (not math.isfinite(cart_position) or not math.isfinite(cart_velocity) or
        not math.isfinite(pole_angle) or not math.isfinite(pole_angular_velocity)):
        return 0.0

    # Compute tilt_raw
    tilt_raw = (abs(pole_angle) - 0.05) / (0.20 - 0.05)
    if tilt_raw < 0:
        tilt_raw = 0.0
    elif tilt_raw > 1:
        tilt_raw = 1.0

    # Gains
    Kp_theta = 12.0 + 18.0 * tilt_raw * tilt_raw
    Kd_theta = 5.0 + 10.0 * tilt_raw * tilt_raw
    Kp_cart = 0.20 * (1.0 - tilt_raw)
    Kd_cart = 0.04 * (1.0 - tilt_raw)
    Kp_center = 0.07 * tilt_raw

    # Efforts
    pole_effort = -Kp_theta * pole_angle - Kd_theta * pole_angular_velocity
    cart_effort = -Kp_cart * cart_position - Kd_cart * cart_velocity
    center_effort = -Kp_center * cart_position

    force_raw = pole_effort + cart_effort + center_effort

    # Clip to action bounds
    if force_raw > 3.0:
        force = 3.0
    elif force_raw < -3.0:
        force = -3.0
    else:
        force = force_raw

    return force

    # Default random action (unreachable in current logic)
    return random.uniform(-3.0, 3.0)
