import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Helper clamp
    def clamp(val, lo, hi):
        return max(lo, min(val, hi))
    # Check finiteness
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    theta = pole_angle
    x = cart_position
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity
    abs_theta = abs(theta)
    if abs_theta >= 0.18:
        force = -math.copysign(1.0, theta) * 3.0
        return clamp(force, -3.0, 3.0)
    elif abs_theta <= 0.02:
        u_angle = -(45.0 * theta + 12.0 * theta_dot)
        u_pos = -(1.0 * x + 0.8 * x_dot)
        raw_force = 0.7 * u_angle + 0.3 * u_pos
        return clamp(raw_force, -3.0, 3.0)
    else:
        u_angle = -(45.0 * theta + 12.0 * theta_dot)
        ramp = 1.0 + 0.8 * (abs_theta - 0.02) / (0.18 - 0.02)
        raw_force = ramp * u_angle
        return clamp(raw_force, -3.0, 3.0)
    # Fallback random action
    return random.uniform(-3.0, 3.0)
