def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    force = None
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    else:
        abs_theta = abs(pole_angle)
        if abs_theta <= 0.05:
            tilt_norm = 0.0
        elif abs_theta >= 0.18:
            tilt_norm = 1.0
        else:
            tilt_norm = (abs_theta - 0.05) / (0.18 - 0.05)
        Kx = 0.30 + (0.90 - 0.30) * tilt_norm
        Kx_dot = 0.45 + (1.20 - 0.45) * tilt_norm
        Ktheta = 2.0 + (7.0 - 2.0) * tilt_norm
        Ktheta_dot = 0.8 + (4.0 - 0.8) * tilt_norm
        raw = -(Kx * cart_position + Kx_dot * cart_velocity + Ktheta * math.sin(pole_angle) + Ktheta_dot * pole_angular_velocity) + 9.81 * math.sin(pole_angle)
        soft = 3.0 * math.tanh(raw / 3.0)
        if soft > 3.0:
            force = 3.0
        elif soft < -3.0:
            force = -3.0
        else:
            force = soft
    if force is None:
        return random.uniform(-3, 3)
    return force
