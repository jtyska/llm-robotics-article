def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity
    force = None
    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        force = 0.0
    else:
        theta_abs = abs(theta)
        if theta_abs < 0.02:
            u = -(12.0 * theta + 8.0 * theta_dot)
        else:
            if theta_abs <= 0.04:
                scale = 1.0 + (theta_abs - 0.02) * (1.5 - 1.0) / (0.04 - 0.02)
            elif theta_abs <= 0.10:
                scale = 1.5 + (theta_abs - 0.04) * (3.0 - 1.5) / (0.10 - 0.04)
            else:
                scale = 3.0 + (theta_abs - 0.10) * (5.0 - 3.0) / (0.20 - 0.10)
            if scale > 5.0:
                scale = 5.0
            u_base = -(12.0 * theta + 8.0 * theta_dot + 0.3 * x + 0.1 * x_dot)
            u = scale * u_base
        force = 3.0 * math.tanh(u / 3.0)
        if force > 3.0:
            force = 3.0
        if force < -3.0:
            force = -3.0
    if force is None:
        return random.uniform(-3, 3)
    return force
