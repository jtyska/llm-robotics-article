def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    action = None
    # finite check
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        action = 0.0
    else:
        x = cart_position
        x_dot = cart_velocity
        theta = pole_angle
        theta_dot = pole_angular_velocity
        if abs(x) > 1.2:
            excess = max(0.0, min(abs(x) - 1.0, 0.2))
            action = -math.copysign(1.0, x) * 3.0 * excess / 0.2
            action = max(-3.0, min(action, 3.0))
        else:
            # normalised tilt (0 → 1)
            tilt_raw = (abs(theta) - 0.05) / (0.20 - 0.05)
            tilt_raw = max(0.0, min(tilt_raw, 1.0))
            tilt = tilt_raw * tilt_raw  # quadratic scaling

            # gain‑schedule
            Kp_theta = 30.0 + 120.0 * tilt          # 30 → 150
            Kd_theta = 2.0  +   8.0 * tilt          # 2  → 10
            Kp_x     = 0.02 + 0.06 * tilt           # 0.02 → 0.08
            Kd_x     = 0.004+ 0.02 * tilt           # 0.004→0.024

            # gravity feed‑forward
            ff_grav = 0.52 * math.sin(theta)

            # small bias (limited)
            bias_raw = 0.015 * math.copysign(1.0, theta) * tilt
            bias = max(-0.2, min(bias_raw, 0.2))

            # PD command
            u_raw = -(Kp_theta * theta +
                      Kd_theta * theta_dot +
                      Kp_x     * x +
                      Kd_x     * x_dot +
                      ff_grav) + bias

            # actuator limits
            action = max(-3.0, min(u_raw, 3.0))
    if action is None:
        return random.uniform(-3.0, 3.0)
    return action
