import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # initialize persistent integral term
    if not hasattr(get_action, "integral_theta"):
        get_action.integral_theta = 0.0

    # check finiteness
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # 1. Normalised tilt
    tilt_raw = (abs(theta) - 0.05) / (0.20 - 0.05)
    if tilt_raw < 0.0:
        tilt_raw = 0.0
    elif tilt_raw > 1.0:
        tilt_raw = 1.0

    # 2. Gain shaping
    if tilt_raw <= 0.5:
        g_low = tilt_raw * tilt_raw
        g_high = 0.0
    else:
        g_low = 0.25
        g_high = (tilt_raw - 0.5) * (tilt_raw - 0.5)

    # 3. Proportional / Derivative gains for the pole
    Kp_theta = 8.0 + 32.0 * g_low + 80.0 * g_high
    Kd_theta = 1.5 + 8.0 * g_low + 20.0 * g_high

    # 4. Tiny integral on theta (clamped)
    get_action.integral_theta += theta * 0.001
    if get_action.integral_theta > 0.05:
        get_action.integral_theta = 0.05
    elif get_action.integral_theta < -0.05:
        get_action.integral_theta = -0.05
    Ki_theta = 0.2 * tilt_raw

    # 5. Pole stabilising effort
    pole_effort = -Kp_theta * theta - Kd_theta * theta_dot - Ki_theta * get_action.integral_theta

    # 6. Cart‑centering bias (fades with tilt)
    centre_bias = -0.07 * (1.0 - tilt_raw) * x

    # 7. Cart‑velocity damping (always active)
    cart_vel_damp = -0.03 * (1.0 - tilt_raw) * x_dot

    # 8. Combine everything
    raw_force = pole_effort + centre_bias + cart_vel_damp

    # 9. Smooth saturation (tanh)
    force = 3.0 * math.tanh(raw_force * 0.30)

    # 10. Hard clip to limits
    if force > 3.0:
        force = 3.0
    elif force < -3.0:
        force = -3.0

    return force

    # default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
