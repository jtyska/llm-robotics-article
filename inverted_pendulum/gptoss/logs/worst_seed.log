def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0
    abs_theta = abs(pole_angle)
    tilt_norm = (abs_theta - 0.05) / (0.18 - 0.05)
    if tilt_norm < 0.0:
        tilt_norm = 0.0
    elif tilt_norm > 1.0:
        tilt_norm = 1.0
    Kp_theta = 4.0 + (30.0 - 4.0) * tilt_norm
    Kd_theta = 2.0 + (12.0 - 2.0) * tilt_norm
    pole_pd = -(Kp_theta * math.sin(pole_angle) + Kd_theta * pole_angular_velocity)
    gravity_ff = 0.60 * 9.81 * math.sin(pole_angle)
    if abs_theta < 0.07:
        centre_bias = -0.08 * cart_position
    else:
        centre_bias = 0.0
    raw_force = pole_pd + gravity_ff + centre_bias
    force_raw = 3.0 * math.tanh(0.75 * raw_force)
    if force_raw > 3.0:
        force = 3.0
    elif force_raw < -3.0:
        force = -3.0
    else:
        force = force_raw
    return force
    # default random action if no rule applies
    return random.uniform(-3, 3)
