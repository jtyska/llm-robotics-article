def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0
    if abs(pole_angle) < 0.07:
        centre_bias = -0.08 * cart_position
    else:
        centre_bias = 0.0
    pole_pd = -(25.0 * math.sin(pole_angle) + 8.0 * pole_angular_velocity)
    cart_pd = -(0.05 * cart_position + 0.07 * cart_velocity)
    gravity_ff = 9.81 * math.sin(pole_angle)
    u_raw = pole_pd + gravity_ff + cart_pd + centre_bias
    force_tanh = 3.0 * math.tanh(1.2 * u_raw)
    if force_tanh > 3.0:
        force = 3.0
    elif force_tanh < -3.0:
        force = -3.0
    else:
        force = force_tanh
    return force
    return random.uniform(-3, 3)
