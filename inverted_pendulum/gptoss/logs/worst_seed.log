import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Rule 1 – Safety check
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Alias for readability
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # Rule 2 – Normalised tilt
    tilt_raw = (abs(theta) - 0.05) / (0.18 - 0.05)
    tilt_norm = max(0.0, min(tilt_raw, 1.0))

    # Rule 3 – Blend factor
    blend = 1.0 / (1.0 + math.exp(-12.0 * (tilt_norm - 0.5)))

    # Rule 4 – Gentle PD control
    u_g = (-8.0) * theta + (-1.0) * theta_dot + (-0.5) * x + (-0.1) * x_dot

    # Rule 5 – Aggressive PD control
    u_a = (-35.0) * theta + (-5.0) * theta_dot + (-2.0) * x + (-0.5) * x_dot

    # Rule 6 – Interpolated control signal
    u = (1.0 - blend) * u_g + blend * u_a

    # Rule 7 – Saturation & output
    force = max(-3.0, min(u, 3.0))
    return force

    # Default random action (fallback, should never be reached)
    return random.uniform(-3.0, 3.0)
