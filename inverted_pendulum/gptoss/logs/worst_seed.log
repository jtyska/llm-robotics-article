import random
import math

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non-finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Compute tilt_raw
    tilt_raw = abs(pole_angle) / 0.20
    tilt_raw = max(0.0, min(tilt_raw, 1.0))

    # Gains
    Kp_theta = 5.0 + 45.0 * tilt_raw
    Kd_theta = 2.0 + 20.0 * tilt_raw
    Kp_cart  = 0.2 + 1.5  * tilt_raw
    Kd_cart  = 0.05 + 0.4 * tilt_raw
    ff_gain  = 0.8 + 4.0  * tilt_raw

    # Raw force calculation
    force_raw = (-Kp_theta * pole_angle
                 -Kd_theta * pole_angular_velocity
                 -Kp_cart  * cart_position
                 -Kd_cart  * cart_velocity
                 +ff_gain  * pole_angle)

    # Saturate to action limits
    if force_raw > 3.0:
        return 3.0
    elif force_raw < -3.0:
        return -3.0
    else:
        return force_raw

    # Default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
