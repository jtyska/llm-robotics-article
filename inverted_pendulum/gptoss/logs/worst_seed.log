def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    force = None
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    else:
        x = cart_position
        theta = pole_angle
        x_dot = cart_velocity
        theta_dot = pole_angular_velocity
        abs_theta = abs(theta)
        if abs_theta <= 0.04:
            tilt_norm = 0.0
        elif abs_theta >= 0.20:
            tilt_norm = 1.0
        else:
            tilt_norm = (abs_theta - 0.04) / (0.20 - 0.04)
        Kp_theta = 10.0 + (80.0 - 10.0) * tilt_norm
        Kd_theta = 1.5 + (30.0 - 1.5) * tilt_norm
        Kp_x = 0.20 + (0.60 - 0.20) * tilt_norm
        Kd_x = 0.10 + (0.45 - 0.10) * tilt_norm
        ff_grav = 0.2 * theta
        u = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * x + Kd_x * x_dot + ff_grav) + 0.02
        Fmax = 0.5 + 2.5 * tilt_norm
        force_raw = math.tanh(u / Fmax) * Fmax
        if force_raw > 3.0:
            force = 3.0
        elif force_raw < -3.0:
            force = -3.0
        else:
            force = force_raw
    if force is None:
        return random.uniform(-3.0, 3.0)
    return force
