def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity
    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0
    theta_abs = abs(theta)
    tau_raw = (theta_abs - 0.05) / (0.18 - 0.05)
    if tau_raw < 0.0:
        tau = 0.0
    elif tau_raw > 1.0:
        tau = 1.0
    else:
        tau = tau_raw
    Kp_theta = (1 - tau) * 30.0 + tau * 120.0
    Kd_theta = (1 - tau) * 8.0 + tau * 30.0
    Kp_x = (1 - tau) * 0.02 + tau * 0.12
    Kd_x = (1 - tau) * 0.02 + tau * 0.15
    u_raw = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * x + Kd_x * x_dot)
    force = 3.0 * math.tanh(u_raw / 2.5)
    if abs(force) < 0.02:
        force = 0.0
    return force
    return random.uniform(-3, 3)
