def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # Check for non-finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    # Failure condition on pole angle
    if abs(pole_angle) > 0.20:
        return 0.0

    g = 9.8
    theta_min = 0.02
    theta_max = 0.20

    alpha_raw = (abs(pole_angle) - theta_min) / (theta_max - theta_min)
    alpha = max(0.0, min(alpha_raw, 1.0))
    scale = 1.0 + 2.0 * alpha  # linear from 1 → 3

    K_theta = 8.0
    K_theta_dot = 3.0
    K_cart_pos = 0.80
    K_cart_vel = 0.40

    u_grav = -g * math.sin(pole_angle)
    u_angle = -scale * (K_theta * pole_angle + K_theta_dot * pole_angular_velocity)
    u_cart = -scale * (K_cart_pos * cart_position + K_cart_vel * cart_velocity)

    u_raw = u_grav + u_angle + u_cart
    u_clamped = max(-3.0, min(u_raw, 3.0))

    if abs(u_clamped) < 0.01:
        return 0.0
    else:
        return u_clamped

    # Default random action if no rule applied
    return random.uniform(-3.0, 3.0)
