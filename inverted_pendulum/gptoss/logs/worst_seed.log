import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # check for non‑finite values
    if not all(math.isfinite(v) for v in (cart_position, pole_angle, cart_velocity, pole_angular_velocity)):
        return 0.0

    # base cart controller
    u_cart = -(0.15 * cart_position + 0.30 * cart_velocity)

    theta_abs = abs(pole_angle)

    # determine gains
    if theta_abs <= 0.02:
        K_theta = 10.0
        K_theta_dot = 3.0
    elif theta_abs >= 0.18:
        K_theta = 55.0
        K_theta_dot = 11.0
    else:
        alpha = (theta_abs - 0.02) / (0.18 - 0.02)  # interpolation factor
        K_theta = (1 - alpha) * 10.0 + alpha * 55.0
        K_theta_dot = (1 - alpha) * 3.0 + alpha * 11.0

    # compute total force
    force = u_cart - (K_theta * pole_angle + K_theta_dot * pole_angular_velocity)

    # clip to action bounds
    if force > 3.0:
        force = 3.0
    elif force < -3.0:
        force = -3.0

    return force if math.isfinite(force) else random.uniform(-3.0, 3.0)
