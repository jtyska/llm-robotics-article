    # saturation
    force_raw = 3.0 * math.tanh(u_pd / 1.0)

    # low‑pass filter
    action = 0.9 * get_action.force_prev + 0.1 * force_raw

    # store for next step
    get_action.force_prev = action

    return action if math.isfinite(action) else random.uniform(-3, 3)
