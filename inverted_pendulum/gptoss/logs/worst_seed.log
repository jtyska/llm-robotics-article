def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # Check for non-finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    # Failure condition on pole angle
    if abs(pole_angle) > 0.20:
        return 0.0
    # Alias variables for readability
    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity
    # Compute scaling factor s
    theta_abs = abs(theta)
    s_raw = (theta_abs - 0.02) / (0.20 - 0.02)
    s = max(0.0, min(1.0, s_raw))
    # Gains
    K_theta = 0.8 + s * (15.0 - 0.8)
    K_theta_d = 0.3 + s * (6.0 - 0.3)
    K_x = 0.80 * (1.0 - s) + 0.20 * s
    K_x_d = 0.40 * (1.0 - s) + 0.10 * s
    # Control components
    u_angle = -(K_theta * theta + K_theta_d * theta_dot)
    u_cart = -(K_x * x + K_x_d * x_dot)
    u_grav = 0.5 * theta
    u_center = -0.20 * x
    u_raw = u_angle + u_cart + u_grav + u_center
    # Safety clamp
    u_safe = max(-3.0 + 0.05, min(3.0 - 0.05, u_raw))
    # Final action
    action = 0.95 * 3.0 * math.tanh(u_safe / 3.0)
    action = max(-3.0, min(3.0, action))
    return action
    # Default random action (fallback)
    return random.uniform(-3.0, 3.0)
