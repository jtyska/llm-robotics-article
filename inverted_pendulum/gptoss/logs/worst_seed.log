import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    def clamp(v, lo, hi):
        return max(lo, min(v, hi))
    def sign(v):
        return 1.0 if v > 0 else -1.0 if v < 0 else 0.0

    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(theta) and math.isfinite(x_dot) and math.isfinite(theta_dot)):
        return 0.0
    elif abs(theta) >= 0.20:
        force = clamp(-sign(theta) * 3.0, -3.0, 3.0)
        return force
    else:
        u_angle = -(30.0 * theta + 8.0 * theta_dot)
        u_cart = -(1.0 * x + 0.5 * x_dot)

        cart_weight = 1.0 - (abs(theta) - 0.08) / (0.20 - 0.08)
        cart_weight = clamp(cart_weight, 0.2, 1.0)

        scale = 1.0 + (abs(theta) - 0.08) / (0.20 - 0.08)
        scale = max(scale, 1.0)

        raw_force = scale * (u_angle + cart_weight * u_cart)
        force = clamp(raw_force, -3.0, 3.0)
        return force

    return random.uniform(-3.0, 3.0)
