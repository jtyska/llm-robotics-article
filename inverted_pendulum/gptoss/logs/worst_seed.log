## 2. New strategy (pseudocode)

```text
# --------------------------------------------------------------
# 0. Safety guard – keep the controller dead if any state is NaN
# --------------------------------------------------------------
IF NOT (isfinite(x) AND isfinite(x_dot) AND isfinite(theta) AND isfinite(theta_dot))
    action = 0.0
    RETURN action
END IF

# --------------------------------------------------------------
# 1. Base linear state‑feedback (LQR‑style)
#    Gains have been tuned empirically for the continuous‑force cart‑pole.
# --------------------------------------------------------------
k_theta      = 15.0      # stronger pole‑angle gain
k_theta_dot  = 10.0      # stronger pole‑rate gain
k_x          =  0.7      # cart‑position gain
k_x_dot      =  0.3      # cart‑velocity gain

u_lin = -( k_theta     * theta
          + k_theta_dot * theta_dot
          + k_x         * x
          + k_x_dot     * x_dot )

# --------------------------------------------------------------
# 2. Angle‑dependent gain scaling (smooth quadratic curve)
#    Scale grows from 1.0 at |θ|=0.00 to 6.0 at |θ|=0.20 rad.
# --------------------------------------------------------------
abs_theta = abs(theta)

# quadratic scaling:   s = 1 + 5 * (|θ|/0.20)^2
scale = 1.0 + 5.0 * (abs_theta / 0.20) ** 2
IF scale > 6.0
    scale = 6.0
END IF

# --------------------------------------------------------------
# 3. Angle‑dependent boost (adds extra torque when the pole is far)
#    Boost = -B * sign(θ) * (|θ|‑θ_thr)^2   for |θ| > θ_thr
# --------------------------------------------------------------
theta_thr   = 0.05                # start boosting beyond 0.05 rad
boost_gain  = 8.0                 # magnitude of the boost
IF abs_theta > theta_thr
    boost = -boost_gain * sign(theta) * (abs_theta - theta_thr) ** 2
ELSE
    boost = 0.0
END IF

# --------------------------------------------------------------
# 4. Combine everything
# --------------------------------------------------------------
u_raw = (u_lin * scale) + boost

# --------------------------------------------------------------
# 5. Soft saturation (tanh) – keep the shape but allow larger
#    effective gain before clipping.
# --------------------------------------------------------------
u_soft = 3.0 * tanh( u_raw / 3.0 )   # output stays in [-3, +3]

# --------------------------------------------------------------
# 6. Hard clipping (actuator limits)
# --------------------------------------------------------------
action = max(-3.0, min(3.0, u_soft))

RETURN action
```

