import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # alias for readability
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    def sign(v):
        return 1.0 if v > 0 else -1.0 if v < 0 else 0.0

    # Rule: non‑finite inputs
    if (not math.isfinite(x) or not math.isfinite(x_dot) or
        not math.isfinite(theta) or not math.isfinite(theta_dot)):
        return 0.0

    # Rule: pole angle beyond limit
    if abs(theta) >= 0.20:
        return -3.0 * sign(theta)

    # Main control law
    k_x = 1.0
    k_xdot = 0.5
    k_theta0 = 10.0
    k_thetadot = 2.5

    if abs(theta) <= 0.02:
        k_theta = k_theta0
    else:
        scale = 1.0 + 0.5 * (abs(theta) - 0.02) / (0.18 - 0.02)
        k_theta = k_theta0 * scale

    raw = -(k_x * x + k_xdot * x_dot + k_theta * theta + k_thetadot * theta_dot)

    if abs(theta) > 0.15:
        raw -= 1.0 * sign(theta)

    force = max(min(raw, 3.0), -3.0)
    return force

    # Default random action (should not be reached)
    return random.uniform(-3.0, 3.0)
