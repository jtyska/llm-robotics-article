    /* ---- 4. Gains ------------------------------------------ */
    /*   Cart PD (used when w is small)                       */
    Kx      = 0.80          // constant
    Kx_dot  = 0.40          // constant
    bias_cart = -0.001 * x   // gentle centering bias

    u_cart = -(Kx * x + Kx_dot * x_dot_f) + bias_cart

    /*   Angle PD – gains grow from a modest base to a strong max */
    Kθ_min   = 0.8
    Kθ_max   = 12.0
    Kθd_min  = 0.3
    Kθd_max  = 4.0

    Kθ   = Kθ_min + w * (Kθ_max - Kθ_min)
    Kθd  = Kθd_min + w * (Kθd_max - Kθd_min)

    u_angle = -(Kθ * theta + Kθd * theta_dot_f)

    /* ---- 5. Blend the two commands -------------------------- */
    u_raw = (1.0 - w) * u_cart + w * u_angle

    /* ---- 6. Anticipate saturation (keep a safety margin) -- */
    safety_margin = 0.15          // leave a little head‑room
    u_raw = clamp(u_raw,
                  -3.0 + safety_margin,
                  +3.0 - safety_margin)

    /* ---- 7. Final clipping --------------------------------- */
    action = clamp(u_raw, -3.0, +3.0)

    /* ---- 8. Store filtered derivatives for next step ------- */
    prev_theta_dot = theta_dot_f
    prev_x_dot     = x_dot_f
ENDIF
