import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if not hasattr(get_action, "i_angle"):
        get_action.i_angle = 0.0
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    tilt_raw = (abs(pole_angle) - 0.05) / (0.18 - 0.05)
    tilt_raw = max(0.0, min(tilt_raw, 1.2))
    tilt = tilt_raw * tilt_raw
    Kp_theta = 30.0 + 150.0 * tilt
    Kd_theta = 2.0 + 12.0 * tilt
    Kp_x = 0.005 + 0.020 * tilt
    Kd_x = 0.001 + 0.008 * tilt
    get_action.i_angle = max(-0.5, min(get_action.i_angle + pole_angle * 0.001, 0.5))
    i_angle = get_action.i_angle
    Ki_theta = 5.0 * tilt
    ff_grav = 0.45 * math.sin(pole_angle)
    cart_center_raw = (abs(cart_position) - 0.5) / 0.5
    cart_center_raw = max(0.0, min(cart_center_raw, 1.0))
    cart_center_force = -math.copysign(1.0, cart_position) * 0.5 * (1.0 - tilt) * cart_center_raw
    u = -(Kp_theta * pole_angle
          + Kd_theta * pole_angular_velocity
          + Ki_theta * i_angle
          + Kp_x * cart_position
          + Kd_x * cart_velocity
          + ff_grav) + cart_center_force
    force = max(-3.0, min(u, 3.0))
    return force
    # fallback random action if needed
    # return random.uniform(-3.0, 3.0)
