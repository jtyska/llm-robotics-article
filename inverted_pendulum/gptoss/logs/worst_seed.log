def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # Check for non‑finite values
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0
    # Failure angle condition
    if pole_angle < -0.20 or pole_angle > 0.20:
        return 0.0
    # Alias variables for readability
    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity
    # Normalized tilt factor s ∈ [0,1]
    theta_abs = abs(theta)
    s_raw = (theta_abs - 0.02) / (0.20 - 0.02)
    s = max(0.0, min(1.0, s_raw))
    # Gain scheduling
    Kx   = 0.80 * (1.0 - s) + 0.30 * s
    Kx_d = 0.40 * (1.0 - s) + 0.15 * s
    Kθ   = 0.80 + s * (15.0 - 0.80)
    Kθ_d = 0.30 + s * (5.0  - 0.30)
    # Raw control law
    u_cart  = -(Kx * x + Kx_d * x_dot) - 0.001 * x
    u_angle = -(Kθ * theta + Kθ_d * theta_dot)
    u_grav  = -0.5 * math.sin(theta)
    u_raw   = u_cart + u_angle + u_grav
    # Safety clipping with margin 0.05 N
    u_safety = max(-3.0 + 0.05, min(3.0 - 0.05, u_raw))
    # Final clipping to enforce hard limits
    action = max(-3.0, min(3.0, u_safety))
    return action
    # Default random action if no rule applies (unreachable in current logic)
    return random.uniform(-3, 3)
