import random, math

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    force = None
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    elif abs(pole_angle) >= 0.18:
        sign = 1.0 if pole_angle > 0 else -1.0 if pole_angle < 0 else 0.0
        force = -sign * 3.0
        force = max(min(force, 3.0), -3.0)
    else:
        Kx = 1.0
        Kx_dot = 1.0
        Ktheta = 10.0
        Ktheta_dot = 2.5
        u_raw = -(Kx * cart_position +
                  Kx_dot * cart_velocity +
                  Ktheta * pole_angle +
                  Ktheta_dot * pole_angular_velocity)
        force = max(min(u_raw, 3.0), -3.0)
        if abs(force) < 0.02:
            force = 0.0
    if force is None:
        force = random.uniform(-3.0, 3.0)
    return force
