def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    def clamp(v, lo, hi):
        return max(lo, min(v, hi))
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity
    force = None
    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        force = 0.0
    elif abs(theta) < 0.02:
        raw_u = -0.30 * x
        force = clamp(raw_u, -0.8, 0.8)
    else:
        tilt_raw = (abs(theta) - 0.02) / (0.20 - 0.02)
        tilt_norm = clamp(tilt_raw, 0.0, 1.0)
        gain = tilt_norm * tilt_norm
        Kp_theta = 8.0 + (45.0 - 8.0) * gain
        Kd_theta = 1.0 + (10.0 - 1.0) * gain
        Kp_x = 0.10 + (0.30 - 0.10) * gain
        Kd_x = 0.05 + (0.20 - 0.05) * gain
        bias = -0.25 * x
        u_raw = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * (x + bias) + Kd_x * x_dot)
        max_force = 0.5 + (3.0 - 0.5) * gain
        force = math.tanh(u_raw / max_force) * max_force
        force = clamp(force, -3.0, 3.0)
    if force is None:
        return random.uniform(-3.0, 3.0)
    return force
