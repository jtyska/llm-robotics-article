import random, math

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    def sign(v):
        return 1.0 if v > 0 else -1.0 if v < 0 else 0.0

    def clip(val, lo, hi):
        return max(lo, min(hi, val))

    if abs(theta) >= 0.15:
        force = -3.0 * sign(theta)
        return force
    elif abs(theta) <= 0.02:
        raw = -(0.8 * x + 0.4 * x_dot)
        force = clip(raw, -3.0, 3.0)
