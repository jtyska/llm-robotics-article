def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x, theta, x_dot, theta_dot = cart_position, pole_angle, cart_velocity, pole_angular_velocity

    def is_finite(v):
        return math.isfinite(v)

    def clip(val, lo, hi):
        return max(min(val, hi), lo)

    def sign(v):
        return 1.0 if v > 0 else (-1.0 if v < 0 else 0.0)

    if not (is_finite(x) and is_finite(x_dot) and is_finite(theta) and is_finite(theta_dot)):
        return 0.0

    abs_theta = abs(theta)

    if abs_theta >= 0.20:
        force = -3.0 * sign(theta)
        return clip(force, -3.0, 3.0)

    if abs_theta <= 0.02:
        expr = -(1.0 * x + 0.5 * x_dot + 10.0 * theta + 2.5 * theta_dot)
        return clip(expr, -3.0, 3.0)

    if abs_theta <= 0.12:
        gain_theta = 1.0 + 0.5 * (abs_theta - 0.02) / (0.12 - 0.02)   # 1 → 1.5
        gain_cart = 1.0 - 0.5 * (abs_theta - 0.02) / (0.12 - 0.02)    # 1 → 0.5
        expr = -(gain_cart * (1.0 * x + 0.5 * x_dot) + gain_theta * (10.0 * theta + 2.5 * theta_dot))
        return clip(expr, -3.0, 3.0)

    # abs_theta > 0.12 and < 0.20
    expr = -(0.2 * (1.0 * x + 0.5 * x_dot) + 2.0 * (10.0 * theta + 2.5 * theta_dot))
    return clip(expr, -3.0, 3.0)

    # fallback (should not be reached)
    return random.uniform(-3.0, 3.0)
