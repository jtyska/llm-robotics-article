    // When the pole is very close to vertical we gently pull the cart toward the centre.
    // This prevents the cart from drifting to the edges of the track.
    IF abs_theta < 0.05 THEN
        Kp_x    ← 0.15          // small proportional gain on x
        Kd_x    ← 0.30          // small derivative gain on ẋ
