import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non-finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Helper functions
    def clamp(val, lo, hi):
        return max(lo, min(hi, val))

    def sign(x):
        return 1.0 if x > 0 else (-1.0 if x < 0 else 0.0)

    theta = pole_angle
    x = cart_position
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # Rule for large angle
    if abs(theta) >= 0.20:
        force = clamp(-sign(theta) * 3.0, -3.0, 3.0)
        return force

    # Main control law
    u_raw = -(0.5 * x + 0.1 * x_dot + 12.0 * theta + 5.0 * theta_dot)
    scale = 1.0 + 2.0 * (1.0 / (1.0 + math.exp(-(abs(theta) - 0.07) / 0.04)) - 0.5)
    force = clamp(scale * u_raw, -3.0, 3.0)
    return force

    # Default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
