import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    force = None
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    else:
        theta = pole_angle
        theta_abs = abs(theta)
        if theta_abs <= 0.02:
            tilt_norm = 0.0
        elif theta_abs >= 0.30:
            tilt_norm = 1.0
        else:
            tilt_norm = (theta_abs - 0.02) / (0.30 - 0.02)
        Kp_theta = 30.0 + (120.0 - 30.0) * tilt_norm
        Kd_theta = 3.0 + (40.0 - 3.0) * tilt_norm
        Kp_x = 0.4 + (1.2 - 0.4) * tilt_norm
        Kd_x = 0.2 + (0.6 - 0.2) * tilt_norm
        ff_grav = 0.1 * theta
        u = -(Kp_theta * theta + Kd_theta * pole_angular_velocity + Kp_x * cart_position + Kd_x * cart_velocity + ff_grav) + 0.02
        Fmax = 0.5 + 2.5 * tilt_norm
        force_raw = math.tanh(u / Fmax) * Fmax
        if force_raw > 3.0:
            force = 3.0
        elif force_raw < -3.0:
            force = -3.0
        else:
            force = force_raw
    if force is None:
        return random.uniform(-3, 3)
    return force
