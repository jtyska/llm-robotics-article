def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    def clamp(v, lo, hi):
        return max(lo, min(v, hi))
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0
    else:
        x = cart_position
        x_dot = cart_velocity
        theta = pole_angle
        theta_dot = pole_angular_velocity

        tilt_norm = clamp((abs(theta) - 0.05) / (0.20 - 0.05), 0.0, 1.0)

        Kp_theta = 4.0 + 2.0 * tilt_norm
        Kd_theta = 2.0 + 1.0 * tilt_norm
        Kp_cart = 0.02 + 0.03 * tilt_norm
        Kd_cart = 0.03 + 0.04 * tilt_norm

        gravity_ff = 0.85 * 9.81 * math.sin(theta)

        pole_pd = -(Kp_theta * math.sin(theta) + Kd_theta * theta_dot + 0.5 * theta_dot)
        cart_pd = -(Kp_cart * x + Kd_cart * x_dot)

        centre_bias = -0.07 * x

        u_raw = pole_pd + gravity_ff + cart_pd + centre_bias

        alpha = 0.6 + 0.6 * tilt_norm

        force = clamp(3.0 * math.tanh(alpha * u_raw), -3.0, 3.0)
        return force
    return random.uniform(-3, 3)
