```pseudo
# -------------------------------------------------
#  Cart‑Pole PD controller with tilt‑scaled gains
# -------------------------------------------------
IF NOT finite(x) OR NOT finite(x_dot) OR NOT finite(theta) OR NOT finite(theta_dot) THEN
    force ← 0
ELSE
    # 1️⃣ Normalised tilt (0 … 1)
    #    - below 0.05 rad we treat the pole as “perfectly upright”
    #    - above 0.20 rad we are at the failure limit (but we will never reach it)
    tilt_raw ← (abs(theta) - 0.05) / (0.20 - 0.05)
    tilt ← clamp(tilt_raw, 0.0, 1.0)

    # 2️⃣ Scale PD gains with tilt.
    #    When the pole is near vertical we use softer gains,
    #    when it leans more we increase the corrective effort.
    Kp_pole ← 12.0 * tilt + 4.0          # 4 → 16   (minimum gain when tilt=0)
    Kd_pole ← 2.5 * tilt + 1.0          # 1 → 3.5

    Kp_cart ← 0.8 * tilt + 0.2          # 0.2 → 1.0
    Kd_cart ← 0.2 * tilt + 0.05         # 0.05 → 0.25

    # 3️⃣ PD terms
    pole_pd   ← -Kp_pole * theta - Kd_pole * theta_dot
    cart_pd   ← -Kp_cart * x      - Kd_cart * x_dot

    # 4️⃣ Combine (no assist, no integral)
    raw_force ← pole_pd + cart_pd

    # 5️⃣ Saturate to the allowed action range
    force ← clamp(raw_force, -3.0, 3.0)
ENDIF
```

