def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    F = None
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        F = 0.0
    elif abs(pole_angle) > 0.14:
        F = -2.5 * pole_angle - 1.0 * pole_angular_velocity
    elif abs(pole_angle) > 0.08 and abs(pole_angular_velocity) > 0.07:
        F = -1.0 * pole_angular_velocity
    elif abs(pole_angle) <= 0.08:
        if abs(cart_position) > 0.4:
            F = -1.2 * cart_position - 0.8 * cart_velocity
        elif abs(cart_velocity) > 0.15:
            F = -0.8 * cart_velocity
        else:
            F = 0.0
    else:
        F = 0.0
    if F is None:
        return random.uniform(-3.0, 3.0)
    return max(-3.0, min(3.0, F))
