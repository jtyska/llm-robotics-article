[2025-08-28 16:59:37] [INFO] ############## LLM Overall strategy code 
def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    force = None
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    else:
        x = cart_position
        x_dot = cart_velocity
        theta = pole_angle
        theta_dot = pole_angular_velocity

        a = abs(theta)
        if a <= 0.05:
            tilt_norm = 0.0
        elif a >= 0.18:
            tilt_norm = 1.0
        else:
            tilt_norm = (a - 0.05) / (0.18 - 0.05)

        gain = tilt_norm ** 3

        Kp_theta = 10.0 + (70.0 - 10.0) * gain
        Kd_theta = 2.0 + (15.0 - 2.0) * gain
        Kp_x = 0.15 + (0.40 - 0.15) * gain
        Kd_x = 0.10 + (0.30 - 0.10) * gain

        ff_theta_dot = -0.5 * theta_dot

        u = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * x + Kd_x * x_dot + ff_theta_dot)

        max_force = 0.5 + 2.5 * gain

        force_raw = math.tanh(u / max_force) * max_force

        if force_raw > 3.0:
            force = 3.0
        elif force_raw < -3.0:
            force = -3.0
        else:
            force = force_raw

    if force is None:
        return random.uniform(-3, 3)
    return force
