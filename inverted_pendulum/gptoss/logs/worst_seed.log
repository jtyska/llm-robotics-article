    kp_x = 1.0
    kd_x = 0.5
    F_cart = -(kp_x * x + kd_x * xdot)

    F = F_angle + 0.3 * F_cart

    if F > 3.0:
        F = 3.0
    elif F < -3.0:
        F = -3.0

    return F
    # Default random action (fallback, should not be reached)
    return random.uniform(-3.0, 3.0)
