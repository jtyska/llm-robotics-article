def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    def clamp(v, lo, hi):
        return max(lo, min(v, hi))
    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity
    if (not math.isfinite(x) or not math.isfinite(x_dot) or
        not math.isfinite(theta) or not math.isfinite(theta_dot)):
        return 0.0
    if abs(theta) < 0.05:
        force = clamp(-(0.5 * x + 0.2 * x_dot), -3.0, 3.0)
        return force
    theta_abs = abs(theta)
    tilt_raw = (theta_abs - 0.05) / (0.18 - 0.05)
    tilt_norm = clamp(tilt_raw, 0.0, 1.0)
    gain = tilt_norm * tilt_norm
    Kp_theta = 8.0 + (45.0 - 8.0) * gain
    Kd_theta = 1.0 + (10.0 - 1.0) * gain
    Kp_x = 0.10 + (0.30 - 0.10) * gain
    Kd_x = 0.05 + (0.20 - 0.05) * gain
    u = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * x + Kd_x * x_dot)
    max_force = 0.8 + (3.0 - 0.8) * tilt_norm
    force_raw = math.tanh(u / max_force) * max_force
    force = clamp(force_raw, -3.0, 3.0)
    return force
    # fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
