# -------------------------------------------------
# Helper functions
# -------------------------------------------------
def clamp(v, lo, hi):
    return max(lo, min(hi, v))

def is_finite(*vals):
    return all(math.isfinite(v) for v in vals)

# -------------------------------------------------
# Parameters (tuned by hand from the observations)
# -------------------------------------------------
Kθ      = -8.0      # angle proportional gain
Kθdot   = -2.0      # angle derivative gain
Kx      = -1.0      # cart position proportional gain
Kxdot   = -0.8      # cart velocity derivative gain

# Weight that decides how much we rely on the cart‑PD.
# When the pole is far (|θ|≈0.2) we want w≈0 (pure angle PD).
# When the pole is very close (|θ|≈0) we want w≈1 (full blend).
def cart_weight(theta):
    # linear mapping on the interval [0, 0.08] → [0.5, 1.0]
    # for |θ| > 0.08 we keep w = 0.5 (still give some cart help)
    a = abs(theta)
    if a >= 0.08:
        return 0.5
    # a in [0,0.08] → w in [1.0,0.5] (more cart help the closer we are)
    return 1.0 - (a / 0.08) * 0.5   # 1.0 → 0.5

# -------------------------------------------------
# Main controller (called each timestep)
# -------------------------------------------------
def policy(state):
    x, theta, xdot, thetadot = state

    # 1) safety guard
    if not is_finite(x, theta, xdot, thetadot):
        return 0.0

    # 2) compute the two PD terms
    F_angle = Kθ * theta + Kθdot * thetadot
    F_cart  = Kx * x + Kxdot * xdot

    # 3) decide how much cart term to mix in
    w = cart_weight(theta)          # 0.5 ≤ w ≤ 1.0
    #   w = 1.0 → pure blend (both terms equally weighted)
    #   w = 0.5 → angle term dominates but we still keep some cart help

    # 4) blended force
    F = (1 - w) * F_angle + w * F_cart

    # 5) respect the actuator limits
    return clamp(F, -3.0, 3.0)
```

