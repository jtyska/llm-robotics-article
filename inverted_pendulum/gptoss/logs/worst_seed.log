import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # helper clamp
    def clamp(val, lo, hi):
        return max(lo, min(hi, val))
    # check finiteness
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0
    # large angle case
    if abs(pole_angle) >= 0.18:
        sign = -1.0 if pole_angle > 0 else 1.0 if pole_angle < 0 else 0.0
        force = clamp(-sign * 3.0, -3.0, 3.0)
        return force
    # blended control
    w_raw = (abs(pole_angle) - 0.02) / (0.12 - 0.02)
    w = clamp(w_raw, 0.0, 1.0)
    w = w * w * (3.0 - 2.0 * w)  # smoothstep
    u_cart = -(1.2 * cart_position + 0.5 * cart_velocity)
    u_angle = -(10.0 * pole_angle + 2.5 * pole_angular_velocity)
    raw_force = (1.0 - w) * u_cart + w * u_angle
    force = clamp(raw_force, -3.0, 3.0)
    return force
    # fallback random action (should not be reached)
    return random.uniform(-3.0, 3.0)
