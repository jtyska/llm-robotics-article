def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    if abs(pole_angle) >= 0.15:
        force_raw = -(45.0 * pole_angle + 12.0 * pole_angular_velocity)
        return 3.0 * math.tanh(force_raw / 3.0)
    elif abs(pole_angle) >= 0.02:
        u_angle = -(30.0 * pole_angle + 10.0 * pole_angular_velocity)
        scale_min = 1.0
        scale_max = 2.0
        scale = scale_min + (abs(pole_angle) - 0.02) * (scale_max - scale_min) / (0.15 - 0.02)
        if scale > scale_max:
            scale = scale_max
        if scale < scale_min:
            scale = scale_min
        u_angle_scaled = scale * u_angle
        u_cart = -(1.0 * cart_position + 0.25 * cart_velocity)
        force_raw = u_angle_scaled + u_cart
        return 3.0 * math.tanh(force_raw / 3.0)
    else:
        u_cart = -(1.5 * cart_position + 0.4 * cart_velocity)
        force_raw = u_cart
        return 3.0 * math.tanh(force_raw / 3.0)
    return random.uniform(-3, 3)
