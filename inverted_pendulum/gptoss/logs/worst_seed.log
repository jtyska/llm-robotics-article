def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # default random action
    force = random.uniform(-3.0, 3.0)
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    else:
        theta_abs = abs(pole_angle)
        if theta_abs <= 0.05:
            tilt_norm = 0.0
        elif theta_abs >= 0.20:
            tilt_norm = 1.0
        else:
            tilt_norm = (theta_abs - 0.05) / (0.20 - 0.05)
        Kx = 0.30 + (1.50 - 0.30) * tilt_norm
        Kx_dot = 0.45 + (2.50 - 0.45) * tilt_norm
        Ktheta = 2.00 + (12.0 - 2.00) * tilt_norm
        Ktheta_d = 0.80 + (6.00 - 0.80) * tilt_norm
        pole_pd = -(Ktheta * pole_angle + Ktheta_d * pole_angular_velocity)
        cart_pd = -(Kx * cart_position + Kx_dot * cart_velocity)
        gravity_ff = 9.81 * math.sin(pole_angle)
        u_raw = pole_pd + cart_pd + gravity_ff
        u_soft = 3.0 * math.tanh(u_raw / 3.0)
        if u_soft > 3.0:
            force = 3.0
        elif u_soft < -3.0:
            force = -3.0
        else:
            force = u_soft
        if abs(force) < 0.02:
            force = 0.0
    return force
