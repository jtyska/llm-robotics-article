def get_action(cart_position,pole_angle,cart_velocity,pole_angular_velocity):
    import math, random
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0
    aθ = abs(pole_angle)
    if aθ <= 0.06:
        Kθ = -8.0
        Kθd = -2.0
    elif aθ >= 0.14:
        Kθ = -15.0
        Kθd = -4.0
    else:
        t = (aθ - 0.06) / (0.14 - 0.06)
        Kθ = -8.0 + t * (-15.0 + 8.0)
        Kθd = -2.0 + t * (-4.0 + 2.0)
    F = Kθ * pole_angle + Kθd * pole_angular_velocity
    if not math.isfinite(F):
        return random.uniform(-3, 3)
    if F > 3.0:
        F = 3.0
    elif F < -3.0:
        F = -3.0
    return F
