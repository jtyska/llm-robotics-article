import random, math

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    def clamp(val, low, high):
        return max(low, min(high, val))

    tilt_norm = clamp((abs(theta) - 0.05) / (0.20 - 0.05), 0.0, 1.0)
    Kp_theta = 3.0 + 4.0 * tilt_norm
    Kd_theta = 1.5 + 2.5 * tilt_norm
    pole_pd = -(Kp_theta * math.sin(theta) + Kd_theta * theta_dot)
    gravity_ff = 0.95 * 9.81 * math.sin(theta)
    cart_pd = -(0.02 * x + 0.04 * x_dot)
    bias = -0.01 * x
    u_raw = pole_pd + gravity_ff + cart_pd + bias
    s = math.tanh(u_raw)
    force = clamp(3.0 * s, -3.0, 3.0)
    return force

    # default random action (unreachable in current logic)
    return random.uniform(-3.0, 3.0)
