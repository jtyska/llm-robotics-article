import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Unpack for readability
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # Rule 1: non‑finite values
    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    # Rule 2: large angle
    if abs(theta) >= 0.18:
        sign = math.copysign(1.0, theta)
        return -3.0 * sign

    # Base raw computation
    raw = (-1.0 * x) + (-0.5 * x_dot) + (-10.0 * theta) + (-2.5 * theta_dot)

    # Rule 3: near‑upright
    if abs(theta) <= 0.02:
        force = max(-3.0, min(3.0, raw))
        return force

    # Rule 4: intermediate angles
    gain_factor = 1.0 - 0.8 * (abs(theta) - 0.02) / (0.18 - 0.02)
    gain_factor = max(0.2, min(1.0, gain_factor))
    raw *= gain_factor
    force = max(-3.0, min(3.0, raw))
    return force

    # Default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
