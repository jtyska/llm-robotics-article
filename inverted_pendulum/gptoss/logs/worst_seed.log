import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non‑finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Cart controller
    u_cart = -(0.8 * cart_position + 0.4 * cart_velocity) - 0.001 * cart_position

    # Angle gains
    abs_theta = abs(pole_angle)
    if abs_theta <= 0.02:
        K_theta = 0.80
        K_theta_d = 0.30
    elif abs_theta >= 0.20:
        K_theta = 1.60
        K_theta_d = 0.80
    else:
        f = (abs_theta - 0.02) / (0.20 - 0.02)
        K_theta = 0.80 + f * (1.60 - 0.80)
        K_theta_d = 0.30 + f * (0.80 - 0.30)

    # Angle controller
    u_angle = -(K_theta * pole_angle + K_theta_d * pole_angular_velocity)

    # Combine
    u_raw = u_cart + u_angle

    # Clamp to action limits
    if u_raw > 3.0:
        action = 3.0
    elif u_raw < -3.0:
        action = -3.0
    else:
        action = u_raw

    return action

    # Fallback (should never be reached)
    return random.uniform(-3, 3)
