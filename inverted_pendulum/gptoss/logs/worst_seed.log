def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # Check for non-finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    theta = pole_angle
    # Compute tilt_raw
    if abs(theta) <= 0.05:
        tilt_raw = 0.0
    elif abs(theta) >= 0.20:
        tilt_raw = 1.0
    else:
        tilt_raw = (abs(theta) - 0.05) / (0.20 - 0.05)

    # Gains
    Kp_theta = 8.0 + (24.0 - 8.0) * tilt_raw
    Kd_theta = 3.0 + (9.0 - 3.0) * tilt_raw
    Kp_cart  = 0.10 + (0.15 - 0.10) * tilt_raw
    Kd_cart  = 0.02 + (0.03 - 0.02) * tilt_raw
    ff_gain  = 0.0 + (1.0 - 0.0) * tilt_raw

    x = cart_position
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity
    sign_theta = 1.0 if theta > 0 else (-1.0 if theta < 0 else 0.0)

    # Raw force computation
    force_raw = (-Kp_theta * theta
                 -Kd_theta * theta_dot
                 -Kp_cart  * x
                 -Kd_cart  * x_dot
                 +ff_gain * sign_theta)

    # Soft limiting
    force_soft = 3.0 * math.tanh(force_raw / 2.5)

    # Clamp to action bounds
    if force_soft > 3.0:
        action = 3.0
    elif force_soft < -3.0:
        action = -3.0
    else:
        action = force_soft

    return action

    # Default random action (fallback)
    return random.uniform(-3.0, 3.0)
