def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    abs_theta = abs(theta)
    if abs_theta <= 0.05:
        t = 0.0
    elif abs_theta >= 0.20:
        t = 1.0
    else:
        t = (abs_theta - 0.05) / (0.20 - 0.05)

    tp = t * t
    Kp_theta = 15.0 + 185.0 * tp
    Kd_theta = 0.8 + 49.2 * tp
    Kp_x = 0.05 + 0.45 * t
    Kd_x = 0.02 + 0.18 * t

    ff_grav = 0.48 * math.sin(theta)
    bias = 0.03 * (0 if theta == 0 else math.copysign(1, theta))

    u = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * x + Kd_x * x_dot + ff_grav) + bias

    Fsoft = 0.6 + 2.4 * tp
    if Fsoft > 3.0:
        Fsoft = 3.0

    force_raw = math.tanh(u / Fsoft) * Fsoft

    if force_raw > 3.0:
        force = 3.0
    elif force_raw < -3.0:
        force = -3.0
    else:
        force = force_raw

    return force

    # Default random action if no rule applies (unreachable in current logic)
    return random.uniform(-3.0, 3.0)
