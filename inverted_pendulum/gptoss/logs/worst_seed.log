import math, random

def clamp(value, low, high):
    return max(min(value, high), low)

def sign(x):
    return 1.0 if x > 0 else -1.0 if x < 0 else 0.0

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non‑finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    abs_angle = abs(pole_angle)

    # Small angle regime
    if abs_angle <= 0.015:
        raw = -(0.8 * cart_position + 0.4 * cart_velocity) - 0.05 * sign(cart_position)
        return clamp(raw, -3.0, 3.0)

    # Intermediate angle regime
    if abs_angle < 0.18:
        u_angle = -(12.0 * pole_angle + 3.0 * pole_angular_velocity)
        scale = 1.0 + (abs_angle - 0.015) / (0.18 - 0.015)
        if scale > 2.0:
            scale = 2.0
        blend = (abs_angle - 0.015) / (0.18 - 0.015)
        u_cart = -(0.8 * cart_position + 0.4 * cart_velocity)
        raw = (1.0 - blend) * u_cart + blend * u_angle
        raw = scale * raw
        return 3.0 * math.tanh(raw / 3.0)

    # Large angle regime
    if abs_angle >= 0.18:
        return -sign(pole_angle) * 3.0

    # Fallback random action
    return random.uniform(-3.0, 3.0)
