All gains are chosen from the successful parts of the previous experiments and then blended with smooth weighting functions so that the controller changes continuously as the pole angle grows.

```
# ------------------------------------------------------------------
# Helper functions
# ------------------------------------------------------------------
sign(v)      =  1.0 if v > 0 else -1.0 if v < 0 else 0.0
clamp(v, lo, hi) = max(lo, min(hi, v))

# ------------------------------------------------------------------
# 1. Safety check
# ------------------------------------------------------------------
if not (isFinite(x) and isFinite(theta) and isFinite(x_dot) and isFinite(theta_dot)):
    force = 0.0
else:

    # ----------------------------------------------------------------
    # 2. Hard‑limit: if the pole is already out of the allowed band,
    #    apply maximum corrective force (bang‑bang) to try to rescue.
    # ----------------------------------------------------------------
    if abs(theta) >= 0.18:
        force = clamp(-sign(theta) * 3.0, -3.0, 3.0)   # max push opposite tilt
        # no further terms – we are in emergency mode
    else:
        # ----------------------------------------------------------------
        # 3. Compute weighting factors (smooth 0‑1 ramps)
        # ----------------------------------------------------------------
        # w_angle = 1   for |θ| ≤ 0.02
        # w_angle = 0   for |θ| ≥ 0.18
        w_angle = clamp((0.18 - abs(theta)) / (0.18 - 0.02), 0.0, 1.0)

        # w_cart   = 1   for |θ| ≤ 0.08   (cart‑centering active)
        # w_cart   = 0   for |θ| ≥ 0.18
        w_cart  = clamp((0.18 - abs(theta)) / (0.18 - 0.08), 0.0, 1.0)

        # ----------------------------------------------------------------
        # 4. Angle PD + tiny I term (acts for the whole range)
        # ----------------------------------------------------------------
        Kθ      = 13.0          # proportional on angle
        Kθ_dot  = 2.5           # derivative on angular velocity
        Kiθ     = 0.08          # very small integral (helps steady‑state)

        # keep a running integral (reset when we go into emergency mode)
        angle_integral += theta * dt
        # anti‑windup: clamp the integral contribution
        angle_integral = clamp(angle_integral, -0.5, 0.5)

        u_angle = -(Kθ * theta + Kθ_dot * theta_dot + Kiθ * angle_integral)

        # ----------------------------------------------------------------
        # 5. Cart‑centering PD (only active when the pole is close to vertical)
        # ----------------------------------------------------------------
        Kx      = 0.9
        Kx_dot  = 0.35
        u_cart  = -(Kx * x + Kx_dot * x_dot)

        # ----------------------------------------------------------------
        # 6. Blend the two control channels
        # ----------------------------------------------------------------
        # Scale the angle term so that the total never exceeds the actuator limit.
        # The scaling grows from 1.0 (tiny angles) to 2.0 (|θ|≈0.18).
        scale_angle = 1.0 + (abs(theta) - 0.02) / (0.18 - 0.02)   # 1 … 2
        scale_angle = clamp(scale_angle, 1.0, 2.0)

        raw_force = w_angle * scale_angle * u_angle + w_cart * u_cart

        # ----------------------------------------------------------------
        # 7. Saturate and dead‑zone
        # ----------------------------------------------------------------
        force = clamp(raw_force, -3.0, 3.0)

        if abs(force) < 0.02:          # avoid jitter around zero
            force = 0.0
