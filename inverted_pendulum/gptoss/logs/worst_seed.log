def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    else:
        abs_theta = abs(pole_angle)
        if abs_theta <= 0.05:
            tilt_norm = 0.0
        elif abs_theta >= 0.18:
            tilt_norm = 1.0
        else:
            tilt_norm = (abs_theta - 0.05) / (0.18 - 0.05)
        Kp_cart = 0.30 + 1.20 * tilt_norm
        Kd_cart = 0.45 + 2.00 * tilt_norm
        Kp_pole = 2.00 + 10.0 * tilt_norm
        Kd_pole = 0.80 + 5.20 * tilt_norm
        pole_pd = -(Kp_pole * pole_angle + Kd_pole * pole_angular_velocity)
        cart_pd = -(Kp_cart * cart_position + Kd_cart * cart_velocity)
        gravity_ff = 9.81 * math.sin(pole_angle)
