import random
import math

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    th = pole_angle
    x_dot = cart_velocity
    th_dot = pole_angular_velocity

    def is_finite(v):
        return math.isfinite(v)

    def sign(v):
        return 1.0 if v > 0 else -1.0 if v < 0 else 0.0

    def clamp(v, lo, hi):
        return max(lo, min(v, hi))

    # Rule 1: non‑finite inputs
    if (not is_finite(x) or not is_finite(th) or
        not is_finite(x_dot) or not is_finite(th_dot)):
        return 0.0

    # Rule 2: angle beyond limit
    if abs(th) >= 0.20:
        return clamp(-sign(th) * 0.8, -3.0, 3.0)

    # Rule 3: main controller
    K_th = 15.0
    K_thdot = 8.0
    K_x = 0.8
    K_xdot = 0.4

    u_angle = -(K_th * th + K_thdot * th_dot)
    u_cart = -(K_x * x + K_xdot * x_dot)

    if abs(th) <= 0.02:
        raw_force = u_cart
    else:
        theta_abs = abs(th)

        if theta_abs <= 0.10:
            scale = 1.0 + 0.5 * (theta_abs - 0.02) / (0.10 - 0.02)
        else:
            scale = 1.5 + 1.5 * (theta_abs - 0.10) / (0.20 - 0.10)

        scale = max(1.0, min(scale, 3.0))

        cart_factor = max(0.0, 1.0 - (theta_abs - 0.02) / (0.10 - 0.02))

        raw_force = scale * (u_angle + cart_factor * u_cart)

    force = clamp(raw_force, -3.0, 3.0)
    return force

    # Default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
