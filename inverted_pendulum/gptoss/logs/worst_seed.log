import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    def is_finite(v):
        return math.isfinite(v)
    def clamp(v, lo, hi):
        return max(lo, min(v, hi))
    def sign(v):
        return 1.0 if v > 0 else -1.0 if v < 0 else 0.0
    def deadzone(v, dz):
        return 0.0 if abs(v) < dz else v
    def smoothstep(t):
        return t * t * (3.0 - 2.0 * t)

    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (is_finite(x) and is_finite(theta) and is_finite(x_dot) and is_finite(theta_dot)):
        return 0.0

    if abs(theta) >= 0.20:
        force = clamp(-sign(theta) * 3.0, -3.0, 3.0)
        return force

    if abs(theta) <= 0.005:
        raw = -(0.8 * x + 0.6 * x_dot + 15.0 * theta + 16.0 * theta_dot)
        raw = deadzone(raw, 0.005)
        force = clamp(raw, -3.0, 3.0)
        return force

    if abs(theta) <= 0.04:
        raw = -(0.8 * x + 0.6 * x_dot + 15.0 * theta + 16.0 * theta_dot)
        raw = deadzone(raw, 0.005)
        force = clamp(raw, -3.0, 3.0)
        return force

    # else case
    u_angle = -(15.0 * theta + 16.0 * theta_dot)
    t = (abs(theta) - 0.04) / (0.20 - 0.04)
    t = clamp(t, 0.0, 1.0)
    scale = 1.0 + 1.5 * smoothstep(t)
    raw = scale * u_angle
    raw = deadzone(raw, 0.005)
    force = clamp(raw, -3.0, 3.0)
    return force

    # default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
