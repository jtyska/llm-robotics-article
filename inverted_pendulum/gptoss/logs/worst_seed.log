```text
# Helper functions
sign(v)   =  1  if v > 0,  -1 if v < 0,  0 otherwise
clip(v,a,b)= max(a, min(b, v))

# State variables
x        = cart position
x_dot    = cart velocity
theta    = pole angle          (rad)
theta_dot= pole angular velocity (rad/s)

# -----------------------------------------------------------------
IF ( NOT isfinite(x) OR NOT isfinite(x_dot) OR
     NOT isfinite(theta) OR NOT isfinite(theta_dot) ) THEN
    force ← 0.0

ELSE IF ( abs(theta) ≥ 0.18 ) THEN
    # Danger zone – maximum corrective push
    force ← -3.0 * sign(theta)

ELSE IF ( abs(theta) ≤ 0.02 ) THEN
    # Very safe inner band – gentle cart PD + tiny angular damping
    raw   ← -( 1.0 * x
               + 0.5 * x_dot
               + 0.1 * theta_dot )
    force ← clip(raw, -3.0, 3.0)

ELSE
    # Intermediate band (0.02 < |θ| < 0.18) – linear state‑feedback
    # Gains have been tuned to stay inside the ±3 N envelope
    kx      = 0.6
    kx_dot  = 0.3
    kθ      = 4.5
    kθ_dot  = 2.5

    raw ← -( kx     * x
             + kx_dot * x_dot
             + kθ     * theta
             + kθ_dot * theta_dot )
    force ← clip(raw, -3.0, 3.0)
END IF
```

