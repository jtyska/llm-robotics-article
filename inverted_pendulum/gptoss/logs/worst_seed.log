import random, math

def clamp(value, low, high):
    return max(low, min(value, high))

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    if abs(theta) < 0.02:
        return 0.0

    tilt_raw = (abs(theta) - 0.05) / (0.18 - 0.05)
    tilt_norm = clamp(tilt_raw, 0.0, 1.0)
    gain = tilt_norm * tilt_norm

    Kp_theta = 8.0 + (35.0 - 8.0) * gain
    Kd_theta = 1.0 + (5.0 - 1.0) * gain
    Kp_x = 0.20 + (0.30 - 0.20) * gain
    Kd_x = 0.05 + (0.10 - 0.05) * gain

    u = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * x + Kd_x * x_dot)
    force = clamp(u, -3.0, 3.0)
    return force

    # fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
