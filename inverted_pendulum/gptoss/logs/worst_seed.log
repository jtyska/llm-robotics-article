def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    if abs(theta) > 0.20:
        return 0.0

    if abs(theta) < 0.02:
        u_cart = -(0.80 * x + 0.40 * x_dot) - 0.001 * x
        u_angle = 0.0
        u_g = -0.5 * math.sin(theta)
        u_raw = u_cart + u_angle + u_g
        u_safety = max(-3.0 + 0.05, min(u_raw, 3.0 - 0.05))
        action = max(-3.0, min(u_safety, 3.0))
        return action

    # else: 0.02 <= abs(theta) <= 0.20
    s = (abs(theta) - 0.02) / (0.20 - 0.02)
    s = max(0.0, min(s, 1.0))

    K_theta = 0.8 + s * (15.0 - 0.8)          # angle proportional gain
    K_theta_d = 0.3 + s * (5.0 - 0.3)         # angle derivative gain

    K_x = 0.80 * (1.0 - s) + 0.30 * s         # cart proportional gain
    K_x_d = 0.40 * (1.0 - s) + 0.15 * s       # cart derivative gain

    u_cart = -(K_x * x + K_x_d * x_dot) - 0.001 * x
    u_angle = -(K_theta * theta + K_theta_d * theta_dot)
    u_g = -0.5 * math.sin(theta)

    u_raw = u_cart + u_angle + u_g
    u_safety = max(-3.0 + 0.05, min(u_raw, 3.0 - 0.05))
    action = max(-3.0, min(u_safety, 3.0))
    return action

    # fallback (should never be reached)
    return random.uniform(-3, 3)
