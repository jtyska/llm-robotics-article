    // ----- 1. base PD on pole angle -----------------
    // Gains are larger when the pole is farther from vertical
    //   kθ grows from 8 → 20   (when |θ| goes from 0.02 → 0.15)
    //   kθ̇ grows from 2 → 6   (same interval)
    IF ( abs(theta) ≤ 0.02 )
        k_theta   ← 8.0
        k_thetad  ← 2.0
    ELSE
        // linear interpolation
        α ← (abs(theta) - 0.02) / (0.15 - 0.02)      // α ∈ (0,1)
        k_theta   ← 8.0  + α * (20.0 - 8.0)          // 8 → 20
        k_thetad  ← 2.0  + α * (6.0  - 2.0)          // 2 → 6
    ENDIF

    pole_pd ← -( k_theta   * theta
               + k_thetad  * theta_dot )

    // ----- 2. weak cart‑position correction ----------
    // Only needed when the pole is almost upright
    IF ( abs(theta) ≤ 0.02 )
        cart_pd ← -( 0.5 * x + 0.1 * x_dot )
    ELSE
        cart_pd ← -( 0.2 * x + 0.05 * x_dot )
    ENDIF

    // ----- 3. combine and scale ----------------------
    raw ← pole_pd + cart_pd

    // Scale the whole command so that it never exceeds the actuator limit.
    // If |raw| ≤ 3 we keep it unchanged; otherwise we shrink proportionally.
    IF ( abs(raw) > 3.0 )
        raw ← 3.0 * raw / abs(raw)          // keep sign, limit magnitude
    ENDIF

    force ← raw
ENDIF
```

