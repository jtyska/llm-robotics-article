import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    tilt_raw = (abs(pole_angle) - 0.05) / (0.18 - 0.05)
    tilt_raw = max(0.0, min(tilt_raw, 1.0))
    Kp_theta = 8.0 + (12.0 - 8.0) * tilt_raw
    Kd_theta = 3.0 + (5.0 - 3.0) * tilt_raw
    Kp_cart = 0.10 + (0.20 - 0.10) * tilt_raw
    Kd_cart = 0.02 + (0.04 - 0.02) * tilt_raw
    ff_gain = 0.0 + (0.30 - 0.0) * tilt_raw
    sign_theta = math.copysign(1.0, pole_angle) if pole_angle != 0 else 0.0
    force_raw = (-Kp_theta * pole_angle
                 - Kd_theta * pole_angular_velocity
                 - Kp_cart * cart_position
                 - Kd_cart * cart_velocity
                 + ff_gain * sign_theta)
    action = 3.0 * math.tanh(force_raw / 3.0)
    return action
    return random.uniform(-3, 3)
