import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        action = 0.0
    else:
        tilt_norm = (abs(pole_angle) - 0.05) / (0.20 - 0.05)
        if tilt_norm < 0:
            tilt_norm = 0.0
        if tilt_norm > 1:
            tilt_norm = 1.0

        Kp = 4.0 + 6.0 * tilt_norm
        Kd = 2.0 + 4.0 * tilt_norm

        pole_pd = -(Kp * math.sin(pole_angle) + Kd * pole_angular_velocity)
        gravity_ff = 0.95 * 9.81 * math.sin(pole_angle)
        cart_pd = -(0.05 * cart_position + 0.08 * cart_velocity)
        bias = -0.02 * cart_position

        u_raw = pole_pd + gravity_ff + cart_pd + bias

        alpha = 1.0 + 0.5 * tilt_norm
        temp = alpha * u_raw
        tanh_val = math.tanh(temp)
        force = 3.0 * tanh_val

        if force > 3.0:
            force = 3.0
        if force < -3.0:
            force = -3.0

        action = force

    if action is None:
        return random.uniform(-3, 3)
    return action
