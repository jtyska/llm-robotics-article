import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    def clip(val, lo, hi):
        return max(lo, min(val, hi))

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    if abs(theta) >= 0.18:
        speed_factor = 1.0 - 0.3 * min(1.0, abs(theta_dot) / 4.0)
        force = -3.0 * (1 if theta > 0 else -1) * speed_factor
        return clip(force, -3.0, 3.0)

    if abs(theta) <= 0.02:
        raw = -(1.0 * x + 0.5 * x_dot)
        return clip(raw, -3.0, 3.0)

    if abs(theta) <= 0.12:
        raw = -(8.0 * theta + 2.5 * theta_dot + 1.0 * x + 0.5 * x_dot)
        return clip(raw, -3.0, 3.0)

    gain = 1.0 + (abs(theta) - 0.12) / (0.18 - 0.12)  # gain ∈ [1,2]
    raw = -(8.0 * theta + 2.5 * theta_dot + 1.0 * x + 0.5 * x_dot)
    force = gain * raw
    return clip(force, -3.0, 3.0)

    # default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
