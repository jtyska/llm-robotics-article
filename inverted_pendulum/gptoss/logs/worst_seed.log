import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    def clamp(v, lo, hi):
        return max(lo, min(hi, v))
    def sign(v):
        return 1 if v > 0 else -1 if v < 0 else 0

    # Check for non-finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Large angle correction
    if abs(pole_angle) >= 0.18:
        return -3.0 * sign(pole_angle)

    # Near-vertical small angle handling
    if abs(pole_angle) <= 0.015:
        temp = -(1.0 * cart_position + 0.5 * cart_velocity)
        force = clamp(temp, -3.0, 3.0)
        if abs(force) < 0.01:
            force = 0.0
        return force

    # General case
    alpha = (abs(pole_angle) - 0.015) / (0.18 - 0.015)
    scale = 1.0 + alpha * alpha
    if scale > 2.2:
        scale = 2.2
    u_angle = -(14.0 * pole_angle + 3.0 * pole_angular_velocity)
    pos_corr = -(1.0 * cart_position + 0.5 * cart_velocity) * 0.15
    raw = scale * u_angle + pos_corr
    force = clamp(raw, -3.0, 3.0)
    if abs(force) < 0.01:
        force = 0.0
    return force

    # Fallback (should not be reached)
    return random.uniform(-3.0, 3.0)
