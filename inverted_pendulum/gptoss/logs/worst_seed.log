def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    action = None
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        action = 0.0
    else:
        k_x = 0.8
        k_xdot = 0.4
        k_theta = 12.0
        k_thetadot = 8.0

        u_lin = -(k_x * cart_position + k_xdot * cart_velocity +
                  k_theta * pole_angle + k_thetadot * pole_angular_velocity)

        theta_abs = abs(pole_angle)
        gain = 1.0 + 2.0 * (theta_abs - 0.02) / (0.20 - 0.02)
        if gain < 1.0:
            gain = 1.0
        if gain > 3.0:
            gain = 3.0

        u_raw = u_lin * gain
        u_smooth = 3.0 * math.tanh(u_raw / 3.0)

        if u_smooth > 3.0:
            action = 3.0
        elif u_smooth < -3.0:
            action = -3.0
        else:
            action = u_smooth

    if action is None:
        return random.uniform(-3, 3)
    return action
