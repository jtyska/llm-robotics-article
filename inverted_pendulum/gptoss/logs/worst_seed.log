import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    abs_theta = abs(theta)
    if abs_theta <= 0.10:
        tilt = 0.0
    elif abs_theta >= 0.20:
        tilt = 1.0
    else:
        tilt = (abs_theta - 0.10) / (0.20 - 0.10)

    boost = 1.0 / (1.0 + math.exp(-12.0 * (tilt - 0.5)))

    base_force = (-12.0) * theta + (-2.5) * theta_dot + (-0.8) * x + (-0.2) * x_dot

    sign_theta = 0.0
    if theta > 0:
        sign_theta = 1.0
    elif theta < 0:
        sign_theta = -1.0

    extra = -3.0 * sign_theta * boost * tilt
    raw_force = base_force + extra

    if raw_force > 3.0:
        force = 3.0
    elif raw_force < -3.0:
        force = -3.0
    else:
        force = raw_force

    return force if force is not None else random.uniform(-3.0, 3.0)
