def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # Check for non‑finite inputs
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity
    abs_theta = abs(theta)

    # Compute interpolation factor t based on pole angle magnitude
    if abs_theta <= 0.05:
        t = 0.0
    elif abs_theta >= 0.20:
        t = 1.0
    else:
        t = (abs_theta - 0.05) / (0.20 - 0.05)

    # Gains
    Kp_theta = 30.0 + 120.0 * t
    Kd_theta = 2.0 + 8.0 * t
    Kp_x = 0.10 + 0.30 * t
    Kd_x = 0.02 + 0.08 * t

    # Feed‑forward gravity compensation and bias
    ff_grav = 0.48 * math.sin(theta)
    sign_theta = 1.0 if theta > 0 else (-1.0 if theta < 0 else 0.0)
    bias = 0.03 * sign_theta * (1.0 + 1.5 * t)

    # Control law
    u = -(Kp_theta * theta +
          Kd_theta * theta_dot +
          Kp_x * x +
          Kd_x * x_dot +
          ff_grav) + bias

    # Saturate to action limits
    if u > 3.0:
        force = 3.0
    elif u < -3.0:
        force = -3.0
    else:
        force = u

    return force
    # Default random action if no rule applies (unreachable in current logic)
    return random.uniform(-3.0, 3.0)
