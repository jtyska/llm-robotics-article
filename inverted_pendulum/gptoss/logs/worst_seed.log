import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    xdot = cart_velocity
    thetadot = pole_angular_velocity

    # default action if no rule matches
    action = None

    # Rule 1: non‑finite values
    if not (math.isfinite(x) and math.isfinite(xdot) and math.isfinite(theta) and math.isfinite(thetadot)):
        action = 0.0

    # Rule 2: near zero state
    elif abs(x) < 0.01 and abs(xdot) < 0.01 and abs(theta) < 0.02 and abs(thetadot) < 0.02:
        action = 0.0

    else:
        a = abs(theta)

        if a <= 0.04:
            kθ = 2.0
            kθd = 0.5
            kx = 0.0
            kxd = 0.0
        elif a <= 0.08:
            kθ = 5.0
            kθd = 1.0
            kx = 0.8
            kxd = 0.4
        elif a <= 0.12:
            kθ = 10.0
            kθd = 2.5
            kx = 1.2
            kxd = 0.6
        else:
            kθ = 14.0
            kθd = 3.5
            kx = 1.5
            kxd = 0.8

        action = -(kx * x + kxd * xdot + kθ * theta + kθd * thetadot)

        if abs(x) > 0.25:
            sign_x = 1.0 if x > 0 else -1.0 if x < 0 else 0.0
            action -= 0.5 * sign_x * (abs(x) - 0.25)

        # clamp to action limits
        if action > 3.0:
            action = 3.0
        elif action < -3.0:
            action = -3.0

    if action is None:
        action = random.uniform(-3.0, 3.0)

    return action
