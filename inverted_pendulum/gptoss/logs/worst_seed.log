def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # Check for non‑finite inputs
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    else:
        x = cart_position
        x_dot = cart_velocity
        theta = pole_angle
        theta_dot = pole_angular_velocity

        # Compute tilt_raw and clamp to [0,1]
        tilt_raw = (abs(theta) - 0.05) / (0.18 - 0.05)
        if tilt_raw < 0.0:
            tilt_raw = 0.0
        if tilt_raw > 1.0:
            tilt_raw = 1.0

        # Determine g_low and g_high
        if tilt_raw <= 0.5:
            g_low = tilt_raw * tilt_raw
            g_high = 0.0
        else:
            g_low = 0.25
            g_high = (tilt_raw - 0.5) * (tilt_raw - 0.5)

        # Gains for pole
        Kp_theta = 8.0 + 32.0 * g_low + 80.0 * g_high
        Kd_theta = 1.5 + 8.0 * g_low + 20.0 * g_high

        pole_effort = -Kp_theta * theta - Kd_theta * theta_dot
        if abs(theta) > 0.15:
            pole_effort *= 1.5

        # Gains for cart
        Kp_cart = 0.10 * (1.0 - tilt_raw)
        Kd_cart = 0.025 * (1.0 - tilt_raw)

        cart_effort = -Kp_cart * x - Kd_cart * x_dot
        centre_bias = -0.07 * (1.0 - tilt_raw) * x

        force_raw = pole_effort + cart_effort + centre_bias
        force = 3.0 * math.tanh(force_raw * 0.25)

        # Clamp final force to allowed range
        if force > 3.0:
            force = 3.0
        if force < -3.0:
            force = -3.0

        return force
    # Default random action if no rule applied
    return random.uniform(-3.0, 3.0)
