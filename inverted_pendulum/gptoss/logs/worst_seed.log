import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    u = None
    if abs(theta) <= 0.015:
        u = -(8 * theta + 4 * theta_dot) - (0.3 * x + 0.1 * x_dot)
    elif abs(theta) <= 0.10:
        gain = 1 + 2 * (abs(theta) - 0.015) / (0.10 - 0.015)
        u_base = -(12 * theta + 8 * theta_dot) - (0.8 * x + 0.4 * x_dot)
        u = gain * u_base
    elif abs(theta) <= 0.20:
        gain = 3 + 2 * (abs(theta) - 0.10) / (0.20 - 0.10)
        if gain > 5:
            gain = 5
        u_base = -(12 * theta + 8 * theta_dot) - (0.4 * x + 0.2 * x_dot)
        u = gain * u_base
    else:
        u = 0.0

    if u is None:
        return random.uniform(-3, 3)

    force = 3.0 * math.tanh(u / 3.0)
    if force > 3.0:
        force = 3.0
    elif force < -3.0:
        force = -3.0
    return force
