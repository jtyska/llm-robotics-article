import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Helper functions
    def clamp(val, min_val, max_val):
        return max(min(val, max_val), min_val)
    def deadzone(val, dz):
        return 0.0 if abs(val) < dz else val

    # Unpack for readability
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # Rule 1: non‑finite check
    if not all(math.isfinite(v) for v in (x, theta, x_dot, theta_dot)):
        return 0.0

    # Rule 2: large angle
    if abs(theta) >= 0.18:
        sign_theta = math.copysign(1.0, theta)
        force = -sign_theta * 3.0
        return clamp(force, -3.0, 3.0)

    # Rule 3: near‑vertical angle
    if abs(theta) <= 0.04:
        raw = -(0.9 * x + 0.7 * x_dot)
        raw = deadzone(raw, 0.02)
        return clamp(raw, -3.0, 3.0)

    # Rule 4: intermediate angle (t computed but no further action defined)
    t = (abs(theta) - 0.04) / (0.18 - 0.04)

    # Default random action
    return random.uniform(-3.0, 3.0)
