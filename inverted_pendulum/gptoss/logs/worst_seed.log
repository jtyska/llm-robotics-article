def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0
    action = None
    if abs(pole_angle) >= 0.18:
        action = -3.0 * (1 if pole_angle > 0 else -1)
    elif abs(pole_angle) <= 0.02:
        raw = -(1.0 * cart_position + 0.5 * cart_velocity + 0.1 * pole_angular_velocity)
        action = max(-3.0, min(3.0, raw))
    else:
        raw = -(0.6 * cart_position + 0.3 * cart_velocity + 4.5 * pole_angle + 2.5 * pole_angular_velocity)
        action = max(-3.0, min(3.0, raw))
    if action is None:
        return random.uniform(-3, 3)
    return action
