import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        force = 0.0
        return force

    tilt_norm = (abs(theta) - 0.05) / (0.18 - 0.05)
    if tilt_norm < 0.0:
        tilt_norm = 0.0
    if tilt_norm > 1.0:
        tilt_norm = 1.0

    p = 3.0
    gain_factor = tilt_norm ** p

    Kp_cart = 0.30 + (0.90 - 0.30) * gain_factor
    Kd_cart = 0.45 + (1.20 - 0.45) * gain_factor
    Kp_pole = 2.0 + (7.0 - 2.0) * gain_factor
    Kd_pole = 0.8 + (4.0 - 0.8) * gain_factor

    pole_pd = -(Kp_pole * theta + Kd_pole * theta_dot)
    cart_pd = -(Kp_cart * x + Kd_cart * x_dot)

    gravity_ff = 9.81 * math.sin(theta)

    u_raw = pole_pd + cart_pd + gravity_ff
    u_soft = 3.0 * math.tanh(u_raw / 3.0)

    if u_soft > 3.0:
        force = 3.0
    elif u_soft < -3.0:
        force = -3.0
    else:
        force = u_soft

    if abs(force) < 0.01:
        force = 0.0

    return force

    # Default random action if no rule applies
    # return random.uniform(-3, 3)
