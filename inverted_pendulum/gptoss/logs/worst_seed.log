import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    force = None
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    else:
        x = cart_position
        theta = pole_angle
        x_dot = cart_velocity
        theta_dot = pole_angular_velocity

        tilt_raw = (abs(theta) - 0.05) / 0.13
        tilt = max(0.0, min(tilt_raw, 1.0))
        scale = 1.0 + 8.0 * tilt * tilt

        Kp_pole = 12.0 * scale
        Kd_pole = 2.0 * scale
        pole_pd = -Kp_pole * theta - Kd_pole * theta_dot

        cart_pd = -0.8 * x - 0.5 * x_dot

        ff_gain = 0.2 * tilt
        sign_theta = math.copysign(1.0, theta) if theta != 0 else 0.0
        ff_term = -ff_gain * theta_dot * sign_theta

        raw_force = pole_pd + cart_pd + ff_term
        if abs(theta) >= 0.20:
            raw_force = -3.0 * sign_theta

        force = max(-3.0, min(raw_force, 3.0))

    if force is None:
        return random.uniform(-3.0, 3.0)
    return force
