def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # Check for finite values
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0
    # Base position control
    u_pos = -(0.6 * cart_position + 0.25 * cart_velocity)
    # Pole‑feedback gain
    abs_theta = abs(pole_angle)
    if abs_theta <= 0.015:
        pole_gain = 0.0
    else:
        norm = (abs_theta - 0.015) / (0.20 - 0.015)
        pole_gain = 1.0 + (5.0 - 1.0) * (norm * norm)
        if pole_gain > 5.0:
            pole_gain = 5.0
    # Pole‑feedback term
    u_pole = -pole_gain * (12.0 * pole_angle + 8.0 * pole_angular_velocity)
    # Combine
    u_raw = u_pos + u_pole
    # Soft saturation
    u_soft = 3.0 * math.tanh(u_raw / 3.0)
    # Hard clipping to actuator limits
    if u_soft > 3.0:
        action = 3.0
    elif u_soft < -3.0:
        action = -3.0
    else:
        action = u_soft
    return action
    # Default random action if no rule applies (unreachable)
    return random.uniform(-3, 3)
