import random, math

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    def clamp(v, lo, hi):
        return max(lo, min(v, hi))

    def sign(v):
        return 1.0 if v > 0 else -1.0 if v < 0 else 0.0

    # Rule 1: non‑finite values
    if not (math.isfinite(x) and math.isfinite(theta) and math.isfinite(x_dot) and math.isfinite(theta_dot)):
        return 0.0

    # Rule 2: large angle
    if abs(theta) >= 0.20:
        force = clamp(-sign(theta) * 3.0, -3.0, 3.0)
        return force

    # Rule 3: very small angle
    if abs(theta) <= 0.015:
        u_pos = -(0.9 * x + 0.6 * x_dot)
        force = clamp(u_pos, -3.0, 3.0)
        if abs(force) < 0.01:
            force = 0.0
        return force

    # Rule 4: moderate angle
    if abs(theta) <= 0.07:
        u_angle = -(13.0 * theta + 2.5 * theta_dot)
        u_pos = -(0.9 * x + 0.6 * x_dot) * 0.3
        raw = u_angle + u_pos
        force = clamp(raw, -3.0, 3.0)
        if abs(force) < 0.01:
            force = 0.0
        return force

    # Rule 5: larger angle but still within limits
    scale_slope = (2.5 - 1.0) / (0.20 - 0.015)
    scale = 1.0 + scale_slope * (abs(theta) - 0.015)
    scale = clamp(scale, 1.0, 2.5)
    u_angle = -(13.0 * theta + 2.5 * theta_dot)
    u_pos = -(0.9 * x + 0.6 * x_dot) * 0.05
    raw = scale * u_angle + u_pos
    force = clamp(raw, -3.0, 3.0)
    if abs(force) < 0.01:
        force = 0.0
    return force

    # Default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
