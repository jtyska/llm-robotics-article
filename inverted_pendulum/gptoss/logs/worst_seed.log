import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    abs_angle = abs(pole_angle)

    # Failure angle condition
    if abs_angle >= 0.20:
        return 0.0

    # Small angle condition
    if abs_angle <= 0.01:
        force = -(0.9 * cart_position + 0.6 * cart_velocity)
        return max(min(force, 3.0), -3.0)

    # Moderate angle condition
    if abs_angle <= 0.07:
        u_angle = -(13.0 * pole_angle + 2.5 * pole_angular_velocity)
        u_pos = -(0.9 * cart_position + 0.6 * cart_velocity) * 0.15
        force = u_angle + u_pos
        return max(min(force, 3.0), -3.0)

    # Larger angle but still within limits
    scale = 1.0 + (abs_angle - 0.07) * 1.33
    scale = min(max(scale, 1.0), 2.8)
    u_angle = -(13.0 * pole_angle + 2.5 * pole_angular_velocity)
    u_pos = -(0.9 * cart_position + 0.6 * cart_velocity) * 0.05
    force = scale * u_angle + u_pos
    return max(min(force, 3.0), -3.0)

    # Default random action (should not be reached)
    return random.uniform(-3.0, 3.0)
