def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random

    # Check for non‑finite inputs
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # Large angle case
    if abs(theta) >= 0.18:
        if theta > 0:
            sign = 1.0
        elif theta < 0:
            sign = -1.0
        else:
            sign = 0.0
        force = -sign * 3.0
    else:
        # Angle PD controller (no integral)
        u_angle_raw = -(13.0 * theta + 2.5 * theta_dot)
        u_angle_raw = max(min(u_angle_raw, 2.0), -2.0)

        # Gain scaling (1 → 2.2)
        alpha = (abs(theta) - 0.02) / (0.18 - 0.02)
        alpha = max(min(alpha, 1.0), 0.0)
        scale = 1.0 + 1.2 * alpha
        u_angle = scale * u_angle_raw

        # Continuous cart‑centering term
        if abs(theta) <= 0.08:
            cent_gain = 1.0 - (abs(theta) / 0.08)
        else:
            cent_gain = 0.0
        u_cart = -(0.9 * x + 0.35 * x_dot) * cent_gain * 0.15

        # Combine terms
        raw_force = u_angle + u_cart
        force = max(min(raw_force, 3.0), -3.0)

    # Output dead‑zone
    if abs(force) < 0.02:
        force = 0.0

    # Default random action (should never be reached)
    if force is None:
        return random.uniform(-3.0, 3.0)

    return force
