import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # check finiteness
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    theta = pole_angle
    theta_dot = pole_angular_velocity
    x = cart_position
    x_dot = cart_velocity

    # failure angle condition
    if abs(theta) >= 0.20:
        sign = (theta > 0) - (theta < 0)  # 1, -1, or 0
        force = -sign * 3.0
        return max(min(force, 3.0), -3.0)

    # base control
    u_base = -(15.0 * theta + 3.5 * theta_dot + 0.8 * x + 0.6 * x_dot)

    # scaling factor
    if abs(theta) <= 0.01:
        scale = 1.0
    else:
        scale = 1.0 + 2.0 * (abs(theta) - 0.01) / (0.20 - 0.01)
        scale = max(min(scale, 3.0), 1.0)

    raw_force = scale * u_base
    force = max(min(raw_force, 3.0), -3.0)
    return force

    # default random action (should not be reached)
    return random.uniform(-3.0, 3.0)
