def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import random
    F = None
    theta = pole_angle
    theta_dot = pole_angular_velocity
    x = cart_position
    x_dot = cart_velocity
    if abs(theta) > 0.15:
        F = -3.0 * theta - 1.2 * theta_dot
