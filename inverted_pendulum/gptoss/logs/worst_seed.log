import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    force = None
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    else:
        x = cart_position
        x_dot = cart_velocity
        theta = pole_angle
        theta_dot = pole_angular_velocity

        if abs(theta) <= 0.05:
            tilt_raw = 0.0
        elif abs(theta) >= 0.18:
            tilt_raw = 1.0
        else:
            tilt_raw = (abs(theta) - 0.05) / (0.18 - 0.05)

        tilt = tilt_raw * tilt_raw * tilt_raw

        Kp = 30.0 + 90.0 * tilt
        Kd = 2.0 + 10.0 * tilt

        ff_grav = 0.15 * math.sin(theta) + 0.05 * math.sin(theta) * abs(theta)

        cart_center = -(0.003 * x + 0.001 * x_dot) * (1.0 + 0.5 * abs(x))

        u_raw = -(Kp * theta + Kd * theta_dot + ff_grav) + cart_center

        u_soft = 3.0 * math.tanh(u_raw / 3.0)

        if u_soft > 3.0:
            force = 3.0
        elif u_soft < -3.0:
            force = -3.0
        else:
            force = u_soft

    if force is None:
        return random.uniform(-3, 3)
    return force
