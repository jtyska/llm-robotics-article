import random, math

def clamp(v, lo, hi):
    return max(lo, min(hi, v))

def sign(v):
    return 1 if v > 0 else -1 if v < 0 else 0

def smoothstep(t):
    return t * t * (3 - 2 * t)

def deadzone(v, dz):
    return 0.0 if abs(v) < dz else v

# Gains
Kx = 1.0
Kx_dot = 0.8
Kθ = 20.0
Kθ_dot = 15.0

MAX_FORCE = 3.0
MIN_FORCE = -3.0
DEAD_ZONE = 0.001

# Angle thresholds (radians)
THETA_SMALL = 0.02
THETA_MAX = 0.18

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(theta) and math.isfinite(x_dot) and math.isfinite(theta_dot)):
        force = 0.0
        return force

    if abs(theta) >= THETA_MAX:
        force = clamp(-sign(theta) * MAX_FORCE, MIN_FORCE, MAX_FORCE)
        return force

    u_angle = -(Kθ * theta + Kθ_dot * theta_dot)
    u_pos = -(Kx * x + Kx_dot * x_dot)

    if abs(theta) <= THETA_SMALL:
        raw = u_pos
    else:
        t = (abs(theta) - THETA_SMALL) / (THETA_MAX - THETA_SMALL)
        t = clamp(t, 0.0, 1.0)
        scale = 1.0 + 1.5 * smoothstep(t)  # 1.0 … 2.5
        raw = scale * u_angle + 0.3 * u_pos

    raw = deadzone(raw, DEAD_ZONE)
    force = clamp(raw, MIN_FORCE, MAX_FORCE)
    return force

    # fallback (should never reach)
    return random.uniform(-3.0, 3.0)
