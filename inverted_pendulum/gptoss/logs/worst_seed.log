def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # Check for non‑finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Normalised tilt (0 = upright, 1 = near failure)
    abs_theta = abs(pole_angle)
    if abs_theta <= 0.05:
        tilt = 0.0
    elif abs_theta >= 0.18:
        tilt = 1.0
    else:
        tilt_raw = (abs_theta - 0.05) / (0.18 - 0.05)   # linear map [0.05,0.18] → [0,1]
        tilt = max(0.0, min(tilt_raw, 1.0))

    # Gain schedule (quadratic in tilt)
    Kp_pole = 4.0   + 72.0 * tilt * tilt      # 4 → 76
    Kd_pole = 1.0   + 18.0 * tilt * tilt      # 1 → 19
    Kp_cart = 0.02  + 0.08 * tilt * tilt      # 0.02 → 0.10
    Kd_cart = 0.005 + 0.02 * tilt * tilt      # 0.005 → 0.025

    # Feed‑forward term
    ff_gain = 1.0 * tilt                     # 0 → 1.0
    sign_theta = 1.0 if pole_angle > 0 else -1.0 if pole_angle < 0 else 0.0
    ff_term = -ff_gain * pole_angular_velocity * sign_theta

    # PD contributions
    pole_pd = -Kp_pole * pole_angle - Kd_pole * pole_angular_velocity
    cart_pd = -Kp_cart * cart_position - Kd_cart * cart_velocity

    # Combine and saturate
    raw_force = pole_pd + cart_pd + ff_term
    force = max(-3.0, min(raw_force, 3.0))
    return force

    # Default random action if no rule applies (should never be reached)
    return random.uniform(-3.0, 3.0)
