import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    # normalized tilt
    abs_theta = abs(theta)
    if abs_theta <= 0.07:
        t = 0.0
    elif abs_theta >= 0.20:
        t = 1.0
    else:
        t = (abs_theta - 0.07) / (0.20 - 0.07)

    # gains
    Kp_theta = 10.0 + (80.0 - 10.0) * t
    Kd_theta = 2.0  + (30.0 - 2.0)  * t
    Kp_x     = 0.20 + (0.60 - 0.20) * t
    Kd_x     = 0.10 + (0.40 - 0.10) * t

    # feed‑forward
    ff_theta_dot = -1.2 * theta_dot

    # raw control signal
    u = -(Kp_theta * theta
          + Kd_theta * theta_dot
          + Kp_x     * x
          + Kd_x     * x_dot
          + ff_theta_dot) + 0.02

    # adaptive envelope
    Fmax = 0.5 + 2.5 * t

    # smooth saturation
    arg = u / Fmax
    if arg < -2.0:
        arg = -2.0
    elif arg > 2.0:
        arg = 2.0
    force_raw = math.tanh(arg) * Fmax

    # clip to physical limits
    if force_raw > 3.0:
        action = 3.0
    elif force_raw < -3.0:
        action = -3.0
    else:
        action = force_raw

    return action

    # default random action (should never be reached)
    return random.uniform(-3, 3)
