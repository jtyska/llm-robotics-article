import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    action = None

    if (not math.isfinite(x) or not math.isfinite(x_dot) or
        not math.isfinite(theta) or not math.isfinite(theta_dot)):
        action = 0.0
    else:
        # cart‑stabilisation term
        if abs(theta) <= 0.02:
            u_cart = -(0.8 * x + 0.4 * x_dot)
        else:
            u_cart = 0.0

        # gain‑scheduling for angle PD
        theta_abs = abs(theta)

        if theta_abs < 0.02:
            K_theta = 1.0
            K_theta_dot = 0.5
        elif theta_abs > 0.20:
            K_theta = 2.0
            K_theta_dot = 1.5
        else:
            frac = (theta_abs - 0.02) / (0.20 - 0.02)  # in [0,1]
            K_theta = 1.0 + frac * (2.0 - 1.0)
            K_theta_dot = 0.5 + frac * (1.5 - 0.5)

        # PD term on pole
        u_angle = -(K_theta * theta + K_theta_dot * theta_dot)

        # combine contributions
        u_raw = u_cart + u_angle

        # smooth saturation
        u_smooth = 3.0 * math.tanh(u_raw / 3.0)

        # final clamp to action limits
        if u_smooth > 3.0:
            action = 3.0
        elif u_smooth < -3.0:
            action = -3.0
        else:
            action = u_smooth

    if action is None:
        action = random.uniform(-3.0, 3.0)

    return action
