import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non‑finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Failure angle condition
    if abs(pole_angle) >= 0.20:
        return 0.0

    # Gains
    K_theta = 12.0
    K_theta_dot = 5.0
    K_x = 0.8
    K_x_dot = 0.4

    # Scaling factor (smooth 1 → 5)
    theta_abs = abs(pole_angle)
    theta0 = 0.02
    theta_max = 0.20
    scale = 1.0 + 4.0 * (theta_abs - theta0) / (theta_max - theta0)
    if scale < 1.0:
        scale = 1.0
    if scale > 5.0:
        scale = 5.0

    # Cart‑bias fade‑out (1 → 0)
    cart_bias_factor = 1.0 - (theta_abs - theta0) / (theta_max - theta0)
    if cart_bias_factor < 0.0:
        cart_bias_factor = 0.0

    # Raw control law
    u_angle = -(K_theta * pole_angle + K_theta_dot * pole_angular_velocity)
    u_cart = -(K_x * cart_position + K_x_dot * cart_velocity) * cart_bias_factor
    raw_force = scale * (u_angle + u_cart)

    # Clamp to actuator limits
    if raw_force > 3.0:
        force = 3.0
    elif raw_force < -3.0:
        force = -3.0
    else:
        force = raw_force

    return force

    # Default random action (should never be reached)
    return random.uniform(-3, 3)
