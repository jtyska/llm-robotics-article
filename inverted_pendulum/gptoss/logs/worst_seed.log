import math, random

_tilt_int = 0.0

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    global _tilt_int
    # check finiteness
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # compute tilt
    tilt = abs(pole_angle) / 0.20
    tilt = max(0.0, min(tilt, 1.0))

    # update integrated tilt
    _tilt_int = (1 - 0.02) * _tilt_int + 0.02 * tilt

    # base force calculation
    base_force = (-12.0 * pole_angle
                  - 2.5 * pole_angular_velocity
                  - 0.5 * cart_position
                  - 0.2 * cart_velocity
                  - 1.0 * _tilt_int)

    # extra force for large tilt
    if tilt > 0.7:
        extra = -3.0 * math.copysign(1.0, pole_angle) * (0.5 * (tilt - 0.7))
    else:
        extra = 0.0

    raw_force = base_force + extra

    # clamp to action limits
    force = max(-3.0, min(raw_force, 3.0))

    return force if force is not None else random.uniform(-3.0, 3.0)
