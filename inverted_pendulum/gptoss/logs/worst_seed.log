import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non-finite inputs
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    else:
        theta = pole_angle
        theta_dot = pole_angular_velocity
        x = cart_position
        x_dot = cart_velocity

        # Compute normalized tilt
        abs_theta = abs(theta)
        if abs_theta <= 0.05:
            tilt_norm = 0.0
        elif abs_theta >= 0.20:
            tilt_norm = 1.0
        else:
            tilt_norm = (abs_theta - 0.05) / (0.20 - 0.05)

        # Gains
        Kp = 2.5 + (9.0 - 2.5) * tilt_norm
        Kd = 1.0 + (5.0 - 1.0) * tilt_norm
        Kpx = 0.02
        Kdx = 0.03

        # Control components
        pole_pd = -(Kp * math.sin(theta) + Kd * theta_dot)
        gravity_ff = 9.81 * math.sin(theta)
        cart_pd = -(Kpx * x + Kdx * x_dot)

        u_raw = pole_pd + gravity_ff + cart_pd
        force = 3.0 * math.tanh(u_raw)

        # Clamp to action limits
        if force > 3.0:
            force = 3.0
        if force < -3.0:
            force = -3.0

    # Default random action if force not set (should not happen)
    if 'force' not in locals():
        return random.uniform(-3, 3)
    return force
