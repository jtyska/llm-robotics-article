import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0
    if abs(theta) > 0.20:
        return 0.0

    theta_abs = abs(theta)  # 0 … 0.20
    s_raw = (theta_abs - 0.02) / (0.20 - 0.02)
    s = max(0.0, min(s_raw, 1.0))

    K_theta = 0.8 + s * (15.0 - 0.8)          # 0.8 → 15.0
    K_theta_d = 0.3 + s * (6.0 - 0.3)         # 0.3 → 6.0

    K_x = 0.80 * (1.0 - s) + 0.20 * s         # 0.80 → 0.20
    K_x_d = 0.40 * (1.0 - s) + 0.10 * s       # 0.40 → 0.10

    u_angle = -(K_theta * theta + K_theta_d * theta_dot)
    u_cart = -(K_x * x + K_x_d * x_dot)
    u_grav = -1.0 * theta

    u_raw = u_angle + u_cart + u_grav
    u_clamped = max(-3.0, min(u_raw, 3.0))

    if abs(u_clamped) < 0.02:
        return 0.0
    else:
        return u_clamped

    # fallback (should never reach here)
    return random.uniform(-3, 3)
