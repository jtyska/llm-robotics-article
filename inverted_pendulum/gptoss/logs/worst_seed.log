import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non-finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Failure condition on pole angle
    if abs(pole_angle) >= 0.20:
        return 0.0

    # Main control law
    scale = 1 + 4 * (abs(pole_angle) - 0.02) / 0.18
    if scale < 1:
        scale = 1
    elif scale > 5:
        scale = 5

    u_angle = -scale * (12 * pole_angle + 5 * pole_angular_velocity)
    u_cart = -scale * (0.9 * cart_position + 0.45 * cart_velocity)
    raw_force = u_angle + u_cart

    if raw_force > 3.0:
        force = 3.0
    elif raw_force < -3.0:
        force = -3.0
    else:
        force = raw_force

    return force

    # Default random action (should never be reached)
    return random.uniform(-3, 3)
