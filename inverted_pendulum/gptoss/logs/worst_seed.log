import random, math

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # helper functions
    def is_finite(v):
        return math.isfinite(v)
    def clamp(val, lo, hi):
        return max(lo, min(hi, val))
    def sign(v):
        return 1.0 if v > 0 else -1.0 if v < 0 else 0.0

    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # Rule 1: non‑finite inputs
    if not (is_finite(x) and is_finite(theta) and is_finite(x_dot) and is_finite(theta_dot)):
        return 0.0

    # Rule 2: large angle
    if abs(theta) >= 0.18:
        force = clamp(-sign(theta) * 3.0, -3.0, 3.0)
        return force

    # Rule 3: near‑vertical angle
    if abs(theta) <= 0.02:
        u_pos = -(1.5 * x + 1.2 * x_dot)
        force = clamp(u_pos, -3.0, 3.0)
        return force

    # Rule 4: intermediate angle region
    # 0.02 < |theta| < 0.18
    u_angle = -(70.0 * theta + 20.0 * theta_dot)
    u_pos = -(1.5 * x + 1.2 * x_dot)
    blend = (abs(theta) - 0.02) / (0.18 - 0.02)          # 0 … 1
    scale = 1.0 + blend * (2.0 - 1.0)                    # 1 … 2
    raw = scale * u_angle + 0.2 * u_pos
    force = clamp(raw, -3.0, 3.0)
    return force

    # default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
