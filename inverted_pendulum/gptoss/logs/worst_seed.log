import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(theta) and math.isfinite(x_dot) and math.isfinite(theta_dot)):
        return 0.0

    if abs(theta) >= 0.22:
        return -math.copysign(1.0, theta) * 3.0

    if abs(theta) <= 0.02:
        return -(1.2 * x + 1.0 * x_dot)

    # blended control
    u_angle = -(55.0 * theta + 15.0 * theta_dot)
    u_pos = -(1.2 * x + 1.0 * x_dot)
    blend = 1.0 / (1.0 + math.exp((abs(theta) - 0.08) / 0.03))
    base_force = (1.0 - blend) * u_angle + blend * u_pos
    scale = 1.0 + 1.5 * ((abs(theta) - 0.02) / (0.18 - 0.02)) ** 2
    if scale > 2.5:
        scale = 2.5
    raw_force = scale * base_force
    force = max(min(raw_force, 3.0), -3.0)
    return force

    # default random action (should not be reached)
    return random.uniform(-3.0, 3.0)
