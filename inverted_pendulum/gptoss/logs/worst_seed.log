# -------------------------------------------------
# 8. Saturate with a slightly larger inner gain
# -------------------------------------------------
    # 0.45 gives a stronger push before the tanh clips at ±3 N
    force ← 3.0 * tanh( 0.45 * raw_force )

    # Clamp just in case of numerical drift
    IF ( force >  3.0 ) THEN force ←  3.0 END IF
    IF ( force < -3.0 ) THEN force ← -3.0 END IF

END IF
