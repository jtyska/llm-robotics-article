def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # Non‑finite check
    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    # Large angle correction
    if abs(theta) >= 0.18:
        force = -math.copysign(1.0, theta) * 3.0
        force = max(-3.0, min(3.0, force))
        return force

    # Near‑upright control
    if abs(theta) <= 0.02:
        raw = -(0.9 * x + 0.12 * x_dot + 0.5 * 20.0 * theta + 0.2 * 3.0 * theta_dot)
        force = 3.0 * math.tanh(raw / 3.0)
        return force

    # Intermediate zone
    rel = (abs(theta) - 0.02) / (0.18 - 0.02)          # ∈ (0,1)
    scale = 1.0 + rel * rel                           # ∈ [1,2]
    if scale > 2.0:
        scale = 2.0

    u_angle = -(20.0 * theta + 3.0 * theta_dot)
    raw_angle = scale * u_angle

    cart_gain = (1.0 - rel) * 0.5                     # max 0.5, min 0
    raw_cart = -cart_gain * (0.9 * x + 0.12 * x_dot)

    raw_total = raw_angle + raw_cart
    force = 3.0 * math.tanh(raw_total / 3.0)
    return force

    # Fallback random action (should never be reached)
    return random.uniform(-3.0, 3.0)
