import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Rule 1
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Rule 2
    if abs(pole_angle) < 0.10 and abs(cart_position) > 2.0:
        sign = 1.0 if cart_position > 0 else -1.0 if cart_position < 0 else 0.0
        action = -0.5 * sign
        return max(-3.0, min(3.0, action))

    # Rule 3
    raw_angle = -(45.0 * pole_angle + 12.0 * pole_angular_velocity)
    if abs(pole_angle) <= 0.02:
        raw = raw_angle - (1.0 * cart_position + 0.8 * cart_velocity)
    else:
        raw = raw_angle

    if abs(raw) < 1e-4:
        raw = 0.0

    soft = raw / (1.0 + abs(raw) / 3.0)

    if soft > 3.0:
        return 3.0
    elif soft < -3.0:
        return -3.0
    else:
        return soft

    # Default random action (should not be reached)
    return random.uniform(-3.0, 3.0)
