[2025-08-28 16:55:08] [INFO] ############## LLM Overall strategy code 
def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # Check for non-finite inputs
    if (not math.isfinite(cart_position) or
        not math.isfinite(pole_angle) or
        not math.isfinite(cart_velocity) or
        not math.isfinite(pole_angular_velocity)):
        return 0.0

    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # Compute tilt normalization
    tilt_raw = (abs(theta) - 0.05) / (0.18 - 0.05)
    tilt_norm = max(0.0, min(tilt_raw, 1.0))  # clamp to [0,1]
    gain = tilt_norm * tilt_norm  # quadratic schedule

    # Gains for theta
    Kp_theta = 8.0 + (35.0 - 8.0) * gain
    Kd_theta = 1.0 + (5.0 - 1.0) * gain

    # Gains for position
    Kp_x = 0.20 + (0.30 - 0.20) * gain
    Kd_x = 0.05 + (0.10 - 0.05) * gain

    center_bias = -0.3 * x

    u = -(Kp_theta * theta +
          Kd_theta * theta_dot +
          Kp_x * (x + center_bias) +
          Kd_x * x_dot)

    max_force = 1.0 + (3.0 - 1.0) * gain

    if u > max_force:
        force = max_force
    elif u < -max_force:
        force = -max_force
    else:
        force = u

    return force
    # Default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
