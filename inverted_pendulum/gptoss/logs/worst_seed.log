import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0
    u_base = -(0.5 * cart_position + 0.1 * cart_velocity + 12.0 * pole_angle + 8.0 * pole_angular_velocity)
    abs_theta = abs(pole_angle)
    if abs_theta < 0.02:
        gain = 1.0
    elif abs_theta < 0.20:
        gain = 1.0 + 2.0 * (abs_theta - 0.02) / (0.20 - 0.02)
    else:
        gain = 3.0
    u_scaled = gain * u_base
    u_soft = 3.0 * math.tanh(u_scaled / 3.0)
    if u_soft > 3.0:
        force = 3.0
    elif u_soft < -3.0:
        force = -3.0
    else:
        force = u_soft
    return force
    return random.uniform(-3, 3)
