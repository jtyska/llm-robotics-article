import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    force = None
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    else:
        theta = pole_angle
        theta_dot = pole_angular_velocity
        x = cart_position
        x_dot = cart_velocity

        tilt_norm_raw = (abs(theta) - 0.05) / 0.13
        if tilt_norm_raw < 0.0:
            tilt_norm = 0.0
        elif tilt_norm_raw > 1.0:
            tilt_norm = 1.0
        else:
            tilt_norm = tilt_norm_raw

        Kp_theta = (1 - tilt_norm) * 8.0 + tilt_norm * 20.0
        Kd_theta = (1 - tilt_norm) * 6.0 + tilt_norm * 15.0
        Kp_x = (1 - tilt_norm) * 0.4 + tilt_norm * 1.2
        Kd_x = (1 - tilt_norm) * 0.4 + tilt_norm * 0.9

        u_raw = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * x + Kd_x * x_dot)
        u_raw += 9.81 * math.sin(theta)

        force = 3.0 * math.tanh(u_raw / 1.0)

        if force > 3.0:
            force = 3.0
        elif force < -3.0:
            force = -3.0

    if force is None:
        return random.uniform(-3, 3)
    return force
