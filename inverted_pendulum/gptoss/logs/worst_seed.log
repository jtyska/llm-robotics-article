import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        force = 0.0
        return force

    tilt_raw = (abs(theta) - 0.05) / (0.18 - 0.05)
    if tilt_raw < 0.0:
        tilt_raw = 0.0
    if tilt_raw > 1.0:
        tilt_raw = 1.0
    tilt = tilt_raw * tilt_raw

    Kp = 30.0 + 120.0 * tilt
    Kd = 2.0 + 12.0 * tilt
    ff_grav = 0.15 * math.sin(theta)
    cart_center = -0.004 * x - 0.001 * x_dot

    u_raw = -(Kp * theta + Kd * theta_dot + ff_grav) + cart_center

    if u_raw < -3.0:
        force = -3.0
    elif u_raw > 3.0:
        force = 3.0
    else:
        force = u_raw

    return force

    # fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
