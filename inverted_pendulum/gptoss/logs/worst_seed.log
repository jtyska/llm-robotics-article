import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    xdot = cart_velocity
    theta = pole_angle
    thetadot = pole_angular_velocity

    def is_finite(v):
        return math.isfinite(v)

    def clamp(val, lo, hi):
        return max(lo, min(val, hi))

    def sign(v):
        return 1.0 if v > 0 else -1.0 if v < 0 else 0.0

    # Rule 1: non‑finite values
    if not (is_finite(x) and is_finite(xdot) and is_finite(theta) and is_finite(thetadot)):
        return 0.0

    # Rule 2: angle out of bounds
    if abs(theta) >= 0.20:
        return clamp(-sign(theta) * 3.0, -3.0, 3.0)

    # Rule 3: compute action for near‑vertical angles
    if abs(theta) <= 0.02:
        s = 1.0
    else:
        s = 1.0 + (abs(theta) - 0.02) / (0.18 - 0.02)
        s = clamp(s, 1.0, 2.0)

    u_angle = -(30.0 * theta + 8.0 * thetadot)

    if abs(theta) <= 0.02:
        u_cart = -(0.5 * x + 0.8 * xdot)
    else:
        u_cart = 0.0

    raw = s * u_angle + u_cart
    action = clamp(raw, -3.0, 3.0)
    return action

    # Default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
