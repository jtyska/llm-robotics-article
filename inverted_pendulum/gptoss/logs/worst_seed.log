def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    def clamp(v, lo, hi):
        return max(lo, min(hi, v))
    def sign(v):
        if v > 0:
            return 1
        elif v < 0:
            return -1
        else:
            return 0
    def sigmoid(z):
        return 1.0 / (1.0 + math.exp(-12.0 * z))
    # Gains
    Kθ = 13.5
    Kθ_dot = 9.5
    Kx = 0.9
    Kx_dot = 0.7
    # Finite check
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    x = cart_position
    θ = pole_angle
    xdot = cart_velocity
    θdot = pole_angular_velocity
    if abs(θ) >= 0.18:
        return clamp(-sign(θ) * 3.0, -3.0, 3.0)
    if abs(θ) < 0.02:
        return 0.0
    if abs(θ) < 0.06:
        raw = -(Kx * x + Kx_dot * xdot)
        raw = raw - 0.02 * sign(raw)
        return clamp(raw, -3.0, 3.0)
    # Angle‑dominant region (0.06 ≤ |θ| < 0.18)
    u_angle = -(Kθ * θ + Kθ_dot * θdot)
    t = (abs(θ) - 0.06) / (0.18 - 0.06)
    t = clamp(t, 0.0, 1.0)
    scale = 1.0 + sigmoid(t - 0.5)
    cart_bias = -(Kx * x + Kx_dot * xdot) * (1.0 - t)
    raw = scale * u_angle + cart_bias
    raw = raw - 0.02 * sign(raw)
    return clamp(raw, -3.0, 3.0)
    # fallback (should not be reached)
    return random.uniform(-3.0, 3.0)
