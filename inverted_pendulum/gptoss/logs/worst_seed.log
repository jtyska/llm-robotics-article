import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non-finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    theta = pole_angle
    theta_dot = pole_angular_velocity
    x = cart_position
    x_dot = cart_velocity

    theta_abs = abs(theta)

    if theta_abs <= 0.04:
        tilt_raw = 0.0
    elif theta_abs >= 0.20:
        tilt_raw = 1.0
    else:
        tilt_raw = (theta_abs - 0.04) / (0.20 - 0.04)

    gain = tilt_raw ** 3

    Kp_theta = 4.0 + 8.0 * gain
    Kd_theta = 2.0 + 5.0 * gain

    pole_effort = -(Kp_theta * theta + Kd_theta * theta_dot)

    if tilt_raw < 0.10:
        centre_bias = -0.15 * x
    else:
        centre_bias = 0.0

    vel_damp = -0.03 * x_dot

    raw_force = pole_effort + centre_bias + vel_damp

    force = 3.0 * math.tanh(0.35 * raw_force)

    # Clamp to action bounds
    if force > 3.0:
        force = 3.0
    elif force < -3.0:
        force = -3.0

    return force

    # Default random action (fallback, should not be reached)
    return random.uniform(-3.0, 3.0)
