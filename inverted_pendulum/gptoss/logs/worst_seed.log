import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non‑finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    theta = pole_angle
    theta_dot = pole_angular_velocity

    # Failure angle condition
    if abs(theta) >= 0.20:
        return -math.copysign(3.0, theta)

    # Near‑upright condition
    if abs(theta) <= 0.02:
        return 0.0

    # Main control law
    u_angle = -(30.0 * theta + 8.0 * theta_dot)

    scale = 1.0 + (abs(theta) - 0.02) * (2.0 - 1.0) / (0.18 - 0.02)
    scale = max(1.0, min(scale, 2.0))

    raw_force = scale * u_angle
    force = max(-3.0, min(raw_force, 3.0))
    return force

    # Fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
