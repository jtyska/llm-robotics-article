def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    # normalised tilt
    if abs(theta) <= 0.05:
        tilt_norm = 0.0
    elif abs(theta) >= 0.18:
        tilt_norm = 1.0
    else:
        tilt_norm = (abs(theta) - 0.05) / (0.18 - 0.05)

    # quadratic scaling
    scale = tilt_norm * tilt_norm

    # tilt‑dependent gains
    Kp_theta = 8.0 + (80.0 - 8.0) * scale          # 8 → 80
    Kd_theta = 1.0 + (20.0 - 1.0) * scale          # 1 → 20
    Kp_x     = 0.10 + (0.40 - 0.10) * scale        # 0.10 → 0.40
    Kd_x     = 0.05 + (0.25 - 0.05) * scale        # 0.05 → 0.25

    # feed‑forward damping
    ff_theta_dot = -0.7 * theta_dot

    # raw control signal
    u = -(Kp_theta * theta
          + Kd_theta * theta_dot
          + Kp_x * x
          + Kd_x * x_dot
          + ff_theta_dot) + 0.02

    # adaptive force envelope
    max_force = 0.5 + 2.5 * scale                  # 0.5 → 3.0 N

    # smooth saturation
    force_raw = math.tanh(u / max_force) * max_force

    # clip to physical limits
    if force_raw > 3.0:
        action = 3.0
    elif force_raw < -3.0:
        action = -3.0
    else:
        action = force_raw

    return action

