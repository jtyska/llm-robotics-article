import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Safety guard
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    if abs(pole_angle) > 0.20:
        return 0.0

    # Dead‑zone (pole almost upright)
    if abs(pole_angle) < 0.02:
        Kx = 0.80
        Kx_dot = 0.40
        u_raw = -(Kx * cart_position + Kx_dot * cart_velocity)
    else:
        # Linear‑scale angle feedback
        s = (abs(pole_angle) - 0.02) / (0.20 - 0.02)  # 0 ≤ s ≤ 1
        Kθ = 1.0 + (4.0 - 1.0) * s
        Kθ_dot = 0.5 + (2.5 - 0.5) * s
        Kx = 0.80 - 0.70 * s
        Kx_dot = 0.40 - 0.30 * s

        u_grav = -9.8 * math.sin(pole_angle)
        u_angle = -(Kθ * pole_angle + Kθ_dot * pole_angular_velocity)
        u_cart = -(Kx * cart_position + Kx_dot * cart_velocity)
        u_raw = u_grav + u_angle + u_cart

    # Saturation & dead‑force
    u_clamped = max(min(u_raw, 3.0), -3.0)
    if abs(u_clamped) < 0.01:
        return 0.0
    return u_clamped

    # Default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
