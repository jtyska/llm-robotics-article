def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # Check for non‑finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    # Normalised tilt (clamped to [0,1])
    tilt_raw = (abs(pole_angle) - 0.05) / (0.20 - 0.05)
    if tilt_raw < 0.0:
        tilt_raw = 0.0
    elif tilt_raw > 1.0:
        tilt_raw = 1.0
    # Cubic gain factor
    gain_factor = tilt_raw ** 3
    # Pole PD gains (increase with tilt)
    Kp_theta = 4.0 + 6.0 * gain_factor
    Kd_theta = 2.0 + 3.0 * gain_factor
    # Cart‑position PD gains (decrease with tilt)
    Kp_x = 0.6 * (1.0 - tilt_raw)
    Kd_x = 0.12 * (1.0 - tilt_raw)
    # Constant velocity‑damping term
    Kd_vel = 0.03
    # Tiny feed‑forward term when cart is fast
    if abs(cart_velocity) > 0.5:
        ff = 0.1 * (1.0 if cart_velocity > 0.0 else -1.0)
    else:
        ff = 0.0
    # PD contributions
    pole_effort = -Kp_theta * pole_angle - Kd_theta * pole_angular_velocity
    centre_bias = -Kp_x * cart_position - Kd_x * cart_velocity
    vel_damp = -Kd_vel * cart_velocity
    # Combine and saturate
    raw_force = pole_effort + centre_bias + vel_damp + ff
    force = 3.0 * math.tanh(0.30 * raw_force)
    # Final safety clamp (redundant after tanh)
    if force < -3.0:
        force = -3.0
    elif force > 3.0:
        force = 3.0
    return force
    # Default random action if no rule applied
    return random.uniform(-3.0, 3.0)
