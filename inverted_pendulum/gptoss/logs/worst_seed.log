import math, random

def _clamp(value, low, high):
    return max(low, min(high, value))

def _sign(x):
    return math.copysign(1.0, x) if x != 0.0 else 0.0

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    if abs(theta) < 0.02:
        force = _clamp(-0.8 * x - 0.4 * x_dot, -3.0, 3.0)
        return force

    # compute scaling factor
    scale = 1.0 + (abs(theta) - 0.02) / (0.20 - 0.02)
    if scale > 2.0:
        scale = 2.0

    # base linear feedback
    u_raw = -(15.0 * theta + 10.0 * theta_dot + 0.30 * x + 0.10 * x_dot)

    # emergency boost for large tilts
    if abs(theta) > 0.12:
        u_raw = u_raw - 5.0 * _sign(theta)

    # apply scaling
    u_scaled = scale * u_raw

    # soft saturation
    u_soft = 3.0 * math.tanh(u_scaled / 3.0)

    # final clipping to actuator limits
    force = _clamp(u_soft, -3.0, 3.0)
    return force

    # default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
