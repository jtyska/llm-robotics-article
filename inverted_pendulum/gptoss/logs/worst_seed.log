    raw_force ← -( Kθ * theta + Kθ_dot * theta_dot ) -( Kx * x + Kx_dot * x_dot )  

    force ← clamp( raw_force , -3.0 , 3.0 )  

    IF abs(force) < 0.001  
    THEN force ← 0.0  

    END IF  

END IF 
