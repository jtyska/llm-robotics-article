import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0

    def clamp(v, lo, hi):
        return max(lo, min(v, hi))

    def sign(v):
        return 1.0 if v > 0 else -1.0 if v < 0 else 0.0

    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity

    force = None

    if abs(theta) >= 0.18:
        force = clamp(-sign(theta) * 3.0, -3.0, 3.0)
    elif abs(theta) <= 0.02:
        raw = -(1.5 * x + 1.0 * x_dot)
        force = clamp(raw, -3.0, 3.0)
    else:
        u_angle = -(12.0 * theta + 3.0 * theta_dot)
        scale_raw = 1.0 + (abs(theta) - 0.02) / (0.18 - 0.02) * (2.5 - 1.0)
        scale = clamp(scale_raw, 1.0, 2.5)
        raw = scale * u_angle
        force = clamp(raw, -3.0, 3.0)

    if force is None:
        return random.uniform(-3.0, 3.0)
    return force
