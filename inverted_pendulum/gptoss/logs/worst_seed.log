def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    abs_theta = abs(theta)

    if abs_theta <= 0.05:
        tilt_norm = 0.0
    elif abs_theta >= 0.18:
        tilt_norm = 1.0
    else:
        tilt_norm = (abs_theta - 0.05) / (0.18 - 0.05)

    Kp_theta = 4.0 + (30.0 - 4.0) * tilt_norm
    Kd_theta = 2.0 + (12.0 - 2.0) * tilt_norm

    Kp_cart = 0.02 + (0.10 - 0.02) * tilt_norm
    Kd_cart = 0.03 + (0.12 - 0.03) * tilt_norm

    gravity_ff = 0.60 * 9.81 * math.sin(theta)

    pole_pd = -(Kp_theta * math.sin(theta) + Kd_theta * theta_dot)
    cart_pd = -(Kp_cart * x + Kd_cart * x_dot)

    if abs_theta < 0.07:
        centre_bias = -0.08 * x
    else:
        centre_bias = 0.0

    raw_force = pole_pd + gravity_ff + cart_pd + centre_bias
    force_raw = 3.0 * math.tanh(0.75 * raw_force)

    if force_raw > 3.0:
        force = 3.0
    elif force_raw < -3.0:
        force = -3.0
    else:
        force = force_raw

    return force

