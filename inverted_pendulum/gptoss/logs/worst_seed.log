## New strategy (full‑state linear feedback with adaptive scaling)

```text
# --------------------------------------------------------------
# Helper functions
sign(v)   =  1  if v > 0
            -1  if v < 0
             0  otherwise
clip(v,a,b)= max(a, min(b, v))

# Observation variables
x        = cart position
x_dot    = cart velocity
theta    = pole angle          (rad)
theta_dot= pole angular velocity (rad/s)

# ----------------------------------------------------------------
# 1. Safety check
IF ( NOT isfinite(x) OR NOT isfinite(x_dot)
     OR NOT isfinite(theta) OR NOT isfinite(theta_dot) ) THEN
    force ← 0.0
    RETURN force
END IF

# 2. Immediate danger – use maximum corrective push
IF ( abs(theta) >= 0.18 ) THEN
    # push opposite to the tilt direction, full magnitude
    force ← -3.0 * sign(theta)
    RETURN force
END IF

# 3. Very small tilt – dead‑band, act only on the cart
#    (helps to keep the cart centred without fighting the pole)
IF ( abs(theta) <= 0.01 ) THEN
    # gentle PD on cart, plus a tiny damping on theta_dot
    raw   ← -( 1.0  * x
               + 0.5 * x_dot
               + 0.1 * theta_dot )
    force ← clip(raw, -3.0, 3.0)
    RETURN force
END IF

# 4. Intermediate tilt – full‑state feedback with adaptive gain
#    Gains (tuned for the classic Cart‑Pole dynamics)
k_x      = 0.8
k_xdot   = 0.4
k_theta  = 10.0      # strong reaction to angle
k_tdot   = 8.0       # strong damping of angular velocity

#    Scaling: we want the controller to be able to reach the
#    full‑force limit already at |theta| ≈ 0.12 rad.
#    Linear scaling from 1.0 at |theta| = 0.01 to 3.0 at |theta| = 0.18
scale = 1.0 + (abs(theta) - 0.01) / (0.18 - 0.01) * 2.0
#    (scale = 1 at 0.01 rad, = 3 at 0.18 rad)

raw   = -( k_x    * x
           + k_xdot * x_dot
           + k_theta* theta
           + k_tdot * theta_dot ) * scale

force ← clip(raw, -3.0, 3.0)
RETURN force
# ----------------------------------------------------------------
```

