def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # check for non‑finite values
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # normalised tilt
    tilt_raw = (abs(pole_angle) - 0.05) / 0.15
    if tilt_raw < 0.0:
        tilt = 0.0
    elif tilt_raw > 1.0:
        tilt = 1.0
    else:
        tilt = tilt_raw

    # gain scheduling
    Kp_pole = 5.0 + 150.0 * tilt * tilt
    Kd_pole = 2.0 + 30.0 * tilt * tilt
    Kp_cart = 0.05 + 0.20 * tilt * tilt
    Kd_cart = 0.01 + 0.05 * tilt * tilt

    # feed‑forward term
    ff_gain = 1.0 * tilt
    sign_theta = math.copysign(1.0, pole_angle) if pole_angle != 0 else 0.0
    ff_term = -ff_gain * pole_angular_velocity * sign_theta

    # PD on pole
    pole_pd = -Kp_pole * pole_angle - Kd_pole * pole_angular_velocity

    # weak cart‑centering PD
    cart_pd = -Kp_cart * cart_position - Kd_cart * cart_velocity

    # combine
    raw_force = pole_pd + cart_pd + ff_term

    # emergency hard‑push when already out of safe tilt band
    if abs(pole_angle) >= 0.20 and raw_force * sign_theta > 0.0:
        raw_force = -3.0 * sign_theta

    # final clipping to actuator limits
    if raw_force > 3.0:
        force = 3.0
    elif raw_force < -3.0:
        force = -3.0
    else:
        force = raw_force

    return force if 'force' in locals() else random.uniform(-3.0, 3.0)
