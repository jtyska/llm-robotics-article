import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # helper functions
    def clamp(val, lo, hi):
        return max(lo, min(hi, val))
    def sign(x):
        return 1.0 if x > 0 else -1.0 if x < 0 else 0.0

    # check finiteness
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        force = 0.0
        return force

    theta = pole_angle
    theta_dot = pole_angular_velocity
    x = cart_position
    x_dot = cart_velocity

    # No integral term provided; assume zero
    theta_int = 0.0

    if abs(theta) >= 0.18:
        force = clamp(-sign(theta) * 3.0, -3.0, 3.0)
        return force

    # Angle PD‑I term (clamped before scaling)
    u_angle_raw = -(13.0 * theta + 2.5 * theta_dot + 0.10 * theta_int)
    u_angle_raw = clamp(u_angle_raw, -2.0, 2.0)

    # Linear scaling 1 → 2
    alpha = (abs(theta) - 0.02) / (0.18 - 0.02)  # 0 … 1
    scale = 1.0 + alpha
    if scale > 2.0:
        scale = 2.0

    # Adaptive cart‑centering gain
    if abs(theta) <= 0.02:
        centering_gain = 1.0
    else:
        centering_gain = 0.15

    # Cart‑centering PD term
    u_cart = -(0.9 * x + 0.35 * x_dot) * centering_gain

    # Combine and final clamp
    raw_force = scale * u_angle_raw + u_cart
    force = clamp(raw_force, -3.0, 3.0)

    # Output dead‑zone
    if abs(force) < 0.01:
        force = 0.0

    # default random action if somehow no rule applied
    if force is None:
        force = random.uniform(-3.0, 3.0)

    return force
