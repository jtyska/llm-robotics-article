import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Gains
    Kθ = 13.0
    Kθ_dot = 2.5
    Kx = 0.8
    Kx_dot = 0.3

    # Thresholds (radians)
    θ_dead = 0.02
    θ_max = 0.18

    # Helper functions
    def clamp(val, lo, hi):
        return max(lo, min(hi, val))

    def sign(v):
        return (v > 0) - (v < 0)

    # Rule 1: non‑finite check
    if (not math.isfinite(cart_position) or
        not math.isfinite(pole_angle) or
        not math.isfinite(cart_velocity) or
        not math.isfinite(pole_angular_velocity)):
        force = 0.0

    # Rule 2: hard‑stop
    elif abs(pole_angle) >= θ_max:
        force = clamp(-sign(pole_angle) * 3.0, -3.0, 3.0)

    # Rule 3: dead‑zone cart centering
    elif abs(pole_angle) <= θ_dead:
        raw = -(Kx * cart_position + Kx_dot * cart_velocity)
        force = clamp(raw, -3.0, 3.0)

    # Rule 4: angle PD controller with scaling and weak position correction
    else:
        u_angle = -(Kθ * pole_angle + Kθ_dot * pole_angular_velocity)

        α = (abs(pole_angle) - θ_dead) / (θ_max - θ_dead)  # 0 … 1
        scale = 1.0 + α
        if scale > 2.0:
            scale = 2.0

        pos_corr = -(Kx * cart_position + Kx_dot * cart_velocity) * 0.15

        raw_force = scale * u_angle + pos_corr
        force = clamp(raw_force, -3.0, 3.0)

    # Output dead‑zone to suppress jitter
    if abs(force) < 0.01:
        force = 0.0

    # Default random action if for some reason force is undefined
    if force is None:
        return random.uniform(-3.0, 3.0)

    return force
