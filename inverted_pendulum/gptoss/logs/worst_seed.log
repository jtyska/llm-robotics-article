    pole_pd      ← -(Kp_theta * sin(theta) + Kd_theta * theta_dot)
    gravity_ff   ← 0.60 * 9.81 * sin(theta)        # approx. g·sinθ term

    # ---- 4. Cart PD (always active) -------------------------
    Kp_cart ← 0.02
    Kd_cart ← 0.03
    cart_pd ← -(Kp_cart * x + Kd_cart * x_dot)

    # ---- 5. Small centre‑bias (only when pole is almost upright)
    IF |theta| < 0.07
        centre_bias ← -0.08 * x
    ELSE
        centre_bias ← 0.0
    ENDIF

    # ---- 6. Raw command ---------------------------------------
    raw_force ← pole_pd + gravity_ff + cart_pd + centre_bias

    # ---- 7. Smooth saturation (tanh) -------------------------
    #   0.60 is the “soft‑gain” that determines how quickly the tanh
    #   approaches its limits; 3.0 is the maximum physical force.
    force_raw ← 3.0 * tanh(0.60 * raw_force)

    # ---- 8. Final clipping (guard against numerical drift) ---
    IF force_raw >  3.0  THEN force ←  3.0
    ELSE IF force_raw < -3.0 THEN force ← -3.0
    ELSE force ← force_raw
    ENDIF
ENDIF
```

