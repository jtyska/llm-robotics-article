import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non‑finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    def sign(v):
        return 1.0 if v > 0 else -1.0 if v < 0 else 0.0

    abs_theta = abs(pole_angle)

    if abs_theta >= 0.18:
        force = -3.0 * sign(pole_angle)
    elif abs_theta <= 0.02:
        force = -(1.0 * cart_position + 0.5 * cart_velocity)
    else:
        alpha = (abs_theta - 0.02) / (0.18 - 0.02)
        bang = -3.0 * sign(pole_angle)
        pd = -(1.0 * cart_position + 0.5 * cart_velocity)
        force = (1.0 - alpha) * pd + alpha * bang

    # Clamp to action limits
    if force > 3.0:
        force = 3.0
    if force < -3.0:
        force = -3.0

    return force if math.isfinite(force) else random.uniform(-3.0, 3.0)
