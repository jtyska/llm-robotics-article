import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Helper functions
    def is_finite(v):
        return math.isfinite(v)
    def clamp(v, lo, hi):
        return max(lo, min(v, hi))
    def sign(v):
        if v > 0:
            return 1.0
        if v < 0:
            return -1.0
        return 0.0

    # Check for non‑finite inputs
    if not (is_finite(cart_position) and is_finite(cart_velocity) and
            is_finite(pole_angle) and is_finite(pole_angular_velocity)):
        return 0.0

    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity

    # Tilt scaling
    tilt_raw = clamp((abs(theta) - 0.05) / (0.18 - 0.05), 0.0, 1.0)
    tilt = tilt_raw * tilt_raw

    # Gains
    Kp_theta = 30.0 + 120.0 * tilt
    Kd_theta = 2.0 + 8.0 * tilt
    Kp_x = 0.005 + 0.015 * tilt
    Kd_x = 0.001 + 0.006 * tilt

    # Feed‑forward gravity compensation
    ff_grav = 0.45 * math.sin(theta)

    # Cart centering term
    cart_center_raw = clamp((abs(x) - 0.5) / 0.5, 0.0, 1.0)
    cart_center_force = -sign(x) * 0.5 * cart_center_raw

    # Control law
    u = -(Kp_theta * theta +
          Kd_theta * theta_dot +
          Kp_x * x +
          Kd_x * x_dot +
          ff_grav) + cart_center_force

    force = clamp(u, -3.0, 3.0)
    return force

    # Default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
