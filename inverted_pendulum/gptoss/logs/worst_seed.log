import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non‑finite inputs
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0

    abs_theta = abs(pole_angle)

    # Normalised tilt
    if abs_theta <= 0.04:
        t = 0.0
    elif abs_theta >= 0.20:
        t = 1.0
    else:
        t = (abs_theta - 0.04) / (0.20 - 0.04)

    # Gain‑scheduling
    Kp_theta = 12.0 + (100.0 - 12.0) * t
    Kd_theta = 1.5 + (30.0 - 1.5) * t
    Kp_x     = 0.15 + (0.60 - 0.15) * t
    Kd_x     = 0.07 + (0.35 - 0.07) * t

    # Feed‑forward on angular velocity
    ff_theta_dot = -0.8 * pole_angular_velocity

    # Raw control signal
    u = -(Kp_theta * pole_angle +
          Kd_theta * pole_angular_velocity +
          Kp_x     * cart_position +
          Kd_x     * cart_velocity +
          ff_theta_dot) + 0.02

    # Adaptive force envelope
    Fmax = 0.5 + 2.5 * t

    # Smooth saturation
    force_raw = math.tanh(u / Fmax) * Fmax

    # Final clipping to physical limits
    if force_raw > 3.0:
        action = 3.0
    elif force_raw < -3.0:
        action = -3.0
    else:
        action = force_raw

    return action

    # Default random action (should never be reached)
    return random.uniform(-3, 3)
