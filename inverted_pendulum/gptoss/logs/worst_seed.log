def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # Check for non-finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Normalise tilt
    tilt_norm_raw = (abs(pole_angle) - 0.05) / (0.20 - 0.05)
    if tilt_norm_raw < 0.0:
        tilt_norm = 0.0
    elif tilt_norm_raw > 1.0:
        tilt_norm = 1.0
    else:
        tilt_norm = tilt_norm_raw

    # Base gains
    Kp_theta = (1 - tilt_norm) * 8.0 + tilt_norm * 22.0
    Kd_theta = (1 - tilt_norm) * 6.0 + tilt_norm * 16.0
    Kp_x = (1 - tilt_norm) * 0.4 + tilt_norm * 1.2
    Kd_x = (1 - tilt_norm) * 0.4 + tilt_norm * 0.9

    # Emergency boost
    if abs(pole_angle) > 0.18:
        Kp_emergency = 5.0 * (abs(pole_angle) - 0.18) / (0.20 - 0.18)
    else:
        Kp_emergency = 0.0

    # Raw control law
    sign_theta = 1.0 if pole_angle > 0 else (-1.0 if pole_angle < 0 else 0.0)
    u_raw = -(Kp_theta * pole_angle +
              Kd_theta * pole_angular_velocity +
              Kp_x * cart_position +
              Kd_x * cart_velocity +
              Kp_emergency * sign_theta)
    u_raw += 9.81 * math.sin(pole_angle)

    # Map to admissible force
    force = 3.0 * math.tanh(u_raw / 1.0)
    if force > 3.0:
        force = 3.0
    elif force < -3.0:
        force = -3.0

    return force if force is not None else random.uniform(-3, 3)
