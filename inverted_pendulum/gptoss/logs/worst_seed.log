        Represent these same rules in a function using python code. The signature of the function should be get_action(cart_position,pole_angle,cart_velocity,pole_angular_velocity), the inputs are the four observation values and the function returns the action value using the rules above. Add a default random action (return random.uniform(-3, 3)) at the end of the function if no rule is used. Your response should contain only the function definition using python code. No other text or explanation, neigher formatting characters, only plain python code.
        
            
            
[2025-08-28 15:32:12] [INFO] ############## LLM Overall strategy code 
def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity
    if not (math.isfinite(x) and math.isfinite(theta) and math.isfinite(x_dot) and math.isfinite(theta_dot)):
        return 0.0
    tilt_raw = (abs(theta) - 0.05) / (0.20 - 0.05)
    if tilt_raw < 0.0:
        tilt_raw = 0.0
    if tilt_raw > 1.0:
        tilt_raw = 1.0
    t3 = tilt_raw ** 3
    Kp = 8.0 + (30.0 - 8.0) * t3
    Kd = 1.5 + (10.0 - 1.5) * t3
    Ki = 0.0 + 0.2 * t3
    if not hasattr(get_action, "I_theta"):
        get_action.I_theta = 0.0
    get_action.I_theta += theta * 0.02
    if get_action.I_theta > 0.5:
        get_action.I_theta = 0.5
    if get_action.I_theta < -0.5:
        get_action.I_theta = -0.5
    I_theta = get_action.I_theta
    pole_effort = -Kp * theta - Kd * theta_dot - Ki * I_theta
    centre_bias = -0.07 * (1.0 - tilt_raw) * x
    cart_vel_damp = -0.03 * (1.0 - tilt_raw) * x_dot
    if tilt_raw > 0.3:
        centre_bias = 0.0
        cart_vel_damp = 0.0
    raw_force = pole_effort + centre_bias + cart_vel_damp
    force = 3.0 * math.tanh(raw_force * 0.60)
    if force > 3.0:
        force = 3.0
    if force < -3.0:
        force = -3.0
    return force

