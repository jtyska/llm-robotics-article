import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # Rule 1
    if not (math.isfinite(x) and math.isfinite(theta) and math.isfinite(x_dot) and math.isfinite(theta_dot)):
        return 0.0

    # Rule 2
    tilt_norm = max(0.0, min(1.0, (abs(theta) - 0.05) / (0.20 - 0.05)))

    # Rule 3
    if tilt_norm <= 0.0:
        alpha = 1.2
    elif tilt_norm >= 1.0:
        alpha = 0.4
    else:
        alpha = 1.2 - 0.8 * tilt_norm

    # Rule 4
    u_raw = -(2.8 * math.sin(theta) + 1.2 * theta_dot) \
            - (0.015 * x + 0.025 * x_dot) \
            - 0.01 * x \
            + 0.25 * 9.81 * math.sin(theta)

    # Rule 5
    s = math.tanh(alpha * u_raw)

    # Rule 6
    a = 3.0 * s

    # Rule 7
    if a > 3.0:
        action = 3.0
    elif a < -3.0:
        action = -3.0
    else:
        action = a

    # Default fallback (should never be reached)
    if action is None:
        return random.uniform(-3.0, 3.0)

    return action
