import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    if abs(theta) >= 0.20:
        return -3.0 * math.copysign(1.0, theta)

    if abs(theta) <= 0.02:
        raw = -(1.0 * x + 0.5 * x_dot)
        return max(min(raw, 3.0), -3.0)

    # 0.02 < abs(theta) < 0.20
    raw = -(1.0 * x + 0.5 * x_dot + 8.0 * theta + 2.0 * theta_dot)
    scale = math.exp(3.0 * (abs(theta) - 0.02) / 0.18)
    force = raw * scale
    return max(min(force, 3.0), -3.0)

    # fallback (should never reach)
    return random.uniform(-3.0, 3.0)
