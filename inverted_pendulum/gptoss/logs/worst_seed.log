def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Helper clamp
    def clamp(val, lo=-3.0, hi=3.0):
        return max(min(val, hi), lo)

    # Check for non‑finite inputs
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Failure angle check
    if abs(pole_angle) > 0.20:
        return 0.0

    theta_abs = abs(pole_angle)

    if theta_abs < 0.02:
        # small‑angle regime: cart‑centering PD
        Kx_small = 0.80
        Kxd_small = 0.40
        raw = -(Kx_small * cart_position + Kxd_small * cart_velocity)
        return clamp(raw)
    else:
        # medium/large‑angle regime: angle‑dominant PD with gravity feed‑forward
        s = (theta_abs - 0.02) / (0.20 - 0.02)  # 0 … 1

        K_theta = 0.8 + s * (15.0 - 0.8)        # 0.8 → 15
        K_theta_d = 0.3 + s * (6.0 - 0.3)       # 0.3 → 6
        K_x = 0.80 * (1.0 - s) + 0.20 * s       # 0.80 → 0.20
        K_x_d = 0.40 * (1.0 - s) + 0.10 * s     # 0.40 → 0.10

        u_angle = -(K_theta * pole_angle + K_theta_d * pole_angular_velocity)
        u_cart = -(K_x * cart_position + K_x_d * cart_velocity)
        u_grav = -1.0 * pole_angle               # gravity compensation

        u_raw = u_angle + u_cart + u_grav
        return clamp(u_raw)

    # Fallback random action (should never be reached)
    return random.uniform(-3.0, 3.0)
