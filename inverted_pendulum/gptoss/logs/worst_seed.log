import math, random

_integral_angle = 0.0

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    global _integral_angle
    x, theta, x_dot, theta_dot = cart_position, pole_angle, cart_velocity, pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(theta) and math.isfinite(x_dot) and math.isfinite(theta_dot)):
        return 0.0

    if abs(theta) >= 0.18:
        force = -math.copysign(1.0, theta) * 3.0
        return max(-3.0, min(force, 3.0))

    # update persistent integral (θ · Δt, Δt = 0.02)
    _integral_angle += theta * 0.02

    # linear feedback terms
    u_angle = -(20.0 * theta + 15.0 * theta_dot) + 0.25 * _integral_angle
    u_pos = -(1.0 * x + 0.8 * x_dot)

    # blending factor (smooth transition)
    t_raw = (abs(theta) - 0.02) / (0.18 - 0.02)
    t_clamped = max(0.0, min(t_raw, 1.0))
    blend = t_clamped * t_clamped * (3.0 - 2.0 * t_clamped)

    # weights for each term
    pos_weight = 1.0 - 0.8 * blend          # 1.0 → 0.2
    angle_weight = 1.0 + blend              # 1.0 → 2.0

    # combined command
    raw = angle_weight * u_angle + pos_weight * u_pos

    # dead‑zone (tiny)
    if abs(raw) < 1e-4:
        raw = 0.0

    # actuator limits
    force = max(-3.0, min(raw, 3.0))
    return force

    # default random action (should not be reached)
    return random.uniform(-3.0, 3.0)
