def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # Check finiteness
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Tilt calculation
    abs_theta = abs(pole_angle)
    if abs_theta <= 0.05:
        tilt = 0.0
    elif abs_theta >= 0.20:
        tilt = 1.0
    else:
        tilt = (abs_theta - 0.05) / (0.20 - 0.05)

    # PD terms
    pole_pd = -12.0 * pole_angle - 2.5 * pole_angular_velocity
    cart_pd = -0.8 * cart_position - 0.2 * cart_velocity

    # Assist term
    if tilt > 0.6:
        assist_factor = (tilt - 0.6) / (1.0 - 0.6)
        assist = -1.5 * math.copysign(1.0, pole_angle) * assist_factor
    else:
        assist = 0.0

    # Integral term (persistent across calls)
    if not hasattr(get_action, "tilt_int"):
        get_action.tilt_int = 0.0
    if tilt > 0.0:
        get_action.tilt_int += 0.005 * tilt
    else:
        get_action.tilt_int *= 0.99
    get_action.tilt_int = max(0.0, min(1.0, get_action.tilt_int))
    integral_term = -1.0 * get_action.tilt_int

    # Combine forces
    raw_force = pole_pd + cart_pd + assist + integral_term

    # Clip to action bounds
    if raw_force > 3.0:
        return 3.0
    elif raw_force < -3.0:
        return -3.0
    else:
        return raw_force

    # Default random action (fallback)
    return random.uniform(-3.0, 3.0)
