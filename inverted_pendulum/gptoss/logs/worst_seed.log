[2025-08-28 13:23:15] [INFO] ############## LLM Overall strategy code 
def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random

    def is_finite(v):
        return math.isfinite(v)

    def sign(v):
        if v > 0:
            return 1.0
        if v < 0:
            return -1.0
        return 0.0

    def clamp(v, lo, hi):
        return max(lo, min(v, hi))

    # Rule 1: non‑finite inputs
    if not (is_finite(cart_position) and is_finite(pole_angle) and
            is_finite(cart_velocity) and is_finite(pole_angular_velocity)):
        return 0.0

    theta = pole_angle
    x = cart_position
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # Rule 2: large angle
    if abs(theta) >= 0.18:
        force = clamp(-sign(theta) * 3.0, -3.0, 3.0)
        return force

    # Rule 3: blended controller
    u_cart = -(0.6 * x + 0.5 * x_dot)
    u_angle = -(14.0 * theta + 7.5 * theta_dot)

    t = (abs(theta) - 0.02) / (0.18 - 0.02)  # denominator = 0.16
    t = clamp(t, 0.0, 1.0)

    alpha = 1.0 / (1.0 + math.exp(-12.0 * (t - 0.5)))
    scale = 1.0 + alpha

    raw = (1.0 - alpha) * u_cart + alpha * (scale * u_angle)
    raw = raw - 0.02 * sign(raw)

    force = clamp(raw, -3.0, 3.0)
    return force

    # Default fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
