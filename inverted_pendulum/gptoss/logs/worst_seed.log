scale_min   = 1.0
scale_max   = 2.5
scale_slope = (scale_max - scale_min) / (θ_limit - θ_mid)

// ------------------------------------------------------------------
// Helper
// ------------------------------------------------------------------
function clip(v, lo, hi):
    if v < lo: return lo
    if v > hi: return hi
    return v

function sign(v):
    return 1.0 if v >= 0 else -1.0

// ------------------------------------------------------------------
// Main control rule (evaluated every timestep)
// ------------------------------------------------------------------
if NOT (isFinite(x) AND isFinite(theta) AND isFinite(x_dot) AND isFinite(theta_dot)):
    force = 0.0

