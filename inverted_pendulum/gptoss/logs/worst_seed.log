import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # persistent integral term
    if not hasattr(get_action, "theta_int"):
        get_action.theta_int = 0.0

    def clamp(val, lo, hi):
        return max(lo, min(val, hi))

    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # rule 1: non‑finite values
    if (not math.isfinite(x) or not math.isfinite(x_dot) or
        not math.isfinite(theta) or not math.isfinite(theta_dot)):
        return 0.0

    # rule 2: near‑upright
    if abs(theta) < 0.02:
        return 0.0

    # rule 3: gain‑scheduled PD control
    tilt_raw = (abs(theta) - 0.05) / (0.18 - 0.05)
    tilt_norm = clamp(tilt_raw, 0.0, 1.0)
    gain = tilt_norm * tilt_norm

    Kp_theta = 8.0 + (35.0 - 8.0) * gain
    Kd_theta = 1.0 + (5.0 - 1.0) * gain
    Kp_x = 0.20 + (0.30 - 0.20) * gain
    Kd_x = 0.05 + (0.10 - 0.05) * gain

    # integral update (tiny)
    get_action.theta_int = clamp(get_action.theta_int + theta * 0.001, -0.3, 0.3)

    center_bias = -0.3 * x

    u = -(Kp_theta * theta +
          Kd_theta * theta_dot +
          Kp_x * (x + center_bias) +
          Kd_x * x_dot +
          0.1 * get_action.theta_int)

    max_force = 1.5 + (3.0 - 1.5) * gain
    force = clamp(u, -max_force, max_force)
    return force

    # default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
