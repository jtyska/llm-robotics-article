import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # initialize persistent variables
    if not hasattr(get_action, "theta_int"):
        get_action.theta_int = 0.0
    if not hasattr(get_action, "force_prev"):
        get_action.force_prev = 0.0

    # finite check
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    theta = pole_angle
    theta_dot = pole_angular_velocity
    x = cart_position
    x_dot = cart_velocity

    # tilt normalization
    if abs(theta) <= 0.05:
        tilt_norm = 0.0
    elif abs(theta) >= 0.18:
        tilt_norm = 1.0
    else:
        tilt_norm = (abs(theta) - 0.05) / (0.18 - 0.05)

    # gain scheduling
    Kp_theta = (1 - tilt_norm) * 8.0 + tilt_norm * 35.0
    Kd_theta = (1 - tilt_norm) * 4.0 + tilt_norm * 18.0
    Kp_x     = (1 - tilt_norm) * 0.2 + tilt_norm * 0.9
    Kd_x     = (1 - tilt_norm) * 0.2 + tilt_norm * 0.7

    # integral on angle with anti-wind-up
    get_action.theta_int += theta * 0.02
    if get_action.theta_int > 0.12:
        get_action.theta_int = 0.12
    elif get_action.theta_int < -0.12:
        get_action.theta_int = -0.12

    # PD control law (no explicit gravity term)
    u_pd = -(Kp_theta * theta + Kd_theta * theta_dot + 0.05 * get_action.theta_int +
