import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0
    tilt_abs = abs(pole_angle)
    tilt_norm = (tilt_abs - 0.05) / (0.20 - 0.05)
    if tilt_norm < 0.0:
        tilt_norm = 0.0
    elif tilt_norm > 1.0:
        tilt_norm = 1.0
    Kp_theta = (1 - tilt_norm) * 8.0 + tilt_norm * 35.0
    Kd_theta = (1 - tilt_norm) * 4.0 + tilt_norm * 18.0
    Kp_x = (1 - tilt_norm) * 0.05 + tilt_norm * 0.30
    Kd_x = (1 - tilt_norm) * 0.05 + tilt_norm * 0.30
    u_pd = -(Kp_theta * pole_angle + Kd_theta * pole_angular_velocity +
             Kp_x * cart_position + Kd_x * cart_velocity)
    force_raw = 3.0 * math.tanh(u_pd / 1.0)
    if force_raw < -3.0:
        force = -3.0
    elif force_raw > 3.0:
        force = 3.0
    else:
        force = force_raw
    return force
