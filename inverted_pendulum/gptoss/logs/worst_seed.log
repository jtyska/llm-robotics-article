import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    else:
        x = cart_position
        theta = pole_angle
        x_dot = cart_velocity
        theta_dot = pole_angular_velocity

        tilt = abs(theta) / 0.20
        if tilt > 1.0:
            tilt = 1.0
        if tilt < 0.0:
            tilt = 0.0

        Kp = 8.0 + (12.0 - 8.0) * tilt
        Kd = 1.5 + (3.0 - 1.5) * tilt

        pole_effort = -Kp * theta - Kd * theta_dot
        centre_bias = -0.07 * (1.0 - tilt) * x
        cart_vel_damp = -0.03 * (1.0 - tilt) * x_dot

        raw_force = pole_effort + centre_bias + cart_vel_damp
        force = 3.0 * math.tanh(raw_force * 0.30)

        if force > 3.0:
            force = 3.0
        if force < -3.0:
            force = -3.0

    if 'force' in locals():
        return force
    return random.uniform(-3, 3)
