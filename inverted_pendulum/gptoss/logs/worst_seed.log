def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0
    else:
        abs_theta = abs(theta)
        if abs_theta <= 0.05:
            tilt_norm = 0.0
        elif abs_theta >= 0.20:
            tilt_norm = 1.0
        else:
            tilt_norm = (abs_theta - 0.05) / (0.20 - 0.05)

        Kp_theta = 20.0 + 180.0 * (tilt_norm * tilt_norm)
        Kd_theta = 2.0 + 48.0 * (tilt_norm * tilt_norm)
        Kp_x = 0.15 + 0.85 * tilt_norm
        Kd_x = 0.07 + 0.35 * tilt_norm

        ff_grav = 0.48 * math.sin(theta)

        u = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * x + Kd_x * x_dot + ff_grav) + 0.02

        Fmax = 0.8 + 2.2 * tilt_norm
        if Fmax > 3.0:
            Fmax = 3.0

        force_raw = math.tanh(u / Fmax) * Fmax

        if force_raw > 3.0:
            force = 3.0
        elif force_raw < -3.0:
            force = -3.0
        else:
            force = force_raw

        return force

    return random.uniform(-3.0, 3.0)
