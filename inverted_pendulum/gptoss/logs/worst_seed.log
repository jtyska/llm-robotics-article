def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    if not hasattr(get_action, "x_int"):
        get_action.x_int = 0.0
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity
    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0
    get_action.x_int = max(-2.0, min(2.0, get_action.x_int + x * 0.02))
    abs_theta = abs(theta)
    if abs_theta <= 0.05:
        tilt_norm = 0.0
    elif abs_theta >= 0.18:
        tilt_norm = 1.0
    else:
        tilt_norm = (abs_theta - 0.05) / (0.18 - 0.05)
    Kp_theta = 6.0 + 4.0 * tilt_norm
    Kd_theta = 3.0 + 2.0 * tilt_norm
    Kp_x = 0.20
    Ki_x = 0.05
    Kd_x = 0.03
    pole_effort = -(Kp_theta * math.sin(theta) + Kd_theta * theta_dot)
    centre_bias = -(Kp_x * x + Ki_x * get_action.x_int)
    vel_damp = -Kd_x * x_dot
    gravity_ff = 9.81 * math.sin(theta)
    raw_force = pole_effort + centre_bias + vel_damp + gravity_ff
    force = 3.0 * math.tanh(0.45 * raw_force)
    if force > 3.0:
        force = 3.0
    elif force < -3.0:
        force = -3.0
    return force

