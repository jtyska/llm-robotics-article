import random, math

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    def sign(v):
        if v > 0:
            return 1
        if v < 0:
            return -1
        return 0

    def clip(v, a, b):
        return max(a, min(b, v))

    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity

    if (not math.isfinite(x) or not math.isfinite(x_dot) or
        not math.isfinite(theta) or not math.isfinite(theta_dot)):
        force = 0.0
        return force

    if abs(theta) >= 0.18:
        force = -3.0 * sign(theta)
        return force

    if abs(theta) <= 0.02:
        raw = -(1.0 * x + 0.5 * x_dot + 0.05 * theta_dot)
        force = clip(raw, -3.0, 3.0)
        return force

    # intermediate band
    kx = 0.8
    kx_dot = 0.4
    k_theta = 4.0
    k_theta_dot = 3.0

    scale = 1.0 + (abs(theta) - 0.02) / (0.18 - 0.02) * 1.5  # 1 at 0.02, 2.5 at 0.18
    raw = -(kx * x + kx_dot * x_dot + k_theta * theta + k_theta_dot * theta_dot) * scale
    force = clip(raw, -3.0, 3.0)
    return force

    # fallback (should never reach here)
    return random.uniform(-3.0, 3.0)
