import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    def is_finite(v):
        return math.isfinite(v)
    def clamp(v, lo, hi):
        return max(lo, min(v, hi))
    def sign(v):
        return 1.0 if v > 0 else -1.0 if v < 0 else 0.0

    if not (is_finite(cart_position) and is_finite(pole_angle) and is_finite(cart_velocity) and is_finite(pole_angular_velocity)):
        return 0.0
    elif abs(pole_angle) >= 0.20:
        return clamp(-sign(pole_angle) * 3.0, -3.0, 3.0)
    else:
        u_cart = -(0.5 * cart_position + 0.5 * cart_velocity)
        u_angle = -(15.0 * pole_angle + 8.0 * pole_angular_velocity)
        t = (abs(pole_angle) - 0.02) / (0.18 - 0.02)
        alpha = 1.0 / (1.0 + math.exp(-15.0 * (t - 0.5)))
        blended = (1.0 - alpha) * u_cart + alpha * u_angle
        blended = blended - 0.05 * sign(blended)
        return clamp(blended, -3.0, 3.0)
    return random.uniform(-3.0, 3.0)
