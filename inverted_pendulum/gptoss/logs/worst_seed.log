import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # Check for non‑finite values
    if not (math.isfinite(x) and math.isfinite(theta) and math.isfinite(x_dot) and math.isfinite(theta_dot)):
        return 0.0

    abs_theta = abs(theta)

    # Large angle region
    if abs_theta >= 0.19:
        sign = math.copysign(1.0, theta) if theta != 0 else 0.0
        return -sign * 3.0

    # Near‑upright region
    if abs_theta <= 0.02:
        raw = -(0.8 * x + 0.1 * x_dot + 5.0 * theta + 2.5 * theta_dot)
        return 3.0 * math.tanh(raw / 3.0)

    # Intermediate zone
    u_angle = -(18.0 * theta + 2.5 * theta_dot)

    scale = 1.0 + (abs_theta - 0.02) / (0.19 - 0.02)
    if scale > 2.0:
        scale = 2.0
    if scale < 1.0:
        scale = 1.0

    raw_angle = scale * u_angle

    cart_gain = 0.4 * (1.0 - (abs_theta - 0.02) / (0.19 - 0.02))
    raw_cart = -cart_gain * (0.8 * x + 0.1 * x_dot)

    raw_total = raw_angle + raw_cart
    return 3.0 * math.tanh(raw_total / 3.0)

    # Default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
