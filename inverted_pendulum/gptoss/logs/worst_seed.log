def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    force = None
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    elif abs(pole_angle) >= 0.20:
        sign = 1.0 if pole_angle > 0 else -1.0 if pole_angle < 0 else 0.0
        force = -sign * 3.0
        force = max(min(force, 3.0), -3.0)
    else:
        t_raw = (abs(pole_angle) - 0.02) / (0.18 - 0.02)
        t = max(0.0, min(t_raw, 1.0))
        b = t * t * (3.0 - 2.0 * t)
        integral_angle = 0.0
        u_angle = -(45.0 * pole_angle + 12.0 * pole_angular_velocity) + 0.30 * integral_angle
        u_pos = -(1.0 * cart_position + 0.8 * cart_velocity)
        raw = b * u_angle + (1.0 - b) * u_pos
        if abs(raw) < 1e-4:
            raw = 0.0
        force = max(min(raw, 3.0), -3.0)
    if force is None:
        return random.uniform(-3.0, 3.0)
    return force
