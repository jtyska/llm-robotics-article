import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    tilt_raw = (abs(pole_angle) - 0.05) / (0.20 - 0.05)
    tilt_raw = max(0.0, min(1.0, tilt_raw))

    Kp = 5.0 + (20.0 - 5.0) * (tilt_raw * tilt_raw)
    Kd = 1.5

    effort_raw = -Kp * pole_angle - Kd * pole_angular_velocity
    scale = 3.0 / 10.0
    force = 3.0 * math.tanh(effort_raw * scale)

    if tilt_raw < 0.1:
        force = force - 0.02 * cart_position
        force = max(-3.0, min(3.0, force))

    force = max(-3.0, min(3.0, force))
    return force

    return random.uniform(-3, 3)
