import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # Rule 1: non‑finite values
    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    # Rule 2: large angle
    if abs(theta) >= 0.20:
        return -3.0 * math.copysign(1.0, theta)

    # Rule 3: near‑zero state
    if abs(theta) < 0.008 and abs(theta_dot) < 0.015 and abs(x) < 0.02:
        return 0.0

    # Rule 4: compute control signal
    Gmin, Gmax = 8.0, 30.0
    Dmin, Dmax = 2.0, 12.0
    g = Gmin + (Gmax - Gmin) * (abs(theta) / 0.20)
    d = Dmin + (Dmax - Dmin) * (abs(theta) / 0.20)

    kp_x, kd_x = 0.4, 0.2
    raw = -(g * theta + d * theta_dot + kp_x * x + kd_x * x_dot)

    if raw > 3.0:
        return 3.0
    elif raw < -3.0:
        return -3.0
    else:
        return raw

    # Default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
