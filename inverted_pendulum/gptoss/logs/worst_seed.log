```text
/* -------------------------------------------------------------
   Helper functions
   ------------------------------------------------------------- */
clamp(v, lo, hi)   = max(lo, min(hi, v))
smooth(v, limit)   = limit * tanh(v / limit)   // smooth saturation

/* -------------------------------------------------------------
   Main controller
   ------------------------------------------------------------- */
IF NOT (isfinite(x) AND isfinite(x_dot) AND isfinite(theta) AND isfinite(theta_dot))
THEN
    action = 0.0
ELSE
    /* ---- 1. Decide which regime we are in ------------------- */
    theta_abs = abs(theta)

    /* ---- 2. Base gains (LQR‑style) -------------------------- */
    /*   Position / cart‑velocity gains are useful only when the pole
         is close to vertical.  When the pole tilts we rely mainly on
         angle / angular‑velocity gains.                                   */
    kx_small      =  0.8      // cart‑position gain (small‑angle)
    kxdot_small   =  0.4      // cart‑velocity gain (small‑angle)

    ktheta_big    = 12.0      // pole‑angle gain (large‑angle)
    kthetadot_big =  8.0      // pole‑angular‑velocity gain (large‑angle)

    /* ---- 3. Gain‑scheduling --------------------------------- */
    /*   • 0.00 – 0.02 rad : pure cart‑position controller
         • 0.02 – 0.20 rad : blend between cart‑only and full‑state
         • >0.20 rad      : full‑state with extra amplification          */
    IF theta_abs <= 0.02
        /* pure cart‑position mode */
        u = -( kx_small * x + kxdot_small * x_dot )
    ELSE IF theta_abs < 0.20
        /* linear interpolation between the two modes */
        w = (theta_abs - 0.02) / (0.20 - 0.02)          // 0 … 1
        /* blend the two control laws */
        u_cart   = -( kx_small * x + kxdot_small * x_dot )
        u_angle  = -( ktheta_big * theta + kthetadot_big * theta_dot )
        u = (1.0 - w) * u_cart + w * u_angle
    ELSE
        /* pole is far from vertical – boost the angle feedback */
        boost   = 1.5 + 0.5 * (theta_abs - 0.20)        // 1.5 … ~2.0
        u_angle = -( ktheta_big * theta + kthetadot_big * theta_dot )
        u = boost * u_angle
    ENDIF

    /* ---- 4. Smooth saturation (avoid hard clipping) --------- */
    u_smooth = smooth(u, 3.0)          // tanh‑shaped saturation at ±3 N

    /* ---- 5. Final clamp (safety net) ------------------------ */
    action = clamp(u_smooth, -3.0, 3.0)
ENDIF
```

