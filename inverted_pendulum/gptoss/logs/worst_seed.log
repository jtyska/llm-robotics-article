    // 2) Small‑to‑moderate angle → mixed controller (angle + position)
    // --------------------------------------------------------------
    elif abs(theta) <= θ_mid:
        // angle PD term
        u_angle = -(Kθ * theta + Kθdot * theta_dot)
        // add a mild position term to keep the cart centred
        u_pos   = -(Kx * x + Kxdot * x_dot) * 0.3   // 30 % of the pure‑position gain
        u = u_angle + u_pos

    // --------------------------------------------------------------
    // 3) Moderate‑to‑large angle (θ_mid < |θ| < θ_limit) → scaled angle PD
    // --------------------------------------------------------------
    else:
        // base PD on angle only
        u_angle = -(Kθ * theta + Kθdot * theta_dot)

        // smooth scaling factor that grows linearly with |θ|
        scale = scale_min + scale_slope * (abs(theta) - θ_mid)
        scale = clip(scale, scale_min, scale_max)

        // still add a tiny position correction (5 % of Kx/Kxdot) to avoid drift
        u_pos = -(Kx * x + Kxdot * x_dot) * 0.05
        u = scale * u_angle + u_pos

    // --------------------------------------------------------------
    // 4) Saturate and dead‑zone
    // --------------------------------------------------------------
