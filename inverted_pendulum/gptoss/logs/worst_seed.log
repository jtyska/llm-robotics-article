import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    if abs(theta) >= 0.20:
        return -3.0 * math.copysign(1.0, theta)

    if abs(theta) <= 0.02:
        raw_force = -(1.0 * x + 0.5 * x_dot)
        return max(min(raw_force, 3.0), -3.0)

    norm = (abs(theta) - 0.02) / (0.18 - 0.02)  # 0 < norm ≤ 1
    k_theta = 5.0 + norm * (30.0 - 5.0)
    k_thetad = 2.0 + norm * (20.0 - 2.0)
    k_x = 0.8 + norm * (2.5 - 0.8)
    k_xdot = 0.2 + norm * (1.0 - 0.2)

    raw_force = -(k_theta * theta + k_thetad * theta_dot + k_x * x + k_xdot * x_dot)
    return max(min(raw_force, 3.0), -3.0)

    # fallback (should not be reached)
    return random.uniform(-3.0, 3.0)
