import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    def sign(x):
        return 1.0 if x > 0 else -1.0 if x < 0 else 0.0

    def clamp(v, lo, hi):
        return max(lo, min(v, hi))

    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    if abs(pole_angle) >= 0.18:
        return clamp(-sign(pole_angle) * 3.0, -3.0, 3.0)

    if abs(pole_angle) <= 0.02:
        raw = -(1.2 * cart_position + 0.8 * cart_velocity)
        raw -= 0.02 * sign(raw)
        return clamp(raw, -3.0, 3.0)

    raw = -(13.0 * pole_angle + 9.0 * pole_angular_velocity)
    raw -= 0.02 * sign(raw)
