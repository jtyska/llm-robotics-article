def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    force = None
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    else:
        abs_theta = abs(pole_angle)
        if abs_theta <= 0.05:
            tilt_norm = 0.0
        elif abs_theta >= 0.20:
            tilt_norm = 1.0
        else:
            tilt_norm = (abs_theta - 0.05) / (0.20 - 0.05)
        Kp_theta = (1 - tilt_norm) * 8.0 + tilt_norm * 30.0
        Kd_theta = (1 - tilt_norm) * 4.0 + tilt_norm * 15.0
        Kp_x = 0.3
        Kd_x = 0.2
        u_grav = 9.81 * math.sin(pole_angle)
        u_pd = -(Kp_theta * pole_angle + Kd_theta * pole_angular_velocity +
                 Kp_x * cart_position + Kd_x * cart_velocity)
        u_raw = u_pd + u_grav
        force_raw = 3.0 * math.tanh(u_raw / 2.0)
        if force_raw > 3.0:
            force = 3.0
        elif force_raw < -3.0:
            force = -3.0
