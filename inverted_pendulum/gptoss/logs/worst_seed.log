import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non‑finite inputs
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Compute tilt factor
    tilt_raw = (abs(pole_angle) - 0.05) / (0.20 - 0.05)
    if tilt_raw < 0:
        tilt = 0.0
    elif tilt_raw > 1:
        tilt = 1.0
    else:
        tilt = tilt_raw

    # Gains
    Kp_pole = 12.0 * tilt + 4.0
    Kd_pole = 2.5 * tilt + 1.0
    Kp_cart = 0.8 * tilt + 0.2
    Kd_cart = 0.2 * tilt + 0.05

    # PD control terms
    pole_pd = -Kp_pole * pole_angle - Kd_pole * pole_angular_velocity
    cart_pd = -Kp_cart * cart_position - Kd_cart * cart_velocity

    raw_force = pole_pd + cart_pd

    # Clamp to action limits
    if raw_force > 3.0:
        force = 3.0
    elif raw_force < -3.0:
        force = -3.0
    else:
        force = raw_force

    return force

    # Default random action (unreachable with current rules)
    # return random.uniform(-3, 3)
