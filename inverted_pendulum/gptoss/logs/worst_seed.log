### 3. Updated rule‑set (pseudocode)

```text
# -------------------------------------------------
#  CART‑POLE BALANCING CONTROLLER
# -------------------------------------------------
# Input:  x, x_dot, theta, theta_dot   (float)
# Output: force ∈ [‑3.0 , 3.0]          (float)

IF NOT (isfinite(x) AND isfinite(x_dot) AND
        isfinite(theta) AND isfinite(theta_dot)) THEN
    force = 0.0
ELSE IF abs(theta) < 0.02 THEN
    # Near‑vertical: weak cart‑position controller
    force = clamp( -0.8 * x  - 0.4 * x_dot , -3.0 , 3.0 )
ELSE
    # -------------------------------------------------
    # 1) Compute a gain‑scaling factor that grows with |θ|
    # -------------------------------------------------
    scale = 1.0 + (abs(theta) - 0.02) / (0.20 - 0.02)   # linear from 1 → 2
    IF scale > 2.0 THEN
        # give a little extra boost when the pole is really far
        IF abs(theta) > 0.15 THEN
            scale = 2.5
        ELSE
            scale = 2.0
        ENDIF
    ENDIF

    # -------------------------------------------------
    # 2) Linear‑feedback law (base gains)
    # -------------------------------------------------
    #   -15·θ   : strong proportional term on angle
    #   -10·θ̇  : strong damping on angular velocity
    #   -0.3·x  : mild pull‑to‑centre (less than in the small‑θ branch)
    #   -0.1·ẋ : mild damping of cart velocity
    u_raw = -(15.0 * theta + 10.0 * theta_dot
              + 0.3 * x + 0.1 * x_dot)

    # -------------------------------------------------
    # 3) Apply scaling
    # -------------------------------------------------
    u_scaled = scale * u_raw

    # -------------------------------------------------
    # 4) Soft saturation (smoothly respects the physical limit)
    # -------------------------------------------------
    u_soft = 3.0 * tanh( u_scaled / 3.0 )

    # -------------------------------------------------
    # 5) Final clipping (just in case)
    # -------------------------------------------------
    force = clamp( u_soft , -3.0 , 3.0 )
END IF
```

