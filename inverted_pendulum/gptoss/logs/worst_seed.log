def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    def clamp(v, lo, hi):
        return max(lo, min(hi, v))
    def sign(v):
        return 1 if v > 0 else -1 if v < 0 else 0
    def deadzone(v, dz):
        return 0.0 if abs(v) < dz else v

    Kθ = 12.0
    Kθdot = 8.0
    Kx = 0.8
    Kxdot = 0.6
    MAX_FORCE = 3.0
    MIN_FORCE = -3.0
    DEAD_ZONE = 0.02

    # Finite check
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if abs(theta) >= 0.18:
        force = clamp(-sign(theta) * MAX_FORCE, MIN_FORCE, MAX_FORCE)
        return force
    elif abs(theta) <= 0.04:
        raw = -(Kx * x + Kxdot * x_dot)
        raw = deadzone(raw, DEAD_ZONE)
        force = clamp(raw, MIN_FORCE, MAX_FORCE)
        return force
    else:
        # Angle‑dominant region (0.04 < |θ| < 0.18)
        u_angle = -(Kθ * theta + Kθdot * theta_dot)

        scale = 1.0 + (abs(theta) - 0.04) / (0.18 - 0.04)   # 0 … 1
        scale = clamp(scale, 0.0, 1.0)                     # safety
        scale = 1.0 + scale                               # → 1.0 … 2.0

        cart_bias = -(Kx * x + Kxdot * x_dot) * (1.0 - scale / 2.0)

        raw = scale * u_angle + cart_bias
        raw = deadzone(raw, DEAD_ZONE)
        force = clamp(raw, MIN_FORCE, MAX_FORCE)
        return force

    # Default random action (should not be reached)
    return random.uniform(-3.0, 3.0)
