import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    abs_theta = abs(theta)
    if abs_theta <= 0.05:
        t = 0.0
    elif abs_theta >= 0.20:
        t = 1.0
    else:
        t = (abs_theta - 0.05) / (0.20 - 0.05)

    Kp_theta = 15.0 + 5.0 * t
    Kd_theta = 0.8  + 0.4 * t
    Kp_x     = 0.05 + 0.05 * t
    Kd_x     = 0.02 + 0.03 * t

    sign_theta = 1.0 if theta > 0 else (-1.0 if theta < 0 else 0.0)
    bias = 0.03 * sign_theta * (1.0 + 0.5 * t)

    u = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * x + Kd_x * x_dot) + bias

    Fsoft = 0.6 + 2.4 * t
    if Fsoft > 3.0:
        Fsoft = 3.0

    force_raw = math.tanh(u / Fsoft) * Fsoft

    if force_raw > 3.0:
        force = 3.0
    elif force_raw < -3.0:
        force = -3.0
    else:
        force = force_raw

    return force

    # default random action (unreachable)
    return random.uniform(-3, 3)
