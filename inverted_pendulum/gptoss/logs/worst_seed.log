import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non-finite values
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0

    theta = pole_angle
    theta_dot = pole_angular_velocity
    x = cart_position
    x_dot = cart_velocity

    theta_abs = abs(theta)

    if theta_abs <= 0.05:
        tilt_norm = 0.0
    elif theta_abs >= 0.18:
        tilt_norm = 1.0
    else:
        tilt_norm = (theta_abs - 0.05) / (0.18 - 0.05)

    Kp_theta = (1 - tilt_norm) * 12.0 + tilt_norm * 6.0
    Kd_theta = (1 - tilt_norm) * 6.0 + tilt_norm * 12.0

    Kp_x = (1 - tilt_norm) * 0.05 + tilt_norm * 0.12
    Kd_x = (1 - tilt_norm) * 0.05 + tilt_norm * 0.15

    u_raw = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * x + Kd_x * x_dot)

    force = 3.0 * math.tanh(u_raw / 0.9)

    if abs(force) < 0.01:
        force = 0.0

    return force

    # Fallback random action (should never be reached)
    return random.uniform(-3.0, 3.0)
