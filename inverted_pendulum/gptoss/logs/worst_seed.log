import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    def clamp(v, lo, hi):
        return max(lo, min(v, hi))

    action = None

    if not (math.isfinite(x) and math.isfinite(theta) and math.isfinite(x_dot) and math.isfinite(theta_dot)):
        action = 0.0
    elif abs(theta) >= 0.18:
        if theta > 0:
            action = -3.0
        elif theta < 0:
            action = 3.0
        else:
            action = 0.0
    else:
        w_angle = clamp((0.18 - abs(theta)) / (0.18 - 0.02), 0.0, 1.0)
        w_cart  = clamp((0.18 - abs(theta)) / (0.18 - 0.08), 0.0, 1.0)

        u_angle = -(13.0 * theta + 2.5 * theta_dot)
        u_cart  = -(0.9 * x + 0.35 * x_dot)

        scale_angle = clamp(1.0 + (abs(theta) - 0.02) / (0.18 - 0.02), 1.0, 2.0)

        raw_force = w_angle * scale_angle * u_angle + w_cart * u_cart
        force = clamp(raw_force, -3.0, 3.0)

        if abs(force) < 0.02:
            force = 0.0

        action = force

    if action is None:
        action = random.uniform(-3.0, 3.0)

    return action
