def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # Check for non‑finite values
    if (not math.isfinite(cart_position) or
        not math.isfinite(cart_velocity) or
        not math.isfinite(pole_angle) or
        not math.isfinite(pole_angular_velocity)):
        return 0.0

    # Compute tilt_raw with clamping
    tilt_raw = (abs(pole_angle) - 0.05) / (0.18 - 0.05)
    tilt_raw = max(0.0, min(tilt_raw, 1.0))

    # Gains
    Kp_theta = 10.0 + (16.0 - 10.0) * tilt_raw
    Kd_theta = 4.0  + (6.0  - 4.0)  * tilt_raw
    Kp_cart  = 0.08 + (0.12 - 0.08) * tilt_raw
    Kd_cart  = 0.015+ (0.025- 0.015)* tilt_raw
    ff_gain  = 0.0  + (0.35 - 0.0) * tilt_raw

    # Raw force computation
    force_raw = -Kp_theta * pole_angle

    # Clamp to action limits
    action = max(-3.0, min(force_raw, 3.0))
    return action

    # Default random action if no rule applies (unreachable)
    return random.uniform(-3.0, 3.0)
