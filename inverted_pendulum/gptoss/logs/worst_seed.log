```text
// ------------------------------------------------------------------
//  CART‑POLE BALANCING CONTROLLER (continuous force ∈ [‑3, +3] N)
// ------------------------------------------------------------------
//  State variables (all floats):
//      x        – cart position (m)
//      x_dot    – cart velocity (m/s)
//      theta    – pole angle   (rad)   (0 = upright)
//      theta_dot– pole angular velocity (rad/s)
//
//  Helper functions
//      sign(v)  – returns -1, 0 or +1
//      clip(v, lo, hi) – clamps v to the interval [lo, hi]
//
// ------------------------------------------------------------------
IF ( NOT isfinite(x)   OR NOT isfinite(x_dot)   OR
     NOT isfinite(theta) OR NOT isfinite(theta_dot) ) THEN
    force ← 0.0                                          // safety guard
ELSE IF ( abs(theta) ≥ 0.18 ) THEN
    // Pole is already out of the allowed range – apply maximum
    // opposite force to try to stop the fall (still respects clip)
    force ← clip( -3.0 * sign(theta) , -3.0 , 3.0 )
ELSE
    // --------------------------------------------------------------
    // 1) Compute a smooth gain that grows with the absolute angle.
    //    g = 1.0  when |θ| ≤ 0.02  (quiet region)
    //    g = 2.0  when |θ| = 0.18   (maximum effort)
    // --------------------------------------------------------------
    IF ( abs(theta) ≤ 0.02 ) THEN
        g ← 1.0
    ELSE
        g ← 1.0 + ( abs(theta) - 0.02 ) / (0.18 - 0.02)   // linear ∈[1,2]
    END IF

    // --------------------------------------------------------------
    // 2) Base linear controller (LQR‑like) – coefficients tuned
    //    for the classic cart‑pole (mass = 1 kg, pole = 0.1 kg, …)
    // --------------------------------------------------------------
    //   k_x      = 0.5   (cart‑position feedback)
    //   k_xdot   = 0.1   (cart‑velocity feedback)
    //   k_theta  = 8.0   (pole‑angle feedback)
    //   k_thetad = 2.5   (pole‑angular‑velocity feedback)
    //
    //   The angle‑related terms are multiplied by the gain g,
    //   which automatically increases both proportional and
    //   derivative effort as the pole tilts.
    // --------------------------------------------------------------
    raw ← -( 0.5   * x
            + 0.1   * x_dot
            + g * ( 8.0   * theta
                    + 2.5   * theta_dot ) )

    // --------------------------------------------------------------
    // 3) Clip to the admissible force range.
    // --------------------------------------------------------------
    force ← clip( raw , -3.0 , 3.0 )
END IF
```

