import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non-finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    theta = pole_angle
    thetadot = pole_angular_velocity
    x = cart_position
    xdot = cart_velocity

    a = abs(theta)
    s = (a - 0.04) / (0.20 - 0.04)
    if s < 0:
        s = 0.0
    if s > 1:
        s = 1.0

    k_theta   = 2.0  + (15.0 - 2.0)  * s
    k_theta_d = 0.5  + (5.0  - 0.5)  * s
    k_x       = 0.1  + (1.0  - 0.1)  * s
    k_x_d     = 0.05 + (0.5  - 0.05) * s

    b = abs(x)
    if b > 0.25:
        extra = 0.6 * (1 if x > 0 else -1) * (b - 0.25)
    else:
        extra = 0.0

    raw = -(k_theta * theta +
            k_theta_d * thetadot +
            k_x * x +
            k_x_d * xdot) - extra

    if raw > 3.0:
        action = 3.0
    elif raw < -3.0:
        action = -3.0
    else:
        action = raw

    return action if action is not None else random.uniform(-3.0, 3.0)
