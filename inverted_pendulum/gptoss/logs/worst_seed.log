    if force_raw > 3.0:
        force = 3.0
    elif force_raw < -3.0:
        force = -3.0
    else:
        force = force_raw

    # Default fallback (should never be reached)
    if force is None:
        force = random.uniform(-3.0, 3.0)

    return force
