def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    force = None
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    else:
        u_raw = -(24.0 * pole_angle + 11.0 * pole_angular_velocity + 1.0 * cart_position + 0.5 * cart_velocity)
        u_raw += 9.81 * math.sin(pole_angle)
        f = 3.0 * math.tanh(u_raw / 1.0)
        if f > 3.0:
            force = 3.0
        elif f < -3.0:
            force = -3.0
        else:
            force = f
    if force is None:
        return random.uniform(-3, 3)
    return force
