import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if not hasattr(get_action, "integral_theta"):
        get_action.integral_theta = 0.0
    dt = 0.02
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    tilt_raw = min(max(abs(pole_angle) / 0.20, 0.0), 1.0)
    Kp_theta = 8.0 + 70.0 * tilt_raw
    Kd_theta = 3.0 + 30.0 * tilt_raw
    Kp_cart = 0.1 + 0.8 * tilt_raw
    Kd_cart = 0.02 + 0.15 * tilt_raw
    ff_gain = 0.5 + 2.5 * tilt_raw
    get_action.integral_theta = 0.99 * get_action.integral_theta + pole_angle * dt
    Ki_theta = 0.1 * tilt_raw
    force_raw = (-Kp_theta * pole_angle
                 -Kd_theta * pole_angular_velocity
                 -Ki_theta * get_action.integral_theta
                 -Kp_cart * cart_position
                 -Kd_cart * cart_velocity
                 +ff_gain * (1 if pole_angle >= 0 else -1))
    force = max(min(force_raw, 3.0), -3.0)
    return force
    return random.uniform(-3, 3)
