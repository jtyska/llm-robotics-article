def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random

    # Helper clamp
    def clamp(val, low, high):
        return max(low, min(val, high))

    action = None

    # Rule: non‑finite inputs
    if (not math.isfinite(cart_position) or
        not math.isfinite(cart_velocity) or
        not math.isfinite(pole_angle) or
        not math.isfinite(pole_angular_velocity)):
        action = 0.0
    else:
        # compute scaling factor based on pole angle magnitude
        f_angle = clamp(abs(pole_angle) / 0.20, 0.0, 1.0)

        # gains for angle control
        K_theta   = 0.80 + f_angle * (4.0  - 0.80)
        K_theta_d = 0.30 + f_angle * (1.5  - 0.30)

        # gains for cart position control (modulated by angle)
        Kx_mod  = 0.80 + f_angle * 0.30
        Kxd_mod = 0.40 + f_angle * 0.15

        # bias term
        bias = -0.001 * cart_position

        # control contributions
        u_cart  = -(Kx_mod * cart_position + Kxd_mod * cart_velocity) + bias
        u_angle = -(K_theta * pole_angle + K_theta_d * pole_angular_velocity)

        # weighting between cart and angle controllers
        weight_angle = 0.5 + 0.5 * f_angle      # 0.5 → 1.0
        weight_cart  = 1.0 - weight_angle       # 0.5 → 0.0

        # combined raw action
        u_raw = weight_cart * u_cart + weight_angle * u_angle

        # final action clipped to allowed range
        action = clamp(u_raw, -3.0, 3.0)

    # default random action if no rule applied (should not happen)
