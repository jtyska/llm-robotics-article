import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0

    theta = pole_angle
    theta_dot = pole_angular_velocity
    x = cart_position

    tilt_raw = (abs(theta) - 0.05) / (0.20 - 0.05)
    if tilt_raw < 0.0:
        tilt_raw = 0.0
    elif tilt_raw > 1.0:
        tilt_raw = 1.0

    Kp = 6.0 + 94.0 * (tilt_raw * tilt_raw)
    Kd = 1.5

    pole_effort = -Kp * theta - Kd * theta_dot

    if tilt_raw < 0.15:
        cart_bias = -0.04 * x
    else:
        cart_bias = 0.0

    raw_force = pole_effort + cart_bias
    force = 3.0 * math.tanh(raw_force * (3.0 / 10.0))

    if force > 3.0:
        force = 3.0
    elif force < -3.0:
        force = -3.0

    return force

    # default fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
