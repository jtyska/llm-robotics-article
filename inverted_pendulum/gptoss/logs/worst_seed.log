    force ← 0.0
ELSE IF ( abs(theta) ≥ 0.15 )                     // emergency zone
    // push hard opposite to the tilt, also consider angular speed
    raw ← -3.0 * sign(theta) - 0.5 * sign(theta_dot)
    force ← clip(raw, -3.0, 3.0)

