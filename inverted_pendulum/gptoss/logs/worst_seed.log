def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    absTheta = abs(pole_angle)
    if absTheta <= 0.02:
        scale = 0.0
    elif absTheta >= 0.25:
        scale = 1.0
    else:
        scale = (absTheta - 0.02) / (0.25 - 0.02)
    k_theta = (1 - scale) * 5.0 + scale * 15.0
    k_theta_dot = (1 - scale) * 1.0 + scale * 4.0
    k_x = (1 - scale) * 0.3 + scale * 0.05
    k_x_dot = (1 - scale) * 0.05 + scale * 0.01
    raw_force = -(k_theta * pole_angle
                  + k_theta_dot * pole_angular_velocity
                  + k_x * cart_position
                  + k_x_dot * cart_velocity
                  + 0.1 * cart_position)
    if raw_force > 3.0:
        force = 3.0
    elif raw_force < -3.0:
        force = -3.0
    else:
        force = raw_force
    return force

