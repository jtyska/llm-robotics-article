def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    def clamp(val, lo, hi):
        return max(lo, min(hi, val))
    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity
    action = None
    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        action = 0.0
    else:
        tilt_norm = clamp((abs(theta) - 0.05) / (0.20 - 0.05), 0.0, 1.0)
        Kp_theta = 3.0 + 2.0 * tilt_norm
        Kd_theta = 1.5 + 1.0 * tilt_norm
        pole_pd = -(Kp_theta * math.sin(theta) + Kd_theta * theta_dot + 0.2 * theta_dot)
        gravity_ff = 0.85 * 9.81 * math.sin(theta)
        cart_pd = -(0.005 * x + 0.01 * x_dot)
        centre_bias = -0.02 * x
        u_raw = pole_pd + gravity_ff + cart_pd + centre_bias
        alpha = 0.9 + 0.6 * tilt_norm
        force = clamp(3.0 * math.tanh(alpha * u_raw), -3.0, 3.0)
        action = force
    if action is None:
        return random.uniform(-3.0, 3.0)
    return action
