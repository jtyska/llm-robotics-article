import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non-finite values
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Failure condition: pole angle beyond limits
    if abs(pole_angle) >= 0.20:
        sign = 1.0 if pole_angle > 0 else -1.0
        return -3.0 * sign

    # Main control law
    rel = (abs(pole_angle) - 0.01) / (0.18 - 0.01)
    if rel < 0.0:
        rel = 0.0
    elif rel > 1.0:
        rel = 1.0

    scale = 1.0 + rel * (2.5 - 1.0)

    cart_part = -(1.0 * cart_position + 0.8 * cart_velocity)
    angle_part = -(45.0 * pole_angle + 10.0 * pole_angular_velocity)

    raw = cart_part + scale * angle_part

    if raw > 3.0:
        return 3.0
    elif raw < -3.0:
        return -3.0
    else:
        return raw

