import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Rule 1: non‑finite values
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Rule 2: pole angle beyond limit
    if abs(pole_angle) >= 0.20:
        sign = 1.0 if pole_angle > 0 else -1.0
        return -3.0 * sign

    # Rule 3: pole angle near upright
    if abs(pole_angle) <= 0.02:
        raw = -(0.9 * cart_position + 0.12 * cart_velocity) - 0.25 * cart_velocity
        return max(min(raw, 3.0), -3.0)

    # Rule 4: intermediate angles
    rel = (abs(pole_angle) - 0.02) / (0.18 - 0.02)  # denominator = 0.16
    rel = max(0.0, min(rel, 1.0))
    scale = 1.0 + rel * (2.5 - 1.0)  # 1 ≤ scale ≤ 2.5
    raw = -(33.0 * pole_angle + 4.5 * pole_angular_velocity) * scale
    return max(min(raw, 3.0), -3.0)

    # Default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
