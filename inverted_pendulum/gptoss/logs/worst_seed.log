import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if (not math.isfinite(cart_position) or not math.isfinite(cart_velocity) or
        not math.isfinite(pole_angle) or not math.isfinite(pole_angular_velocity)):
        return 0.0
    Kp_theta = 8.0
    Kd_theta = 2.5
    Kp_cart = 0.04
    Kd_cart = 0.01

    pole_effort = -Kp_theta * pole_angle - Kd_theta * pole_angular_velocity
    cart_effort = -Kp_cart * cart_position - Kd_cart * cart_velocity

    force_raw = pole_effort + cart_effort
    force = max(-3.0, min(3.0, force_raw))
    return force

    # default random action if no rule applies (unreachable in current logic)
    return random.uniform(-3.0, 3.0)
