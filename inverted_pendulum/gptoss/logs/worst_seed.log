import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    xdot = cart_velocity
    thetadot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(theta) and math.isfinite(xdot) and math.isfinite(thetadot)):
        return 0.0

    def clamp(val, lo, hi):
        return max(min(val, hi), lo)

    if abs(theta) >= 0.08:
        action = clamp(-(9.0 * theta) - (2.5 * thetadot), -3.0, 3.0)
        return action
    else:
        w = abs(theta) / 0.08  # 0 ≤ w < 1
        F_angle = -(9.0 * theta) - (2.5 * thetadot)
        F_cart = -(0.6 * x) - (0.4 * xdot)
        F = (1 - w) * (F_angle + F_cart) + w * F_angle
        action = clamp(F, -3.0, 3.0)
        return action

    # Default random action (should not be reached)
    return random.uniform(-3.0, 3.0)
