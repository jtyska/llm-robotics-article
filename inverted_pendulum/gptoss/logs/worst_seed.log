import random, math

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    xdot = cart_velocity
    thetadot = pole_angular_velocity

    # Check for non‑finite values
    if not (math.isfinite(x) and math.isfinite(xdot) and math.isfinite(theta) and math.isfinite(thetadot)):
        return 0.0

    # Small‑angle, near‑center dead zone
    if abs(theta) <= 0.04 and abs(x) <= 0.02:
        return 0.0

    # Determine base gains from |theta|
    at = abs(theta)
    if at <= 0.08:
        Kx, Kxd, Kθ, Kθd = 0.8, 0.4, 5.0, 1.5
    elif at <= 0.12:
        Kx, Kxd, Kθ, Kθd = 0.8, 0.4, 9.0, 2.8
    else:
        Kx, Kxd, Kθ, Kθd = 0.8, 0.4, 13.0, 4.0

    # Far‑cart recovery boost
    if abs(x) > 0.40:
        Kx += 0.5
        Kxd += 0.3

    # Compute raw control command with quadratic bias
    F_raw = -(Kx * x + Kxd * xdot + Kθ * theta + Kθd * thetadot)
    sign_theta = math.copysign(1.0, theta) if theta != 0 else 0.0
    F_raw -= 0.1 * sign_theta * (abs(theta) ** 2)

    # Saturate to allowed force range
    if F_raw > 3.0:
        F = 3.0
    elif F_raw < -3.0:
        F = -3.0
    else:
        F = F_raw

    return F if isinstance(F, float) else float(F)

    # Default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
