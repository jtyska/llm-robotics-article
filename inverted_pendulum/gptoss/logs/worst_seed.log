def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0
    theta = pole_angle
    x = cart_position
    x_dot = cart_velocity
    aTheta = abs(theta)
    if aTheta >= 0.20:
        sign = 1 if theta > 0 else -1 if theta < 0 else 0
        return -3.0 * sign
    if aTheta <= 0.02:
        raw_force = -(1.0 * x + 0.5 * x_dot)
        return raw_force
    s = (aTheta - 0.02) / (0.20 - 0.02)
    return random.uniform(-3, 3)
