import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(theta) and math.isfinite(x_dot) and math.isfinite(theta_dot)):
        return 0.0

    if abs(theta) >= 0.18:
        sign = math.copysign(1, theta) if theta != 0 else 0.0
        return -sign * 3.0

    # blended control
    w_angle = (abs(theta) - 0.02) / (0.18 - 0.02)
    w_angle = max(0.0, min(1.0, w_angle))
    w_cart = 1.0 - w_angle

    u_angle = -(15.0 * theta + 3.0 * theta_dot)
    u_cart = -(1.0 * x + 0.4 * x_dot)

    scale_angle = 1.0 + w_angle
    raw_force = w_angle * scale_angle * u_angle + w_cart * u_cart
    force = max(-3.0, min(3.0, raw_force))

    if abs(force) < 0.001:
        force = 0.0

    return force

    # fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
