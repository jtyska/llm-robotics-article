if not (isfinite(x) and isfinite(theta) and isfinite(x_dot) and isfinite(theta_dot)):
    force = 0.0

elif abs(theta) >= θ_big:
    # Hard push – bring the pole back quickly
    force = clamp(-sign(theta) * 3.0, -3.0, 3.0)

else:
    # Base controllers
    u_angle = -(Kθ * theta + Kθ_dot * theta_dot)          # pure angle term
    u_pos   = -(Kx * x + Kx_dot * x_dot)                 # pure cart term

    if abs(theta) <= θ_small:
        # When the pole is very close to vertical we rely almost entirely on the cart controller
        raw = u_pos
    else:
        # In the intermediate band we blend the two terms.
        # The blending factor grows linearly with |θ| so that the angle term dominates as the pole tilts.
        blend = (abs(theta) - θ_small) / (θ_big - θ_small)   # 0 … 1
        # Scale the angle term (1 → scale_max) – this is the “gain‑schedule” that proved useful.
        scale = scale_min + blend * (scale_max - scale_min)
        scale = clamp(scale, scale_min, scale_max)

        # Mix the two contributions.  A small weight (≈0.2) on the position term is enough to stop drift.
        raw = scale * u_angle + 0.2 * u_pos
    # Saturate to the actuator limits
    force = clamp(raw, -3.0, 3.0)
