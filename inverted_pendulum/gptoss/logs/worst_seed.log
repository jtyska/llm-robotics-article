import random, math

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    force = None
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    elif abs(pole_angle) < 0.02:
        force = 0.0
    else:
        force_raw = (-12.0) * pole_angle + (-2.5) * pole_angular_velocity + (-0.5) * cart_position + (-0.1) * cart_velocity
        if force_raw > 3.0:
            force = 3.0
        elif force_raw < -3.0:
            force = -3.0
        else:
            force = force_raw
    if force is None:
        return random.uniform(-3, 3)
    return force
