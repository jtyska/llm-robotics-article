def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    force = None
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    elif abs(pole_angle) >= 0.20:
        force = 0.0
    elif abs(pole_angle) < 0.02:
        u_cart = -(0.8 * cart_position + 0.4 * cart_velocity)
        force = max(min(u_cart, 3.0), -3.0)
    else:
        u_angle = -(10.0 * pole_angle + 2.5 * pole_angular_velocity)
        u_cart = -(0.8 * cart_position + 0.4 * cart_velocity)
        theta_abs = abs(pole_angle)
        scale = 1.0 + (theta_abs - 0.02) / (0.20 - 0.02)
        if scale < 1.0:
            scale = 1.0
        if scale > 2.0:
            scale = 2.0
        raw_force = scale * (u_angle + u_cart)
        force = max(min(raw_force, 3.0), -3.0)
    if force is None:
        return random.uniform(-3, 3)
    return force
