import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if not hasattr(get_action, "x_int"):
        get_action.x_int = 0.0
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    tilt_raw = (abs(pole_angle) - 0.05) / (0.20 - 0.05)
    if tilt_raw < 0.0:
        tilt_raw = 0.0
    elif tilt_raw > 1.0:
        tilt_raw = 1.0
    g = tilt_raw * tilt_raw
    Kp_theta = 12.0 + 30.0 * g
    Kd_theta = 5.0 + 15.0 * g
    Kp_cart = 0.20 * (1.0 - g)
    Kd_cart = 0.04 * (1.0 - g)
    Kp_center = 0.10 * tilt_raw
    alpha_int = 0.01
    get_action.x_int = (1.0 - alpha_int) * get_action.x_int + alpha_int * cart_position
    if get_action.x_int > 0.5:
        get_action.x_int = 0.5
    elif get_action.x_int < -0.5:
        get_action.x_int = -0.5
    Ki_cart = 0.02 * (1.0 - g)
    pole_effort = -Kp_theta * pole_angle - Kd_theta * pole_angular_velocity
    cart_effort = -Kp_cart * cart_position - Kd_cart * cart_velocity
    int_effort = -Ki_cart * get_action.x_int
    center_effort = -Kp_center * cart_position
    force_raw = pole_effort + cart_effort + int_effort + center_effort
    if force_raw > 3.0:
        force = 3.0
    elif force_raw < -3.0:
        force = -3.0
    else:
        force = force_raw
    return force
    return random.uniform(-3.0, 3.0)
