import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Helper clamp
    def clamp(val, min_val, max_val):
        return max(min(val, max_val), min_val)

    # Check for non-finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Failure condition on pole angle
    if abs(pole_angle) > 0.20:
        return 0.0

    # Compute adaptive gains
    alpha_raw = (abs(pole_angle) - 0.02) / (0.20 - 0.02)
    alpha = clamp(alpha_raw, 0.0, 1.0)

    K_theta   = (1 - alpha) * 1.0 + alpha * 8.0
    K_theta_d = (1 - alpha) * 0.5 + alpha * 3.0
    K_x       = (1 - alpha) * 0.80 + alpha * 0.10
    K_x_d     = (1 - alpha) * 0.40 + alpha * 0.10

    # Control components
    u_grav   = -9.8 * math.sin(pole_angle)
    u_angle  = -(K_theta * pole_angle + K_theta_d * pole_angular_velocity)
    u_cart   = -(K_x * cart_position + K_x_d * cart_velocity)

    u_raw = u_grav + u_angle + u_cart
    u_clamped = clamp(u_raw, -3.0, 3.0)

    if abs(u_clamped) < 0.01:
        return 0.0
    else:
        return u_clamped

    # Default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
