import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0

    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity

    tilt_raw = (abs(theta) - 0.05) / (0.18 - 0.05)
    if tilt_raw < 0:
        tilt_raw = 0.0
    if tilt_raw > 1:
        tilt_raw = 1.0

    tilt_gain = tilt_raw ** 3

    Kp_theta = 4.0 + 6.0 * tilt_gain
    Kd_theta = 2.0 + 3.0 * tilt_gain

    base_Kp_x = 0.20 * (1 - tilt_raw) + 0.02
    base_Kd_x = 0.04 * (1 - tilt_raw) + 0.004

    centre_bias = -base_Kp_x * x - base_Kd_x * x_dot
    vel_damp = -0.03 * x_dot

    if abs(x_dot) > 0.5:
        ff = -0.5 * math.copysign(1, x_dot)
    else:
        ff = 0.0

    pole_effort = -Kp_theta * theta - Kd_theta * theta_dot

    raw_force = pole_effort + centre_bias + vel_damp + ff
    force = 3.0 * math.tanh(0.35 * raw_force)

    if force < -3.0:
        force = -3.0
    if force > 3.0:
        force = 3.0

    return force

    return random.uniform(-3, 3)
