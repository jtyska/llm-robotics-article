import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    def clamp(val, low, high):
        return max(min(val, high), low)

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    if abs(theta) < 0.02:
        action = clamp(-(0.8 * x + 0.4 * x_dot), -3.0, 3.0)
        return action

    # linear feedback
    u_lin = -(13.0 * theta + 10.0 * theta_dot + 0.6 * x + 0.3 * x_dot)

    # angle‑dependent scale (cubic)
    theta_abs = abs(theta)
    norm = (theta_abs - 0.02) / (0.20 - 0.02)
    if norm < 0:
        norm = 0.0
    if norm > 1:
        norm = 1.0
    scale = 1.0 + 4.0 * (norm ** 3)

    # recovery boost (cubic, activates after 0.08 rad)
    if theta_abs > 0.08:
        boost = -7.0 * math.copysign(1.0, theta) * ((theta_abs - 0.08) ** 3)
    else:
        boost = 0.0

    # combine, soft‑saturate and clip
    u_raw = u_lin * scale + boost
    u_soft = 3.0 * math.tanh(u_raw / 3.0)
    action = clamp(u_soft, -3.0, 3.0)
    return action

    # default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
