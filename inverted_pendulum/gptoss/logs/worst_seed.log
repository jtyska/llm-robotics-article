import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non‑finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Failure condition: pole angle out of bounds
    if abs(pole_angle) >= 0.20:
        sign = 1.0 if pole_angle > 0 else -1.0 if pole_angle < 0 else 0.0
        return -sign * 3.0

    # Compute scaling factor
    if abs(pole_angle) <= 0.02:
        scale = 1.0
    elif abs(pole_angle) >= 0.18:
        scale = 2.0
    else:
        scale = 1.0 + (abs(pole_angle) - 0.02) * (2.0 - 1.0) / (0.18 - 0.02)

    # LQR‑like gains
    u_angle = -(30.0 * pole_angle + 10.0 * pole_angular_velocity)
    u_cart = -(1.0 * cart_position + 0.5 * cart_velocity)

    # Raw force before saturation
    force_raw = scale * u_angle + u_cart

    # Smooth saturation to [-3, 3]
    force = 3.0 * math.tanh(force_raw / 3.0)

    # Return computed force
    return force

    # Default random action (should not be reached)
    return random.uniform(-3.0, 3.0)
