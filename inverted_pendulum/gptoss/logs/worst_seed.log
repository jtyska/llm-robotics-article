def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # Rule 1 – safety
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    # Alias for readability
    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity
    abs_theta = abs(theta)
    # Rule 2 – normalised tilt
    if abs_theta <= 0.05:
        tilt = 0.0
    elif abs_theta >= 0.20:
        tilt = 1.0
    else:
        tilt_raw = (abs_theta - 0.05) / (0.20 - 0.05)
        tilt = max(0.0, min(tilt_raw, 1.0))
    # Rule 3 – gain schedule
    Kp_pole = 5.0 + 150.0 * tilt * tilt
    Kd_pole = 2.0 + 30.0 * tilt * tilt
    Ki_pole = 0.03 * tilt
    Kp_cart = 0.05 + 0.20 * tilt * tilt
    Kd_cart = 0.01 + 0.05 * tilt * tilt
    # Rule 4 – velocity‑dependent boost
    vel_boost = 1.0
    if abs(theta_dot) > 1.0:
        vel_boost *= 1.2
    if abs(x_dot) > 0.8:
        vel_boost *= 1.1
    vel_boost = max(1.0, min(vel_boost, 1.5))
    # Rule 5 – feed‑forward term
    ff_gain = 1.2 * tilt
    sign_theta = 1.0 if theta > 0 else (-1.0 if theta < 0 else 0.0)
    ff_term = -ff_gain * theta_dot * sign_theta
    # Rule 6 – PD + I contributions
    pole_pd = -Kp_pole * theta - Kd_pole * theta_dot * vel_boost
    pole_i = -Ki_pole * theta
    cart_pd = -Kp_cart * x - Kd_cart * x_dot
    # Rule 7 – combine everything
    raw_force = pole_pd + pole_i + cart_pd + ff_term
    # Rule 8 – hard‑limit at failure angle
    if abs_theta >= 0.20:
        raw_force = -3.0 * sign_theta
    # Rule 9 – final saturation
    force = max(-3.0, min(raw_force, 3.0))
    return force

