import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # initialize persistent integral term
    if not hasattr(get_action, "cart_int"):
        get_action.cart_int = 0.0

    # safety check for finite values
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0

    abs_theta = abs(pole_angle)

    if abs_theta <= 0.05:
        tilt_norm = 0.0
    elif abs_theta >= 0.18:
        tilt_norm = 1.0
    else:
        tilt_norm = (abs_theta - 0.05) / (0.18 - 0.05)

    Kp_theta = 8.0 + 12.0 * tilt_norm
    Kd_theta = 2.0 + 4.0 * tilt_norm
    Kp_x = 0.5 + 1.5 * tilt_norm
    Kd_x = 0.6 + 1.4 * tilt_norm

    # update integral term
    get_action.cart_int += 0.01 * cart_position
    if get_action.cart_int > 0.5:
        get_action.cart_int = 0.5
    if get_action.cart_int < -0.5:
        get_action.cart_int = -0.5

    gravity_ff = 9.81 * math.sin(pole_angle)

    u_raw = -(Kp_theta * pole_angle +
              Kd_theta * pole_angular_velocity +
              Kp_x * cart_position +
              Kd_x * cart_velocity +
              get_action.cart_int) + gravity_ff

    u_soft = 3.0 * math.tanh(u_raw / 3.0)

    if abs(u_soft) < 0.01:
        force = 0.0
    else:
        force = u_soft

    # ensure force within bounds [-3, 3]
    force = max(-3.0, min(3.0, force))

    return force if force is not None else random.uniform(-3.0, 3.0)
