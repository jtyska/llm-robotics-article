def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    dt = 0.02
    if not hasattr(get_action, "pole_int"):
        get_action.pole_int = 0.0
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0
    x, x_dot = cart_position, cart_velocity
    theta, theta_dot = pole_angle, pole_angular_velocity
    abs_theta = abs(theta)
    if abs_theta <= 0.05:
        tilt_norm = 0.0
    elif abs_theta >= 0.20:
        tilt_norm = 1.0
    else:
        tilt_norm = (abs_theta - 0.05) / (0.20 - 0.05)
    Kp_pole = 2.0 + (5.5 - 2.0) * tilt_norm
    Kd_pole = 0.8 + (2.8 - 0.8) * tilt_norm
    Ki_pole = 0.08 * tilt_norm if abs_theta < 0.10 else 0.0
    if abs_theta < 0.10:
        get_action.pole_int += theta * dt
    else:
        get_action.pole_int = 0.0
    pole_i = -Ki_pole * get_action.pole_int
    pole_pd = -(Kp_pole * math.sin(theta) + Kd_pole * theta_dot)
    cart_pd = -(0.10 * x + 0.15 * x_dot)
    gravity_ff = 9.81 * math.sin(theta)
    u_raw = pole_pd + gravity_ff + pole_i + cart_pd
    force_raw = 3.0 * math.tanh(u_raw)
    force = 0.0 if abs(force_raw) < 0.01 else force_raw
    return force if force is not None else random.uniform(-3.0, 3.0)
