import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    force = None
    # check finiteness
    if (not math.isfinite(cart_position) or not math.isfinite(cart_velocity) or
        not math.isfinite(pole_angle) or not math.isfinite(pole_angular_velocity)):
        force = 0.0
    else:
        dead_zone = 0.05
        full_angle = 0.18

        # tilt normalisation
        if abs(pole_angle) <= dead_zone:
            tilt = 0.0
        elif abs(pole_angle) >= full_angle:
            tilt = 1.0
        else:
            tilt_raw = (abs(pole_angle) - dead_zone) / (full_angle - dead_zone)
            tilt = max(0.0, min(tilt_raw, 1.0))

        # gain schedule (quadratic)
        Kp_pole = 4.0 + 28.0 * tilt * tilt
        Kd_pole = 1.0 + 6.0 * tilt * tilt
        Kp_cart = 0.08 + 0.32 * tilt * tilt
        Kd_cart = 0.02 + 0.08 * tilt * tilt

        # PD terms
        pole_pd = -Kp_pole * pole_angle - Kd_pole * pole_angular_velocity
        cart_pd = -Kp_cart * cart_position - Kd_cart * cart_velocity

        # feed‑forward on angular velocity
        ff_gain = 0.6 * tilt
        ff_term = -ff_gain * pole_angular_velocity

        # combine and saturate
        raw_force = pole_pd + cart_pd + ff_term
        force = max(-3.0, min(raw_force, 3.0))

    if force is None:
        return random.uniform(-3.0, 3.0)
    return force
