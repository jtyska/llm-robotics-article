import math, random

Kx = 0.4
Kx_dot = 0.6
Kθ_base = 20.0
Kθ_dot_base = 5.0
Kθ_max = 70.0
Kθ_dot_max = 13.0
LOW_FORCE = -3.0
HIGH_FORCE = 3.0

def clamp(v, lo=LOW_FORCE, hi=HIGH_FORCE):
    return max(lo, min(hi, v))

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # Safety guard
    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    # Emergency push
    if abs(theta) >= 0.18:
        return clamp(-math.copysign(3.0, theta))

    # Very small angle (cart‑centering only)
    if abs(theta) <= 0.02:
        u_angle = 0.0
        u_cart = -(Kx * x + Kx_dot * x_dot)
        return clamp(u_angle + u_cart)

    # Moderate tilt (angle control + light cart term)
    z = (abs(theta) - 0.02) / (0.18 - 0.02)  # normalized tilt between 0 and 1
    Kθ = Kθ_base + z * (Kθ_max - Kθ_base)
    Kθ_dot = Kθ_dot_base + z * (Kθ_dot_max - Kθ_dot_base)

    u_angle = -(Kθ * theta + Kθ_dot * theta_dot)
    u_cart = -(Kx * x + Kx_dot * x_dot) * (1.0 - z)  # reduced cart term as tilt grows
    return clamp(u_angle + u_cart)

    # Default random action (should not be reached)
    return random.uniform(-3.0, 3.0)
