import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    # 1. Normalise tilt
    a = 0.20 if abs(theta) > 0.20 else abs(theta)

    # 2. Blending weight
    if a < 0.02:
        w = 0.0
    elif a > 0.20:
        w = 1.0
    else:
        w = (a - 0.02) / (0.20 - 0.02)

    # 3. Cart‑controller
    bias_cart = -0.001 * x
    Kx = 0.80 + 0.30 * w
    Kx_dot = 0.40 + 0.15 * w
    u_cart = -(Kx * x + Kx_dot * x_dot) + bias_cart

    # 4. Angle‑controller
    Kθ = 0.80 + w * (12.0 - 0.80)
    Kθd = 0.30 + w * (4.0 - 0.30)
    u_angle = -(Kθ * theta + Kθd * theta_dot)

    # 5. Blend the two commands
    u_raw = (1.0 - w) * u_cart + w * u_angle

    # 6. Anticipate saturation
    if u_raw > 3.0 - 0.2:
        u_raw = 3.0 - 0.2
    if u_raw < -3.0 + 0.2:
        u_raw = -3.0 + 0.2

    # 7. Final clipping
    if u_raw > 3.0:
        action = 3.0
    elif u_raw < -3.0:
        action = -3.0
    else:
        action = u_raw

    return action

    # default random action (should never be reached)
    return random.uniform(-3, 3)
