import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non‑finite values
    if (not math.isfinite(cart_position) or
        not math.isfinite(pole_angle) or
        not math.isfinite(cart_velocity) or
        not math.isfinite(pole_angular_velocity)):
        return 0.0

    abs_theta = abs(pole_angle)

    if abs_theta <= 0.02:
        s = 0.0
    elif abs_theta >= 0.18:
        s = 1.0
    else:
        s = (abs_theta - 0.02) / (0.18 - 0.02)

    k_theta   = (1 - s) * 5.0  + s * 15.0
    k_theta_d = (1 - s) * 1.0  + s * 4.0
    k_x       = (1 - s) * 0.30 + s * 0.05
    k_x_d     = (1 - s) * 0.05 + s * 0.01

    raw_force = -( (k_theta   * pole_angle) +
                   (k_theta_d * pole_angular_velocity) +
                   (k_x       * cart_position) +
                   (k_x_d     * cart_velocity) +
                   0.1 * cart_position )

    if raw_force > 3.0:
        force = 3.0
    elif raw_force < -3.0:
        force = -3.0
    else:
        force = raw_force

    return force

    # Fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
