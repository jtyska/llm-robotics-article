def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    force = None
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    else:
        # Normalise tilt
        tilt_raw = (abs(pole_angle) - 0.05) / (0.20 - 0.05)
        if tilt_raw < 0.0:
            tilt_raw = 0.0
        elif tilt_raw > 1.0:
            tilt_raw = 1.0

        # Gain‑scheduling
        Kp_theta = 12.0 + 30.0 * tilt_raw ** 2
        Kd_theta = 5.0 + 15.0 * tilt_raw ** 2
        Kp_cart = 0.20 * (1.0 - tilt_raw)
        Kd_cart = 0.04 * (1.0 - tilt_raw)
        Kp_center = 0.10 * (1.0 - tilt_raw)
        ff_gain = 0.6 + 0.8 * tilt_raw
        sign_theta = 1 if pole_angle > 0 else (-1 if pole_angle < 0 else 0)
        ff_bias = -ff_gain * sign_theta * 0.5

        # Effort terms
        pole_effort = -Kp_theta * pole_angle - Kd_theta * pole_angular_velocity
        cart_effort = -Kp_cart * cart_position - Kd_cart * cart_velocity
        center_effort = -Kp_center * cart_position
        ff_effort = ff_bias

        force_raw = pole_effort + cart_effort + center_effort + ff_effort

        # Saturate to allowed range
        if force_raw > 3.0:
            force = 3.0
        elif force_raw < -3.0:
            force = -3.0
        else:
            force = force_raw

    if force is None:
        return random.uniform(-3, 3)
    return force
