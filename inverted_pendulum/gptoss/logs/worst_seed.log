import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Rule 1: non‑finite check
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    theta = pole_angle
    abs_theta = abs(theta)

    # Helper sign function
    def sign(x):
        if x > 0:
            return 1.0
        if x < 0:
            return -1.0
        return 0.0

    # Rule 2
    if abs_theta >= 0.18:
        return -3.0 * sign(theta)

    # Rule 3
    if abs_theta <= 0.02:
        scale = 1.0
        return -3.0 * sign(theta) * scale

    # Rule 4
    if 0.02 < abs_theta < 0.18:
        alpha = (abs_theta - 0.02) / (0.18 - 0.02)
        scale = 1.0 + alpha ** 2
        return -3.0 * sign(theta) * scale

    # Default random action
    return random.uniform(-3.0, 3.0)
