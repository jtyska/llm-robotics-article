def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    abs_theta = abs(theta)
    if abs_theta <= 0.04:
        tilt_raw = 0.0
    elif abs_theta >= 0.20:
        tilt_raw = 1.0
    else:
        tilt_raw = (abs_theta - 0.04) / (0.20 - 0.04)

    gain = tilt_raw ** 3
    Kp_theta = 4.0 + 8.0 * gain
    Kd_theta = 2.0 + 5.0 * gain
    pole_effort = -(Kp_theta * theta + Kd_theta * theta_dot)
    vel_damp = -0.03 * x_dot
    centre_bias = -0.15 * x if tilt_raw < 0.1 else 0.0

    raw_force = pole_effort + vel_damp + centre_bias
    force = 3.0 * math.tanh(0.35 * raw_force)

    if force > 3.0:
        force = 3.0
    elif force < -3.0:
        force = -3.0

    return force if 'force' in locals() else random.uniform(-3, 3)
