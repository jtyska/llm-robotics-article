def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    # persistent integral term
    if not hasattr(get_action, "i_pos"):
        get_action.i_pos = 0.0

    # normalised tilt
    abs_theta = abs(theta)
    if abs_theta <= 0.05:
        t = 0.0
    elif abs_theta >= 0.20:
        t = 1.0
    else:
        t = (abs_theta - 0.05) / (0.20 - 0.05)

    # gain‑schedule
    Kp_theta = 20.0 + 180.0 * (t * t)      # 20 → 200
    Kd_theta = 2.0  + 48.0  * (t * t)      # 2  → 50
    Kp_x     = 0.15 + 0.75 * t             # 0.15 → 0.90
    Kd_x     = 0.05 + 0.35 * t             # 0.05 → 0.40

    # tiny integral on cart position (anti‑drift)
    get_action.i_pos += 0.001 * x
    Ki_x = 0.02

    # gravity feed‑forward & bias
    ff_grav = 0.48 * math.sin(theta)
    bias = 0.03 * math.copysign(1.0, theta) * (1.0 + 2.0 * t)

    # raw control signal
    u = -(Kp_theta * theta
          + Kd_theta * theta_dot
          + Kp_x * x
          + Kd_x * x_dot
          + Ki_x * get_action.i_pos
          + ff_grav) + bias

    # adaptive hard limit (no soft‑saturation)
    Fmax = 0.6 + 2.4 * t
    if Fmax > 3.0:
        Fmax = 3.0

    # hard clipping
    if u > Fmax:
        force = Fmax
    elif u < -Fmax:
        force = -Fmax
    else:
        force = u

    return force

    # default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
