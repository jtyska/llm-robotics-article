    tilt_norm   ← (theta_abs - 0.05) / (0.18 - 0.05)
    tilt_norm   ← clamp(tilt_norm, 0.0, 1.0)

    # ---- 2.  Gain schedule (more aggressive when pole leans) --
    Kp_theta    ← 4.0 + 3.0 * tilt_norm          # proportional on pole
    Kd_theta    ← 2.5 + 2.0 * tilt_norm          # derivative on pole

    # ---- 3.  Pole effort (PD on sin(theta) for correct torque) --
    pole_effort ← -(Kp_theta * sin(theta) + Kd_theta * theta_dot)

    # ---- 4.  Small integral on pole angle (anti‑wind‑up) -----
    IF theta_abs < 0.02
        theta_int ← clamp(theta_int + theta * 0.02, -0.1, 0.1)
    ELSE
        theta_int ← 0.0                # reset when tilt is large
    END IF
    int_effort  ← -0.5 * theta_int      # tiny integral gain

    # ---- 5.  Cart centering bias -------------------------------
    centre_bias ← -0.12 * x

    # ---- 6.  Cart velocity damping -----------------------------
    vel_damp    ← -0.04 * x_dot

    # ---- 7.  Combine all terms --------------------------------
    raw_force   ← pole_effort + int_effort + centre_bias + vel_damp

    # ---- 8.  Smooth saturation (tanh) -------------------------
    force       ← 3.0 * tanh(0.45 * raw_force)

    # ---- 9.  Hard clipping (safety) ---------------------------
    force       ← clamp(force, -3.0, 3.0)
END IF
```

