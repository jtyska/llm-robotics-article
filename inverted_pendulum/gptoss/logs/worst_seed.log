import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    abs_theta = abs(theta)
    if abs_theta <= 0.04:
        tilt_norm = 0.0
    elif abs_theta >= 0.20:
        tilt_norm = 1.0
    else:
        tilt_norm = (abs_theta - 0.04) / (0.20 - 0.04)

    gain = tilt_norm * tilt_norm

    Kp_theta = 5.0 + (25.0 - 5.0) * gain
    Kd_theta = 2.5 + (12.0 - 2.5) * gain
    Kp_cart = 0.04 + (0.12 - 0.04) * gain
    Kd_cart = 0.05 + (0.15 - 0.05) * gain

    pole_pd = -(Kp_theta * theta + Kd_theta * theta_dot)
    cart_pd = -(Kp_cart * x + Kd_cart * x_dot)

    if abs_theta < 0.12:
        centre_bias = -0.10 * x
    else:
        centre_bias = 0.0

    gravity_ff = 0.60 * 9.81 * math.sin(theta)

    raw_force = pole_pd + cart_pd + centre_bias + gravity_ff
    force_raw = 3.0 * math.tanh(0.65 * raw_force)

    if force_raw > 3.0:
        force = 3.0
    elif force_raw < -3.0:
        force = -3.0
    else:
        force = force_raw

    return force

    # fallback (should never be reached)
    return random.uniform(-3, 3)
