def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # Check for non-finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # Large angle case
    if abs(theta) >= 0.20:
        sign = 1.0 if theta > 0 else -1.0 if theta < 0 else 0.0
        force = -sign * 3.0
        return max(-3.0, min(3.0, force))

    # Blended controller
    raw_cart = -1.0 * x + -1.0 * x_dot
    raw_angle = -12.0 * theta + -1.5 * theta_dot

    if abs(theta) <= 0.02:
        alpha = 0.0
    elif abs(theta) >= 0.18:
        alpha = 1.0
    else:
        t = (abs(theta) - 0.02) / (0.18 - 0.02)
        alpha = t ** 1.2

    blended = (1 - alpha) * raw_cart + alpha * raw_angle
    scale = 1.0 + alpha
    force = scale * blended
    force = max(-3.0, min(3.0, force))
    return force

    # Default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
