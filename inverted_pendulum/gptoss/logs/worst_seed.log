import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    force = None
    if (not math.isfinite(cart_position) or not math.isfinite(cart_velocity) or
        not math.isfinite(pole_angle) or not math.isfinite(pole_angular_velocity)):
        force = 0.0
    else:
        theta = pole_angle
        theta_dot = pole_angular_velocity
        x = cart_position
        x_dot = cart_velocity

        tilt_raw = (abs(theta) - 0.05) / (0.18 - 0.05)
        tilt_raw = max(0.0, min(tilt_raw, 1.0))

        Kp_theta = 8.0 + 70.0 * tilt_raw
        Kd_theta = 3.0 + 30.0 * tilt_raw
        Kp_cart  = 0.1 + 0.8  * tilt_raw
        Kd_cart  = 0.02 + 0.15 * tilt_raw
        ff_gain  = 0.5 + 2.5 * tilt_raw

        force_raw = (-Kp_theta * theta
                     - Kd_theta * theta_dot
                     - Kp_cart  * x
                     - Kd_cart  * x_dot
                     + ff_gain  * math.copysign(1.0, theta))

        force = max(-3.0, min(force_raw, 3.0))

    if force is None:
        return random.uniform(-3.0, 3.0)
    return force
