import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Helper clamp
    def clamp(val, lo, hi):
        return max(lo, min(hi, val))
    
    # Check finiteness
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0

    theta = pole_angle
    theta_dot = pole_angular_velocity
    x = cart_position
    x_dot = cart_velocity

    if abs(theta) >= 0.19:
        sign_theta = math.copysign(1.0, theta)
        force = clamp(-sign_theta * 3.0, -3.0, 3.0)
        return force

    if abs(theta) <= 0.05:
        Kx = 0.5
        Kx_dot = 0.8
        raw = -(Kx * x + Kx_dot * x_dot)
        force = clamp(raw, -3.0, 3.0)
        return force

    # Intermediate angles
    K_theta = 30.0
    K_theta_dot = 8.0
    a = (abs(theta) - 0.02) / (0.18 - 0.02)
    s = 1.0 + a * a
    if s > 2.0:
        s = 2.0
    u_angle = -(K_theta * theta + K_theta_dot * theta_dot)
    raw_force = s * u_angle
    force = clamp(raw_force, -3.0, 3.0)
    return force

    # Default random action (should not be reached)
    return random.uniform(-3.0, 3.0)
