import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    def clamp(v, lo, hi):
        return max(lo, min(hi, v))
    def sign(v):
        return 1 if v > 0 else -1 if v < 0 else 0
    def deadzone(v, dz):
        return 0.0 if abs(v) < dz else v
    def smoothstep(t):
        return t * t * (3 - 2 * t)

    Kθ = 16.0
    Kθdot = 10.0
    Kx = 0.9
    Kxdot = 0.7
    MAX_FORCE = 3.0
    MIN_FORCE = -3.0
    DEAD_ZONE = 0.02
    THETA_SMALL = 0.04
    THETA_MAX = 0.18

    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    else:
        x = cart_position
        theta = pole_angle
        x_dot = cart_velocity
        theta_dot = pole_angular_velocity

        if abs(theta) >= THETA_MAX:
            force = clamp(-sign(theta) * MAX_FORCE, MIN_FORCE, MAX_FORCE)
        elif abs(theta) <= THETA_SMALL:
            raw = -(Kx * x + Kxdot * x_dot)
            raw = deadzone(raw, DEAD_ZONE)
            force = clamp(raw, MIN_FORCE, MAX_FORCE)
        else:
            u_angle = -(Kθ * theta + Kθdot * theta_dot)
            t = (abs(theta) - THETA_SMALL) / (THETA_MAX - THETA_SMALL)
            t = clamp(t, 0.0, 1.0)
            scale = 1.0 + 1.2 * smoothstep(t)
            raw = scale * u_angle
            raw = deadzone(raw, DEAD_ZONE)
            force = clamp(raw, MIN_FORCE, MAX_FORCE)

    if 'force' in locals():
        return force
    else:
        return random.uniform(-3.0, 3.0)
