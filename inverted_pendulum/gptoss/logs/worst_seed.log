    # 4. Cart‑centering bias (fades with tilt)
    # -------------------------------------------------
    k_c ← 0.07
    centre_bias ← -k_c * (1.0 - tilt) * x

    # -------------------------------------------------
    # 5. Cart‑velocity damping (fades with tilt)
    # -------------------------------------------------
    k_v ← 0.03
    cart_vel_damp ← -k_v * (1.0 - tilt) * x_dot

    # -------------------------------------------------
    # 6. Combine contributions
    # -------------------------------------------------
    raw_force ← pole_effort + centre_bias + cart_vel_damp

    # -------------------------------------------------
    # 7. Smooth saturation (tanh) and hard clipping
    # -------------------------------------------------
    # 0.30 is the “soft‑gain” that maps raw_force → [-3,3] before clipping
    force ← 3.0 * tanh( raw_force * 0.30 )

    IF force >  3.0 THEN force ←  3.0
    IF force < -3.0 THEN force ← -3.0
END IF
```

