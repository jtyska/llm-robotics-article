def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # Check for non‑finite values
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0
    # Normalise tilt
    tilt_norm = (abs(pole_angle) - 0.05) / (0.20 - 0.05)
    if tilt_norm < 0.0:
        tilt_norm = 0.0
    elif tilt_norm > 1.0:
        tilt_norm = 1.0
    # Pole PD gains (scheduled)
    Kp_pole = 2.0 + (7.0 - 2.0) * tilt_norm
    Kd_pole = 0.8 + (4.0 - 0.8) * tilt_norm
    # Cart PD gains (fixed)
    Kp_cart = 0.30
    Kd_cart = 0.45
    # Control terms
    pole_pd = -(Kp_pole * math.sin(pole_angle) + Kd_pole * pole_angular_velocity)
    cart_pd = -(Kp_cart * cart_position + Kd_cart * cart_velocity)
    gravity_ff = 9.81 * math.sin(pole_angle)
    u_raw = pole_pd + cart_pd + gravity_ff
    # Soft saturation
    force_raw = 3.0 * math.tanh(u_raw / 3.0)
    # Dead‑zone
    if abs(force_raw) < 0.02:
        force = 0.0
    else:
        force = force_raw
    return force
    # Default random action (fallback)
    return random.uniform(-3.0, 3.0)
