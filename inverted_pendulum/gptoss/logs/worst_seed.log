import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    def clamp(x, lo, hi):
        return max(lo, min(hi, x))
    # Check for non‑finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    # Small angle regime
    if abs(pole_angle) < 0.02:
        action = clamp(-(0.8 * cart_position + 0.4 * cart_velocity), -3.0, 3.0)
        return action
    # General case
    u_lin = -(15.0 * pole_angle + 10.0 * pole_angular_velocity +
              0.5 * cart_position + 0.2 * cart_velocity)
    if abs(pole_angle) > 0.10:
        u_lin -= 0.1 * cart_velocity
    scale = 1.0 + 4.0 * (abs(pole_angle) - 0.02) / (0.20 - 0.02)
    if scale > 5.0:
        scale = 5.0
    if scale < 1.0:
        scale = 1.0
    u_raw = u_lin * scale
    action = clamp(u_raw, -3.0, 3.0)
    return action
    # Default random action (should not be reached)
    return random.uniform(-3.0, 3.0)
