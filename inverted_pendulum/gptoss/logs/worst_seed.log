    else:
        F = (-0.8 * cart_position) + (-12.0 * pole_angle) + (-0.5 * cart_velocity) + (-2.5 * pole_angular_velocity)
        if F > 3.0:
            F = 3.0
        elif F < -3.0:
            F = -3.0
        action = F
    if action is None:
        return random.uniform(-3, 3)
    return action
