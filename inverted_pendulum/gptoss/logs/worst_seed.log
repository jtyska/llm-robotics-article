import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # constants (tune as needed)
    Kx = 1.0
    Kx_dot = 1.0
    Ktheta = 10.0
    Ktheta_dot = 1.0
    theta_low = 0.05
    theta_high = 0.20
    max_force = 3.0
    min_force = -3.0

    # Rule 1: non‑finite check
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Rule 2: large angle override
    if abs(pole_angle) >= 0.20:
        sign = math.copysign(1.0, pole_angle) if pole_angle != 0 else 0.0
        force = -sign * max_force
        return max(min(force, max_force), min_force)

    # Rule 3: linear‑feedback controller
    u_base = -(Kx * cart_position +
               Kx_dot * cart_velocity +
               Ktheta * pole_angle +
               Ktheta_dot * pole_angular_velocity)

    if abs(pole_angle) <= theta_low:
        raw = u_base
    else:
        # gain‑schedule placeholder (currently just using u_base)
        t = (abs(pole_angle) - theta_low) / (theta_high - theta_low)
        # Example of scaling could be added here; using u_base unchanged
        raw = u_base

    force = max(min(raw, max_force), min_force)
    return force


