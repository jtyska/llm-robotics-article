def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    action = None
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        action = 0.0
    else:
        u_lin = -(6.0 * pole_angle + 16.0 * pole_angular_velocity + 0.4 * cart_position + 0.2 * cart_velocity)
        if abs(pole_angle) > 0.12 or abs(pole_angular_velocity) > 1.5:
            boost = -8.0 * (1 if pole_angle > 0 else -1 if pole_angle < 0 else 0)
        else:
            boost = 0.0
        u_raw = u_lin + boost
        u_soft = 3.0 * math.tanh(u_raw / 3.0)
        if u_soft > 3.0:
            action = 3.0
        elif u_soft < -3.0:
            action = -3.0
        else:
            action = u_soft
    if action is None:
        return random.uniform(-3, 3)
    return action
