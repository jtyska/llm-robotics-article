import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    theta = pole_angle
    theta_dot = pole_angular_velocity
    x = cart_position
    x_dot = cart_velocity

    theta_abs = abs(theta)

    if theta_abs <= 0.04:
        tilt_norm = 0.0
    elif theta_abs >= 0.18:
        tilt_norm = 1.0
    else:
        tilt_norm = (theta_abs - 0.04) / (0.18 - 0.04)

    Kp_theta = 30.0 + 170.0 * (tilt_norm ** 2)
    Kd_theta = 3.0 + 45.0 * (tilt_norm ** 2)
    Kp_x = 0.25 + 0.85 * tilt_norm
    Kd_x = 0.12 + 0.45 * tilt_norm

    ff_grav = 0.48 * math.sin(theta)

    u = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * x + Kd_x * x_dot + ff_grav) + 0.02

    Fmax_base = 0.4 + 2.6 * tilt_norm
    Fmax = 3.0 if Fmax_base > 3.0 else Fmax_base

    force_raw = math.tanh(u / Fmax) * Fmax

    if force_raw > 3.0:
        force = 3.0
    elif force_raw < -3.0:
        force = -3.0
    else:
        force = force_raw

    return force

    # fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
