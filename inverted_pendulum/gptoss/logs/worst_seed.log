import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    force = None

    # Rule 1
    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        force = 0.0
    # Rule 2
    elif abs(theta) > 0.20:
        force = 0.0
    else:
        # Rules 3‑5: compute tilt
        if abs(theta) <= 0.05:
            tilt = 0.0
        elif abs(theta) >= 0.18:
            tilt = 1.0
        else:
            tilt_raw = (abs(theta) - 0.05) / (0.18 - 0.05)
            tilt = max(0.0, min(1.0, tilt_raw))

        # Rule 6
        Kp_pole = 4.0 + 28.0 * (tilt ** 2)
        Kd_pole = 1.0 + 6.0 * (tilt ** 2)

        # Rule 7
        Kp_cart = 0.08 + 0.32 * (tilt ** 2)
        Kd_cart = 0.02 + 0.08 * (tilt ** 2)

        # Rule 8
        ff_gain = 0.6 * tilt

        # Rule 9‑11
        pole_pd = -Kp_pole * theta - Kd_pole * theta_dot
        cart_pd = -Kp_cart * x - Kd_cart * x_dot
        ff_term = -ff_gain * theta_dot

        # Rule 12
        raw_force = pole_pd + cart_pd + ff_term

        # Rule 13
        if raw_force > 3.0:
            force = 3.0
        elif raw_force < -3.0:
            force = -3.0
        else:
            force = raw_force

    if force is None:
        return random.uniform(-3.0, 3.0)
    return force
