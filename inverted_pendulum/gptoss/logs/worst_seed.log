    IF tilt > 1.0 THEN tilt ← 1.0
    IF tilt < 0.0 THEN tilt ← 0.0

    # -------------------------------------------------
    # 2. Linear gain‑scheduling for PD on the pole
    # -------------------------------------------------
    Kp_min ← 8.0
    Kp_max ← 12.0
    Kd_min ← 1.5
