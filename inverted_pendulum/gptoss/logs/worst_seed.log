import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non‑finite inputs
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Normalise tilt (0 = vertical, 1 = failure bound)
    tilt_raw = (abs(pole_angle) - 0.05) / (0.20 - 0.05)
    if tilt_raw < 0.0:
        tilt_raw = 0.0
    if tilt_raw > 1.0:
        tilt_raw = 1.0

    # Quadratic gain‑shaping
    if tilt_raw <= 0.5:
        g_low = tilt_raw * tilt_raw
        g_high = 0.0
    else:
        g_low = 0.25
        g_high = (tilt_raw - 0.5) * (tilt_raw - 0.5)

    # Pole PID gains (no integral term)
    Kp_theta = 8.0 + 32.0 * g_low + 80.0 * g_high
    Kd_theta = 1.5 + 8.0 * g_low + 20.0 * g_high

    # Pole stabilising effort (PD)
    pole_effort = -Kp_theta * pole_angle - Kd_theta * pole_angular_velocity

    # Cart‑centering (active for small tilt)
    centre_bias = -0.07 * (1.0 - tilt_raw) * cart_position

    # Cart‑velocity damping (active for small tilt)
    cart_vel_damp = -0.03 * (1.0 - tilt_raw) * cart_velocity

    # Combine contributions
    raw_force = pole_effort + centre_bias + cart_vel_damp

    # Smooth saturation and hard clip
    force = 3.0 * math.tanh(raw_force * 0.30)
    if force > 3.0:
        force = 3.0
    if force < -3.0:
        force = -3.0

    return force

    # Default random action (should never be reached)
    return random.uniform(-3, 3)
