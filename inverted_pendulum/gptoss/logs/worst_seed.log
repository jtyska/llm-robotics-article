import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non‑finite inputs
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity

    abs_theta = abs(theta)

    if abs_theta <= 0.05:
        tilt_norm = 0.0
    elif abs_theta >= 0.18:
        tilt_norm = 1.0
    else:
        tilt_norm = (abs_theta - 0.05) / (0.18 - 0.05)

    Kp_theta = 8.0 + (80.0 - 8.0) * tilt_norm
    Kd_theta = 1.0 + (20.0 - 1.0) * tilt_norm
    Kp_x     = 0.10 + (0.40 - 0.10) * tilt_norm
    Kd_x     = 0.05 + (0.25 - 0.05) * tilt_norm

    ff_theta_dot = -0.7 * theta_dot

    u = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * x + Kd_x * x_dot + ff_theta_dot) + 0.02

    max_force = 0.5 + 2.5 * tilt_norm
    force_raw = math.tanh(u / max_force) * max_force

    if force_raw > 3.0:
        action = 3.0
    elif force_raw < -3.0:
        action = -3.0
    else:
        action = force_raw

    return action

    # Default fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
