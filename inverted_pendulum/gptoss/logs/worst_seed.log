import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non‑finite values
    if not all(math.isfinite(v) for v in (cart_position, pole_angle, cart_velocity, pole_angular_velocity)):
        return 0.0

    theta = pole_angle
    x = cart_position
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # Large angle correction
    if abs(theta) >= 0.19:
        return -math.copysign(3.0, theta)

    # Near‑upright small‑angle control
    if abs(theta) <= 0.02:
        raw = -(0.8 * x + 0.1 * x_dot)
        return max(-3.0, min(3.0, raw))

    # Intermediate angle control
    u_angle = -(18.0 * theta + 2.5 * theta_dot)
    scale = 1.0 + (abs(theta) - 0.02) / (0.19 - 0.02)
    if scale > 2.0:
        scale = 2.0
    if scale < 1.0:
        scale = 1.0
    raw = scale * u_angle
    force = 3.0 * math.tanh(raw / 3.0)
    return force

    # Fallback random action (should never be reached)
    return random.uniform(-3.0, 3.0)
