def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    action = None
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        action = 0.0
    else:
        a = abs(pole_angle)
        b = abs(cart_position)
        s = (a - 0.04) / (0.20 - 0.04)
        if s < 0:
            s = 0.0
        if s > 1:
            s = 1.0
        k_theta = 2.0 + (12.0 - 2.0) * s
        k_theta_d = 0.5 + (4.0 - 0.5) * s
        k_x = 0.3 + (0.8 - 0.3) * s
        k_x_d = 0.1 + (0.3 - 0.1) * s
        if b > 0.25:
            extra = 0.5 * (1 if cart_position > 0 else -1 if cart_position < 0 else 0) * (b - 0.25)
        else:
            extra = 0.0
        raw = -(k_theta * pole_angle + k_theta_d * pole_angular_velocity + k_x * cart_position + k_x_d * cart_velocity) - extra
        if raw > 3.0:
            action = 3.0
        elif raw < -3.0:
            action = -3.0
        else:
            action = raw
    if action is None:
        return random.uniform(-3, 3)
    return action
