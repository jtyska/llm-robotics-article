    force ← 0.0
ELSE
    /* tilt normalisation */
    tilt_abs      ← abs(theta)
    tilt_norm_raw ← (tilt_abs - 0.05) / (0.18 - 0.05)
    IF tilt_norm_raw < 0.0 THEN
        tilt_norm ← 0.0
    ELSE IF tilt_norm_raw > 1.0 THEN
        tilt_norm ← 1.0
    ELSE
        tilt_norm ← tilt_norm_raw
    END IF

    /* gain scheduling */
    Kp_theta_safe ← 12.0   ; Kd_theta_safe ← 8.0
    Kp_x_safe     ← 0.5    ; Kd_x_safe     ← 0.5
    Kp_theta_aggr ← 30.0   ; Kd_theta_aggr ← 20.0
    Kp_x_aggr     ← 1.5    ; Kd_x_aggr     ← 1.2

    Kp_theta ← (1.0 - tilt_norm) * Kp_theta_safe + tilt_norm * Kp_theta_aggr
    Kd_theta ← (1.0 - tilt_norm) * Kd_theta_safe + tilt_norm * Kd_theta_aggr
    Kp_x     ← (1.0 - tilt_norm) * Kp_x_safe     + tilt_norm * Kp_x_aggr
    Kd_x     ← (1.0 - tilt_norm) * Kd_x_safe     + tilt_norm * Kd_x_aggr

    /* emergency boost */
    IF tilt_abs > 0.18 THEN
        boost_factor ← (tilt_abs - 0.18) / (0.20 - 0.18)
        boost       ← 8.0 * boost_factor * sign(theta)
    ELSE
        boost ← 0.0
    END IF

    /* raw control law */
    u_raw ← -( Kp_theta * theta
               + Kd_theta * theta_dot
               + Kp_x     * x
               + Kd_x     * x_dot ) + boost

    /* gravity compensation */
    u_raw ← u_raw + 9.81 * sin(theta)

    /* map to admissible force */
    force_unclipped ← 3.0 * tanh( u_raw / 2.0 )
    IF force_unclipped > 3.0 THEN
        force ← 3.0
    ELSE IF force_unclipped < -3.0 THEN
        force ← -3.0
    ELSE
        force ← force_unclipped
    END IF
END IF 
