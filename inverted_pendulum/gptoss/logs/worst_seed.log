import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    def clamp(val, lo, hi):
        return max(lo, min(hi, val))

    def sign(v):
        return 1 if v > 0 else -1 if v < 0 else 0

    if not (math.isfinite(x) and math.isfinite(theta) and math.isfinite(x_dot) and math.isfinite(theta_dot)):
        return 0.0

    if abs(theta) >= 0.18:
        return clamp(-sign(theta) * 3.0, -3.0, 3.0)

    if abs(theta) <= 0.015:
        return clamp(-(1.2 * x + 1.0 * x_dot), -3.0, 3.0)

    u_angle = -(70.0 * theta + 20.0 * theta_dot)
    scale = 1.0 + (2.5 - 1.0) * (abs(theta) - 0.015) / (0.18 - 0.015)
    scale = clamp(scale, 1.0, 2.5)
    action = clamp(scale * u_angle, -3.0, 3.0)
    return action

    # fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
