import random
import math

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # helper functions
    def is_finite(v):
        return math.isfinite(v)
    
    def clamp(val, lo, hi):
        return max(lo, min(hi, val))
    
    def sign(v):
        if v > 0:
            return 1.0
        if v < 0:
            return -1.0
        return 0.0

    force = None

    # Rule 1: non‑finite inputs
    if (not is_finite(cart_position) or not is_finite(cart_velocity) or
        not is_finite(pole_angle) or not is_finite(pole_angular_velocity)):
        force = 0.0

    # Rule 2: large angle
    elif abs(pole_angle) >= 0.18:
        force = clamp(-sign(pole_angle) * 3.0, -3.0, 3.0)

    # Rule 3: proportional control
    else:
        alpha = (abs(pole_angle) - 0.02) / (0.18 - 0.02)
        alpha = clamp(alpha, 0.0, 1.0)

        K_theta = 20.0 + alpha * (70.0 - 20.0)
        K_theta_dot = 5.0 + alpha * (13.0 - 5.0)

        u_angle = -(K_theta * pole_angle + K_theta_dot * pole_angular_velocity)

        cart_factor = 1.0 - alpha
        u_cart = -(0.5 * cart_position + 0.8 * cart_velocity) * cart_factor

        raw_force = u_angle + u_cart
        force = clamp(raw_force, -3.0, 3.0)

    if force is None:
        return random.uniform(-3.0, 3.0)
    return force
