def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(theta) and math.isfinite(x_dot) and math.isfinite(theta_dot)):
        return 0.0

    abs_theta = abs(theta)
    if abs_theta <= 0.04:
        tilt_norm = 0.0
    elif abs_theta >= 0.20:
        tilt_norm = 1.0
    else:
        tilt_norm = (abs_theta - 0.04) / (0.20 - 0.04)

    Kp_theta = 5.0 + 30.0 * tilt_norm
    Kd_theta = 3.0 + 12.0 * tilt_norm
    Kp_cart = 0.01 + 0.07 * tilt_norm
    Kd_cart = 0.02 + 0.08 * tilt_norm
    Ki_theta = 0.2 * tilt_norm

    gravity_ff = 0.95 * 9.81 * math.sin(theta)

    pole_pd = -(Kp_theta * math.sin(theta) + Kd_theta * theta_dot)
    pole_i = -(Ki_theta * theta)
    cart_pd = -(Kp_cart * x + Kd_cart * x_dot)

    centre_bias = -0.10 * x * (1.0 + 2.0 * abs(x))

    u_raw = pole_pd + pole_i + gravity_ff + cart_pd + centre_bias

    alpha = 0.8 + 0.8 * tilt_norm
    force_tanh = 3.0 * math.tanh(alpha * u_raw)

    if force_tanh > 3.0:
        force = 3.0
    elif force_tanh < -3.0:
        force = -3.0
    else:
        force = force_tanh

    return force
    return random.uniform(-3, 3)
