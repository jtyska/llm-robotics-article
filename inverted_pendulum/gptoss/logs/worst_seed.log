import math, random

_theta_int = 0.0

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    global _theta_int
    # Unpack for readability
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # Check for non‑finite values
    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    # Compute tilt_raw with clamping
    tilt_raw = (abs(theta) - 0.05) / 0.15
    if tilt_raw < 0:
        tilt_raw = 0.0
    elif tilt_raw > 1:
        tilt_raw = 1.0

    g = tilt_raw * tilt_raw

    # Pole PID terms
    Kp_theta = 12.0 + 30.0 * g
    Kd_theta = 5.0 + 15.0 * g
    pole_effort = -Kp_theta * theta - Kd_theta * theta_dot

    # Cart PID terms (active only for small tilt)
    cart_active = 1 if tilt_raw < 0.2 else 0
    Kp_cart = 0.20 * (1.0 - g) * cart_active
    Kd_cart = 0.04 * (1.0 - g) * cart_active
    cart_effort = -Kp_cart * x - Kd_cart * x_dot

    # Center bias term
    center_bias = -0.10 * tilt_raw * x

