import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non-finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Compute tilt factor
    tilt_raw = (abs(pole_angle) - 0.05) / (0.18 - 0.05)
    tilt_raw = max(0.0, min(tilt_raw, 1.0))
    tilt = tilt_raw * tilt_raw

    # Gains
    Kp = 30.0 + 30.0 * tilt
    Kd = 2.0 + 6.0 * tilt

    # Feed‑forward gravity compensation
    ff_grav = 0.15 * math.sin(pole_angle)

    # Cart centering term
    cart_center = -(0.003 * cart_position + 0.001 * cart_velocity)

    # Control law
    u = -(Kp * pole_angle + Kd * pole_angular_velocity + ff_grav) + cart_center
    force = max(-3.0, min(u, 3.0))
    return force

    # Default random action (fallback, should never be reached)
    return random.uniform(-3.0, 3.0)
