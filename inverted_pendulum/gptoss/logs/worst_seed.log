import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    theta = pole_angle
    theta_dot = pole_angular_velocity
    theta_abs = abs(theta)
    if theta_abs <= 0.05:
        tilt_raw = 0.0
    elif theta_abs >= 0.18:
        tilt_raw = 1.0
    else:
        tilt_raw = (theta_abs - 0.05) / (0.18 - 0.05)
    tau = 1.0 / (1.0 + math.exp(-12.0 * (tilt_raw - 0.5)))
    Kp = (1 - tau) * 30.0 + tau * 120.0
    Kd = (1 - tau) * 5.0 + tau * 20.0
    u_raw = -(Kp * theta + Kd * theta_dot)
    force = 3.0 * math.tanh(u_raw / 2.5)
    if force > 3.0:
        force = 3.0
    if force < -3.0:
        force = -3.0
    return force if force is not None else random.uniform(-3, 3)
