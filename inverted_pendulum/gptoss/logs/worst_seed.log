import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # initialize persistent integral term
    if not hasattr(get_action, "integ_x"):
        get_action.integ_x = 0.0

    # check finiteness
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0

    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity

    # tilt normalization
    if abs(theta) <= 0.02:
        tilt_norm = 0.0
    elif abs(theta) >= 0.20:
        tilt_norm = 1.0
    else:
        tilt_norm = (abs(theta) - 0.02) / (0.20 - 0.02)

    # logistic weighting
    tau = 1.0 / (1.0 + math.exp(-12.0 * (tilt_norm - 0.5)))

    # gains
    Kp_theta = (1 - tau) * 70.0 + tau * 150.0
    Kd_theta = (1 - tau) * 10.0 + tau * 28.0
    Kp_x = 0.8
    Kd_x = 0.5
    Ki_x = 0.25

    # update integral of position
    get_action.integ_x = 0.995 * get_action.integ_x + 0.005 * x

    # control law
    u_raw = -(Kp_theta * theta + Kd_theta * theta_dot +
              Kp_x * x + Kd_x * x_dot + Ki_x * get_action.integ_x)

    force_soft = 3.0 * math.tanh(u_raw / 2.8)

    # clamp to action limits
    if force_soft > 3.0:
        force = 3.0
    elif force_soft < -3.0:
        force = -3.0
    else:
        force = force_soft

    # fallback (should never be reached)
    if force is None:
        return random.uniform(-3.0, 3.0)

    return force
