def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    if not hasattr(get_action, "cart_int"):
        get_action.cart_int = 0.0
    force = None
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    else:
        abs_theta = abs(pole_angle)
        if abs_theta <= 0.05:
            tilt_norm = 0.0
        elif abs_theta >= 0.20:
            tilt_norm = 1.0
        else:
            tilt_norm = (abs_theta - 0.05) / (0.20 - 0.05)
        Kp_pole = 2.0 + 22.0 * tilt_norm
        Kd_pole = 0.8 + 11.0 * tilt_norm
        Kp_cart = 0.30 + 3.0 * tilt_norm + 5.0 * tilt_norm * tilt_norm
        Kd_cart = 0.45 + 2.5 * tilt_norm + 4.0 * tilt_norm * tilt_norm
        get_action.cart_int += 0.02 * cart_position
        if get_action.cart_int > 1.0:
            get_action.cart_int = 1.0
        elif get_action.cart_int < -1.0:
            get_action.cart_int = -1.0
        pole_pd = -(Kp_pole * pole_angle + Kd_pole * pole_angular_velocity)
        cart_pd = -(Kp_cart * cart_position + Kd_cart * cart_velocity + get_action.cart_int)
        gravity_ff = 9.81 * math.sin(pole_angle)
        u_raw = pole_pd + cart_pd + gravity_ff
        u_soft = 3.0 * math.tanh(u_raw / 3.0)
        if abs(u_soft) < 0.02:
            force = 0.0
        else:
            force = u_soft
    if force is None:
        return random.uniform(-3, 3)
    return force
