import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    abs_theta = abs(theta)
    tilt_norm = (abs_theta - 0.05) / (0.18 - 0.05)
    tilt_norm = max(0.0, min(tilt_norm, 1.0))

    Kp_theta = 8.0 + 22.0 * tilt_norm
    Kd_theta = 2.0 + 8.0 * tilt_norm
    Kp_x = 0.3 + 1.7 * tilt_norm
    Kd_x = 0.4 + 1.6 * tilt_norm

    vel_boost = abs(theta_dot) / 2.0
    vel_boost = max(0.0, min(vel_boost, 0.3))
    Kd_theta *= (1.0 + vel_boost)

    u_raw = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * x + Kd_x * x_dot) + 9.81 * math.sin(theta)
    force_raw = 3.0 * math.tanh(u_raw / 3.0)

    if abs(force_raw) < 0.02:
        force = 0.0
    else:
        force = force_raw

    return force

    # Default random action (should not be reached)
    return random.uniform(-3.0, 3.0)
