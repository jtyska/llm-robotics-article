def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # helper functions
    def clamp(v, lo, hi):
        return max(lo, min(hi, v))
    def sign(v):
        return 1.0 if v > 0 else (-1.0 if v < 0 else 0.0)
    # initialize persistent tilt integral
    if not hasattr(get_action, "tilt_int"):
        get_action.tilt_int = 0.0
    # finite check
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    # compute tilt
    tilt_raw = (abs(pole_angle) - 0.02) / (0.20 - 0.02)
    tilt = clamp(tilt_raw, 0.0, 1.0)
    # gains
    pole_Kp = 8.0 + 4.0 * tilt
    pole_Kd = 1.5 + 1.0 * tilt
    cart_Kp = 0.5 + 0.3 * tilt
    cart_Kd = 0.1 + 0.1 * tilt
    # PD terms
    pole_pd = -pole_Kp * pole_angle - pole_Kd * pole_angular_velocity
    cart_pd = -cart_Kp * cart_position - cart_Kd * cart_velocity
    # assist term
    assist = -1.0 * sign(pole_angle) * tilt
    # integral update
    if tilt > 0.0:
        get_action.tilt_int = get_action.tilt_int * 0.995 + 0.02 * tilt
    else:
        get_action.tilt_int = get_action.tilt_int * 0.995
    get_action.tilt_int = clamp(get_action.tilt_int, 0.0, 1.0)
    integral = -0.8 * get_action.tilt_int
    # total force
    raw_force = pole_pd + cart_pd + assist + integral
    force = clamp(raw_force, -3.0, 3.0)
    return force
    # default random action (fallback)
    return random.uniform(-3.0, 3.0)
