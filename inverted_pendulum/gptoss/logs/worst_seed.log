def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    if not hasattr(get_action, "theta_int"):
        get_action.theta_int = 0.0
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity
    force = None
    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        force = 0.0
    else:
        # Normalised tilt
        tilt_raw = (abs(theta) - 0.05) / (0.18 - 0.05)
        if tilt_raw < 0.0:
            tilt_raw = 0.0
        if tilt_raw > 1.0:
            tilt_raw = 1.0
        tilt = tilt_raw ** 3
        # Gain scheduling
        Kp = 30.0 + 150.0 * tilt
        Kd = 2.0 + 20.0 * tilt
        Kx = 0.5 + 2.5 * tilt
        Kv = 0.1 + 0.5 * tilt
        Ki = 0.5 * tilt
        # Integral on angle (stateful)
        get_action.theta_int += theta * 0.02
        if get_action.theta_int > 0.5:
            get_action.theta_int = 0.5
        if get_action.theta_int < -0.5:
            get_action.theta_int = -0.5
        theta_int = get_action.theta_int
        # Gravity feed‑forward
        ff_grav = 0.20 * math.sin(theta)
        if abs(theta) > 0.1:
            ff_grav += 0.05 * math.sin(theta) * abs(theta)
        # Cart‑centering bias
        cart_center = -(Kx * x + Kv * x_dot)
        # Raw control law
        u_raw = -(Kp * theta + Kd * theta_dot + Ki * theta_int + ff_grav) + cart_center
        # Soft saturation
        u_soft = 3.0 * math.tanh(u_raw / 3.0)
        # Final clipping
        if u_soft > 3.0:
            force = 3.0
        elif u_soft < -3.0:
            force = -3.0
        else:
            force = u_soft
    if force is None:
        return random.uniform(-3.0, 3.0)
    return force
