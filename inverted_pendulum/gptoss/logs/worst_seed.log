import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    abs_theta = abs(theta)

    cart_pd = -(1.0 * x + 0.5 * x_dot)

    if abs_theta <= 0.02:
        k_p = 8.0
        k_d = 2.0
    elif abs_theta >= 0.18:
        k_p = 20.0
        k_d = 6.0
    else:
        t = (abs_theta - 0.02) / (0.18 - 0.02)
        k_p = 8.0 + (20.0 - 8.0) * (t * t)
        k_d = 2.0 + (6.0 - 2.0) * (t * t)

    pole_pd = -(k_p * theta + k_d * theta_dot)

    raw = cart_pd + pole_pd

    if abs_theta >= 0.18:
        raw = -3.0 * (1 if theta > 0 else -1 if theta < 0 else 0) - 0.5 * theta_dot

    if raw > 3.0:
        force = 3.0
    elif raw < -3.0:
        force = -3.0
    else:
        force = raw

    return force if force is not None else random.uniform(-3.0, 3.0)
