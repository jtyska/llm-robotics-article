def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # check for non‑finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    # large angle correction
    if abs(pole_angle) >= 0.18:
        sign = 1.0 if pole_angle > 0 else -1.0 if pole_angle < 0 else 0.0
        force = -sign * 3.0
        force = max(-3.0, min(3.0, force))
        return force
    # PD control for angle
    u_angle = -(15.0 * pole_angle + 3.0 * pole_angular_velocity)
    # PD control for cart with bias
    u_cart = -(0.8 * cart_position + 0.3 * cart_velocity) - 0.2 * cart_position
    # weight based on pole angle
    w = (abs(pole_angle) - 0.02) / (0.18 - 0.02)
    if w < 0.0:
        w = 0.0
    elif w > 1.0:
        w = 1.0
    # scale angle gain
    scale = 1.0 + w
    if scale < 1.0:
        scale = 1.0
    elif scale > 2.0:
        scale = 2.0
    # blend weights
    cart_weight = (1.0 - w) * 0.3
    angle_weight = 1.0 - cart_weight
    # combined force before saturation
    raw_force = angle_weight * (scale * u_angle) + cart_weight * u_cart
    # saturation
    force = max(-3.0, min(3.0, raw_force))
    # dead‑zone
    if abs(force) < 0.01:
        force = 0.0
    return force
    # fallback random action (should never be reached)
    return random.uniform(-3.0, 3.0)
