import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # NaN check
    if (x != x) or (x_dot != x_dot) or (theta != theta) or (theta_dot != theta_dot):
        return 0.0

    # Small angle case
    if abs(theta) < 0.02:
        force = -0.8 * x + -0.4 * x_dot
        return max(min(force, 3.0), -3.0)

    # General case
    scale = 1.0 + (abs(theta) - 0.02) / 0.18
    if scale > 2.0:
        scale = 2.0
    u_raw = -13.0 * theta + -8.5 * theta_dot + -0.6 * x + -0.2 * x_dot
    u_scaled = scale * u_raw
    u_soft = 3.0 * math.tanh(u_scaled / 3.0)
    force = max(min(u_soft, 3.0), -3.0)
    return force

    # Fallback random action (should never be reached)
    return random.uniform(-3.0, 3.0)
