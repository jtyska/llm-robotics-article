import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    def finite(v):
        return math.isfinite(v)
    def sign(v):
        return 1 if v > 0 else (-1 if v < 0 else 0)
    def clip(v, a, b):
        return max(a, min(b, v))

    force = None

    if not (finite(cart_position) and finite(cart_velocity) and finite(pole_angle) and finite(pole_angular_velocity)):
        force = 0
    elif abs(pole_angle) >= 0.16:
        force = -3 * sign(pole_angle)
    elif abs(pole_angle) <= 0.02:
        raw = -(1.0 * cart_position + 0.7 * cart_velocity)
        force = clip(raw, -3, 3)
    else:
        norm = (abs(pole_angle) - 0.02) / (0.16 - 0.02)  # 0 … 1
        k_theta  = 5   + norm * (35  - 5)   # 5 → 35
        k_thetad = 2   + norm * (35  - 2)   # 2 → 35
        k_x      = 0.8 + norm * (3.0 - 0.8) # 0.8 → 3.0
        k_xdot   = 0.2 + norm * (1.5 - 0.2) # 0.2 → 1.5
        raw = -(k_theta  * pole_angle +
                k_thetad * pole_angular_velocity +
                k_x      * cart_position +
                k_xdot   * cart_velocity)
        force = clip(raw, -3, 3)

    if force is None:
        return random.uniform(-3, 3)
    return force
