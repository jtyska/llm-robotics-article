import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    action = random.uniform(-3.0, 3.0)
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        action = 0.0
    elif abs(pole_angle) < 0.05:
        action = 0.0
    else:
        tilt_raw = (abs(pole_angle) - 0.05) / (0.18 - 0.05)
        tilt = max(0.0, min(tilt_raw, 1.0))
        Kp_theta = 8.0 + 300.0 * (tilt ** 2)
        Kd_theta = 2.5 + 150.0 * (tilt ** 3)
        Kp_cart = 0.6 + 4.0 * tilt
        Kd_cart = 0.15 + 1.0 * tilt
        ff_gain = 0.4 + 3.0 * (tilt ** 3)
        sign_theta = 1.0 if pole_angle > 0 else -1.0 if pole_angle < 0 else 0.0
        force_raw = (-Kp_theta * pole_angle
                     -Kd_theta * pole_angular_velocity
                     -Kp_cart * cart_position
                     -Kd_cart * cart_velocity
                     +ff_gain * sign_theta)
        action = max(-3.0, min(force_raw, 3.0))
    return action
