import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    # tilt calculation
    if abs(theta) <= 0.05:
        tilt = 0.0
    else:
        tilt = (abs(theta) - 0.05) / (0.20 - 0.05)
    if tilt > 1.0:
        tilt = 1.0

    # gains
    Kp_pole = 4.0 + 120.0 * tilt * tilt
    Kd_pole = 1.5 + 25.0 * tilt * tilt
    Kp_cart = 0.02 + 0.18 * tilt * tilt
    Kd_cart = 0.005 + 0.045 * tilt * tilt

    # boost
    boost = 1.0
    if abs(theta_dot) > 0.8:
        boost *= 1.15
    if abs(x_dot) > 0.6:
        boost *= 1.10
    if boost > 1.3:
        boost = 1.3

    # feed‑forward term
    sign_theta = math.copysign(1.0, theta) if theta != 0 else 0.0
    ff_term = - tilt * theta_dot * sign_theta

    # PD terms
    pole_pd = - Kp_pole * theta - Kd_pole * theta_dot * boost
    cart_pd = - Kp_cart * x - Kd_cart * x_dot

    raw_force = pole_pd + cart_pd + ff_term

    if raw_force > 3.0:
        force = 3.0
    elif raw_force < -3.0:
        force = -3.0
    else:
        force = raw_force

    return force

    # default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
