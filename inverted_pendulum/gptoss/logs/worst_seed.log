import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0

    theta = pole_angle
    theta_dot = pole_angular_velocity
    x = cart_position
    x_dot = cart_velocity

    theta_abs = abs(theta)
    tilt_norm_raw = (theta_abs - 0.02) / (0.20 - 0.02)

    if tilt_norm_raw < 0:
        tilt_norm = 0.0
    elif tilt_norm_raw > 1:
        tilt_norm = 1.0
    else:
        tilt_norm = tilt_norm_raw

    Kp_theta = 30.0 - 22.0 * tilt_norm
    Kd_theta = 8.0 + 22.0 * tilt_norm
    Kp_x = 0.5 - 0.4 * tilt_norm
    Kd_x = 0.5 - 0.4 * tilt_norm

    u_raw = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * x + Kd_x * x_dot)
    force = 3.0 * math.tanh(u_raw / 0.5)

    return force

    # fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
