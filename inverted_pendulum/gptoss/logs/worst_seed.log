import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # helper functions
    def is_finite(v):
        return math.isfinite(v)
    def sign(v):
        return 1 if v > 0 else (-1 if v < 0 else 0)
    def clamp(v, lo, hi):
        return max(lo, min(v, hi))

    # Rule 1: non‑finite check
    if not (is_finite(cart_position) and is_finite(pole_angle) and
            is_finite(cart_velocity) and is_finite(pole_angular_velocity)):
        return 0.0

    theta = pole_angle
    x = cart_position
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # Rule 2: large angle
    if abs(theta) >= 0.20:
        action = -sign(theta) * 3.0 - 0.3 * sign(x) - 0.1 * x_dot
        return clamp(action, -3.0, 3.0)

    # Rule 3: blended controller
    u_cart = -(1.0 * x + 0.2 * x_dot)
    u_angle = -(12.0 * theta + 7.0 * theta_dot)

    frac = (abs(theta) - 0.02) / (0.18 - 0.02)
    if frac < 0.0:
        frac = 0.0
    if frac > 1.0:
        frac = 1.0

    alpha = 1.0 / (1.0 + math.exp(-12.0 * (frac - 0.5)))
    blended = (1.0 - alpha) * u_cart + alpha * u_angle
    scale = 1.0 + alpha
    action = clamp(scale * blended, -3.0, 3.0)
    return action

    # fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
