import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    force = None

    if (not math.isfinite(cart_position) or
        not math.isfinite(cart_velocity) or
        not math.isfinite(pole_angle) or
        not math.isfinite(pole_angular_velocity)):
        force = 0.0
    else:
        # 1. Normalised tilt
        tilt_raw = (abs(pole_angle) - 0.0) / 0.20
        tilt_raw = max(0.0, min(tilt_raw, 1.0))

        # 2. PD gains for pole
        Kp_theta = 30.0
        Kd_theta = 2.0

        # 3. Soft cart-centering gain
        if tilt_raw < 0.3:
            Kp_x = 0.004
            Kd_x = 0.001
            cart_center_force = -(Kp_x * cart_position + Kd_x * cart_velocity)
        else:
            cart_center_force = 0.0

        # 4. Raw control signal
        u = -(Kp_theta * pole_angle + Kd_theta * pole_angular_velocity) + cart_center_force

        # 5. Saturate to actuator limits
        force = max(-3.0, min(u, 3.0))

    if force is not None:
        return force
    return random.uniform(-3.0, 3.0)
