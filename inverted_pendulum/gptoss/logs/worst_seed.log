import random, math

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    abs_theta = abs(theta)
    if abs_theta <= 0.05:
        tilt_norm = 0.0
    elif abs_theta >= 0.20:
        tilt_norm = 1.0
    else:
        tilt_norm = (abs_theta - 0.05) / 0.15

    Kp_theta = (1 - tilt_norm) * 12.0 + tilt_norm * 45.0
    Kd_theta = (1 - tilt_norm) * 6.0 + tilt_norm * 22.0
    Kp_x = (1 - tilt_norm) * 0.08 + tilt_norm * 0.30
    Kd_x = (1 - tilt_norm) * 0.08 + tilt_norm * 0.30

    u_raw = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * x + Kd_x * x_dot)
    force_raw = 3.0 * math.tanh(u_raw / 0.9)

    if abs(force_raw) < 0.02:
        return 0.0
    else:
        return force_raw

    # fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
