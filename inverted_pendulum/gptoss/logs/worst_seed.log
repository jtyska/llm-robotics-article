import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # helper clamp
    def clamp(val, lo, hi):
        return max(lo, min(val, hi))
    
    # finite check
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    theta = pole_angle
    theta_dot = pole_angular_velocity
    x = cart_position
    x_dot = cart_velocity

    if abs(theta) >= 0.18:
        sign = 0.0
        if theta > 0:
            sign = 1.0
        elif theta < 0:
            sign = -1.0
        force = clamp(-sign * 3.0, -3.0, 3.0)
        return force

    # blended control
    u_angle = -(15.0 * theta + 3.0 * theta_dot)          # angle‑PD term
    u_cart  = -(1.0 * x + 0.4 * x_dot)                  # cart‑PD term

    w = (abs(theta) - 0.02) / (0.18 - 0.02)              # blend weight
    w = clamp(w, 0.0, 1.0)

    scale = 1.0 + (abs(theta) - 0.02) / (0.18 - 0.02)   # angle‑gain scaling
    scale = clamp(scale, 1.0, 2.0)

    raw = w * scale * u_angle + (1.0 - w) * u_cart       # blended control
    force = clamp(raw, -3.0, 3.0)                        # saturation

