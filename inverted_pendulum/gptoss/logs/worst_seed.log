def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0
    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity
    if abs(theta) >= 0.18:
        sign = 1.0 if theta > 0 else -1.0 if theta < 0 else 0.0
        force = -sign * 3.0
        return max(-3.0, min(3.0, force))
    elif abs(theta) <= 0.02:
        raw = -(0.45 * x + 0.75 * x_dot + 12.0 * theta + 3.5 * theta_dot)
        return max(-3.0, min(3.0, raw))
    else:
        a = (abs(theta) - 0.02) / (0.18 - 0.02)
        return random.uniform(-3.0, 3.0)
