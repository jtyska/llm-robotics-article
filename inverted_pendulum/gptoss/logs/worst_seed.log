import random, math

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    abs_theta = abs(theta)

    if abs_theta < 0.018:
        u = -(0.85 * x + 0.45 * x_dot)
        return max(-3.0, min(3.0, u))

    if abs_theta >= 0.12:
        u_lin = -(14.0 * theta + 10.0 * theta_dot)
        boost = -9.0 * math.copysign(1.0, theta) * (abs_theta - 0.12) ** 3
        u_raw = u_lin + boost
        u_soft = 3.0 * math.tanh(u_raw / 3.0)
        return max(-3.0, min(3.0, u_soft))

    # 0.018 ≤ |theta| < 0.12
    u_lin = -(12.0 * theta + 8.0 * theta_dot)
    scale = 1.0 + 4.0 * ((abs_theta - 0.018) / (0.20 - 0.018))
    if scale > 5.0:
        scale = 5.0
    if 0.05 < abs_theta < 0.12:
        boost = -7.0 * math.copysign(1.0, theta) * (abs_theta - 0.05) * (abs_theta - 0.05)
    else:
        boost = 0.0
    u_raw = u_lin * scale + boost
    u_soft = 3.0 * math.tanh(u_raw / 3.0)
    return max(-3.0, min(3.0, u_soft))

    # fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
