import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    def clamp(v, lo, hi):
        return max(lo, min(v, hi))
    def sign(v):
        if v > 0:
            return 1
        elif v < 0:
            return -1
        return 0

    force = None

    # Rule 1 – Safety
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    # Rule 2 – Emergency (failure angle)
    elif abs(pole_angle) >= 0.20:
        force = clamp(-3 * sign(pole_angle), -3, 3)
    else:
        # Rule 3 – Compute elementary controls
        F_cart = -(0.55 * cart_position + 0.12 * cart_velocity)
        F_angle = -(13.0 * pole_angle + 3.5 * pole_angular_velocity)

        # Rule 4 – Determine blending weight α
        a = abs(pole_angle)
        if a <= 0.015:
            alpha = 0.0
        elif a >= 0.10:
            alpha = 1.0
        else:
            alpha = 1.0 / (1.0 + math.exp(-10.0 * (a - 0.06)))

        # Rule 5 – Mix the two commands
        F_raw = (1 - alpha) * F_cart + alpha * F_angle

        # Rule 6 – Final clamp
        force = clamp(F_raw, -3, 3)

    # Default random action if no rule applied
    if force is None:
        force = random.uniform(-3, 3)

    return force
