import random
import math

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non‑finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Small angle region
    if abs(pole_angle) < 0.02:
        u = -(0.8 * cart_position + 0.4 * cart_velocity)
        return max(-3.0, min(3.0, u))

    # Linear LQR‑like feedback
    u_lin = -(13.0 * pole_angle + 9.0 * pole_angular_velocity +
              0.6 * cart_position + 0.3 * cart_velocity)

    # Angle‑dependent scale, bounded between 1 and 5
    theta_abs = abs(pole_angle)
    scale = 1.0 + 4.0 * (theta_abs - 0.02) / (0.20 - 0.02)
    if scale > 5.0:
        scale = 5.0
    if scale < 1.0:
        scale = 1.0

    # Combine, soft‑saturate, and clip
    u_raw = u_lin * scale
    u_soft = 3.0 * math.tanh(u_raw / 3.0)
    return max(-3.0, min(3.0, u_soft))

    # Default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
