def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity
    used_rule = False
    if not (math.isfinite(x) and math.isfinite(theta) and math.isfinite(x_dot) and math.isfinite(theta_dot)):
        force = 0.0
        used_rule = True
    else:
        tilt_raw = (abs(theta) - 0.05) / (0.18 - 0.05)
        tilt_raw = max(0.0, min(tilt_raw, 1.0))
        gain_factor = tilt_raw ** 3
        Kp = 4.0 + 6.0 * gain_factor
        Kd = 2.0 + 3.0 * gain_factor
        if tilt_raw < 0.3:
            Kx = 0.5
            Kxd = 0.1
        else:
            Kx = 0.0
            Kxd = 0.0
        pd_raw = -Kp * theta - Kd * theta_dot - Kx * x - Kxd * x_dot
        force = 3.0 * math.tanh(pd_raw)
        used_rule = True
    if used_rule:
        return force
    return random.uniform(-3.0, 3.0)
