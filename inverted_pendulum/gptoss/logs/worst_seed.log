import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    tilt = (abs(theta) - 0.05) / (0.18 - 0.05)
    if tilt < 0.0:
        tilt = 0.0
    elif tilt > 1.0:
        tilt = 1.0

    Kp = 30.0 + 150.0 * tilt
    Kd = 2.0 + 10.0 * tilt
    Kx = 0.5 * tilt
    Kv = 0.1 * tilt
    ff_grav = 0.15 * math.sin(theta)

    u_raw = -(Kp * theta + Kd * theta_dot + ff_grav) - (Kx * x + Kv * x_dot)

    if u_raw > 3.0:
        force = 3.0
    elif u_raw < -3.0:
        force = -3.0
    else:
        force = u_raw

    return force

    # default random action (unreachable)
    return random.uniform(-3, 3)
