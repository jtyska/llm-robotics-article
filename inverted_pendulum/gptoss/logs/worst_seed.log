import math, random

# Persistent state
integral_angle = 0.0
dt = 0.02  # simulation step size (adjust if different)

def clamp(v, lo, hi):
    return max(lo, min(hi, v))

def sign(v):
    return 1 if v > 0 else -1 if v < 0 else 0

def deadzone(v, dz):
    return 0.0 if abs(v) < dz else v

# Constants
Kx = 1.0
Kx_dot = 0.8
Kθ = 20.0
Kθ_dot = 15.0
Ki_angle = 0.1
MAX_FORCE = 3.0
DZ = 0.001
θ1 = 0.02
θ2 = 0.15
θ3 = 0.18
θ_fail = 0.20

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    global integral_angle
    # Update integral of angle
    integral_angle += pole_angle * dt

    # Finite check
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    theta = pole_angle
    x = cart_position
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if abs(theta) >= θ_fail:
        force = clamp(-sign(theta) * MAX_FORCE, -MAX_FORCE, MAX_FORCE)
    elif abs(theta) <= θ1:
        raw = -(Kx * x + Kx_dot * x_dot)
        force = clamp(deadzone(raw, DZ), -MAX_FORCE, MAX_FORCE)
    elif abs(theta) < θ2:
        scale = 1.0 + (abs(theta) - θ1) / (θ2 - θ1)
        raw = scale * (-(Kθ * theta + Kθ_dot * theta_dot) + Ki_angle * integral_angle)
        force = clamp(deadzone(raw, DZ), -MAX_FORCE, MAX_FORCE)
    else:
        raw = 2.0 * (-(Kθ * theta + Kθ_dot * theta_dot) + Ki_angle * integral_angle) - \
              0.2 * (Kx * x + Kx_dot * x_dot)
        force = clamp(deadzone(raw, DZ), -MAX_FORCE, MAX_FORCE)

    return force if 'force' in locals() else random.uniform(-3.0, 3.0)
