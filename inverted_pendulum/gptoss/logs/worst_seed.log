import math, random

def _clamp(value, min_val, max_val):
    return max(min(value, max_val), min_val)

def _sign(x):
    if x > 0:
        return 1.0
    if x < 0:
        return -1.0
    return 0.0

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if (not math.isfinite(x) or not math.isfinite(theta) or
        not math.isfinite(x_dot) or not math.isfinite(theta_dot)):
        return 0.0

    if abs(theta) >= 0.20:
        force = _clamp(-_sign(theta) * 3.0, -3.0, 3.0)
        return force

    if abs(theta) <= 0.02:
        Kx = 1.0
        Kx_dot = 0.5
        raw = -(Kx * x + Kx_dot * x_dot)
        force = _clamp(raw, -3.0, 3.0)
        return force

    # 0.02 < |theta| < 0.18 (or other values not caught above)
    Ktheta = 30.0
    Ktheta_dot = 8.0
    u_angle = -(Ktheta * theta + Ktheta_dot * theta_dot)
    scale = 1.0 + 0.5 * (abs(theta) - 0.02) / (0.18 - 0.02)
    scale = _clamp(scale, 1.0, 1.5)
    raw_force = scale * u_angle
    force = _clamp(raw_force, -3.0, 3.0)
    return force

    # default random action (should not be reached)
    return random.uniform(-3.0, 3.0)
