import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Unpack for readability
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # Helper sign function
    def sign(v):
        if v > 0:
            return 1.0
        if v < 0:
            return -1.0
        return 0.0

    # Rule 1: non‑finite values
    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    # Rule 2: cart out of bounds
    if abs(x) > 1.2:
        return -sign(x) * 3.0

    # Rule 3: compute PD control
    tilt_raw = (abs(theta) - 0.05) / (0.18 - 0.05)
    tilt_raw = max(0.0, min(1.0, tilt_raw))   # clamp to [0,1]
    tilt = tilt_raw * tilt_raw               # quadratic scaling

    Kp_theta = 30.0 + 120.0 * tilt
    Kd_theta = 2.0  +   8.0 * tilt
    Kp_x     = 0.02 + 0.06 * tilt
    Kd_x     = 0.004+ 0.02 * tilt

    ff_grav = 0.48 * math.sin(theta)
    bias    = 0.015 * sign(theta) * tilt

    u_raw = -(Kp_theta * theta
              + Kd_theta * theta_dot
              + Kp_x * x
              + Kd_x * x_dot
              + ff_grav) + bias

    # Hard clipping to actuator limits
    if u_raw > 3.0:
        force = 3.0
    elif u_raw < -3.0:
        force = -3.0
    else:
        force = u_raw

    return force

    # Default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
