```
# ---- Safety -------------------------------------------------
IF ( NOT isFinite(x) OR NOT isFinite(theta) OR NOT isFinite(x_dot) OR NOT isFinite(theta_dot) )
THEN force ← 0.0

# ---- Emergency (near‑failure) -------------------------------
ELSE IF ( abs(theta) ≥ 0.18 )
THEN force ← clamp( -sign(theta) * 3.0 , -3.0 , 3.0 )

# ---- Very small tilt – pure cart stabilisation -------------
ELSE IF ( abs(theta) ≤ 0.02 )
THEN
    # Cart‑position + small velocity damping
    u_cart ← -( Kx      * x      + Kx_dot  * x_dot )
    force  ← clamp( u_cart , -3.0 , 3.0 )

# ---- General case – angle‑dominant with damping -------------
ELSE
    # 1) Angle‑only proportional‑derivative term
    u_angle ← -( Kθ      * theta      + Kθ_dot * theta_dot )

    # 2) Add a weak cart‑velocity counter‑force
    u_cart_vel ← -( Kx_dot_small * x_dot )          # Kx_dot_small ≈ 0.2

    # 3) Blend the two (cart‑velocity term is always added)
    raw ← u_angle + u_cart_vel

    # 4) Scale the magnitude according to how far we are from vertical
    #    Convex scaling:  scale = 1 + a * ((|θ|-0.02)/(0.18-0.02))^p
    a ← 1.0                # max extra factor = 1 → overall max = 2
    p ← 1.2                # convex exponent
    frac ← (abs(theta) - 0.02) / (0.18 - 0.02)
    scale ← 1.0 + a * (frac ^ p)
    IF (scale > 2.0) THEN scale ← 2.0
    IF (scale < 1.0) THEN scale ← 1.0

    force ← clamp( scale * raw , -3.0 , 3.0 )
```

