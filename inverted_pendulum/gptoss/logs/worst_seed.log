    #   values >0.18 are clipped to 1
    theta_abs ← |theta|
    IF theta_abs ≤ 0.05
        tilt_norm ← 0.0
    ELSE IF theta_abs ≥ 0.18
        tilt_norm ← 1.0
    ELSE
        tilt_norm ← (theta_abs - 0.05) / (0.18 - 0.05)   # linear in [0,1]
    ENDIF

