import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non‑finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    theta = pole_angle
    theta_dot = pole_angular_velocity
    x = cart_position
    x_dot = cart_velocity

    abs_theta = abs(theta)

    # Determine gains
    if abs_theta <= 0.05:
        Kp_pole = 2.0
        Kd_pole = 0.8
    elif abs_theta >= 0.20:
        Kp_pole = 5.5
        Kd_pole = 2.5
    else:
        tilt_norm = (abs_theta - 0.05) / 0.15
        Kp_pole = 2.0 + (5.5 - 2.0) * tilt_norm
        Kd_pole = 0.8 + (2.5 - 0.8) * tilt_norm

    # Compute raw control signal
    u_raw = -(Kp_pole * math.sin(theta) + Kd_pole * theta_dot) \
            + 9.81 * math.sin(theta) \
            - (0.20 * x + 0.30 * x_dot)

    # Apply saturation and deadzone
    if u_raw > 3.0:
        force = 3.0
    elif u_raw < -3.0:
        force = -3.0
    elif abs(u_raw) < 0.02:
        force = 0.0
    else:
        force = u_raw

    return force

    # Default fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
