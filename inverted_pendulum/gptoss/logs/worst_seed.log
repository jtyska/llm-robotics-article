import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if not hasattr(get_action, "theta_int"):
        get_action.theta_int = 0.0
    used_rule = False
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        force = 0.0
        used_rule = True
    else:
        # 1. Normalised tilt (0 … 1)
        tilt_raw = (abs(pole_angle) - 0.05) / (0.18 - 0.05)
        if tilt_raw < 0.0:
            tilt_raw = 0.0
        elif tilt_raw > 1.0:
            tilt_raw = 1.0
        # 2. Smooth gain curve
        g = tilt_raw * tilt_raw
        # 3. Pole PD gains
        Kp_theta = 12.0 + 30.0 * g
        Kd_theta = 5.0 + 15.0 * g
        # 4. Integral on pole angle (slow integration)
        alpha_int = 0.004
        get_action.theta_int = (1.0 - alpha_int) * get_action.theta_int + alpha_int * pole_angle
        if get_action.theta_int > 0.2:
            get_action.theta_int = 0.2
        elif get_action.theta_int < -0.2:
            get_action.theta_int = -0.2
        Ki_theta = 0.6 * g
        int_effort = -Ki_theta * get_action.theta_int
        # 5. Pole effort (PD + I)
        pole_effort = -Kp_theta * pole_angle - Kd_theta * pole_angular_velocity + int_effort
        # 6. Centre‑bias (cart‑position correction)
        centre_bias = -0.10 * tilt_raw * cart_position
        # 7. Combine
        force_raw = pole_effort + centre_bias
        # 8. Saturate to actuator limits
        if force_raw > 3.0:
            force = 3.0
        elif force_raw < -3.0:
            force = -3.0
        else:
            force = force_raw
        used_rule = True
    if used_rule:
        return force
    else:
        return random.uniform(-3.0, 3.0)
