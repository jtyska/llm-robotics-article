def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    force = None
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    else:
        x = cart_position
        x_dot = cart_velocity
        theta = pole_angle
        theta_dot = pole_angular_velocity
        abs_theta = abs(theta)
        if abs_theta <= 0.02:
            scale = 0.0
        elif abs_theta >= 0.20:
            scale = 1.0
        else:
            scale = (abs_theta - 0.02) / (0.20 - 0.02)
        k_theta = (1 - scale) * 5.0 + scale * 25.0
        k_theta_dot = (1 - scale) * 1.0 + scale * 8.0
        k_x = (1 - scale) * 0.30 + scale * 0.05
        k_x_dot = (1 - scale) * 0.05 + scale * 0.01
        raw_force = -(k_theta * theta + k_theta_dot * theta_dot + k_x * x + k_x_dot * x_dot + 0.1 * x)
        if raw_force > 3.0:
            force = 3.0
        elif raw_force < -3.0:
            force = -3.0
        else:
            force = raw_force
    if force is None:
        return random.uniform(-3, 3)
    return force
