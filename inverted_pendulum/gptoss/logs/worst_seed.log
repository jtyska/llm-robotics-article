    Kp_x = 0.2 + (1.0 - 0.2) * tilt_norm**2
    Kd_x = 0.05 + (0.2 - 0.05) * tilt_norm**2
    u = -(Kp_theta * pole_angle
          + Kd_theta * pole_angular_velocity
          + Kp_x * cart_position
          + Kd_x * cart_velocity)
    force = max(-3.0, min(u, 3.0))
    return force
    return random.uniform(-3.0, 3.0)
