Kxd     = 0.40          # cart‑velocity derivative
Kθ_base = 0.80          # pole‑angle proportional (when |θ|≈0)
Kθd_base= 0.30          # pole‑angular‑velocity derivative (when |θ|≈0)

# --------------------------------------------------------------
# 3. Gain‑schedule as a smooth function of |θ|
#    We map |θ|∈[0, 0.20] → a factor f∈[0,1]
f_angle = clamp( (abs(theta) - 0.00) / (0.20 - 0.00), 0.0, 1.0 )

#    Angle gains grow up to a chosen maximum
Kθ      = Kθ_base  + f_angle * (4.0  - Kθ_base)   # 0.8 → 4.0
Kθd     = Kθd_base + f_angle * (1.5  - Kθd_base) # 0.3 → 1.5

#    Cart gains also increase a little when the pole is far away
#    (helps to pull the cart back before the pole blows up)
Kx_mod  = Kx  + f_angle * 0.30   # 0.80 → 1.10
Kxd_mod = Kxd + f_angle * 0.15   # 0.40 → 0.55

# --------------------------------------------------------------
# 4. Optional tiny bias that always pushes the cart toward the centre
#    (acts like a very small spring, ε = 0.001)
bias = -0.001 * x

# --------------------------------------------------------------
# 5. Compute the two PD components
u_cart  = -(Kx_mod  * x  + Kxd_mod  * x_dot) + bias
u_angle = -(Kθ      * theta + Kθd      * theta_dot)

# --------------------------------------------------------------
# 6. Blend the two components.
#    When the pole is almost upright we let the angle term dominate,
#    otherwise we give both loops roughly equal weight.
#    A simple linear blend based on f_angle works well:
weight_angle = 0.5 + 0.5 * f_angle   # 0.5 → 1.0
weight_cart  = 1.0 - weight_angle    # 0.5 → 0.0

u_raw = weight_cart * u_cart + weight_angle * u_angle

# --------------------------------------------------------------
# 7. Saturate to the admissible force range
action = clamp(u_raw, -3.0, 3.0)

RETURN action
```

