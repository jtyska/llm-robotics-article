def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    tilt_raw = (abs(pole_angle) - 0.05) / (0.18 - 0.05)
    tilt_raw = max(0.0, min(tilt_raw, 1.0))
    Kp_theta = 8.0 + (16.0 - 8.0) * tilt_raw
    Kd_theta = 3.0 + (7.0 - 3.0) * tilt_raw
    Kp_cart = 0.08 + (0.14 - 0.08) * tilt_raw
    Kd_cart = 0.015 + (0.030 - 0.015) * tilt_raw
    ff_gain = 0.0 + (0.35 - 0.0) * tilt_raw
    force_raw = -Kp_theta * pole_angle
    action = max(min(force_raw, 3.0), -3.0)
    return action
    return random.uniform(-3, 3)
