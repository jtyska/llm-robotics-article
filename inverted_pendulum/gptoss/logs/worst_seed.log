def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # check for non‑finite inputs
    if not all(math.isfinite(v) for v in (cart_position, pole_angle, cart_velocity, pole_angular_velocity)):
        return 0.0

    theta = pole_angle
    theta_dot = pole_angular_velocity

    # compute tilt factor
    tilt_raw = (abs(theta) - 0.04) / (0.18 - 0.04)
    tilt = max(0.0, min(tilt_raw, 1.0))

    # large tilt handling
    if abs(theta) >= 0.17:
        sign_theta = 1 if theta > 0 else -1 if theta < 0 else 0
        raw_force = -3.0 * sign_theta - 1.5 * theta_dot
    else:
        # gains (some are unused per the specification)
        Kp_pole = 8.0 + 120.0 * tilt * tilt
        Kd_pole = 2.5 + 25.0 * tilt * tilt
        Kp_cart = 0.6 + 1.8 * tilt
        Kd_cart = 0.15 + 0.6 * tilt
        ff_gain = 0.4 + 1.2 * tilt
        ff_term = -ff_gain * theta_dot

        # leaky integrator for theta
        if not hasattr(get_action, "integral_theta"):
            get_action.integral_theta = 0.0
        get_action.integral_theta = get_action.integral_theta * 0.99 + theta * 0.001
        Ki_pole = 0.5 * tilt
        int_term = -Ki_pole * get_action.integral_theta

        # base control law (as given)
        raw_force = -Kp_pole * theta

    # clamp to allowed action range
    force = max(-3.0, min(raw_force, 3.0))

    # fallback random action (should not be reached)
    if force is None:
        return random.uniform(-3.0, 3.0)
    return force
