import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0

    u_base = -(0.8 * cart_position + 0.4 * cart_velocity +
               12.0 * pole_angle + 8.0 * pole_angular_velocity)

    theta_abs = abs(pole_angle)
    if theta_abs < 0.01:
        gain = 0.0
    elif theta_abs < 0.20:
        gain = 1.0 + 5.0 * (theta_abs - 0.01) / (0.20 - 0.01)
    else:
        gain = 6.0

    u_scaled = gain * u_base
    u_soft = 3.0 * math.tanh(u_scaled / 3.0)

    if u_soft > 3.0:
        force = 3.0
    elif u_soft < -3.0:
        force = -3.0
    else:
        force = u_soft

    return force

    # fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
