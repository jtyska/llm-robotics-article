import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    def is_finite(v):
        return math.isfinite(v)

    def sign(v):
        if v > 0:
            return 1.0
        if v < 0:
            return -1.0
        return 0.0

    # default: no rule matched
    force_raw = None

    if (not is_finite(x) or not is_finite(theta) or
        not is_finite(x_dot) or not is_finite(theta_dot)):
        force_raw = 0.0
    elif abs(theta) >= 0.18:
        force_raw = -sign(theta) * 3.0
    elif abs(theta) >= 0.08:
        K_theta = 30.0
        K_theta_dot = 10.0
        u_angle = -(K_theta * theta + K_theta_dot * theta_dot)

        scale_min = 1.0
        scale_max = 2.0
        scale = (scale_min +
                 (abs(theta) - 0.08) * (scale_max - scale_min) /
                 (0.18 - 0.08))
        if scale > scale_max:
            scale = scale_max
        if scale < scale_min:
            scale = scale_min

        Kx = 1.2
        Kx_dot = 0.3
        u_cart = -(Kx * x + Kx_dot * x_dot)

        force_raw = scale * u_angle + u_cart
    else:
        Kx = 1.5
        Kx_dot = 0.4
        u_cart = -(Kx * x + Kx_dot * x_dot)

        K_theta_small = 15.0
        K_theta_dot_small = 5.0
        u_angle_small = -(K_theta_small * theta + K_theta_dot_small * theta_dot) * 0.3

        force_raw = u_cart + u_angle_small

    if force_raw is None:
        return random.uniform(-3.0, 3.0)

    force = 3.0 * math.tanh(force_raw / 3.0)
    return force
