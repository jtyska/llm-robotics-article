import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Helper clamp
    def clamp(val, low, high):
        return max(low, min(high, val))
    
    # Check for non-finite values
    if not all(math.isfinite(v) for v in (cart_position, pole_angle, cart_velocity, pole_angular_velocity)):
        return 0.0

    theta_abs = abs(pole_angle)

    # Rule: large angle
    if theta_abs >= 0.20:
        sign = 1.0 if pole_angle > 0 else -1.0
        return -sign * 3.0

    # Rule: near upright
    if theta_abs < 0.02:
        u = -(0.8 * cart_position + 0.4 * cart_velocity)
        return clamp(u, -3.0, 3.0)

    # General case
    scale = 1.0 + 4.0 * (theta_abs - 0.02) / (0.20 - 0.02)
    scale = clamp(scale, 1.0, 5.0)

    u_angle = -scale * (12.0 * pole_angle + 5.0 * pole_angular_velocity)
    u_cart = -scale * (0.9 * cart_position + 0.45 * cart_velocity)
    u = u_angle + u_cart
    return clamp(u, -3.0, 3.0)

    # Fallback random action (should not be reached)
    return random.uniform(-3.0, 3.0)
