import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # helper functions
    def is_finite(v):
        return math.isfinite(v)
    def clamp(v, lo, hi):
        return max(lo, min(v, hi))
    def sign(v):
        return 1.0 if v > 0 else (-1.0 if v < 0 else 0.0)

    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # Rule 1: non‑finite inputs
    if not (is_finite(x) and is_finite(x_dot) and is_finite(theta) and is_finite(theta_dot)):
        return 0.0

    # Rule 2: angle beyond failure limit
    if abs(theta) >= 0.20:
        return clamp(-sign(theta) * 3.0, -3.0, 3.0)

    # Rule 3: near‑upright angle
    if abs(theta) <= 0.02:
        return clamp(-(0.9 * x + 0.12 * x_dot), -3.0, 3.0)

    # Rule 4: intermediate angles
    rel = (abs(theta) - 0.02) / (0.18 - 0.02)          # ∈ (0,1)
    scale = 1.0 + rel ** 3                             # cubic‑ease‑in
    if scale > 2.0:
        scale = 2.0
    cart_gain = (1.0 - rel) * 0.4

    u_angle = -(25.0 * theta + 4.0 * theta_dot)
    u_cart = -cart_gain * (0.9 * x + 0.12 * x_dot)

    raw_total = scale * u_angle + u_cart
    force = 3.0 * math.tanh(raw_total / 3.0)
    return force

