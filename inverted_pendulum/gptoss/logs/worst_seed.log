def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    action = None
    # Rule 1
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        action = 0.0
    # Rule 2
    elif pole_angle < -0.20 or pole_angle > 0.20:
        action = 0.0
    # Rule 3
    else:
        theta = pole_angle
        theta_abs = abs(theta)
        s_raw = (theta_abs - 0.02) / (0.20 - 0.02)
        s = min(max(s_raw, 0.0), 1.0)
        K_theta   = 0.8  + s * (15.0 - 0.8)
        K_theta_d = 0.3  + s * (6.0  - 0.3)
        K_x   = 0.80 * (1.0 - s) + 0.20 * s
        K_x_d = 0.40 * (1.0 - s) + 0.10 * s
        u_cart   = -(K_x   * cart_position + K_x_d   * cart_velocity)
        u_angle  = -(K_theta * theta + K_theta_d * pole_angular_velocity)
        u_grav   =  0.5 * theta
        u_center = -0.20 * cart_position
        u_raw = u_cart + u_angle + u_grav + u_center
        u_safety = min(max(u_raw, -3.0 + 0.05), 3.0 - 0.05)
        action = min(max(0.95 * u_safety, -3.0), 3.0)
    if action is None:
        action = random.uniform(-3.0, 3.0)
    return action
