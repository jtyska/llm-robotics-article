import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(theta) and math.isfinite(x_dot) and math.isfinite(theta_dot)):
        return 0.0

    abs_theta = abs(theta)
    if abs_theta <= 0.05:
        tilt_norm = 0.0
    elif abs_theta >= 0.20:
        tilt_norm = 1.0
    else:
        tilt_norm = (abs_theta - 0.05) / 0.15

    Kp_pole = 2.0 + 2.5 * tilt_norm
    Kd_pole = 0.8 + 1.2 * tilt_norm
    Kp_cart = 0.04
    Kd_cart = 0.06

    pole_pd = -(Kp_pole * math.sin(theta) + Kd_pole * theta_dot)
    gravity_ff = 9.81 * math.sin(theta)
    cart_pd = -(Kp_cart * x + Kd_cart * x_dot)

    u_raw = pole_pd + gravity_ff + cart_pd
    force = 3.0 * math.tanh(u_raw)

    if force > 3.0:
        force = 3.0
    elif force < -3.0:
        force = -3.0

    return force

    # fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
