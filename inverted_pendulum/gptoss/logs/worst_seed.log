```text
/* -------------------------------------------------------------
   CART‑POLE BALANCING – RULE‑BASED CONTROLLER
   -------------------------------------------------------------
   State vector:  s = [x, x_dot, theta, theta_dot]
   Action:        force ∈ [‑3.0 , 3.0]   (N)
   Failure: |theta| > 0.2 rad  OR any component not finite
   ------------------------------------------------------------- */

IF NOT isfinite(x) OR NOT isfinite(x_dot) OR NOT isfinite(theta) OR NOT isfinite(theta_dot)
THEN
    force ← 0.0
ELSE
    /* ---------- 1. Normalised tilt (0 … 1) ---------- */
    const TILT_MIN = 0.04          // below this we treat the pole as “almost upright”
    const TILT_MAX = 0.20          // failure angle
    abs_theta ← |theta|

    IF abs_theta ≤ TILT_MIN
        tilt_norm ← 0.0
    ELSE IF abs_theta ≥ TILT_MAX
        tilt_norm ← 1.0
    ELSE
        tilt_norm ← (abs_theta - TILT_MIN) / (TILT_MAX - TILT_MIN)
    ENDIF

    /* ---------- 2. Smoothed derivative of theta ---------- */
    // simple exponential moving average to reduce measurement noise
    const ALPHA = 0.9
    theta_dot_f ← ALPHA * theta_dot_f_prev + (1‑ALPHA) * theta_dot
    // (theta_dot_f_prev is stored from the previous step)

    /* ---------- 3. Gain‑scheduling (linear interpolation) ---------- */
    // Base gains (when tilt_norm = 0)
    const Kp_theta_0 = 10.0
    const Kd_theta_0 = 1.5
    const Kp_x_0     = 0.20
    const Kd_x_0     = 0.10
    const Ki_x_0     = 0.05   // integral gain on cart position

    // Maximum gains (when tilt_norm = 1)
    const Kp_theta_1 = 80.0
    const Kd_theta_1 = 30.0
    const Kp_x_1     = 0.60
    const Kd_x_1     = 0.45
    const Ki_x_1     = 0.15

    Kp_theta ← Kp_theta_0 + (Kp_theta_1 - Kp_theta_0) * tilt_norm
    Kd_theta ← Kd_theta_0 + (Kd_theta_1 - Kd_theta_0) * tilt_norm
    Kp_x     ← Kp_x_0     + (Kp_x_1     - Kp_x_0)     * tilt_norm
    Kd_x     ← Kd_x_0     + (Kd_x_1     - Kd_x_0)     * tilt_norm
    Ki_x     ← Ki_x_0     + (Ki_x_1     - Ki_x_0)     * tilt_norm

    /* ---------- 4. Integral of cart position (anti‑drift) ---------- */
    // simple trapezoidal integration, clamped to avoid wind‑up
    const X_INT_MAX = 2.0
    x_int ← clamp( x_int_prev + 0.5*(x + x_prev)*dt , -X_INT_MAX , X_INT_MAX )

    /* ---------- 5. Feed‑forward torque due to gravity (linearised) ---------- */
    // For a pole of length l and mass m the torque ≈ m·g·l·theta.
    // We use a small coefficient because the full term is already covered by Kp_theta.
    const GFF = 0.2          // empirically tuned
    ff_grav ← GFF * theta

    /* ---------- 6. Raw control law (PD + integral + gravity FF) ---------- */
    u ← -( Kp_theta * theta
           + Kd_theta * theta_dot_f
           + Kp_x     * x
           + Kd_x     * x_dot
           + Ki_x     * x_int
           + ff_grav ) + 0.02   // tiny bias to break symmetry

    /* ---------- 7. Adaptive force envelope ---------- */
    // Minimum authority (soft) when the pole is almost upright,
    // full authority when the pole is close to the failure angle.
    Fmax ← 0.5 + 2.5 * tilt_norm          // 0.5 N → 3.0 N

    /* ---------- 8. Smooth saturation (tanh) ---------- */
    force_raw ← tanh( u / Fmax ) * Fmax

    /* ---------- 9. Clip to physical limits ---------- */
    force ← clamp( force_raw , -3.0 , 3.0 )
ENDIF

/* -------------------------------------------------------------
   Store variables for the next step:
   theta_dot_f_prev ← theta_dot_f
   x_int_prev       ← x_int
   x_prev           ← x
   ------------------------------------------------------------- */
```

