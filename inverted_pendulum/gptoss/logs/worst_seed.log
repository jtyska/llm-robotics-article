import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Helper functions
    def clamp(val, min_val, max_val):
        return max(min_val, min(max_val, val))
    def sign(v):
        return (v > 0) - (v < 0)

    # Finite check
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # Tilt calculation
    abs_theta = abs(theta)
    if abs_theta <= 0.05:
        tilt = 0.0
    elif abs_theta >= 0.20:
        tilt = 1.0
    else:
        tilt_raw = (abs_theta - 0.05) / (0.20 - 0.05)
        tilt = clamp(tilt_raw, 0.0, 1.0)

    # Gains
    Kp_pole = 5.0 + 150.0 * tilt * tilt
    Kd_pole = 2.0 + 30.0 * tilt * tilt
    Ki_pole = 0.02 * tilt

    Kp_cart = 0.05 + 0.20 * tilt * tilt
    Kd_cart = 0.01 + 0.05 * tilt * tilt

    # Boost
    boost = 1.0
    if abs(theta_dot) > 0.8:
        boost *= 1.15
    if abs(x_dot) > 0.6:
        boost *= 1.10
    boost = clamp(boost, 1.0, 1.3)

    # Feed‑forward term
    ff_gain = tilt
    ff_term = -ff_gain * theta_dot * sign(theta)

    # PD and I terms
    pole_pd = -Kp_pole * theta - Kd_pole * theta_dot * boost
    pole_i  = -Ki_pole * theta
    cart_pd = -Kp_cart * x - Kd_cart * x_dot

    raw_force = pole_pd + pole_i + cart_pd + ff_term

    # Safety override
    if abs_theta >= 0.20 and (raw_force * sign(theta) > 0):
        raw_force = -3.0 * sign(theta)

    force = clamp(raw_force, -3.0, 3.0)
    return force if math.isfinite(force) else random.uniform(-3.0, 3.0)
