import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0

    abs_theta = abs(pole_angle)

    if abs_theta <= 0.05:
        tilt_norm = 0.0
    elif abs_theta >= 1.0:
        tilt_norm = 1.0
    else:
        tilt_norm = (abs_theta - 0.05) / (1.0 - 0.05)

    Kx = 0.30 + 0.70 * tilt_norm
    Kx_dot = 0.45 + 1.55 * tilt_norm
    Ktheta = 2.0 + 18.0 * tilt_norm
    Ktheta_d = 0.8 + 9.2 * tilt_norm

    pole_pd = -(Ktheta * pole_angle + Ktheta_d * pole_angular_velocity)
    cart_pd = -(Kx * cart_position + Kx_dot * cart_velocity)
    gravity_ff = 9.81 * math.sin(pole_angle)

    u_raw = pole_pd + cart_pd + gravity_ff
    u_soft = 3.0 * math.tanh(u_raw / 3.0)

    if u_soft > 3.0:
        force = 3.0
    elif u_soft < -3.0:
        force = -3.0
    else:
        force = u_soft

    if abs(force) < 0.02:
        force = 0.0

    return force

    # default random action (should never be reached)
    return random.uniform(-3, 3)
