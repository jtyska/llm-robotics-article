import random, math

def clamp(v, lo, hi):
    return max(lo, min(hi, v))

def sign(v):
    return 1 if v > 0 else -1 if v < 0 else 0

def deadzone(v, dz):
    return 0.0 if abs(v) < dz else v

def smoothstep(t):
    return t * t * (3 - 2 * t)

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Gains
    Kx = 1.0
    Kx_dot = 0.8
    Kθ = 20.0
    Kθ_dot = 15.0
    MAX_FORCE = 3.0
    MIN_FORCE = -3.0
    DEAD_ZONE = 0.001

    # Angle thresholds (radians)
    THETA_SMALL = 0.02
    THETA_MAX = 0.20

    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # Rule: non‑finite values
    if not (math.isfinite(x) and math.isfinite(theta) and math.isfinite(x_dot) and math.isfinite(theta_dot)):
        return 0.0

    # Rule: angle beyond max
    if abs(theta) >= THETA_MAX:
        return clamp(-sign(theta) * MAX_FORCE, MIN_FORCE, MAX_FORCE)

    # Rule: angle within small region
    if abs(theta) <= THETA_SMALL:
        raw = -(Kx * x + Kx_dot * x_dot + Kθ * theta + Kθ_dot * theta_dot)
        raw = deadzone(raw, DEAD_ZONE)
        return clamp(raw, MIN_FORCE, MAX_FORCE)

    # Mixed region
    u_angle = -(Kθ * theta + Kθ_dot * theta_dot)
    t = (abs(theta) - THETA_SMALL) / (THETA_MAX - THETA_SMALL)
    t = clamp(t, 0.0, 1.0)
    scale = 1.0 + 1.5 * smoothstep(t)
    raw = scale * u_angle
    raw += -(Kx * x + Kx_dot * x_dot) * 0.3
    raw = deadzone(raw, DEAD_ZONE)
    return clamp(raw, MIN_FORCE, MAX_FORCE)

    # Default random action (should never be reached)
    # return random.uniform(-3, 3)
