import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    tilt_raw = (abs(theta) - 0.05) / 0.13
    tilt_raw = max(0.0, min(tilt_raw, 1.0))

    tilt = tilt_raw ** 3

    Kp = 4.0 + 6.0 * tilt
    Kd = 2.0 + 3.0 * tilt

    pole_effort = -Kp * theta - Kd * theta_dot
    centre_bias = -0.07 * (1.0 - tilt_raw) * x
    cart_vel_damp = -0.03 * (1.0 - tilt_raw) * x_dot

    if tilt_raw > 0.6:
        ff = 0.2 * (1 if x_dot > 0 else -1 if x_dot < 0 else 0)
    else:
        ff = 0.0

    raw_force = pole_effort + centre_bias + cart_vel_damp + ff
    force = 3.0 * math.tanh(0.30 * raw_force)
    force = max(-3.0, min(force, 3.0))
    return force

    # fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
