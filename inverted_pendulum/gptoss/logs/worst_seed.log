def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    if not hasattr(get_action, "int_theta"):
        get_action.int_theta = 0.0
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    theta_abs = abs(pole_angle)
    tau_raw = (theta_abs - 0.05) / (0.18 - 0.05)
    tau = 1.0 / (1.0 + math.exp(-12.0 * (tau_raw - 0.5)))
    Kp_theta = (1 - tau) * 30.0 + tau * 8.0
    Kd_theta = (1 - tau) * 8.0 + tau * 30.0
    Ki_theta = (1 - tau) * 0.5 + tau * 0.0
    Kp_x = (1 - tau) * 0.05 + tau * 0.12
    Kd_x = (1 - tau) * 0.05 + tau * 0.15
    dt = 0.02
    if tau < 0.2:
        get_action.int_theta += pole_angle * dt
    else:
        get_action.int_theta = 0.0
    u_raw = -(Kp_theta * pole_angle + Kd_theta * pole_angular_velocity + Ki_theta * get_action.int_theta + Kp_x * cart_position + Kd_x * cart_velocity)
    force = 3.0 * math.tanh(u_raw / 1.2)
    return force if math.isfinite(force) else random.uniform(-3, 3)
