import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # controller gains (set to default values, adjust as needed)
    Kx = 0.0
    Kx_dot = 0.0
    Ktheta = 0.0
    Ktheta_dot = 0.0

    def clamp(val, lo, hi):
        return max(lo, min(hi, val))

    def sign(v):
        return 1 if v > 0 else -1 if v < 0 else 0

    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(theta) and math.isfinite(x_dot) and math.isfinite(theta_dot)):
        return 0.0
    elif abs(theta) >= 0.18:
        force = clamp(-sign(theta) * 3.0, -3.0, 3.0)
        return force
    elif abs(theta) <= 0.02:
        force = clamp(-(Kx * x + Kx_dot * x_dot), -3.0, 3.0)
        return force
    else:
        u_angle = -(Ktheta * theta + Ktheta_dot * theta_dot)
        scale = 1.0 + (abs(theta) - 0.02) / (0.18 - 0.02)
        if scale > 2.0:
            scale = 2.0
        if scale < 1.0:
            scale = 1.0
        raw_force = scale * u_angle
        force = clamp(raw_force, -3.0, 3.0)
        return force

    # default random action (should not be reached)
    return random.uniform(-3, 3)
