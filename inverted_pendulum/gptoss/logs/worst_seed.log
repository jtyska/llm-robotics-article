def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # Check for non-finite values
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0

    theta = pole_angle
    theta_dot = pole_angular_velocity

    # Large angle case
    if abs(theta) >= 0.20:
        sign = 1.0 if theta > 0 else -1.0 if theta < 0 else 0.0
        force = -sign * 3.0
        return max(min(force, 3.0), -3.0)

    # Normal control case
    u_angle = -(22.0 * theta + 3.5 * theta_dot)

    if abs(theta) <= 0.02:
        scale = 1.0
    else:
        rel = (abs(theta) - 0.02) / (0.18 - 0.02)  # 0 … 1
        scale = 1.0 + rel * (2.0 - 1.0)            # 1.0 … 2.0

    raw_force = scale * u_angle
    force = max(min(raw_force, 3.0), -3.0)
    return force

    # Default random action (should not be reached)
    return random.uniform(-3.0, 3.0)
