import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # check for non‑finite inputs
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    def sign(x):
        return 1.0 if x > 0 else -1.0 if x < 0 else 0.0

    # large tilt: apply maximum opposite force
    if abs(pole_angle) >= 0.20:
        return -3.0 * sign(pole_angle)

    # compute normalized tilt
    tilt_raw = (abs(pole_angle) - 0.05) / (0.18 - 0.05)
    tilt = max(0.0, min(tilt_raw, 1.0))

    tilt_sq = tilt * tilt

    # pole PD gains
    Kp_pole = 5.0 + 150.0 * tilt_sq
    Kd_pole = 2.0 + 30.0 * tilt_sq

    # cart‑centering gains
    Kp_cart = 0.5 + 2.0 * tilt_sq
    Kd_cart = 0.2 + 0.8 * tilt_sq

    # feed‑forward damping
    ff_gain = tilt
    ff_term = -ff_gain * pole_angular_velocity * sign(pole_angle)

    # PD control terms
    pole_pd = -Kp_pole * pole_angle - Kd_pole * pole_angular_velocity
    cart_pd = -Kp_cart * cart_position - Kd_cart * cart_velocity

    raw_force = pole_pd + cart_pd + ff_term

    # actuator limits
    force = max(-3.0, min(raw_force, 3.0))

    return force

    # default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
