def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # 1. Safety guard
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0
    # 2. Linear state‑feedback (LQR‑style)
    k_theta = 12.0
    k_theta_dot = 8.0
    k_x = 0.5
    k_x_dot = 0.2
    u_lin = -(k_theta * pole_angle +
              k_theta_dot * pole_angular_velocity +
              k_x * cart_position +
              k_x_dot * cart_velocity)
    # 3. Angle‑dependent gain scaling
    abs_theta = abs(pole_angle)
    if abs_theta <= 0.02:
        scale = 1.0
    else:
        scale = 1.0 + 3.0 * (abs_theta - 0.02) / (0.20 - 0.02)
        if scale > 4.0:
            scale = 4.0
    # 4. Angle‑dependent boost
    if abs_theta > 0.05:
        sign = 1.0 if pole_angle > 0 else -1.0
        boost = -5.0 * sign * (abs_theta - 0.05)
    else:
        boost = 0.0
    # 5. Combine, soft‑saturate and hard‑clip
    u_raw = (u_lin * scale) + boost
    u_soft = 3.0 * math.tanh(u_raw / 3.0)
    action = max(-3.0, min(3.0, u_soft))
    return action
    # default random action (fallback)
    return random.uniform(-3.0, 3.0)
