import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Helper sign function
    def sign(x):
        if x > 0:
            return 1.0
        elif x < 0:
            return -1.0
        else:
            return 0.0

    # Check for non-finite values
    if (not math.isfinite(cart_position) or
        not math.isfinite(cart_velocity) or
        not math.isfinite(pole_angle) or
        not math.isfinite(pole_angular_velocity)):
        return 0.0

    theta = pole_angle
    theta_dot = pole_angular_velocity
    x = cart_position
    x_dot = cart_velocity

    # Rule for large angle
    if abs(theta) >= 0.18:
        return -3.0 * sign(theta)

    # Main control law
    raw = -(10.0 * theta + 2.0 * theta_dot + 1.0 * x + 0.5 * x_dot)
    alpha = abs(theta) / 0.18
    if alpha > 1.0:
        alpha = 1.0
    if alpha < 0.0:
        alpha = 0.0
    force = (1.0 - alpha) * raw + alpha * (-3.0 * sign(theta))

    # Clamp force to allowed range
    if force > 3.0:
        force = 3.0
    if force < -3.0:
        force = -3.0

    return force

    # Default random action (should not be reached)
    return random.uniform(-3.0, 3.0)
