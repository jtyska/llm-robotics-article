import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # helper functions
    def clamp(val, low, high):
        return max(min(val, high), low)
    def sign(x):
        return 1.0 if x > 0 else -1.0 if x < 0 else 0.0

    # finite check
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    theta = pole_angle
    theta_dot = pole_angular_velocity
    x = cart_position
    x_dot = cart_velocity

    # angle limit rule
    if abs(theta) >= 0.20:
        return clamp(-sign(theta) * 3.0, -3.0, 3.0)

    # compute angle‑scale
    if abs(theta) <= 0.02:
        scale_angle = 1.0
    else:
        scale_angle = 1.0 + (abs(theta) - 0.02) * (2.5 - 1.0) / (0.20 - 0.02)
        scale_angle = clamp(scale_angle, 1.0, 2.5)

    # blending weights
    w_angle = (abs(theta) - 0.02) / (0.20 - 0.02)
    w_angle = clamp(w_angle, 0.0, 1.0)
    w_cart = 1.0 - w_angle

    # PD terms
    u_angle = -(30.0 * theta + 8.0 * theta_dot)
    u_cart = -(1.0 * x + 0.2 * x_dot)

    # blended command
    raw_force = w_cart * u_cart + w_angle * (scale_angle * u_angle)

    # saturate to actuator limits
    action = clamp(raw_force, -3.0, 3.0)
    return action

    # fallback (should not be reached)
    return random.uniform(-3.0, 3.0)
