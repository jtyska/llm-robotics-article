/* -------------------------------------------------------------
   1. Safety check
   ------------------------------------------------------------- */
IF NOT (isfinite(x) AND isfinite(x_dot) AND isfinite(theta) AND isfinite(theta_dot))
THEN
    force ← 0
    RETURN
ENDIF

/* -------------------------------------------------------------
   2. Normalised tilt (0 = perfectly upright, 1 = at failure bound)
   ------------------------------------------------------------- */
theta_abs   ← abs(theta)
IF theta_abs ≤ 0.05
THEN tilt_norm ← 0
ELSE IF theta_abs ≥ 0.20
THEN tilt_norm ← 1
ELSE
    tilt_norm ← (theta_abs - 0.05) / (0.20 - 0.05)   // linear map to [0,1]
ENDIF

/* -------------------------------------------------------------
   3. Gain schedule (values chosen from the successful run)
      – larger Kpθ when tilt is large, larger Kdθ when tilt is small
      – cart gains stay weak but also grow a little with tilt
   ------------------------------------------------------------- */
Kp_theta_low   ← 6.0   ; Kp_theta_high   ← 15.0
Kd_theta_low   ← 12.0  ; Kd_theta_high   ← 4.0
Kp_x_low       ← 0.08  ; Kp_x_high       ← 0.25
Kd_x_low       ← 0.08  ; Kd_x_high       ← 0.30

Kp_theta ← (1 - tilt_norm) * Kp_theta_low  + tilt_norm * Kp_theta_high
Kd_theta ← (1 - tilt_norm) * Kd_theta_low  + tilt_norm * Kd_theta_high
Kp_x     ← (1 - tilt_norm) * Kp_x_low      + tilt_norm * Kp_x_high
Kd_x     ← (1 - tilt_norm) * Kd_x_low      + tilt_norm * Kd_x_high

/* -------------------------------------------------------------
   4. Small integral on the angle (anti‑bias)
   ------------------------------------------------------------- */
Ki_theta ← 0.05                     // fixed integral gain
int_theta ← int_theta + theta * dt // dt = simulation step (≈0.02 s)
int_theta ← clamp(int_theta, -0.5, 0.5)

/* -------------------------------------------------------------
   5. Control law (PD + I on angle, PD on cart)
   ------------------------------------------------------------- */
u_raw ← -( Kp_theta * theta
          + Kd_theta * theta_dot
          + Ki_theta * int_theta
          + Kp_x * x
          + Kd_x * x_dot )

/* -------------------------------------------------------------
   6. Smooth saturation (tanh) – map to ±3 N
   ------------------------------------------------------------- */
force_raw ← 3.0 * tanh( u_raw / 0.8 )   // denominator tuned for a bit more authority

/* -------------------------------------------------------------
   7. Dead‑zone – ignore tiny forces that only add noise
   ------------------------------------------------------------- */
IF abs(force_raw) < 0.02
THEN force ← 0.0
ELSE force ← force_raw
ENDIF
```

