import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non‑finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Rule: large angle
    if abs(pole_angle) >= 0.16:
        sign = 1.0 if pole_angle > 0 else -1.0 if pole_angle < 0 else 0.0
        return -3.0 * sign

    # Rule: near‑vertical
    if abs(pole_angle) <= 0.02:
        raw = -(1.2 * cart_position + 1.0 * cart_velocity)
        return max(-3.0, min(3.0, raw))

    # General case
    u_angle = -(70.0 * pole_angle + 20.0 * pole_angular_velocity)
    u_pos = -(1.2 * cart_position + 1.0 * cart_velocity) * 0.3
    scale = 1.0 + 2.5 * (abs(pole_angle) - 0.02) / (0.16 - 0.02)
    scale = max(1.0, min(3.0, scale))
    raw = scale * (u_angle + u_pos)
    action = max(-3.0, min(3.0, raw))
    return action

    # Default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
