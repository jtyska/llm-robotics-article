import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non-finite values
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0

    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity

    if abs(theta) <= 0.02:
        raw = -(0.8 * x + 0.4 * x_dot)
        force = max(-3.0, min(3.0, raw))
        return force
    elif abs(theta) <= 0.12:
        raw = -(0.8 * x + 0.4 * x_dot + 8.0 * theta + 4.0 * theta_dot)
        force = max(-3.0, min(3.0, raw))
        return force
    else:
        raw = -(12.0 * theta + 6.0 * theta_dot) - 0.3 * x
        force = max(-3.0, min(3.0, raw))
        return force

    # Default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
