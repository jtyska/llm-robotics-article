def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # Check for non-finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    theta = pole_angle

    # Large angle case
    if abs(theta) >= 0.20:
        sign = 1.0 if theta > 0 else -1.0 if theta < 0 else 0.0
        force = -sign * 3.0
        return max(min(force, 3.0), -3.0)

    # Compute scale_angle
    if abs(theta) <= 0.02:
        scale_angle = 1.0
    else:
        scale_angle = 1.0 + (abs(theta) - 0.02) * (2.5 - 1.0) / (0.18 - 0.02)
        scale_angle = max(min(scale_angle, 2.5), 1.0)

    # Control terms
    u_cart = -(1.0 * cart_position + 0.2 * cart_velocity)
    u_angle = -(30.0 * theta + 8.0 * pole_angular_velocity)
    u_angle = scale_angle * u_angle

