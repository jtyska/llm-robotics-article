import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    if abs(theta) >= 0.18:
        return -3.0 * (1.0 if theta > 0 else -1.0)

    if abs(theta) <= 0.01:
        force = -(1.0 * x + 0.5 * x_dot + 0.1 * theta_dot)
        return max(min(force, 3.0), -3.0)

    scale = 1.0 + (abs(theta) - 0.01) / (0.18 - 0.01) * 2.0
    raw = -(0.8 * x + 0.4 * x_dot + 10.0 * theta + 8.0 * theta_dot) * scale
    force = max(min(raw, 3.0), -3.0)
    return force

    # default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
