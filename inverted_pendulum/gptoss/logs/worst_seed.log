def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    abs_theta = abs(pole_angle)
    if abs_theta <= 0.05:
        tilt_norm = 0.0
    elif abs_theta >= 0.22:
        tilt_norm = 1.0
    else:
        tilt_norm = (abs_theta - 0.05) / (0.22 - 0.05)
    gain_sq = tilt_norm * tilt_norm
    Kp = 4.0 + (12.0 - 4.0) * gain_sq
    Kd = 2.5 + (7.5 - 2.5) * gain_sq
    Ki = 0.1 * tilt_norm
    if not hasattr(get_action, "theta_int"):
        get_action.theta_int = 0.0
    get_action.theta_int = 0.99 * get_action.theta_int + 0.01 * pole_angle
    theta_int = get_action.theta_int
    pole_PD = -(Kp * math.sin(pole_angle) + Kd * pole_angular_velocity + Ki * theta_int)
    gravity_ff = 0.60 * 9.81 * math.sin(pole_angle)
    pole_effort = pole_PD + gravity_ff
    cart_effort = -(0.02 * cart_position + 0.03 * cart_velocity)
    centre_bias = -0.08 * cart_position if abs_theta < 0.07 else 0.0
    raw_force = pole_effort + cart_effort + centre_bias
    force_raw = 3.0 * math.tanh(0.30 * raw_force)
    if force_raw > 3.0:
        force = 3.0
    elif force_raw < -3.0:
        force = -3.0
    else:
        force = force_raw
    return force
    return random.uniform(-3, 3)
