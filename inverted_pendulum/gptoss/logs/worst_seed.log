## Refined Strategy (PD + FF + Integral + Tilt‑Schedule)

```
# --------------------------------------------------------------
# Rule 1 – Safety
IF NOT finite(x) OR NOT finite(x_dot) OR NOT finite(theta) OR NOT finite(theta_dot)
THEN force ← 0.0
ELSE

    # ----------------------------------------------------------
    # Rule 2 – Normalised tilt (0 = upright, 1 = near‑failure)
    IF |theta| ≤ 0.05
        THEN tilt ← 0.0
    ELSE IF |theta| ≥ 0.20
        THEN tilt ← 1.0
    ELSE
        tilt_raw ← (|theta| - 0.05) / (0.20 - 0.05)   # linear map [0.05,0.20] → [0,1]
        tilt ← CLAMP(tilt_raw, 0.0, 1.0)
    ENDIF

    # ----------------------------------------------------------
    # Rule 3 – Gain schedule (quadratic in tilt)
    Kp_pole ← 5.0   + 150.0 * tilt * tilt      # 5 → 155
    Kd_pole ← 2.0   + 30.0  * tilt * tilt      # 2 → 32
    Ki_pole ← 0.02  * tilt                     # tiny integral term

    Kp_cart ← 0.05  + 0.20 * tilt * tilt       # 0.05 → 0.25
    Kd_cart ← 0.01  + 0.05 * tilt * tilt       # 0.01 → 0.06

    # ----------------------------------------------------------
    # Rule 4 – Velocity‑dependent boost (capped)
    boost ← 1.0
    IF |theta_dot| > 0.8 THEN boost ← boost * 1.15 ENDIF
    IF |x_dot|      > 0.6 THEN boost ← boost * 1.10 ENDIF
    boost ← CLAMP(boost, 1.0, 1.3)

    # ----------------------------------------------------------
    # Rule 5 – Feed‑forward term (anticipates fall direction)
    ff_gain ← 1.0 * tilt
    ff_term ← -ff_gain * theta_dot * SIGN(theta)

    # ----------------------------------------------------------
    # Rule 6 – PD + I contributions
    pole_pd ← -Kp_pole * theta - Kd_pole * theta_dot * boost
    pole_i  ← -Ki_pole * theta
    cart_pd ← -Kp_cart * x - Kd_cart * x_dot

    # ----------------------------------------------------------
    # Rule 7 – Combine everything
    raw_force ← pole_pd + pole_i + cart_pd + ff_term

    # ----------------------------------------------------------
    # Rule 8 – Soft hard‑limit (only when we would push the pole away)
    IF |theta| ≥ 0.20 AND (raw_force * SIGN(theta) > 0)
        THEN raw_force ← -3.0 * SIGN(theta)      # push back toward centre
    ENDIF

    # ----------------------------------------------------------
    # Rule 9 – Final saturation
    force ← CLAMP(raw_force, -3.0, 3.0)

END IF
```

