# ------------------------------------------------------------------
#  CART‑POLE BALANCING POLICY (deterministic, continuous force)
# ------------------------------------------------------------------
# State vector:  s = (x, θ, x_dot, θ_dot)
# Action:        force ∈ [‑3.0, +3.0]   (N)

IF any component of s is not finite THEN
    force ← 0.0                                 # safety fallback
ELSE IF |θ| ≥ 0.20 THEN
    force ← 0.0                                 # we have already failed
ELSE
