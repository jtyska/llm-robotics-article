def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    action = None

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        action = 0.0
    elif abs(theta) >= 0.18:
        s = 1.0 if theta > 0 else -1.0 if theta < 0 else 0.0
        raw = -3.0 * s - 0.5 * theta_dot
        action = max(min(raw, 3.0), -3.0)
    elif abs(theta) <= 0.02:
        raw = -(1.0 * x + 0.5 * x_dot)
        if abs(raw) < 0.05:
            raw = 0.0
        action = max(min(raw, 3.0), -3.0)
    else:
        a = abs(theta)
        t = (a - 0.02) / (0.18 - 0.02)  # t ∈ (0,1)
        k_theta = 8.0 + (30.0 - 8.0) * (t * t)      # 8 → 30
        k_theta_dot = 2.0 + (12.0 - 2.0) * (t * t)  # 2 → 12
        k_x = 1.0 - 0.5 * t                        # 1.0 → 0.5
        k_x_dot = 0.5 - 0.3 * t                    # 0.5 → 0.2
        raw = -(k_theta * theta + k_theta_dot * theta_dot) - (k_x * x + k_x_dot * x_dot)
        if abs(raw) < 0.05:
            raw = 0.0
        action = max(min(raw, 3.0), -3.0)

    if action is None:
        return random.uniform(-3.0, 3.0)
    return action
