def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity, _state={'pole_int': 0.0}):
    import math, random
    # Failure check
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Normalized tilt
    abs_theta = abs(pole_angle)
    tilt_norm = (abs_theta - 0.07) / (0.20 - 0.07)
    if tilt_norm < 0:
        tilt_norm = 0.0
    elif tilt_norm > 1:
        tilt_norm = 1.0

    # Gains
    Kp_pole = 2.0 + (7.0 - 2.0) * tilt_norm
    Kd_pole = 0.8 + (4.0 - 0.8) * tilt_norm
    Ki_pole = 0.02 + (0.12 - 0.02) * tilt_norm
    Kp_cart = 0.30
    Kd_cart = 0.45

    dt = 0.02  # time step

    # Integral term with clamping
    _state['pole_int'] += pole_angle * dt
    if _state['pole_int'] < -0.5:
        _state['pole_int'] = -0.5
    elif _state['pole_int'] > 0.5:
        _state['pole_int'] = 0.5

    pole_i = -Ki_pole * _state['pole_int']
    pole_pd = -(Kp_pole * math.sin(pole_angle) + Kd_pole * pole_angular_velocity)
    cart_pd = -(Kp_cart * cart_position + Kd_cart * cart_velocity)
    gravity_ff = 9.81 * math.sin(pole_angle)

    u_raw = pole_pd + gravity_ff + pole_i + cart_pd

    # Saturate force
    if u_raw < -3.0:
        force_raw = -3.0
    elif u_raw > 3.0:
        force_raw = 3.0
    else:
        force_raw = u_raw

    # Deadzone
    if abs(force_raw) < 0.02:
        force = 0.0
    else:
        force = force_raw

    return force if force != 0.0 else force or random.uniform(-3.0, 3.0)
