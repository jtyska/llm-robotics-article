### 4. New rule set (pseudocode)

```text
# -------------------------------------------------
#  CART‑POLE BALANCING CONTROLLER (v2)
# -------------------------------------------------
# INPUT:  x, x_dot, theta, theta_dot   (float)
# OUTPUT: force ∈ [‑3.0 , 3.0]          (float)

IF NOT isfinite(x) OR NOT isfinite(x_dot) OR NOT isfinite(theta) OR NOT isfinite(theta_dot)
THEN
    force = 0.0
ELSE
    # ---- 1) base linear feedback (LQR‑like) ----
    #   coefficients were tuned manually; they are in the same ball‑park
    #   as a classic optimal pole‑balancing controller.
    k1 = 0.8      # cart‑position gain
    k2 = 0.4      # cart‑velocity gain
    k3 = 12.0     # pole‑angle gain
    k4 = 8.0      # pole‑angular‑velocity gain

    u_base = -(k1 * x + k2 * x_dot + k3 * theta + k4 * theta_dot)

    # ---- 2) angle‑dependent gain (stronger when pole leans) ----
    #   - inside a tiny dead‑zone we keep the gain = 1 (or 0)
    #   - from 0.01 rad up to the failure limit 0.20 rad we linearly
    #     increase the gain up to a factor of 6.
    IF abs(theta) < 0.01
        gain = 0.0                     # no action, avoid jitter
    ELSE IF abs(theta) < 0.20
        # linear interpolation: 1 → 6   over 0.01 → 0.20 rad
        gain = 1.0 + 5.0 * (abs(theta) - 0.01) / (0.20 - 0.01)
    ELSE
        gain = 6.0                     # maximum boost (will be clamped later)

    # ---- 3) apply gain and smooth with tanh ----
    u_scaled = gain * u_base
    # tanh gives a smooth saturation before the hard clamp
    u_soft   = 3.0 * tanh(u_scaled / 3.0)

    # ---- 4) final hard clamp to the admissible force range ----
    IF u_soft > 3.0
        force = 3.0
    ELSE IF u_soft < -3.0
        force = -3.0
    ELSE
        force = u_soft
END IF
```

