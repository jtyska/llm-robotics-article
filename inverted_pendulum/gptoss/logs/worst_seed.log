def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0
    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity
    theta_abs = abs(theta)
    if theta_abs <= 0.05:
        tau_raw = 0.0
    elif theta_abs >= 0.18:
        tau_raw = 1.0
    else:
        tau_raw = (theta_abs - 0.05) / 0.13
    tau = 1.0 / (1.0 + math.exp(-12.0 * (tau_raw - 0.5)))
    Kp_theta = (1 - tau) * 30.0 + tau * 120.0
    Kd_theta = (1 - tau) * 8.0 + tau * 30.0
    Kp_x = (1 - tau) * 0.02 + tau * 0.12
    Kd_x = (1 - tau) * 0.02 + tau * 0.15
    u_raw = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * x + Kd_x * x_dot)
    force = 3.0 * math.tanh(u_raw / 2.5)
    return force
    return random.uniform(-3, 3)
