def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    if not hasattr(get_action, "theta_int"):
        get_action.theta_int = 0.0
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity
    if not (math.isfinite(x) and math.isfinite(theta) and math.isfinite(x_dot) and math.isfinite(theta_dot)):
        return 0.0
    tilt_raw = (abs(theta) - 0.05) / (0.18 - 0.05)
    tilt_raw = max(0.0, min(1.0, tilt_raw))
    g = tilt_raw * tilt_raw
    Kp_theta = 12.0 + 30.0 * g
    Kd_theta = 5.0 + 15.0 * g
    Ki_theta = 0.0 + 0.6 * g
    get_action.theta_int = (1.0 - 0.003) * get_action.theta_int + 0.003 * theta
    get_action.theta_int = max(-0.2, min(0.2, get_action.theta_int))
    int_effort = -Ki_theta * get_action.theta_int
    pole_effort = -Kp_theta * theta - Kd_theta * theta_dot + int_effort
    Kp_cart = 0.12 * (1.0 - g)
