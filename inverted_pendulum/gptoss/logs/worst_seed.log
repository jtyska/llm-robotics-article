def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # Check for non‑finite values
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0

    theta = pole_angle
    # Normalised tilt
    if abs(theta) <= 0.05:
        tilt_norm = 0.0
    elif abs(theta) >= 0.18:
        tilt_norm = 1.0
    else:
        tilt_norm = (abs(theta) - 0.05) / (0.18 - 0.05)

    # Gain schedules
    Kp_pole = 2.0 + 6.0 * tilt_norm          # 2 → 8
    Kd_pole = 0.8 + 3.0 * tilt_norm          # 0.8 → 3.8
    Kp_cart = 0.30 + 0.70 * tilt_norm        # 0.30 → 1.0
    Kd_cart = 0.45 + 0.55 * tilt_norm        # 0.45 → 1.0

    # Small integral term (computed from current state only)
    cart_int = 0.01 * cart_position
    if cart_int > 0.5:
        cart_int = 0.5
    elif cart_int < -0.5:
        cart_int = -0.5

    # PD + gravity feed‑forward
    pole_pd = -(Kp_pole * theta + Kd_pole * pole_angular_velocity)
    cart_pd = -(Kp_cart * cart_position + Kd_cart * cart_velocity + cart_int)
    gravity_ff = 9.81 * math.sin(theta)

    u_raw = pole_pd + cart_pd + gravity_ff

    # Smooth saturation
    u_soft = 3.0 * math.tanh(u_raw / 3.0)

    # Dead‑zone
    if abs(u_soft) < 0.01:
        return 0.0
    else:
        return u_soft

    # Default random action (should never be reached)
    return random.uniform(-3, 3)
