import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # Check for non‑finite values
    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    # Failure angle check
    if abs(theta) > 0.20:
        return 0.0

    theta_abs = abs(theta)

    if theta_abs < 0.02:
        s = 0.0
    else:
        s = (theta_abs - 0.02) / (0.20 - 0.02)  # denominator = 0.18

    K_theta   = 1.0 + (20.0 - 1.0) * (s * s)
    K_theta_d = 0.5 + (8.0  - 0.5) * (s * s)

    K_x   = 0.80 * (1.0 - s) + 0.20 * s
    K_x_d = 0.40 * (1.0 - s) + 0.10 * s

    u_angle = -(K_theta * theta + K_theta_d * theta_dot)
    u_grav  = -9.8 * math.sin(theta)
    u_cart  = -(K_x * x + K_x_d * x_dot)

    u_raw = u_angle + u_grav + u_cart
    u_clamped = max(min(u_raw, 3.0), -3.0)

    if abs(u_clamped) < 0.02:
        return 0.0
    else:
        return u_clamped

    # Default random action (should not be reached)
    return random.uniform(-3.0, 3.0)
