import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # check finiteness
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # helper functions
    def clamp(val, lo, hi):
        return max(lo, min(hi, val))

    def sign(val):
        if val > 0:
            return 1.0
        if val < 0:
            return -1.0
        return 0.0

    theta = pole_angle
    theta_dot = pole_angular_velocity
    x = cart_position
    x_dot = cart_velocity

    # large angle failure handling
    if abs(theta) >= 0.20:
        return clamp(-sign(theta) * 3.0, -3.0, 3.0)

    # compute blending factor
    denom = 0.15 - 0.02
    blend_raw = (abs(theta) - 0.02) / denom if denom != 0 else 0.0
    if blend_raw <= 0.0:
        blend = 0.0
    elif blend_raw >= 1.0:
        blend = 1.0
    else:
        blend = blend_raw

    # PID‑like terms
    u_angle = -(45.0 * theta + 12.0 * theta_dot)
    u_pos = -(1.0 * x + 0.8 * x_dot)

    # blend
    raw_force = (1.0 - blend) * u_angle + blend * u_pos

    # dead‑zone
    if abs(raw_force) < 1e-4:
        raw_force = 0.0

    force = clamp(raw_force, -3.0, 3.0)
    return force

    # fallback (should never be reached)
