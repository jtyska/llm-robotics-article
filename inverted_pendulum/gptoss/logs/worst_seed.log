import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Initialize force as None to detect if no rule applies
    force = None

    # Check finiteness
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    else:
        abs_theta = abs(pole_angle)

        if abs_theta <= 0.05:
            tilt_norm = 0.0
        elif abs_theta >= 0.20:
            tilt_norm = 1.0
        else:
            tilt_norm = (abs_theta - 0.05) / (0.20 - 0.05)  # linear 0‑1

        blend = tilt_norm * tilt_norm  # quadratic blend 0‑1

        Kx = 0.30 + (0.90 - 0.30) * blend
        Kx_dot = 0.45 + (1.20 - 0.45) * blend
        Ktheta = 2.0 + (7.0 - 2.0) * blend
        Ktheta_d = 0.8 + (4.0 - 0.8) * blend

        u_raw = -(Kx * cart_position +
                  Kx_dot * cart_velocity +
                  Ktheta * pole_angle +
                  Ktheta_d * pole_angular_velocity)

        u_soft = 3.0 * math.tanh(u_raw / 3.0)  # soft saturation to (‑3, +3)

        if u_soft > 3.0:
            force = 3.0
        elif u_soft < -3.0:
            force = -3.0
        else:
            force = u_soft

        if abs(force) < 0.02:
            force = 0.0

    # Default random action if for some reason force is still None
    if force is None:
        force = random.uniform(-3.0, 3.0)

    return force
