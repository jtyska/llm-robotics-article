def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    def clamp(v, lo, hi):
        return max(lo, min(v, hi))
    # Check for non‑finite values
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0
    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity
    # Small tilt case
    if abs(theta) < 0.05:
        return clamp(-0.30 * x, -3, 3)
    # General case
    tilt_norm = clamp((abs(theta) - 0.05) / (0.18 - 0.05), 0, 1)
    gain = tilt_norm * tilt_norm
    Kp_theta = 8 + (45 - 8) * gain
    Kd_theta = 1 + (10 - 1) * gain
    Kp_x = 0.10 + (0.30 - 0.10) * gain
    Kd_x = 0.05 + (0.20 - 0.05) * gain
    # Persistent integral term for theta
    if not hasattr(get_action, "theta_int"):
        get_action.theta_int = 0.0
    get_action.theta_int = 0.99 * get_action.theta_int + 0.01 * theta
    u = -(Kp_theta * theta + Kd_theta * theta_dot + 0.5 * get_action.theta_int +
          Kp_x * x + Kd_x * x_dot)
    force_raw = math.tanh(u / 3.0) * 3.0
    force = clamp(force_raw, -3, 3)
    return force
    # Fallback random action (should not be reached)
    return random.uniform(-3, 3)
