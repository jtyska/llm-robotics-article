import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    force = None

    if not (math.isfinite(x) and math.isfinite(theta) and math.isfinite(x_dot) and math.isfinite(theta_dot)):
        force = 0.0
    elif abs(theta) >= 0.18:
        if theta > 0:
            sign = 1.0
        elif theta < 0:
            sign = -1.0
        else:
            sign = 0.0
        force = -3.0 * sign
    else:
        base_angle = -(13.0 * theta + 2.5 * theta_dot)
        scale = 1.0 + 2.0 * (abs(theta) - 0.02) / (0.18 - 0.02)
        if scale < 1.0:
            scale = 1.0
        if scale > 3.0:
            scale = 3.0
        angle_term = scale * base_angle
        pos_term = -(0.9 * x + 0.6 * x_dot) * 0.2
        raw_force = angle_term + pos_term
        if raw_force > 3.0:
            force = 3.0
        elif raw_force < -3.0:
            force = -3.0
        else:
            force = raw_force
        if abs(force) < 0.01:
            force = 0.0

    if force is None:
        force = random.uniform(-3.0, 3.0)

    return force
