import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # check finiteness
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity

    # helper clamp
    def clamp(v, lo, hi):
        return max(lo, min(v, hi))

    tilt_raw = clamp((abs(theta) - 0.05) / (0.20 - 0.05), 0.0, 1.0)

    Kp_theta = 8.0 + 8.0 * tilt_raw
    Kd_theta = 3.0 + 3.0 * tilt_raw
    Kp_cart  = 0.10 + 0.10 * tilt_raw
    Kd_cart  = 0.02 + 0.02 * tilt_raw

    ff_gain  = 0.0 + 0.3 * tilt_raw

    sign_theta = 1.0 if theta > 0 else (-1.0 if theta < 0 else 0.0)

    force_raw = (-Kp_theta * theta
                 - Kd_theta * theta_dot
                 - Kp_cart  * x
                 - Kd_cart  * x_dot
                 + ff_gain * sign_theta)

    force_soft = 3.0 * math.tanh(force_raw / 3.0)

    action = clamp(force_soft, -3.0, 3.0)
    return action

# fallback (not reached in current logic, but kept as per specification)
# return random.uniform(-3, 3) would be used if no rule applied.
