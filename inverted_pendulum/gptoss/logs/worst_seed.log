import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    if abs(theta) < 0.04:
        return 0.0

    Kp_theta = 30.0
    Kd_theta = 5.0
    Kp_x = 0.5
    Kd_x = 0.1

    if abs(theta) > 0.15:
        scale = max(0.0, (0.20 - abs(theta)) / (0.20 - 0.15))
        Kp_theta *= scale
        Kd_theta *= scale

    u = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * x + Kd_x * x_dot)
    force = max(-3.0, min(3.0, u))
    return force

    # fallback random action (should never be reached)
    return random.uniform(-3.0, 3.0)
