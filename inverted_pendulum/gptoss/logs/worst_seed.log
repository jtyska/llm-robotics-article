def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    force = None
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    elif abs(pole_angle) >= 0.19:
        force = -3.0 * (1 if pole_angle > 0 else -1)
    else:
        raw = -(0.5 * cart_position + 0.1 * cart_velocity + 12.0 * pole_angle + 5.0 * pole_angular_velocity)
        if raw > 3.0:
            force = 3.0
        elif raw < -3.0:
            force = -3.0
        else:
            force = raw
    if force is None:
        force = random.uniform(-3, 3)
    return force
