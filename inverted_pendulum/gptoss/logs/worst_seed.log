import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    force = None

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        force = 0.0
    elif abs(theta) >= 0.20:
        force = -3.0 * (1 if theta > 0 else -1)
    else:
        if abs(theta) <= 0.02:
            gain_theta = 1.0
            gain_cart = 1.0
            gain_theta_dot = 1.0
        else:
            scale = (abs(theta) - 0.02) / (0.18 - 0.02)
            gain_theta = 1.0 + 2.0 * scale
            gain_cart = 1.0 - 0.8 * scale
            gain_theta_dot = 1.0 + 0.5 * scale

        pole_term = gain_theta * (10.0 * theta) + gain_theta_dot * (2.5 * theta_dot)
        cart_term = gain_cart * (1.0 * x + 0.5 * x_dot)

        if abs(theta) <= 0.02:
            cart_term += 0.1 * x

        raw_force = -(pole_term + cart_term)
        force = max(-3.0, min(3.0, raw_force))

    if force is None:
        return random.uniform(-3, 3)
    return force
