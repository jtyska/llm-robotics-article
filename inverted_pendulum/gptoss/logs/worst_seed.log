[2025-08-28 16:38:12] [INFO] ############## LLM Overall strategy code 
def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    dt = 0.02
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    theta = pole_angle
    theta_dot = pole_angular_velocity
    x = cart_position
    x_dot = cart_velocity
    theta_abs = abs(theta)
    if theta_abs <= 0.05:
        tilt_norm = 0.0
    elif theta_abs >= 0.20:
        tilt_norm = 1.0
    else:
        tilt_norm = (theta_abs - 0.05) / 0.15
    Kp_theta = (1 - tilt_norm) * 6.0 + tilt_norm * 15.0
    Kd_theta = (1 - tilt_norm) * 12.0 + tilt_norm * 4.0
    Kp_x = (1 - tilt_norm) * 0.08 + tilt_norm * 0.25
    Kd_x = (1 - tilt_norm) * 0.08 + tilt_norm * 0.30
    if not hasattr(get_action, "int_theta"):
        get_action.int_theta = 0.0
    get_action.int_theta += theta * dt
    force = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * x + Kd_x * x_dot)
    if force < -3.0:
        force = -3.0
    elif force > 3.0:
        force = 3.0
    return force
    return random.uniform(-3, 3)
