    cart_effort = -Kp_cart * x - Kd_cart * x_dot
    centre_bias = -0.07 * tilt_raw * x
    force_raw = pole_effort + cart_effort + centre_bias
    if force_raw > 3.0:
        force = 3.0
    elif force_raw < -3.0:
        force = -3.0
    else:
        force = force_raw
    return force
    return random.uniform(-3, 3)
