# -------------------------------------------------
#  CART‑POLE BALANCING CONTROLLER (continuous force)
# -------------------------------------------------
# Input:  x, x_dot, theta, theta_dot   (float)
# Output: force ∈ [‑3.0 , +3.0]        (float)

IF NOT ( isfinite(x) AND isfinite(x_dot) AND isfinite(theta) AND isfinite(theta_dot) ) THEN
    force ← 0.0

ELSE IF abs(theta) ≥ 0.12 THEN                     # early hard‑stop
    force ← -3.0 * sign(theta)

