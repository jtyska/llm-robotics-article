import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # Check for non‑finite values
    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    # Failure angle bounds
    if theta <= -0.20 or theta >= 0.20:
        return 0.0

    # Compute normalized tilt
    if abs(theta) <= 0.04:
        tilt = 0.0
    else:
        tilt_raw = (abs(theta) - 0.04) / (0.20 - 0.04)
        tilt = max(0.0, min(tilt_raw, 1.0))

    # Gain schedule
    tilt_sq = tilt * tilt
    Kp_pole = 4.0 + 28.0 * tilt_sq
    Kd_pole = 1.0 + 6.0 * tilt_sq
    Kp_cart = 0.08 + 0.32 * tilt_sq
    Kd_cart = 0.02 + 0.08 * tilt_sq

    # PD terms
    pole_pd = -Kp_pole * theta - Kd_pole * theta_dot
    cart_pd = -Kp_cart * x - Kd_cart * x_dot

    # Feed‑forward on pole angular velocity
    ff_gain = 0.6 * tilt
    if theta_dot > 0:
        feed_fwd = -ff_gain
    elif theta_dot < 0:
        feed_fwd = ff_gain
    else:
        feed_fwd = 0.0

    # Combine and clamp
    raw_force = pole_pd + cart_pd + feed_fwd
    if raw_force > 3.0:
        force = 3.0
    elif raw_force < -3.0:
        force = -3.0
    else:
        force = raw_force

    return force

    # Default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
