def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    abs_theta = abs(theta)
    if abs_theta <= 0.05:
        tilt_norm = 0.0
    elif abs_theta >= 0.20:
        tilt_norm = 1.0
    else:
        tilt_norm = (abs_theta - 0.05) / (0.20 - 0.05)

    Kp_theta = (1 - tilt_norm) * 8.0 + tilt_norm * 25.0
    Kd_theta = (1 - tilt_norm) * 4.0 + tilt_norm * 12.0
    Kp_x = (1 - tilt_norm) * 0.2 + tilt_norm * 0.8
    Kd_x = (1 - tilt_norm) * 0.2 + tilt_norm * 0.6

    u_pd = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * x + Kd_x * x_dot)
    u_grav = 9.81 * math.sin(theta)
    u_raw = u_pd + u_grav

    if abs_theta > 0.12:
        boost_factor = (abs_theta - 0.12) / (0.20 - 0.12)
        u_raw *= (1 + boost_factor)

    if u_raw < -3.0:
        u_raw = -3.0
    elif u_raw > 3.0:
        u_raw = 3.0

    return u_raw

