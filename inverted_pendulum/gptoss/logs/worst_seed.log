def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    action = None
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        action = 0.0
    elif abs(pole_angle) >= 0.18:
        sign = 1.0 if pole_angle > 0 else -1.0
        action = -sign * 3.0
    else:
        raw = -(1.0 * cart_position + 1.0 * cart_velocity +
                10.0 * pole_angle + 2.5 * pole_angular_velocity)
        if (abs(pole_angle) < 0.01 and abs(cart_position) < 0.02 and
                abs(cart_velocity) < 0.02):
            raw = 0.0
        action = max(-3.0, min(3.0, raw))
    if action is None:
        action = random.uniform(-3.0, 3.0)
