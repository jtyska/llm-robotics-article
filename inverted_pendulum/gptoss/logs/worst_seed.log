[2025-08-28 16:31:09] [INFO] ############## LLM Overall strategy code 
import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # check finiteness
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    theta = pole_angle
    theta_dot = pole_angular_velocity
    x = cart_position
    x_dot = cart_velocity

    # tilt_norm
    abs_theta = abs(theta)
    if abs_theta <= 0.05:
        tilt_norm = 0.0
    elif abs_theta >= 0.22:
        tilt_norm = 1.0
    else:
        tilt_norm = (abs_theta - 0.05) / (0.22 - 0.05)

    # gain‑scheduling
    Kp_theta = (1 - tilt_norm) * 8.0 + tilt_norm * 35.0
    Kd_theta = (1 - tilt_norm) * 4.0 + tilt_norm * 18.0
    Kp_x = (1 - tilt_norm) * 0.2 + tilt_norm * 0.9
    Kd_x = (1 - tilt_norm) * 0.2 + tilt_norm * 0.7

    # gravity compensation
    u_grav = 9.81 * math.sin(theta)

    # PD control
    u_pd = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * x + Kd_x * x_dot)

    # raw command
    u_raw = u_pd + u_grav

    # smooth saturation
    force_raw = 3.0 * math.tanh(u_raw / 1.5)

    # dead‑zone
    if abs(force_raw) < 0.2:
        return 0.0

    # hard clipping
    if force_raw > 3.0:
        return 3.0
    elif force_raw < -3.0:
        return -3.0
    else:
        return force_raw

    # default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
