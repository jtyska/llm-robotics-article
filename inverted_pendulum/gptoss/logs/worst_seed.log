import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    tilt_raw = (abs(pole_angle) - 0.05) / (0.18 - 0.05)
    if tilt_raw < 0.0:
        tilt_raw = 0.0
    elif tilt_raw > 1.0:
        tilt_raw = 1.0
    Kp_theta = 10.0 + (18.0 - 10.0) * tilt_raw
    Kd_theta = 4.0 + (8.0 - 4.0) * tilt_raw
    Kp_cart = 0.12 + (0.22 - 0.12) * tilt_raw
    Kd_cart = 0.025 + (0.045 - 0.025) * tilt_raw
    Kp_center = 0.07 * tilt_raw
    ff_gain = 0.5 + (1.2 - 0.5) * tilt_raw
    pole_effort = -Kp_theta * pole_angle - Kd_theta * pole_angular_velocity
    cart_effort = -Kp_cart * cart_position - Kd_cart * cart_velocity
    centre_effort = -Kp_center * cart_position
    sign_theta = math.copysign(1.0, pole_angle) if pole_angle != 0 else 0.0
    ff_effort = -ff_gain * sign_theta * 3.0
    force_raw = pole_effort + cart_effort + centre_effort + ff_effort
    if force_raw > 3.0:
        force = 3.0
    elif force_raw < -3.0:
        force = -3.0
    else:
        force = force_raw
    return force
    return random.uniform(-3, 3)
