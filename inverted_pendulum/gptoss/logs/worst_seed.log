def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # Check for finite values
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0

    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity

    # Normalised tilt (linear)
    abs_theta = abs(theta)
    if abs_theta <= 0.05:
        tilt_norm = 0.0
    elif abs_theta >= 0.18:
        tilt_norm = 1.0
    else:
        tilt_norm = (abs_theta - 0.05) / (0.18 - 0.05)

    # Gain scheduling
    Kp_theta = 4.0 + (14.0 - 4.0) * tilt_norm
    Kd_theta = 2.0 + (7.0 - 2.0) * tilt_norm

    # Pole PD + gravity feed‑forward
    pole_pd = -(Kp_theta * math.sin(theta) + Kd_theta * theta_dot)
    gravity_ff = 0.60 * 9.81 * math.sin(theta)

    # Cart PD (always active)
    cart_pd = -(0.02 * x + 0.03 * x_dot)

    # Small centre‑bias (only when pole is almost upright)
    if abs_theta < 0.07:
        centre_bias = -0.08 * x
    else:
        centre_bias = 0.0

    # Raw command
    raw_force = pole_pd + gravity_ff + cart_pd + centre_bias

    # Smooth saturation (tanh)
    force_raw = 3.0 * math.tanh(0.60 * raw_force)

    # Final clipping
    if force_raw > 3.0:
        force = 3.0
    elif force_raw < -3.0:
        force = -3.0
    else:
        force = force_raw

    return force
    # Default random action (fallback)
    return random.uniform(-3.0, 3.0)
