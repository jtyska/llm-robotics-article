def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    force = None
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    elif abs(pole_angle) <= 0.02:
        raw = -(1.0 * cart_position + 0.5 * cart_velocity)
        if raw > 3.0:
            force = 3.0
        elif raw < -3.0:
            force = -3.0
        else:
            force = raw
    else:
        theta_abs = abs(pole_angle)
        alpha = (theta_abs - 0.02) / (0.18 - 0.02)
        if alpha < 0.0:
            alpha = 0.0
        elif alpha > 1.0:
            alpha = 1.0
        k_theta = 8.0 + alpha * (20.0 - 8.0)
        k_thetad = 2.0 + alpha * (6.0 - 2.0)
        pole_pd = -(k_theta * pole_angle + k_thetad * pole_angular_velocity)
        cart_pd = -(1.0 * cart_position + 0.5 * cart_velocity)
        raw = pole_pd + cart_pd
        if raw > 3.0:
            force = 3.0
        elif raw < -3.0:
            force = -3.0
        else:
            force = raw
    if force is None:
        return random.uniform(-3, 3)
    return force
