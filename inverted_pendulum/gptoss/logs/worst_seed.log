import math
import random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0
    elif abs(theta) >= 0.18:
        sign = 1 if theta > 0 else -1 if theta < 0 else 0
        raw = -3.0 * sign
        return max(min(raw, 3.0), -3.0)
    elif abs(theta) <= 0.02:
        g = 1.0
        raw = -(0.5 * x + 0.1 * x_dot + g * (8.0 * theta + 2.5 * theta_dot))
        return max(min(raw, 3.0), -3.0)
    else:
        g = 1.0 + (abs(theta) - 0.02) / (0.18 - 0.02)
        raw = -(0.5 * x + 0.1 * x_dot + g * (8.0 * theta + 2.5 * theta_dot))
        return max(min(raw, 3.0), -3.0)
    # fallback (should not be reached)
    return random.uniform(-3.0, 3.0)
