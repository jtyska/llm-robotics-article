import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non‑finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Base control term
    base = -(0.8 * cart_position + 0.4 * cart_velocity)

    # Small angle case
    if abs(pole_angle) < 0.02:
        action = base
    else:
        # Scale factor for larger angles
        scale = 1.0 + (abs(pole_angle) - 0.02) / (0.20 - 0.02)
        action = base * scale

    # Clamp to allowed force range
    action = max(-3.0, min(3.0, action))

    # Fallback random action (should not be reached)
    if action is None:
        return random.uniform(-3.0, 3.0)

    return action
