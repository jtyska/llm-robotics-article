import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    def is_finite(v):
        return math.isfinite(v)

    def clamp(val, lo, hi):
        return max(lo, min(hi, val))

    def sign(v):
        return 1.0 if v > 0 else -1.0 if v < 0 else 0.0

    if (not is_finite(x) or not is_finite(theta) or
        not is_finite(x_dot) or not is_finite(theta_dot)):
        return 0.0

    if abs(theta) >= 0.18:
        force = clamp(-sign(theta) * 3.0, -3.0, 3.0)
        return force

    if abs(theta) <= 0.02:
        u_cart = -(0.55 * x + 0.12 * x_dot)
        force = clamp(u_cart, -3.0, 3.0)
        return force

    # intermediate region
    u_angle = -(12.0 * theta + 7.0 * theta_dot)
    u_cart_vel = -(0.20 * x_dot)
    raw = u_angle + u_cart_vel

    frac = (abs(theta) - 0.02) / (0.18 - 0.02)
    scale = 1.0 + (frac ** 1.2)
    if scale > 2.0:
        scale = 2.0
    if scale < 1.0:
        scale = 1.0

    force = clamp(scale * raw, -3.0, 3.0)
    return force

    # fallback (should not be reached)
    return random.uniform(-3.0, 3.0)
