import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Helper functions
    def is_finite(v):
        return math.isfinite(v)
    def sign(v):
        return 1.0 if v > 0 else -1.0 if v < 0 else 0.0
    def clamp(v, lo, hi):
        return max(lo, min(v, hi))

    # Unpack for readability
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # Rule 1: non‑finite inputs
    if not (is_finite(x) and is_finite(theta) and is_finite(x_dot) and is_finite(theta_dot)):
        return 0.0

    # Rule 2: angle beyond limit
    if abs(theta) >= 0.20:
        return clamp(-sign(theta) * 3.0, -3.0, 3.0)

    # Rule 3: main controller
    K_theta = 22.0
    K_thdot = 10.0
    K_x = 0.8
    K_xdot = 0.4

    u_angle = -(K_theta * theta + K_thdot * theta_dot)
    u_cart = -(K_x * x + K_xdot * x_dot)

    if abs(theta) <= 0.02:
        cart_factor = 1.0
    elif abs(theta) < 0.08:
        cart_factor = 1.0 - (abs(theta) - 0.02) / (0.08 - 0.02)
    else:
        cart_factor = 0.0

    scale = 1.0 + (abs(theta) - 0.02) * (2.0 - 1.0) / (0.20 - 0.02)
    if scale > 2.0:
        scale = 2.0

    raw_force = scale * (u_angle + cart_factor * u_cart)
    force = clamp(raw_force, -3.0, 3.0)
    return force

    # Default fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
