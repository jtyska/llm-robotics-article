import random, math

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(theta) and math.isfinite(x_dot) and math.isfinite(theta_dot)):
        return 0.0

    if abs(theta) >= 0.18:
        sign = 1.0 if theta > 0 else -1.0 if theta < 0 else 0.0
        force_raw = -3.0 * sign - 0.5 * theta
        return max(-3.0, min(3.0, force_raw))

    if abs(theta) <= 0.02:
        raw = -(1.0 * x + 0.5 * x_dot)
        return max(-3.0, min(3.0, raw))

    # intermediate case
    scale = 1.0 + (abs(theta) - 0.02) / (0.18 - 0.02) * 2.0
    base = -(1.0 * x + 0.5 * x_dot)
    pole_term = -(8.0 * theta + 4.0 * theta_dot)
    raw = scale * (base + pole_term)
    return max(-3.0, min(3.0, raw))

    # fallback (should never reach here)
    return random.uniform(-3.0, 3.0)
