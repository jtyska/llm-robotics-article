def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    abs_theta = abs(theta)
    if abs_theta <= 0.05:
        t = 0.0
    elif abs_theta >= 0.20:
        t = 1.0
    else:
        t = (abs_theta - 0.05) / (0.20 - 0.05)

    Kp_theta = 10.0 + 190.0 * (t * t)
    Kd_theta = 1.0 + 49.0 * (t * t)
    Kp_x = 0.10 + 0.90 * t
    Kd_x = 0.05 + 0.45 * t

    ff_grav = 0.48 * math.sin(theta)

    u = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * x + Kd_x * x_dot + ff_grav)

    Fmax = 0.4 + 2.6 * t
    if Fmax > 3.0:
        Fmax = 3.0

    force_raw = math.tanh(u / Fmax) * Fmax

    if force_raw > 3.0:
        force = 3.0
    elif force_raw < -3.0:
        force = -3.0
    else:
        force = force_raw

    return force
    return random.uniform(-3, 3)
