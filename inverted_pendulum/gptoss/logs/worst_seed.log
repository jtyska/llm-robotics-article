import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0
    if abs(pole_angle) < 0.05:
        u_raw = -(12.0 * pole_angle + 2.5 * pole_angular_velocity + 0.15 * cart_position + 0.30 * cart_velocity) + 9.81 * math.sin(pole_angle)
        return 3.0 * math.tanh(u_raw / 2.0)
    else:
        u_raw = -(12.0 * pole_angle + 2.5 * pole_angular_velocity) + 9.81 * math.sin(pole_angle)
        return 3.0 * math.tanh(u_raw / 2.0)
    return random.uniform(-3, 3)
