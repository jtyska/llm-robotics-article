def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity
    force = None
    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        force = 0.0
    else:
        abs_theta = abs(theta)
        if abs_theta <= 0.05:
            tilt_norm = 0.0
        elif abs_theta >= 0.18:
            tilt_norm = 1.0
        else:
            tilt_norm = (abs_theta - 0.05) / (0.18 - 0.05)
        gain = tilt_norm * tilt_norm
        Kp_theta = 4.0 + (14.0 - 4.0) * gain
        Kd_theta = 2.0 + (7.0 - 2.0) * gain
        pole_pd = -(Kp_theta * math.sin(theta) + Kd_theta * theta_dot)
        gravity_ff = 0.60 * 9.81 * math.sin(theta)
        cart_pd = -(0.02 * x + 0.03 * x_dot)
        centre_bias = -0.08 * x if abs_theta < 0.07 else 0.0
        raw_force = pole_pd + gravity_ff + cart_pd + centre_bias
        force_raw = 3.0 * math.tanh(0.60 * raw_force)
        if force_raw > 3.0:
            force = 3.0
        elif force_raw < -3.0:
            force = -3.0
        else:
            force = force_raw
    if force is None:
        return random.uniform(-3, 3)
    return force
