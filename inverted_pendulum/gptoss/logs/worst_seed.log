import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    force = None
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    else:
        abs_theta = abs(pole_angle)
        if abs_theta <= 0.05:
            tilt_norm = 0.0
        elif abs_theta >= 0.30:
            tilt_norm = 1.0
        else:
            tilt_norm = (abs_theta - 0.05) / (0.30 - 0.05)

        Kp_theta = 10.0 + 20.0 * tilt_norm
        Kd_theta = 8.0 + 12.0 * tilt_norm
        Kp_x = 0.5 + 1.5 * tilt_norm
        Kd_x = 0.5 + 1.0 * tilt_norm

        u_raw = -(Kp_theta * pole_angle
                  + Kd_theta * pole_angular_velocity
                  + Kp_x * cart_position
                  + Kd_x * cart_velocity) + 9.81 * math.sin(pole_angle)

        force = 3.0 * math.tanh(u_raw / 1.0)

        if force > 3.0:
            force = 3.0
        elif force < -3.0:
            force = -3.0

    if force is None:
        return random.uniform(-3, 3)
    return force
