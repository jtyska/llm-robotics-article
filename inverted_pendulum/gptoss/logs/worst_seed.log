import random, math

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non-finite inputs
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Compute normalized tilt
    abs_theta = abs(pole_angle)
    tilt_norm = (abs_theta - 0.05) / (0.20 - 0.05)
    tilt_norm = max(0.0, min(tilt_norm, 1.0))

    # Gains for cart
    Kp_cart = 0.30 + 1.5 * tilt_norm
    Kd_cart = 0.45 + 2.5 * tilt_norm

    # Gains for pole
    Kp_pole = 2.00 + 22.0 * tilt_norm
    Kd_pole = 0.80 + 11.0 * tilt_norm

    # PD terms
    pole_pd = -(Kp_pole * pole_angle + Kd_pole * pole_angular_velocity)
    cart_pd = -(Kp_cart * cart_position + Kd_cart * cart_velocity)

    # Gravity feed‑forward
    gravity_ff = 9.81 * math.sin(pole_angle)

    # Raw control signal
    u_raw = pole_pd + cart_pd + gravity_ff

    # Soft saturation
    u_soft = 3.0 * math.tanh(u_raw / 3.0)

    # Deadzone
    if abs(u_soft) < 0.02:
        force = 0.0
    else:
        force = u_soft  # already within [-3, 3]

    # Return computed force (fallback random if somehow undefined)
    return force if force is not None else random.uniform(-3, 3)
