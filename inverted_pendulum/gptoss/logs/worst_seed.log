def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity, _state={'theta_int': 0.0}):
    import math, random

    force = None

    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    else:
        theta_abs = abs(pole_angle)
        tilt_norm = (theta_abs - 0.05) / (0.18 - 0.05)
        if tilt_norm < 0.0:
            tilt_norm = 0.0
        elif tilt_norm > 1.0:
            tilt_norm = 1.0

        Kp_theta = 4.0 + 3.0 * tilt_norm
        Kd_theta = 2.5 + 2.0 * tilt_norm

        pole_effort = -(Kp_theta * math.sin(pole_angle) + Kd_theta * pole_angular_velocity)

        if theta_abs < 0.02:
            _state['theta_int'] += pole_angle * 0.02
            if _state['theta_int'] < -0.1:
                _state['theta_int'] = -0.1
            elif _state['theta_int'] > 0.1:
                _state['theta_int'] = 0.1
        else:
            _state['theta_int'] = 0.0

        int_effort = -0.5 * _state['theta_int']
        centre_bias = -0.12 * cart_position
        vel_damp = -0.04 * cart_velocity

        raw_force = pole_effort + int_effort + centre_bias + vel_damp
        force = 3.0 * math.tanh(0.45 * raw_force)

        if force < -3.0:
            force = -3.0
        elif force > 3.0:
            force = 3.0

    if force is None:
        return random.uniform(-3, 3)
    return force
