```text
# -------------------------------------------------
#  CART‑POLE BALANCING CONTROLLER (continuous force)
# -------------------------------------------------
# Input: state = (x, theta, x_dot, theta_dot)   # all floats
# Output: force ∈ [‑3.0, +3.0]  (N)

IF any component of state is not finite:
    force = 0.0
ELSE:
    # 1️⃣  Safety band – if we are already out of bounds we cannot recover
    IF abs(theta) >= 0.20:
        force = 0.0                     # episode will end anyway
    ELSE:
        # 2️⃣  Gain schedule – linear from 1.0 (near‑vertical) to 5.0 (near failure)
        #    scale = 1 + 4 * (|θ|‑0.02) / (0.20‑0.02)
        #    (clamped to [1, 5] for numerical safety)
        scale = 1.0 + 4.0 * (abs(theta) - 0.02) / 0.18
        IF scale < 1.0:   scale = 1.0
        IF scale > 5.0:   scale = 5.0

        # 3️⃣  Core LQR‑like law (dominant angle term)
        #    K_theta = 12.0, K_theta_dot = 5.0
        u_angle = -scale * (12.0 * theta + 5.0 * theta_dot)

