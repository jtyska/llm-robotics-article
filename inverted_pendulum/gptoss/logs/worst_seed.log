import random, math

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Helper functions
    def clamp(v, lo, hi):
        return max(lo, min(hi, v))
    def sign(v):
        return 1 if v > 0 else -1 if v < 0 else 0
    def deadzone(v, dz):
        return 0.0 if abs(v) < dz else v
    def smoothstep(t):
        return t * t * (3 - 2 * t)
    # Gains and constants
    Kθ = 16.0
    Kθdot = 10.0
    Kx = 1.0
    Kxdot = 0.8
    MAX_FORCE = 3.0
    MIN_FORCE = -3.0
    DEAD_ZONE = 0.02

    # Finite check
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        force = 0.0
        return force

    theta = pole_angle
    x = cart_position
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if abs(theta) >= 0.18:
        force = clamp(-sign(theta) * MAX_FORCE, MIN_FORCE, MAX_FORCE)
        return force
    elif abs(theta) <= 0.02:
        raw = -(Kx * x + Kxdot * x_dot)
        raw = deadzone(raw, DEAD_ZONE)
        force = clamp(raw, MIN_FORCE, MAX_FORCE)
        return force
    else:
        # Angle‑dominant region
        u_angle = -(Kθ * theta + Kθdot * theta_dot)
        t = (abs(theta) - 0.02) / (0.18 - 0.02)
        t = clamp(t, 0.0, 1.0)
        scale = 1.0 + 1.2 * smoothstep(t)
        cart_bias = 0.30 * (-(Kx * x + Kxdot * x_dot))
        raw = scale * u_angle + cart_bias
        raw = deadzone(raw, DEAD_ZONE)
        force = clamp(raw, MIN_FORCE, MAX_FORCE)
        return force

    # Fallback random action (should not be reached)
    return random.uniform(-3.0, 3.0)
