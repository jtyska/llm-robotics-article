import random, math

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Constants
    Kx = 0.4
    Kx_dot = 0.6
    Kθ_base = 20.0
    Kθ_dot_base = 5.0
    Kθ_max = 70.0
    Kθ_dot_max = 13.0
    θ_low = 0.02
    θ_high = 0.18
    F_MAX = 3.0
    F_MIN = -3.0

    def clamp(val, lo, hi):
        return max(lo, min(hi, val))

    # Finite check
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0

    theta = pole_angle
    theta_dot = pole_angular_velocity
    x = cart_position
    x_dot = cart_velocity

    # Large angle case
    if abs(theta) >= θ_high:
        force = clamp(-math.copysign(F_MAX, theta), F_MIN, F_MAX)
        return force

    # Small angle case
    if abs(theta) <= θ_low:
        u_cart = -(Kx * x + Kx_dot * x_dot)
        force = clamp(u_cart, F_MIN, F_MAX)
        return force

    # Intermediate angle case
    α = (abs(theta) - θ_low) / (θ_high - θ_low)  # 0 … 1
    Kθ = Kθ_base + α * (Kθ_max - Kθ_base)
    Kθ_dot = Kθ_dot_base + α * (Kθ_dot_max - Kθ_dot_base)

    u_angle = -(Kθ * theta + Kθ_dot * theta_dot)
    u_cart = -(Kx * x + Kx_dot * x_dot) * (1.0 - α)  # fade cart term

    raw_force = u_angle + u_cart
    force = clamp(raw_force, F_MIN, F_MAX)
    return force

    # Fallback random action (should never be reached)
    return random.uniform(-3.0, 3.0)
