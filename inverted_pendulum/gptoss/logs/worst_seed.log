    if abs(theta) <= 0.02:
        bias = -(1.0 * x + 0.5 * x_dot)
    else:
        bias = 0.0

    raw = -(1.2 * x + 0.8 * x_dot + 30.0 * theta + 8.0 * theta_dot) + bias

    if raw > 3.0:
        return 3.0
    if raw < -3.0:
        return -3.0
    return raw

    # Default random action (should not be reached)
