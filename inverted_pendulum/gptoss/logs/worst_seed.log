def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # Finite check
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0

    abs_theta = abs(pole_angle)
    if abs_theta <= 0.05:
        tilt_norm = 0.0
    elif abs_theta >= 0.18:
        tilt_norm = 1.0
    else:
        tilt_norm = (abs_theta - 0.05) / (0.18 - 0.05)

    Kp_theta = 8.0 + 22.0 * tilt_norm
    Kd_theta = 2.0 + 8.0 * tilt_norm
    Kp_x = 0.3 + 1.7 * tilt_norm
    Kd_x = 0.4 + 1.6 * tilt_norm

    # Integral terms (persist across calls)
    get_action.cart_int = getattr(get_action, "cart_int", 0.0) + 0.01 * cart_position
    get_action.cart_int = max(min(get_action.cart_int, 0.5), -0.5)

    get_action.pole_int = getattr(get_action, "pole_int", 0.0) + 0.001 * pole_angle
    get_action.pole_int = max(min(get_action.pole_int, 0.2), -0.2)

    gravity_ff = 9.81 * math.sin(pole_angle)

    u_raw = -(Kp_theta * pole_angle + Kd_theta * pole_angular_velocity + get_action.pole_int)

    # Clip to action bounds
    action = max(min(u_raw, 3.0), -3.0)

    if not math.isfinite(action):
        return random.uniform(-3, 3)
    return action
