import random, math

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    if abs(theta) <= 0.02:
        raw = -(1.0 * x + 0.5 * x_dot)
        force = max(min(raw, 3.0), -3.0)
        return force

    if True:  # fallback to the general case
        angle_factor = 1.0 + 2.0 * (abs(theta) - 0.02) / (0.18 - 0.02)
        ktheta = 8.0 * angle_factor
        ktheta_dot = 2.0 * angle_factor
        raw = -(1.0 * x + 0.5 * x_dot + ktheta * theta + ktheta_dot * theta_dot)
        force = max(min(raw, 3.0), -3.0)
        return force

    # default random action if no rule matched
    return random.uniform(-3.0, 3.0)
