def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non‑finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Large angle correction
    if abs(pole_angle) >= 0.18:
        if pole_angle > 0:
            return -3.0
        elif pole_angle < 0:
            return 3.0
        else:
            return 0.0

    # Blended controller
    u_angle = -(12.0 * pole_angle + 3.0 * pole_angular_velocity)
    u_cart = -(0.9 * cart_position + 0.3 * cart_velocity)

    blend = (abs(pole_angle) - 0.02) / (0.18 - 0.02)
    if blend < 0:
        blend = 0.0
    if blend > 1:
        blend = 1.0

    raw_force = (1.0 - blend) * u_cart + blend * u_angle

    scale = 1.0 + (abs(pole_angle) - 0.02) / (0.18 - 0.02)
    if scale < 1.0:
        scale = 1.0
    if scale > 3.0:
        scale = 3.0

    raw_force = scale * raw_force

    if raw_force > 3.0:
        force = 3.0
    elif raw_force < -3.0:
        force = -3.0
    else:
        force = raw_force

    return force

    # Default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
