[2025-08-28 16:18:32] [INFO] ############## LLM Overall strategy code 
def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    abs_theta = abs(theta)
    if abs_theta <= 0.05:
        tilt_norm = 0.0
    elif abs_theta >= 0.18:
        tilt_norm = 1.0
    else:
        tilt_norm = (abs_theta - 0.05) / (0.18 - 0.05)

    Kp_theta = 8.0 + 22.0 * tilt_norm
    Kd_theta = 2.0 + 8.0 * tilt_norm
    Kp_x = 0.3 + 1.7 * tilt_norm
    Kd_x = 0.4 + 1.6 * tilt_norm

    u_raw = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * x + Kd_x * x_dot)
    u_raw += 9.81 * math.sin(theta)

    u_soft = 3.0 * math.tanh(u_raw / 3.0)

    if abs(u_soft) < 0.01:
        return 0.0
    return u_soft

    return random.uniform(-3, 3)
