def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0
    tilt_raw = (abs(pole_angle) - 0.05) / 0.15
    if tilt_raw < 0.0:
        tilt_raw = 0.0
    elif tilt_raw > 1.0:
        tilt_raw = 1.0
    Kp_theta = 30.0 + 30.0 * tilt_raw
    Kd_theta = 2.0 + 3.0 * tilt_raw
    if tilt_raw < 0.2:
        cart_center = -(0.003 * cart_position + 0.001 * cart_velocity)
    else:
        cart_center = 0.0
    u = -(Kp_theta * pole_angle + Kd_theta * pole_angular_velocity) + cart_center
    if u < -3.0:
        force = -3.0
    elif u > 3.0:
        force = 3.0
    else:
        force = u
    return force
    return random.uniform(-3.0, 3.0)
