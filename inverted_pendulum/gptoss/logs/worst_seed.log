def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    if not hasattr(get_action, "int_theta"):
        get_action.int_theta = 0.0
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity
    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0
    if abs(theta) > 0.15:
        tilt_norm = min((abs(theta) - 0.15) / 0.05, 1.0)
    else:
        tilt_norm = 0.0
    gain_factor = 1.0 + 0.2 * tilt_norm
    Kp_theta = 10.0 * gain_factor
    Kd_theta = 5.0 * gain_factor
    Kp_x = 0.08 * gain_factor
    Kd_x = 0.08 * gain_factor
    get_action.int_theta = (1 - 0.001) * get_action.int_theta + 0.001 * theta
    u_raw = -(Kp_theta * theta + Kd_theta * theta_dot + 0.05 * get_action.int_theta + Kp_x * x + Kd_x * x_dot)
    force_raw = 3.0 * math.tanh(u_raw / 1.0)
    if abs(force_raw) < 0.02:
        force = 0.0
    else:
        force = force_raw
    if force > 3.0:
        force = 3.0
    elif force < -3.0:
        force = -3.0
    return force
    return random.uniform(-3, 3)
