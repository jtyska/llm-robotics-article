def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity

    # 1. Safety guard – non‑finite observation
    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        action = 0.0

    # 2. Hard‑limit push‑away when pole is far from vertical
    elif abs(theta) >= 0.18:
        action = max(-3.0, min(-math.copysign(1.0, theta) * 3.0, 3.0))

    # 3. Core PD controller (angle + cart‑centering)
    else:
        # ---- angle‑gain schedule ----
        if abs(theta) <= 0.02:
            K_theta = 20.0
            K_theta_dot = 5.0
        elif abs(theta) >= 0.10:
            K_theta = 70.0
            K_theta_dot = 12.0
        else:
            z = (abs(theta) - 0.02) / (0.10 - 0.02)  # 0 ≤ z ≤ 1
            K_theta = 20.0 + z * (70.0 - 20.0)       # 20 → 70
            K_theta_dot = 5.0 + z * (12.0 - 5.0)    # 5  → 12

        # ---- PD law on pole ----
        u_angle = -(K_theta * theta + K_theta_dot * theta_dot)

        # ---- Small always‑on cart‑centering term ----
        u_cart = -(0.15 * x + 0.5 * x_dot)

        # ---- Combine and saturate ----
        raw = u_angle + u_cart
        action = max(-3.0, min(raw, 3.0))

    # 4. Dead‑zone for tiny forces
    if abs(action) < 0.05:
        action = 0.0

    # Default random action if somehow no rule applied
    if action is None:
        return random.uniform(-3.0, 3.0)
    return action
