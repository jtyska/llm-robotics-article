import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    if abs(theta) > 0.20:
        return -3.0 * (1 if theta > 0 else -1)

    # compute scaling factor s based on |theta|
    abs_theta = abs(theta)
    if abs_theta <= 0.02:
        s = 0.0
    elif abs_theta >= 0.18:
        s = 1.0
    else:
        s = (abs_theta - 0.02) / (0.18 - 0.02)

    k_theta = 5.0 + s * (20.0 - 5.0)
    k_thetad = 2.0 + s * (12.0 - 2.0)
    k_x = 0.8 + s * (1.5 - 0.8)
    k_xdot = 0.2 + s * (0.5 - 0.2)

    raw_force = -(k_theta * theta + k_thetad * theta_dot + k_x * x + k_xdot * x_dot)

    if raw_force > 3.0:
        force = 3.0
    elif raw_force < -3.0:
        force = -3.0
    else:
        force = raw_force

    return force

    # default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
