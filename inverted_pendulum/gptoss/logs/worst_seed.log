### 3️⃣ New strategy – “Exponential‑gain LQR‑ish PD‑I”

```text
/* -------------------------------------------------------------
   CART‑POLE BALANCING – CONTINUOUS FORCE (‑3 … +3 N)
   ------------------------------------------------------------- */
IF NOT ( isfinite(x) AND isfinite(x_dot) AND
         isfinite(theta) AND isfinite(theta_dot) ) THEN
    force ← 0.0
ELSE
    /* ---------- 1. Normalised tilt (0 … 1) ----------------- */
    /*   0   → |θ| ≤ 0.05 rad   (almost upright)            */
    /*   1   → |θ| ≥ 0.18 rad   (near failure)               */
    tilt_norm ← ( ABS(theta) - 0.05 ) / (0.18 - 0.05)
    tilt_norm ← CLAMP( tilt_norm , 0.0 , 1.0 )

    /* ---------- 2. Exponential gain‑scheduling ------------- */
    /*    Gains stay low for small tilt, then rise sharply   */
    /*    g(tilt) = g_min + (g_max‑g_min) * tilt_norm^p      */
    p ← 3.0                     /* curvature exponent (tunable) */

    Kp_cart   ← 0.30 + (0.90 - 0.30) * (tilt_norm ** p)
    Kd_cart   ← 0.45 + (1.20 - 0.45) * (tilt_norm ** p)
    Kp_pole   ← 2.0  + (7.0  - 2.0 ) * (tilt_norm ** p)
    Kd_pole   ← 0.8  + (4.0  - 0.8 ) * (tilt_norm ** p)

    /* ---------- 3. Integral on pole angle (anti‑windup) ---- */
    Ki_pole   ← 0.25                     /* larger than before   */
    dt        ← 0.02                     /* simulation step size */
    integral_theta ← CLAMP( integral_theta + theta*dt , -0.5 , 0.5 )

    /* ---------- 4. PD‑I control on the pole ---------------- */
    pole_pd   ← -( Kp_pole * theta
                 + Kd_pole * theta_dot
                 + Ki_pole * integral_theta )

    /* ---------- 5. PD control on the cart ------------------- */
    cart_pd   ← -( Kp_cart * x + Kd_cart * x_dot )

    /* ---------- 6. Gravity feed‑forward -------------------- */
    gravity_ff ← 9.81 * SIN(theta)

    /* ---------- 7. Raw command (N) ------------------------ */
    u_raw ← pole_pd + cart_pd + gravity_ff

    /* ---------- 8. Soft‑saturation (tanh) ----------------- */
    /*    tanh gives a smooth approach to the hard limits    */
    u_soft ← 3.0 * TANH( u_raw / 3.0 )

    /* ---------- 9. Hard clipping (actuator limits) -------- */
    force ← CLAMP( u_soft , -3.0 , 3.0 )

    /* ---------- 10. Tiny dead‑zone (to avoid jitter) ----- */
    IF ABS(force) < 0.01 THEN
        force ← 0.0
    END IF
END IF

RETURN force
```

