def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    if not hasattr(get_action, "int_theta"):
        get_action.int_theta = 0.0
    dt = 0.02
    force = None
    # Check for non‑finite values
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    # Position out of bounds
    elif abs(cart_position) > 1.2:
        force = -math.copysign(1.0, cart_position) * 3.0
    else:
        # Normal operation
        x = cart_position
        x_dot = cart_velocity
        theta = pole_angle
        theta_dot = pole_angular_velocity

        tilt_raw = (abs(theta) - 0.05) / (0.18 - 0.05)
        tilt_raw = max(0.0, min(tilt_raw, 1.0))
        tilt = tilt_raw * tilt_raw  # quadratic scaling

        Kp_theta = 35.0 + 115.0 * tilt
        Kd_theta = 2.5 + 7.5 * tilt
        Kp_x = 0.03 + 0.07 * tilt
        Kd_x = 0.006 + 0.014 * tilt

        ff_grav = 0.48 * math.sin(theta)
        bias = 0.015 * math.copysign(1.0, theta) * tilt

        if abs(theta) < 0.02:
            int_theta = 0.0
        else:
            int_theta = get_action.int_theta + theta * dt
            int_theta = max(-0.5, min(int_theta, 0.5))

        Ki_theta = 0.1

        u_raw = -(Kp_theta * theta +
                  Kd_theta * theta_dot +
                  Ki_theta * int_theta +
                  Kp_x * x +
                  Kd_x * x_dot +
                  ff_grav) + bias

        force = max(-3.0, min(u_raw, 3.0))
        get_action.int_theta = int_theta

    if force is None:
        force = random.uniform(-3.0, 3.0)
    return force
