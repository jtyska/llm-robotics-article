import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    u_lin = -(15.0 * theta + 10.0 * theta_dot + 0.7 * x + 0.3 * x_dot)

    scale = 1.0 + 5.0 * (abs(theta) / 0.20) ** 2
    if scale > 6.0:
        scale = 6.0

    if abs(theta) > 0.05:
        sign = 1.0 if theta > 0 else -1.0
        boost = -8.0 * sign * (abs(theta) - 0.05) ** 2
    else:
        boost = 0.0

    u_raw = u_lin * scale + boost
    u_soft = 3.0 * math.tanh(u_raw / 3.0)

    if u_soft > 3.0:
        action = 3.0
    elif u_soft < -3.0:
        action = -3.0
    else:
        action = u_soft

    return action

    return random.uniform(-3.0, 3.0)
