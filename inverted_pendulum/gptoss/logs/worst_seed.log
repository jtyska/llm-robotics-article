import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if not hasattr(get_action, "integral_x"):
        get_action.integral_x = 0.0
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0
    if abs(pole_angle) < 0.02:
        force = -0.8 * cart_position - 0.4 * cart_velocity
        return max(-3.0, min(3.0, force))
    else:
        scale = 1.0 + (abs(pole_angle) - 0.02) / (0.20 - 0.02)
        if scale > 2.0:
            scale = 2.0
        get_action.integral_x += 0.001 * cart_position
        u_raw = -(13.0 * pole_angle + 8.5 * pole_angular_velocity + 0.6 * cart_position + 0.2 * cart_velocity) - 0.05 * get_action.integral_x
        u_scaled = scale * u_raw
        u_soft = 3.0 * math.tanh(u_scaled / 3.0)
        force = max(-3.0, min(3.0, u_soft))
        return force
    return random.uniform(-3.0, 3.0)
