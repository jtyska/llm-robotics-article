def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # Check for non‑finite inputs
    if not all(map(math.isfinite, (cart_position, pole_angle, cart_velocity, pole_angular_velocity))):
        return 0.0
    # Tilt normalisation
    abs_theta = abs(pole_angle)
    if abs_theta <= 0.05:
        tilt_raw = 0.0
    elif abs_theta >= 0.20:
        tilt_raw = 1.0
    else:
        tilt_raw = (abs_theta - 0.05) / (0.20 - 0.05)
    # Gain scaling
    gain = tilt_raw ** 3
    # Pole PD gains
    Kp_theta = 4.0 + 8.0 * gain
    Kd_theta = 2.0 + 5.0 * gain
    # Cart‑position PD gains (decrease with tilt)
    Kp_x = 0.30 * (1.0 - tilt_raw) + 0.02
    Kd_x = 0.06 * (1.0 - tilt_raw) + 0.004
    # Constant velocity damping
    vel_damp = -0.03 * cart_velocity
    # Fast‑cart feed‑forward brake
    if abs(cart_velocity) > 0.5:
        ff = -0.5 * math.copysign(1.0, cart_velocity)
    else:
        ff = 0.0
    # PD contributions
    pole_effort = -Kp_theta * pole_angle - Kd_theta * pole_angular_velocity
    centre_bias = -Kp_x * cart_position - Kd_x * cart_velocity
    # Combine
    raw_force = pole_effort + centre_bias + vel_damp + ff
    # Smooth saturation
    force = 3.0 * math.tanh(0.35 * raw_force)
    # Clip to allowed range
    if force > 3.0:
        force = 3.0
    if force < -3.0:
        force = -3.0
    # Return computed force (fallback to random if somehow undefined)
    if force is None:
        return random.uniform(-3, 3)
    return force
