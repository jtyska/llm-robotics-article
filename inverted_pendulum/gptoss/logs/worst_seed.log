def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # Check for finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    else:
        # Rule 2 – Normalized tilt
        tilt_raw = (abs(pole_angle) - 0.05) / (0.18 - 0.05)
        tilt_norm = max(0.0, min(tilt_raw, 1.0))
        # Rule 3 – Smooth blending factor
        tau = 1.0 / (1.0 + math.exp(-12.0 * (tilt_norm - 0.5)))
        # Rule 4 – Gain schedule
        Kp_theta = (1 - tau) * 200.0 + tau * 400.0
        Kd_theta = (1 - tau) * 25.0 + tau * 55.0
        Kp_x = (1 - tau) * 6.0 + tau * 10.0
        Kd_x = (1 - tau) * 1.5 + tau * 3.0
        Ki_x = (1 - tau) * 0.5 + tau * 1.0
        # Rule 5 – Integral of position (slow drift correction)
        if not hasattr(get_action, "integ_x"):
            get_action.integ_x = 0.0
        get_action.integ_x = 0.99 * get_action.integ_x + 0.01 * cart_position
        # Rule 6 – Raw control signal
        u_raw = -(Kp_theta * pole_angle +
                  Kd_theta * pole_angular_velocity +
                  Kp_x * cart_position +
                  Kd_x * cart_velocity +
                  Ki_x * get_action.integ_x)
        # Rule 7 – Soft saturation
        force_soft = 3.0 * math.tanh(u_raw / 4.0)
        # Rule 8 – Dead‑band
        if abs(force_soft) < 0.05:
            force_soft = 0.0
        # Rule 9 – Final clipping
        force = max(-3.0, min(force_soft, 3.0))
    # Default random action (unreachable if rules applied)
    return force if 'force' in locals() else random.uniform(-3.0, 3.0)
