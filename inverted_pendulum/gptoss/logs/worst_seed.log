import random, math

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non-finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Helper sign function
    def sign(x):
        return 1.0 if x > 0 else -1.0 if x < 0 else 0.0

    # Failure condition: pole angle beyond limits
    if abs(pole_angle) >= 0.20:
        return -sign(pole_angle) * 3.0

    # Main control law
    raw = -(0.5 * cart_position +
            0.1 * cart_velocity +
            15.0 * pole_angle +
            2.5 * pole_angular_velocity)

    if raw > 3.0:
        return 3.0
    elif raw < -3.0:
        return -3.0
    else:
        return raw

    # Default random action (should not be reached)
    return random.uniform(-3.0, 3.0)
