import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # Rule 1
    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    # Rule 2
    if abs(theta) > 0.20:
        return 0.0

    # Rule 3
    theta_dead = 0.02
    theta_max = 0.20
    g = 9.8

    # Rule 4
    alpha = max(0.0, (abs(theta) - theta_dead) / (theta_max - theta_dead))
    alpha = alpha * alpha * (3 - 2 * alpha)

    # Rule 5
    Kx = 0.80 * (1 - alpha) + 0.10 * alpha
    Kx_dot = 0.40 * (1 - alpha) + 0.20 * alpha
    Ktheta = 1.0 + (8.0 - 1.0) * alpha
    Ktheta_dot = 0.5 + (3.0 - 0.5) * alpha

    # Rule 6
    u_grav = -g * math.sin(theta)
    u_angle = -(Ktheta * theta + Ktheta_dot * theta_dot) * alpha
    u_cart = -(Kx * x + Kx_dot * x_dot)

    # Rule 7
    u_raw = u_grav + u_angle + u_cart

    # Rule 8
    u_clamped = max(-3.0, min(u_raw, 3.0))

    # Rule 9
    if abs(u_clamped) < 0.01:
        return 0.0
    else:
        return u_clamped

    # Default fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
