def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    tilt_norm = (abs(pole_angle) - 0.02) / 0.18
    tilt_norm = max(0.0, min(1.0, tilt_norm))
    tau = 1.0 / (1.0 + math.exp(-20.0 * (tilt_norm - 0.5)))
    Kp_theta = (1 - tau) * 150.0 + tau * 300.0
    Kd_theta = (1 - tau) * 20.0 + tau * 45.0
    Kp_x = (1 - tau) * 5.0 + tau * 8.0
    Kd_x = (1 - tau) * 1.0 + tau * 2.0
    Ki_x = (1 - tau) * 0.4 + tau * 0.8
    if not hasattr(get_action, "integ_x"):
        get_action.integ_x = 0.0
    get_action.integ_x = 0.995 * get_action.integ_x + 0.005 * cart_position
    u_raw = -(Kp_theta * pole_angle + Kd_theta * pole_angular_velocity + Kp_x * cart_position + Kd_x * cart_velocity + Ki_x * get_action.integ_x)
    force_soft = 3.0 * math.tanh(u_raw / 4.0)
    if abs(force_soft) < 0.05:
        force_soft = 0.0
    force = max(-3.0, min(3.0, force_soft))
    return force

