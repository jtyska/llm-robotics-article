def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    force = None
    # Check for non‑finite inputs
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    else:
        x = cart_position
        theta = pole_angle
        x_dot = cart_velocity
        theta_dot = pole_angular_velocity

        # Normalised tilt (dead‑zone 0.05 rad, full‑tilt at 0.18 rad)
        tilt_raw_raw = (abs(theta) - 0.05) / 0.13
        if tilt_raw_raw < 0.0:
            tilt_raw = 0.0
        elif tilt_raw_raw > 1.0:
            tilt_raw = 1.0
        else:
            tilt_raw = tilt_raw_raw

        # Cubic scaling
        tilt = tilt_raw ** 3

        # Gain scheduling
        Kp = 8.0 + 4.0 * tilt
        Kd = 1.5 + 1.5 * tilt

        # Pole effort (PD)
        pole_effort = -Kp * theta - Kd * theta_dot

        # Cart‑position bias (only near vertical)
        centre_bias = -0.07 * (1.0 - tilt_raw) * x

        # Cart‑velocity damping (only near vertical)
        cart_vel_damp = -0.03 * (1.0 - tilt_raw) * x_dot

        # Feed‑forward term for large tilts
        if tilt_raw > 0.6:
            if x_dot > 0.0:
                sign_xdot = 1.0
            elif x_dot < 0.0:
                sign_xdot = -1.0
            else:
                sign_xdot = 0.0
            ff = 0.2 * sign_xdot
        else:
            ff = 0.0

        # Combine contributions
        raw_force = pole_effort + centre_bias + cart_vel_damp + ff

        # Saturated tanh scaling
        force = 3.0 * math.tanh(raw_force * 0.30)

        # Hard clipping to environment limits
        if force > 3.0:
            force = 3.0
        elif force < -3.0:
            force = -3.0

    if force is None:
        return random.uniform(-3.0, 3.0)
    return force
