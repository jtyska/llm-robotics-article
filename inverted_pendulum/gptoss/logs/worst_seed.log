import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        force = 0.0
        return force

    abs_theta = abs(theta)
    if abs_theta <= 0.05:
        tilt_norm = 0.0
    elif abs_theta >= 0.18:
        tilt_norm = 1.0
    else:
        tilt_norm = (abs_theta - 0.05) / (0.18 - 0.05)

    Kp_theta = 4.0 + 4.0 * tilt_norm
    Kd_theta = 2.5 + 2.5 * tilt_norm

    pole_PD = -(Kp_theta * math.sin(theta) + Kd_theta * theta_dot)
    gravity_ff = 0.60 * 9.81 * math.sin(theta)
    pole_effort = pole_PD + gravity_ff

    cart_effort = -(0.30 * x + 0.05 * x_dot)

    raw_force = pole_effort + cart_effort
    force = 3.0 * math.tanh(0.30 * raw_force)

    if force > 3.0:
        force = 3.0
    elif force < -3.0:
        force = -3.0

    return force

    # default random action if no rule applies
    return random.uniform(-3, 3)
