def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    if not hasattr(get_action, "theta_int"):
        get_action.theta_int = 0.0
    # safety checks
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    if abs(pole_angle) >= 0.20:
        return 0.0
    # normalised tilt
    dead_zone = 0.05
    full_angle = 0.18
    tilt_raw = (abs(pole_angle) - dead_zone) / (full_angle - dead_zone)
    tilt = max(0.0, min(tilt_raw, 1.0))
    # gain schedule (quadratic)
    Kp = 4.0 + 28.0 * tilt * tilt
    Kd = 1.0 + 6.0 * tilt * tilt
    KpC = 0.08 + 0.32 * tilt * tilt
    KdC = 0.02 + 0.08 * tilt * tilt
    # pole PD term
    pole_pd = -Kp * pole_angle - Kd * pole_angular_velocity
    # cart‑centering PD term
    cart_pd = -KpC * cart_position - KdC * cart_velocity
    # tiny integral on theta (persistent across steps)
    dt = 0.02
    get_action.theta_int += pole_angle * dt
    get_action.theta_int = max(-0.1, min(get_action.theta_int, 0.1))
    Ki = 0.1 * tilt * tilt
    int_term = -Ki * get_action.theta_int
    # combine
    raw_force = pole_pd + cart_pd + int_term
    # saturate
    force = max(-3.0, min(raw_force, 3.0))
    return force
    # default random action (fallback)
    return random.uniform(-3.0, 3.0)
