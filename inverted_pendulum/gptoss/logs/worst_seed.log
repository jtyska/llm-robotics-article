def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # Rule: check for non-finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    # Compute tilt_raw and clamp to [0,1]
    tilt_raw = (abs(pole_angle) - 0.05) / (0.18 - 0.05)
    if tilt_raw < 0.0:
        tilt_raw = 0.0
    elif tilt_raw > 1.0:
        tilt_raw = 1.0
    # Gain based on tilt
    g = tilt_raw * tilt_raw
    Kp_theta = 12.0 + 30.0 * g
    Kd_theta = 5.0 + 15.0 * g
    # Control effort
    pole_effort = -Kp_theta * pole_angle - Kd_theta * pole_angular_velocity
    centre_bias = -0.07 * tilt_raw * cart_position
    force_raw = pole_effort + centre_bias
    # Clip force to allowed range
    if force_raw > 3.0:
        force = 3.0
    elif force_raw < -3.0:
        force = -3.0
    else:
        force = force_raw
    return force
    # Default random action if no rule applies
    return random.uniform(-3, 3)
