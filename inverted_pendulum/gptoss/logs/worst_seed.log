    # 7. Raw control signal (sum of all contributions)
    u_raw = pole_pd + gravity_ff + cart_pd + centre_bias

    # 8. Tanh scaling – keep the signal inside the linear region
    alpha = 0.6 + 0.6 * tilt_norm

    # 9. Final force, limited to the actuator bounds
    force = clamp( 3.0 * tanh( alpha * u_raw ), -3.0, 3.0 )
