// ---------- helper ----------
function clamp(v, lo, hi):
    if v < lo: return lo
    if v > hi: return hi
    return v

// ---------- controller ----------
IF ( !isFinite(x) OR !isFinite(x_dot) OR !isFinite(theta) OR !isFinite(theta_dot) )
    force ← 0.0

ELSE IF ( abs(theta) >= 0.20 )
    // emergency push – we are already at the failure limit
    force ← clamp( -3.0 * sign(theta), -3.0, 3.0 )

ELSE
    // ----- base linear state‑feedback -----
    // Gains were tuned manually (they are in the same ball‑park as a
    // discretised LQR solution for the classic pole‑cart with m=1kg,
    // M=0.5kg, l=0.5m, g=9.8).  They give a stable pole for small
    // deviations and a strong corrective push when the pole tilts.
    Kx        ←  1.0      // cart‑position gain
    Kx_dot    ←  0.8      // cart‑velocity gain
    Ktheta    ← 45.0      // pole‑angle gain
    Ktheta_dot← 10.0      // pole‑angular‑velocity gain

    // raw control from all four states
    raw ← -( Kx      * x
           + Kx_dot  * x_dot
           + Ktheta  * theta
           + Ktheta_dot * theta_dot )

    // ----- adaptive scaling based on pole angle -----
    // We start scaling already at |θ| = 0.01 rad and finish at |θ| = 0.18 rad.
    // Scale grows linearly from 1.0 to 2.5.
    rel   ← ( abs(theta) - 0.01 ) / (0.18 - 0.01)   // may be <0 or >1
    rel   ← clamp(rel, 0.0, 1.0)
    scale ← 1.0 + rel * (2.5 - 1.0)                // 1 … 2.5

    // Apply scaling only to the *angle* part of the controller.
    // This keeps the cart‑position term active even when the pole is
    // almost vertical.
    angle_part ← -( Ktheta * theta + Ktheta_dot * theta_dot )
    cart_part  ← -( Kx * x + Kx_dot * x_dot )
    raw_scaled ← cart_part + scale * angle_part

    // ----- final clipping to actuator limits -----
    force ← clamp( raw_scaled, -3.0, 3.0 )
END IF

RETURN force
```

