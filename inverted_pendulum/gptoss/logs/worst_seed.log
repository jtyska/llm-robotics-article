import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for finite values
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0

    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity

    a_theta = abs(theta)

    if a_theta <= 0.02:
        k_theta = 0.0
        k_theta_d = 0.0
        k_x = 1.0
        k_x_d = 0.5
    else:
        t = (a_theta - 0.02) / (0.18 - 0.02)  # t in (0,1)
        k_theta = 8.0 + (20.0 - 8.0) * (t * t)      # 8 → 20
        k_theta_d = 2.0 + (6.0 - 2.0) * (t * t)      # 2 → 6
        k_x = 0.5
        k_x_d = 0.2

    if a_theta >= 0.18:
        raw = -3.0 * (1 if theta > 0 else -1) - 0.3 * theta_dot
    else:
        pole_pd = -(k_theta * theta + k_theta_d * theta_dot)
        cart_pd = -(k_x * x + k_x_d * x_dot)
        raw = pole_pd + cart_pd

    if abs(raw) < 0.05:
        raw = 0.0

    if raw > 3.0:
        force = 3.0
    elif raw < -3.0:
        force = -3.0
    else:
        force = raw

    # Fallback random action (should not be reached)
    if force is None:
        return random.uniform(-3, 3)

    return force
