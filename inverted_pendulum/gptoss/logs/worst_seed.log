import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    abs_theta = abs(theta)
    if abs_theta <= 0.02:
        scale = 0.0
    elif abs_theta >= 0.20:
        scale = 1.0
    else:
        scale = (abs_theta - 0.02) / (0.20 - 0.02)

    k_theta = (1 - scale) * 5.0 + scale * 12.0
    k_theta_dot = (1 - scale) * 1.0 + scale * 3.0
    k_x = (1 - scale) * 0.3 + scale * 0.1
    k_x_dot = (1 - scale) * 0.05 + scale * 0.02

    raw_force = -(k_theta * theta + k_theta_dot * theta_dot + k_x * x + k_x_dot * x_dot + 0.1 * x)

    if raw_force > 3.0:
        force = 3.0
    elif raw_force < -3.0:
        force = -3.0
    else:
        force = raw_force

    return force if force is not None else random.uniform(-3, 3)
