import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for finite values
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0

    theta = pole_angle
    theta_dot = pole_angular_velocity
    x = cart_position
    x_dot = cart_velocity

    # Helper functions
    def clamp(v, lo, hi):
        return max(lo, min(v, hi))

    def sign(v):
        if v > 0:
            return 1.0
        if v < 0:
            return -1.0
        return 0.0

    # Large angle rule
    if abs(theta) >= 0.18:
        force = clamp(-sign(theta) * 3.0, -3.0, 3.0)
        return force

    # Compute control signals
    u_angle = -(13.0 * theta + 3.5 * theta_dot)
    u_full = -(0.55 * x + 0.85 * x_dot + 13.0 * theta + 3.5 * theta_dot)

    # Blend based on angle magnitude
    if abs(theta) <= 0.02:
        raw = u_full
    elif abs(theta) < 0.12:
        blend = (0.12 - abs(theta)) / (0.12 - 0.02)
        raw = blend * u_full + (1.0 - blend) * u_angle
    else:
        raw = u_angle

    # Small angle adjustment
    if abs(theta) <= 0.01:
        raw = raw - 0.1 * x

    force = clamp(raw, -3.0, 3.0)
    return force

    # Default random action (should not be reached)
    return random.uniform(-3.0, 3.0)
