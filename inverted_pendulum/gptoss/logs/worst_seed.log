import math, random

def clamp(val, lo, hi):
    return max(lo, min(val, hi))

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(theta) and math.isfinite(x_dot) and math.isfinite(theta_dot)):
        return 0.0

    if abs(theta) >= 0.20:
        sign = 1.0 if theta > 0 else -1.0 if theta < 0 else 0.0
        force = clamp(-sign * 3.0, -3.0, 3.0)
        return force

    if abs(theta) <= 0.02:
        cart_cmd = -(0.5 * x + 0.1 * x_dot)
        angle_cmd = -(10.0 * theta + 2.0 * theta_dot)
        raw_force = cart_cmd + angle_cmd
        force = clamp(raw_force, -3.0, 3.0)
        return force

    # 0.02 < abs(theta) < 0.20
    u_angle = -(30.0 * theta + 8.0 * theta_dot)
    scale = 1.0 + (abs(theta) - 0.02) / (0.18 - 0.02)
    scale = clamp(scale, 1.0, 2.0)
    raw_force = scale * u_angle
    force = clamp(raw_force, -3.0, 3.0)
    return force

    # fallback (should not be reached)
    return random.uniform(-3.0, 3.0)
