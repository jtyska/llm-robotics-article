def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0
    aTheta = abs(pole_angle)
    def sign(x):
        return 1.0 if x > 0 else -1.0 if x < 0 else 0.0
    def clamp(v, lo, hi):
        return max(lo, min(v, hi))
    if aTheta >= 0.12:
        force = -3.0 * sign(pole_angle)
        return force
    elif aTheta > 0.02:
        k_theta = 8 + ((aTheta - 0.02) / (0.12 - 0.02)) * (20 - 8)
        k_theta_dot = 2 + ((aTheta - 0.02) / (0.12 - 0.02)) * (5 - 2)
        k_x = 0.5
        k_x_dot = 0.2
        raw = -(k_theta * pole_angle + k_theta_dot * pole_angular_velocity + k_x * cart_position + k_x_dot * cart_velocity)
        force = clamp(raw, -3.0, 3.0)
        return force
    else:
        k_theta = 1.0
        k_theta_dot = 0.5
        k_x = 1.5
        k_x_dot = 0.7
        raw = -(k_theta * pole_angle + k_theta_dot * pole_angular_velocity + k_x * cart_position + k_x_dot * cart_velocity)
        force = clamp(raw, -3.0, 3.0)
        return force
    return random.uniform(-3, 3)
