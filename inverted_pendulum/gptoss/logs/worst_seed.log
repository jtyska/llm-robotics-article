import random, math

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    if abs(theta) <= 0.02:
        raw = -(0.5 * x + 0.1 * x_dot)
    elif abs(theta) < 0.15:
        beta = (abs(theta) - 0.02) / (0.15 - 0.02)
        beta = max(0.0, min(1.0, beta))
        pole_pd = -(8.0 * theta + 2.0 * theta_dot)
        cart_pd = -(0.5 * x + 0.1 * x_dot) * (1.0 - beta)
        raw = pole_pd + cart_pd
    else:
        raw = -(20.0 * theta + 6.0 * theta_dot)

    if abs(raw) > 3.0:
        force = 3.0 * (1 if raw > 0 else -1)
    else:
        force = raw

    if force is None:
        return random.uniform(-3, 3)
    return force
