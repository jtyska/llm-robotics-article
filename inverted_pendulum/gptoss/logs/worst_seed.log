import random, math

Kx = 1.2
Kx_dot = 1.0
Ktheta = 55.0
Ktheta_dot = 15.0
theta_dead = 0.02
theta_limit = 0.18
ramp_min = 1.0
ramp_max = 2.0

def _clamp(v, lo, hi):
    return max(lo, min(v, hi))

def _sign(v):
    return 1.0 if v > 0 else -1.0 if v < 0 else 0.0

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(theta) and math.isfinite(x_dot) and math.isfinite(theta_dot)):
        return 0.0

    if abs(theta) >= theta_limit:
        return _clamp(-_sign(theta) * 3.0, -3.0, 3.0)

    if abs(theta) <= theta_dead:
        u_pos = -(Kx * x + Kx_dot * x_dot)
        return _clamp(u_pos, -3.0, 3.0)

    # else: angle control
    u_angle = -(Ktheta * theta + Ktheta_dot * theta_dot)
    ramp = ramp_min + (ramp_max - ramp_min) * ((abs(theta) - theta_dead) / (theta_limit - theta_dead))
    ramp = _clamp(ramp, ramp_min, ramp_max)
    raw_force = ramp * u_angle
    force = _clamp(raw_force, -3.0, 3.0)
    return force

    # fallback random action (should never be reached)
    return random.uniform(-3.0, 3.0)
