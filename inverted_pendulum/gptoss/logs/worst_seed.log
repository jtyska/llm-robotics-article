def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # Rule 0: non‑finite check
    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    # 1. Normalised tilt
    abs_theta = abs(theta)
    if abs_theta <= 0.05:
        tilt_norm = 0.0
    elif abs_theta >= 0.18:
        tilt_norm = 1.0
    else:
        tilt_norm = (abs_theta - 0.05) / (0.18 - 0.05)

    # 2. Gain‑scheduling
    Kp_theta = 4.0 + (14.0 - 4.0) * tilt_norm
    Kd_theta = 2.0 + (7.0 - 2.0) * tilt_norm
    Kp_cart  = 0.02 + (0.08 - 0.02) * tilt_norm
    Kd_cart  = 0.03 + (0.10 - 0.03) * tilt_norm

    # 3. Pole PD (using sin)
    pole_pd = -(Kp_theta * math.sin(theta) + Kd_theta * theta_dot)

    # 4. Gravity feed‑forward
    gravity_ff = 0.60 * 9.81 * math.sin(theta)

    # 5. Cart PD
    cart_pd = -(Kp_cart * x + Kd_cart * x_dot)

    # 6. Centre bias (only when pole is very upright)
    centre_bias = -0.08 * x if abs_theta < 0.07 else 0.0

    # 7. Raw command
    raw_force = pole_pd + gravity_ff + cart_pd + centre_bias

    # 8. Smooth saturation (tanh)
    force_raw = 3.0 * math.tanh(0.60 * raw_force)

    # 9. Final clipping to [-3, 3]
    if force_raw > 3.0:
        force = 3.0
    elif force_raw < -3.0:
        force = -3.0
    else:
        force = force_raw

    return force

    # Default random action if no rule applies (fallback)
    return random.uniform(-3, 3)
