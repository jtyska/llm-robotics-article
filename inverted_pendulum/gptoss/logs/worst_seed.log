import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    # 1. Normalised tilt
    abs_theta = abs(theta)
    if abs_theta <= 0.05:
        tilt_norm = 0.0
    elif abs_theta >= 0.22:
        tilt_norm = 1.0
    else:
        tilt_norm = (abs_theta - 0.05) / (0.22 - 0.05)

    # 2. Gain‑scheduling
    Kp_theta = (1 - tilt_norm) * 8.0 + tilt_norm * 35.0
    Kd_theta = (1 - tilt_norm) * 4.0 + tilt_norm * 18.0
    Kp_x = (1 - tilt_norm) * 0.2 + tilt_norm * 0.9
    Kd_x = (1 - tilt_norm) * 0.2 + tilt_norm * 0.7

    # 3. PD control + gravity compensation
    u_grav = 9.81 * math.sin(theta)
    u_pd = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * x + Kd_x * x_dot)
    u_raw = u_pd + u_grav

    # 4. Smooth saturation
    force_raw = 3.0 * math.tanh(u_raw / 1.5)

    # 5. Final clipping
    if force_raw > 3.0:
        force = 3.0
    elif force_raw < -3.0:
        force = -3.0
    else:
        force = force_raw

    return force

    # Default random action (should never be reached)
    return random.uniform(-3, 3)
