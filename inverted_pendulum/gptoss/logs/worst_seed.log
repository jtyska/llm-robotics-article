import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    abs_theta = abs(theta)
    if abs_theta <= 0.05:
        tilt_norm = 0.0
    elif abs_theta >= 0.20:
        tilt_norm = 1.0
    else:
        tilt_norm = (abs_theta - 0.05) / (0.20 - 0.05)

    gain_factor = tilt_norm * tilt_norm

    Kp = 4.0 + (12.0 - 4.0) * gain_factor
    Kd = 2.5 + (7.5 - 2.5) * gain_factor

    pole_PD = -(Kp * math.sin(theta) + Kd * theta_dot)
    pole_PD = max(min(pole_PD, 10.0), -10.0)

    gravity_ff = 0.60 * 9.81 * math.sin(theta)

    pole_effort = pole_PD + gravity_ff

    cart_effort = -(0.30 * x + 0.07 * x_dot)

    tilt_bias = -0.10 * (math.copysign(1, theta) if theta != 0 else 0) * abs_theta

    raw_force = pole_effort + cart_effort + tilt_bias

    force_raw = 3.0 * math.tanh(0.30 * raw_force)
    force = max(min(force_raw, 3.0), -3.0)

    return force

    # fallback random action (should never be reached)
    return random.uniform(-3.0, 3.0)
