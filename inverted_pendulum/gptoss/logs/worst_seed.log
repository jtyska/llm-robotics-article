import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Rule 1 – Safety guard
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity

    # Rule 2 – Normalised tilt
    tilt_raw = (abs(theta) - 0.05) / (0.20 - 0.05)
    if tilt_raw < 0.0:
        tilt = 0.0
    elif tilt_raw > 1.0:
        tilt = 1.0
    else:
        tilt = tilt_raw

    # Rule 3 – Gain schedule
    Kp_theta = 20.0 + 80.0 * tilt
    Kd_theta = 1.0 + 4.0 * tilt
    Kp_x = 0.02 + 0.08 * tilt
    Kd_x = 0.005 + 0.025 * tilt

    # Rule 4 – Gravity feed‑forward
    ff_grav = 0.48 * math.sin(theta)

    # Rule 5 – Tiny bias
    bias = 0.01 * (1 if theta > 0 else (-1 if theta < 0 else 0)) * tilt

    # Rule 6 – Raw PD command
    u_raw = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * x + Kd_x * x_dot + ff_grav) + bias

    # Rule 7 – Soft‑saturation limit
    Fsoft = 0.6 + 1.9 * tilt
    if u_raw > Fsoft:
        force = Fsoft
    elif u_raw < -Fsoft:
        force = -Fsoft
    else:
        force = u_raw

    # Clamp to action bounds
    if force > 3.0:
        force = 3.0
    elif force < -3.0:
        force = -3.0

    return force

    # Default random action (fallback)
    return random.uniform(-3, 3)
