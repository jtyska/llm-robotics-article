import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    def clamp(v, lo, hi):
        return max(lo, min(v, hi))

    def sign(v):
        return 1.0 if v > 0 else -1.0 if v < 0 else 0.0

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0
    elif abs(theta) < 0.015:
        return clamp(-(0.6 * x + 0.25 * x_dot), -3.0, 3.0)
    else:
        u_lin = -(13.0 * theta + 9.0 * theta_dot + 0.8 * x + 0.35 * x_dot)

        theta_abs = abs(theta)
        if theta_abs < 0.04:
            scale = 1.0
        else:
            norm = (theta_abs - 0.04) / (0.20 - 0.04)  # ∈[0,1]
            scale = 1.0 + 4.0 * (norm * norm)          # quadratic growth, max 5.0

        if theta_abs > 0.06:
            boost = -6.0 * sign(theta) * (theta_abs - 0.06) * (theta_abs - 0.06)
        else:
            boost = 0.0

        u_raw = (u_lin * scale) + boost
        u_soft = 3.0 * math.tanh(u_raw / 3.0)
        return clamp(u_soft, -3.0, 3.0)

    return random.uniform(-3.0, 3.0)
