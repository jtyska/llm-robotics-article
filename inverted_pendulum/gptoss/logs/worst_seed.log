def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity
    force = None
    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        force = 0.0
    else:
        abs_theta = abs(theta)
        if abs_theta <= 0.05:
            t = 0.0
        elif abs_theta >= 0.20:
            t = 1.0
        else:
            t = ((abs_theta - 0.05) / (0.20 - 0.05)) ** 2
        Kp_theta = 30.0 + 120.0 * t
        Kd_theta = 2.0 + 8.0 * t
        Kp_x = 0.05 + 0.25 * t
        Kd_x = 0.01 + 0.07 * t
        ff_grav = 0.48 * math.sin(theta)
        bias = 0.03 * math.copysign(1.0, theta) * (1.0 + 1.5 * t)
        u_raw = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * x + Kd_x * x_dot + ff_grav) + bias
        Fsoft = 0.6 + 2.4 * t
        if Fsoft > 3.0:
            Fsoft = 3.0
        u_soft = math.tanh(u_raw / Fsoft) * Fsoft
        if u_soft > 3.0:
            force = 3.0
        elif u_soft < -3.0:
            force = -3.0
        else:
            force = u_soft
    if force is None:
        return random.uniform(-3.0, 3.0)
    return force
