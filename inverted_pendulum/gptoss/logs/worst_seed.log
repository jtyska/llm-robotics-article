import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    if abs(theta) >= 0.18:
        sign = 1.0 if theta > 0 else -1.0 if theta < 0 else 0.0
        return -sign * 3.0

    abs_theta = abs(theta)

    if abs_theta <= 0.02:
        K_theta = 15.0
        K_theta_dot = 3.0
        K_x = 0.3
        K_x_dot = 0.5
    elif abs_theta < 0.10:
        alpha = (abs_theta - 0.02) / (0.10 - 0.02)
        K_theta = 15.0 + alpha * (40.0 - 15.0)
        K_theta_dot = 3.0 + alpha * (8.0 - 3.0)
        K_x = 0.3 + alpha * (0.6 - 0.3)
        K_x_dot = 0.5 + alpha * (0.9 - 0.5)
    else:
        beta = (abs_theta - 0.10) / (0.18 - 0.10)
        K_theta = 40.0 + beta * (80.0 - 40.0)
        K_theta_dot = 8.0 + beta * (15.0 - 8.0)
        K_x = 0.6 + beta * (1.0 - 0.6)
        K_x_dot = 0.9 + beta * (1.4 - 0.9)

    raw_force = -(K_theta * theta + K_theta_dot * theta_dot) - (K_x * x + K_x_dot * x_dot)
    force = max(-3.0, min(3.0, raw_force))

    if abs(force) < 0.001:
        force = 0.0

    return force

    # fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
