import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0

    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity

    theta_abs = abs(theta)

    if theta_abs <= 0.02:
        K_theta = 1.0
        K_theta_dot = 0.5
    else:
        frac = (theta_abs - 0.02) / 0.18
        K_theta = 1.0 + frac * (2.0 - 1.0)
        K_theta_dot = 0.5 + frac * (1.5 - 0.5)

    u_cart = -(0.8 * x + 0.4 * x_dot)
    u_angle = -(K_theta * theta + K_theta_dot * theta_dot)
    u_raw = u_cart + u_angle

    u_smooth = 3.0 * math.tanh(u_raw / 3.0)

    if u_smooth > 3.0:
        action = 3.0
    elif u_smooth < -3.0:
        action = -3.0
    else:
        action = u_smooth

    return action if action is not None else random.uniform(-3, 3)
