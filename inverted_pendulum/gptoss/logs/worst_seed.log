import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    xdot = cart_velocity
    thetadot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(xdot) and math.isfinite(theta) and math.isfinite(thetadot)):
        return 0.0

    abs_theta = abs(theta)

    if abs_theta <= 0.08:
        K_theta = -8.0
        K_thetadot = -2.0
    elif abs_theta >= 0.14:
        K_theta = -12.5
        K_thetadot = -3.5
    else:
        t = (abs_theta - 0.08) / (0.14 - 0.08)  # 0 … 1
        K_theta = (1 - t) * (-8.0) + t * (-12.5)
        K_thetadot = (1 - t) * (-2.0) + t * (-3.5)

    sign_theta = 0.0
    if theta > 0:
        sign_theta = 1.0
    elif theta < 0:
        sign_theta = -1.0

    bias = -0.05 * sign_theta * (abs_theta ** 2)

    F_raw = (-0.5) * x + (-0.1) * xdot + K_theta * theta + K_thetadot * thetadot + bias

    if F_raw > 3.0:
        F = 3.0
    elif F_raw < -3.0:
        F = -3.0
    else:
        F = F_raw

    return F if math.isfinite(F) else random.uniform(-3, 3)
