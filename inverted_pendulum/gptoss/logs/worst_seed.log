def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    force = None
    # Check for non‑finite values
    if not all(math.isfinite(v) for v in (cart_position, pole_angle, cart_velocity, pole_angular_velocity)):
        force = 0.0
    else:
        theta_abs = abs(pole_angle)
        # Base control law
        if theta_abs < 0.01:
            u_base = -(12.0 * pole_angle + 8.0 * pole_angular_velocity)
        else:
            u_base = -(0.8 * cart_position + 0.4 * cart_velocity + 12.0 * pole_angle + 8.0 * pole_angular_velocity)
        # Gain boost calculation
        if theta_abs < 0.015:
            gain_boost = 0.0
        elif theta_abs < 0.20:
            gain_boost = 3.5 * (theta_abs - 0.015) / (0.20 - 0.015)
        else:
            gain_boost = 3.5
        gain = 1.0 + gain_boost
        u_scaled = gain * u_base
        u_soft = 4.0 * math.tanh(u_scaled / 4.0)
        # Clamp to action limits
        if u_soft > 3.0:
            force = 3.0
        elif u_soft < -3.0:
            force = -3.0
        else:
            force = u_soft
    # Default random action if no rule applied
    if force is None:
        return random.uniform(-3, 3)
    return force
