def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    if abs(theta) >= 0.20:
        return -math.copysign(1.0, theta) * 3.0

    if abs(theta) <= 0.02:
        scale = 1.0
        cart_gain = 1.0
        u_angle = -(22.0 * theta + 3.5 * theta_dot) * scale
        u_cart = -(0.9 * x + 0.12 * x_dot) * cart_gain
        raw_force = u_angle + u_cart
        return 3.0 * math.tanh(raw_force / 3.0)

    if abs(theta) < 0.18:
        rel = (abs(theta) - 0.02) / (0.18 - 0.02)
        scale = 1.0 + rel * (3.0 - 1.0)
        cart_gain = 1.0 - rel
        u_angle = -(22.0 * theta + 3.5 * theta_dot) * scale
        u_cart = -(0.9 * x + 0.12 * x_dot) * cart_gain
        raw_force = u_angle + u_cart
        return 3.0 * math.tanh(raw_force / 3.0)

    # 0.18 ≤ abs(theta) < 0.20
    scale = 3.0
    cart_gain = 0.0
    u_angle = -(22.0 * theta + 3.5 * theta_dot) * scale
    raw_force = u_angle
    return 3.0 * math.tanh(raw_force / 3.0)

    # Default random action (should not be reached)
    return random.uniform(-3.0, 3.0)
