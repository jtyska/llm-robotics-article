import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non‑finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Small tilt tolerance
    if abs(pole_angle) < 0.015:
        return 0.0

    # Compute tilt factor
    tilt_raw = (abs(pole_angle) - 0.015) / (0.20 - 0.015)
    tilt = max(0.0, min(tilt_raw, 1.0))

    # Gains
    Kp_theta = 8.0 + 300.0 * (tilt * tilt)
    Kd_theta = 2.5 + 150.0 * (tilt * tilt * tilt)
    Kp_cart  = 0.6 + 4.0 * tilt
    Kd_cart  = 0.15 + 1.0 * tilt
    ff_gain  = 0.4 + 3.0 * (tilt * tilt * tilt)

    # Base force (only the proportional term for theta is defined in the spec)
    force_raw = -Kp_theta * pole_angle

    # Optional: include derivative and cart terms if desired
    # force_raw += -Kd_theta * pole_angular_velocity
    # force_raw += -Kp_cart * cart_position
    # force_raw += -Kd_cart * cart_velocity
    # force_raw += ff_gain * (1.0 if pole_angle > 0 else -1.0)

    # Clamp to action limits
    force = max(-3.0, min(force_raw, 3.0))
    return force

    # Fallback random action (unreachable with current rules)
    return random.uniform(-3.0, 3.0)
