def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    force = None
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    else:
        # Normalised tilt
        theta0 = 0.04
        theta1 = 0.20
        tilt_raw = (abs(pole_angle) - theta0) / (theta1 - theta0)
        tilt_norm = max(0.0, min(tilt_raw, 1.0))
        gain = tilt_norm * tilt_norm  # quadratic scaling

        # Gain scheduling
        Kp_theta = 8.0 + (35.0 - 8.0) * gain
        Kd_theta = 1.0 + (5.0 - 1.0) * gain
        Kp_x = 0.20 + (1.0 - 0.20) * gain
        Kd_x = 0.05 + (0.20 - 0.05) * gain

        # Position bias
        if cart_position > 0.5:
            center_bias = -(cart_position - 0.5) * 0.3
        elif cart_position < -0.5:
            center_bias = -(cart_position + 0.5) * 0.3
        else:
            center_bias = cart_position * 0.3

        # PD control law
        u = -(Kp_theta * pole_angle
              + Kd_theta * pole_angular_velocity
              + Kp_x * (cart_position + center_bias)
              + Kd_x * cart_velocity)

        # Adaptive saturation
        max_force = 3.0 * (0.5 + 0.5 * gain)   # 1.5 N at gain=0, 3 N at gain=1
        if u > max_force:
            force = max_force
