import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    if abs(theta) < 0.02:
        u = -(0.8 * x + 0.4 * x_dot)
        return max(-3.0, min(3.0, u))

    u_lin = -(13.0 * theta + 9.0 * theta_dot + 0.6 * x + 0.3 * x_dot)

    theta_abs = abs(theta)
    scale = 1.0 + 4.0 * (theta_abs - 0.02) / (0.20 - 0.02)
    if scale > 5.0:
        scale = 5.0

    if theta_abs > 0.08:
        boost = -3.0 * math.copysign(1.0, theta) * (theta_abs - 0.08) ** 3
    else:
        boost = 0.0

    u_raw = (u_lin * scale) + boost
    u_soft = 3.0 * math.tanh(u_raw / 3.0)
    action = max(-3.0, min(3.0, u_soft))
    return action

    # fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
