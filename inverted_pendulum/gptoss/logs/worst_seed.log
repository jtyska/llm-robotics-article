import math, random

_theta_int = 0.0
_dt = 0.02  # typical timestep

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    global _theta_int
    # check for non‑finite values
    if (not math.isfinite(cart_position) or not math.isfinite(cart_velocity) or
        not math.isfinite(pole_angle) or not math.isfinite(pole_angular_velocity)):
        return 0.0

    # tilt_norm calculation
    abs_angle = abs(pole_angle)
    if abs_angle <= 0.05:
        tilt_norm = 0.0
    elif abs_angle >= 0.22:
        tilt_norm = 1.0
    else:
        tilt_norm = (abs_angle - 0.05) / (0.22 - 0.05)

    # gains
    Kp_theta = (1 - tilt_norm) * 8.0 + tilt_norm * 35.0
    Kd_theta = (1 - tilt_norm) * 4.0 + tilt_norm * 18.0
    Ki_theta = 0.1

    Kp_cart = (1 - tilt_norm) * 0.9
    Kd_cart = (1 - tilt_norm) * 0.7

    # integral term with clamping
    _theta_int += pole_angle * _dt
    if _theta_int > 0.2:
        _theta_int = 0.2
    elif _theta_int < -0.2:
        _theta_int = -0.2

    # gravity compensation
    u_grav = 9.81 * math.sin(pole_angle)

    # PD+I controller
    u_pd = -(Kp_theta * pole_angle +
             Kd_theta * pole_angular_velocity +
             Ki_theta * _theta_int +
             Kp_cart * cart_position +
             Kd_cart * cart_velocity)

    u_raw = u_pd + u_grav

    # saturate through tanh scaling
    force_raw = 3.0 * math.tanh(u_raw / 2.0)

    # deadzone and final clipping
    if abs(force_raw) < 0.2:
        force = 0.0
    elif force_raw > 3.0:
        force = 3.0
    elif force_raw < -3.0:
        force = -3.0
    else:
        force = force_raw

    # fallback random action (should never be reached)
    if force is None:
        return random.uniform(-3.0, 3.0)
    return force
