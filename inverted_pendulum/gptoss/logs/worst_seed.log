    Kd_theta = 2.0 + 1.0 * tilt_norm          # pole‑angle derivative gain
    Kp_cart  = 0.02 + 0.03 * tilt_norm        # cart‑position proportional gain
    Kd_cart  = 0.03 + 0.04 * tilt_norm        # cart‑velocity derivative gain

    # 3. Gravity feed‑forward (helps the cart move in the direction of the falling pole)
    gravity_ff = 0.85 * 9.81 * sin(theta)

    # 4. Pole PD term (includes a tiny extra damping on theta_dot)
