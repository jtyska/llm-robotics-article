import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Helper functions
    def clamp(val, min_val, max_val):
        return max(min(val, max_val), min_val)
    def sign(val):
        return 1.0 if val > 0 else -1.0 if val < 0 else 0.0

    # Rule 1: non-finite check
    if (not math.isfinite(cart_position) or
        not math.isfinite(pole_angle) or
        not math.isfinite(cart_velocity) or
        not math.isfinite(pole_angular_velocity)):
        return 0.0

    # Rule 2: large angle
    if abs(pole_angle) >= 0.18:
        force = -sign(pole_angle) * 3.0
        return clamp(force, -3.0, 3.0)

    # Rule 3: near upright
    if abs(pole_angle) <= 0.02:
        Kx = 1.0
        Kx_dot = 0.25
        u_pos = -(Kx * cart_position + Kx_dot * cart_velocity)
        return clamp(u_pos, -3.0, 3.0)

    # Rule 4: intermediate angle
    Kθ = 28.0
    Kθ_dot = 7.5
    u_angle = -(Kθ * pole_angle + Kθ_dot * pole_angular_velocity)

    scale_min = 1.0
    scale_max = 1.8
    scale = (scale_min +
             (abs(pole_angle) - 0.02) * (scale_max - scale_min) / (0.18 - 0.02))
    if scale > scale_max:
        scale = scale_max

    Kx_small = 0.05
    Kx_dot_small = 0.01
    u_drift = -(Kx_small * cart_position + Kx_dot_small * cart_velocity)

    raw_force = scale * u_angle + u_drift
    force = clamp(raw_force, -3.0, 3.0)
    return force

    # Default random action (should not be reached)
    return random.uniform(-3.0, 3.0)
