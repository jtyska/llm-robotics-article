def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity
    action = None
    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        action = 0.0
    else:
        abs_theta = abs(theta)
        if abs_theta <= 0.05:
            tilt_norm = 0.0
        elif abs_theta >= 0.18:
            tilt_norm = 1.0
        else:
            tilt_norm = (abs_theta - 0.05) / (0.18 - 0.05)
        Kp_theta = 10.0 + (120.0 - 10.0) * tilt_norm
        Kd_theta = 1.2 + (35.0 - 1.2) * tilt_norm
        Kp_x = 0.20 + (0.80 - 0.20) * tilt_norm
        Kd_x = 0.10 + (0.45 - 0.10) * tilt_norm
        ff_grav = 9.81 * theta
        u = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * x + Kd_x * x_dot + ff_grav) + 0.02
        if tilt_norm < 0.2:
            Fmax = 0.5 + 2.5 * tilt_norm
        else:
            Fmax = 3.0
        force_raw = math.tanh(u / Fmax) * Fmax
        if force_raw > 3.0:
            action = 3.0
        elif force_raw < -3.0:
            action = -3.0
        else:
            action = force_raw
    if action is None:
        return random.uniform(-3.0, 3.0)
    return action
