def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0
    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity
    tilt_raw = (abs(theta) - 0.05) / (0.18 - 0.05)
    if tilt_raw < 0.0:
        tilt_raw = 0.0
    elif tilt_raw > 1.0:
        tilt_raw = 1.0
    tilt = tilt_raw * tilt_raw
    Kp = 30.0 + 120.0 * tilt
    Kd = 2.0 + 12.0 * tilt
    ff_grav = 0.9 * math.sin(theta)
    cart_center = -(0.006 * x + 0.002 * x_dot)
    u = -(Kp * theta + Kd * theta_dot + ff_grav) + cart_center
    force = max(-3.0, min(u, 3.0))
    return force
    return random.uniform(-3.0, 3.0)
