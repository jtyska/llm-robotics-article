def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # time step (assumed)
    dt = 0.02
    # initialize persistent integral term
    if not hasattr(get_action, "pole_int"):
        get_action.pole_int = 0.0
    # check for non‑finite values
    if (not math.isfinite(cart_position) or not math.isfinite(cart_velocity) or
        not math.isfinite(pole_angle) or not math.isfinite(pole_angular_velocity)):
        return 0.0
    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity
    # tilt normalization
    abs_theta = abs(theta)
    if abs_theta <= 0.05:
        tilt_norm = 0.0
    elif abs_theta >= 0.20:
        tilt_norm = 1.0
    else:
        tilt_norm = (abs_theta - 0.05) / (0.20 - 0.05)
    # gains
    Kp_pole = 2.0 + 3.0 * tilt_norm
    Kd_pole = 0.8 + 1.5 * tilt_norm
    Ki_pole = 0.05 * tilt_norm
    Kp_cart = 0.04
    Kd_cart = 0.06
    # PD for pole and gravity feed‑forward
    pole_pd = -(Kp_pole * math.sin(theta) + Kd_pole * theta_dot)
    gravity_ff = 9.81 * math.sin(theta)
    # integral term for pole
    if abs_theta < 0.10:
        get_action.pole_int += theta * dt
    else:
        get_action.pole_int = 0.0
    pole_i = -Ki_pole * get_action.pole_int
    # PD for cart
    cart_pd = -(Kp_cart * x + Kd_cart * x_dot)
    # raw control signal
    u_raw = pole_pd + gravity_ff + pole_i + cart_pd
    force_raw = 3.0 * math.tanh(u_raw)
    # dead‑zone
    if abs(force_raw) < 0.02:
        force = 0.0
    else:
        force = force_raw
    return force
    # fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
