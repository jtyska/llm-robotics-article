import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # helper functions
    def clamp(v, lo, hi):
        return max(lo, min(v, hi))
    def sign(v):
        return 1.0 if v > 0 else -1.0 if v < 0 else 0.0

    # initialize
    force = None

    # Rule 1: non‑finite values
    if (not math.isfinite(cart_position) or
        not math.isfinite(cart_velocity) or
        not math.isfinite(pole_angle) or
        not math.isfinite(pole_angular_velocity)):
        force = 0.0

    # Rule 2: large angle
    elif abs(pole_angle) >= 0.18:
        force = clamp(-sign(pole_angle) * 3.0, -3.0, 3.0)

    # Rule 3: near‑vertical angle
    elif abs(pole_angle) <= 0.02:
        raw = (-0.5) * cart_position + (-1.0) * cart_velocity
        force = clamp(raw, -3.0, 3.0)

    # Rule 4: intermediate angle
    else:
        u_angle = (-10.0) * pole_angle + (-2.5) * pole_angular_velocity
        z = (abs(pole_angle) - 0.02) / (0.18 - 0.02)
        scale = 1.0 + (2.0 - 1.0) * (1.0 / (1.0 + math.exp(-10.0 * (z - 0.5))))
        raw = scale * u_angle
        force = clamp(raw, -3.0, 3.0)

    # Small force threshold
    if force is not None and abs(force) < 0.05:
        force = 0.0

    # Default random action if no rule matched
    if force is None:
        force = random.uniform(-3.0, 3.0)

    return force
