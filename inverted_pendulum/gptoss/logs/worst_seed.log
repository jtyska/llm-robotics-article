import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non-finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Failure condition on pole angle
    if abs(pole_angle) > 0.20:
        return 0.0

    # Main control logic
    theta = pole_angle
    theta_dot = pole_angular_velocity
    x = cart_position
    x_dot = cart_velocity

    if abs(theta) < 0.02:
        s = 0.0
    else:
        s = (abs(theta) - 0.02) / (0.20 - 0.02)  # s ∈ [0,1]

    s3 = s * s * s

    K_theta   = 1.0  + (30.0 - 1.0) * s3   # 1 → 30
    K_theta_d = 0.5  + (12.0 - 0.5) * s3   # 0.5 → 12

    K_x   = 0.80 * (1.0 - s) + 0.10 * s   # 0.80 → 0.10
    K_x_d = 0.40 * (1.0 - s) + 0.20 * s   # 0.40 → 0.20

    u_grav   = -9.8 * math.sin(theta)
    u_angle  = -(K_theta * theta + K_theta_d * theta_dot)
    u_cart   = -(K_x * x + K_x_d * x_dot)

    u_raw = u_angle + u_grav + u_cart
    u_clamped = max(min(u_raw, 3.0), -3.0)

