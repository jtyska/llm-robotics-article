import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non-finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Large angle correction
    if abs(pole_angle) >= 0.16:
        sign = 0.0
        if pole_angle > 0:
            sign = 1.0
        elif pole_angle < 0:
            sign = -1.0
        return -sign * 3.0

    # Linear controller
    Kx = 1.0
    Kx_dot = 0.20
    Ktheta = 30.0
    Ktheta_dot = 8.0

    u_linear = -(Kx * cart_position +
                 Kx_dot * cart_velocity +
                 Ktheta * pole_angle +
                 Ktheta_dot * pole_angular_velocity)

    scale = 1.0 + (abs(pole_angle) / 0.18) * (2.5 - 1.0)
    if scale > 2.5:
        scale = 2.5
    if scale < 1.0:
        scale = 1.0

    force_raw = scale * u_linear

    if force_raw > 2.8:
        force_raw = 2.8 + 0.2 * math.tanh((force_raw - 2.8) / 0.2)
    if force_raw < -2.8:
        force_raw = -2.8 - 0.2 * math.tanh((-force_raw - 2.8) / 0.2)

    if force_raw > 3.0:
        force = 3.0
    elif force_raw < -3.0:
        force = -3.0
    else:
        force = force_raw

    # Default random action (should not be reached)
    if force is None:
        return random.uniform(-3, 3)
    return force
