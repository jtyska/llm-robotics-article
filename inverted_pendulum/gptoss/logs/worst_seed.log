def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random

    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    def clamp(v, lo, hi):
        return max(lo, min(v, hi))

    # 0. Safety
    if not (math.isfinite(x) and math.isfinite(theta) and math.isfinite(x_dot) and math.isfinite(theta_dot)):
        return 0.0

    # 1. Emergency push – pole dangerously tilted
    if abs(theta) >= 0.18:
        sign = math.copysign(1.0, theta) if theta != 0 else 0.0
        force = -sign * 3.0
        return clamp(force, -3.0, 3.0)

    # 2. Near‑vertical region – keep cart centred and damp angular speed
    if abs(theta) <= 0.02:
        cart_term = -(1.5 * x + 0.30 * x_dot)
        angle_damp = -(2.0 * theta_dot)
        force = cart_term + angle_damp
        return clamp(force, -3.0, 3.0)

    # 3. Overlap region – blend cart‑stabiliser with angle‑torque (0.02 < |θ| < 0.06)
    if abs(theta) < 0.06:
        alpha = (abs(theta) - 0.02) / (0.06 - 0.02)  # α ∈ (0,1)
        cart_part = -(1.5 * x + 0.30 * x_dot)
        u_angle = -(35.0 * theta + 9.0 * theta_dot)
        force = (1 - alpha) * cart_part + alpha * u_angle
        return clamp(force, -3.0, 3.0)

    # 4. Moderate tilt – scaled angle‑torque (0.06 ≤ |θ| < 0.18)
    u_angle = -(35.0 * theta + 9.0 * theta_dot)
    scale = 1.0 + (abs(theta) - 0.06) * (2.5 - 1.0) / (0.18 - 0.06)
    scale = clamp(scale, 1.0, 2.5)
    force = scale * u_angle
    return clamp(force, -3.0, 3.0)

    # Default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
