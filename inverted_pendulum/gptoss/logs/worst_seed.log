import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    # 1 Compute tilt (start scaling at |θ| = 0.02)
    tilt_raw = (abs(theta) - 0.02) / (0.20 - 0.02)
    if tilt_raw < 0:
        tilt = 0.0
    elif tilt_raw > 1:
        tilt = 1.0
    else:
        tilt = tilt_raw

    # 2 Pole PD gains
    gain_factor = 1 + 9 * tilt * tilt
    Kp_pole = 12.0 * gain_factor
    Kd_pole = 3.0 * gain_factor

    # 3 Cart‑centering gains
    Kp_cart = 0.8 + 2.2 * tilt * tilt
    Kd_cart = 0.2 + 0.8 * tilt * tilt

    # 4 Feed‑forward angular damping
    ff_gain = 0.5 + 1.5 * tilt

    # 5 Raw control force
    raw_force = (-Kp_pole * theta
                 - Kd_pole * theta_dot
                 - Kp_cart * x
                 - Kd_cart * x_dot
                 - ff_gain * theta_dot)

    # 6 Emergency hard‑push (if outside safe band)
    if abs(theta) >= 0.22:
        if theta > 0:
            sign_theta = 1
        elif theta < 0:
            sign_theta = -1
        else:
            sign_theta = 0
        raw_force = -3.0 * sign_theta - 1.0 * theta_dot

    # 7 Clamp to actuator limits
    if raw_force > 3.0:
        force = 3.0
    elif raw_force < -3.0:
        force = -3.0
    else:
        force = raw_force

    return force

    # default random action (unreachable)
    return random.uniform(-3, 3)
