def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # Check for non-finite inputs
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    theta = pole_angle
    theta_dot = pole_angular_velocity
    x = cart_position
    x_dot = cart_velocity

    theta_abs = abs(theta)
    tilt_norm = (theta_abs - 0.05) / (0.18 - 0.05)
    tilt_norm = max(0.0, min(1.0, tilt_norm))

    Kp = 5.0 + 5.0 * tilt_norm
    Kd = 3.0 + 3.0 * tilt_norm

    pole_PD = -(Kp * math.sin(theta) + Kd * theta_dot)
    gravity_ff = 0.60 * 9.81 * math.sin(theta)
    pole_effort = pole_PD + gravity_ff

    cart_effort = -(0.02 * x + 0.03 * x_dot)

    raw_force = pole_effort + cart_effort
    force_raw = 3.0 * math.tanh(0.30 * raw_force)

    if force_raw > 3.0:
        force = 3.0
    elif force_raw < -3.0:
        force = -3.0
    else:
        force = force_raw

    return force

    # Default random action (should never be reached)
    return random.uniform(-3, 3)
