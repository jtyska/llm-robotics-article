import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    theta = pole_angle
    theta_dot = pole_angular_velocity
    x = cart_position
    x_dot = cart_velocity

    tilt_raw = (abs(theta) - 0.05) / (0.18 - 0.05)
    if tilt_raw < 0.0:
        tilt_raw = 0.0
    if tilt_raw > 1.0:
        tilt_raw = 1.0
    tilt = tilt_raw * tilt_raw

    Kp = 30.0 + 120.0 * tilt
    Kd = 2.0 + 12.0 * tilt
    Kx = 0.004 + 0.006 * tilt
    Kv_cart = 0.001 + 0.003 * tilt

    ff_grav = 0.15 * math.sin(theta)

    u_raw = -(Kp * theta + Kd * theta_dot + ff_grav) - (Kx * x + Kv_cart * x_dot)

    if u_raw > 3.0:
        force = 3.0
    elif u_raw < -3.0:
        force = -3.0
    else:
        force = u_raw

    return force

    # Default random action (should not be reached)
    return random.uniform(-3.0, 3.0)
