import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # Check for non-finite values
    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    # Small angle case
    if abs(theta) < 0.02:
        force = -0.3 * x
        if force > 3.0:
            force = 3.0
        elif force < -3.0:
            force = -3.0
        return force

    # General case
    tilt_raw = (abs(theta) - 0.02) / (0.20 - 0.02)
    tilt_norm = max(0.0, min(tilt_raw, 1.0))
    gain = tilt_norm * tilt_norm

    Kp_theta = 8.0 + (45.0 - 8.0) * gain
    Kd_theta = 1.0 + (10.0 - 1.0) * gain
    Kp_x = 0.10 + (0.40 - 0.10) * gain
    Kd_x = 0.05 + (0.20 - 0.05) * gain

    bias = -0.25 * x

    u = -(Kp_theta * theta +
          Kd_theta * theta_dot +
          Kp_x * (x + bias) +
          Kd_x * x_dot)

    max_force = 0.2 + (3.0 - 0.2) * gain

    if u > max_force:
        force = max_force
    elif u < -max_force:
        force = -max_force
    else:
        force = u

    if force > 3.0:
        force = 3.0
    elif force < -3.0:
        force = -3.0

    return force

    # Fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
