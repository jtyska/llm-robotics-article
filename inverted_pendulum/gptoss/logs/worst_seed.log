def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random

    def is_finite(*vals):
        return all(math.isfinite(v) for v in vals)

    def sign(x):
        return 1.0 if x > 0 else -1.0 if x < 0 else 0.0

    def clamp(v, lo, hi):
        return max(lo, min(hi, v))

    # Rule 1
    if not is_finite(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
        return 0.0

    theta = pole_angle
    theta_abs = abs(theta)

    # Rule 2
    if theta_abs >= 0.18:
        return -sign(theta) * 3.0

    # Rule 3
    if theta_abs <= 0.02:
        raw = -(1.0 * cart_position + 0.25 * cart_velocity)
        return clamp(raw, -3.0, 3.0)

    # Rule 4 (0.02 < |θ| < 0.18)
    scale = 1.0 + (theta_abs - 0.02) * (2.0 - 1.0) / (0.18 - 0.02)
    u_angle = -(30.0 * theta + 8.0 * pole_angular_velocity)
    u_drift = -(0.05 * cart_position + 0.01 * cart_velocity)
    raw = scale * u_angle + u_drift

    if raw > 3.0:
        force = 3.0 + 0.2 * math.tanh((raw - 3.0) / 0.2)
    elif raw < -3.0:
        force = -3.0 - 0.2 * math.tanh((-raw - 3.0) / 0.2)
    else:
        force = raw

    return clamp(force, -3.0, 3.0)

    # Default random action (should not be reached)
    # return random.uniform(-3.0, 3.0)
