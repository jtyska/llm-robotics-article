    #   We use a quadratic curve so that medium tilts get a stronger boost.
    #   g(tilt) = a·tilt_norm² + b·tilt_norm + c   (c = value at tilt_norm=0)
    #   The coefficients were chosen to match the “good” run at tilt_norm≈0.5
    #   while staying modest near zero.

    #   Pole angle PD gains
    Kp_theta ← 20.0 + 180.0 * (tilt_norm**2)          # 20 → 200
    Kd_theta ← 2.0  +  38.0 * (tilt_norm**2)          # 2  → 40

    #   Cart position PD gains (small, just to keep the cart centred)
    Kp_x     ← 0.3  +   0.9 * tilt_norm               # 0.3 → 1.2
    Kd_x     ← 0.15 +   0.45 * tilt_norm              # 0.15→0.6

    # ---- 3. Gravity feed‑forward (approx. m·g·l/2·sinθ) --------------------
    #   The constant 0.12 was tuned to the physical parameters of the
    #   classic OpenAI‑Gym cart‑pole (m_cart≈1 kg, m_pole≈0.1 kg, l≈0.5 m).
    ff_grav ← 0.12 * sin(theta)                       # smoother than 0.1·θ

    # ---- 4. Raw control law ------------------------------------------------
    #   Negative sign because a positive θ (pole leaning right) requires a
    #   force to the right (positive force) to push the cart under the pole.
    u ← -( Kp_theta * theta
           + Kd_theta * theta_dot
           + Kp_x     * x
           + Kd_x     * x_dot
           + ff_grav ) + 0.02                       # tiny bias to break symmetry

    # ---- 5. Adaptive saturation --------------------------------------------
    #   Max admissible force grows with tilt_norm (more aggressive when needed)
    Fmax ← 0.5 + 2.5 * tilt_norm                     # 0.5 → 3.0

