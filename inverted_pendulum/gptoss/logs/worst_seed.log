[2025-08-28 15:50:35] [INFO] ############## LLM Overall strategy code 
def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # Check for finite values
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # 1. absolute angle
    abs_theta = -pole_angle if pole_angle < 0 else pole_angle

    # 2. tilt normalisation (quadratic)
    if abs_theta <= 0.05:
        tilt_norm = 0.0
    elif abs_theta >= 0.20:
        tilt_norm = 1.0
    else:
        linear = (abs_theta - 0.05) / (0.20 - 0.05)  # in (0,1)
        tilt_norm = linear * linear

    # 3. gain‑scheduling
    Kp_theta = 4.0 + (30.0 - 4.0) * tilt_norm
    Kd_theta = 2.0 + (12.0 - 2.0) * tilt_norm
    Kp_cart = 0.02 + (0.10 - 0.02) * tilt_norm
    Kd_cart = 0.03 + (0.12 - 0.03) * tilt_norm

    # 4. pole PD (sin‑space)
    pole_pd = -(Kp_theta * math.sin(pole_angle) + Kd_theta * pole_angular_velocity)

    # 5. gravity feed‑forward
    gravity_ff = 0.60 * 9.81 * math.sin(pole_angle)

    # 6. cart‑gain factor (reduce when pole almost upright)
    temp = abs_theta / 0.07
    cart_gain_factor = 1.0 - 0.5 * math.exp(-(temp * temp))

    # 7. cart PD (always active)
    cart_pd = -(cart_gain_factor * (Kp_cart * cart_position + Kd_cart * cart_velocity))

    # 8. centre bias (only for very small tilt)
    centre_bias = -0.08 * cart_position if abs_theta < 0.07 else 0.0

    # 9. raw command (sum of all contributions)
    raw_force = pole_pd + gravity_ff + cart_pd + centre_bias

    # 10. smooth saturation (tanh)
    force_raw = 3.0 * math.tanh(0.75 * raw_force)

    # 11. final clipping to enforce limits
    if force_raw > 3.0:
        force = 3.0
    elif force_raw < -3.0:
        force = -3.0
    else:
        force = force_raw

    return force
    # default random action (should not be reached)
    return random.uniform(-3, 3)
