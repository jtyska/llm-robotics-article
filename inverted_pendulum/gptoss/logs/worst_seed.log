def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity
    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0
    theta_abs = abs(theta)
    if theta_abs <= 0.05:
        tilt_norm = 0.0
    elif theta_abs >= 0.18:
        tilt_norm = 1.0
    else:
        tilt_norm = (theta_abs - 0.05) / (0.18 - 0.05)
    Kp_theta = 20.0 + 180.0 * (tilt_norm ** 2)
    Kd_theta = 2.0 + 38.0 * (tilt_norm ** 2)
    Kp_x = 0.3 + 0.9 * tilt_norm
    Kd_x = 0.15 + 0.45 * tilt_norm
    ff_grav = 0.12 * math.sin(theta)
    u = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * x + Kd_x * x_dot + ff_grav) + 0.02
    Fmax = 0.5 + 2.5 * tilt_norm
    force_raw = math.tanh(u / Fmax) * Fmax
    if force_raw > 3.0:
        force = 3.0
    elif force_raw < -3.0:
        force = -3.0
    else:
        force = force_raw
    return force
    return random.uniform(-3, 3)
