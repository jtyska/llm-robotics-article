def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0
    else:
        # Normalised tilt
        if abs(theta) <= 0.05:
            tilt_norm = 0.0
        elif abs(theta) >= 0.18:
            tilt_norm = 1.0
        else:
            tilt_norm = (abs(theta) - 0.05) / (0.18 - 0.05)

        # Gain schedule (smoothstep²)
        gain = tilt_norm * tilt_norm * (3.0 - 2.0 * tilt_norm)

        # Interpolated gains
        Kp_theta = 8.0 + (55.0 - 8.0) * gain
        Kd_theta = 1.0 + (12.0 - 1.0) * gain
        Kp_x = 0.12 + (0.35 - 0.12) * gain
        Kd_x = 0.07 + (0.25 - 0.07) * gain

        # Raw control output
        u = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * x + Kd_x * x_dot)

        # Adaptive force envelope
        max_force = 0.8 + 2.2 * tilt_norm

        # Saturated force (tanh scaling)
        force_raw = math.tanh(u / max_force) * max_force

        # Final clipping to physical limits
        if force_raw > 3.0:
            force = 3.0
        elif force_raw < -3.0:
            force = -3.0
        else:
            force = force_raw

        return force

    # Default random action if no rule applies
    return random.uniform(-3, 3)
