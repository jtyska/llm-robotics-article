import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(theta) and math.isfinite(x_dot) and math.isfinite(theta_dot)):
        return 0.0

    if abs(theta) >= 0.20:
        return -3.0 * math.copysign(1.0, theta)

    # scaling factor for angle controller
    if abs(theta) <= 0.02:
        scale = 1.0
    elif abs(theta) >= 0.20:
        scale = 2.0
    else:
        scale = 1.0 + (abs(theta) - 0.02) / (0.20 - 0.02)

    # weight for cart‑position controller
    if abs(theta) <= 0.02:
        cart_weight = 1.0
    elif abs(theta) >= 0.08:
        cart_weight = 0.0
    else:
        cart_weight = 1.0 - (abs(theta) - 0.02) / (0.08 - 0.02)

    # controller terms
    angle_term = -(30.0 * theta + 9.0 * theta_dot)
    cart_term = -(1.0 * x + 0.5 * x_dot)

    raw_force = scale * angle_term + cart_weight * cart_term

    if raw_force > 3.0:
        force = 3.0
    elif raw_force < -3.0:
        force = -3.0
    else:
        force = raw_force

    return force

    # fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
