import random, math

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    if abs(theta) >= 0.18:
        sign = 1.0 if theta > 0 else -1.0 if theta < 0 else 0.0
        return -3.0 * sign

    if abs(theta) <= 0.02:
        raw = -(1.0 * x + 0.5 * x_dot)
        return max(min(raw, 3.0), -3.0)

    # 0.02 < abs(theta) < 0.18
    scale = (abs(theta) - 0.02) / (0.18 - 0.02)  # 0 … 1

    gain_theta = 8.0 + 2.0 * scale          # 8 → 10
    gain_theta_dot = 2.0 + 0.5 * scale      # 2 → 2.5
    gain_cart = 0.5 * (1.0 - 0.5 * scale)   # 0.5 → 0.25
    gain_cart_dot = 0.1 * (1.0 - 0.5 * scale)  # 0.1 → 0.05

    pole_term = gain_theta * theta + gain_theta_dot * theta_dot
    cart_term = gain_cart * x + gain_cart_dot * x_dot

    raw = -(pole_term + cart_term)
    return max(min(raw, 3.0), -3.0)

    # fallback (should never reach here)
    return random.uniform(-3.0, 3.0)
