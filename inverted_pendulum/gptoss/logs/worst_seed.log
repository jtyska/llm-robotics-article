import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    def is_finite(v):
        return math.isfinite(v)

    def clamp(v, lo, hi):
        return max(lo, min(v, hi))

    def sign(v):
        return (v > 0) - (v < 0)

    force = None

    if not (is_finite(x) and is_finite(x_dot) and is_finite(theta) and is_finite(theta_dot)):
        force = 0.0
    elif abs(x) > 1.2:
        excess = clamp(abs(x) - 1.0, 0.0, 0.2)
        force = -sign(x) * 1.5 * excess / 0.2
    else:
        tilt_raw = (abs(theta) - 0.05) / (0.20 - 0.05)
        tilt_raw = clamp(tilt_raw, 0.0, 1.0)
        tilt = tilt_raw * tilt_raw

        Kp_theta = 20.0 + 130.0 * tilt
        Kd_theta = 1.5 + 8.5 * tilt
        Kp_x = 0.015 + 0.045 * tilt
        Kd_x = 0.003 + 0.021 * tilt

        ff_grav = 0.45 * math.sin(theta)

        u_raw = -(Kp_theta * theta +
                  Kd_theta * theta_dot +
                  Kp_x * x +
                  Kd_x * x_dot +
                  ff_grav)

        force = clamp(u_raw, -3.0, 3.0)

    if force is None:
        return random.uniform(-3.0, 3.0)
    return force
