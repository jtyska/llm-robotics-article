import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # Check for non-finite values
    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    # Failure condition handling
    if abs(theta) >= 0.20:
        return -math.copysign(1.0, theta) * 3.0

    # Compute gain scale
    abs_theta = abs(theta)
    if abs_theta <= 0.02:
        scale = 1.0
    elif abs_theta >= 0.15:
        scale = 2.5
    else:
        rel = (abs_theta - 0.02) / (0.15 - 0.02)  # 0 … 1
        scale = 1.0 + rel * (2.5 - 1.0)           # linear interpolation

    # Angle PD term
    u_angle = -(22.0 * theta + 3.5 * theta_dot)

    # Optional cart PD term
    if abs_theta <= 0.05:
        u_cart = -(0.9 * x + 0.12 * x_dot)
    else:
        u_cart = 0.0

    # Combine
    raw_force = scale * u_angle + u_cart

    # Smooth saturation
    action = 3.0 * math.tanh(raw_force / 3.0)

    # Default random action (fallback)
    return action if action is not None else random.uniform(-3.0, 3.0)
