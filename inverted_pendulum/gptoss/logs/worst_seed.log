def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    dt = 0.02
    # initialize integral storage on first call
    if not hasattr(get_action, "pole_int"):
        get_action.pole_int = 0.0
    # finite check
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    # 1. Normalised tilt
    theta = pole_angle
    theta_dot = pole_angular_velocity
    x = cart_position
    x_dot = cart_velocity
    if abs(theta) <= 0.05:
        tilt_norm = 0.0
    elif abs(theta) >= 0.20:
        tilt_norm = 1.0
    else:
        tilt_norm = (abs(theta) - 0.05) / (0.20 - 0.05)
    # 2. Gain scheduling
    Kp_pole = 2.0 + (6.5 - 2.0) * tilt_norm
    Kd_pole = 0.8 + (3.5 - 0.8) * tilt_norm
    Ki_pole = 0.0 + (0.12 - 0.0) * tilt_norm
    Kp_cart = 0.10
    Kd_cart = 0.15
    # 3. Integral term (anti‑windup)
    if abs(theta) < 0.10:
        get_action.pole_int += theta * dt
    else:
        get_action.pole_int = 0.0
    pole_i = - Ki_pole * get_action.pole_int
    # 4. PD terms
    pole_pd = -(Kp_pole * math.sin(theta) + Kd_pole * theta_dot)
    cart_pd = -(Kp_cart * x + Kd_cart * x_dot)
    # 5. Gravity feed‑forward
    gravity_ff = 9.81 * math.sin(theta)
    # 6. Raw control signal
    u_raw = pole_pd + gravity_ff + pole_i + cart_pd
    # 7. Smooth saturation
    force_raw = 3.0 * math.tanh(u_raw)
    # 8. Dead‑zone
    if abs(force_raw) < 0.02:
        force = 0.0
    else:
        force = force_raw
    return force if force is not None else random.uniform(-3.0, 3.0)
