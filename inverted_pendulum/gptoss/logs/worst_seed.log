```text
# --------------------------------------------------------------
#  CART‑POLE BALANCING CONTROLLER
# --------------------------------------------------------------
# INPUT  :  x, x_dot, theta, theta_dot   (float, may be any real)
# OUTPUT :  force ∈ [‑3.0 , 3.0]  (float, N)
# --------------------------------------------------------------

function clamp(v, lo, hi):
    if v < lo: return lo
    if v > hi: return hi
    return v

function is_finite(v):
    return (v == v) and (v != float('inf')) and (v != float('-inf'))

# ---------- 1. safety check ----------
if not (is_finite(x) and is_finite(x_dot) and
        is_finite(theta) and is_finite(theta_dot)):
    return 0.0

# ---------- 2. dead‑zone (pole almost upright) ----------
#   When the pole is within ±0.02 rad we only care about keeping the
#   cart near the centre.  The pole will stay upright by inertia.
if abs(theta) < 0.02:
    # small PD on cart position only (no theta terms)
    kx      = -0.8      # proportional on cart position
    kx_dot  = -0.4      # derivative on cart velocity
    u = kx * x + kx_dot * x_dot
    return clamp(u, -3.0, 3.0)

# ---------- 3. angle‑dependent scaling ----------
#   The farther the pole is from vertical, the larger the gain,
#   but we keep the maximum gain modest (≈ 2.0) to avoid saturation.
theta_abs = abs(theta)

# linear scaling: 1.0 at 0.02 rad → 2.0 at 0.20 rad
scale = 1.0 + (theta_abs - 0.02) / (0.20 - 0.02)   # = 1 + (θ‑0.02)/0.18
if scale > 2.0:   # hard cap
    scale = 2.0

# ---------- 4. full linear feedback ----------
#   Classic LQR‑style gains (tuned for the classic cart‑pole):
k_theta      = -13.0   # proportional on pole angle
k_theta_dot  = -8.5    # derivative on pole angular velocity
k_x          = -0.6    # small correction for cart position
k_x_dot      = -0.2    # small correction for cart velocity

u_raw = (k_theta      * theta      +
         k_theta_dot  * theta_dot  +
         k_x          * x          +
         k_x_dot      * x_dot)

# apply the angle‑dependent scaling
u_scaled = scale * u_raw

# ---------- 5. smooth clipping ----------
#   tanh gives a soft saturation, then we enforce the hard limits.
u_soft = 3.0 * tanh(u_scaled / 3.0)

force = clamp(u_soft, -3.0, 3.0)
return force
```

