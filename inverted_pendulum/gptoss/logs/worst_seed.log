import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    abs_theta = abs(theta)
    if abs_theta <= 0.02:
        scale = 1.0
    elif abs_theta <= 0.10:
        scale = 1.0 + 0.3 * (abs_theta - 0.02) / (0.10 - 0.02)
    else:
        scale = 1.3

    u_raw = -(13.0 * theta + 8.5 * theta_dot + 0.6 * x + 0.2 * x_dot)
    u_scaled = scale * u_raw
    u_soft = 3.0 * math.tanh(u_scaled / 3.0)

    if u_soft > 3.0:
        force = 3.0
    elif u_soft < -3.0:
        force = -3.0
    else:
        force = u_soft

    return force

    # Default fallback (should never be reached)
    return random.uniform(-3, 3)
