import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    if abs(theta) <= 0.05:
        tilt_raw = 0.0
    elif abs(theta) >= 0.18:
        tilt_raw = 1.0
    else:
        tilt_raw = (abs(theta) - 0.05) / (0.18 - 0.05)

    tilt_gain = tilt_raw ** 3

    Kp_theta = 4.0 + 8.0 * tilt_gain
    Kd_theta = 2.0 + 5.0 * tilt_gain
    pole_effort = -(Kp_theta * theta + Kd_theta * theta_dot)

    Kp_x = 0.20 * (1.0 - tilt_raw) + 0.02
    Kd_x = 0.04 * (1.0 - tilt_raw) + 0.004
    centre_bias = -(Kp_x * x + Kd_x * x_dot)

    vel_damp = -0.03 * x_dot

    if abs(x_dot) > 0.5:
        ff_brake = -0.30 * math.copysign(1.0, x_dot)
    else:
        ff_brake = 0.0

    raw_force = pole_effort + centre_bias + vel_damp + ff_brake
    action = 3.0 * math.tanh(0.35 * raw_force)

    if action > 3.0:
        action = 3.0
    elif action < -3.0:
        action = -3.0

    return action if action is not None else random.uniform(-3.0, 3.0)
