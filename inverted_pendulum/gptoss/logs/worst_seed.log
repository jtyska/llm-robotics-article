import random, math

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0

    theta = pole_angle
    theta_dot = pole_angular_velocity
    x = cart_position
    x_dot = cart_velocity

    tilt_raw = (abs(theta) - 0.05) / (0.18 - 0.05)
    if tilt_raw < 0.0:
        tilt = 0.0
    elif tilt_raw > 1.0:
        tilt = 1.0
    else:
        tilt = tilt_raw

    Kp_theta = 8.0 + 120.0 * tilt * tilt
    Kd_theta = 2.5 + 25.0 * tilt * tilt
    Kp_cart = 0.6 + 1.8 * tilt
    Kd_cart = 0.15 + 0.6 * tilt

    ff_gain = 0.4 + 1.2 * tilt
    ff_term = -ff_gain * theta_dot

    force_raw = (Kp_theta * (-theta) + Kd_theta * (-theta_dot) +
                 Kp_cart * (-x) + Kd_cart * (-x_dot) + ff_term)

    if force_raw > 3.0:
        force = 3.0
    elif force_raw < -3.0:
        force = -3.0
    else:
        force = force_raw

    return force if force is not None else random.uniform(-3, 3)
