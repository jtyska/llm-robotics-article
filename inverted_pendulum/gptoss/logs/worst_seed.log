import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # initialize persistent integral term
    if not hasattr(get_action, "theta_int"):
        get_action.theta_int = 0.0

    # check finiteness
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # tilt normalization
    abs_theta = abs(pole_angle)
    if abs_theta <= 0.05:
        tilt_norm = 0.0
    elif abs_theta >= 0.22:
        tilt_norm = 1.0
    else:
        tilt_norm = (abs_theta - 0.05) / (0.22 - 0.05)

    # gains interpolation
    Kp_theta = (1 - tilt_norm) * 8.0 + tilt_norm * 35.0
    Kd_theta = (1 - tilt_norm) * 4.0 + tilt_norm * 18.0
    Kp_x     = (1 - tilt_norm) * 0.2 + tilt_norm * 0.9
    Kd_x     = (1 - tilt_norm) * 0.2 + tilt_norm * 0.7

    # integral term update with clamping
    get_action.theta_int += pole_angle * 0.02
    if get_action.theta_int > 0.15:
        get_action.theta_int = 0.15
    elif get_action.theta_int < -0.15:
        get_action.theta_int = -0.15

    # control law
    u_grav = 9.81 * math.sin(pole_angle)
    u_pd = -(Kp_theta * pole_angle +
             Kd_theta * pole_angular_velocity +
             0.05 * get_action.theta_int +
             Kp_x * cart_position +
             Kd_x * cart_velocity)
    u_raw = u_pd + u_grav

    # force saturation via tanh
    force_raw = 3.0 * math.tanh(u_raw / 1.0)
    force = force_raw

    return force if math.isfinite(force) else random.uniform(-3.0, 3.0)
