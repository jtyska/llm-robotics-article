import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        force = 0.0
        return force

    # Normalised tilt
    abs_theta = abs(theta)
    if abs_theta <= 0.05:
        tilt_norm = 0.0
    elif abs_theta >= 0.20:
        tilt_norm = 1.0
    else:
        tilt_norm = (abs_theta - 0.05) / (0.20 - 0.05)

    # Gain‑schedule
    tilt_sq = tilt_norm * tilt_norm
    Kp_theta = 15.0 + 185.0 * tilt_sq
    Kd_theta = 2.0 + 48.0 * tilt_sq
    Kp_x = 0.20 + 0.90 * tilt_norm
    Kd_x = 0.10 + 0.45 * tilt_norm

    # Gravity feed‑forward
    ff_grav = 0.48 * math.sin(theta)

    # Raw control signal
    u = -(Kp_theta * theta
          + Kd_theta * theta_dot
          + Kp_x * x
          + Kd_x * x_dot
          + ff_grav) + 0.02

    # Adaptive force limit
    Fmax = 0.5 + 2.5 * tilt_norm
    if Fmax > 3.0:
        Fmax = 3.0

    # Smooth saturation
    force_raw = math.tanh(u / Fmax) * Fmax

    # Final hard clip
    if force_raw > 3.0:
        force = 3.0
    elif force_raw < -3.0:
        force = -3.0
    else:
        force = force_raw

    return force

    # Default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
