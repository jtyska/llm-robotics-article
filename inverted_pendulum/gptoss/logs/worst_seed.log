def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        force = 0.0
    elif abs(theta) < 0.02:
        force = -0.8 * x - 0.4 * x_dot
        force = max(min(force, 3.0), -3.0)
    else:
        scale = 1.0 + (abs(theta) - 0.02) / (0.20 - 0.02)
        if scale > 2.0:
            if abs(theta) > 0.15:
                scale = 2.5
            else:
                scale = 2.0
        u_raw = -(15.0 * theta + 10.0 * theta_dot + 0.3 * x + 0.1 * x_dot)
        u_scaled = scale * u_raw
        u_soft = 3.0 * math.tanh(u_scaled / 3.0)
        force = max(min(u_soft, 3.0), -3.0)

    if 'force' in locals():
        return force
    return random.uniform(-3.0, 3.0)
