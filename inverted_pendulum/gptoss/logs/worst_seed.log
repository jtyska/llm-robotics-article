import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(theta) and math.isfinite(x_dot) and math.isfinite(theta_dot)):
        return 0.0

    if abs(theta) >= 0.18:
        sign = math.copysign(1, theta)
        return -sign * 3.0

    # compute scale
    if abs(theta) <= 0.02:
        scale = 1.0
    else:
        scale = 1.0 + ((abs(theta) - 0.02) / (0.18 - 0.02)) * 0.5

    u = -(13.0 * theta + 2.5 * theta_dot + 0.9 * x + 0.7 * x_dot)
    raw_force = scale * u

    if raw_force > 3.0:
        force = 3.0
    elif raw_force < -3.0:
        force = -3.0
    else:
        force = raw_force

    return force

    # fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
