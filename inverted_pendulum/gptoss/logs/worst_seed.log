def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    else:
        theta_abs = abs(pole_angle)
        tilt_norm = (theta_abs - 0.05) / (0.18 - 0.05)
        if tilt_norm < 0.0:
            tilt_norm = 0.0
        if tilt_norm > 1.0:
            tilt_norm = 1.0
        Kp_theta = 4.0 + 3.0 * tilt_norm
        Kd_theta = 2.5 + 2.0 * tilt_norm
        pole_PD = -(Kp_theta * math.sin(pole_angle) + Kd_theta * pole_angular_velocity)
        gravity_ff = 0.5 * 9.81 * math.sin(pole_angle)
        pole_effort = pole_PD + gravity_ff
        cart_effort = -0.20 * cart_position - 0.03 * cart_velocity
        raw_force = pole_effort + cart_effort
        force = 3.0 * math.tanh(0.45 * raw_force)
        if force > 3.0:
            force = 3.0
        if force < -3.0:
            force = -3.0
    return force
    return random.uniform(-3, 3)
