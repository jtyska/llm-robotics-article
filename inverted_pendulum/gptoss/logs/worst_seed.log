def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # Rule 1: non‑finite check
    if not all(map(math.isfinite, [cart_position, pole_angle, cart_velocity, pole_angular_velocity])):
        return 0.0

    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity
    abs_theta = abs(theta)

    # Rule 2
    if abs_theta >= 0.18:
        force = -math.copysign(1.0, theta) * 3.0
        return max(-3.0, min(3.0, force))

    # Rule 3
    if abs_theta <= 0.02:
        force = -(1.2 * x + 0.30 * x_dot)
        return max(-3.0, min(3.0, force))

    # Rule 4
    if abs_theta >= 0.15:
        scale = 1 + (abs_theta - 0.02) / (0.18 - 0.02)
        scale = max(1.0, min(2.5, scale))
        force = scale * -(35.0 * theta + 9.0 * theta_dot)
        return max(-3.0, min(3.0, force))

    # Rule 5 (0.02 < |θ| < 0.15)
    if 0.02 < abs_theta < 0.15:
        w_angle = (abs_theta - 0.02) / (0.15 - 0.02)
        # blend between position‑based and angle‑based controllers
        force_pos = -(1.2 * x + 0.30 * x_dot)
        force_ang = -(35.0 * theta + 9.0 * theta_dot)
        force = (1 - w_angle) * force_pos + w_angle * force_ang
        return max(-3.0, min(3.0, force))

    # default random action
    return random.uniform(-3.0, 3.0)
