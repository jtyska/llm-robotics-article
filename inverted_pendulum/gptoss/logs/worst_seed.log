def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0
    tilt_raw = (abs(pole_angle) - 0.05) / (0.18 - 0.05)
    tilt_raw = max(0.0, min(1.0, tilt_raw))
    tilt = tilt_raw * tilt_raw
    Kp = 30.0 + 70.0 * tilt
    Kd = 2.0 + 8.0 * tilt
    ff_grav = 0.45 * math.sin(pole_angle)
    cart_center = -(0.005 * cart_position + 0.001 * cart_velocity)
    u = -(Kp * pole_angle + Kd * pole_angular_velocity + ff_grav) + cart_center
    force = max(-3.0, min(3.0, u))
    return force
    return random.uniform(-3, 3)
