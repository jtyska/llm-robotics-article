import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # helper functions
    def clamp(val, lo, hi):
        return max(lo, min(val, hi))
    def sign(val):
        return 1.0 if val > 0 else -1.0 if val < 0 else 0.0

    # check for non‑finite values
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # failure angle condition
    if pole_angle <= -0.20 or pole_angle >= 0.20:
        return 0.0

    # Normalised tilt (dead‑zone = 0.03 rad)
    tilt_raw = (abs(pole_angle) - 0.03) / (0.20 - 0.03)
    tilt = clamp(tilt_raw, 0.0, 1.0)

    # Quadratic gain schedule
    Kp_pole = 4.0 + 8.0 * tilt * tilt          # 4 → 12
    Kd_pole = 1.0 + 2.0 * tilt * tilt          # 1 → 3
    Kp_cart = 0.08 + 0.12 * tilt * tilt        # 0.08 → 0.20
    Kd_cart = 0.02 + 0.03 * tilt * tilt        # 0.02 → 0.05

    # PD terms
    pole_pd = -Kp_pole * pole_angle - Kd_pole * pole_angular_velocity
    cart_pd = -Kp_cart * cart_position - Kd_cart * cart_velocity

    # Tiny assist term (max ≈ 0.3 N)
    assist = -0.3 * sign(pole_angle) * tilt

    # Combine and clamp
    raw_force = pole_pd + cart_pd + assist
    force = clamp(raw_force, -3.0, 3.0)

    # fallback (should never be reached)
    if force is None:
        return random.uniform(-3.0, 3.0)
    return force
