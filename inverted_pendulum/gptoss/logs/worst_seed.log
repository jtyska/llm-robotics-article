[2025-08-28 14:59:16] [INFO] ############## LLM Overall strategy code 
def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # Check for non‑finite inputs
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    theta = pole_angle
    # Normalise tilt
    if abs(theta) <= 0.05:
        tilt = 0.0
    elif abs(theta) >= 0.18:
        tilt = 1.0
    else:
        tilt_raw = (abs(theta) - 0.05) / (0.18 - 0.05)
        tilt = max(0.0, min(tilt_raw, 1.0))

    # Gain schedule
    Kp_pole = 4.0 + 76.0 * tilt * tilt
    Kd_pole = 1.0 + 19.0 * tilt * tilt
    Kp_cart = 0.02 + 0.08 * tilt * tilt
    Kd_cart = 0.005 + 0.02 * tilt * tilt

    # PD terms
    pole_pd = -Kp_pole * theta - Kd_pole * pole_angular_velocity
    cart_pd = -Kp_cart * cart_position - Kd_cart * cart_velocity

    # Phase‑aware feed‑forward
    ff_gain = 1.2 * tilt
    sign_theta = 1.0 if theta > 0 else (-1.0 if theta < 0 else 0.0)
    ff_term = -ff_gain * pole_angular_velocity * sign_theta

    # Combine and saturate
    raw_force = pole_pd + cart_pd + ff_term
    force = max(-3.0, min(raw_force, 3.0))
    return force

    # Default random action (fallback)
    return random.uniform(-3.0, 3.0)
