import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    def sign(v):
        return 1.0 if v > 0 else -1.0 if v < 0 else 0.0

    # Check for non‑finite values
    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    # Large angle correction
    if abs(theta) >= 0.15:
        raw = -3.0 * sign(theta) - 0.5 * sign(theta_dot)
        force = max(min(raw, 3.0), -3.0)
        return force

    # PD control for smaller angles
    if abs(theta) <= 0.02:
        k_theta = 8.0
        k_thetad = 2.0
    else:
        alpha = (abs(theta) - 0.02) / (0.15 - 0.02)
        k_theta = 8.0 + alpha * (20.0 - 8.0)      # 8 → 20
        k_thetad = 2.0 + alpha * (6.0 - 2.0)      # 2 → 6

    pole_pd = -(k_theta * theta + k_thetad * theta_dot)

    if abs(theta) <= 0.02:
        cart_pd = -(0.5 * x + 0.1 * x_dot)
    else:
        cart_pd = -(0.2 * x + 0.05 * x_dot)

    raw = pole_pd + cart_pd

    if abs(raw) > 3.0:
        force = 3.0 * sign(raw)
    else:
        force = raw

    return force

    # Default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
