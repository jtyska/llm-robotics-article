import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # Check for non‑finite inputs
    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    # Compute tilt factor
    norm = (abs(theta) - 0.04) / (0.20 - 0.04)
    if norm < 0.0:
        tilt = 0.0
    elif norm > 1.0:
        tilt = 1.0
    else:
        tilt = norm

    # Gains and terms
    gain_factor = 1.0 + 8.0 * tilt * tilt
    Kp_pole = 10.0 * gain_factor
    Kd_pole = 2.5 * gain_factor
    Kp_cart = 0.6 + 1.5 * tilt * tilt
    Kd_cart = 0.15 + 0.6 * tilt * tilt
    ff_gain = 0.3 + 0.9 * tilt
    ff_term = -ff_gain * theta_dot

    # Integral term (stateful across calls)
    if not hasattr(get_action, "integral_theta"):
        get_action.integral_theta = 0.0
    get_action.integral_theta = 0.995 * get_action.integral_theta + theta * 0.02
    Ki_pole = 0.4 * tilt
    int_term = -Ki_pole * get_action.integral_theta

    # Raw force computation
    raw_force = -Kp_pole * theta
    raw_force -= Kd_pole * theta_dot
    raw_force -= Kp_cart * x
    raw_force -= Kd_cart * x_dot
    raw_force += ff_term
    raw_force += int_term

    # Override for large angles
    if abs(theta) >= 0.22:
        sign = math.copysign(1.0, theta) if theta != 0 else 0.0
        raw_force = -3.0 * sign - 1.0 * theta_dot

    # Clamp to action limits
    force = max(min(raw_force, 3.0), -3.0)
    return force if math.isfinite(force) else random.uniform(-3.0, 3.0)
