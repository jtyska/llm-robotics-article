import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # persistent integral term
    if not hasattr(get_action, "theta_int"):
        get_action.theta_int = 0.0

    # default random action
    action = random.uniform(-3, 3)

    # check for finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        action = 0.0
        return action

    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity

    # tilt normalization
    if abs(theta) > 0.05:
        tilt_norm = min((abs(theta) - 0.05) / (0.22 - 0.05), 1.0)
    else:
        tilt_norm = 0.0

    blend = 0.2 * tilt_norm

    Kp_theta = (1 - blend) * 8.0 + blend * 35.0
    Kd_theta = (1 - blend) * 4.0 + blend * 18.0
    Kp_x = (1 - blend) * 0.2 + blend * 0.9
    Kd_x = (1 - blend) * 0.2 + blend * 0.7

    # integral update with clamping
    get_action.theta_int += theta * 0.02
    get_action.theta_int = max(-0.15, min(0.15, get_action.theta_int))
    theta_int = get_action.theta_int

    u_grav = 9.81 * math.sin(theta)

    u_pd = -(Kp_theta * theta +
             Kd_theta * theta_dot +
             0.05 * theta_int +
             Kp_x * x +
             Kd_x * x_dot)

    u_raw = u_pd + u_grav
    force_raw = 3.0 * math.tanh(u_raw / 1.0)

    if abs(force_raw) < 0.02:
        force = 0.0
    else:
        force = force_raw

    # clamp to allowed range
    action = max(-3.0, min(3.0, force))
    return action
