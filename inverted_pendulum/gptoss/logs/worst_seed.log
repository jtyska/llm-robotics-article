Kd_pole ← 1.0  + 19.0 * tilt * tilt      // 1 → 20
Kp_cart ← 0.02 + 0.08 * tilt * tilt      // 0.02 → 0.10
Kd_cart ← 0.005+ 0.02 * tilt * tilt      // 0.005 → 0.025

/* --------------------------------------------------------------
   3. PD terms
   -------------------------------------------------------------- */
pole_pd  ← -Kp_pole * theta - Kd_pole * theta_dot
cart_pd  ← -Kp_cart * x     - Kd_cart * x_dot

