def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity

    force = None

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        force = 0.0
    else:
        if abs(theta) < 0.015:
            u = -(0.8 * x + 0.4 * x_dot)
        else:
            u_base = -(0.5 * x + 0.1 * x_dot + 12.0 * theta + 8.0 * theta_dot)
            gain = 1.0 + 2.0 * (abs(theta) - 0.015) / (0.20 - 0.015)
            if gain > 3.0:
                gain = 3.0
            u = gain * u_base

        u_soft = 3.0 * math.tanh(u / 3.0)

        if u_soft > 3.0:
            force = 3.0
        elif u_soft < -3.0:
            force = -3.0
        else:
            force = u_soft

    if force is None:
        return random.uniform(-3, 3)
    return force
