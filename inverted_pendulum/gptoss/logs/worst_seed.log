def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity
    abs_theta = abs(theta)
    tilt_norm = (abs_theta - 0.05) / (0.18 - 0.05)
    if tilt_norm < 0.0:
        tilt_norm = 0.0
    elif tilt_norm > 1.0:
        tilt_norm = 1.0
    Kp_theta = 6.0 + 10.0 * tilt_norm
    Kd_theta = 1.0 + 7.0 * tilt_norm
    Kp_x = 0.05 + 0.35 * tilt_norm
    Kd_x = 0.1 + 0.4 * tilt_norm
    u_raw = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * x + Kd_x * x_dot - 0.1 * x) + 9.81 * math.sin(theta)
    force_raw = 3.0 * math.tanh(u_raw / 2.5)
    if abs(force_raw) < 0.02:
        force = 0.0
    else:
        force = force_raw
    if force is None:
        force = random.uniform(-3, 3)
    return force
