    # 1)  Pure‑cart PD when the pole is almost upright
    # ------------------------------------------------------------------
    IF |θ| < 0.02 THEN
        # Cart‑only stabiliser (PD on position & velocity)
        u_cart ← -(Kx   * x   + Kx_dot * x_dot)   # Kx = 0.8, Kx_dot = 0.4
        force  ← clamp(u_cart, -3.0, 3.0)

    # ------------------------------------------------------------------
    # 2)  Angle‑dominant LQR‑like controller with gentle scaling
    # ------------------------------------------------------------------
    ELSE
        # LQR‑style feedback on angle & angular velocity
        u_angle ← -(Kθ   * θ   + Kθ_dot * θ_dot)   # Kθ = 10.0, Kθ_dot = 2.5

        # Cart‑feedback is still useful but we keep its influence
        # constant (no extra fade‑out).  It helps keep the cart near 0.
        u_cart  ← -(Kx   * x   + Kx_dot * x_dot)

        # Linear scaling that grows from 1 at |θ| = 0.02 to 2 at |θ| = 0.20
        θ_abs   ← |θ|
        scale   ← 1.0 + (θ_abs - 0.02) / (0.20 - 0.02)   # = 1 + (θ_abs‑0.02)/0.18
        IF scale < 1.0 THEN scale ← 1.0
        IF scale > 2.0 THEN scale ← 2.0

        raw_force ← scale * (u_angle + u_cart)

        force ← clamp(raw_force, -3.0, 3.0)
    END IF
END IF
