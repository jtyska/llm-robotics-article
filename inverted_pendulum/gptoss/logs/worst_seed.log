    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    # tilt normalisation
    tilt_abs = abs(theta)
    tilt_norm_raw = (tilt_abs - 0.05) / (0.18 - 0.05)
    if tilt_norm_raw < 0.0:
        tilt_norm = 0.0
    elif tilt_norm_raw > 1.0:
        tilt_norm = 1.0
    else:
        tilt_norm = tilt_norm_raw

    # gain scheduling
    Kp_theta_safe, Kd_theta_safe = 12.0, 8.0
    Kp_x_safe, Kd_x_safe = 0.5, 0.5
    Kp_theta_aggr, Kd_theta_aggr = 30.0, 20.0
    Kp_x_aggr, Kd_x_aggr = 1.5, 1.2

    Kp_theta = (1.0 - tilt_norm) * Kp_theta_safe + tilt_norm * Kp_theta_aggr
    Kd_theta = (1.0 - tilt_norm) * Kd_theta_safe + tilt_norm * Kd_theta_aggr
    Kp_x = (1.0 - tilt_norm) * Kp_x_safe + tilt_norm * Kp_x_aggr
    Kd_x = (1.0 - tilt_norm) * Kd_x_safe + tilt_norm * Kd_x_aggr

    # emergency boost
    if tilt_abs > 0.18:
        boost_factor = (tilt_abs - 0.18) / (0.20 - 0.18)
        boost = 8.0 * boost_factor * (1 if theta > 0 else -1 if theta < 0 else 0)
    else:
        boost = 0.0

    # raw control law
    u_raw = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * x + Kd_x * x_dot) + boost

    # gravity compensation
    u_raw += 9.81 * math.sin(theta)

    # map to admissible force
    force_unclipped = 3.0 * math.tanh(u_raw / 2.0)
    if force_unclipped > 3.0:
        force = 3.0
    elif force_unclipped < -3.0:
        force = -3.0
    else:
        force = force_unclipped

    return force

    # default random action if no rule applies
    return random.uniform(-3.0, 3.0)
