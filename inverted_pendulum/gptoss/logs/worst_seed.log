import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Helper functions
    def clamp(val, low, high):
        return max(low, min(high, val))
    def sign(x):
        return 1.0 if x > 0 else -1.0 if x < 0 else 0.0

    # Rule 1: non‑finite check
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Rule 2: angle beyond limit
    if abs(pole_angle) >= 0.20:
        force = clamp(-sign(pole_angle) * 3.0, -3.0, 3.0)
        return force

    # Rule 3: LQR‑based control with scaling
    K_theta = 16.0
    K_theta_dot = 3.0
    K_x = 0.6
    K_x_dot = 0.5

    u_base = -(K_theta * pole_angle +
               K_theta_dot * pole_angular_velocity +
               K_x * cart_position +
               K_x_dot * cart_velocity)

    theta_abs = abs(pole_angle)

    if theta_abs <= 0.01:
        scale = 1.0
    else:
        alpha = (theta_abs - 0.01) / (0.18 - 0.01)  # 0 ≤ α ≤ 1
        scale = 1.0 + 1.5 * (alpha ** 2)
        scale = clamp(scale, 1.0, 2.5)

    raw_force = scale * u_base
    force = clamp(raw_force, -3.0, 3.0)
    return force

    # Fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
