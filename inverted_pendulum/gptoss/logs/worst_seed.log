import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x, theta, x_dot, theta_dot = cart_position, pole_angle, cart_velocity, pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    if abs(theta) >= 0.18:
        sign = math.copysign(1.0, theta) if theta != 0 else 0.0
        action = -sign * 3.0
        action = max(min(action, 3.0), -3.0)
        return action

    # compute blending weight
    w = (abs(theta) - 0.02) / (0.18 - 0.02)
    w = max(min(w, 1.0), 0.0)
    w = w * w * (3.0 - 2.0 * w)  # smoothstep

    # PD terms
    u_angle = -(16.0 * theta + 3.5 * theta_dot)
    u_cart = -(1.2 * x + 0.4 * x_dot)

    # blended force
    raw_force = (1.0 - w) * u_cart + w * u_angle
    action = max(min(raw_force, 3.0), -3.0)

    if abs(action) < 0.001:
        action = 0.0

    return action

    # fallback random action (should never be reached)
    return random.uniform(-3.0, 3.0)
