def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    abs_theta = abs(theta)
    if abs_theta <= 0.04:
        tilt_norm = 0.0
    elif abs_theta >= 0.18:
        tilt_norm = 1.0
    else:
        tilt_norm = (abs_theta - 0.04) / (0.18 - 0.04)

    Kp_theta = 25.0 + 95.0 * tilt_norm
    Kd_theta = 2.5 + 37.5 * tilt_norm
    Kp_x = 0.35 + 0.85 * tilt_norm
    Kd_x = 0.15 + 0.45 * tilt_norm

    u = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * x + Kd_x * x_dot) + 0.02
    Fmax = 0.4 + 2.1 * tilt_norm
    force_raw = math.tanh(u / Fmax) * Fmax

    if force_raw > 3.0:
        force = 3.0
    elif force_raw < -3.0:
        force = -3.0
    else:
        force = force_raw

    return force

    # Default random action if no rule applies (unreachable in current logic)
    return random.uniform(-3.0, 3.0)
