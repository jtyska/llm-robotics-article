[2025-08-28 16:48:38] [INFO] ############## LLM Overall strategy code 
def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    force = None
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    else:
        u = -(35.0 * pole_angle + 6.0 * pole_angular_velocity) - (0.5 * cart_position + 0.1 * cart_velocity)
        if u > 3.0:
            force = 3.0
        elif u < -3.0:
            force = -3.0
        elif abs(u) < 0.02:
            force = 0.0
        else:
            force = u
    if force is None:
        return random.uniform(-3, 3)
    return force
