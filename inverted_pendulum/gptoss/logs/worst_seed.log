def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0
    theta = pole_angle
    theta_dot = pole_angular_velocity
    x = cart_position
    x_dot = cart_velocity
    if abs(theta) <= 0.05:
        tilt_norm = 0.0
    elif abs(theta) >= 0.20:
        tilt_norm = 1.0
    else:
        tilt_norm = (abs(theta) - 0.05) / 0.15
    Kp_theta = (1 - tilt_norm) * 8.0 + tilt_norm * 35.0
    Kd_theta = (1 - tilt_norm) * 4.0 + tilt_norm * 18.0
    Kp_x = (1 - tilt_norm) * 0.05 + tilt_norm * 0.30
    Kd_x = (1 - tilt_norm) * 0.05 + tilt_norm * 0.30
    u_raw = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * x + Kd_x * x_dot)
    force = 3.0 * math.tanh(u_raw / 1.0)
    return force
    return random.uniform(-3, 3)
