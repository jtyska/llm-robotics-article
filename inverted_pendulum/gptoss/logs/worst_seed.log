import random, math

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    if abs(pole_angle) < 0.015:
        return 0.0

    tilt_raw = (abs(pole_angle) - 0.015) / (0.20 - 0.015)
    tilt_norm = max(0.0, min(tilt_raw, 1.0))

    Kp_theta = 1.0 + 4.0 * tilt_norm
    Kd_cart = 0.30 + 0.70 * tilt_norm
    Kp_cart = 0.05 + 0.15 * tilt_norm

    sign_theta = 1.0 if pole_angle > 0 else -1.0 if pole_angle < 0 else 0.0
    force_raw = Kp_theta * (-sign_theta * abs(pole_angle)) + Kd_cart * (-cart_velocity) + Kp_cart * (-cart_position)
    force = max(-3.0, min(force_raw, 3.0))
    return force

    return random.uniform(-3, 3)
