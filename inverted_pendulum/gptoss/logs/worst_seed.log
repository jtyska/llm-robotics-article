import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non‑finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    theta = pole_angle
    x = cart_position
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # Rule: large angle
    if abs(theta) >= 0.18:
        sign = 1.0 if theta > 0 else -1.0
        return -3.0 * sign

    # Rule: near‑vertical
    if abs(theta) <= 0.02:
        force = -(1.0 * x + 0.5 * x_dot)
        return max(-3.0, min(3.0, force))

    # General case
    raw_force = -(1.0 * x + 0.5 * x_dot + 8.0 * theta + 2.0 * theta_dot)
    scale = 1.0 + (abs(theta) - 0.02) / (0.18 - 0.02)  # linear from 1 to 2
    force = raw_force * scale
    force = max(-3.0, min(3.0, force))
    return force

