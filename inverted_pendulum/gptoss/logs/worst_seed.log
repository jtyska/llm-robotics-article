def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # Check for non‑finite inputs
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Base cart controller
    u_cart = -(0.8 * cart_position + 0.4 * cart_velocity) - 0.001 * cart_position

    theta_abs = abs(pole_angle)

    # Gains based on pole angle magnitude
    if theta_abs <= 0.02:
        K_theta = 0.80
        K_theta_dot = 0.30
    elif theta_abs >= 0.20:
