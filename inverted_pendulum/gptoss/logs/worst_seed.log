import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # check finiteness
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0

    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity

    tilt_abs = abs(theta)
    tilt_norm_raw = (tilt_abs - 0.02) / (0.20 - 0.02)

    if tilt_norm_raw < 0.0:
        tilt_norm = 0.0
    elif tilt_norm_raw > 1.0:
        tilt_norm = 1.0
    else:
        tilt_norm = tilt_norm_raw

    Kp_theta = (1.0 - tilt_norm) * 12.0 + tilt_norm * 30.0
    Kd_theta = (1.0 - tilt_norm) * 8.0  + tilt_norm * 20.0
    Kp_x     = (1.0 - tilt_norm) * 0.4  + tilt_norm * 1.2
    Kd_x     = (1.0 - tilt_norm) * 0.4  + tilt_norm * 1.0

    if tilt_abs > 0.12:
        boost_factor = (tilt_abs - 0.12) / (0.20 - 0.12)
        boost = 6.0 * boost_factor * (1 if theta > 0 else -1)
    else:
        boost = 0.0

    u_raw = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * x + Kd_x * x_dot) + boost
    u_raw += 9.81 * math.sin(theta)

