def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    abs_theta = abs(pole_angle)
    if abs_theta <= 0.05:
        tilt_norm = 0.0
    elif abs_theta >= 0.20:
        tilt_norm = 1.0
    else:
        tilt_norm = (abs_theta - 0.05) / (0.20 - 0.05)
    Kp_theta = 4.0 + 26.0 * tilt_norm
    Kd_theta = 2.0 + 10.0 * tilt_norm
    Kp_cart = 0.02 + 0.08 * tilt_norm
    Kd_cart = 0.03 + 0.09 * tilt_norm
    gravity_ff = 0.90 * 9.81 * math.sin(pole_angle)
    pole_pd = -(Kp_theta * math.sin(pole_angle) + Kd_theta * pole_angular_velocity)
    cart_pd = -(Kp_cart * cart_position + Kd_cart * cart_velocity)
    centre_bias = -0.07 * cart_position
    u_raw = pole_pd + gravity_ff + cart_pd + centre_bias
    alpha = 0.8 + 0.8 * tilt_norm
    force_tanh = 3.0 * math.tanh(alpha * u_raw)
    if force_tanh > 3.0:
        action = 3.0
    elif force_tanh < -3.0:
        action = -3.0
    else:
        action = force_tanh
    return action
    return random.uniform(-3, 3)
