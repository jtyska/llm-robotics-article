import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(theta) and math.isfinite(x_dot) and math.isfinite(theta_dot)):
        return 0.0
    elif abs(theta) >= 0.19:
        if theta > 0:
            s = 1.0
        elif theta < 0:
            s = -1.0
        else:
            s = 0.0
        return -s * 3.0
    else:
        Kx = 1.2
        Kx_dot = 0.25
        Ktheta = 28.0
        Ktheta_dot = 7.5
        u_linear = -(Kx * x + Kx_dot * x_dot + Ktheta * theta + Ktheta_dot * theta_dot)

        scale = 1.0 + (abs(theta) / 0.18) * 2.5
        if scale > 3.5:
            scale = 3.5

        force_raw = scale * u_linear

        if force_raw > 3.0:
            force = 3.0 + 0.2 * math.tanh((force_raw - 3.0) / 0.2)
        elif force_raw < -3.0:
            force = -3.0 - 0.2 * math.tanh((-force_raw - 3.0) / 0.2)
        else:
            force = force_raw
        return force

    return random.uniform(-3, 3)
