def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    force = None
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        force = 0.0
    else:
        x = cart_position
        theta = pole_angle
        x_dot = cart_velocity
        theta_dot = pole_angular_velocity
        abs_theta = abs(theta)
        if abs_theta <= 0.05:
            tilt_norm = 0.0
        elif abs_theta >= 0.20:
            tilt_norm = 1.0
        else:
            tilt_norm = (abs_theta - 0.05) / (0.20 - 0.05)
        Kp = 2.5 + (8.0 - 2.5) * tilt_norm
        Kd = 1.0 + (4.0 - 1.0) * tilt_norm
        pole_pd = -(Kp * math.sin(theta) + Kd * theta_dot)
        gravity_ff = 9.81 * math.sin(theta)
        cart_pd = -(0.02 * x + 0.03 * x_dot)
        bias_term = -0.015 * x
        u_raw = pole_pd + gravity_ff + cart_pd + bias_term
        force = 3.0 * math.tanh(u_raw)
        if force > 3.0:
            force = 3.0
        if force < -3.0:
            force = -3.0
    if force is None:
        return random.uniform(-3.0, 3.0)
    return force
