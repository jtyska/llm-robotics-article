def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    def clamp(v, lo, hi):
        return max(lo, min(hi, v))
    def sign(x):
        return 1.0 if x > 0 else -1.0 if x < 0 else 0.0
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0
    if abs(pole_angle) >= 0.18:
        force = clamp(-sign(pole_angle) * 3.0, -3.0, 3.0)
        return force
    if abs(pole_angle) <= 0.03:
        Kx = 0.6
        Kx_dot = 0.9
        Ktheta = 15.0
        Ktheta_dot = 4.0
        raw_force = -(Kx * cart_position + Kx_dot * cart_velocity + Ktheta * pole_angle + Ktheta_dot * pole_angular_velocity)
        force = clamp(raw_force, -3.0, 3.0)
        return force
    # Medium angle case
    Ktheta = 15.0
    Ktheta_dot = 4.0
    a = (abs(pole_angle) - 0.03) / (0.18 - 0.03)  # 0 … 1
    scale = 1.0 + a  # 1 … 2
    if scale > 2.0:
        scale = 2.0
    u_angle = -(Ktheta * pole_angle + Ktheta_dot * pole_angular_velocity)
    raw_force = scale * u_angle
    force = clamp(raw_force, -3.0, 3.0)
    return force
    # Default random action if no rule matched
    return random.uniform(-3.0, 3.0)
