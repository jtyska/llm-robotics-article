import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Helper functions
    def clamp(v, lo=-3.0, hi=3.0):
        return max(lo, min(v, hi))
    def sign(v):
        return 1.0 if v > 0 else (-1.0 if v < 0 else 0.0)

    # Rule 1: non‑finite values
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Rule 2: large pole angle
    if abs(pole_angle) >= 0.20:
        force = clamp(-sign(pole_angle) * 3.0)
        return force

    # Rule 3: linear controller
    Kx = 0.5
    Kx_dot = 1.0
    Ktheta = 30.0
    Ktheta_dot = 8.0

    if abs(pole_angle) >= 0.18:
        Ktheta *= 1.5      # 45.0
        Ktheta_dot *= 1.5  # 12.0

    raw = -(Kx * cart_position +
            Kx_dot * cart_velocity +
            Ktheta * pole_angle +
            Ktheta_dot * pole_angular_velocity)
    force = clamp(raw)
    return force

    # Default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
