import math, random

def clamp(value, low, high):
    return max(low, min(value, high))

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(theta) and math.isfinite(x_dot) and math.isfinite(theta_dot)):
        return 0.0

    if abs(theta) >= 0.20:
        sign = 1.0 if theta > 0 else -1.0 if theta < 0 else 0.0
        force = clamp(-sign * 3.0, -3.0, 3.0)
        return force

    # linear feedback gains
    Kx = 1.0
    Kx_dot = 0.8
    Ktheta = 12.0
    Ktheta_dot = 2.0

    u_lin = -(Ktheta * theta + Ktheta_dot * theta_dot + Kx * x + Kx_dot * x_dot)

    if abs(theta) <= 0.02:
        scale = 1.0
    else:
        scale = 1.0 + 0.5 * (abs(theta) - 0.02) / (0.18 - 0.02)
        scale = clamp(scale, 1.0, 1.5)

    raw_force = scale * u_lin
    force = clamp(raw_force, -3.0, 3.0)
    return force

    # fallback (should never reach)
    return random.uniform(-3.0, 3.0)
