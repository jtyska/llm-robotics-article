def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # initialize persistent integral term
    if not hasattr(get_action, "integral_theta"):
        get_action.integral_theta = 0.0
    # check for non‑finite values
    if not all(math.isfinite(v) for v in (cart_position, pole_angle, cart_velocity, pole_angular_velocity)):
        return 0.0
    theta = pole_angle
    theta_dot = pole_angular_velocity
    # large tilt handling
    if abs(theta) >= 0.22:
        force_raw = -3.0 * math.copysign(1.0, theta) - 1.0 * theta_dot
        return max(-3.0, min(3.0, force_raw))
    # small tilt handling
    tilt_raw = (abs(theta) - 0.04) / (0.20 - 0.04)
    tilt = max(0.0, min(1.0, tilt_raw))
    Kp_theta = 8.0 + 120.0 * tilt * tilt
    Kd_theta = 2.5 + 25.0 * tilt * tilt
    Kp_cart = 0.6 + 1.8 * tilt
    Kd_cart = 0.15 + 0.6 * tilt
    ff_gain = 0.4 + 1.2 * tilt
    ff_term = -ff_gain * theta_dot
    # update integral term
    get_action.integral_theta = 0.99 * get_action.integral_theta + 0.001 * theta
    # no explicit force rule for this branch – fall back to random action
    return random.uniform(-3.0, 3.0)
