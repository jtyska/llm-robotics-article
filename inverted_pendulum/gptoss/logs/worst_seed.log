import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # Check for finite values
    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    # Failure angle check
    if abs(theta) >= 0.20:
        return 0.0

    # Compute tilt factor (0 … 1)
    tilt = (abs(theta) - 0.02) / (0.18 - 0.02)
    tilt = max(0.0, min(1.0, tilt))
    tilt = 1.0 / (1.0 + math.exp(-(tilt - 0.5) * 8.0))

    # Scale gains with tilt
    k_theta   = 5.0  + tilt * (35.0 - 5.0)
    k_thetad = 2.0  + tilt * (35.0 - 2.0)
    k_x       = 0.8  + tilt * (3.0  - 0.8)
    k_xdot    = 0.2  + tilt * (1.5  - 0.2)

    # Centering bias (always present)
    bias = -(0.3 * x + 0.15 * x_dot)

    # Raw control output
    raw = -(k_theta * theta +
            k_thetad * theta_dot +
            k_x * x +
            k_xdot * x_dot) + bias

    # Emergency push blending
    if abs(theta) >= 0.18:
        emergency = -3.0 * (1.0 if theta > 0 else -1.0 if theta < 0 else 0.0)
        w = (abs(theta) - 0.18) / (0.20 - 0.18)
        w = max(0.0, min(1.0, w))
        raw = (1.0 - w) * raw + w * emergency

    # Clip to allowed force range
    force = max(-3.0, min(3.0, raw))
    return force

    # Default random action (should not be reached)
    return random.uniform(-3.0, 3.0)
