def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    x = cart_position
    theta = pole_angle
    xdot = cart_velocity
    thetadot = pole_angular_velocity
    F = None
    if abs(theta) <= 0.06 and abs(thetadot) <= 0.05:
        F = -0.8 * x - 0.4 * xdot
        if abs(x) < 0.05 and abs(xdot) < 0.02:
            F = 0.0
    elif abs(theta) <= 0.14:
        F = -(8.0 * theta) - (2.0 * thetadot)
        if abs(x) > 0.3:
            F = F - 0.5 * x - 0.2 * xdot
    else:
        F = -(13.0 * theta) - (4.0 * thetadot)
        if abs(theta) < 0.10:
            F = -(8.0 * theta) - (2.0 * thetadot)
    if F is None:
        return random.uniform(-3.0, 3.0)
    F = max(-3.0, min(3.0, F))
    return F
