import random
import math

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non-finite values
    if (not math.isfinite(cart_position) or
        not math.isfinite(cart_velocity) or
        not math.isfinite(pole_angle) or
        not math.isfinite(pole_angular_velocity)):
        return 0.0

    theta = pole_angle
    theta_dot = pole_angular_velocity
    x = cart_position
    x_dot = cart_velocity

    # Compute scaling factor t based on pole angle magnitude
    abs_theta = abs(theta)
    if abs_theta <= 0.05:
        t = 0.0
    elif abs_theta >= 0.20:
        t = 1.0
    else:
        t = (abs_theta - 0.05) / 0.15

    # Gains
    Kp_theta = 30.0 + 120.0 * t
    Kd_theta = 2.0 + 8.0 * t
    Kp_x = 0.02 + 0.08 * t
    Kd_x = 0.005 + 0.025 * t

    # Feed‑forward gravity compensation
    ff_grav = 0.48 * math.sin(theta)

    # Raw control signal
    u_raw = -(Kp_theta * theta + Kd_theta * theta_dot + Kp_x * x + Kd_x * x_dot + ff_grav)

    # Clamp to action limits
    if u_raw > 3.0:
        force = 3.0
    elif u_raw < -3.0:
        force = -3.0
    else:
        force = u_raw

    return force

    # Fallback random action (should never be reached)
    return random.uniform(-3.0, 3.0)
