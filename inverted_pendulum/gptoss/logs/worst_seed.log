def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random

    # Helper clamp
    def _clamp(val, lo, hi):
        return max(lo, min(hi, val))

    # Check finiteness
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Alias variables for readability
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # Compute tilt_raw
    tilt_raw = _clamp((abs(theta) - 0.05) / (0.18 - 0.05), 0.0, 1.0)

    # Gains
    Kp_theta = 8.0 + (16.0 - 8.0) * tilt_raw
    Kd_theta = 3.0 + (7.0 - 3.0) * tilt_raw
    Kp_cart  = 0.12 + (0.20 - 0.12) * tilt_raw
    Kd_cart  = 0.025 + (0.045 - 0.025) * tilt_raw
    ff_gain  = 0.35 * tilt_raw
    Kp_center = 0.05 * tilt_raw

    # Efforts
    pole_effort = -Kp_theta * theta - Kd_theta * theta_dot
    cart_effort = -Kp_cart * x - Kd_cart * x_dot - Kp_center * x
    ff_effort = -ff_gain * (1 if theta > 0 else -1 if theta < 0 else 0) * 3.0

    force_raw = pole_effort + cart_effort + ff_effort
    force = _clamp(force_raw, -3.0, 3.0)

    # Return computed force
    return force if force is not None else random.uniform(-3.0, 3.0)
