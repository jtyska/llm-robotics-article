                  10.0 * pole_angle + 2.5 * pole_angular_velocity)
    if force_raw > 3:
        return 3.0
    elif force_raw < -3:
        return -3.0
    else:
        return force_raw
    # fallback (should never be reached)
    return random.uniform(-3, 3)
