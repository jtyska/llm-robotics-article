import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0

    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity

    u_base = -(13.0 * theta + 9.5 * theta_dot + 0.6 * x + 0.3 * x_dot)

    if abs(theta) < 0.02:
        scale = 1.0
    elif abs(theta) > 0.20:
        scale = 4.0
    else:
        scale = 1.0 + (abs(theta) - 0.02) * (4.0 - 1.0) / (0.20 - 0.02)

    u_raw = u_base * scale
    u_smooth = 3.0 * math.tanh(u_raw / 3.0)

    if u_smooth > 3.0:
        action = 3.0
    elif u_smooth < -3.0:
        action = -3.0
    else:
        action = u_smooth

    return action if action is not None else random.uniform(-3, 3)
