import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # helper clamp
    def clamp(val, lo, hi):
        return max(lo, min(val, hi))
    # check finiteness
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0
    # large angle rule
    if abs(pole_angle) >= 0.18:
        sign = 1.0 if pole_angle > 0 else -1.0 if pole_angle < 0 else 0.0
        force = clamp(-sign * 3.0, -3.0, 3.0)
        return force
    # angle‑gain selection
    if abs(pole_angle) <= 0.02:
        K_theta = 20.0
        K_theta_dot = 5.0
    else:
        z = (abs(pole_angle) - 0.02) / (0.18 - 0.02)  # 0 … 1
        K_theta = 20.0 + z * (80.0 - 20.0)            # 20 → 80
        K_theta_dot = 5.0 + z * (15.0 - 5.0)          # 5 → 15
    # cart‑centering gains (constant)
    Kx = 0.5
    Kx_dot = 0.8
    # compute torques
    u_angle = -(K_theta * pole_angle + K_theta_dot * pole_angular_velocity)
    u_cart = -(Kx * cart_position + Kx_dot * cart_velocity)
    raw_force = u_angle + u_cart
    # saturate
    force = clamp(raw_force, -3.0, 3.0)
    # tiny dead‑zone
    if abs(force) < 0.01:
        force = 0.0
    return force
    # fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
