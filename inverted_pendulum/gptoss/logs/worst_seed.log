import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Rule 1: check finiteness
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Compute tilt based on pole angle
    theta_abs = abs(pole_angle)
    if theta_abs <= 0.05:
        tilt = 0.0
    elif theta_abs >= 0.18:
        tilt = 1.0
    else:
        tilt = (theta_abs - 0.05) / 0.13
        tilt = max(0.0, min(tilt, 1.0))

    # Compute velocity boost
    vel_boost = 1.0
    if abs(pole_angular_velocity) > 1.5:
        vel_boost = 1.3
    if abs(cart_velocity) > 0.8:
        vel_boost = max(vel_boost, 1.2)

    # Gains for pole and cart
    Kp_pole = 4.0 + 72.0 * (tilt ** 2)
    Kd_pole = 1.0 + 18.0 * (tilt ** 2)
    Ki_pole = 0.02 * tilt
    Kp_cart = 0.02 + 0.08 * (tilt ** 2)
    Kd_cart = 0.005 + 0.02 * (tilt ** 2)

    # Feed‑forward term
    ff_gain = 1.5 * tilt
    sign_theta = math.copysign(1.0, pole_angle) if pole_angle != 0 else 0.0
    ff_term = -ff_gain * pole_angular_velocity * sign_theta

    # PD and I terms
    pole_pd = -Kp_pole * pole_angle - Kd_pole * pole_angular_velocity * vel_boost
    pole_i = -Ki_pole * pole_angle
    cart_pd = -Kp_cart * cart_position - Kd_cart * cart_velocity

    # Combine into raw force
    raw_force = pole_pd + pole_i + cart_pd + ff_term

    # Clamp to action limits
    force = max(-3.0, min(raw_force, 3.0))
    return force if math.isfinite(force) else random.uniform(-3.0, 3.0)
