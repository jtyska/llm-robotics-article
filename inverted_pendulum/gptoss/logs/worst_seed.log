import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check for non‑finite inputs
    if not (math.isfinite(cart_position) and math.isfinite(cart_velocity) and
            math.isfinite(pole_angle) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Failure condition: pole angle beyond limit
    if abs(pole_angle) > 0.20:
        return 0.0

    # Compute blending weight (sigmoid)
    w = 1.0 / (1.0 + math.exp(-(abs(pole_angle) - 0.07) / 0.03))

    # Cart PD command
    u_cart = -(0.80 * cart_position + 0.40 * cart_velocity) - 0.001 * cart_position

    # Angle PD gains
    K_theta = 0.8 + w * (12.0 - 0.8)
    K_theta_dot = 0.3 + w * (4.0 - 0.3)

    # Angle PD command
    u_angle = -(K_theta * pole_angle + K_theta_dot * pole_angular_velocity)

    # Blend the two commands
    u_raw = (1.0 - w) * u_cart + w * u_angle

    # Safety margin before clipping
    u_safety = max(-3.0 + 0.15, min(u_raw, 3.0 - 0.15))

    # Final clipping to action limits
    action = max(-3.0, min(u_safety, 3.0))

    return action

    # Default random action if no rule applies
    return random.uniform(-3, 3)
