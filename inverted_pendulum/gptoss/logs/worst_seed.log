import random, math

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    def clamp(v, lo, hi):
        return max(lo, min(hi, v))
    def sign(v):
        return 1 if v > 0 else -1 if v < 0 else 0

    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # Check for non‑finite values
    if not (math.isfinite(x) and math.isfinite(theta) and math.isfinite(x_dot) and math.isfinite(theta_dot)):
        force = 0.0

    elif abs(theta) >= 0.18:
        force = -3.0 * sign(theta)

    elif abs(theta) <= 0.02:
        raw = -(1.0 * x + 0.5 * x_dot)
        force = clamp(raw, -3.0, 3.0)

    else:
        u_angle = -(13.0 * theta + 2.5 * theta_dot)
        scale = 1.0 + (abs(theta) - 0.02) * (1.0 / (0.18 - 0.02))
        if scale > 2.0:
            scale = 2.0
        if scale < 1.0:
            scale = 1.0
        raw = scale * u_angle
        force = clamp(raw, -3.0, 3.0)

    # Optional dead‑zone
    if abs(force) < 0.01:
        force = 0.0

    # Fallback (should never be reached)
    if force is None:
        force = random.uniform(-3.0, 3.0)

    return force
