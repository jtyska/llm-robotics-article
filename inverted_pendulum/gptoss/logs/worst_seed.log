def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    # Check for non‑finite values
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    # Failure angle condition
    if pole_angle < -0.20 or pole_angle > 0.20:
        return 0.0
    # Normalised tilt factor
    theta_abs = abs(pole_angle)
    s_raw = (theta_abs - 0.02) / (0.20 - 0.02)  # denominator = 0.18
    if s_raw < 0.0:
        s = 0.0
    elif s_raw > 1.0:
        s = 1.0
    else:
        s = s_raw
    # Gain‑scheduling
    K_theta   = 0.8  + s * (15.0 - 0.8)      # 0.8 → 15.0
    K_theta_d = 0.3  + s * (6.0  - 0.3)      # 0.3 → 6.0
    K_x       = 0.80 * (1.0 - s) + 0.20 * s # 0.80 → 0.20
    K_x_d     = 0.40 * (1.0 - s) + 0.10 * s # 0.40 → 0.10
    # Control components
    u_angle = -(K_theta * pole_angle + K_theta_d * pole_angular_velocity)
    u_cart  = -(K_x * cart_position + K_x_d * cart_velocity)
    u_grav  = 0.5 * pole_angle
    u_center = -0.20 * cart_position
    u_raw = u_angle + u_cart + u_grav + u_center
    # Soft saturation
    u_safe = u_raw
    if u_safe < -3.0 + 0.05:
        u_safe = -3.0 + 0.05
    elif u_safe > 3.0 - 0.05:
        u_safe = 3.0 - 0.05
    action = 0.95 * 3.0 * math.tanh(u_safe / 3.0)
    # Final hard clip
    if action < -3.0:
        action = -3.0
    elif action > 3.0:
        action = 3.0
    return action
    # Default random action (fallback)
    return random.uniform(-3.0, 3.0)
