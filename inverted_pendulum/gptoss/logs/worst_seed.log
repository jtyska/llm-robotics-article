import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # tilt normalization
    abs_theta = abs(pole_angle)
    if abs_theta <= 0.05:
        tilt_norm = 0.0
    elif abs_theta >= 0.20:
        tilt_norm = 1.0
    else:
        tilt_norm = (abs_theta - 0.05) / 0.15

    # gains
    Kp_theta_low, Kd_theta_low, Kp_x_low, Kd_x_low = 8.0, 4.0, 0.08, 0.08
    Kp_theta_high, Kd_theta_high, Kp_x_high, Kd_x_high = 15.0, 8.0, 0.30, 0.30

    Kp_theta = (1 - tilt_norm) * Kp_theta_low + tilt_norm * Kp_theta_high
    Kd_theta = (1 - tilt_norm) * Kd_theta_low + tilt_norm * Kd_theta_high
    Kp_x = (1 - tilt_norm) * Kp_x_low + tilt_norm * Kp_x_high
    Kd_x = (1 - tilt_norm) * Kd_x_low + tilt_norm * Kd_x_high

    # integral term (stateful)
    if not hasattr(get_action, "int_theta"):
        get_action.int_theta = 0.0
    get_action.int_theta = (1 - 0.001) * get_action.int_theta + 0.001 * pole_angle

    # control law
    u_raw = -(Kp_theta * pole_angle + Kd_theta * pole_angular_velocity +
              0.05 * get_action.int_theta + Kp_x * cart_position + Kd_x * cart_velocity)

    force_raw = 3.0 * math.tanh(u_raw / 0.9)

    if abs(force_raw) < 0.02:
        force = 0.0
    else:
        force = force_raw

    return force if force is not None else random.uniform(-3.0, 3.0)
