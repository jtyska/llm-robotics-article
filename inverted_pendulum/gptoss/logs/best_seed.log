import random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    if abs(pole_angle) > 0.015 or abs(pole_angular_velocity) > 0.02:
        A = 3.0 * pole_angle + 1.2 * pole_angular_velocity
