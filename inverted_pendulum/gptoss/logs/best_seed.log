import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    xdot = cart_velocity
    thetad = pole_angular_velocity

    def is_finite(v):
        return math.isfinite(v)

    def sign(v):
        if v > 0:
            return 1.0
        if v < 0:
            return -1.0
        return 0.0

    def clip(v, lo, hi):
        return max(lo, min(v, hi))

    # Rule 1: non‑finite values
    if (not is_finite(x) or not is_finite(xdot) or
        not is_finite(theta) or not is_finite(thetad)):
        return 0.0

    # Rule 2: large angle -> max force opposite sign
    if abs(theta) >= 0.20:
        return -3.0 * sign(theta)

    # Rule 3: near‑zero angle and angular velocity -> no force
    if abs(theta) < 0.003 and abs(thetad) < 0.006:
        return 0.0

    # Main control logic
    scale = 1.0 + 1.8 * min(abs(theta), 0.20)
    if scale > 1.5:
        scale = 1.5

    pole_pd = 4.0 * theta + 2.5 * thetad

    damp_coeff = 0.5 + 0.4 * (abs(theta) / 0.20)
    pole_damp = -damp_coeff * thetad

    recovery = 0.0
    if abs(theta) > 0.15 and theta * thetad > 0:
        recovery = -2.0 * sign(theta)

    cart_term = 0.0
    if abs(theta) < 0.06 and abs(thetad) < 0.12:
        cent_gain = 0.30 + 0.30 * clip(abs(x) / 0.20, 0.0, 1.0)
        cart_term = cent_gain * x + 0.25 * xdot
        cart_term = clip(cart_term, -1.2, 1.2)

    bias = 0.0
    if 0.003 < abs(theta) < 0.020 and abs(thetad) < 0.01:
        bias = 0.006 * sign(theta) * scale

    raw = scale * (pole_pd + pole_damp + recovery - cart_term) + bias
    force = 3.0 * math.tanh(raw / 3.0)

    # If for some reason no rule applied, fall back to random action
    if force is None:
        return random.uniform(-3.0, 3.0)
    return force
