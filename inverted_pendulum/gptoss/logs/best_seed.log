### 2️⃣ Updated strategy (call it **S‑4**)

```text
// ------------------------------------------------------------
// 0. Safety guard
IF  NOT is_finite(x) OR NOT is_finite(x_dot) OR
    NOT is_finite(theta) OR NOT is_finite(theta_dot)
THEN
    force = 0.0
    RETURN
ENDIF

// 1. Hard angle failure – immediate max‑force correction
IF  abs(theta) >= 0.20
THEN
    force = -3.0 * sign(theta)          // push back as hard as possible
    RETURN
ENDIF

// ------------------------------------------------------------
// 2. Core pole stabilisation
pole_pd   = 4.6 * theta + 2.9 * theta_dot   // +10 % over S‑2

// 2a. Angle‑dependent viscous damping (0.5 → 1.2)
damp_coeff = 0.5 + 0.7 * (abs(theta) / 0.20)   // 0.5 … 1.2
pole_damp  = -damp_coeff * theta_dot

// ------------------------------------------------------------
// 3. Adaptive recovery boost (only when the pole is already far)
IF (abs(theta) > 0.12) OR (abs(theta_dot) > 0.15)
THEN
    // linear growth from 0.8 at 0.12 rad to 2.5 at 0.20 rad
    boost_gain = 0.8 + 8.0 * (abs(theta) - 0.12) / (0.20 - 0.12)
    IF boost_gain > 2.5 THEN boost_gain = 2.5
    ENDIF
    IF theta * theta_dot > 0          // same sign → pole moving away
    THEN recovery = -boost_gain * sign(theta)
    ELSE recovery = 0.0
    ENDIF
ELSE
    recovery = 0.0
ENDIF

// ------------------------------------------------------------
// 4. Cart‑centering (always active, but modest)
cart_center_weak = clamp(0.35 * x + 0.22 * x_dot, -1.8, 1.8)

// ------------------------------------------------------------
// 5. Strong centering – only when pole is very vertical
//    or when the cart is already near a track edge.
IF (abs(theta) < 0.05 AND abs(theta_dot) < 0.08) OR (abs(x) > 1.2)
THEN
    // edge‑aware gain: stronger the closer we are to the edge
    edge_factor = clamp((abs(x) - 1.2) / 0.8, 0.0, 1.0)   // 0 … 1
    strong_gain = 0.45 + 0.55 * edge_factor               // 0.45 … 1.0
    cart_center_strong = clamp(strong_gain * x +
                               (0.30 + 0.30 * edge_factor) * x_dot,
                               -2.5, 2.5)
ELSE
    cart_center_strong = 0.0
ENDIF

// ------------------------------------------------------------
// 6. Edge‑repel – gentle nudge when we are really close to the limits
IF abs(x) > 1.5
THEN
    rep_coeff = 0.6 * (abs(x) - 1.5) / (2.4 - 1.5)   // 0 … 0.6
    edge_repulsion = -rep_coeff * sign(x)
ELSE
    edge_repulsion = 0.0
ENDIF

// ------------------------------------------------------------
// 7. Tiny symmetry‑breaking bias (optional – keeps the controller from getting stuck)
IF (abs(theta) > 0.003) AND (abs(theta) < 0.015) AND (abs(theta_dot) < 0.01)
THEN bias = 0.012 * sign(theta)
ELSE bias = 0.0
ENDIF

// ------------------------------------------------------------
// 8. Small velocity feed‑forward (helps the cart follow the pole)
vel_feed = -0.05 * x_dot

// ------------------------------------------------------------
// 9. Combine everything
raw = pole_pd + pole_damp + recovery
      - cart_center_weak - cart_center_strong
      + edge_repulsion + bias + vel_feed

