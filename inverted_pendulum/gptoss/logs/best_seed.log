import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    def is_finite(v):
        return math.isfinite(v)
    def sign(v):
        return 1.0 if v > 0 else -1.0 if v < 0 else 0.0
    def clamp(v, lo, hi):
        return max(lo, min(hi, v))
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if not (is_finite(x) and is_finite(x_dot) and is_finite(theta) and is_finite(theta_dot)):
        return 0.0

    if abs(theta) >= 0.20:
        return -3.0 * sign(theta)

    # pole PD term
    pole_pd = 4.2 * theta + 2.6 * theta_dot

    # angle‑dependent damping
    damp_coeff = 0.5 + 0.5 * (abs(theta) / 0.20)  # range 0.5 … 1.0
    pole_damp = -damp_coeff * theta_dot

    # recovery boost (only when pole is falling away)
    if (abs(theta) > 0.12) or (abs(theta_dot) > 0.15):
        boost_gain = 0.8 + 6.0 * (abs(theta) - 0.12) / (0.20 - 0.12)
        if boost_gain > 2.0:
            boost_gain = 2.0
        if theta * theta_dot > 0:
            recovery = -boost_gain * sign(theta)
        else:
            recovery = 0.0
    else:
        recovery = 0.0

    # weak centering (always active)
    cart_center_weak = clamp(0.30 * x + 0.18 * x_dot, -1.5, 1.5)

    # strong centering (activates when pole is near vertical OR cart near edge)
    strong_active = (abs(theta) < 0.07) and (abs(theta_dot) < 0.10)
    edge_near = (abs(x) > 1.5)
    if strong_active or edge_near:
        edge_factor = clamp((abs(x) - 1.5) / 0.7, 0.0, 1.0)  # 0 … 1
        strong_gain = 0.45 + 0.55 * edge_factor               # 0.45 … 1.0
        cart_center_strong = clamp(strong_gain * x + (0.30 + 0.30 * edge_factor) * x_dot, -2.5, 2.5)
    else:
        cart_center_strong = 0.0

    # edge‑repel (soft push when very close to limits)
    if abs(x) > 1.8:
        rep_coeff = 0.8 * (abs(x) - 1.8) / (2.4 - 1.8)  # 0 … 0.8
        edge_repulsion = -rep_coeff * sign(x)        # toward centre
    else:
        edge_repulsion = 0.0

    # tiny symmetry‑breaking bias
    if (abs(theta) > 0.003) and (abs(theta) < 0.015) and (abs(theta_dot) < 0.01):
        bias = 0.012 * sign(theta)
    else:
        bias = 0.0

    # velocity feed‑forward
    vel_feed = -0.05 * x_dot

    # combine all terms
    raw = (pole_pd + pole_damp + recovery -
           cart_center_weak - cart_center_strong +
           edge_repulsion + bias + vel_feed)

    # pre‑clip before tanh saturation
    raw = clamp(raw, -5.0, 5.0)

    # final smooth actuator saturation
    force = 3.0 * math.tanh(raw / 3.0)

    return force if force is not None else random.uniform(-3.0, 3.0)
