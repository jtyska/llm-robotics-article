import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    def is_finite(v):
        return math.isfinite(v)

    def sign(v):
        return 1.0 if v > 0 else -1.0 if v < 0 else 0.0

    def clip(v, lo, hi):
        return max(lo, min(hi, v))

    # Rule 1: non‑finite check
    if not (is_finite(x) and is_finite(x_dot) and is_finite(theta) and is_finite(theta_dot)):
        return 0.0

    # Rule 2: angle out of bounds
    if abs(theta) >= 0.20:
        return -3.0 * sign(theta)

    # 1. Pole PD term
    pole_pd = 4.2 * theta + 2.6 * theta_dot

    # 2. Angle‑dependent viscous damping
    damp_coeff = 0.5 + 0.5 * (abs(theta) / 0.20)  # 0.5 … 1.0
    pole_damp = -damp_coeff * theta_dot

    # 3. Adaptive recovery boost
    if (abs(theta) > 0.12) or (abs(theta_dot) > 0.15):
        boost_gain = 0.8 + 6.0 * (abs(theta) - 0.12) / (0.20 - 0.12)  # grows 0.8 … 2.0
        if boost_gain > 2.0:
            boost_gain = 2.0
        if theta * theta_dot > 0:
            recovery = -boost_gain * sign(theta)
        else:
            recovery = 0.0
    else:
        recovery = 0.0

    # 4. Cart‑centering (always on)
    cart_center_weak = 0.30 * x + 0.18 * x_dot
    cart_center_weak = clip(cart_center_weak, -1.5, 1.5)

    # 5. Strong centering when pole is almost vertical
    if (abs(theta) < 0.05) and (abs(theta_dot) < 0.08):
        cart_center_strong = 0.45 * x + 0.30 * x_dot
        cart_center_strong = clip(cart_center_strong, -2.0, 2.0)
    else:
        cart_center_strong = 0.0

    # 6. Tiny symmetry‑breaking bias
    if (0.003 < abs(theta) < 0.015) and (abs(theta_dot) < 0.01):
        bias = 0.01 * sign(theta)
    else:
        bias = 0.0

    # 7. Small velocity feed‑forward
    vel_feed = -0.05 * x_dot

    # 8. Combine all terms
    raw = pole_pd + pole_damp + recovery - cart_center_weak - cart_center_strong + bias + vel_feed

    # 9. Pre‑clip for smooth saturation
    raw = clip(raw, -5.0, 5.0)

    # 10. Final smooth saturation
    force = 3.0 * math.tanh(raw / 3.0)

    return force if math.isfinite(force) else random.uniform(-3.0, 3.0)
