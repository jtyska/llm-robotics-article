import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    xdot = cart_velocity
    thetad = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(xdot) and math.isfinite(theta) and math.isfinite(thetad)):
        return 0.0

    if (abs(theta) < 0.002 and abs(thetad) < 0.004 and
        abs(x) < 0.05 and abs(xdot) < 0.05):
        return 0.0

    pole_term = 8.5 * theta + 3.2 * thetad
    cart_term = 0.55 * x + 0.38 * xdot
    raw = -(pole_term - cart_term)

    scale = 1.0 + 3.0 * min(abs(theta), 0.20)
    if scale > 2.5:
        scale = 2.5
    raw *= scale

    if 0.003 < abs(theta) < 0.020:
        sign = 1.0 if theta > 0 else -1.0 if theta < 0 else 0.0
        raw += 0.010 * sign

    if raw > 3.0:
        force = 3.0
    elif raw < -3.0:
        force = -3.0
    else:
        force = raw

    return force

    # fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
