import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    xdot = cart_velocity
    thetad = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(xdot) and math.isfinite(theta) and math.isfinite(thetad)):
        return 0.0

    if abs(theta) > 0.20:
        return 0.0

    if abs(theta) < 0.003 and abs(thetad) < 0.006:
        return 0.0

    raw = (-3.5) * theta + (-2.2) * thetad + (-0.9) * x + (-0.8) * xdot

    scale = 1.0 + 2.0 * min(abs(theta), 0.20)
    if scale > 2.0:
        scale = 2.0
    raw = raw * scale

    if 0.003 < abs(theta) < 0.020:
        raw = raw + 0.04 * (1.0 if theta > 0 else -1.0)

    force_raw = 3.0 * math.tanh(raw / 3.0)

    if force_raw > 3.0:
        force = 3.0
    elif force_raw < -3.0:
        force = -3.0
    else:
        force = force_raw

    return force

    # fallback random action (should never be reached)
    return random.uniform(-3.0, 3.0)
