import random
import math

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Rule 1: small angle and angular velocity
    if abs(pole_angle) < 0.003 and abs(pole_angular_velocity) < 0.006:
        return 0.0

    # Compute terms
    pole_term = 4.0 * pole_angle + 2.5 * pole_angular_velocity
    cart_term = 0.6 * cart_position + 0.4 * cart_velocity
    raw = pole_term - cart_term

    # Scale factor
    scale = 1.0 + 2.0 * min(abs(pole_angle), 0.2)
    if scale > 1.8:
        scale = 1.8
    raw *= scale

    # Small angle bias
    if 0.003 < abs(pole_angle) < 0.020:
        sign = 1.0 if pole_angle > 0 else -1.0
        raw += 0.010 * sign

    # Clamp to action limits
    if raw > 3.0:
        return 3.0
    elif raw < -3.0:
        return -3.0
    else:
        return raw

    # Default random action (should not be reached)
    return random.uniform(-3.0, 3.0)
