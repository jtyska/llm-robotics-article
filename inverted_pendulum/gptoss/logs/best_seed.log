def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    def sign(x):
        return 1.0 if x > 0 else -1.0 if x < 0 else 0.0
    def clamp(v, lo, hi):
        return max(lo, min(v, hi))
    # Rule 1
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    # Rule 2
    if abs(pole_angle) >= 0.20:
        return -3.0 * sign(pole_angle)
    # Rule 3
    if abs(cart_position) > 2.2:
        return -3.0 * sign(cart_position)
    # Rule 4
    # 4‑a Pole PD
    pole_pd = 4.5 * pole_angle + 3.0 * pole_angular_velocity
    # 4‑b Angle‑dependent damping
    damp_coeff = 0.5 + 0.7 * (abs(pole_angle) / 0.20)  # range 0.5 … 1.2
    pole_damp = -damp_coeff * pole_angular_velocity
    # 4‑c Recovery boost
    if pole_angle * pole_angular_velocity > 0 and (abs(pole_angle) > 0.10 or abs(pole_angular_velocity) > 0.12):
        boost_raw = 0.8 + 4.0 * (abs(pole_angle) - 0.10) / 0.10  # 0.8 … 4.8
        boost_speed = 1.5 * abs(pole_angular_velocity) / 2.0   # 0 … 1.5
        boost = clamp(boost_raw + boost_speed, 0.0, 3.0)
        recovery = -boost * sign(pole_angle)
    else:
        recovery = 0.0
    # 4‑d Weak cart‑centering
    cart_center_weak = clamp(0.30 * cart_position + 0.18 * cart_velocity, -1.5, 1.5)
    # 4‑e Strong cart‑centering
    if abs(pole_angle) < 0.08 and abs(pole_angular_velocity) < 0.10:
        edge_factor = clamp((abs(cart_position) - 1.5) / 0.7, 0.0, 1.0)  # 0 → 1 as |x| goes 1.5→2.2
        strong_gain = 0.45 + 0.55 * edge_factor                     # 0.45 … 1.0
        cart_center_strong = clamp(strong_gain * cart_position +
                                   (0.30 + 0.30 * edge_factor) * cart_velocity,
                                   -2.5, 2.5)
    else:
        cart_center_strong = 0.0
    # 4‑f Velocity feed‑forward
    vel_feed = -0.07 * cart_velocity
    # 4‑g Combine
    raw = pole_pd + pole_damp + recovery - cart_center_weak - cart_center_strong + vel_feed
    # 4‑h Pre‑clip
    raw = clamp(raw, -5.5, 5.5)
    # 4‑i Saturation to actuator limits
    force = 3.0 * math.tanh(raw / 3.0)  # result in [‑3, +3]
    return force
    # default random action if no rule matched (should never be reached)
    return random.uniform(-3.0, 3.0)
