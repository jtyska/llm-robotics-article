import random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    xdot = cart_velocity
    thetadot = pole_angular_velocity

    if (abs(theta) < 0.004) and (abs(thetadot) < 0.008) and (abs(x) < 0.02) and (abs(xdot) < 0.02):
        return 0.0
    else:
        pole_term = 3.0 * theta + 1.5 * thetadot
        cart_term = 1.0 * x + 0.8 * xdot
        F_raw = -pole_term - cart_term

        if F_raw > 3.0:
