import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    xdot = cart_velocity
    thetad = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(theta) and math.isfinite(xdot) and math.isfinite(thetad)):
        return 0.0
    if abs(theta) > 0.20:
        return 0.0
    if abs(theta) < 0.003 and abs(thetad) < 0.006:
        return 0.0

    # compute adaptive scale
    scale = 1 + 2.5 * min(abs(theta), 0.20)
    if scale > 1.5:
        scale = 1.5

    # pole PD term
    pole_pd = 3.5 * theta + 2.0 * thetad

    # angle‑dependent damping
    damp_factor = 0.8 if abs(theta) > 0.05 else 0.5
    pole_damp = -damp_factor * thetad

    # cart‑centering term (clamped)
    if abs(x) > 0.05:
        raw_center = 0.4 * x + 0.3 * xdot
        if raw_center > 1.5:
            cart_term = 1.5
        elif raw_center < -1.5:
            cart_term = -1.5
        else:
            cart_term = raw_center
    else:
        cart_term = 0.0

    # conditional quick‑kick
    if abs(theta) < 0.02 and abs(thetad) > 0.15:
        ff = -0.3 * (1 if thetad > 0 else -1 if thetad < 0 else 0)
    else:
        ff = 0.0

    # tiny bias for very small angles
    if 0.003 < abs(theta) < 0.020 and abs(thetad) < 0.01:
        bias = 0.006 * (1 if theta > 0 else -1 if theta < 0 else 0) * scale
    else:
        bias = 0.0

    # assemble raw command
    raw = scale * (pole_pd + pole_damp - cart_term + ff) + bias

    # soft saturation to enforce limits
    force = 3.0 * math.tanh(raw / 3.0)

    return force

    # default random action if no rule applied
    return random.uniform(-3, 3)
