    if abs(cart_position) > 0.04 or abs(cart_velocity) > 0.04:
        B = 0.7 * cart_position + 0.6 * cart_velocity
    else:
        B = 0.0
    F_raw = A - B
    if F_raw > 3.0:
        action = 3.0
    elif F_raw < -3.0:
        action = -3.0
    else:
        action = F_raw
    if action is None:
        return random.uniform(-3, 3)
    return action
