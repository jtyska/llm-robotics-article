import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    xdot = cart_velocity
    thetad = pole_angular_velocity

    # rule: non‑finite values
    if not (math.isfinite(x) and math.isfinite(xdot) and math.isfinite(theta) and math.isfinite(thetad)):
        return 0.0

    # rule: pole angle out of bounds
    if abs(theta) > 0.20:
        return 0.0

    # rule: near‑zero angle and angular velocity
    if abs(theta) < 0.003 and abs(thetad) < 0.006:
        return 0.0

    # compute scaling factor
    scale = 1.0 + 2.5 * min(abs(theta), 0.20)
    if scale > 1.5:
        scale = 1.5

    # pole PD term
    pole_pd = 3.5 * theta + 2.0 * thetad

    # adaptive velocity damping
    damp_factor = 0.5
    if abs(theta) > 0.05:
        damp_factor = 0.8
    pole_damp = -damp_factor * thetad

    # cart‑centering term
    cart_term = 0.0
    if abs(x) > 0.05:
        cart_term = 0.4 * x + 0.3 * xdot

    # raw command before bias and saturation
    raw = scale * (pole_pd + pole_damp - cart_term)

    # tiny bias for very small non‑zero angles
    if 0.003 < abs(theta) < 0.020 and abs(thetad) < 0.01:
        raw += 0.006 * math.copysign(1.0, theta) * scale

    # soft saturation
    force = 3.0 * math.tanh(raw / 3.0)

    return force if math.isfinite(force) else random.uniform(-3.0, 3.0)
