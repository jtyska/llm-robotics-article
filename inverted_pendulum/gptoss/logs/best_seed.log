def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # safety check
    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    # large angle recovery
    if abs(theta) >= 0.20:
        sign_theta = math.copysign(1.0, theta) if theta != 0.0 else 0.0
        return -2.0 * sign_theta

    # pole PD term
    pole_pd = 4.2 * theta + 2.6 * theta_dot

    # angle‑dependent damping
    damp_coeff = 0.5 + 0.5 * (abs(theta) / 0.20)
    pole_damp = -damp_coeff * theta_dot

    # graduated recovery boost
    if abs(theta) > 0.15 and theta * theta_dot > 0:
        boost_gain = (abs(theta) - 0.15) * (0.8 / (0.20 - 0.15))
    else:
        boost_gain = 0.0
    recovery = -boost_gain * (math.copysign(1.0, theta) if theta != 0.0 else 0.0)

    # cart‑centering term (always active)
    cart_raw = 0.30 * x + 0.18 * x_dot
    cart_center = max(-1.5, min(1.5, cart_raw))

    # strong centering when pole is near vertical
    if abs(theta) < 0.08 and abs(theta_dot) < 0.10:
        strong_center = max(-1.2, min(1.2, 0.25 * x + 0.15 * x_dot))
    else:
        strong_center = 0.0

    # tiny symmetry‑breaking bias
    if 0.003 < abs(theta) < 0.015 and abs(theta_dot) < 0.01:
        bias = 0.004 * (math.copysign(1.0, theta) if theta != 0.0 else 0.0)
    else:
        bias = 0.0

    # combine components
    raw = pole_pd + pole_damp + recovery - cart_center - strong_center + bias

    # pre‑clamp before smooth saturation
    raw = max(-4.0, min(4.0, raw))

    # final smooth saturation to actuator limits
    force = 3.0 * math.tanh(raw / 3.0)  # force ∈ [‑3.0 , 3.0]

    return force
    return random.uniform(-3.0, 3.0)
