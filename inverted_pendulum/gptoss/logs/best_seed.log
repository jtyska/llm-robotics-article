import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    xdot = cart_velocity
    thetad = pole_angular_velocity

    # Rule 1
    if abs(theta) < 0.003 and abs(thetad) < 0.006:
        return 0.0

    # Rule 2
    if abs(theta) > 0.20 or not (math.isfinite(x) and math.isfinite(xdot) and math.isfinite(theta) and math.isfinite(thetad)):
        return 0.0

    # Rule 3
    scale = 1 + 2.5 * min(abs(theta), 0.20)
    if scale > 1.5:
        scale = 1.5

    raw = scale * (3.5 * theta + 2.0 * thetad - (0.4 * x + 0.3 * xdot))

    if 0.003 < abs(theta) < 0.020:
        raw += 0.008 * (1 if theta > 0 else -1)

    if raw > 3.0:
        force = 3.0
    elif raw < -3.0:
        force = -3.0
    else:
        force = raw

    return force

    # Default random action (should not be reached)
    return random.uniform(-3.0, 3.0)
