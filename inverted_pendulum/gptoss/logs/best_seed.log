import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    def clamp(v, lo, hi):
        return max(lo, min(v, hi))

    def sign(v):
        return 1.0 if v > 0 else -1.0 if v < 0 else 0.0

    # 1. Non‑finite check
    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    # 2. Angle limit breach
    if abs(theta) >= 0.20:
        return -3.0 * sign(theta)

    # 3. Pole PD term
    pole_pd = 4.6 * theta + 2.9 * theta_dot

    # 4. Adaptive damping
    damp_coeff = 0.5 + 0.7 * (abs(theta) / 0.20)
    pole_damp = -damp_coeff * theta_dot

    # 5. Recovery boost
    if (abs(theta) > 0.12) or (abs(theta_dot) > 0.15):
        boost_gain = 0.8 + 8.0 * (abs(theta) - 0.12) / (0.20 - 0.12)
        boost_gain = clamp(boost_gain, 0.0, 2.8)
        if theta * theta_dot > 0:
            recovery = -boost_gain * sign(theta)
        else:
            recovery = 0.0
    else:
        recovery = 0.0

    # 6. Weak cart‑centering
    cart_center_weak = clamp(0.30 * x + 0.20 * x_dot, -1.5, 1.5)

    # 7. Strong cart‑centering
    if (abs(theta) < 0.05 and abs(theta_dot) < 0.08) or (abs(x) > 1.2):
        edge_factor = clamp((abs(x) - 1.2) / 0.8, 0.0, 1.0)
        strong_gain = 0.45 + 0.55 * edge_factor
        cart_center_strong = clamp(strong_gain * x + (0.30 + 0.30 * edge_factor) * x_dot, -2.5, 2.5)
    else:
        cart_center_strong = 0.0

    # 8. Edge repulsion
    if abs(x) > 1.5:
        rep_coeff = 0.6 * (abs(x) - 1.5) / (2.4 - 1.5)
        edge_repulsion = -rep_coeff * sign(x)
    else:
        edge_repulsion = 0.0

    # 9. Static‑friction bias
    if (0.003 < abs(theta) < 0.015) and (abs(theta_dot) < 0.01):
        bias = 0.012 * sign(theta)
    else:
        bias = 0.0

    # 10. Cart velocity feed‑forward damping
    vel_feed = -0.05 * x_dot

    # 11. Combine terms
    raw = (pole_pd + pole_damp + recovery
           - cart_center_weak - cart_center_strong
           + edge_repulsion + bias + vel_feed)

    # 12. Limit raw before saturation
    raw = clamp(raw, -5.0, 5.0)

    # 13. Smooth saturation to actuator limits
    force = clamp(3.0 * math.tanh(raw / 3.0), -3.0, 3.0)

    return force

    # Default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
