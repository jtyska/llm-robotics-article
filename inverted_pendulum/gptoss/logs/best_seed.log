**2. New strategy – “Adaptive‑PD‑Integral‑Center (APDIC)”**

Below is a compact, human‑readable rule set that incorporates the lessons above.  
All numeric constants were chosen by hand‑tuning on the observed data; they can be further refined with a simple grid‑search if needed.

```text
# --------------------------------------------------------------
#  Helper functions (pseudo‑code)
# --------------------------------------------------------------
sign(v)      =  1  if v > 0 else -1  if v < 0 else 0
clamp(v, lo, hi) = max(lo, min(hi, v))

# --------------------------------------------------------------
#  1. Safety check
# --------------------------------------------------------------
IF NOT is_finite(x) OR NOT is_finite(x_dot) OR NOT is_finite(theta) OR NOT is_finite(theta_dot)
THEN
    force = 0.0
    RETURN

# --------------------------------------------------------------
#  2. Immediate “hard‑stop” when the pole is already out of bounds
# --------------------------------------------------------------
IF abs(theta) >= 0.20
THEN
    force = -3.0 * sign(theta)          # push back as hard as possible
    RETURN

# --------------------------------------------------------------
#  3. Core pole controller (PD + small Integral)
# --------------------------------------------------------------
#   Proportional & derivative gains – a bit higher than the best previous run
Kp_theta = 7.0
Kd_theta = 3.5

pole_pd   = Kp_theta * theta + Kd_theta * theta_dot

#   Integral on theta (anti‑wind‑up)
theta_int = clamp(theta_int + 0.002 * theta, -0.07, 0.07)   # persistent across steps
int_term  = -4.0 * theta_int                               # negative feedback

# --------------------------------------------------------------
#  4. Adaptive damping (depends on both angle and angular speed)
# --------------------------------------------------------------
#   Base damping + extra when the pole is far from vertical OR moving fast
base_damp   = 0.6
angle_factor = (abs(theta) / 0.20)          # 0 … 1
vel_factor   = (abs(theta_dot) / 2.0)       # normalise by a typical max speed
damp_coeff   = base_damp + 1.2 * angle_factor + 0.8 * vel_factor
pole_damp    = -damp_coeff * theta_dot

# --------------------------------------------------------------
#  5. Recovery boost – aggressive when the pole is already tilting
# --------------------------------------------------------------
IF (abs(theta) > 0.12) OR (abs(theta_dot) > 0.15)
THEN
    # Linear growth from 0.8 at |θ|=0.12 to the full actuator limit at |θ|=0.20
    boost_gain = 0.8 + 22.0 * (abs(theta) - 0.12) / (0.20 - 0.12)   # 0.8 … ≈3.0
    boost_gain = clamp(boost_gain, 0.0, 3.0)                        # never exceed actuator
    IF theta * theta_dot > 0
    THEN recovery = -boost_gain * sign(theta)                     # push opposite to tilt
    ELSE recovery = 0.0
    ENDIF
ELSE
    recovery = 0.0
ENDIF

# --------------------------------------------------------------
#  6. Cart centering (weak + strong) – act early, act strong when needed
# --------------------------------------------------------------
#   Weak centering always present (keeps the cart near zero)
cart_center_weak = clamp(0.40 * x + 0.25 * x_dot, -2.0, 2.0)

#   Strong centering when the cart is noticeably away from centre
IF abs(x) > 0.6
THEN
    edge_factor   = clamp((abs(x) - 0.6) / 0.9, 0.0, 1.0)   # 0 … 1   (starts at |x|=0.6 m)
    strong_gain   = 0.6 + 0.9 * edge_factor                # 0.6 … 1.5
    cart_center_strong = clamp(strong_gain * x
                               + (0.35 + 0.35 * edge_factor) * x_dot,
                               -3.0, 3.0)
ELSE
    cart_center_strong = 0.0
ENDIF

# --------------------------------------------------------------
#  7. Edge‑repulsion – soft push that begins well before the track limit
# --------------------------------------------------------------
IF abs(x) > 1.0
THEN
    rep_factor = clamp((abs(x) - 1.0) / (2.4 - 1.0), 0.0, 1.0)   # 0 … 1
    rep_coeff  = 0.7 * rep_factor                               # up to 0.7 N
    edge_repulsion = -rep_coeff * sign(x)
ELSE
    edge_repulsion = 0.0
ENDIF

# --------------------------------------------------------------
#  8. Static‑friction bias – tiny nudge when the pole is almost still
# --------------------------------------------------------------
IF (0.003 < abs(theta) < 0.015) AND (abs(theta_dot) < 0.01)
THEN
    bias = 0.012 * sign(theta)
ELSE
    bias = 0.0
ENDIF

# --------------------------------------------------------------
#  9. Cart‑velocity feed‑forward (helps cancel inertia)
# --------------------------------------------------------------
vel_feed = -0.07 * x_dot

# --------------------------------------------------------------
# 10. Combine everything
# --------------------------------------------------------------
raw = ( pole_pd + pole_damp + int_term + recovery
        - cart_center_weak - cart_center_strong
        + edge_repulsion + bias + vel_feed )

#   Clamp the raw command to a safe range before the tanh squashing
raw = clamp(raw, -5.5, 5.5)

#   Map to the actuator limits (smooth saturation)
force = clamp(3.0 * tanh(raw / 3.0), -3.0, 3.0)
```

