import random, math

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    xdot = cart_velocity
    thetad = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(xdot) and math.isfinite(theta) and math.isfinite(thetad)):
        return 0.0

    # compute adaptive scaling
    scale = 1.0 + 3.0 * min(abs(theta), 0.20)
    if scale > 1.6:
        scale = 1.6

    # choose cart‑feedback gains
    if abs(x) > 0.5 or abs(xdot) > 0.5:
        Kp_cart = 2.0
        Kd_cart = 1.5
    else:
        Kp_cart = 1.2
        Kd_cart = 0.8

    # raw PD output (negative feedback)
    raw = -(4.5 * theta + 2.0 * thetad - (Kp_cart * x + Kd_cart * xdot))

    # apply scaling
    raw = raw * scale

    # small‑angle bias
    if 0.003 < abs(theta) < 0.020:
        raw = raw + 0.02 * math.copysign(1.0, theta)

    # smooth dead‑zone
    if abs(theta) < 0.003 and abs(thetad) < 0.006:
        raw = 0.1 * raw

    # clip to actuator limits
    if raw > 3.0:
        force = 3.0
    elif raw < -3.0:
        force = -3.0
    else:
        force = raw

    return force

    # default random action (fallback)
    return random.uniform(-3.0, 3.0)
