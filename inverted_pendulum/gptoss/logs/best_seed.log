        scale = 1.0 + 2.2 * min(abs(pole_angle), 0.20)
        raw_force = raw_force * scale
        force_raw = 3.0 * math.tanh(raw_force / 3.0)
        if force_raw > 3.0:
            force = 3.0
        elif force_raw < -3.0:
            force = -3.0
        else:
            force = force_raw
    if force is None:
        return random.uniform(-3, 3)
    return force
