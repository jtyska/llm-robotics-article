import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    def is_finite(v):
        return math.isfinite(v)

    def clamp(v, lo, hi):
        return max(lo, min(v, hi))

    def sign(v):
        if v > 0:
            return 1.0
        if v < 0:
            return -1.0
        return 0.0

    # Rule 1 – Finite‑state guard
    if not (is_finite(x) and is_finite(x_dot) and is_finite(theta) and is_finite(theta_dot)):
        return 0.0

    # Rule 2 – Hard stop when the pole is out of the safe window
    if abs(theta) >= 0.20:
        return -3.0 * sign(theta)

    # Rule 3 – Compute pole PD term
    pole_pd = 4.8 * theta + 3.2 * theta_dot

    # Rule 4 – Angle‑dependent viscous damping
    damp_coeff = 0.6 + 0.8 * (abs(theta) / 0.20)
    pole_damp = -damp_coeff * theta_dot

    # Rule 5 – Adaptive recovery boost
    if (abs(theta) > 0.12) or (abs(theta_dot) > 0.15):
        boost_raw = 0.9 + 5.5 * (abs(theta) - 0.12) / (0.20 - 0.12)
        boost_gain = min(boost_raw, 2.2)
        if theta * theta_dot > 0:
            recovery = -boost_gain * sign(theta)
        else:
            recovery = 0.0
    else:
        recovery = 0.0

    # Rule 6 – Weak cart‑centering (always on)
    cart_center_weak = 0.30 * x + 0.18 * x_dot
    cart_center_weak = clamp(cart_center_weak, -1.5, 1.5)

    # Rule 7 – Strong cart‑centering (only when pole is very stable)
    if (abs(theta) < 0.05) and (abs(theta_dot) < 0.08):
        edge_factor = clamp((abs(x) - 1.5) / 0.7, 0.0, 1.0)
        strong_gain = 0.45 + 0.55 * edge_factor
        cart_center_strong = strong_gain * x + (0.30 + 0.30 * edge_factor) * x_dot
        cart_center_strong = clamp(cart_center_strong, -2.5, 2.5)
    else:
        cart_center_strong = 0.0

    # Rule 8 – Tiny symmetry‑breaking bias
    if (0.003 < abs(theta) < 0.015) and (abs(theta_dot) < 0.01):
        bias = 0.012 * sign(theta)
    else:
        bias = 0.0

    # Rule 9 – Velocity feed‑forward
    vel_feed = -0.06 * x_dot

    # Rule 10 – Combine all contributions
    raw = pole_pd + pole_damp + recovery - cart_center_weak - cart_center_strong + bias + vel_feed
    raw = clamp(raw, -5.5, 5.5)

    # Rule 11 – Final saturation (produces the action)
    force = 3.0 * math.tanh(raw / 3.0)
    return force

    # Default random action (should never be reached)
    # return random.uniform(-3.0, 3.0)
