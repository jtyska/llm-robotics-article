import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    xdot = cart_velocity
    thetad = pole_angular_velocity

    # Rule 1: non‑finite values
    if not (math.isfinite(x) and math.isfinite(xdot) and math.isfinite(theta) and math.isfinite(thetad)):
        return 0.0

    # Rule 2: pole angle out of bounds
    if abs(theta) > 0.20:
        return 0.0

    # Rule 3: near‑upright dead zone
    if abs(theta) < 0.003 and abs(thetad) < 0.006:
        return 0.0

    # Main control computation
    scale_val = 1.0 + 2.0 * (abs(theta) / 0.20)
    scale = 1.5 if scale_val > 1.5 else scale_val

    pole_pd = 3.5 * theta + 2.0 * thetad

    damp = 0.8 if abs(theta) > 0.05 else 0.5
    pole_damp = -damp * thetad

    if abs(x) > 0.05:
        gain = 0.6 if abs(x) > 0.20 else 0.4
        cart_term = gain * x + 0.3 * xdot
        cart_term = max(min(cart_term, 1.5), -1.5)
    else:
        cart_term = 0.0

    if abs(theta) < 0.02 and abs(thetad) > 0.15:
        ff = -0.45 * math.copysign(1.0, thetad)
    else:
        ff = 0.0

    if 0.003 < abs(theta) < 0.020 and abs(thetad) < 0.01:
        bias = 0.006 * math.copysign(1.0, theta) * scale
    else:
        bias = 0.0

    raw = scale * (pole_pd + pole_damp - cart_term + ff) + bias
    force = 3.0 * math.tanh(raw / 3.0)

    return force if math.isfinite(force) else random.uniform(-3.0, 3.0)
