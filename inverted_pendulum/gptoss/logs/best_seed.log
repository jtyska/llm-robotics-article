import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    def is_finite(v):
        return math.isfinite(v)
    def sign(v):
        return 1.0 if v > 0 else -1.0 if v < 0 else 0.0
    def clamp(v, lo, hi):
        return max(lo, min(v, hi))

    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    if (not is_finite(x) or not is_finite(x_dot) or
        not is_finite(theta) or not is_finite(theta_dot)):
        return 0.0

    if abs(theta) >= 0.20:
        return -3.0 * sign(theta)

    # ----- pole PD -----
    Kp_theta = 5.2
    Kd_theta = 3.4
    pole_pd = Kp_theta * theta + Kd_theta * theta_dot

    # ----- adaptive damping -----
    damp_coeff = 0.5 + 0.7 * (abs(theta) / 0.20)
    pole_damp = -damp_coeff * theta_dot

    # ----- recovery boost -----
    if (abs(theta) > 0.12) or (abs(theta_dot) > 0.15):
        boost_gain = 0.8 + (2.0 - 0.8) * ((abs(theta) - 0.12) / (0.20 - 0.12))**2
        boost_gain = min(boost_gain, 2.0)
        if theta * theta_dot > 0:
            recovery = -boost_gain * sign(theta)
        else:
            recovery = 0.0
    else:
        recovery = 0.0

    # ----- weak cart centering -----
    cart_center_weak = clamp(0.35 * x + 0.22 * x_dot, -1.8, 1.8)

    # ----- strong cart centering -----
    if (abs(theta) < 0.05 and abs(theta_dot) < 0.08) or (abs(x) > 1.2):
        edge_factor = clamp((abs(x) - 1.2) / 0.8, 0.0, 1.0)
        strong_gain = 0.45 + 0.55 * edge_factor
        cart_center_strong = clamp(strong_gain * x +
                                   (0.30 + 0.30 * edge_factor) * x_dot,
                                   -2.5, 2.5)
    else:
        cart_center_strong = 0.0

    # ----- edge repulsion -----
    if abs(x) > 1.3:
        rep_coeff = 0.6 * (abs(x) - 1.3) / (2.4 - 1.3)
        edge_repulsion = -rep_coeff * sign(x)
    else:
        edge_repulsion = 0.0

    # ----- static‑friction bias -----
    if (0.003 < abs(theta) < 0.015) and (abs(theta_dot) < 0.01):
        bias = 0.012 * sign(theta)
    else:
        bias = 0.0

    # ----- cart velocity feed‑forward -----
    vel_feed = -0.05 * x_dot

    # ----- combine raw command -----
    raw = (pole_pd + pole_damp + recovery
           - cart_center_weak - cart_center_strong
           + edge_repulsion + bias + vel_feed)
    raw = clamp(raw, -5.0, 5.0)

    # ----- map to actuator limits -----
    force = clamp(3.0 * math.tanh(raw / 3.0), -3.0, 3.0)
    return force

    # default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
