import math, random

def clamp(value, min_val, max_val):
    return max(min_val, min(max_val, value))

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Rule 0 – Safety guard
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    # Rule 1 – Emergency angle limit
    if abs(pole_angle) >= 0.20:
        return -3.0 * math.copysign(1.0, pole_angle)

    # Rule 2 – Core computation
    gain_scale = 1.0 - 0.30 * (abs(cart_position) / 2.4)
    pole_pd = gain_scale * (5.5 * pole_angle + 3.3 * pole_angular_velocity)

    damp_coeff = 0.5 + 0.9 * (abs(pole_angle) / 0.20)
    pole_damp = -damp_coeff * pole_angular_velocity

    # Rule 3 – Boost / recovery
    if (abs(pole_angle) > 0.12 or abs(pole_angular_velocity) > 0.15) and (pole_angle * pole_angular_velocity > 0):
        boost_gain = 0.8 + 3.0 * (abs(pole_angle) - 0.12) / (0.20 - 0.12) + \
                     1.0 * ((abs(pole_angle) - 0.12) / (0.20 - 0.12)) ** 2
        boost_gain = clamp(boost_gain, 0.0, 4.0)
        recovery = -boost_gain * math.copysign(1.0, pole_angle)
    else:
        recovery = 0.0

    # Rule 4 – Cart centering (weak term)
    cart_center_weak = clamp(0.45 * cart_position + 0.30 * cart_velocity, -2.0, 2.0)

    # Rule 5 – Cart centering (strong term, smooth activation)
    edge_factor = 0.0
    if abs(cart_position) > 0.6:
        edge_factor = clamp((abs(cart_position) - 0.6) / (2.4 - 0.6), 0.0, 1.0)
        strong_gain = 0.6 + 0.9 * edge_factor
        strong_vel = 0.35 + 0.35 * edge_factor
        cart_center_strong = clamp(strong_gain * cart_position + strong_vel * cart_velocity,
                                   -3.0, 3.0)
    else:
        cart_center_strong = 0.0

    # Rule 6 – Edge repulsion (always‑on, smooth)
    rep_coeff = 0.9 * edge_factor

    # Combine all contributions
    force = pole_pd + pole_damp + recovery + cart_center_weak + cart_center_strong + rep_coeff
    force = clamp(force, -3.0, 3.0)

    # Default random action (should not be reached)
    if not math.isfinite(force):
        return random.uniform(-3.0, 3.0)
    return force
