   CART‑POLE BALANCER – version 4
   -------------------------------------------------------------
   State variables (persistent across steps):
       drift_sum   ← 0.0          // integral‑like term
   ------------------------------------------------------------- */

IF NOT is_finite(x) OR NOT is_finite(x_dot) OR
   NOT is_finite(theta) OR NOT is_finite(theta_dot) THEN
    force ← 0.0
    RETURN

/* -----------------------------------------------------------------
   1. Safety envelope – never let the pole cross the hard limit.
   ----------------------------------------------------------------- */
IF abs(theta) ≥ 0.20 THEN
    /* apply a modest corrective push, not the full ‑3 N */
    force ← -2.0 * sign(theta)          // still pushes back, but softer
    RETURN

/* -----------------------------------------------------------------
