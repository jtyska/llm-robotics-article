import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    xdot = cart_velocity
    thetad = pole_angular_velocity

    def is_finite(v):
        return math.isfinite(v)

    def clamp(v, lo, hi):
        return max(lo, min(v, hi))

    def sign(v):
        return 1 if v > 0 else -1 if v < 0 else 0

    # Rule 1: non‑finite inputs
    if not (is_finite(x) and is_finite(xdot) and is_finite(theta) and is_finite(thetad)):
        return 0.0

    # Rule 2: near‑zero pole state
    if abs(theta) < 0.003 and abs(thetad) < 0.006:
        return 0.0

    # Main control law
    scale = 1.0 + 2.5 * min(abs(theta), 0.20)
    if scale > 1.5:
        scale = 1.5

    pole_pd = 3.5 * theta + 2.0 * thetad
    damp_factor = 0.5 + 0.3 * (abs(theta) / 0.20)
    pole_damp = -damp_factor * thetad

    cart_term = 0.0
    if abs(x) > 0.05:
        raw_center = 0.4 * x + 0.3 * xdot
        cart_term = clamp(raw_center, -1.5, 1.5)

    ff = 0.0
    if abs(theta) < 0.02 and abs(thetad) > 0.15:
        ff = -0.2 * sign(thetad)

    raw = scale * (pole_pd + pole_damp - cart_term + ff)

    if 0.003 < abs(theta) < 0.020 and abs(thetad) < 0.01:
        raw = raw + 0.006 * sign(theta) * scale

    force = 3.0 * math.tanh(raw / 3.0)
    return force

    # Default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
