def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    if not hasattr(get_action, "drift_sum"):
        get_action.drift_sum = 0.0
    def is_finite(v):
        return math.isfinite(v)
    def sign(v):
        return 1.0 if v > 0 else -1.0 if v < 0 else 0.0
    def clip(v, lo, hi):
        return max(lo, min(v, hi))
    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity
    if not (is_finite(x) and is_finite(x_dot) and is_finite(theta) and is_finite(theta_dot)):
        return 0.0
    if abs(theta) >= 0.20:
        return -3.0 * sign(theta)
    pole_pd = 4.2 * theta + 2.6 * theta_dot
    damp_coeff = 0.5 + 0.5 * (abs(theta) / 0.20)
    pole_damp = -damp_coeff * theta_dot
    if abs(theta) > 0.15 and theta * theta_dot > 0:
        dist_to_limit = 0.20 - abs(theta)
        boost_gain = 0.6 + 4.0 * (0.05 - dist_to_limit)
        recovery = -boost_gain * sign(theta)
    else:
        recovery = 0.0
    cart_term_raw = 0.08 * x + 0.04 * x_dot
    cart_term = clip(cart_term_raw, -0.8, 0.8)
    if abs(theta) < 0.08 and abs(theta_dot) < 0.10:
        strong_center = clip(0.25 * x + 0.15 * x_dot, -1.2, 1.2)
    else:
        strong_center = 0.0
    if 0.003 < abs(theta) < 0.015 and abs(theta_dot) < 0.01:
        bias = 0.004 * sign(theta)
    else:
        bias = 0.0
    get_action.drift_sum = clip(get_action.drift_sum + 0.0015 * sign(theta), -0.08, 0.08)
    drift_sum = get_action.drift_sum
    raw = pole_pd + pole_damp + recovery - cart_term - strong_center + bias + drift_sum
    raw = clip(raw, -4.5, 4.5)
    force = 3.0 * math.tanh(raw / 3.0)
    return force
    return random.uniform(-3.0, 3.0)
