import random
import math

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    xdot = cart_velocity
    thetad = pole_angular_velocity

    # Rule 1: non‑finite values
    if not (math.isfinite(x) and math.isfinite(xdot) and math.isfinite(theta) and math.isfinite(thetad)):
        return 0.0

    # Rule 2: near‑upright region
    if abs(theta) < 0.010 and abs(thetad) < 0.020:
        force = -0.2 * x
        if force > 3.0:
            force = 3.0
        elif force < -3.0:
            force = -3.0
        return force

    # Rule 3: general case
    pole_term = 3.5 * theta + 2.0 * thetad
    cart_term = 0.2 * x + 0.3 * xdot
    raw = -(pole_term - cart_term)
    scale = 1.0 + 1.5 * min(abs(theta), 0.20)
    raw = raw * scale
    force = 3.0 * math.tanh(raw / 3.0)
    if force > 3.0:
        force = 3.0
    elif force < -3.0:
        force = -3.0
    return force

    # Default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
