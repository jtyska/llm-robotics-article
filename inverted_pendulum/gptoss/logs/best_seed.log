import math, random

drift_sum = 0.0

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    global drift_sum

    def is_finite(v):
        return math.isfinite(v)

    def sign(v):
        return 1.0 if v > 0 else (-1.0 if v < 0 else 0.0)

    def clip(v, lo, hi):
        return max(lo, min(hi, v))

    x = cart_position
    theta = pole_angle
    xdot = cart_velocity
    thetad = pole_angular_velocity

    # 1. Safety guard
    if not (is_finite(x) and is_finite(xdot) and is_finite(theta) and is_finite(thetad)):
        return 0.0

    # 2. Hard limit – emergency push
    if abs(theta) >= 0.20:
        return -3.0 * sign(theta)

    # 3. Near‑zero dead‑zone (no action needed)
    if abs(theta) < 0.003 and abs(thetad) < 0.006:
        return 0.0

    # 4. Core control computation
    # 4.1 Scaling
    scale = 1.0 + 2.0 * min(abs(theta), 0.20)
    if scale > 1.5:
        scale = 1.5

    # 4.2 Pole PD term
    kp = 4.4
    kd = 2.8
    pole_pd = kp * theta + kd * thetad

    # 4.3 Angle‑dependent viscous damping
    damp_coeff = 0.5 + 0.5 * (abs(theta) / 0.20)  # 0.5 … 1.0
    pole_damp = -damp_coeff * thetad

    # 4.4 Recovery boost
    recovery = 0.0
    if abs(theta) > 0.12 and theta * thetad > 0:
        recovery = -2.0 * sign(theta)

    # 4.5 Cart‑centering term
    cart_term = 0.0
    if abs(theta) < 0.12 and abs(thetad) < 0.20:
        cent_gain = 0.45 + 0.30 * clip(abs(x) / 0.30, 0.0, 1.0)
        cart_term = cent_gain * x + 0.35 * xdot
        cart_term = clip(cart_term, -1.8, 1.8)

    # 4.6 Tiny bias in the mid‑zone
    bias = 0.0
    if 0.003 < abs(theta) < 0.020 and abs(thetad) < 0.01:
        bias = 0.008 * sign(theta) * scale

    # 4.7 Integral‑like drift compensation
    drift_sum += 0.003 * sign(theta)
    drift_sum = clip(drift_sum, -0.07, 0.07)
    drift_bias = drift_sum

    # 4.8 Combine everything
    raw = scale * (pole_pd + pole_damp + recovery - cart_term) + bias + drift_bias

    # 4.9 Saturate to allowed force range
    force = 3.0 * math.tanh(raw / 3.0)

    # fallback (should never reach here)
    if force is None:
        return random.uniform(-3.0, 3.0)
    return force
