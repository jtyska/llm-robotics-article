        F_raw = -(3.0 * pole_angle) - (1.5 * pole_angular_velocity) - (0.5 * cart_position) - (0.4 * cart_velocity)
        if F_raw > 3.0:
            action = 3.0
        elif F_raw < -3.0:
            action = -3.0
        else:
            action = F_raw
    if action is None:
        action = random.uniform(-3, 3)
    return action
