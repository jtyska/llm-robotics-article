import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    xdot = cart_velocity
    thetad = pole_angular_velocity

    # Check for non‑finite values
    if not (math.isfinite(x) and math.isfinite(xdot) and math.isfinite(theta) and math.isfinite(thetad)):
        return 0.0

    # Failure angle check
    if abs(theta) > 0.20:
        return 0.0

    # Near‑zero angle and angular velocity
    if abs(theta) < 0.003 and abs(thetad) < 0.006:
        return 0.0

    # Main control law
    scale = 1.0 + 2.0 * min(abs(theta), 0.20)
    if scale > 1.5:
        scale = 1.5

    pole_pd = 3.5 * theta + 2.0 * thetad
    cart_term = 0.4 * x + 0.3 * xdot
    damp = -0.5 * thetad

    raw = scale * (pole_pd + damp - cart_term)

    if 0.003 < abs(theta) < 0.020:
        sign_theta = 1.0 if theta > 0 else -1.0
        raw += 0.008 * sign_theta * scale

    force = 3.0 * math.tanh(raw / 3.0)
    return force

    # fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
