import random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    xdot = cart_velocity
    thetad = pole_angular_velocity

    force = None

    if abs(theta) < 0.002 and abs(thetad) < 0.004:
        force = 0.0
    else:
        scale = 1.0 + 3.0 * min(abs(theta), 0.2)
        if scale > 1.6:
            scale = 1.6

        pole_term = 4.2 * theta + 2.8 * thetad
        cart_term = 0.35 * x + 0.25 * xdot

        raw = scale * (pole_term - cart_term)

        if abs(theta) > 0.002 and abs(theta) < 0.018:
            raw += 0.010 * (1 if theta > 0 else -1 if theta < 0 else 0)

        if raw > 3.0:
            force = 3.0
        elif raw < -3.0:
            force = -3.0
        else:
            force = raw

    if force is None:
        return random.uniform(-3.0, 3.0)
    return force
