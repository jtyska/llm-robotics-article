import random
import math

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    xdot = cart_velocity
    thetadot = pole_angular_velocity

    if abs(theta) < 0.004 and abs(thetadot) < 0.008:
        return 0.0
    else:
        pole_term = 3.0 * theta + 1.8 * thetadot
        cart_term = 0.5 * x + 0.4 * xdot

        if abs(x) > 0.5:
            center_term = 1.2 * (0.0 - x)
        else:
            center_term = 0.0

        F_raw = pole_term - cart_term + center_term

        if 0.004 < abs(theta) < 0.02:
            sign_theta = math.copysign(1, theta) if theta != 0 else 0
            F_raw += 0.01 * sign_theta

        if F_raw > 3.0:
            action = 3.0
        elif F_raw < -3.0:
            action = -3.0
        else:
            action = F_raw

        return action

    # Default random action if somehow no rule applies
    return random.uniform(-3, 3)
