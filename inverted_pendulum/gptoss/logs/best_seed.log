import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    def is_finite(v):
        return math.isfinite(v)

    def sign(v):
        return 1.0 if v > 0 else -1.0 if v < 0 else 0.0

    def clamp(v, lo, hi):
        return max(lo, min(v, hi))

    # Rule 1: non‑finite check
    if not (is_finite(x) and is_finite(x_dot) and is_finite(theta) and is_finite(theta_dot)):
        return 0.0

    # Rule 2: angle out of bounds
    if abs(theta) >= 0.20:
        return -3.0 * sign(theta)

    # Main control logic
    pole_pd = 4.6 * theta + 2.9 * theta_dot

    damp_coeff = 0.6 + 0.6 * (abs(theta) / 0.20)          # 0.6 … 1.2
    pole_damp = -damp_coeff * theta_dot

    # Recovery boost
    if (abs(theta) > 0.12) or (abs(theta_dot) > 0.15):
        boost_gain = 0.5 + 0.8 * (abs(theta) - 0.12) / (0.20 - 0.12)
        boost_gain = clamp(boost_gain, 0.5, 1.3)
        if theta * theta_dot > 0:
            recovery = -boost_gain * sign(theta)
        else:
            recovery = 0.0
    else:
        recovery = 0.0

    cart_center_weak = clamp(0.30 * x + 0.18 * x_dot, -1.5, 1.5)

    if (abs(theta) < 0.07) and (abs(theta_dot) < 0.09):
        cart_center_strong = clamp(0.55 * x + 0.35 * x_dot, -2.0, 2.0)
    else:
        cart_center_strong = 0.0

    if (0.002 < abs(theta) < 0.020) and (abs(theta_dot) < 0.01):
        bias = 0.008 * sign(theta)
    else:
        bias = 0.0

    vel_feed = -0.07 * x_dot

    raw = (pole_pd + pole_damp + recovery
           - cart_center_weak - cart_center_strong
           + bias + vel_feed)

    raw = clamp(raw, -4.5, 4.5)

    force = 3.0 * math.tanh(raw / 3.0)

    return force if force is not None else random.uniform(-3.0, 3.0)
