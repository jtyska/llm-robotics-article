# 7. Saturation with smooth tanh (keeps the output within [-3,3])
# -------------------------------------------------
force_raw = 3.0 * tanh( raw / 3.0 )      # smooth clipping

# -------------------------------------------------
# 8. Final hard clipping (just in case)
# -------------------------------------------------
IF force_raw > 3.0  THEN force ← 3.0
ELSE IF force_raw < -3.0 THEN force ← -3.0
ELSE force ← force_raw
END IF

RETURN force
```

