    if abs(cart_position) > 0.04 or abs(cart_velocity) > 0.03:
        B = 0.6 * cart_position + 0.4 * cart_velocity
    else:
        B = 0.0
    F = -(A - B)
    if F > 3.0:
        action = 3.0
    elif F < -3.0:
        action = -3.0
    else:
        action = F
    if action is None:
        return random.uniform(-3, 3)
    return action
