def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x = cart_position
    xdot = cart_velocity
    theta = pole_angle
    thetad = pole_angular_velocity
    force = None

    # Rule 1: non‑finite values
    if not (math.isfinite(x) and math.isfinite(xdot) and math.isfinite(theta) and math.isfinite(thetad)):
        force = 0.0

    # Rule 2: near‑zero angle and angular velocity
    elif abs(theta) < 0.003 and abs(thetad) < 0.006:
        force = 0.0

    # Rule 3: main control law
    else:
        pole_term = 3.5 * theta + 2.0 * thetad
        cart_term = 0.4 * x + 0.3 * xdot
        raw = -(pole_term - cart_term)

        scale = 1.0 + 2.5 * min(abs(theta), 0.20)
        if scale > 1.5:
            scale = 1.5
        raw = raw * scale

        if 0.003 < abs(theta) < 0.020:
            raw += 0.008 * (1 if theta > 0 else -1)

        if raw > 3.0:
            force = 3.0
        elif raw < -3.0:
            force = -3.0
        else:
            force = raw

    # Default random action if for some reason no rule set force
    if force is None:
        force = random.uniform(-3.0, 3.0)

    return force
