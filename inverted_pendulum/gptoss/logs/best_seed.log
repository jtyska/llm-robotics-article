    Kp   = 8.5          # pole proportional
    Kd   = 3.2          # pole derivative
    Kx   = 0.55         # cart position
    Kv   = 0.38         # cart velocity

    # ---- raw PD terms -----------------------------------------
    pole_term = Kp * theta + Kd * thetad
    cart_term = Kx * x + Kv * xdot

    raw = -(pole_term - cart_term)      # negative feedback

    # ---- angle‑dependent scaling --------------------------------
    #   grows from 1.0 (vertical) to at most 2.5 (|θ|≈0.20 rad)
    scale = 1.0 + 3.0 * min(abs(theta), 0.20)
    IF scale > 2.5 THEN scale = 2.5
    raw = raw * scale

    # ---- small‑angle bias (kick) --------------------------------
    IF 0.003 < abs(theta) < 0.020
        THEN raw = raw + 0.010 * sign(theta)

    # ---- clip to actuator limits --------------------------------
    IF raw > 3.0   THEN force = 3.0
    ELSE IF raw < -3.0 THEN force = -3.0
    ELSE force = raw
END IF
```

