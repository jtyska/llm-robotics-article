import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # helpers
    def sign(v):
        return 1.0 if v > 0 else -1.0 if v < 0 else 0.0
    def clamp(v, lo, hi):
        return max(lo, min(hi, v))
    # initialize persistent integral term
    if not hasattr(get_action, "theta_int"):
        get_action.theta_int = 0.0
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity
    # check finiteness
    if not (math.isfinite(x) and math.isfinite(theta) and math.isfinite(x_dot) and math.isfinite(theta_dot)):
        return 0.0
    # angle out of bounds
    if abs(theta) >= 0.20:
        return -3.0 * sign(theta)
    # core PD
    pole_pd = 6.5 * theta + 4.5 * theta_dot
    # adaptive damping
    damp_coeff = 0.6 + 1.0 * (abs(theta) / 0.20)
    pole_damp = -damp_coeff * theta_dot
    # integral term
    get_action.theta_int = clamp(get_action.theta_int + 0.001 * theta, -0.05, 0.05)
    int_term = -2.0 * get_action.theta_int
    # recovery boost
    if (abs(theta) > 0.12) or (abs(theta_dot) > 0.15):
        boost_gain = 1.0 + 4.0 * (abs(theta) - 0.12) / (0.20 - 0.12)
        boost_gain = clamp(boost_gain, 0.0, 5.0)
        if theta * theta_dot > 0:
            recovery = -boost_gain * sign(theta)
        else:
            recovery = 0.0
    else:
        recovery = 0.0
    # weak cart centering
    cart_center_weak = clamp(0.30 * x + 0.20 * x_dot, -1.5, 1.5)
    # strong cart centering
    if abs(x) > 0.9:
        edge_factor = clamp((abs(x) - 0.9) / 0.6, 0.0, 1.0)
        strong_gain = 0.5 + 0.5 * edge_factor
        cart_center_strong = clamp(strong_gain * x + (0.35 + 0.35 * edge_factor) * x_dot, -2.5, 2.5)
    else:
        cart_center_strong = 0.0
    # edge repulsion
    if abs(x) > 1.8:
        rep_coeff = 0.8 * (abs(x) - 1.8) / (2.4 - 1.8)
        edge_repulsion = -rep_coeff * sign(x)
    else:
        edge_repulsion = 0.0
    # static‑friction bias
    if (0.003 < abs(theta) < 0.015) and (abs(theta_dot) < 0.01):
        bias = 0.012 * sign(theta)
    else:
        bias = 0.0
    # velocity feed‑forward
    vel_feed = -0.07 * x_dot
    # combine
    raw = (pole_pd + pole_damp + int_term + recovery
           - cart_center_weak - cart_center_strong
           + edge_repulsion + bias + vel_feed)
    raw = clamp(raw, -4.5, 4.5)
    force = clamp(3.0 * math.tanh(raw / 3.0), -3.0, 3.0)
    return force if force is not None else random.uniform(-3.0, 3.0)
