import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    def is_finite(v):
        return math.isfinite(v)

    def sign(v):
        if v > 0:
            return 1.0
        if v < 0:
            return -1.0
        return 0.0

    def clamp(v, lo, hi):
        return max(lo, min(hi, v))

    # Rule 1
    if not (is_finite(x) and is_finite(x_dot) and is_finite(theta) and is_finite(theta_dot)):
        return 0.0

    # Rule 2
    if abs(theta) >= 0.20:
        return -3.0 * sign(theta)

    # Rule 3
    # 1. pole PD
    pole_pd = 4.5 * theta + 2.8 * theta_dot

    # 2. pole damping
    damp_coeff = 0.5 + 0.7 * (abs(theta) / 0.20)  # range 0.5 -> 1.2
    pole_damp = -damp_coeff * theta_dot

    # 3. Recovery boost
    if abs(theta) > 0.12 or abs(theta_dot) > 0.15:
        boost_gain = 0.8 + 8.0 * ((abs(theta) - 0.12) / (0.20 - 0.12)) ** 2
        if boost_gain > 2.5:
            boost_gain = 2.5
        if theta * theta_dot > 0:
            recovery = -boost_gain * sign(theta)
        else:
            recovery = 0.0
    else:
        recovery = 0.0

    # 4. Weak centering
    cart_center_weak = clamp(0.35 * x + 0.22 * x_dot, -1.8, 1.8)

    # 5. Strong centering
    if (abs(theta) < 0.05 and abs(theta_dot) < 0.08) or abs(x) > 1.2:
        edge_factor = clamp((abs(x) - 1.2) / 0.8, 0.0, 1.0)
        strong_gain = 0.45 + 0.55 * edge_factor
        cart_center_strong = clamp(strong_gain * x + (0.30 + 0.30 * edge_factor) * x_dot, -2.5, 2.5)
    else:
        cart_center_strong = 0.0

    # 6. Edge‑repel
    if abs(x) > 1.6:
        rep_coeff = 0.6 * (abs(x) - 1.6) / (2.4 - 1.6)  # 0 -> 0.6
        edge_repulsion = -rep_coeff * sign(x)
    else:
        edge_repulsion = 0.0

    # 7. Bias
    if 0.003 < abs(theta) < 0.015 and abs(theta_dot) < 0.01:
        bias = 0.012 * sign(theta)
    else:
        bias = 0.0

    # 8. Velocity feedforward
    vel_feed = -0.05 * x_dot

    # 9. Combine
    raw = (pole_pd + pole_damp + recovery
           - cart_center_weak - cart_center_strong
           + edge_repulsion + bias + vel_feed)
    raw = clamp(raw, -5.0, 5.0)

    # 10. Final saturation
    force = 3.0 * math.tanh(raw / 3.0)

    return force

    # Default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
