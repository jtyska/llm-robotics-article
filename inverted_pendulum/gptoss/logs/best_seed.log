def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    if not hasattr(get_action, "drift_sum"):
        get_action.drift_sum = 0.0
    # Rule 1
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0
    # Rule 2
    if abs(pole_angle) >= 0.20:
        return -3.0 * math.copysign(1.0, pole_angle)
    # Rule 3
    if abs(pole_angle) < 0.003 and abs(pole_angular_velocity) < 0.006:
        return 0.0
    # Rule 4 – compute control
    # 1. Scaling
    scale = 1.0 + 2.0 * min(abs(pole_angle), 0.20)
    if scale > 1.5:
        scale = 1.5
    # 2. Pole PD term
    kp, kd = 4.2, 2.6
    pole_pd = kp * pole_angle + kd * pole_angular_velocity
    # 3. Viscous damping
    damp_coeff = 0.5 + 0.5 * (abs(pole_angle) / 0.20)
    pole_damp = -damp_coeff * pole_angular_velocity
    # 4. Recovery boost
    recovery = 0.0
    if abs(pole_angle) > 0.15 and pole_angle * pole_angular_velocity > 0:
        recovery = -1.5 * math.copysign(1.0, pole_angle)
    # 5. Cart‑centering term
    cart_term = 0.0
    if abs(pole_angle) < 0.08 and abs(pole_angular_velocity) < 0.15:
        cart_term = 0.45 * cart_position + 0.30 * cart_velocity
        if cart_term > 1.5:
            cart_term = 1.5
        elif cart_term < -1.5:
            cart_term = -1.5
    # 6. Small bias
    bias = 0.0
    if 0.003 < abs(pole_angle) < 0.020 and abs(pole_angular_velocity) < 0.01:
        bias = 0.006 * math.copysign(1.0, pole_angle) * scale
    # 7. Integral‑like drift compensation
    get_action.drift_sum += 0.001 * math.copysign(1.0, pole_angle)
    if get_action.drift_sum > 0.05:
        get_action.drift_sum = 0.05
    elif get_action.drift_sum < -0.05:
        get_action.drift_sum = -0.05
    drift_bias = get_action.drift_sum
    # 8. Combine
    raw = scale * (pole_pd + pole_damp + recovery - cart_term) + bias + drift_bias
    # 9. Saturate
    force = 3.0 * math.tanh(raw / 3.0)
    return force
    # default fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
