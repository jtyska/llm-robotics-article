import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    xdot = cart_velocity
    thetad = pole_angular_velocity

    # check for non‑finite values
    if not (math.isfinite(x) and math.isfinite(xdot) and math.isfinite(theta) and math.isfinite(thetad)):
        return 0.0

    # failure angle check
    if abs(theta) > 0.20:
        return 0.0

    # scaling factor
    scale = 2.0 if 1.0 + 2.0 * abs(theta) > 2.0 else 1.0 + 2.0 * abs(theta)

    # base PD‑cart controller
    raw = (3.5 * theta + 2.0 * thetad - 0.6 * x - 0.8 * xdot) * scale

    # tiny bias for small non‑zero angles
    if 0.003 < abs(theta) < 0.020:
        raw += 0.008 * (1.0 if theta > 0 else -1.0) * scale

    # soft dead‑zone when almost upright
    if abs(theta) < 0.003 and abs(thetad) < 0.006:
        raw *= 0.4

    # tanh saturation
    force = 3.0 * math.tanh(raw / 3.0)

    # final clipping
    if force > 3.0:
        force = 3.0
    elif force < -3.0:
        force = -3.0

    return force

    # fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
