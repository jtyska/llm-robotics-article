import math, random

_drift_sum = 0.0

def _sign(x):
    return 1.0 if x > 0 else -1.0 if x < 0 else 0.0

def _clip(val, low, high):
    return max(low, min(high, val))

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    global _drift_sum

    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # non‑finite check
    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    abs_theta = abs(theta)
    abs_theta_dot = abs(theta_dot)

    # large angle failure recovery
    if abs_theta >= 0.20:
        return -3.0 * _sign(theta)

    # near‑vertical dead‑zone
    if abs_theta < 0.003 and abs_theta_dot < 0.006:
        return 0.0

    # pole PD term
    pole_pd = 4.2 * theta + 2.6 * theta_dot

    # angle‑dependent viscous damping
    damp_coeff = 0.5 + 0.5 * (abs_theta / 0.20)  # range 0.5 … 1.0
    pole_damp = -damp_coeff * theta_dot

    # mild recovery boost
    if abs_theta > 0.15 and abs_theta_dot > 0.20 and theta * theta_dot > 0:
        recovery = -0.8 * _sign(theta)
    else:
        recovery = 0.0

    # cart‑centering term (active only near vertical)
    if abs_theta < 0.08 and abs_theta_dot < 0.10:
        cart_term = _clip(0.25 * x + 0.15 * x_dot, -1.2, 1.2)
    else:
        cart_term = 0.0

    # tiny symmetry‑breaking bias
    if 0.003 < abs_theta < 0.015 and abs_theta_dot < 0.01:
        bias = 0.004 * _sign(theta)
    else:
        bias = 0.0

    # integral‑like drift compensation (persistent across steps)
    _drift_sum = _clip(_drift_sum + 0.001 * _sign(theta), -0.05, 0.05)

    # combine all contributions
    raw = pole_pd + pole_damp + recovery - cart_term + bias + _drift_sum

    # smooth saturation to the allowed force range
    force = 3.0 * math.tanh(raw / 3.0)

    return force

    # default random action (should never be reached)
    # return random.uniform(-3.0, 3.0)
