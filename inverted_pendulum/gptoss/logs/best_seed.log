import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Parameters
    k_theta = 4.5
    k_thetadot = 2.5
    k_x = 0.8
    k_xdot = 0.6
    bias_low = 0.004
    bias_high = 0.020
    bias_gain = 0.01
    dead_theta = 0.004
    dead_thetad = 0.008
    boost_thresh = 0.15
    boost_factor = 1.5

    x = cart_position
    theta = pole_angle
    xdot = cart_velocity
    thetadot = pole_angular_velocity

    abs_theta = abs(theta)
    abs_thetadot = abs(thetadot)

    # Rule evaluation
    if abs_theta < dead_theta and abs_thetadot < dead_thetad:
        F_raw = -k_x * x - k_xdot * xdot
    else:
        pole_term = k_theta * theta + k_thetadot * thetadot
        cart_term = k_x * x + k_xdot * xdot
        scale_angle = 1 + 2 * min(abs_theta, 0.2)
        F_raw = scale_angle * (pole_term - cart_term)

        if bias_low < abs_theta < bias_high:
            sign_theta = math.copysign(1, theta) if theta != 0 else 0
            F_raw += bias_gain * sign_theta

        if abs_theta > boost_thresh:
            F_raw *= boost_factor

    # Compute final action
    try:
        action = 3.0 * math.tanh(F_raw / 3.0)
        return action
    except Exception:
        # Fallback random action if something went wrong
        return random.uniform(-3.0, 3.0)
