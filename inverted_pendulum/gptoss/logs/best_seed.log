   3. Angle‑dependent viscous damping
   ----------------------------------------------------------------- */
damp_coeff ← 0.5 + 0.5 * (abs(theta) / 0.20)   // 0.5 … 1.0
pole_damp ← -damp_coeff * theta_dot

/* -----------------------------------------------------------------
   4. Graduated recovery boost (smoothly grows when |θ| > 0.15)
   ----------------------------------------------------------------- */
IF abs(theta) > 0.15 AND theta * theta_dot > 0 THEN
    /* linear map: 0.15 → 0.0   ,   0.20 → 0.8  (max boost) */
    boost_gain ← 0.0 + (abs(theta) - 0.15) * (0.8 / (0.20 - 0.15))
    recovery   ← -boost_gain * sign(theta)
ELSE
    recovery ← 0.0
END IF

/* -----------------------------------------------------------------
   5. Cart‑centering term – active always, but stronger when far.
   ----------------------------------------------------------------- */
cart_gain_pos   ← 0.30          // coefficient for position
cart_gain_vel   ← 0.18          // coefficient for velocity
cart_raw        ← cart_gain_pos * x + cart_gain_vel * x_dot
/* limit the raw centering command so it never exceeds ±1.5 N */
cart_center    ← clip(cart_raw, -1.5, 1.5)

/* -----------------------------------------------------------------
   6. Strong centering when the pole is almost vertical
   ----------------------------------------------------------------- */
IF abs(theta) < 0.08 AND abs(theta_dot) < 0.10 THEN
    strong_center ← clip(0.25 * x + 0.15 * x_dot, -1.2, 1.2)
ELSE
    strong_center ← 0.0
END IF

/* -----------------------------------------------------------------
   7. Tiny symmetry‑breaking bias
   ----------------------------------------------------------------- */
IF 0.003 < abs(theta) AND abs(theta) < 0.015 AND abs(theta_dot) < 0.01 THEN
    bias ← 0.004 * sign(theta)
ELSE
    bias ← 0.0
END IF

/* -----------------------------------------------------------------
   8. Integral‑like drift compensation (slow, small)
   ----------------------------------------------------------------- */
drift_sum ← clip(drift_sum + 0.0005 * sign(theta), -0.03, 0.03)

/* -----------------------------------------------------------------
   9. Combine everything
   ----------------------------------------------------------------- */
raw ← pole_pd + pole_damp + recovery
       - cart_center - strong_center
       + bias + drift_sum

/* -----------------------------------------------------------------
   10. Clamp raw command before the smooth saturation.
   ----------------------------------------------------------------- */
raw ← clip(raw, -4.0, 4.0)          // keep it inside a region where tanh is linearish

/* -----------------------------------------------------------------
   11. Smooth saturation to the actuator limits.
   ----------------------------------------------------------------- */
force ← 3.0 * tanh(raw / 3.0)      // final command ∈ [‑3, +3]

/* ------------------------------------------------------------- */
```

