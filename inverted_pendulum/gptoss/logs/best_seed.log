def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # Check for non‑finite values
    if not (math.isfinite(x) and math.isfinite(x_dot) and math.isfinite(theta) and math.isfinite(theta_dot)):
        return 0.0

    # Large angle recovery
    if abs(theta) >= 0.20:
        sign_theta = 1.0 if theta > 0 else -1.0 if theta < 0 else 0.0
        return -3.0 * sign_theta

    # Core control terms
    kp = 4.2
    kd = 2.6
    pole_pd = kp * theta + kd * theta_dot

    damp_coeff = 0.5 + 0.5 * (abs(theta) / 0.20)
    pole_damp = -damp_coeff * theta_dot

    # Recovery boost
    if abs(theta) > 0.18 and theta * theta_dot > 0:
        sign_theta = 1.0 if theta > 0 else -1.0
        recovery = -1.5 * sign_theta
    elif abs(theta) > 0.12 and theta * theta_dot > 0:
        sign_theta = 1.0 if theta > 0 else -1.0
        recovery = -1.0 * sign_theta
    else:
        recovery = 0.0

    # Cart centering term
    cent_gain_base = 0.25
    cent_gain_angle = 0.75 * (1.0 - min(abs(theta) / 0.20, 1.0))
    cent_gain = cent_gain_base + cent_gain_angle
    cart_term_raw = cent_gain * x + 0.15 * x_dot
    cart_term = max(-1.2, min(cart_term_raw, 1.2))

    # Small‑angle bias
    if 0.003 < abs(theta) < 0.015 and abs(theta_dot) < 0.01:
        sign_theta = 1.0 if theta > 0 else -1.0
        bias = 0.004 * sign_theta
    else:
        bias = 0.0

    # Deadzone cart term
    if abs(theta) < 0.004 and abs(theta_dot) < 0.006:
        deadzone_cart = -0.20 * x
    else:
        deadzone_cart = 0.0

    # Combine terms
    raw = pole_pd + pole_damp + recovery - cart_term + bias + deadzone_cart
    raw = max(-4.5, min(raw, 4.5))

    force = 3.0 * math.tanh(raw / 3.0)
    return force

    # Default random action (should never be reached)
    return random.uniform(-3.0, 3.0)
