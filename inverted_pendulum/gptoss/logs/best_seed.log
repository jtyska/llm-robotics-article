def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x, theta, xdot, thetad = cart_position, pole_angle, cart_velocity, pole_angular_velocity

    # helper sign
    def sign(v):
        return 1.0 if v > 0 else -1.0 if v < 0 else 0.0

    # non‑finite check
    if not (math.isfinite(x) and math.isfinite(xdot) and math.isfinite(theta) and math.isfinite(thetad)):
        return 0.0

    # angle out of bounds
    if abs(theta) > 0.20:
        return 0.0

    # near‑upright dead zone
    if abs(theta) < 0.003 and abs(thetad) < 0.006:
        return 0.0

    # scaling
    scale = 1.0 + 2.0 * min(abs(theta), 0.20)
    if scale > 1.5:
        scale = 1.5

    # pole PD
    pole_pd = 3.8 * theta + 2.2 * thetad

    # angle‑dependent damping
    damp = 0.5
    if abs(theta) > 0.05:
        damp = 0.8
    pole_damp = -damp * thetad

    # conditional cart‑centering
    cart_term = 0.0
