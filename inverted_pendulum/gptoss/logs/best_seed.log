import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    # Check finiteness
    if not (math.isfinite(cart_position) and math.isfinite(pole_angle) and
            math.isfinite(cart_velocity) and math.isfinite(pole_angular_velocity)):
        return 0.0

    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # 1. Pole PD term
    pole_pd = 4.3 * theta + 2.4 * theta_dot

    # 2. Angle‑dependent damping
    damp_coeff = 0.5 + 0.5 * (abs(theta) / 0.20)  # 0.5 … 1.0
    pole_damp = -damp_coeff * theta_dot

    # 3. Adaptive recovery boost
    if (abs(theta) > 0.12) or (abs(theta_dot) > 0.15):
        boost_raw = 0.8 + 6.0 * (abs(theta) - 0.12) / (0.20 - 0.12)   # 0.8 … 2.0
        if boost_raw > 2.0:
            boost_raw = 2.0
        if theta * theta_dot > 0:
            recovery = -boost_raw * (1 if theta > 0 else -1)
        else:
            recovery = 0.0
    else:
        recovery = 0.0

    # 4. Weak cart‑centering (always on)
    cart_center_weak = 0.30 * x + 0.18 * x_dot
    if cart_center_weak > 1.5:
        cart_center_weak = 1.5
    if cart_center_weak < -1.5:
        cart_center_weak = -1.5

    # 5. Strong cart‑centering (only when pole is very stable)
    if (abs(theta) < 0.05) and (abs(theta_dot) < 0.08):
        edge_factor = (abs(x) - 1.5) / 0.7
        if edge_factor < 0.0:
            edge_factor = 0.0
        if edge_factor > 1.0:
            edge_factor = 1.0
        strong_gain = 0.45 + 0.55 * edge_factor               # 0.45 … 1.0
        cart_center_strong = strong_gain * x + (0.30 + 0.30 * edge_factor) * x_dot
        if cart_center_strong > 2.5:
            cart_center_strong = 2.5
        if cart_center_strong < -2.5:
            cart_center_strong = -2.5
    else:
        cart_center_strong = 0.0

    # 6. Edge‑repel (soft push near track limits)
    if abs(x) > 1.8:
        rep_coeff = 0.8 * (abs(x) - 1.8) / (2.4 - 1.8)   # 0 … 0.8
        edge_repulsion = -rep_coeff * (1 if x > 0 else -1)
    else:
        edge_repulsion = 0.0

    # 7. Tiny symmetry‑breaking bias
    if (abs(theta) > 0.003) and (abs(theta) < 0.015) and (abs(theta_dot) < 0.01):
        bias = 0.01 * (1 if theta > 0 else -1)
    else:
        bias = 0.0

    # 8. Small velocity feed‑forward
    vel_feed = -0.05 * x_dot

    # 9. Combine all contributions
    raw = (pole_pd + pole_damp + recovery -
           cart_center_weak - cart_center_strong +
           edge_repulsion + bias + vel_feed)

    # 10. Pre‑clip for smooth saturation
    if raw > 5.0:
        raw = 5.0
    if raw < -5.0:
        raw = -5.0

    # 11. Final smooth saturation (actuator limit)
    force = 3.0 * math.tanh(raw / 3.0)   # ∈ [‑3 , +3]

    # Return computed force
    return force

    # Default random action (fallback, should never be reached)
    return random.uniform(-3, 3)
