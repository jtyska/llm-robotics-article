def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random

    def is_finite(v):
        return math.isfinite(v)

    def sign(v):
        if v > 0:
            return 1.0
        if v < 0:
            return -1.0
        return 0.0

    def clamp(v, lo, hi):
        return max(lo, min(v, hi))

    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    # Rule 1: non‑finite values
    if (not is_finite(x) or not is_finite(x_dot) or
        not is_finite(theta) or not is_finite(theta_dot)):
        return 0.0

    # Rule 2: angle beyond hard limit
    if abs(theta) >= 0.20:
        return -3.0 * sign(theta)

    # Main control block
    pole_pd = 4.2 * theta + 2.6 * theta_dot
    damp_coeff = 0.5 + 0.5 * (abs(theta) / 0.20)
    pole_damp = -damp_coeff * theta_dot

    # Recovery boost
    if (abs(theta) > 0.12) or (abs(theta_dot) > 0.15):
        boost_gain = 0.8 + 6.0 * (abs(theta) - 0.12) / (0.20 - 0.12)
        boost_gain = clamp(boost_gain, 0.8, 2.5)
        if theta * theta_dot > 0:
            recovery = -boost_gain * sign(theta)
        else:
            recovery = 0.0
    else:
        recovery = 0.0

    # Cart centering (weak)
    cart_center_weak = 0.30 * x + 0.18 * x_dot
    angle_factor = clamp(abs(theta) / 0.20, 0.0, 1.0)
    cart_center_extra = 0.6 * angle_factor * x
    cart_center = cart_center_weak + cart_center_extra
    cart_center = clamp(cart_center, -2.0, 2.0)

    # Strong centering when near upright
    if (abs(theta) < 0.07) and (abs(theta_dot) < 0.10):
        cart_center_strong = 0.45 * x + 0.30 * x_dot
        cart_center_strong = clamp(cart_center_strong, -2.5, 2.5)
    else:
        cart_center_strong = 0.0

    # Edge repulsion
    if abs(x) > 1.8:
        rep_coeff = 0.8 * (abs(x) - 1.8) / (2.4 - 1.8)
        edge_repulsion = -rep_coeff * sign(x)
    else:
        edge_repulsion = 0.0

    # Small bias
    if (abs(theta) > 0.003) and (abs(theta) < 0.015) and (abs(theta_dot) < 0.01):
        bias = 0.012 * sign(theta)
    else:
        bias = 0.0

    # Velocity feed‑forward
    vel_feed = -0.05 * x_dot

    raw = (pole_pd + pole_damp + recovery -
           cart_center - cart_center_strong +
           edge_repulsion + bias + vel_feed)
    raw = clamp(raw, -5.0, 5.0)
    force = 3.0 * math.tanh(raw / 3.0)
    return force

    # Fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
