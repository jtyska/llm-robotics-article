def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x = cart_position
    theta = pole_angle
    xdot = cart_velocity
    thetad = pole_angular_velocity

    force = None

    if not (math.isfinite(x) and math.isfinite(xdot) and math.isfinite(theta) and math.isfinite(thetad)):
        force = 0.0
    elif abs(theta) > 0.20:
        force = 0.0
    else:
        scale = 1.0 + 2.5 * min(abs(theta), 0.20)
        if scale > 1.5:
            scale = 1.5

        pole_term = 3.5 * theta + 2.0 * thetad
        cart_term = 0.4 * x + 0.3 * xdot

        raw = -(pole_term - cart_term) * scale

        if 0.003 < abs(theta) < 0.020:
            raw += 0.008 * (1 if theta > 0 else -1)

        if abs(theta) < 0.003 and abs(thetad) < 0.006:
            raw = 0.15 * raw

        if raw > 3.0:
            force = 3.0
        elif raw < -3.0:
            force = -3.0
        else:
            force = raw

    if force is None:
        force = random.uniform(-3, 3)

    return force
