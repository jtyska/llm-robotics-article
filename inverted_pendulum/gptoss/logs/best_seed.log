def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import math, random
    x = cart_position
    xdot = cart_velocity
    theta = pole_angle
    thetad = pole_angular_velocity

    if not (math.isfinite(x) and math.isfinite(xdot) and math.isfinite(theta) and math.isfinite(thetad)):
        return 0.0
    if abs(theta) > 0.20:
        return 0.0
    if abs(theta) < 0.003 and abs(thetad) < 0.006:
        return 0.0

    pole_term = 3.5 * theta + 2.0 * thetad
    cart_term = 0.4 * x + 0.5 * xdot
    raw_force = pole_term - cart_term

    scale = 1.0 + 2.0 * min(abs(theta), 0.20)
    if scale > 1.5:
        scale = 1.5
    raw_force *= scale

    if 0.003 < abs(theta) < 0.020:
        sign_theta = 1 if theta > 0 else -1 if theta < 0 else 0
        raw_force += 0.008 * sign_theta

    soft_force = 3.0 * math.tanh(raw_force / 3.0)

    if soft_force > 3.0:
        force = 3.0
    elif soft_force < -3.0:
        force = -3.0
    else:
        force = soft_force

    return force

    # default random action if no rule applies
    return random.uniform(-3, 3)
