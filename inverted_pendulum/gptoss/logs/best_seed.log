import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    xdot = cart_velocity
    thetad = pole_angular_velocity

    force = None

    if not (math.isfinite(x) and math.isfinite(xdot) and math.isfinite(theta) and math.isfinite(thetad)):
        force = 0.0
    elif abs(theta) < 0.002 and abs(thetad) < 0.004:
        force = 0.0
    else:
        Kp = 6.0
        Kd = 2.5
        Kx = 0.45
        Kv = 0.30

        pole_term = Kp * theta + Kd * thetad
        cart_term = Kx * x + Kv * xdot

        raw = -(pole_term - cart_term)

        scale = 1.0 + 3.0 * min(abs(theta), 0.20)
        if scale > 2.2:
            scale = 2.2

        raw = raw * scale

        if 0.002 < abs(theta) < 0.018:
            raw += 0.010 * (1 if theta > 0 else -1)

        if raw > 3.0:
            force = 3.0
        elif raw < -3.0:
            force = -3.0
        else:
            force = raw

    if force is None:
        return random.uniform(-3, 3)
    return force
