import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    xdot = cart_velocity
    thetad = pole_angular_velocity

    def is_finite(v):
        return math.isfinite(v)

    def sign(v):
        return 1.0 if v > 0 else -1.0 if v < 0 else 0.0

    def clip(v, lo, hi):
        return max(lo, min(v, hi))

    # Rule 1: non‑finite check
    if (not is_finite(x) or not is_finite(xdot) or
        not is_finite(theta) or not is_finite(thetad)):
        return 0.0

    # Rule 2: angle out of bounds
    if abs(theta) >= 0.20:
        return -3.0 * sign(theta)

    # Rule 3: near‑perfect upright
    if abs(theta) < 0.003 and abs(thetad) < 0.006:
        return 0.0

    # Main controller
    scale_angle = 1.0 + 2.0 * min(abs(theta), 0.20)
    if scale_angle > 1.5:
        scale_angle = 1.5

    damp_coeff = 0.5 + 0.3 * clip(abs(theta) / 0.20, 0.0, 1.0)

    pole_pd = 4.2 * theta + 2.5 * thetad
    pole_damp = -damp_coeff * thetad

    cart_term = 0.0
    if abs(theta) < 0.07 and abs(thetad) < 0.12 and abs(x) > 0.05:
        cent_gain = 0.35 * clip(abs(x) / 0.20, 0.0, 1.0) + 0.25  # 0.25 … 0.60
        cart_term = cent_gain * x + 0.25 * xdot
        cart_term = clip(cart_term, -1.2, 1.2)

    recovery = 0.0
    if abs(theta) > 0.15 and theta * thetad > 0:
        recovery = -2.5 * sign(theta)

    bias = 0.0
    if 0.003 < abs(theta) < 0.020 and abs(thetad) < 0.01:
        bias = 0.006 * sign(theta) * scale_angle

    raw = scale_angle * (pole_pd + pole_damp - cart_term + recovery) + bias
    force = 3.0 * math.tanh(raw / 3.0)

    return force

    # fallback (should never be reached)
    return random.uniform(-3.0, 3.0)
