import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    def is_finite(v):
        return math.isfinite(v)

    def sign(v):
        if v > 0:
            return 1.0
        if v < 0:
            return -1.0
        return 0.0

    def clamp(val, lo, hi):
        return max(lo, min(hi, val))

    # Rule 1
    if not (is_finite(x) and is_finite(x_dot) and is_finite(theta) and is_finite(theta_dot)):
        return 0.0

    # Rule 2
    if abs(theta) >= 0.20:
        return -3.0 * sign(theta)

    # Rule 3
    # 1. Pole PD
    pole_pd = 5.5 * theta + 3.3 * theta_dot

    # 2. Angle‑dependent damping
    damp_coeff = 0.5 + 0.9 * (abs(theta) / 0.20)
    pole_damp = -damp_coeff * theta_dot

    # 3. Boost / recovery
    if (abs(theta) > 0.12 or abs(theta_dot) > 0.15) and (theta * theta_dot > 0):
        boost_gain = clamp(0.8 + 2.4 * (abs(theta) - 0.12) / (0.20 - 0.12), 0.0, 3.2)
        recovery = -boost_gain * sign(theta)
    else:
        recovery = 0.0

    # 4. Weak cart‑centering
    cart_center_weak = clamp(0.45 * x + 0.30 * x_dot, -2.0, 2.0)

    # 5. Strong edge‑repulsion
    edge_repulsion = 0.0
    if abs(x) > 0.6:
        edge_factor = clamp((abs(x) - 0.6) / (2.4 - 0.6), 0.0, 1.0)
        rep_gain = 0.9 + 1.2 * edge_factor
        edge_repulsion = -rep_gain * sign(x)

    # Combine components
    force = pole_pd + pole_damp + recovery + cart_center_weak + edge_repulsion
    force = clamp(force, -3.0, 3.0)

    # Default fallback (should not be reached)
    if force is None:
        return random.uniform(-3.0, 3.0)
    return force
