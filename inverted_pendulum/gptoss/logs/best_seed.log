cart_center_weak = 0.30 * x + 0.18 * x_dot
cart_center_weak = clamp(cart_center_weak, -1.5, 1.5)

# 5. Strong cart‑centering (only when pole is very stable)
IF (abs(theta) < 0.05) AND (abs(theta_dot) < 0.08)
THEN
    edge_factor = clamp((abs(x) - 1.5) / 0.7, 0.0, 1.0)   # 0 … 1 as |x| → 2.2
    strong_gain = 0.45 + 0.55 * edge_factor               # 0.45 … 1.0
    cart_center_strong = strong_gain * x + (0.30 + 0.30 * edge_factor) * x_dot
    cart_center_strong = clamp(cart_center_strong, -2.5, 2.5)
ELSE
    cart_center_strong = 0.0
ENDIF

# 6. Edge‑repel (soft push when the cart is close to the track limits)
#    Acts like a gentle spring that starts at |x| = 1.8 m and reaches
#    full strength at |x| = 2.4 m (the physical limit of the classic cart‑pole).
edge_repulsion = 0.0
IF abs(x) > 1.8
THEN
    rep_coeff = 0.8 * (abs(x) - 1.8) / (2.4 - 1.8)   # 0 … 0.8
    edge_repulsion = -rep_coeff * sign(x)          # pushes back toward centre
ENDIF

# 7. Tiny symmetry‑breaking bias
IF (0.003 < abs(theta)) AND (abs(theta) < 0.015) AND (abs(theta_dot) < 0.01)
THEN bias = 0.01 * sign(theta)
ELSE bias = 0.0
ENDIF

# 8. Small velocity feed‑forward
vel_feed = -0.05 * x_dot

# 9. Combine all contributions
raw = pole_pd + pole_damp + recovery \
      - cart_center_weak - cart_center_strong \
      + edge_repulsion + bias + vel_feed

# 10. Pre‑clip for smooth saturation
raw = clamp(raw, -5.0, 5.0)

# 11. Final smooth saturation (acts as actuator limit)
force = 3.0 * tanh(raw / 3.0)      # ∈ [‑3 , +3]

ENDIF
# --------------------------------------------------------------
```

