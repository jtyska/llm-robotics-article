# -------------------------------------------------
#  CART‑POLE BALANCING CONTROLLER (v4)
# -------------------------------------------------
# Input:  state = [x, θ, xdot, θdot]   (float)
# Output: force ∈ [‑3.0, 3.0]          (float)

function control(state):
    x      = state[0]
    theta  = state[1]          # pole angle (rad)
    xdot   = state[2]
    thetad = state[3]          # pole angular velocity

    # ---- 1. dead‑band (no action when almost upright) ----
    if abs(theta) < 0.003 and abs(thetad) < 0.006:
        return 0.0

    # ---- 2. linear combination (pole – cart) ----
    #   gains tuned from the best previous strategy
    k_theta   = 3.5      # proportional pole gain
    k_thetad  = 2.0      # derivative pole gain
    k_x       = 0.4      # cart position gain (negative sign later)
    k_xdot    = 0.3      # cart velocity gain (negative sign later)

    pole_term = k_theta * theta + k_thetad * thetad
    cart_term = k_x * x + k_xdot * xdot

    # ---- 3. adaptive scaling (more aggressive when far) ----
    scale = 1.0 + 2.5 * min(abs(theta), 0.2)   # grows up to 1 + 0.5 = 1.5

    # ---- 4. raw force before saturation ----
    F_raw = scale * (pole_term - cart_term)

    # ---- 5. tiny bias when angle is just outside the dead‑band ----
    if 0.003 < abs(theta) < 0.020:
        F_raw += 0.008 * sign(theta)

    # ---- 6. clip to the physical limits ----
    if F_raw > 3.0:
        return 3.0
    elif F_raw < -3.0:
        return -3.0
    else:
        return F_raw
```

