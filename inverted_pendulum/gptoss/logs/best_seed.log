import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    xdot = cart_velocity
    thetad = pole_angular_velocity

    # non‑finite check
    if not (math.isfinite(x) and math.isfinite(xdot) and math.isfinite(theta) and math.isfinite(thetad)):
        return 0.0

    # angle limit failure
    if abs(theta) > 0.20:
        return 0.0

    # near‑zero deadband
    if abs(theta) < 0.003 and abs(thetad) < 0.006:
        return 0.0

    # adaptive scale
    scale = 1.0 + 2.5 * min(abs(theta), 0.20)
    if scale > 2.0:
        scale = 2.0

    # pole PD term
    pole_pd = 3.5 * theta + 2.0 * thetad

    # angle‑dependent damping
    damp_factor = 0.5
    if abs(theta) > 0.05:
        damp_factor = 0.9
    pole_damp = -damp_factor * thetad

    # cart‑centering term
    cart_term = 0.0
    if abs(x) > 0.05:
        raw_center = 0.4 * x + 0.3 * xdot
        cart_term = max(-1.5, min(1.5, raw_center))

    # feed‑forward quick‑kick
    ff = 0.0
    if abs(theta) < 0.02 and abs(thetad) > 0.15:
        ff = -0.4 * (1 if thetad > 0 else -1)

    # tiny bias
    bias = 0.0
    if 0.003 < abs(theta) < 0.020 and abs(thetad) < 0.01:
        bias = -0.006 * (1 if theta > 0 else -1) * scale

    # assemble raw command
    raw = scale * (pole_pd + pole_damp - cart_term + ff) + bias

    # soft saturation
    force = 3.0 * math.tanh(raw / 3.0)

    return force

    # default random action (fallback)
    return random.uniform(-3, 3)
