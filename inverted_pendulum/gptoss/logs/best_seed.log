import math, random

_theta_int = 0.0

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    global _theta_int
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    def is_finite(v):
        return math.isfinite(v)

    def sign(v):
        return math.copysign(1.0, v) if v != 0 else 0.0

    def clamp(v, lo, hi):
        return max(lo, min(hi, v))

    # Rule 1: non‑finite check
    if not (is_finite(x) and is_finite(x_dot) and is_finite(theta) and is_finite(theta_dot)):
        return 0.0

    # Rule 2: large angle failure recovery
    if abs(theta) >= 0.20:
        return -3.0 * sign(theta)

    # ----- Main controller -----
    Kp_theta = 5.0
    Kd_theta = 3.2
    pole_pd = Kp_theta * theta + Kd_theta * theta_dot

    damp_coeff = 0.6 + 0.7 * (abs(theta) / 0.20)
    pole_damp = -damp_coeff * theta_dot

    # integral term (persistent)
    _theta_int = clamp(_theta_int + 0.001 * theta, -0.05, 0.05)
    Ki_theta = -2.0
    int_term = Ki_theta * _theta_int

    # boost recovery
    boost_active = (abs(theta) > 0.12) or (abs(theta_dot) > 0.15)
    if boost_active:
        boost_gain = 0.8 + 2.7 * (abs(theta) - 0.12) / (0.20 - 0.12)
        boost_gain = clamp(boost_gain, 0.0, 3.5)
        if theta * theta_dot > 0:
            recovery = -boost_gain * sign(theta)
        else:
            recovery = 0.0
    else:
        recovery = 0.0

    # weak cart centering
    Kc_weak = 0.45
    Kc_weak_v = 0.30
    cart_center_weak = clamp(Kc_weak * x + Kc_weak_v * x_dot, -2.0, 2.0)

    # strong cart centering
    strong_active = (abs(theta) < 0.05 and abs(theta_dot) < 0.08) or (abs(x) > 0.8)
    if strong_active:
        edge_factor = clamp((abs(x) - 0.8) / (2.4 - 0.8), 0.0, 1.0)
        strong_gain = 0.6 + 0.6 * edge_factor
        strong_vel_g = 0.35 + 0.35 * edge_factor
        cart_center_strong = clamp(strong_gain * x + strong_vel_g * x_dot, -3.0, 3.0)
    else:
        cart_center_strong = 0.0

    # edge repulsion
    if abs(x) > 1.0:
        rep_factor = clamp((abs(x) - 1.0) / (2.4 - 1.0), 0.0, 1.0)
        rep_coeff = 0.8 * rep_factor
        edge_repulsion = -rep_coeff * sign(x)
    else:
        edge_repulsion = 0.0

    # small‑angle bias
    if (0.003 < abs(theta) < 0.015) and (abs(theta_dot) < 0.01):
        bias = 0.012 * sign(theta)
    else:
        bias = 0.0

    # velocity feed‑forward
    vel_feed = -0.07 * x_dot

    raw = (pole_pd + pole_damp + int_term + recovery +
           cart_center_weak + cart_center_strong + edge_repulsion +
           bias + vel_feed)

    raw = clamp(raw, -5.5, 5.5)
    force = clamp(3.0 * math.tanh(raw / 3.0), -3.0, 3.0)

    return force if force is not None else random.uniform(-3.0, 3.0)
