import math, random

_integral_theta = 0.0

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    global _integral_theta

    def is_finite(v):
        return math.isfinite(v)

    def sign(v):
        return 1.0 if v > 0 else -1.0 if v < 0 else 0.0

    def clamp(v, lo, hi):
        return max(lo, min(hi, v))

    # safety guard
    if (not is_finite(cart_position) or not is_finite(cart_velocity) or
        not is_finite(pole_angle) or not is_finite(pole_angular_velocity)):
        return 0.0

    x = cart_position
    x_dot = cart_velocity
    theta = pole_angle
    theta_dot = pole_angular_velocity

    # immediate failure recovery
    if abs(theta) >= 0.20:
        return -2.0 * sign(theta)

    # pole PD controller
    pole_pd = 4.5 * theta + 2.8 * theta_dot

    # angle‑dependent viscous damping
    damp_coeff = 0.5 + 0.5 * (abs(theta) / 0.20)  # range 0.5 … 1.0
    pole_damp = -damp_coeff * theta_dot

    # tiny leaky integral on angle
    _integral_theta = 0.99 * _integral_theta + 0.001 * theta
    int_term = -0.3 * _integral_theta

    # graduated recovery boost
    if (abs(theta) > 0.10) or (abs(theta_dot) > 0.12):
        boost_gain = (abs(theta) - 0.10) / (0.20 - 0.10)
        boost_gain = clamp(boost_gain, 0.0, 1.0)
        if theta * theta_dot > 0:
            recovery = -boost_gain * sign(theta)
        else:
            recovery = 0.0
    else:
        recovery = 0.0

    # weak cart‑centering (always on)
    cart_center_weak = 0.35 * x + 0.20 * x_dot
    cart_center_weak = clamp(cart_center_weak, -1.5, 1.5)

    # strong centering (activates earlier)
    if (abs(theta) < 0.07) and (abs(theta_dot) < 0.09):
        cart_center_strong = 0.55 * x + 0.35 * x_dot
        cart_center_strong = clamp(cart_center_strong, -2.0, 2.0)
    else:
        cart_center_strong = 0.0

    # symmetry‑breaking bias
    if (0.003 < abs(theta) < 0.015) and (abs(theta_dot) < 0.01):
        bias = 0.008 * sign(theta)
    else:
        bias = 0.0

    # small velocity feed‑forward
    vel_feed = -0.07 * x_dot

    # combine all terms
    raw = (pole_pd + pole_damp + int_term + recovery
           - cart_center_weak - cart_center_strong + bias + vel_feed)

    # pre‑clip before saturation
    raw = clamp(raw, -4.0, 4.0)

    # final smooth saturation
    force = 3.0 * math.tanh(raw / 3.0)

    if force is None:
        return random.uniform(-3.0, 3.0)
    return force
