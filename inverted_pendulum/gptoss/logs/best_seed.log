import random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    action = None
    if (abs(pole_angle) < 0.004 and
        abs(pole_angular_velocity) < 0.008 and
        abs(cart_position) < 0.03 and
        abs(cart_velocity) < 0.03):
        action = 0.0
