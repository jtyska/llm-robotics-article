import math, random

def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    x = cart_position
    theta = pole_angle
    x_dot = cart_velocity
    theta_dot = pole_angular_velocity

    def sign(v):
        return 1.0 if v > 0 else -1.0 if v < 0 else 0.0

    def clamp(v, lo, hi):
        return max(lo, min(v, hi))

    # Rule 1
    if not (math.isfinite(x) and math.isfinite(theta) and math.isfinite(x_dot) and math.isfinite(theta_dot)):
        return 0.0

    # Rule 2
    if abs(theta) >= 0.20:
        return -3.0 * sign(theta)

    # Rule 3
    pole_pd = 5.5 * theta + 3.3 * theta_dot

    # Rule 4
    damp_coeff = 0.5 + 0.9 * abs(theta) / 0.20
    pole_damp = -damp_coeff * theta_dot

    # Rule 5
    if (abs(theta) > 0.12 or abs(theta_dot) > 0.15) and (theta * theta_dot > 0):
        boost_gain = clamp(0.8 + 2.4 * (abs(theta) - 0.12) / (0.20 - 0.12), 0.0, 3.2)
        recovery = -boost_gain * sign(theta)
    else:
        recovery = 0.0

    # Rule 6
    cart_center_weak = clamp(0.45 * x + 0.30 * x_dot, -2.0, 2.0)

    # Rule 7
    if abs(x) > 0.8:
        edge_factor = clamp((abs(x) - 0.8) / (2.4 - 0.8), 0.0, 1.0)
        strong_gain = 0.6 + 0.6 * edge_factor
        strong_vel = 0.35 + 0.35 * edge_factor
        cart_center_strong = clamp(strong_gain * x + strong_vel * x_dot, -3.0, 3.0)
    else:
        cart_center_strong = 0.0

    # Rule 8
    if abs(x) > 0.8:
        rep_factor = clamp((abs(x) - 0.8) / (2.4 - 0.8), 0.0, 1.0)
        rep_coeff = 0.9 * rep_factor
        edge_repulsion = -rep_coeff * sign(x)
    else:
        edge_repulsion = 0.0

    # Rule 9
    if 0.003 < abs(theta) < 0.015 and abs(theta_dot) < 0.01:
        bias = 0.012 * sign(theta)
    else:
        bias = 0.0

    # Rule 10
    vel_feed = -0.07 * x_dot

    # Rule 11
    raw = (pole_pd + pole_damp + recovery + cart_center_weak +
           cart_center_strong + edge_repulsion + bias + vel_feed)

    # Rule 12
    raw = clamp(raw, -5.5, 5.5)

    # Rule 13
    force = clamp(3.0 * math.tanh(raw / 3.0), -3.0, 3.0)

    # Rule 14
    return force

    # Default random action (should not be reached)
    return random.uniform(-3.0, 3.0)
