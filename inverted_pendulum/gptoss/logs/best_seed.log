def get_action(cart_position, pole_angle, cart_velocity, pole_angular_velocity):
    import random
    x = cart_position
    theta = pole_angle
    xdot = cart_velocity
    thetad = pole_angular_velocity
    force = None

    if abs(theta) < 0.003 and abs(thetad) < 0.006:
        force = 0.0
    else:
        if abs(theta) < 0.2:
            scale = 1.0 + 2.5 * abs(theta)
        else:
            scale = 1.0 + 2.5 * 0.2
        pole_term = 3.5 * theta + 2.0 * thetad
        cart_term = 0.4 * x + 0.3 * xdot
        F_raw = scale * (pole_term - cart_term)
        if 0.003 < abs(theta) < 0.020:
            sign_theta = 1 if theta > 0 else -1 if theta < 0 else 0
            F_raw += 0.008 * sign_theta
        if F_raw > 3.0:
            force = 3.0
        elif F_raw < -3.0:
            force = -3.0
        else:
            force = F_raw

    if force is None:
        return random.uniform(-3, 3)
    return force
