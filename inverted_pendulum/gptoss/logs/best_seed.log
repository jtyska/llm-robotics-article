    else:
        action = F_raw
    if (abs(pole_angle) <= 0.012 and abs(pole_angular_velocity) <= 0.018 and
        abs(cart_position) <= 0.03 and abs(cart_velocity) <= 0.03):
        return random.uniform(-3, 3)
    return action
