    elif pole_angle < -10 and pole_angular_velocity < -5:
        return 1
    elif pole_angle > 10 and pole_angular_velocity < -5:
        return 2
    elif pole_angle < -10 and pole_angular_velocity > 5:
        return 1
    elif cart_velocity > 10:
        if cart_position > 0:
            return 1
        else:
            return 2
    elif cart_velocity < -10:
        if cart_position > 0:
            return 1
        else:
            return 2
    else:
        return random.randint(1, 2)

