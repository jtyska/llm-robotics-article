import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    theta = 1.0
    if pole_angle > 0 and pole_angular_velocity > 0:
        return 2
    elif pole_angle < 0 and pole_angular_velocity < 0:
        return 2
    elif pole_angle > 0 and pole_angular_velocity < 0:
        return 1
    elif pole_angle < 0 and pole_angular_velocity > 0:
        return 1

    if cart_position > 25 - theta * (pole_angle / 25):
        return 1
    elif cart_position < -25 + theta * (pole_angle / 25):
        return 2

    if pole_angle > 20 and cart_velocity < 0:
        return 1
    elif pole_angle < -20 and cart_velocity > 0:
        return 2

    if abs(pole_angle) >= 24:
        if pole_angular_velocity > 0:
            return 2
        else:
            return 1
    else:
        if cart_position > 10:
            return 1
        elif cart_position < -10:
            return 2
        else:
            if pole_angle > 5 and pole_angular_velocity > 0:
                return 2
            elif pole_angle < -5 and pole_angular_velocity < 0:
                return 2
            elif pole_angle > 5 and pole_angular_velocity < 0:
                return 1
            elif pole_angle < -5 and pole_angular_velocity > 0:
                return 1
            else:
                return 2
    return random.randint(1, 2)

