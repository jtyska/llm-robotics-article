    elif pole_angular_velocity > 2 and pole_angle > 0:
        return 2
    elif pole_angular_velocity < -2 and pole_angle < 0:
        return 1
    elif pole_angle > 25:
        return 2 if pole_angular_velocity > 0 else 1
    elif pole_angle < -25:
        return 1 if pole_angular_velocity < 0 else 2
    else:
        return random.randint(1, 2)

