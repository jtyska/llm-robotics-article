    elif cart_position < -25:
        return 2
    elif pole_angle > 0 and pole_angular_velocity >= 0:
        return 1
    elif pole_angle < 0 and pole_angular_velocity <= 0:
        return 1
    else:
        if pole_angle > 0:
            return 1
        else:
            return 2
    return random.randint(1, 2)

