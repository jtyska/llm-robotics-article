import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if pole_angle > 0 and pole_angular_velocity > 0:
        return 2
    elif pole_angle < 0 and pole_angular_velocity < 0:
        return 1
    elif abs(pole_angle) > 10:
        if pole_angular_velocity > 0:
            return 2
        else:
            return 1
    elif cart_velocity > 5:
        return 1
    elif cart_velocity < -5:
        return 2
    elif cart_position > 20 or cart_position < -20:
        if pole_angle > 0:
            return 1
        else:
            return 2
    elif abs(pole_angle) < 10 and pole_angular_velocity == 0:
        if pole_angle > 0:
            return 2
        else:
            return 1
    elif (pole_angular_velocity > 0 and pole_angle < 0) or (pole_angular_velocity < 0 and pole_angle > 0):
        if pole_angle > 0:
            return 1
        else:
            return 2
    else:
        return random.randint(1, 2)

