import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if pole_angle > 0 and pole_angular_velocity > 0:
        return 2
    elif pole_angle < 0 and pole_angular_velocity < 0:
        return 2
    elif pole_angle > 0 and pole_angular_velocity < 0:
        return 1
    elif pole_angle < 0 and pole_angular_velocity > 0:
        return 1

    if abs(pole_angle) > 5 and abs(pole_angle) < 10 and pole_angular_velocity != 0:
        if pole_angle > 0:
            return 2
        else:
            return 1

    if cart_velocity > 5:
        return 1
    elif cart_velocity < -5:
        return 2

    if cart_position > 15 and pole_angle > 0:
        return 1
    elif cart_position > 15 and pole_angle < 0:
        return 1
    elif cart_position < -15 and pole_angle > 0:
        return 2
    elif cart_position < -15 and pole_angle < 0:
        return 2

    if cart_position > 15 and abs(pole_angle) < 5:
        return 1
    elif cart_position < -15 and abs(pole_angle) < 5:
        return 2

    return random.randint(1, 2)

