import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if (pole_angle > 0 and pole_angular_velocity > 0 and cart_velocity > 0):
        return 2
    elif (pole_angle < 0 and pole_angular_velocity < 0 and cart_velocity < 0):
        return 1
    elif (pole_angle > 0 and pole_angular_velocity > 0 and cart_velocity < 0):
        return 1
    elif (pole_angle < 0 and pole_angular_velocity < 0 and cart_velocity > 0):
        return 2
    elif (pole_angle > 0 and pole_angular_velocity < 0):
        return 1
    elif (pole_angle < 0 and pole_angular_velocity > 0):
        return 2
    elif (cart_position > 20):
        return 1
    elif (cart_position < -20):
        return 2
    elif (abs(pole_angle) >= 25):
        if pole_angle > 0:
            return 1
        else:
            return 2
    elif (abs(pole_angle) < 5 and abs(cart_velocity) < 5):
        if cart_position > 0:
            return 1
        elif cart_position < 0:
            return 2
        else:
            if cart_velocity != 0:
                if cart_velocity > 0:
                    return 1
                else:
                    return 2
            else:
                return 2
    else:
        if cart_velocity != 0:
            if cart_velocity > 0:
                return 1
            else:
                return 2
        else:
            return random.randint(1, 2)

