import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if abs(pole_angle) > 5:
        return 2 if pole_angle < 0 else 1
    elif pole_angular_velocity > 0 and pole_angle > 0:
        return 2
    elif pole_angular_velocity < 0 and pole_angle < 0:
        return 1
    elif cart_position > 20:
        return 1
    elif cart_position < -20:
        return 2
    elif cart_velocity > 5:
        return 1
    elif cart_velocity < -5:
        return 2
    elif (pole_angle > 0 and cart_velocity > 0) or (pole_angle < 0 and cart_velocity < 0):
        return 1 if pole_angle < 0 else 2
    elif abs(pole_angle) > 15:
        return 2 if pole_angle < 0 else 1
    else:
        return random.randint(1, 2)

