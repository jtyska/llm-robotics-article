import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if pole_angular_velocity > 12 and pole_angle > 0:
        return 1
    elif pole_angular_velocity < -12 and pole_angle < 0:
        return 1
