import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if abs(pole_angle) > 10 and cart_position != 0:
        return 1 if cart_position > 0 else 2
    elif abs(cart_velocity) > 5:
        return 1 if cart_velocity > 0 else 2
    elif pole_angle > 0 and pole_angular_velocity > 0:
        return 2
    elif pole_angle < 0 and pole_angular_velocity < 0:
        return 1
    elif abs(pole_angle) < 5 and pole_angular_velocity != 0:
        return 2 if pole_angular_velocity > 0 else 1
    else:
        return random.randint(1, 2)

