            return 1
        else:
            return 2
    elif pole_angle > 10 and pole_angular_velocity > 0:
        return 1
    elif pole_angle < -10 and pole_angular_velocity < 0:
        return 1
    elif (pole_angle > 0 and cart_position < -5) or (pole_angle < 0 and cart_position > 5):
        if cart_position < 0:
            return 2
        else:
            return 1
    elif pole_angle > 5:
        return 1
    elif pole_angle < -5:
        return 2
    else:
        return 2
    return random.randint(1, 2)

