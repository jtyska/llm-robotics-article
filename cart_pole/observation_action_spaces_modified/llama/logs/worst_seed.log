    elif cart_velocity > 0 and pole_angle < 0:
        return 1
    elif cart_velocity < 0 and pole_angle > 0:
        return 1
    elif cart_velocity < 0 and pole_angle < 0:
        return 2
    else:
        return random.randint(1, 2)

