import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if pole_angle > 5 or pole_angular_velocity > 0.5:
        return 2
    elif pole_angle < -5 or pole_angular_velocity < -0.5:
        return 1
