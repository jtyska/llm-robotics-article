    elif cart_position > 15 and cart_velocity > 0:
        return 1
    elif cart_position < -15 and cart_velocity < 0:
        return 2
    elif pole_angular_velocity > 5:
        if pole_angle > 0:
            return 1
        else:
            return 2
    else:
        return 2
    return random.randint(1, 2)

