            return 2
        elif cart_velocity > 0:
            return 2
        elif cart_velocity < 0:
            return 1
    elif cart_position > 20 or cart_position < -20 or pole_angle > 15 or pole_angle < -15:
        if cart_position > 0 and pole_angle > 0:
            return 1
        elif cart_position < 0 and pole_angle < 0:
            return 2
        elif cart_position > 0 and pole_angle < 0:
            return 1
        elif cart_position > 0 and pole_angle > 0:
            return 2
        elif cart_position < 0 and pole_angle > 0:
            return 1
        else:
            return 2
    return random.randint(1, 2)

