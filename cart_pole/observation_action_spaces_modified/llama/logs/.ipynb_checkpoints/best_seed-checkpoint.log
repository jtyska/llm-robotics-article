import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if pole_angle > 10 and pole_angular_velocity > 2:
        return 1
    elif pole_angle < -10 and pole_angular_velocity < -2:
        return 2
    elif cart_position > 15 and cart_velocity > 4:
        return 1
    elif cart_position < -15 and cart_velocity < -4:
        return 2
    elif pole_angle > 0 and pole_angular_velocity > 0 and cart_velocity > 0:
        return 1
    elif pole_angle < 0 and pole_angular_velocity < 0 and cart_velocity < 0:
        return 2
    elif cart_position > 10 and pole_angle > 5:
