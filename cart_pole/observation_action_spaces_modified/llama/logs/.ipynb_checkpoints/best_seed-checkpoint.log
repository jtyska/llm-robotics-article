import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if pole_angle > 10 and pole_angular_velocity > 0:
        return 1
    elif pole_angle < -10 and pole_angular_velocity < 0:
        return 2
    elif cart_position > 20 or cart_velocity > 5:
        return 1
    elif cart_position < -20 or cart_velocity < -5:
        return 2
    elif pole_angular_velocity > 15 and pole_angle > 0:
        return 1
    elif pole_angular_velocity > 15 and pole_angle < 0:
        return 2
    elif pole_angle > 0 and -5 <= pole_angle <= 25 and cart_velocity > 0:
        return 1
    elif pole_angle < 0 and -25 <= pole_angle <= 5 and cart_velocity < 0:
        return 2
    elif -5 <= pole_angle <= 5 and cart_velocity != 0:
        if cart_velocity > 0:
            return 1
        else:
            return 2
    else:
        return random.randint(1, 2)

