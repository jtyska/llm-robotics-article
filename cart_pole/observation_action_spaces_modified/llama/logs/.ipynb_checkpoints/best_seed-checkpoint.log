import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if pole_angular_velocity > 2 and pole_angle > 0:
        return 2
    elif pole_angular_velocity > 2 and pole_angle <= 0:
        return 1
    elif pole_angular_velocity < -2 and pole_angle > 0:
        return 2
    elif pole_angular_velocity < -2 and pole_angle <= 0:
        return 1
    elif cart_position > 15:
        return 1
    elif cart_position < -15:
        return 2
    elif -15 <= cart_position <= 15 and pole_angle > 5:
        return 2
    elif -15 <= cart_position <= 15 and pole_angle < -5:
        return 1
    elif -15 <= cart_position <= 15 and -5 <= pole_angle <= 5:
        if cart_position > 0:
            return 1
        elif cart_position < 0:
            return 2
        else:
            return 2
    return random.randint(1, 2)

