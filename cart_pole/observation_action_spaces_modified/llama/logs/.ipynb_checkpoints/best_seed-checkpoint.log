import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if pole_angle > 10 or pole_angular_velocity > 0:
        return 2
    elif pole_angle < -10 or pole_angular_velocity < -0.8:
        return 1
    elif -10 <= pole_angle <= 10 and -0.8 <= pole_angular_velocity <= 0.8:
        if cart_position > 12 or cart_velocity > 3:
            return 1
        elif cart_position < -12 or cart_velocity < -3:
            return 2
        elif cart_velocity > 1 and pole_angle > 0:
            return 2
        elif cart_velocity < -1 and pole_angle < 0:
            return 1
    elif cart_position > 18 or cart_position < -18:
        if pole_angle > 12:
            return 2
        elif pole_angle < -12:
            return 1
    return random.randint(1, 2)

