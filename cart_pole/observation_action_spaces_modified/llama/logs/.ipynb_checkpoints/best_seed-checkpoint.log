def new_strategy(state):
    # Extract state variables
    cart_position = state[0]
    cart_velocity = state[1]
    pole_angle = state[2]
    angular_velocity = state[3]

    if pole_angle > 5 or angular_velocity > 0.5:
        return 2  # Move right to stabilize the pole
    elif cart_position < -20 or cart_position > 20:
        if cart_position < 0:
            return 2  # Move right to correct cart position
        else:
            return 1  # Move left to correct cart position

    # Control cart movement when pole is stable
    if cart_position > 0 and cart_velocity > 0:
        return 1  # Move left to slow down the cart
    elif cart_position < 0 and cart_velocity < 0:
        return 2  # Move right to speed up the cart

    # More cautious approach when pole angle is near limits
    if abs(pole_angle) > 4.5:  # adjust threshold value as needed
        action = -1 * np.sign(cart_position)
        return action  # reduce magnitude of action taken

    # Default action ( move right if cart position is positive, else move left)
    return -1 * np.sign(cart_position)
```

