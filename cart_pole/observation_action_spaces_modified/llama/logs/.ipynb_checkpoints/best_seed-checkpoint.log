    elif (pole_angular_velocity > 3 or pole_angle > 12) and pole_angle > 0:
        return 1
    elif (pole_angular_velocity > 3 or pole_angle > 12) and pole_angle <= 0:
        return 2
    elif abs(pole_angle) > 8 and abs(cart_position) < 5 and pole_angle > 0:
        return 1
    elif abs(pole_angle) > 8 and abs(cart_position) < 5 and pole_angle <= 0:
        return 2
    else:
        return random.randint(1, 2)

