            return 1 if pole_angle > 0 else 2
    elif cart_position < -10 or cart_position > 10 or pole_angle < -25 or pole_angle > 25:
        if pole_angle > 0:
            return 2
        if pole_angle < 0:
            return 1
    return random.randint(1, 2)

