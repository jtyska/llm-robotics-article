import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if -5 <= cart_position <= 5 and -10 <= pole_angle <= 10:
        if cart_velocity > 2:
            return 1
        elif cart_velocity < -2:
            return 2
        elif pole_angular_velocity > 3:
            return 1
        elif pole_angular_velocity < -3:
            return 2
    elif -10 <= cart_position <= 10 and -15 <= pole_angle <= 15:
        if cart_velocity > 4:
            return 1
        elif cart_velocity < -4:
            return 2
        elif pole_angular_velocity > 6:
            return 1
        elif pole_angular_velocity < -6:
            return 2
    elif -20 <= cart_position <= 20 and -25 <= pole_angle <= 25:
        if cart_velocity > 8:
            return 1
        elif cart_velocity < -8:
            return 2
        elif pole_angular_velocity > 9:
            return 1
        elif pole_angular_velocity < -9:
            return 2
    elif cart_position < -20 or cart_position > 20 or pole_angle < -30 or pole_angle > 30:
        if pole_angle > 5:
            return 2
        elif pole_angle < -5:
            return 1
        elif cart_position > 5:
            return 2
        elif cart_position < -5:
            return 1
    return random.randint(1, 2)

