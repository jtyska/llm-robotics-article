import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if -5 <= cart_position <= 5 and -10 <= pole_angle <= 10:
        if cart_velocity > 3 or cart_velocity < -3:
            action = 2 if cart_velocity > 0 else 1
        elif pole_angular_velocity > 6 or pole_angular_velocity < -6:
            action = 2 if pole_angle < 0 else 1
    elif -8 <= cart_position <= 8 and -12 <= pole_angle <= 12:
        if cart_velocity > 4 or cart_velocity < -4:
            action = 2 if cart_velocity > 0 else 1
        elif pole_angular_velocity > 5 or pole_angular_velocity < -5:
            action = 2 if pole_angle < 0 else 1
    elif -10 <= cart_position <= 10 and -15 <= pole_angle <= 15:
        if cart_velocity > 3 or cart_velocity < -3:
            action = 2 if cart_velocity > 0 else 1
        elif pole_angular_velocity > 4 or pole_angular_velocity < -4:
            action = 2 if pole_angle < 0 else 1
    elif -12 <= cart_position <= 12 and -18 <= pole_angle <= 18:
        if cart_velocity > 3 or cart_velocity < -3:
            action = 2 if cart_velocity > 0 else 1
        elif pole_angular_velocity > 4 or pole_angular_velocity < -4:
            action = 2 if pole_angle < 0 else 1
    else:
        if cart_position > 0 or pole_angle > 0:
            action = 2
        elif cart_position < 0 or pole_angle < 0:
            action = 1
    return random.randint(1, 2) if 'action' not in locals() else action

