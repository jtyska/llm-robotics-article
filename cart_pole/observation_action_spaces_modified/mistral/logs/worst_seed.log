def improved_control_strategy(cart_position, cart_velocity, pole_angle, angular_velocity):
    # Stability Zone: Maintain balance with moderate corrections
    if abs(cart_position) <= 5 and abs(pole_angle) <= 10:
        if abs(cart_velocity) > 2:
            return 1 if cart_velocity < 0 else 2
        elif abs(angular_velocity) > 3:
            return 1 if angular_velocity < 0 else 2
        else:
            # Maintain stability with small adjustments based on pole angle
            return 1 if pole_angle > 0 else 2

    # Correction Zone: Apply aggressive corrections for larger deviations
    elif abs(pole_angle) > 6 or abs(angular_velocity) > 15:
        if pole_angle > 4 and angular_velocity > 3:
            return 2  # Move right aggressively
        elif pole_angle < -4 and angular_velocity < -3:
            return 1  # Move left aggressively
        else:
            # Apply maximum corrective action in opposite direction of tilt
            return 1 if pole_angle > 0 else 2

    # Transition Zone: Smooth transition between stability and correction zones
    else:
        if cart_position + pole_angle * 10 / 6 < 0:
            return 1
        else:
            return 2
```

