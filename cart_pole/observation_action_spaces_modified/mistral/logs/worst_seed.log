import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if -5 <= cart_position <= 5 and -12 <= pole_angle <= 12:
        if cart_velocity > 3 or cart_velocity < -3:
            return 1 if cart_velocity > 0 else 2
        if pole_angular_velocity > 6 or pole_angular_velocity < -6:
            return 1 if pole_angular_velocity > 0 else 2
    elif cart_position < -5 or cart_position > 5 or pole_angle < -12 or pole_angle > 12:
        if pole_angle > 4 and pole_angular_velocity > 0:
            return 2
        if pole_angle < -4 and pole_angular_velocity < 0:
            return 1
        if pole_angle > 8 or pole_angle < -8:
            return 2 if pole_angle > 0 else 1
    return random.randint(1, 2)

