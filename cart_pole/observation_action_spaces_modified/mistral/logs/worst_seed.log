def control_strategy(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if -5 <= cart_position <= 5 and -10 <= pole_angle <= 10:
        if abs(cart_velocity) > 2:
            # Apply force to slow down the cart
            return -np.sign(cart_velocity) * 10
        elif abs(pole_angular_velocity) > 5:
            # Apply moderate force to counteract pole tilt
            return -np.sign(pole_angular_velocity) * 5
    else:
        if (abs(pole_angle) > 2 and abs(pole_angular_velocity) > 3):
            # Aggressive correction for large angles and velocities
            return -np.sign(pole_angle + pole_angular_velocity * 0.1) * 50
        elif (abs(pole_angle) > 6 or abs(cart_position) > 5):
            # Maximum correction for extreme conditions
            return -np.sign(pole_angle + cart_position * 2) * 100
    # Maintain stability with moderate corrections
    return -np.sign(cart_velocity + pole_angular_velocity * 0.5) * 10
```
