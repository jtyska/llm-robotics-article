import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if cart_velocity > 3:
        return 1
    elif cart_velocity < -3:
        return 2
    elif pole_angular_velocity > 6:
        return 1
    elif pole_angular_velocity < -6:
        return 2
    elif abs(cart_position) <= 8 and abs(pole_angle) <= 12 and (cart_velocity > 0 or pole_angular_velocity > 0):
        return 1
    elif abs(cart_position) <= 8 and abs(pole_angle) <= 12 and (cart_velocity < 0 or pole_angular_velocity < 0):
        return 2
    elif abs(cart_position) > 8 or abs(pole_angle) > 12:
        return random.randint(1, 2)
    else:
        return random.randint(1, 2)

