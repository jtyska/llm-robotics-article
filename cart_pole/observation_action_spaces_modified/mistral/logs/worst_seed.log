import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if (pole_angle < -5 or pole_angular_velocity < -10):
        return 2
    elif (pole_angle > 5 or pole_angular_velocity > 10):
        return 1
    elif (cart_position < -5 and pole_angle <= 0):
        return 2
    elif (cart_position > 5 and pole_angle >= 0):
        return 1
    elif ((pole_angle < -3 and cart_velocity > 4) or (cart_position < -8)):
        return 2
    elif ((pole_angle > 3 and cart_velocity < -4) or (cart_position > 8)):
        return 1
    elif (pole_angular_velocity < 0 and pole_angle <= 0):
        return 2
    elif (pole_angular_velocity > 0 and pole_angle >= 0):
        return 1
    else:
        return random.randint(1, 2)

