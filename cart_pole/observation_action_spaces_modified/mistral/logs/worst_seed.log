def control_cart_pole(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    # Central Range (Cart Position -6 to 6, Pole Angle -10 to 10)
    if abs(cart_position) <= 6 and abs(pole_angle) <= 10:
        if abs(cart_velocity) > 2 or abs(pole_angular_velocity) > 3:
            action = 2 if cart_velocity + pole_angle * 0.5 >= 0 else 1 # Dynamic adjustment based on combined state
    # Intermediate Range (Cart Position -8 to 8, Pole Angle -14 to 14)
    elif abs(cart_position) <= 8 and abs(pole_angle) <= 14:
        if abs(cart_velocity) > 3 or abs(pole_angular_velocity) > 5:
            action = 2 if cart_velocity + pole_angle * 0.7 >= 0 else 1 # Increased sensitivity
    # Wider Range (Cart Position -10 to 10, Pole Angle -18 to 18)
    elif abs(cart_position) <= 10 and abs(pole_angle) <= 18:
        if abs(cart_velocity) > 4 or abs(pole_angular_velocity) > 6:
            action = 2 if cart_velocity + pole_angle >= 0 else 1 # Stronger corrective force
    # Extended Range (Cart Position -12 to 12, Pole Angle -24 to 24)
    elif abs(cart_position) <= 12 and abs(pole_angle) <= 24:
        if abs(cart_velocity) > 5 or abs(pole_angular_velocity) > 8:
            action = 2 if cart_velocity + pole_angle * 1.2 >= 0 else 1 # Aggressive correction
    # Beyond Specified Ranges
    else:
        if abs(cart_position) > 12 or abs(pole_angle) > 24:
            action = 2 if cart_velocity + pole_angle * 0.5 >= 0 else 1 # Emergency correction
    return action
```

