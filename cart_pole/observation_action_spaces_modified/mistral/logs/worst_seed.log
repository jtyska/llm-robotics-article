        if pole_angular_velocity > 3 or pole_angular_velocity < -3:
            return 1 if pole_angular_velocity > 0 else 2
        elif cart_velocity > 5 or cart_velocity < -5:
            return 1 if cart_velocity > 0 else 2
        else:
            # Minimal corrective action to maintain stability
            if pole_angle > 3 or pole_angle < -3:
                return 1 if pole_angle > 0 else 2
            elif cart_position > 3 or cart_position < -3:
                return 1 if cart_position > 0 else 2
    # Default random action
    return random.randint(1, 2)

