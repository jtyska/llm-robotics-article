import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    # Central Range (Cart Position -5 to 5, Pole Angle -10 to 10):
    if cart_position >= -5 and cart_position <= 5 and pole_angle >= -10 and pole_angle <= 10:
