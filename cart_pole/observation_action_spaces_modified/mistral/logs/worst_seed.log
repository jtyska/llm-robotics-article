            return 2 if cart_velocity > 4 else 1 # move in the opposite direction to slow down
        elif pole_angular_velocity > 6 or pole_angular_velocity < -6:
            return 1 if pole_angle >= 0 else 2 # apply a moderate force in the opposite direction of the tilt to stabilize
    # Intermediate Range (Cart Position -8 to 8, Pole Angle -12 to 12):
    elif cart_position >= -8 and cart_position <= 8 and pole_angle >= -12 and pole_angle <= 12:
        if cart_velocity > 4 or cart_velocity < -4:
            return 2 if cart_velocity > 5 else 1 # move in the opposite direction to slow down
        elif pole_angular_velocity > 5 or pole_angular_velocity < -5:
            return 1 if pole_angle >= 0 else 2 # apply a moderate force in the opposite direction of the tilt to stabilize
    # Wider Range (Cart Position -10 to 10, Pole Angle -15 to 15):
    elif cart_position >= -10 and cart_position <= 10 and pole_angle >= -15 and pole_angle <= 15:
        if cart_velocity > 4 or cart_velocity < -4:
            return 2 if cart_velocity > 5 else 1 # move in the opposite direction to slow down
        elif pole_angular_velocity > 4 or pole_angular_velocity < -4:
            return 1 if pole_angle >= 0 else 2 # apply a moderate force in the opposite direction of the tilt to stabilize
    # Extended Range (Cart Position -12 to 12, Pole Angle -18 to 18):
    elif cart_position >= -12 and cart_position <= 12 and pole_angle >= -18 and pole_angle <= 18:
        if cart_velocity > 3 or cart_velocity < -3:
            return 2 if cart_velocity > 4 else 1 # move in the opposite direction to slow down
        elif pole_angular_velocity > 5 or pole_angular_velocity < -5:
            return 1 if pole_angle >= 0 else 2 # apply a moderate force in the opposite direction of the tilt to stabilize
    # Beyond Specified Ranges:
    elif cart_position < -12 or cart_position > 12:
        return 2 if cart_position > 0 else 1 # move cart to center
    elif pole_angle < -18 or pole_angle > 18:
        return 1 if pole_angle >= 0 else 2 # apply strong opposing force gradually reducing force as the system stabilizes

    # Default random action
    return random.randint(1, 2)

