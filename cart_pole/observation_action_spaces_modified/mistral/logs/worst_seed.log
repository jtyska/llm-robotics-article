            return 1 if cart_velocity > 2 else (2 if cart_velocity < -2 else (1 if pole_angular_velocity > 4 else (2 if pole_angular_velocity < -4 else random.randint(1, 2))))
    elif -8 <= cart_position <= 8 and -12 <= pole_angle <= 12:
        if abs(cart_velocity) > 3 or abs(pole_angular_velocity) > 5:
            return 1 if cart_velocity > 0 else (2 if cart_velocity < 0 else (1 if pole_angular_velocity > 4 else (2 if pole_angular_velocity < -4 else random.randint(1, 2))))
    elif -10 <= cart_position <= 10 and -15 <= pole_angle <= 15:
        if abs(cart_velocity) > 3 or abs(pole_angular_velocity) > 4:
            return 1 if cart_velocity > 2 else (2 if cart_velocity < -2 else (1 if pole_angular_velocity > 3 else (2 if pole_angular_velocity < -3 else random.randint(1, 2))))
    elif -12 <= cart_position <= 12 and -18 <= pole_angle <= 18:
