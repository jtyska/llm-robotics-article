def updated_strategy(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if -5 <= cart_position <= 5 and -10 <= pole_angle <= 10:
        # If the cart velocity is high, apply force to slow down
        if abs(cart_velocity) > 2:
