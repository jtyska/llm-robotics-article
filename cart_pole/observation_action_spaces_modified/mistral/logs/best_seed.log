    if abs(pole_angle) > 15 or abs(pole_angular_velocity) > 30:
        return 2 if pole_angle < -15 or pole_angular_velocity < -30 else 1
    elif abs(pole_angle) > 8:
        return 2 if pole_angle < -8 or (pole_angle < 0 and pole_angular_velocity < 0) else 1
    elif abs(cart_position) > 3 or abs(cart_velocity) > 5:
        return 2 if cart_position < -3 or cart_velocity < -5 else 1
    elif abs(pole_angular_velocity) > 8:
        return 2 if pole_angular_velocity < -8 or (pole_angular_velocity < 0 and pole_angle < 0) else 1
    elif abs(cart_position) > 1.5 or abs(cart_velocity) > 3:
        return 2 if cart_position < -1.5 or cart_velocity < -3 else 1
    elif abs(pole_angle) > 3 or abs(pole_angular_velocity) > 6:
        return 2 if pole_angle < -3 or (pole_angle < 0 and pole_angular_velocity < 0) else 1
    else:
        return 2 if cart_position > 0 else 1
    return random.randint(1, 2)

