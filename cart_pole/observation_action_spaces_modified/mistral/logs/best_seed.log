def new_strategy(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    action = None  # Initialize action

    # Handle extreme conditions first for immediate correction
    if abs(pole_angle) > 12 or abs(pole_angular_velocity) > 50:
        if pole_angle > 0:
            return 'left'  # Correct to the left if pole is leaning right
        else:
            return 'right'  # Correct to the right if pole is leaning left

    # Intermediate corrections for pole angle and angular velocity
    if abs(pole_angle) > 6 or abs(pole_angular_velocity) > 20:
        if pole_angle > 0 or pole_angular_velocity > 10:
            action = 'left'
        elif pole_angle < 0 or pole_angular_velocity < -10:
            action = 'right'

    # Cart position and velocity control to prevent excessive movement
    if abs(cart_position) > 2.4:
        if cart_position > 3.6:
            return 'left'
        elif cart_position < -3.6:
            return 'right'

    if abs(cart_velocity) > 1.5:
        if cart_velocity > 2.0:
            action = 'left'
        elif cart_velocity < -2.0:
            action = 'right'

    # Default action to stabilize minor fluctuations
    if not action:
        if pole_angle > 1 or (pole_angular_velocity > 5):
            return 'left'
        elif pole_angle < -1 or (pole_angular_velocity < -5):
            return 'right'

    # If no specific action is triggered, maintain the current state
    return action if action else 'noop'
```

