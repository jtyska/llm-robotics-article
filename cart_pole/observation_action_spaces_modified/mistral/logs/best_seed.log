        else:
            return 1
    elif abs(cart_position) > 1 or abs(cart_velocity) > 3:
        if cart_position < -1 or cart_velocity < -3:
            return 2
        else:
            return 1
    elif abs(pole_angle) > 5 or abs(pole_angular_velocity) > 7:
        if pole_angle < -5 or (pole_angle < 0 and pole_angular_velocity < 0):
            return 2
        else:
            return 1
    else:
        return 2 if cart_position <= 0 else 1
    return random.randint(1, 2)

