def improved_strategy(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    action = 2  # Default action to keep the pole upright (move right)

    if abs(pole_angle) > 20 or abs(pole_angular_velocity) > 35:
        if pole_angle < -20 or pole_angular_velocity < -35:
            action = 1  # Move left to correct severe left lean/fall
        else:
            action = 0  # Move right to correct severe right lean/fall
    elif abs(pole_angle) > 5:
        if pole_angle < -5 or (pole_angle < 0 and pole_angular_velocity < 0):
            action = 1  # Move left to correct moderate left lean
        else:
            action = 2  # Move right to correct moderate right lean
    elif abs(cart_position) > 3 or abs(cart_velocity) > 4:
        if cart_position < -3 or cart_velocity < -4:
            action = 1  # Move left to correct major leftward drift
        else:
            action = 2  # Move right to correct major rightward drift
    elif abs(pole_angular_velocity) > 5:
        if pole_angular_velocity < -5 or (pole_angular_velocity < 0 and pole_angle < 0):
            action = 1  # Move left to counteract significant left rotation
        else:
            action = 2  # Move right to counteract significant right rotation
    elif abs(cart_position) > 1.5 or abs(cart_velocity) > 3:
        if cart_position < -1.5 or cart_velocity < -3:
            action = 0  # Minor adjustment leftward drift
        else:
            action = 2  # Minor adjustment rightward drift
    elif abs(cart_position) > 0.8 or abs(cart_velocity) > 1.5:
        if cart_position < -0.8 or cart_velocity < -1.5:
            action = 0  # Fine-tune leftward drift
        else:
            action = 2  # Fine-tune rightward drift
    return action
```

