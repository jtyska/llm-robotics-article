        if cart_position < -3.5 or cart_velocity < -4:
            action = 2  # Move right to correct leftward drift
        else:
            action = 1  # Move left to correct rightward drift
    elif abs(pole_angular_velocity) > 7.5:
        if pole_angular_velocity < -7.5 or (pole_angular_velocity < 0 and pole_angle < 0):
            action = 2  # Move right to counteract left rotation
        else:
            action = 1  # Move left to counteract right rotation
    elif abs(cart_position) > 1 or abs(cart_velocity) > 3.5:
        if cart_position < -1 or cart_velocity < -3.5:
            action = 2  # Fine-tune movement to correct slight leftward drift
        else:
            action = 1  # Fine-tune movement to correct slight rightward drift

    return action
```

