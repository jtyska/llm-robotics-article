def enhanced_stability_control(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    # Critical thresholds for immediate action
    if abs(pole_angle) > 15 or abs(pole_angular_velocity) > 30:
        action = 2 if (pole_angle < -15 or pole_angular_velocity < -30) else 1
    # Secondary thresholds for stabilizing the cart and pole
    elif abs(cart_position) > 4 or abs(cart_velocity) > 6:
        action = 2 if (cart_position < -4 or cart_velocity < -6) else 1
    # Fine-tuning thresholds for better balance and reduced oscillation
    elif abs(pole_angle) > 5:
        if pole_angular_velocity < 0 and pole_angle < 0:
            action = 2
        elif pole_angular_velocity > 0 and pole_angle > 0:
            action = 1
    # Additional checks for cart position and velocity to prevent overshooting
    elif abs(cart_position) > 3 or abs(cart_velocity) > 4.5:
        action = 2 if (cart_position < -3 or cart_velocity < -4.5) else 1
    else:
        # Prediction model with adjusted weights for finer control
        prediction = cart_position * 0.8 + cart_velocity * 0.6 + pole_angle * 0.25 + pole_angular_velocity * 0.4
        action = 1 if prediction < 0 else 2
    return action
```

