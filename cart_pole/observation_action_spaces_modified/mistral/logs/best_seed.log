    elif abs(pole_angle) > 4 or abs(pole_angular_velocity) > 4:
        action = 2 if (pole_angle < -3.8 or (pole_angle < 0 and pole_angular_velocity < 0)) else 1
    elif cart_position > 5 or cart_position < -5:  # Additional condition to handle extreme positions
