import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if abs(pole_angle) > 8:
        action = 2 if (pole_angle < -8 and pole_angular_velocity < 0) or (pole_angle > 8 and pole_angular_velocity > 0) else 1
    elif abs(cart_position) > 5.5 or abs(cart_velocity) > 13:
        action = 2 if cart_position < -5.5 or cart_velocity < -13 else 1
    else:
        prediction = (cart_position * 0.4 + cart_velocity * 0.6 + pole_angle * 1.2 + pole_angular_velocity * 1.4)
        action = 1 if prediction < 0 else 2
    return action

