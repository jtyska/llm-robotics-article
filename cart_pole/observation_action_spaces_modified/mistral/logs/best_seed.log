import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if abs(pole_angle) > 20 or abs(pole_angular_velocity) > 50:
        action = 2 if pole_angle < -20 or pole_angular_velocity < -50 else 1
    elif abs(cart_position) > 5 or abs(cart_velocity) > 8:
        action = 2 if cart_position < -5 or cart_velocity < -8 else 1
    elif abs(pole_angle) > 7:
        action = 2 if (pole_angle < -7 and pole_angular_velocity < 0) or (pole_angle > 7 and pole_angular_velocity > 0) else 1
    elif abs(cart_position) > 4 or abs(cart_velocity) > 6:
        action = 2 if cart_position < -4 or cart_velocity < -6 else 1
    else:
        prediction = (cart_position * 0.5 +
                      cart_velocity * 1.0 +
                      pole_angle * 8 +
                      pole_angular_velocity * 3)
        action = 1 if prediction < 0 else 2
    return random.randint(1, 2) if 'action' not in locals() else action

