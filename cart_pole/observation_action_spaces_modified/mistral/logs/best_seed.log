def enhanced_balancing_control(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if abs(pole_angle) > 12 or abs(pole_angular_velocity) > 30:
        action = 2 if (pole_angle < -12 or pole_angular_velocity < -30) else 1
    elif abs(cart_position) > 4 or abs(cart_velocity) > 6:
        action = 2 if cart_position < -4 or cart_velocity < -6 else 1
    elif abs(pole_angle) > 5:
        action = 2 if (pole_angle < -5 and pole_angular_velocity < 0) or (pole_angle > 5 and pole_angular_velocity > 0) else 1
    elif abs(cart_position) > 3 or abs(cart_velocity) > 4.2:
        action = 2 if cart_position < -3 or cart_velocity < -4.2 else 1
    else:
        prediction = cart_position + (cart_velocity * 0.5) + (pole_angle * 0.4) + (pole_angular_velocity * 0.3)
        action = 1 if prediction < 0 else 2
    return action
```

