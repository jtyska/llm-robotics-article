import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if abs(pole_angle) > 15 or abs(pole_angular_velocity) > 30:
        if pole_angle < -15 or pole_angular_velocity < -30:
            return 2
        else:
            return 1
    elif abs(pole_angle) > 8:
        if pole_angle < -8 or (pole_angle < 0 and pole_angular_velocity < 0):
            return 2
        else:
            return 1
    elif abs(cart_position) > 3 or abs(cart_velocity) > 5:
        if cart_position < -3 or cart_velocity < -5:
            return 2
        else:
            return 1
    elif abs(pole_angular_velocity) > 8:
        if pole_angular_velocity < -8 or (pole_angular_velocity < 0 and pole_angle < 0):
