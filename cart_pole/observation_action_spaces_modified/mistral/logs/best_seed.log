        # Fine-tuning for small deviations in pole angle and velocity
        action = 2 if (pole_angle < -3 or (pole_angle < 0 and pole_angular_velocity < 0)) else 1
    else:
        # Default action to maintain stability
        action = 2 if cart_position > 0.5 else 1

    return action
