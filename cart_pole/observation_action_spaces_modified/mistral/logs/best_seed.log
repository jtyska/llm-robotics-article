import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if abs(pole_angle) > 15 or abs(pole_angular_velocity) > 30:
        action = 2 if (pole_angle < -15 or pole_angular_velocity < -30) else 1
    elif abs(cart_position) > 4 or abs(cart_velocity) > 6:
        action = 2 if (cart_position < -4 or cart_velocity < -6) else 1
    elif abs(pole_angle) > 5:
        if pole_angular_velocity > 0:
            action = 2 if pole_angle > 0 else 1
        else:
            action = 1 if pole_angle > 0 else 2
    elif abs(cart_position) > 3 or abs(cart_velocity) > 5:
        action = 2 if cart_velocity < 0 else 1
    else:
        combined_score = (cart_position * 0.4 + cart_velocity * 0.3 + pole_angle * 0.5 + pole_angular_velocity * 2)
        action = 1 if combined_score < 0 else 2
    return action

