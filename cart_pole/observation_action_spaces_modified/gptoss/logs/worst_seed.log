def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    import random
    a = pole_angle
    w = pole_angular_velocity
    x = cart_position
    v = cart_velocity

    if a > 6:
        return 1
    elif a < -6:
        return 2
    elif w > 4:
        return 1
    elif w < -4:
        return 2
    elif x > 12:
        return 1
    elif x < -12:
        return 2
    elif v > 3:
        return 1
    elif v < -3:
        return 2
    elif x > 0:
        return 1
    elif x < 0:
        return 2
    else:
        return 2  # default rule when x == 0

    # fallback random action if no rule applied (the above else covers all cases, so this is a safety net)
    return random.randint(1, 2)
