import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    x = cart_position
    v = cart_velocity
    a = pole_angle
    w = pole_angular_velocity

    if x > 20:
        return 1
    elif x < -20:
        return 2
    elif v > 6:
        return 1
    elif v < -6:
        return 2
    elif a > 0:
        if w > 0:
            return 2
        else:
            return 1
    elif a < 0:
        if w < 0:
            return 1
        else:
            return 2
