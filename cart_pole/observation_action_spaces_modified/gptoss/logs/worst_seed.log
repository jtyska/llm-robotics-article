def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    x = cart_position
    v = cart_velocity
    a = pole_angle
    w = pole_angular_velocity

    if abs(a) >= 3:
        if a > 0:
            return 2  # pole leans right → push right
        else:
            return 1  # pole leans left → push left
    elif abs(w) >= 3:
        if w > 0:
            return 2  # pole rotating clockwise → push right
        else:
            return 1  # pole rotating counter‑clockwise → push left
    elif abs(x) >= 22 and abs(a) <= 1 and abs(w) <= 1:
        if x > 0:
            return 1  # cart too far right → push left
        else:
            return 2  # cart too far left → push right
    elif abs(v) >= 5:
        if v > 0:
            return 1  # cart moving right fast → push left
        else:
            return 2  # cart moving left fast → push right
    else:
        return random.randint(1, 2)
