# -----------------------------------------------------------------

# 1.  HARD SAFETY – never let the cart hit the wall
if abs(x) >= 25:                     # already out of bounds → stop (fail)
    a = None                         # episode ends
elif abs(x) >= 20:                   # close to wall
    # push *away* from the wall, regardless of pole state
    a = 1 if x > 0 else 2
    # but if the pole is already > 22° leaning toward the wall,
    # give a *strong* opposite push to avoid immediate fall
    if abs(th) > 22 and (th * x) > 0:
        a = 1 if th > 0 else 2
    return a

# 2.  PREVENT POLE FROM REACHING ANGLE LIMIT
if abs(th) >= 25:                    # pole already out of safe angle
    a = None                         # episode ends
elif abs(th) >= 18:                  # pole is getting dangerous
    # if angular velocity is *adding* to the tilt, push opposite to the tilt
    if (th > 0 and w > 0) or (th < 0 and w < 0):
        a = 1 if th > 0 else 2      # brake the fall
    else:
        a = 2 if th > 0 else 1      # usual corrective push
    return a

# 3.  COUPLED ANGLE‑VELOCITY CONTROL (mid‑range angles)
if abs(th) >= 3:
    # When |θ| is moderate, use a *proportional* rule:
    #   - If ω is helping the correction, push with the angle.
    #   - If ω is worsening the tilt, push against the angle.
    if (th > 0 and w < 0) or (th < 0 and w > 0):
        a = 2 if th > 0 else 1      # push with the angle
    else:
        a = 1 if th > 0 else 2      # push against the angle (brake)
    return a

# 4.  VELOCITY‑BASED CART STABILISATION
if abs(v) >= 4:                      # cart moving fast → damp it
    a = 1 if v > 0 else 2           # push opposite to velocity
    return a

# 5.  SMALL‑ANGLE, SMALL‑VELOCITY DEFAULT
#    Keep the pole centred by pushing opposite to the sign of the angle.
#    This yields the classic “push‑the‑pole‑toward‑center” behaviour.
a = 2 if th > 0 else 1
return a
```

