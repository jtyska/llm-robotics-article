```text
# CART‑POLE BALANCING – SIMPLE DISCRETE POLICY
# State variables (integers):
#   x  – cart position          (‑25 … 25)
#   v  – cart velocity          (‑50 … 50)
#   θ  – pole angle (0 = upright, + = lean right)   (‑25 … 25)
#   ω  – pole angular velocity  (‑50 … 50)
#
# Actions:
#   1 = push LEFT
#   2 = push RIGHT
#
# -----------------------------------------------------------------
# 1) VERY LARGE ANGLE – prevent immediate crash
IF |θ| >= 22 THEN
    IF θ > 0 THEN ACTION = 1        # push opposite to stop fast fall
    ELSE       ACTION = 2
# 2) LARGE ANGULAR VELOCITY – damp the swing
ELSE IF |ω| >= 4 THEN
    IF ω > 0 THEN ACTION = 1        # push opposite to angular motion
    ELSE       ACTION = 2
# 3) MODERATE ANGLE – the core “follow‑the‑pole” rule
ELSE IF |θ| >= 2 THEN
    IF θ > 0 THEN ACTION = 2        # push in the same direction as the lean
    ELSE       ACTION = 1
# 4) CART DRIFT – keep the cart inside the safe band
ELSE IF |x| >= 20 THEN
    IF x > 0 THEN ACTION = 2        # push further right (pole is already near‑vertical)
    ELSE       ACTION = 1
# 5) CART VELOCITY – damp excessive speed
ELSE IF |v| >= 3 THEN
    IF v > 0 THEN ACTION = 1        # push opposite to motion
    ELSE       ACTION = 2
# 6) DEFAULT – cart is near centre, pole almost upright
ELSE
    # Small random tie‑breaker to avoid dead‑lock when everything is zero
    ACTION = 2   # (right) – any deterministic choice works
```

