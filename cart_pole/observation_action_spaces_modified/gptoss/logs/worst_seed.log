import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    x = cart_position
    v = cart_velocity
    a = pole_angle
    w = pole_angular_velocity

    if abs(a) >= 3:
        if a > 0:
            return 2  # pole leans right → push right
        else:
            return 1  # pole leans left → push left
    elif abs(w) >= 2:
        if w > 0:
            return 2  # pole rotating clockwise → push right
        else:
            return 1  # pole rotating counter‑clockwise → push left
    elif abs(x) >= 20:
        if x > 0:
            return 1  # far right → push left
        else:
            return 2  # far left → push right
    elif abs(x) >= 12:
        if x > 0:
            if v > 0:
                return 1  # moving right → push left
            else:
                return 2  # moving left → push right
        else:
            if v < 0:
                return 2  # moving left → push right
            else:
                return 1  # moving right → push left
    elif abs(v) >= 5:
        if v > 0:
            return 1  # fast right motion → push left
        else:
            return 2  # fast left motion → push right
    else:
        # default right push, but also provide random fallback
        return random.randint(1, 2)
