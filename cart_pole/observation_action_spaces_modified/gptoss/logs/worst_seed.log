import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    x = cart_position
    v = cart_velocity
    theta = pole_angle
    omega = pole_angular_velocity

    # Rule 1
    if abs(x) >= 20 and abs(theta) > 22 and (theta * x) > 0:
        return 1 if theta > 0 else 2

    # Rule 2
    elif abs(x) >= 20:
        return 1 if x > 0 else 2

    # Rule 3
    elif abs(theta) >= 18 and ((theta > 0 and omega > 0) or (theta < 0 and omega < 0)):
        return 1 if theta > 0 else 2

    # Rule 4
    elif abs(theta) >= 18:
        return 2 if theta > 0 else 1

    # Rule 5
    elif abs(theta) >= 3 and ((theta > 0 and omega < 0) or (theta < 0 and omega > 0)):
        return 2 if theta > 0 else 1

    # Rule 6
    elif abs(theta) >= 3:
        return 1 if theta > 0 else 2

    # Rule 7
    elif abs(v) >= 4:
        return 1 if v > 0 else 2

    # Rule 8 (default)
    elif theta > 0:
        return 2
    else:
        return 1

    # Fallback random action (should not be reached)
    return random.randint(1, 2)
