IF |a| >= 23 AND a * w > 0               # pole almost at a limit and rotating outward
    THEN IF a > 0  THEN action = 1      # pole leans right → push LEFT
    ELSE               action = 2      # pole leans left  → push RIGHT

ELSE IF |a| >= 3                         # strong tilt dominates everything
    THEN IF a > 0  THEN action = 2
    ELSE               action = 1

ELSE IF |w| >= 3                         # fast rotation while still near vertical
    THEN IF w > 0  THEN action = 2
    ELSE               action = 1

ELSE IF |x| >= 22 AND |a| <= 1 AND |w| <= 1   # cart near a wall, pole almost upright
    THEN IF x > 0  THEN action = 1
    ELSE               action = 2

ELSE IF |v| >= 5                         # cart moving fast → damp it
    THEN IF v > 0  THEN action = 1
    ELSE               action = 2

ELSE                                      # ---- neutral default ----
    IF x > 2      THEN action = 1        # cart too far right → nudge left
    ELSE IF x < -2 THEN action = 2       # cart too far left  → nudge right
    ELSE            action = 0           # do nothing (no force)
```

