def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    import random
    TH_ANGLE = 3
    TH_OMEGA = 2
    TH_POS = 18
    TH_VEL = 2

    # 1. Strong tilt – act opposite to the tilt
    if abs(pole_angle) >= TH_ANGLE:
        if pole_angle > 0:
            return 2  # push right
        else:
            return 1  # push left

    # 2. Fast rotation – act opposite to the angular velocity
    elif abs(pole_angular_velocity) >= TH_OMEGA:
        if pole_angular_velocity > 0:
            return 1  # push left
        else:
            return 2  # push right

    # 3. Cart near the limits – drive it back toward the centre
    elif abs(cart_position) >= TH_POS:
        if cart_position > 0:
            return 1  # push left
        else:
            return 2  # push right

    # 4. Cart moving fast – damp the velocity
