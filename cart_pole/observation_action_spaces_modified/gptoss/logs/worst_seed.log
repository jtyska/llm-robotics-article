#  a  = pole angle      (positive → pole leaning right)
#  w  = pole angular velocity
#  x  = cart position   (positive → cart to the right)
#  v  = cart velocity

IF |a| > 3 THEN                     # pole already leaning enough
    IF a > 0 THEN action = 2       # move right to catch a right‑leaning pole
    ELSE        action = 1        # move left  to catch a left‑leaning pole

ELSE IF |w| > 3 THEN                 # pole is rotating fast
    IF w > 0 THEN action = 2       # rotate right → push cart right
    ELSE        action = 1        # rotate left  → push cart left

ELSE IF |x| > 20 THEN                # cart is close to the wall, bring it back
    IF x > 0 THEN action = 1       # push left
    ELSE        action = 2        # push right

ELSE IF |v| > 5 THEN                 # cart moving too fast, damp it
    IF v > 0 THEN action = 1       # opposite to motion
    ELSE        action = 2

ELSE                                 # pole is almost upright, cart near centre
    action = 2                       # default to “do nothing special”
