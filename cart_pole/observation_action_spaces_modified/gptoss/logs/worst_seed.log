import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    # Alias for readability
    x = cart_position
    v = cart_velocity
    theta = pole_angle
    omega = pole_angular_velocity

    if abs(theta) >= 3:
        if theta > 0:
            return 2  # push right
        else:
            return 1  # push left
    elif abs(omega) >= 2:
        if omega > 0:
            return 2  # push right
        else:
            return 1  # push left
    elif abs(x) >= 18:
        if x > 0:
            return 1  # push left
        else:
            return 2  # push right
    elif abs(v) >= 2:
        if v > 0:
            return 1  # push left
        else:
            return 2  # push right
    else:
        if theta > 0:
            return 2  # push right
        else:
            return 1  # push left

    # Fallback random action (should not be reached)
    return random.randint(1, 2)
