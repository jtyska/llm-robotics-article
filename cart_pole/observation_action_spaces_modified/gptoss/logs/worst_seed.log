            return 1
        else:
            return 2
    elif abs(omega) >= 3:
        if omega > 0:
            return 2
        else:
            return 1
    elif abs(theta) >= 2 or abs(omega) >= 2:
        if theta * omega > 0:
            if theta > 0:
                return 1
            else:
                return 2
        else:
            if omega > 0:
                return 2
            else:
                return 1
    elif abs(x) >= 12:
        if x > 0:
            return 1
        else:
            return 2
    elif abs(v) >= 2:
        if v > 0:
            return 1
        else:
            return 2
    else:
        if theta > 0:
            return 1
        else:
            return 2
    return random.randint(1, 2)
