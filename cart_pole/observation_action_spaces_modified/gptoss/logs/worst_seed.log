def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    x = cart_position
    v = cart_velocity
    theta = pole_angle
    omega = pole_angular_velocity

    if abs(theta) >= 20 and theta > 0:
        return 1
    elif abs(theta) >= 20 and theta < 0:
        return 2
    elif abs(theta) >= 4 and theta > 0:
