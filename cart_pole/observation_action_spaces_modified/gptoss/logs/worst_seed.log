        return 1
    elif abs(omega) >= 2 and omega < 0:
        return 2
    elif abs(x) >= 15 and x > 0:
        return 1
    elif abs(x) >= 15 and x < 0:
        return 2
    elif abs(v) >= 2 and v > 0:
        return 1
    elif abs(v) >= 2 and v < 0:
        return 2
    elif theta > 0:
        return 1
    elif theta < 0:
        return 2
    return random.randint(1, 2)
