# 3. Bring the cart back toward the centre of the track
ELSE IF |x| ≥ 18
    THEN action = LEFT  (1)  IF x > 0   # cart too far right → move left
         ELSE action = RIGHT (2)      # cart too far left  → move right

# 4. Dampen a large cart velocity (only when the pole is upright)
ELSE IF |v| ≥ 2
    THEN action = LEFT  (1)  IF v > 0   # moving right fast → push left
         ELSE action = RIGHT (2)      # moving left fast  → push right

# 5. Fine‑tune when everything is almost balanced
ELSE
    # If the pole is still slightly off‑vertical, keep nudging opposite to the tilt
    IF θ ≠ 0
        THEN action = LEFT  (1)  IF θ > 0
             ELSE action = RIGHT (2)
    # Otherwise just keep the cart near the centre (arbitrary choice)
    ELSE action = LEFT (1)               # (any deterministic choice works)
