def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    import random
    x = cart_position
    v = cart_velocity
    a = pole_angle
    w = pole_angular_velocity

    if a > 3:
        return 1
    elif a < -3:
        return 2
    elif a > 1 and w > 0:
        return 1
    elif a > 1 and w < 0:
        return 2
    elif a < -1 and w > 0:
        return 1
    elif a < -1 and w < 0:
        return 2
    elif abs(a) <= 1 and v > 4:
        return 1
    elif abs(a) <= 1 and v < -4:
        return 2
    elif abs(a) <= 1 and x > 20:
        return 1
    elif abs(a) <= 1 and x < -20:
        return 2
    elif x > 0:
        return 1
    elif x < 0:
        return 2
    else:
        return 2
    return random.randint(1, 2)
