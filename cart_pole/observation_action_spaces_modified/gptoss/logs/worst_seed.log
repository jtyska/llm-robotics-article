import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    x = cart_position
    v = cart_velocity
    a = pole_angle
    w = pole_angular_velocity

    action = None

    if abs(a) >= 3:
        action = 2 if a > 0 else 1
    elif abs(w) >= 3:
        action = 2 if w > 0 else 1
    elif abs(x) >= 22:
        action = 1 if x > 0 else 2
    elif abs(v) >= 5:
        action = 1 if v > 0 else 2
    elif a == 0 and w == 0:
        action = 2
    else:
        action = 2

    if action is None:
        action = random.randint(1, 2)

    return action
