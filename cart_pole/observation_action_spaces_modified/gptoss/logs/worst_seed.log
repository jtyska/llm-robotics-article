```text
# ------------------------------------------------------------------
#  CART‑POLE BALANCING CONTROLLER (500‑step max)
# ------------------------------------------------------------------
#  Input:  x  – cart position  (‑25 … 25)
#          v  – cart velocity  (‑50 … 50)
#          a  – pole angle    (‑25 … 25)   (0 = upright)
#          w  – pole angular velocity (‑50 … 50)
#  Output: ACTION ∈ {1 (push left), 2 (push right)}
# ------------------------------------------------------------------

# 1.  Strong pole‑angle correction (dominant term)
IF |a| >= 4 THEN
    IF a > 0 THEN ACTION = 2      # pole leans right → push right
    ELSE        ACTION = 1        # pole leans left  → push left
    RETURN

# 2.  Angular‑velocity correction when the pole is almost upright
#    (|a| <= 2) – we must stop the swing before it grows.
ELSE IF |a| <= 2 AND |w| >= 3 THEN
    # w > 0  → pole rotating clockwise (top moving right)
    # w < 0  → pole rotating counter‑clockwise (top moving left)
    IF w > 0 THEN ACTION = 1      # push opposite to rotation → left
    ELSE        ACTION = 2        # push opposite to rotation → right
    RETURN

# 3.  Cart‑position safety – keep the cart inside the central corridor
ELSE IF |x| >= 20 THEN
    IF x > 0 THEN ACTION = 1      # too far right → push left
    ELSE        ACTION = 2        # too far left  → push right
    RETURN

# 4.  Cart‑velocity damping – when the cart is already moving fast,
#    push opposite to its motion to avoid drifting out of the corridor.
ELSE IF |v| >= 6 THEN
    IF v > 0 THEN ACTION = 1      # moving right fast → push left
    ELSE        ACTION = 2        # moving left fast  → push right
    RETURN

# 5.  Small “bias” to the right when everything is near zero.
#    This mirrors the empirically‑successful default of S‑2.
ELSE
    ACTION = 2                    # default right push
    RETURN
```

