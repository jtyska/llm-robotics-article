# -------------------------------------------------

IF |θ| >= 3                     # pole is noticeably tilted
    IF θ > 0  THEN ACTION = 2  # tilt right → push right
    ELSE       ACTION = 1      # tilt left  → push left

ELSE IF |ω| >= 2                # pole is rotating quickly
    IF ω > 0  THEN ACTION = 2  # rotating right → push right
    ELSE       ACTION = 1      # rotating left  → push left

ELSE IF |x| >= 18               # cart far from centre
    IF x > 0  THEN ACTION = 2  # cart on the right → keep pushing right
    ELSE       ACTION = 1      # cart on the left  → keep pushing left

ELSE IF |v| >= 2                # cart moving fast
    IF v > 0  THEN ACTION = 2  # moving right → push right
    ELSE       ACTION = 1      # moving left  → push left

ELSE                            # everything is small, use angle sign
    IF θ > 0  THEN ACTION = 2
    ELSE       ACTION = 1
```

