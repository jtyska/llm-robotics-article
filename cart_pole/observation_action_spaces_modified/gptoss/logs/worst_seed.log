                action = 1          # push left
        ENDIF
ELSE IF a < 0 THEN
        # pole leans left
        IF w < 0 THEN               # rotating left → reinforce
                action = 1          # push left
        ELSE                        # rotating right → damp
                action = 2          # push right
        ENDIF
