        if cart_velocity > 0:
            return 1  # push left
        else:
            return 2  # push right

    # 5. Fine‑tune when everything is small
    else:
        if pole_angle != 0:
            if pole_angle > 0:
                return 2  # push right
            else:
                return 1  # push left
        else:
            return 1  # default left

    # default random action if no rule matched (fallback)
    return random.randint(1, 2)
