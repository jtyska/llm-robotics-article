import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    x = cart_position
    v = cart_velocity
    theta = pole_angle
    omega = pole_angular_velocity
    action = None
    if abs(theta) >= 3:
        action = 2 if theta > 0 else 1
    elif abs(omega) >= 2:
        action = 2 if omega > 0 else 1
    elif abs(x) >= 18:
        action = 1 if x > 0 else 2
    elif abs(v) >= 2:
        action = 1 if v > 0 else 2
    else:
        action = 2 if theta > 0 else 1
    if action is None:
        action = random.randint(1, 2)
    return action
