import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if abs(pole_angular_velocity) > 10:
        return 1 if pole_angular_velocity < 0 else 2
    elif abs(pole_angle) >= 5:
        return 1 if pole_angle < 0 else 2
    elif cart_position > 15:
        return 1
    elif cart_position < -15:
        return 2
    elif cart_position > 10 and cart_velocity > 0:
        return 1
    elif cart_position < -10 and cart_velocity < 0:
        return 2
    elif abs(cart_position) >= 5:
        return 1 if cart_position > 0 else 2
    else:
        return random.randint(1, 2)

