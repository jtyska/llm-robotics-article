import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if cart_position >= 25:
        return 1
    elif cart_position <= -25:
        return 2
    else:
        if pole_angular_velocity > 10 or pole_angle < -3:
            return 2
        elif pole_angular_velocity < -10 or pole_angle > 3:
            return 1
        else:
            return 2
    return random.randint(1, 2)

