import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if -5 <= pole_angle <= 5:
        if pole_angle > 0:
            return 1
        elif pole_angle < 0:
            return 2
    elif -15 <= pole_angle <= 15:
        if (pole_angle > 0 and pole_angular_velocity > 0) or (pole_angle < 0 and pole_angular_velocity < 0):
            if pole_angle > 0:
                return 2
            else:
                return 1
        elif (pole_angle > 0 and pole_angular_velocity < 0) or (pole_angle < 0 and pole_angular_velocity > 0):
            if pole_angle > 0:
                return 1
            else:
                return 2
    elif pole_angle > 15:
        return 1
    elif pole_angle < -15:
        return 2
    return random.randint(1, 2)

