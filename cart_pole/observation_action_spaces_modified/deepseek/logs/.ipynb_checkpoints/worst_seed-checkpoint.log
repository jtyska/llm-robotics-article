import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if cart_position > 25:
        return 1
    elif cart_position < -25:
        return 2
    else:
        if pole_angle > 10 and pole_angular_velocity > 0:
            return 1
        elif pole_angle < -10 and pole_angular_velocity < 0:
            return 2
        elif (pole_angle > 0 and pole_angular_velocity > 0) or (pole_angle < 0 and pole_angular_velocity < 0):
            if pole_angle > 0:
                return 1
            else:
                return 2
        elif pole_angle > 0:
            return 1
        else:
            return 2
    return random.randint(1, 2)

