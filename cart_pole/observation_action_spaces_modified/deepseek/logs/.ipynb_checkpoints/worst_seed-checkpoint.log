def balance(pole_angle, pole_velocity, cart_position):
    if (pole_angle < -15 and pole_velocity < 0) or (pole_angle > 15 and pole_velocity > 20):
        return "move left"
    elif pole_angle > 5:
        return "move right"
    elif pole_angle < -5:
        return "move left"
    
