import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if cart_position >= 20:
        action = 1
    elif cart_position <= -20:
        action = 2
    elif pole_angle > 0 and pole_angular_velocity > 0:
        action = 2
    elif pole_angle < 0 and pole_angular_velocity < 0:
        action = 1
    else:
        if pole_angle > 0:
            action = 2
        else:
            action = 1
    return action

# Default random action
if __name__ == "__main__":
    print(get_action(random.randint(-50, 50), random.randint(-50, 50), random.randint(-50, 50), random.randint(-50, 50)))

