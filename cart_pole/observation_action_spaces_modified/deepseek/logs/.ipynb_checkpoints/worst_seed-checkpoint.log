import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if cart_position >= 17:
        action = 1
    elif cart_position < 3:
        action = 2
    elif (pole_angle < 0 and pole_angular_velocity < 0):
        action = 1
    elif (pole_angle > 0 and pole_angular_velocity > 0):
        action = 2
    elif pole_angle < 0 or pole_angular_velocity < 0:
        action = 1
    elif pole_angle > 0 or pole_angular_velocity > 0:
        action = 2
    else:
        action = random.randint(1, 2)
    return action

