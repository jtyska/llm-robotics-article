    elif abs(pole_angle) > 3:
        return 1 if pole_angle < -2 else 2
    elif abs(cart_position) > 5:
        return 1 if cart_position > 0 else 2
    else:
        return 1 if cart_velocity > 0 else 2
    return random.randint(1, 2)

