def get_action(cart_pos, cart_vel, pole_ang, pole_ang_vel):
    # Proportional control constants
    Kp_cart = 1.0
    Kp_pole = 2.0

    # Calculate proportional forces
    force_cart = Kp_cart * cart_pos
    force_pole = Kp_pole * pole_ang

    # Combine forces to determine the final action
    total_force = force_cart + force_pole

    # Apply thresholds for smooth control
    if total_force > 0:
