    elif cart_vel < -10 and abs(pole_ang) < 15:
        action = 1 if cart_pos < 0 else 2
    else:
        action = 2 if cart_pos < 0 else 1

    # Fine-tuning for high velocities to prevent overshooting
    if abs(cart_vel) > 12 and abs(pole_ang) < 5:
        action = 2 if cart_pos < 0 else 1

    return action
```

