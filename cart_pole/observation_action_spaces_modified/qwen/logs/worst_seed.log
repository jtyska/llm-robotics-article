def balance_pole(cart_pos, cart_vel, pole_ang, pole_vel):
    # Handle large pole angles first
    if abs(pole_ang) > 15:
        return 1 if pole_ang < 0 else 2
    
    # Handle significant cart velocities
    if abs(cart_vel) > 10:
        return 1 if cart_vel > 0 else 2
    
    # Handle significant pole velocities with conditions
    if abs(pole_vel) > 7:
        if pole_ang < 0 and pole_vel < -5:
            return 1
        elif pole_ang >= 0 and pole_vel > 5:
            return 2
        else:
            return 1 if cart_vel > 0 else 2
    
    # Handle large cart positions
    if abs(cart_pos) > 10:
        return 1 if cart_pos > 0 else 2
    
    # Handle moderate pole angles
    if abs(pole_ang) > 8:
        return 1 if pole_ang < -3 else 2
    
    # Handle moderate cart velocities
    if abs(cart_vel) > 5:
        return 1 if cart_vel > 0 else 2
    
    # Handle small pole angles
    if abs(pole_ang) > 3:
        return 1 if pole_ang < -2 else 2
    
    # Default action
    return 1 if cart_vel > 0 else 2
```

