def choose_action(cart_pos, cart_vel, pole_ang, pole_vel):
    # Handle critical pole angles
    if abs(pole_ang) >= 23:
        return 1 if pole_ang < 0 else 2

    # Handle high pole velocities
    if abs(pole_vel) > 25:
        return 1 if pole_ang < 0 else 2

    # Handle high cart velocities
    if abs(cart_vel) > 15:
        return 1 if cart_vel > 0 else 2

    # Fine-tune for small deviations
    if -10 <= cart_pos <= 10 and -5 <= cart_vel <= 5:
        if abs(pole_ang) > 5:
            return 1 if pole_ang < 0 else 2
        else:
            return 2 if cart_pos < 0 else 1

    # Fine-tune for moderate deviations
    if -20 <= cart_pos <= 20 and -10 <= cart_vel <= 10:
        if abs(pole_ang) > 5 or abs(cart_vel) > 5:
            return 1 if pole_ang < 0 else 2
        else:
            return 2 if cart_pos < 0 else 1

    # Handle high cart velocities with moderate pole angles
    if cart_vel > 10 and abs(pole_ang) < 15:
        return 2 if cart_pos < 0 else 1

    if cart_vel < -10 and abs(pole_ang) < 15:
        return 1 if cart_pos < 0 else 2

    # Default action for other cases
    if abs(cart_vel) > 5 and abs(pole_ang) > 3:
        return 1 if pole_ang < 0 else 2
    else:
        return 2 if cart_pos < 0 else 1

    # Additional fine-tuning for high pole velocities
    if abs(pole_vel) > 15 and abs(pole_ang) > 10:
        return 1 if pole_ang < 0 else 2

    # Final default action
    return 2 if cart_pos < 0 else 1
```

