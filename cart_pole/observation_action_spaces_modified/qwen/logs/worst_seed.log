def determine_action(cart_pos, cart_vel, pole_ang, pole_ang_vel):
    # Critical angle and velocity thresholds
    critical_angle = 23
    critical_velocity = 18
    
    # Action for critical angles
    if abs(pole_ang) >= critical_angle:
        return 1 if pole_ang < 0 else 2
    
    # Action for high angular velocities
    if abs(pole_ang_vel) > critical_velocity:
        return 1 if pole_ang < 0 else 2
    
    # Action for extreme cart positions
    if abs(cart_pos) > 2.4 or abs(cart_vel) > 15:
        return 1 if cart_pos < 0 else 2
    
    # Action for moderate angles and velocities
    if -15 <= cart_pos <= 15 and -10 <= cart_vel <= 10:
        if abs(pole_ang) > 7 or abs(cart_vel) > 8:
            return 1 if pole_ang < 0 else 2
        else:
            return 2 if cart_pos < 0 else 1
    
    # Default action for stable conditions
    return 2 if cart_pos < 0 else 1
```

### Explanation of the New Strategy

