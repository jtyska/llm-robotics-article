def determine_action(cart_pos, cart_vel, pole_ang, pole_vel):
    # Correct extreme pole angles
    if abs(pole_ang) >= 23:
        return 1 if pole_ang < 0 else 2

    # Correct high pole velocities
    elif abs(pole_vel) > 20:
        return 1 if pole_ang < 0 else 2

    # Reduce cart velocity when it's too high
    elif abs(cart_vel) > 15:
        return 1 if cart_vel > 0 else 2

    # Balance cart position and velocity within safe ranges
    elif -10 <= cart_pos <= 10 and -5 <= cart_vel <= 5:
        if abs(pole_ang) > 5:
            return 1 if pole_ang < 0 else 2
        else:
            return 2 if cart_pos < 0 else 1

    # Balance larger ranges for position and velocity
    elif -20 <= cart_pos <= 20 and -10 <= cart_vel <= 10:
        if abs(pole_ang) > 5 or abs(cart_vel) > 5:
            return 1 if pole_ang < 0 else 2
        else:
            return 2 if cart_pos < 0 else 1

    # Default action to balance the pole
    else:
        return 2 if cart_pos < 0 else 1

    # Additional velocity correction for moderate speeds
    if 10 <= abs(cart_vel) < 15 and abs(pole_ang) < 15:
        return 2 if cart_pos < 0 else 1

    if -15 <= abs(cart_vel) < -10 and abs(pole_ang) < 15:
        return 1 if cart_pos > 0 else 2
