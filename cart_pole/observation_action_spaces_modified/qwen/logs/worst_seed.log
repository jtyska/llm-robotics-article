def choose_action(cart_pos, cart_vel, pole_ang):
    if abs(pole_ang) > 10:
        action = 1 if pole_ang < 0 else 2
    elif abs(cart_vel) > 15:
        action = 1 if cart_vel > 0 else 2
    elif abs(pole_ang) > 5 and abs(cart_pos) < 20:
        action = 1 if pole_ang < 0 else 2
    elif abs(cart_pos) > 15:
        action = 1 if cart_pos > 0 else 2
    elif (cart_vel > 0 and cart_pos > 0) or (cart_vel < 0 and cart_pos < 0):
        action = 1 if cart_pos > 0 else 2
    else:
        action = 2 if pole_ang < 0 else 1
    return action
```

