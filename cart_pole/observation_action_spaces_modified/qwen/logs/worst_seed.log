import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if abs(pole_angle) > 15:
        action = 1 if pole_angle < 0 else 2
    elif abs(cart_velocity) > 30:
        action = 1 if cart_velocity > 0 else 2
    elif abs(pole_angular_velocity) > 18:
        if pole_angle < 0:
            action = 1 if pole_angular_velocity < -15 else 2
        else:
            action = 2 if pole_angular_velocity > 15 else 1
    elif abs(cart_position) > 20:
        action = 1 if cart_position > 0 else 2
    elif abs(pole_angle) > 7:
        action = 1 if pole_angle < -7 else 2
    elif abs(cart_position) > 9:
        action = 1 if cart_position > 0 else 2
    else:
        action = 1 if cart_velocity > 0 else 2
    return action if action is not None else random.randint(1, 2)

