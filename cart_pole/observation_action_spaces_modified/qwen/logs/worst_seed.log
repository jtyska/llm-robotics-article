def balance_pole(cart_pos, cart_vel, pole_ang, pole_vel):
    # Large pole angle correction
    if abs(pole_ang) > 15:
        return 1 if pole_ang < 0 else 2
    
    # Cart position correction
    if abs(cart_pos) > 2.4:
        return 1 if cart_pos < 0 else 2
    
    # Pole velocity correction for smaller deviations
    if abs(pole_vel) > 5:
        return 1 if pole_vel < 0 else 2
    
    # Cart velocity correction
    if abs(cart_vel) > 5:
        return 1 if cart_vel < 0 else 2
    
    # Smaller angle and velocity corrections
    if abs(pole_ang) > 3 or abs(pole_vel) > 2:
        return 1 if pole_ang < -3 or pole_vel < -2 else 2
    
    # Small adjustments based on cart velocity
    if cart_vel > 0.5:
        return 2
    elif cart_vel < -0.5:
        return 1
    
    # Default action
    return 1

