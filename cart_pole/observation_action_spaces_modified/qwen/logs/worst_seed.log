import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if abs(pole_angular_velocity) > 20 and pole_angle > 0:
        return 1
    elif abs(pole_angular_velocity) > 20 and pole_angle < 0:
        return 2
    elif 10 < abs(pole_angular_velocity) <= 20 and pole_angle > 5:
        return 1
    elif 10 < abs(pole_angular_velocity) <= 20 and pole_angle < -5:
        return 2
    elif 5 < abs(pole_angular_velocity) <= 10 and pole_angle > 3:
        return 1
    elif 5 < abs(pole_angular_velocity) <= 10 and pole_angle < -3:
        return 2
    elif abs(pole_angular_velocity) <= 5 and pole_angle > 0 and cart_position > 3:
        return 1
    elif abs(pole_angular_velocity) <= 5 and pole_angle > 0 and cart_position <= 3:
        return 2
    elif abs(pole_angular_velocity) <= 5 and pole_angle < 0 and cart_position < -3:
        return 2
    elif abs(pole_angular_velocity) <= 5 and pole_angle < 0 and cart_position >= -3:
        return 1
    elif abs(cart_position) > 10 and cart_position > 0:
        return 1
    elif abs(cart_position) > 10 and cart_position < 0:
        return 2
    else:
        return random.randint(1, 2)

