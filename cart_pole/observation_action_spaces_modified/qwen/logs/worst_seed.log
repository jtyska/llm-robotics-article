def updated_strategy(cart_pos, cart_vel, pole_ang, pole_ang_vel):
    # High angular velocity correction
    if abs(pole_ang_vel) > 25:
        return 1 if pole_ang < 0 else 2

    # Pole angle near critical point
    if abs(pole_ang) >= 23:
        return 1 if pole_ang < 0 else 2

    # High cart velocity correction
    if abs(cart_vel) > 15:
        return 1 if cart_vel > 0 else 2

    # Balance within a small range of cart position and low velocities
    if -10 <= cart_pos <= 10 and -5 <= cart_vel <= 5:
        if abs(pole_ang) > 5:
            return 1 if pole_ang < 0 else 2
        else:
            return 2 if cart_pos < 0 else 1

    # Balance within a moderate range of cart position and velocities
    if -20 <= cart_pos <= 20 and -10 <= cart_vel <= 10:
        if abs(pole_ang) > 5 or abs(cart_vel) > 5:
            return 1 if pole_ang < 0 else 2
        else:
            return 2 if cart_pos < 0 else 1

    # Handle high cart velocities with moderate pole angles
    if cart_vel > 10 and abs(pole_ang) < 15:
        return 2 if cart_pos < 0 else 1

    if cart_vel < -10 and abs(pole_ang) < 15:
        return 1 if cart_pos < 0 else 2

    # Default case
    if abs(cart_vel) > 5 and abs(pole_ang) > 3:
        return 1 if pole_ang < 0 else 2
    else:
        return 2 if cart_pos < 0 else 1
```

