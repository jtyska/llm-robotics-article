def update_action(cart_pos, cart_vel, pole_ang, pole_ang_vel):
    if abs(pole_ang) >= 23:
        action = 1 if pole_ang < 0 else 2
    elif abs(pole_ang_vel) > 25:
        action = 1 if pole_ang < 0 else 2
    elif abs(cart_vel) > 18:
