def choose_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    # Strong corrections for high angular velocities
    if abs(pole_angular_velocity) > 25:
        if pole_angle < 0:
            action = 1
        else:
            action = 2
    # Fine-tuning based on angle and velocity
    elif -5 <= cart_position <= 5 and -10 <= cart_velocity <= 10:
        if abs(pole_angle) > 10 or abs(pole_angular_velocity) > 15:
            if pole_angle < 0:
                action = 1
            else:
                action = 2
        else:
            if cart_position < 0:
                action = 2
            else:
                action = 1
    # Balancing for moderate angles and velocities
    elif -20 <= cart_position <= 20 and -20 <= cart_velocity <= 20:
        if abs(pole_angle) > 5 or abs(pole_angular_velocity) > 10:
            if pole_angle < 0:
                action = 1
            else:
                action = 2
        else:
            if cart_position < 0:
                action = 2
            else:
                action = 1
    # Default action for extreme positions or velocities
    else:
        if cart_position < -15:
            action = 2
        elif cart_position > 15:
            action = 1
        else:
            if pole_angle < 0:
                action = 1
            else:
                action = 2
    
    return action
```

