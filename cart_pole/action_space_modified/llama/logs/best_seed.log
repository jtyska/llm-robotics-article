        return 2
    elif cart_position * pole_angle > 0.05 and abs(cart_position) < abs(pole_angle) and pole_angle < 0:
        return 1
    elif cart_position * pole_angle > 0.05 and abs(cart_position) < abs(pole_angle) and pole_angle > 0:
        return 2
    elif abs(pole_angle) > 0.1 and pole_angle < 0:
        return 1
    elif abs(pole_angle) > 0.1 and pole_angle > 0:
        return 2
    else:
        return random.randint(1, 2)

