    elif pole_angle > 0 and pole_angular_velocity > 0.1 and cart_velocity >= 0:
        return 2
    elif pole_angle < 0 and pole_angular_velocity < -0.1 and cart_velocity > 0:
        return 2
    elif pole_angle < 0 and pole_angular_velocity < -0.1 and cart_velocity <= 0:
        return 1
    elif cart_position > 0.5 and pole_angle > 0:
        return 1
    elif cart_position < -0.5 and pole_angle < 0:
