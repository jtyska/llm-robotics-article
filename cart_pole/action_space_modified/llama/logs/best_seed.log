import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if abs(cart_position) > 2:
        if cart_position > 0:
            return 1
        else:
            return 2
    elif pole_angle * pole_angular_velocity > 0 and abs(pole_angle) > 0.05:
        if pole_angle > 0:
            return 1
        else:
            return 2
    elif cart_position * pole_angle > 0.05 or abs(pole_angle) > 0.1:
        if cart_position > 0 and pole_angle > 0:
            return 1
        elif cart_position < 0 and pole_angle < 0:
            return 2
    else:
        if pole_angle > 0:
            return 1
        elif pole_angle < 0:
            return 2
    return random.randint(1, 2)

