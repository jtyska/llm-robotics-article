import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if pole_angle > 0 and cart_position >= 0 and pole_angular_velocity > 0:
        return 1
    elif pole_angle < 0 and cart_position <= 0 and pole_angular_velocity < 0:
        return 1
    elif pole_angular_velocity > 0.5 and cart_position < 0:
        return 2
    elif pole_angular_velocity < -0.5 and cart_position > 0:
        return 2
    elif abs(pole_angular_velocity) > 0.5 and pole_angle > 0:
        return 1
    elif abs(pole_angular_velocity) > 0.5 and pole_angle < 0:
        return 1
    elif cart_position > 2 and pole_angle != 0:
        return 1
    elif cart_position < -2 and pole_angle != 0:
        return 2
    elif pole_angle > 0 and abs(cart_position) < 1:
        return 1
    elif pole_angle < 0 and abs(cart_position) < 1:
        return 1
    elif cart_velocity > 1 and pole_angle > 0:
        return 1
    elif cart_velocity < -1 and pole_angle < 0:
        return 2
    else:
        return 2 if random.randint(1, 10) > 5 else random.randint(1, 2)

