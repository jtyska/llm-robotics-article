import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if cart_position > 2:
        return 1
    elif cart_position < -2:
        return 1
    elif pole_angle > 0.1045 and cart_position > 0:
        return 1
    elif pole_angle < -0.1045 and cart_position < 0:
        return 2
    elif abs(pole_angular_velocity) > 0.5 and pole_angle < 0:
        return 1
    elif abs(pole_angular_velocity) > 0.5 and pole_angle > 0:
        return 2
    elif abs(pole_angle) < 0.1045 and pole_angle > 0:
        return 2
    elif abs(pole_angle) < 0.1045 and pole_angle < 0:
        return 1
    else:
        return random.randint(1, 2)

