    elif abs(pole_angle) > 0.1:
        if pole_angle > 0:
            return 1
        else:
            return 2
    else:
        if cart_position * pole_angle > 0:
            if cart_position > 0 and pole_angle > 0:
                return 1
            elif cart_position < 0 and pole_angle < 0:
                return 2
        elif cart_position * pole_angle < 0:
            if cart_position > 0 and pole_angle < 0:
                return 2
            elif cart_position < 0 and pole_angle > 0:
                return 1
    return random.randint(1, 2)

