import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if abs(cart_position) > 2:
        return 1 if cart_position < 0 else 2
    elif pole_angle * pole_angular_velocity > 0 and abs(pole_angle) > 0.02:
        return 2 if pole_angle > 0 else 1
    elif cart_position * pole_angle > 0 and abs(cart_position) > 0.5:
        return 1 if cart_position > 0 else 2
    elif pole_angular_velocity < 0:
        return 2
    else:
        return 1 if pole_angular_velocity >= 0 else random.randint(1, 2)
    return random.randint(1, 2)

