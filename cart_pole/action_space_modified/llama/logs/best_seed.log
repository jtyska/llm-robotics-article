    elif pole_angle < 0 and (pole_angular_velocity <= 0.1 and pole_angular_velocity >= -0.1) or pole_angular_velocity > 0:
        if cart_position > 0:
            return 1
        else:
            return 2
    else:
        return random.randint(1, 2)

