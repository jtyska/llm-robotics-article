import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if abs(cart_position) > 2 and cart_position < 0:
        return 1
    elif abs(cart_position) > 2 and cart_position > 0:
        return 2
    elif pole_angle * pole_angular_velocity > 0 and pole_angle < 0:
        return 1
    elif pole_angle * pole_angular_velocity > 0 and pole_angle > 0:
        return 2
    elif cart_position * pole_angle > 0 and abs(cart_position) > abs(pole_angle):
        if cart_position > 0:
            return 2
        else:
            return 1
    elif cart_velocity < 0 and pole_angular_velocity < 0:
        return 1
    elif cart_velocity > 0 and pole_angular_velocity > 0:
        return 2
    elif abs(pole_angle) > 0.2095 or abs(cart_position) > 2.4:
        return None
    elif pole_angle < 0:
        return 1
    elif pole_angle > 0:
        return 2
    else:
        return random.randint(1, 2)

