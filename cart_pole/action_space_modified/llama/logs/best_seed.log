        return 2
    elif pole_angular_velocity > 0 and abs(pole_angle) < 0.2095:
        return 2
    elif pole_angular_velocity < 0 and abs(pole_angle) < 0.2095:
        return 1
    else:
        return random.randint(1, 2)

