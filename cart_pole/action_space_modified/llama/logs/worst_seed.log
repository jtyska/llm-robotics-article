def decide_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if abs(pole_angle) < 0.05:  # Near upright position, slight correction based on angle and velocity
        if pole_angle > 0:
            return 2  # Move right slightly to correct
        else:
            return 1  # Move left slightly to correct
    elif pole_angle > 0:  # Pole is leaning right
        if pole_angular_velocity > 0:  # And it's falling faster to the right
            return 2  # Apply force to the right to counteract
        else:
            return 1  # Apply force to the left, considering velocity
    elif pole_angle < 0:  # Pole is leaning left
        if pole_angular_velocity < 0:  # And it's falling faster to the left
            return 1  # Apply force to the left to counteract
        else:
            return 2  # Apply force to the right, considering velocity

    # Consider cart position and adjust accordingly
    if cart_position > 2.0:
        return 1  # Move towards center if too far right
    elif cart_position < -2.0:
        return 2  # Move towards center if too far left

# Example usage with last state before termination in the provided trial
