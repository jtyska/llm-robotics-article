import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if cart_position > 0 and pole_angle > 0:
        return 2
    elif cart_position > 0 and pole_angle < 0:
        return 1
    elif cart_position < 0 and pole_angle > 0:
        return 1
    elif cart_position < 0 and pole_angle < 0:
        return 2

    if pole_angular_velocity > 0 and pole_angle > 0:
        return 2
    elif pole_angular_velocity > 0 and pole_angle < 0:
        return 1
    elif pole_angular_velocity < 0 and pole_angle > 0:
        return 1
    elif pole_angular_velocity < 0 and pole_angle < 0:
        return 2

    if cart_position > 2 and pole_angle > 0:
        return 2
    elif cart_position > 2 and pole_angle < 0:
        return 2
    elif cart_position < -2 and pole_angle > 0:
        return 1
    elif cart_position < -2 and pole_angle < 0:
        return 1

    if abs(pole_angle) < 0.1 and abs(cart_position) < 1:
        if pole_angular_velocity > 0:
            return 2
        else:
            return 1

    return random.randint(1, 2)

