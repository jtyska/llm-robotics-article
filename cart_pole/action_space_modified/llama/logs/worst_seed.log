    if pole_angle > 0 and pole_angular_velocity > 0:
        return 2
    elif pole_angle < 0 and pole_angular_velocity < 0:
        return 1
    elif pole_angle > 0 and pole_angular_velocity < 0:
        if abs(pole_angle) > 0.1 or abs(pole_angular_velocity) > 0.1:
            return 2 if random.random() < 0.7 else 1
        else:
            return 2 if random.random() < 0.3 else 1
    elif pole_angle < 0 and pole_angular_velocity > 0:
        if abs(pole_angle) > 0.1 or abs(pole_angular_velocity) > 0.1:
            return 1 if random.random() < 0.7 else 2
        else:
            return 1 if random.random() < 0.3 else 2
    elif cart_position < -1.5 or cart_position > 1.5:
        if cart_position < 0:
            return 2
        else:
            return 1
    elif abs(pole_angle) <= 0.1 and abs(pole_angular_velocity) <= 0.1:
        return 2 if random.random() < 0.5 else 1
    return random.randint(1, 2)

