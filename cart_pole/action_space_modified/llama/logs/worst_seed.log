            return 1
        elif cart_velocity > 0.5:
            return 2
    elif -0.05 <= pole_angle < 0:
        return 2 if random.random() < 0.7 else 1
    elif 0 < pole_angle <= 0.05:
        return 1 if random.random() < 0.7 else 2
    elif -0.2095 <= pole_angle < -0.05 or 0.05 < pole_angle <= 0.2095:
        if cart_position < -1.8 or cart_position > 1.8:
            if cart_velocity < -0.5:
                return 1
            elif cart_velocity > 0.5:
                return 2
        else:
            if pole_angle < 0:
                return 2 if random.random() < 0.7 else 1
            elif pole_angle > 0:
                return 1 if random.random() < 0.7 else 2
    return random.randint(1, 2)

