import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if pole_angle > 0.2095:
        return 1
    elif pole_angle < -0.2095:
        return 2
    elif cart_position > 2.4:
        return 1
    elif cart_position < -2.4:
        return 2
    elif pole_angular_velocity > 0 and pole_angle > 0:
        return 1
    elif pole_angular_velocity < 0 and pole_angle < 0:
        return 1
    elif pole_angular_velocity > 0 and pole_angle < 0:
        return 2
    elif pole_angular_velocity < 0 and pole_angle > 0:
        return 2
    elif cart_position > 1.5 and pole_angle > 0:
        return 1
    elif cart_position > 1.5 and pole_angle < 0:
        return 2
    elif cart_position < -1.5 and pole_angle > 0:
        return 2
    elif cart_position < -1.5 and pole_angle < 0:
        return 1
    elif abs(pole_angle) < 0.1:
        return 2 if cart_position > 0 else 1
    elif pole_angular_velocity > 0.5:
        return 2 if pole_angle < 0 else 1
    elif pole_angular_velocity < -0.5:
        return 1 if pole_angle < 0 else 2
    elif abs(pole_angle) > 0.1 and abs(pole_angle) < 0.2095:
        if cart_position > 0 and pole_angle > 0:
            return 2 if random.random() < 0.7 else 1
        elif cart_position > 0 and pole_angle < 0:
            return 1 if random.random() < 0.7 else 2
        elif cart_position < 0 and pole_angle > 0:
            return 1 if random.random() < 0.7 else 2
        else:
            return 2 if random.random() < 0.7 else 1
    elif abs(pole_angular_velocity) > 1:
        if pole_angle < 0:
            return 1 if random.random() < 0.9 else 2
        else:
            return 2 if random.random() < 0.9 else 1
    else:
        return random.randint(1, 2)

