import random
def get_action(cart_position, cart_velocity, pole_angle,pole_angular_velocity):
    if pole_angle < 0 and pole_angular_velocity < 0:
        return 1 if random.random() < 0.8 else 2
    elif pole_angle < 0 and pole_angular_velocity > 0:
        return 2 if random.random() < 0.8 else 1
    elif pole_angle > 0 and pole_angular_velocity < 0:
        return 2 if random.random() < 0.8 else 1
    elif pole_angle > 0 and pole_angular_velocity > 0:
        return 1 if random.random() < 0.8 else 2
    elif abs(pole_angle) < 0.1 and abs(pole_angular_velocity) < 0.5:
        return 1 if random.random() < 0.6 else 2
    elif abs(pole_angular_velocity) > 1:
        action = 1 if pole_angle < 0 else 2
        return action if random.random() < 0.9 else (2 if action == 1 else 1)
    return random.randint(1, 2)

