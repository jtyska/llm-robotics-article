    elif pole_angle * pole_angular_velocity < 0 and abs(pole_angle) > 0.1745:
        return 2 if random.random() < 0.8 else 1
    elif pole_angle * pole_angular_velocity < 0 and abs(pole_angle) <= 0.1745:
        return 1 if random.random() < 0.5 else 2
    else:
        return 1 if random.random() < 0.5 else 2

