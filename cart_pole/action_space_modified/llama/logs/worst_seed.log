    elif cart_position > 1.5 and pole_angle > 0:
        return 1
    elif abs(pole_angle) <= 0.1 and pole_angular_velocity > 0:
        return 2
    elif abs(pole_angle) <= 0.1 and pole_angular_velocity < 0:
        return 1
    else:
        return random.randint(1, 2)

