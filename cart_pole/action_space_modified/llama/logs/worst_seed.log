    elif pole_angle < 0 and pole_angular_velocity > 0:
        return 2 if random.random() < 0.7 else 1
    elif -0.5 < cart_position < 0.5 and -0.1 < pole_angle < 0.1:
        return 2 if cart_velocity > 0 else 1
    else:
        return random.randint(1, 2)

