    if pole_angle > 0.04:
        return 2
    elif pole_angle < -0.04:
        return 1
    elif pole_angular_velocity > 1.5:
        return 2
    elif pole_angular_velocity < -1.5:
        return 1
    elif cart_position < -2.0 and cart_velocity < 0:
        return 2
    elif cart_position > 2.0 and cart_velocity > 0:
        return 1
    elif cart_position > 0:
        return 1
    else:
        return 2
    return random.randint(1, 2)

