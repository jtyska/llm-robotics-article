        return 2
    elif pole_angle < -0.04:
        return 1
    elif pole_angular_velocity > 1.5:
        return 2
    elif pole_angular_velocity < -1.5:
        return 1
    elif cart_position > 0.2:
        return 1
    elif cart_position < -0.2:
        return 2
    else:
        return 1
    return random.randint(1, 2)

