import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if cart_position > 2.0:
        return 1
    elif cart_position < -2.0:
        return 2
    elif pole_angle < -0.1 and pole_angular_velocity < 0:
        return 1
    elif pole_angle > 0.1 and pole_angular_velocity > 0:
        return 2
    elif -0.1 <= pole_angle <= 0.1:
        if pole_angular_velocity < -0.5:
            return 1
        elif pole_angular_velocity > 0.5:
            return 2
    return random.randint(1, 2)

