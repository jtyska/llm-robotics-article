import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if cart_position < -2.0:
        action = 2
    elif cart_position > 2.0:
        action = 1
    elif pole_angle > 0 and pole_angular_velocity > 0:
        action = 1
    elif pole_angle > 0:
        action = 2
    elif pole_angle < 0 and pole_angular_velocity > 0:
        action = 2
    else:
        action = 1
    return action if action in [1, 2] else random.randint(1, 2)

