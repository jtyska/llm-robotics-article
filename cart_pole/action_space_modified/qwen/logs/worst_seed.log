import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if pole_angle > 0.2:
        return 2
    elif pole_angle < -0.2:
        return 1
    elif cart_position > 2.0:
        return 1
    elif cart_position < -2.0:
        return 2
    elif pole_angular_velocity > 1.0:
        if pole_angle > 0:
            return 1
        else:
            return 2
    elif pole_angular_velocity < -1.0:
        if pole_angle > 0:
            return 2
        else:
            return 1
    elif pole_angle > 0:
        return 2
    else:
        return 1
    return random.randint(1, 2)

