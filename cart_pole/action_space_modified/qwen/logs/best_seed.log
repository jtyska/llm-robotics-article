    elif pole_angle > 0.1:
        return 1
    elif cart_position < -1.5 and pole_angle > -0.2:
        return 2
    elif cart_position > 1.5 and pole_angle < 0.2:
        return 1
    elif cart_velocity < -1.0 and pole_angle > -0.2:
