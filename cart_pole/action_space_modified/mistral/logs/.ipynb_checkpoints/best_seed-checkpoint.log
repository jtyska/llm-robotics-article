def keep_pole_balanced(cart_position, cart_velocity, pole_angle, angular_velocity):
    # Dynamic threshold for pole angle based on angular velocity
    dynamic_pole_angle_threshold = 0.1 + abs(angular_velocity) * 0.2

    # Check if the pole angle exceeds the dynamic threshold
    if abs(pole_angle) > dynamic_pole_angle_threshold:
        return 2 if pole_angle > 0 else 1

    # Check for high angular velocities and corrective actions
    if abs(angular_velocity) > 3:
        if (pole_angle > 0 and cart_velocity < 0) or (pole_angle < 0 and cart_velocity > 0):
            return 2 if angular_velocity > 0 else 1

    # Check for high cart velocities and corrective actions
    if abs(cart_velocity) > 3:
        return 1 if cart_velocity > 0 else 2

    # Integral error consideration with a higher threshold
    integral_error = sum([pole_angle, angular_velocity])
    if integral_error > 0.5:
        return 2
    elif integral_error < -0.5:
        return 1

    # Additional check for extreme conditions
    if abs(cart_velocity) > 3 or abs(angular_velocity) > 1:
        return 2 if cart_velocity + angular_velocity > 0 else 1

    # Default action when no specific condition is met
    return 0
```

