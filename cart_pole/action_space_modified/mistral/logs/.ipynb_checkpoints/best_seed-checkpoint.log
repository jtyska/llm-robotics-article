def enhanced_strategy(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    # Dynamic threshold for pole angle based on current state
    dynamic_threshold = 0.05 + abs(pole_angular_velocity) * 0.1

    if abs(pole_angle) > dynamic_threshold:
        return 2 if pole_angle > 0 else 1

    if abs(pole_angular_velocity) > 2:
