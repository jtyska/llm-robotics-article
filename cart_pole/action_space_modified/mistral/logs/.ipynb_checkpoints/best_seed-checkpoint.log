def balance_pole(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if not (-2.4 < cart_position < 2.4):
        return None
    if not (-0.5 < pole_angle < 0.5):
        return None

    force = 0

    # Pole angle correction with dynamic force
    if pole_angle > 0:
        force = -1 * (abs(pole_angle) * 10 + cart_velocity * 5)
    else:
        force = 1 * (abs(pole_angle) * 10 + cart_velocity * 5)

    # Cart velocity management
    if cart_velocity > 0.5:
        force -= abs(cart_velocity) * 2
    elif cart_velocity < -0.5:
        force += abs(cart_velocity) * 2

    # Fine-tuning for stability
    if abs(pole_angle) < 0.1 and abs(cart_velocity) < 0.3:
        force = 0

    # Combining rules from previous strategy
    if pole_angle > 0.1 or pole_angle < -0.1:
        if cart_velocity > 0.5:
            force -= abs(cart_velocity) * 3
        elif cart_velocity < -0.5:
            force += abs(cart_velocity) * 3

    return force
```

This hybrid approach combines the simplicity of the current strategy with refined rules from the previous strategy, aiming to improve stability and balance duration.
