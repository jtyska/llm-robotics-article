    elif pole_angle > 0.1:
        return 1
    elif cart_position < -1.5:
        return 2
    elif cart_position > 1.5:
        return 1
    elif cart_velocity < -0.3 and pole_angle < 0:
        return 2
    elif cart_velocity > 0.3 and pole_angle > 0:
        return 1
    else:
        return random.randint(1, 2)

