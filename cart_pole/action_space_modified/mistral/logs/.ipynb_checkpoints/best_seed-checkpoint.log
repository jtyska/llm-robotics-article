def adaptive_pi_control(state):
    cart_position, cart_velocity, pole_angle, pole_angular_velocity = state

    # Dynamic thresholds for pole angle and angular velocity
    dynamic_pole_angle_threshold = 0.1 + abs(cart_velocity) * 0.2
    dynamic_pole_angular_velocity_threshold = 1.5 + abs(cart_velocity) * 0.3

    # Integral error calculation
    integral_error = sum([pole_angle, pole_angular_velocity])

    if abs(pole_angle) > dynamic_pole_angle_threshold:
        return 2 if pole_angle > 0 else 1

    if abs(pole_angular_velocity) > dynamic_pole_angular_velocity_threshold:
        if (pole_angle > 0 and cart_velocity < 0) or (pole_angle < 0 and cart_velocity > 0):
            return 2 if pole_angular_velocity > 0 else 1

    if abs(cart_velocity) > 3:
        return 1 if cart_velocity > 0 else 2

    if integral_error > 0.5:
        return 2
    elif integral_error < -0.5:
        return 1

    if abs(cart_velocity) > 3 or abs(pole_angular_velocity) > 1:
        return 2 if cart_velocity + pole_angular_velocity > 0 else 1

    return 0
```

