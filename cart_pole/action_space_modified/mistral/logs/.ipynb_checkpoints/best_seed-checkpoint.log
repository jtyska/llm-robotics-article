            return 2 if pole_angular_velocity > 0 else 1

    if abs(cart_velocity) > velocity_threshold:
        return 1 if cart_velocity > 0 else 2

    # Integral error for long-term stability
    integral_error = sum([pole_angle, pole_angular_velocity])
    if integral_error > 0.5:
        return 2
    elif integral_error < -0.5:
        return 1

    # Combined velocity and angular velocity consideration for stability
    combined_velocity = cart_velocity + pole_angular_velocity
    if abs(combined_velocity) > 3 or abs(pole_angular_velocity) > 2:
        return 2 if combined_velocity > 0 else 1

    # Default action to maintain balance
    return 0
```

