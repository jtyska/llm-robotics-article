    def __init__(self):
        self.integral_error = 0
        self.previous_pole_angle = 0

    def get_action(self, cart_pos, cart_vel, pole_ang, pole_ang_vel):
        # Constants for PI control
        Kp = 1.0  # Proportional gain
        Ki = 0.5  # Integral gain

        # Calculate the error
        error = pole_ang

        # Update integral error
        self.integral_error += error

        # PI control calculation
        control_action = Kp * error + Ki * self.integral_error

        # Dynamic thresholds based on cart velocity and pole angle
        if abs(cart_vel) > 1.0:
            control_action *= -1  # Reverse action to counteract high velocity

        if abs(pole_ang) > 0.2:
            control_action *= 2  # Increase action for large angles

        # Boundary conditions to prevent cart from drifting too far
        if cart_pos < -1.5 or cart_pos > 1.5:
            control_action = -control_action  # Reverse action to bring cart back to center

        # Determine the final action (left or right)
        if control_action > 0:
            return 'right'
        else:
            return 'left'

