def improved_strategy(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    # Ensure the cart stays within bounds
    if not (-2.4 < cart_position < 2.4):
        return 1 if cart_position > 0 else 2

    # Adjust actions based on pole angle with more nuanced thresholds
    if abs(pole_angle) > 0.1:
        return 2 if pole_angle > 0 else 1

    # Consider angular velocity in combination with cart velocity for better stability
    if pole_angular_velocity > 0:
        if pole_angle > 0 and cart_velocity < 0:
            return 2
        elif pole_angle < 0 and cart_velocity > 0:
            return 1
    else:
        if pole_angle > 0 and cart_velocity > 0:
            return 1
        elif pole_angle < 0 and cart_velocity < 0:
            return 2

    # Default action based on cart velocity
    return 1 if cart_velocity > 0 else 2
```

