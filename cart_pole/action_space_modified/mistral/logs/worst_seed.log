    elif cart_velocity > 0.3:
        return 1

    if (cart_position < -0.4 and cart_velocity < -0.2) or (pole_angular_velocity < -0.5 and pole_angle < -0.1):
        return 2
    elif (cart_position > 0.4 and cart_velocity > 0.2) or (pole_angular_velocity > 0.5 and pole_angle > 0.1):
        return 1

    return random.randint(1, 2)

