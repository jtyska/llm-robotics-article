    elif cart_velocity > 0.5:
        return 1

    if -0.05 <= pole_angle <= 0.05 and -0.3 <= pole_angular_velocity <= 0.3:
        if cart_velocity < 0:
            return 2
        elif cart_velocity > 0:
            return 1

    return random.randint(1, 2)

