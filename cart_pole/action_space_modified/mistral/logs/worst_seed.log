import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if pole_angle > 0.1:
        return 1
    elif pole_angle < -0.1:
        return 2

    if cart_position < -0.8:
        return 2
    elif cart_position > 0.8:
        return 1

    if pole_angular_velocity < -0.5 and pole_angle < 0:
