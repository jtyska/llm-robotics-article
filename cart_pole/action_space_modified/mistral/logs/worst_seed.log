    elif pole_angular_velocity > 0.4 and pole_angle > 0.3:
        return 1
    if cart_velocity < -1.5:
        return 2
    elif cart_velocity > 1.5:
        return 1
    if -0.1 <= pole_angle <= 0.1 and -1 <= cart_position <= 1:
        if cart_velocity > 0:
            return 1
        else:
            return 2
    return random.randint(1, 2)

