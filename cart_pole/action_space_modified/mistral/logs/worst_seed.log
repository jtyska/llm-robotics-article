import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if pole_angle < 0 and cart_position > -2:
        return 2
    elif pole_angle > 0 and cart_position < 2:
        return 1

    if pole_angular_velocity < 0 and cart_velocity > -0.5:
        return 2
    elif pole_angular_velocity > 0 and cart_velocity < 0.5:
        return 1

    if cart_position < -1:
        return 2
    elif cart_position > 1:
        return 1

    if cart_velocity < -0.5 and cart_position < -0.5:
        return 2
    elif cart_velocity > 0.5 and cart_position > 0.5:
        return 1

    if pole_angle < 0 and pole_angular_velocity < 0:
        return 2
    elif pole_angle > 0 and pole_angular_velocity > 0:
        return 1

    if cart_position < -1 or (cart_position < 0 and cart_velocity < -0.5):
        return 2
    elif cart_position > 1 or (cart_position > 0 and cart_velocity > 0.5):
        return 1

    if pole_angle < 0 and cart_position > 0:
        return 2
    elif pole_angle > 0 and cart_position < 0:
