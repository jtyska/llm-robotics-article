import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    if pole_angle < -0.1 or (pole_angular_velocity < -0.5 and pole_angle < 0):
        return 2
    elif pole_angle > 0.1 or (pole_angular_velocity > 0.5 and pole_angle > 0):
        return 1

    if cart_position < -0.8:
        return 2
    elif cart_position > 0.8:
        return 1

    if cart_velocity < -0.5:
        return 2
    elif cart_velocity > 0.5:
        return 1

    if pole_angle < -0.05 and cart_position < -0.4:
        return 2
    elif pole_angle > 0.05 and cart_position > 0.4:
        return 1

    if pole_angular_velocity < -0.3 and cart_velocity < -0.3:
        return 2
    elif pole_angular_velocity > 0.3 and cart_velocity > 0.3:
        return 1

    return random.randint(1, 2)

