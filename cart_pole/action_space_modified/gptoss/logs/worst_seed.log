# constants (tuned from the experiments)
C_THRESHOLD = 0.012          # when pole dynamics dominate
X_RIGHT_LIMIT =  2.0         # safe distance from the right wall
X_LEFT_LIMIT  = -2.0         # safe distance from the left wall

