import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    lean = pole_angle + 0.9 * pole_angular_velocity
    action = None

    if abs(lean) > 0.013:
        if lean > 0:
            action = 2  # push right
        else:
            action = 1  # push left
    else:
        if cart_position > 0.05:
            action = 1  # push left
        elif cart_position < -0.05:
            action = 2  # push right
        elif abs(cart_velocity) > 0.1:
            if cart_velocity > 0:
                action = 1  # oppose positive velocity
            else:
                action = 2  # oppose negative velocity
        else:
            action = 2  # deterministic default (right)

    if action is None:
        action = random.randint(1, 2)

    return action
