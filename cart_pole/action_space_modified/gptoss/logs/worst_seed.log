# --------------------------------------------------------------
# Cart‑Pole balancing rule set (discrete actions: 1 = left, 2 = right)
# --------------------------------------------------------------

# 1. Compute a single “control variable” that mixes angle and angular velocity
c = theta + 0.9 * theta_dot          # theta  in radians, theta_dot in rad/s

# 2. Primary pole‑stabilisation branch
if c >  0.012:          # pole tilting clockwise (positive angle)
        action = 2     # push cart to the right
elif c < -0.012:        # pole tilting counter‑clockwise
        action = 1     # push cart to the left
else:
