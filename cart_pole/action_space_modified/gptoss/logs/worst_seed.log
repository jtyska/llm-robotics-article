// (optional fine‑tune)
# k = 0.85; epsilon = 0.011

// ---------- policy ----------
e = theta + k * omega               // pole error term

IF |e| > epsilon THEN
    // pole is noticeably tilted – correct it
    IF e > 0 THEN   action = 2      // push right
    ELSE            action = 1      // push left
