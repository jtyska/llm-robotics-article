# Parameters
K_ANGLE   = 0.9
THETA_T   = 0.013          # angle‑error threshold
POS_T     = 0.06           # dead‑zone for cart position
VEL_T     = 0.02           # velocity dead‑zone for tie‑break

function decide_action(x, v, theta, omega):
    # 1) Angle control
    A = theta + K_ANGLE * omega
    if abs(A) > THETA_T:
