THETA_OMEGA_T = 0.013
POS_T = 0.02

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    theta_omega = pole_angle + K_ANGLE_VEL * pole_angular_velocity
    if abs(theta_omega) > THETA_OMEGA_T:
        if theta_omega > 0:
            return 2  # right
        else:
