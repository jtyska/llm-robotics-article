import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    K_omega = 0.9
    THETA_DEAD = 0.013
    X_DEAD = 0.05

    e = pole_angle + K_omega * pole_angular_velocity

    if abs(e) > THETA_DEAD:
        if e > 0:
            return 2  # push right
        else:
            return 1  # push left
    else:
        if cart_position > X_DEAD:
            return 1  # cart too far right → push left
        elif cart_position < -X_DEAD:
            return 2  # cart too far left → push right
        else:
            if cart_position >= 0:
                return 2  # centered, nudge right
            else:
                return 1  # centered, nudge left

    return random.randint(1, 2)
