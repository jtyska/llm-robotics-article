            return 2  # push right
        else:
            return 1  # push left
    else:
        if x > 0.05:
            return 1  # cart too far right → push left
        elif x < -0.05:
            return 2  # cart too far left → push right
        else:
            if v > 0.02:
                return 1  # moving right → push left
            elif v < -0.02:
                return 2  # moving left → push right
            else:
                return 2  # default deterministic tie‑break (push right)
    return random.randint(1, 2)
