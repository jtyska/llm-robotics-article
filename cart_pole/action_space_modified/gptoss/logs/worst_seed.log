            action = previous_action != null ? previous_action : 2
        }

        // optional velocity damping
        if (abs(x_dot) > VEL_MAX) {
            if (x_dot > 0) action = 1   // slow down rightward drift
            else           action = 2   // slow down leftward drift
        }
    }
}
```

