# 1. Compute pole‑lean signal
s = θ + 0.9 * θ̇               # θ in rad, θ̇ in rad/s
τ = 0.013

# 2. Strong correction when the pole is tilting
IF |s| > τ THEN
        IF s > 0      → action = 2   # pole leans right → push right
        ELSE          → action = 1   # pole leans left  → push left

