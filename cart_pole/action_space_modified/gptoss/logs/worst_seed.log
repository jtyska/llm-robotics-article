import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    k = 0.9
    epsilon = 0.013
    x_dead = 0.05

    e = pole_angle + k * pole_angular_velocity

    if abs(e) > epsilon:
        if e > 0:
            return 2  # push right
        else:
            return 1  # push left
    else:
        if cart_position > x_dead:
            return 1  # push left
        elif cart_position < -x_dead:
            return 2  # push right
        else:
            return random.choice([1, 2])

    # default fallback (should not be reached)
    return random.randint(1, 2)
