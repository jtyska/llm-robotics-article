def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    import random
    action = None
    if cart_position > 2.0:
        action = 1
    elif cart_position < -2.0:
        action = 2
    else:
        combo = pole_angle + 0.9 * pole_angular_velocity
        if abs(combo) > 0.012:
            if combo > 0:
                action = 2
            else:
                action = 1
        else:
            if cart_position > 0:
                action = 1
            else:
                action = 2
    if action is None:
        action = random.randint(1, 2)
    return action
