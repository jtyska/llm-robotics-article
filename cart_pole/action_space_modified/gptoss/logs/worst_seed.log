import random

def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    theta = pole_angle
    omega = pole_angular_velocity
    if abs(theta + 0.9 * omega) > 0.013:
        if (theta + 0.9 * omega) > 0:
            return 2  # push right
        else:
            return 1  # push left
    else:
        if cart_position > 0.05:
            return 1  # push left
        elif cart_position < -0.05:
            return 2  # push right
        else:
            return 2  # deterministic tie‑break (push right)
    # fallback (should not be reached)
    return random.randint(1, 2)
