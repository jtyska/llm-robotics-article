            return 2
        else:
            return 1
    else:
        if abs(x + 0.1 * v) > 0.015:
            if (x + 0.1 * v) > 0:
                return 1
            else:
                return 2
        else:
            if random.random() < 0.5:
                return 1
            else:
                return 2
    return random.randint(1, 2)
