def get_action(cart_position, cart_velocity, pole_angle, pole_angular_velocity):
    import random
    theta = pole_angle
    theta_dot = pole_angular_velocity
    expr = theta + 0.9 * theta_dot
    if abs(expr) > 0.013:
        if expr > 0:
            return 2  # push right
        else:
            return 1  # push left
    else:
        x = cart_position
        if x > 0.05:
            return 1  # cart too far right → push left
        elif x < -0.05:
            return 2  # cart too far left → push right
        else:
            if x > 0:
                return 1  # slight right offset → push left
            elif x < 0:
                return 2  # slight left offset → push right
            else:
                return 1 if random.random() < 0.5 else 2  # tie break randomly
    return random.randint(1, 2)
