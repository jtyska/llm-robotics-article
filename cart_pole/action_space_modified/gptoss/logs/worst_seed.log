          abs(theta_dot) <= 0.02 and
          abs(-0.5 * x - 0.2 * x_dot) > 0.05):
        action = 2 if (-0.5 * x - 0.2 * x_dot) > 0 else 1
    else:
        action = 2

    if action is None:
        return random.randint(1, 2)
    return action
