def cartpole_policy(state):
    x, xdot, theta, omega = state

    # ----- 1️⃣ Pole‑error correction -----
    e = theta + 0.9 * omega                # combined angle‑velocity error
    if abs(e) > 0.013:                     # pole is tilting enough to need correction
        return 2 if e > 0 else 1           # push opposite to the sign of the error

    # ----- 2️⃣ Cart‑centering (pole already vertical) -----
    # dead‑zone of ±0.07 m, with a tiny velocity bias
    if x > 0.07:
        return 1                           # push left
    elif x < -0.07:
        return 2                           # push right
    else:
        # optional velocity‑bias (uncomment if needed)
        # if abs(xdot) > 0.02:
        #     return 1 if xdot > 0 else 2
        return 2                           # deterministic tie‑break (push right)
```

