    elif p < 0.35:
        d = (p - 0.20) / 0.15
        a = 0.20 * (1.0 - d**2)
    else:
        a = 0.0
    if a is None:
        a = random.uniform(-1.0, 1.0)
    a = max(-1.0, min(1.0, a))
