def get_action(car_position, car_velocity):
    import random
    p = car_position
    v = car_velocity
    a = None
    if p >= 0.45:
        a = 0.0
    elif v < 0.0 and p <= -0.20:
        a = -1.0
    elif v >= 0.0 and p <= -0.20:
