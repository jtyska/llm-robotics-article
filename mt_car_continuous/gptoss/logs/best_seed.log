def get_action(car_position, car_velocity):
    import random
    if car_position >= 0.45:
        return 0.0
    elif car_position <= -0.20 and car_velocity < 0:
        return -0.45
    elif car_position <= -0.20 and car_velocity >= 0:
        return 0.70
    else:
        base = 0.55 * (0.45 - car_position) / 0.65
        action = base * max(0.0, 1 - 0.8 * car_velocity)
        if action > 1.0:
