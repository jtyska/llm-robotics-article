import random

def get_action(car_position, car_velocity):
    action = None

    if car_position >= 0.45:
        action = 0.0
    else:
        dist = 0.45 - car_position
        base = 0.62 * (dist / (0.45 + 0.25))

        if car_velocity <= 0:
            vel_factor = 1.0
        else:
            vel_factor = max(0.0, 1.0 - 0.80 * car_velocity)

        if dist <= 0.12:
            taper = (dist / 0.12) ** 2
        else:
            taper = 1.0

        action = base * vel_factor * taper

        projected_pos = car_position + car_velocity

        if projected_pos > 0.44 and car_velocity > 0.015:
            excess = car_velocity - 0.015
            brake = -min(0.20, 0.5 * excess)
            action = action + brake

        if action > 1.0:
            action = 1.0
        elif action < -1.0:
            action = -1.0

    if action is None:
        return random.uniform(-1, 1)
    return action
