def get_action(car_position, car_velocity):
    import random
    action = None
    if car_position >= 0.45:
        action = 0.0
    else:
        raw = 1.20 * (0.45 - car_position) - 0.80 * car_velocity
        if raw > 0.6:
            action = 0.6
        elif raw < -0.6:
            action = -0.6
        else:
            action = raw
    if action is not None:
        if action > 1.0:
            action = 1.0
        elif action < -1.0:
            action = -1.0
        return action
    return random.uniform(-1, 1)
