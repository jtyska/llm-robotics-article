import random

def get_action(car_position, car_velocity):
    action = None

    if car_position >= 0.45:
        action = 0.0
    elif car_position <= -0.40:
        if car_velocity < 0:
            action = -0.45
        else:
            action = 0.70
    elif car_position <= -0.20:
        if car_velocity < 0:
            action = -0.30
        else:
            action = 0.65
    else:
        dist = 0.45 - car_position
        base = 0.60 * (dist / (0.45 + 0.20))
        vel_damp = max(0.0, 1.0 - 0.80 * car_velocity)
        if dist <= 0.10:
            taper = (dist / 0.10) ** 2
        else:
            taper = 1.0
        action = base * vel_damp * taper

    if action is not None and car_position > 0.40 and car_velocity > 0.03:
        action = min(action, 0.0)

    if action is not None:
        action = max(-1.0, min(1.0, action))
        return action

    return random.uniform(-1.0, 1.0)
