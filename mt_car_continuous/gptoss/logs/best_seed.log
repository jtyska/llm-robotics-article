def get_action(car_position, car_velocity):
    import random
    action = None
    if car_position >= 0.45:
        action = 0.0
    elif car_position <= -0.20:
        action = 0.6
    else:
        dist = 0.45 - car_position
        base = 0.60 * (dist / 0.65)
        if dist <= 0.10:
            taper = (dist / 0.10) ** 2
        else:
            taper = 1.0
        action = base * taper
        if dist <= 0.02 and car_velocity < 0.01:
            action += max(0.0, 0.02 - car_velocity)
        action = max(-1.0, min(1.0, action))
    if action is None:
        return random.uniform(-1, 1)
    return action
