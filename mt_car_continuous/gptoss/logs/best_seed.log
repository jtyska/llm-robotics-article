import random

def get_action(car_position, car_velocity):
    position = car_position
    velocity = car_velocity

    # Rule 1: goal reached
    if position >= 0.45:
        action = 0.0
        return max(-1.0, min(1.0, action))

    # Rule 2: far left region
    if position <= -0.20:
        if velocity < 0:
            if position < -0.55:
                action = -0.45
            else:
                action = -0.30
        else:
            action = 0.60
        return max(-1.0, min(1.0, action))

    # Rule 3: middle region
    dist = 0.45 - position                     # distance to goal (positive)
    basePush = 0.60 * (dist / 0.65)            # linear decay
    velFactor = max(0.0, 1.0 - 0.80 * velocity) # velocity‑dependent damping

    if dist <= 0.10:
        taper = (dist / 0.10) ** 2            # quadratic soft‑landing
    else:
        taper = 1.0

    action = basePush * velFactor * taper

    if position > 0.35 and velocity > 0.02:
        excess = velocity - 0.02
        brake = - min(0.12, 5.0 * excess)      # tiny brake, capped
        action = action + brake

    action = max(-1.0, min(1.0, action))
    return action

    # Default random action (should never be reached)
    return random.uniform(-1.0, 1.0)
