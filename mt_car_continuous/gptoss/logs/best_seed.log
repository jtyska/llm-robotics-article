def get_action(car_position, car_velocity):
    import random
    if car_position >= 0.45:
        action = 0.0
        return max(-1.0, min(1.0, action))
    elif car_position <= -0.20:
        action = 0.60
        return max(-1.0, min(1.0, action))
    else:
        dist = 0.45 - car_position
        maxDist = 0.45 + 0.20
        base = 0.60 * (dist / maxDist)
        vel_factor = max(0.0, 1.0 - 0.8 * car_velocity)
        if dist <= 0.10:
            base = base * (dist / 0.10) ** 2
        action = base * vel_factor
        if dist <= 0.02 and car_velocity < 0.02:
            action = action + (0.02 - car_velocity)
        action = max(-1.0, min(1.0, action))
        return action
    return random.uniform(-1.0, 1.0)
