import random

def get_action(car_position, car_velocity):
    # Rule 1: goal reached
    if car_position >= 0.45:
        action = 0.0
    # Rule 2: far left side
    elif car_position <= -0.20:
        if car_velocity < 0:
            action = -0.45
        else:
            action = 0.70
    # Rule 3: left of center but not far left
    elif car_position < 0.0:
        action = 0.55
    # Rule 4: between center and goal
    elif 0.0 <= car_position < 0.45:
        distance = 0.45 - car_position
        speed_factor = max(0.0, 1.0 - 1.5 * car_velocity)
        action = (0.55 * distance / 0.45) * speed_factor
    else:
        # Fallback random action
        return random.uniform(-1, 1)
    
    # Clip to legal range
    action = max(-1.0, min(1.0, action))
    return action
