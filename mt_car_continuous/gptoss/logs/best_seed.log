import random

def get_action(car_position, car_velocity):
    # Rule: if goal reached, no thrust
    if car_position >= 0.45:
        action = 0.0
    else:
        dist = 0.45 - car_position  # distance to goal (>0)

        # quadratic taper near the goal
        if dist <= 0.18:
            taper = (dist / 0.18) ** 2
        else:
            taper = 1.0

        # base forward thrust, decreasing linearly with distance
        base = 0.62 * (dist / 0.65)  # 0.65 = 0.45 + 0.20

        # damp thrust when already moving forward
        vel_factor = max(0.0, 1.0 - 0.80 * car_velocity)

        # preliminary thrust
        action = base * vel_factor * taper

        # soft brake on the right‑hand slope
        if car_position > 0.35 and car_velocity > 0.02:
            action = min(action, -0.12)

    # clip to legal range
    if 'action' in locals():
        action = max(-1.0, min(1.0, action))
        return action

    # default random action if no rule applied
    return random.uniform(-1.0, 1.0)
