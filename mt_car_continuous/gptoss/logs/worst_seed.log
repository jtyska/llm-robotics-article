import random

def get_action(car_position, car_velocity):
    action = None

    if car_position >= 0.45:
        action = 0.0
    elif car_position < -0.30:
        action = 1.0
    else:
        dist = 0.45 - car_position          # remaining distance to goal (>0)
        vel_err = -car_velocity             # desired positive velocity

        if dist <= 0.05:
            kp = 2.0
            kv = 0.5
        elif dist <= 0.15:
            kp = 1.0
            kv = 0.3
        else:
            kp = 0.5
            kv = 0.1

        raw = kp * dist + kv * vel_err

        if raw > 1.0:
            action = 1.0
        elif raw < -1.0:
            action = -1.0
        else:
            action = raw

    if action is None:
        action = random.uniform(-1, 1)

    return action
