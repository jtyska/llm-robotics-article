import random

def get_action(car_position, car_velocity):
    # Rule: if goal reached
    if car_position >= 0.45:
        return 0.0

    # Rule: far left, push right
    if car_position < -0.4:
        return 1.0

    # Rule: moving left while on right side of valley
    if car_velocity < -0.001 and car_position > 0.0:
        return -1.0

    # Rule: moving left while still left of the peak but not too far left
    if car_velocity < -0.001 and car_position > -0.3:
        return -1.0

    # PD control fallback
    dist = 0.45 - car_position          # distance to goal (positive while left of goal)
    vel_err = -car_velocity             # desired velocity is positive

    if dist <= 0.05:
        kp = 2.0
        kv = 0.5
    elif dist <= 0.15:
        kp = 1.0
        kv = 0.3
    else:
        kp = 0.5
        kv = 0.1

    raw = kp * dist + kv * vel_err      # PD control output

    if raw > 1.0:
        return 1.0
    elif raw < -1.0:
        return -1.0
    else:
        return raw

    # Default random action (should never be reached)
    return random.uniform(-1.0, 1.0)
