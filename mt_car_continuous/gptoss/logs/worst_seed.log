def get_action(car_position, car_velocity):
    import random
    # Rule 1: goal reached with near-zero velocity
    if car_position >= 0.45 and abs(car_velocity) < 0.01:
        action = 0.0
    # Rule 2: far left, push right strongly
    elif car_position < -0.30:
        action = 1.0
    # Rule 3: moving left too fast while still left of a small threshold
    elif car_velocity < -0.001 and car_position < -0.05:
        action = -1.0
    else:
        dist = 0.45 - car_position               # distance to goal (positive left of goal)
        velErr = -car_velocity                    # desired velocity error

        # ----- gain interpolation -----
        if dist <= 0.03:
            t = dist / 0.03
            kp = (1 - t) * 3.5 + t * 2.0
            kv = (1 - t) * 1.0 + t * 0.5
        else:
            t = (dist - 0.03) / 0.04
            kp = (1 - t) * 2.0 + t * 0.5
            kv = (1 - t) * 0.5 + t * 0.1

        # ----- PD command -----
        raw = kp * dist + kv * velErr

        # ----- velocity‑dependent scaling -----
        scale = max(0.2, 1.0 - 0.5 * abs(car_velocity))
        raw = raw * scale

        # ----- saturation to [-1, 1] -----
        if raw > 1.0:
            action = 1.0
        elif raw < -1.0:
            action = -1.0
        else:
            action = raw

    # Default random action if for some reason action is not set
    if 'action' not in locals():
        action = random.uniform(-1, 1)
    return action
