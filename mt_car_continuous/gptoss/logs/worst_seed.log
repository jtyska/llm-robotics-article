    ELSE IF v < 0                # still sliding left → keep left thrust
        a = -0.8
    ELSE                         # sliding right – keep moderate right thrust
        a = 0.8
ELSE IF p < 0.2                  # left‑hand slope of the right hill
    IF v < 0.0                   # still going left → push right strongly
        a = 0.9
    ELSE                         # already moving right – give a modest push
        a = 0.4
ELSE IF p < 0.35                 # upper part of the right hill
    IF v < 0.02                  # speed still low → boost a little more
        a = 0.3
    ELSE                         # speed sufficient – coast
        a = 0.0
ELSE IF p < 0.45                 # just before the top
    a = -0.2                      # brake a bit so we don’t overshoot
ELSE
