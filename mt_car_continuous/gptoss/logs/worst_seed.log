import random

def get_action(car_position, car_velocity):
    # Rule: if position >= 0.45
    if car_position >= 0.45:
        action = 0.0
    # Rule: velocity > 0.001
    elif car_velocity > 0.001:
        if car_position >= 0.43:
            err_pos = 0.45 - car_position
            err_vel = 0.07 - car_velocity
            action = max(0.0, 50.0 * err_pos + 10.0 * err_vel)
        else:
            action = 1.0
    # Rule: velocity < -0.001
    elif car_velocity < -0.001:
        action = -1.0
    # Rule: velocity around zero, use position thresholds
    else:
        if car_position < -0.6:
            action = 0.9
        elif car_position < -0.2:
            action = 0.6
        elif car_position < 0.0:
            action = 0.3
        elif car_position < 0.2:
            action = 0.1
        else:
            action = 0.05

    # Clamp action to [-1.0, 1.0]
    if action > 1.0:
        action = 1.0
    if action < -1.0:
        action = -1.0

    # If for any reason action is undefined, fall back to random
    if action is None:
        action = random.uniform(-1, 1)

    return action
