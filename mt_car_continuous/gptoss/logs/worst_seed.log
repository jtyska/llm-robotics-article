import random

def get_action(car_position, car_velocity):
    # Rule 1: Goal reached
    if car_position >= 0.45:
        return 0.0
    # Rule 2: Far left side
    elif car_position < -0.30:
        return 1.0
    # Rule 3: Moving left too fast
    elif car_velocity < -0.001:
        return -1.0
    else:
        dist = 0.45 - car_position
        vel_err = -car_velocity

        if dist <= 0.02:
            kp, kv = 4.0, 2.0
        elif dist <= 0.05:
            kp, kv = 2.5, 1.0
        else:
            kp, kv = 0.8, 0.2

        raw = kp * dist + kv * vel_err
        scale = max(0.5, 1.0 - 0.5 * abs(car_velocity))
        raw *= scale

        if dist <= 0.015 and car_velocity > 0.02:
            return -0.3
        else:
            if raw > 1.0:
                return 1.0
            elif raw < -1.0:
                return -1.0
            else:
                return raw

    # Default random action if no rule applied
    return random.uniform(-1, 1)
