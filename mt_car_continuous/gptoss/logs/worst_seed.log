import random

def get_action(car_position, car_velocity):
    # Rule 1
    if car_position >= 0.45 and abs(car_velocity) < 0.01:
        return 0.0
    # Rule 2
    elif car_position < -0.30:
        return 1.0
    # Rule 3: left side of valley
    elif car_position < 0.0:
        dist = 0.45 - car_position          # positive distance to goal
        velErr = -car_velocity              # desired velocity = 0

        if dist > 0.25:
            t = (dist - 0.25) / 0.25
            kp = (1 - t) * 2.0 + t * 3.5
            kv = (1 - t) * 0.5 + t * 1.0
        else:
            kp = 2.0
            kv = 0.5

        raw = kp * dist + kv * velErr
        scale = max(0.3, 1.0 - 0.6 * abs(car_velocity))
        raw = raw * scale
        action = max(-1.0, min(1.0, raw))
        return action
    # Rule 4: right side of valley (position >= 0.0)
    else:
        dist = 0.45 - car_position
        velErr = -car_velocity

        if dist <= 0.02:
            kp = 3.0
            kv = 0.8
        elif dist <= 0.05:
            kp = 2.0
            kv = 0.5
        else:
            kp = 1.0
            kv = 0.3

        raw = kp * dist + kv * velErr

        if car_position > 0.35 and car_velocity > 0.02:
            brake = -min(0.4, 0.8 * car_velocity)   # negative thrust to brake
            raw = raw + brake

        scale = max(0.5, 1.0 - 0.4 * abs(car_velocity))
        raw = raw * scale
        action = max(-1.0, min(1.0, raw))
        return action

    # Default random action (should never be reached)
    return random.uniform(-1.0, 1.0)
