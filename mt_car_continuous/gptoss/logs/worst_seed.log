import random

def get_action(car_position, car_velocity):
    # Rule 1
    if car_position >= 0.45 and abs(car_velocity) < 0.02:
        return 0.0
    # Rule 2
    if car_velocity < -0.001:
        return 1.0
    # Rule 3
    if car_position < -0.30:
        return 1.0
    # Rule 4: PD controller
    dist = 0.45 - car_position          # > 0
    vel_err = -car_velocity             # target velocity ≈ 0

    if dist > 0.25:
        kp = 0.5
        kv = 0.1
    elif dist > 0.10:
        kp = 0.5 + (dist - 0.10) / (0.25 - 0.10) * (2.0 - 0.5)
        kv = 0.1 + (dist - 0.10) / (0.25 - 0.10) * (0.5 - 0.1)
    else:
        kp = 2.0 + (dist - 0.02) / (0.10 - 0.02) * (3.0 - 2.0)
        kv = 0.5 + (dist - 0.02) / (0.10 - 0.02) * (0.8 - 0.5)

    raw = kp * dist + kv * vel_err

    scale = max(0.5, 1.0 - 0.5 * abs(car_velocity))
    raw = raw * scale

    if dist < 0.02:
        raw = raw - 0.05 * car_velocity

    action = max(-1.0, min(1.0, raw))
    return action

    # Default random action (should not be reached)
    return random.uniform(-1.0, 1.0)
