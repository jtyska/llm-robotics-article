import random

def get_action(car_position, car_velocity):
    # Rule 1
    if car_position >= 0.45 and abs(car_velocity) < 0.02:
        return 0.0
    # Rule 2
    elif car_velocity < -0.001:
        return 1.0
    # Rule 3
    elif car_position < -0.30:
        return 1.0
    else:
        dist = 0.45 - car_position          # distance to goal (positive when left of goal)
        velErr = -car_velocity              # desired velocity is zero at the top

        # Gain scheduling based on distance
        if dist <= 0.02:
            kp, kv = 4.0, 1.5
        elif dist <= 0.05:
            kp, kv = 2.5, 0.9
        elif dist <= 0.10:
            kp, kv = 1.2, 0.4
        else:
            kp, kv = 0.6, 0.2

        # Basic PD command
        raw = kp * dist + kv * velErr

        # Scale down when already moving fast
        scale = max(0.5, 1.0 - 0.5 * abs(car_velocity))
        raw = raw * scale

        # Braking aid in the close‑in zone
        if dist <= 0.04 and car_velocity > 0.01:
            brake = -0.4 * car_velocity
            raw = raw + brake

        # Clip to admissible range
        if raw > 1.0:
            action = 1.0
        elif raw < -1.0:
            action = -1.0
        else:
            action = raw

        return action

    # Default random action if no rule matched (should not be reached)
    return random.uniform(-1.0, 1.0)
