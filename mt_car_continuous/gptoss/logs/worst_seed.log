import random

def get_action(car_position, car_velocity):
    # Rule 1: goal reached
    if car_position >= 0.45:
        return 0.0

    # Determine base acceleration
    if car_position < -0.6:
        base = 0.9
    elif car_position < -0.2:
        base = 0.6
    elif car_position < 0.0:
        base = 0.3
    elif car_position < 0.2:
        base = 0.2
    else:
        base = 0.1

    # Taper near the goal
    if car_position >= 0.43:
        taper = 1 - 50 * (car_position - 0.43)
        if taper < 0:
            taper = 0
        if base > taper:
            base = taper

    # Desired speed
    if car_position >= 0.43:
        desired_speed = 0.07 * (0.45 - car_position) / (0.45 - 0.43) + 0.02
    else:
        desired_speed = 0.04

    # Velocity control term
    vel_error = desired_speed - car_velocity
    vel_term = 1.5 * vel_error - 0.5 * car_velocity

    # Raw action
    raw_action = base + vel_term

    # Clamp to [-1, 1]
    if raw_action > 1:
        action = 1.0
    elif raw_action < -1:
        action = -1.0
    else:
        action = raw_action

    return action

    # Default random action (should never be reached)
    return random.uniform(-1, 1)
