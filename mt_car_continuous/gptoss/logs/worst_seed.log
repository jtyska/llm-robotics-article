def get_action(car_position, car_velocity):
    import random
    # Goal reached
    if car_position >= 0.45:
        return 0.0
    # Moving left
    if car_velocity < 0.0:
        return -1.0
    # Determine base thrust from position
    if car_position < -0.6:
        base = 0.9
    elif car_position < -0.2:
        base = 0.6
    elif car_position < 0.0:
        base = 0.3
    else:
        base = 1.0
    # Apply taper when close to goal
    if car_position >= 0.43:
        taper = 1 - 50 * (car_position - 0.43)
        if taper < 0:
            taper = 0
        if base > taper:
            base = taper
    # Light speed‑tracking correction
    desired_speed = 0.07 * (0.45 - car_position) / 0.02
    vel_error = desired_speed - car_velocity
    vel_term = 2.0 * vel_error
    raw_action = base + vel_term
    # Clip to allowed range
    if raw_action > 1.0:
        action = 1.0
    elif raw_action < -1.0:
        action = -1.0
    else:
        action = raw_action
    return action
    # Default random action (fallback)
    return random.uniform(-1, 1)
