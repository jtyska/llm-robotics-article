    ELSE
        action = 1.0
    ENDIF
ELSE IF velocity < 0.0 THEN
    # Still moving left → brake as hard as possible.
    action = -1.0
ELSE
    # Velocity ≈ 0 (car is stuck).  Use a position‑based “kick‑start”.
    IF position < -0.6 THEN
        action = 0.9
    ELSE IF position < -0.2 THEN
        action = 0.6
    ELSE IF position < 0.0 THEN
        action = 0.3
    ELSE
        action = 0.1          # very close to the bottom, only a tiny nudge needed
    ENDIF
ENDIF
```

