import random

def get_action(car_position, car_velocity):
    if car_position >= 0.45:
        return 0.0
    elif car_velocity < -0.001:
        return -1.0
    elif car_position < -0.3:
        return 1.0
    else:
        dist_to_goal = 0.45 - car_position
        if dist_to_goal <= 0.05:
            kp = 2.0
            kv = 0.5
        else:
            kp = 0.5
            kv = 0.1
        pos_err = 0.45 - car_position
        vel_err = -car_velocity
        raw_action = kp * pos_err + kv * vel_err
        if raw_action > 1.0:
            action = 1.0
        elif raw_action < -1.0:
            action = -1.0
        else:
            action = raw_action
        return action
    return random.uniform(-1, 1)
