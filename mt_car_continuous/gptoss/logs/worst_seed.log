import random

def get_action(car_position, car_velocity):
    # Rule 1
    if car_position >= 0.45 and abs(car_velocity) < 0.02:
        return 0.0
    # Rule 2
    elif car_position < -0.45:
        return 1.0
    # Rule 3
    elif car_velocity < -0.001 and car_position < -0.10:
        return -0.5
    else:
        dist = 0.45 - car_position          # positive while left of goal
        velErr = -car_velocity               # desire zero velocity at top

        if dist <= 0.02:
            kp, kv = 4.0, 1.5
        elif dist <= 0.05:
            kp, kv = 2.5, 0.9
        elif dist <= 0.10:
            kp, kv = 1.2, 0.4
        else:
            kp, kv = 0.6, 0.2

        raw = kp * dist + kv * velErr

        scale = max(0.5, 1.0 - 0.5 * abs(car_velocity))
        raw *= scale

        if dist <= 0.04 and car_velocity > 0.01:
            raw -= 0.5 * car_velocity

        if car_position > 0.30 and car_velocity > 0.0:
            raw -= 0.2

        if raw > 1.0:
            return 1.0
        elif raw < -1.0:
            return -1.0
        else:
            return raw

    # Default random action if no rule matched (should never reach here)
    return random.uniform(-1, 1)
