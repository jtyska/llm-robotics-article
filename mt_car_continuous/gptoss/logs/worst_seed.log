    IF position < -0.6 THEN
        a = 0.9                               # deep in the left valley
    ELSE IF position < -0.2 THEN
        a = 0.6                               # middle of the left slope
    ELSE IF position < 0.0 THEN
        a = 0.3                               # near the bottom
    ELSE
        a = 0.1                               # just left of the goal hill
    ENDIF
ENDIF
```

