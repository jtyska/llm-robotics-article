import random

def get_action(car_position, car_velocity):
    if car_position >= 0.45:
        return 0.0
    elif car_velocity < -0.001:
        return -1.0
    elif car_position < -0.30 or abs(car_velocity) < 0.05:
        return 1.0
    else:
        dist = 0.45 - car_position
        vel_err = -car_velocity
        if dist <= 0.05:
            kp = 2.0
            kv = 0.5
        else:
            kp = 0.5
            kv = 0.1
        raw = kp * dist + kv * vel_err
        if raw > 1.0:
            return 1.0
        elif raw < -1.0:
            return -1.0
        else:
            return raw
    return random.uniform(-1, 1)
