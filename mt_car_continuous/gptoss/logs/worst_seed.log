    // we linearly interpolate kp and kv between them
    IF dist <= 0.03 THEN
        // between (0.00,3.5,1.0) and (0.03,2.0,0.5)
        t   = dist / 0.03
        kp  = (1‑t)*3.5 + t*2.0
        kv  = (1‑t)*1.0 + t*0.5
    ELSE
        // between (0.03,2.0,0.5) and (0.07,0.5,0.1)
        t   = (dist‑0.03) / 0.04
        kp  = (1‑t)*2.0 + t*0.5
        kv  = (1‑t)*0.5 + t*0.1
    ENDIF

    // ---------- PD command ----------
    raw = kp * dist + kv * velErr

    // ---------- velocity‑dependent scaling ----------
    // when |v| is small we keep full power, when |v| grows we damp the command
    scale = max(0.2, 1.0 - 0.5*abs(velocity))
    raw   = raw * scale

    // ---------- saturation ----------
    IF raw >  1.0 THEN action =  1.0
    ELSEIF raw < -1.0 THEN action = -1.0
    ELSE               action = raw
    ENDIF
ENDIF
```

