import random

def get_action(car_position, car_velocity):
    action = None

    if car_position >= 0.45 and abs(car_velocity) < 0.01:
        action = 0.0

    elif car_position < -0.30:
        action = 1.0

    elif car_position < 0.0:
        # left half of the valley
        dist = 0.45 - car_position
        velErr = -car_velocity

        if dist > 0.25:
            kp = 2.5
            kv = 0.8
        elif dist > 0.10:
            kp = 1.8
            kv = 0.6
        else:
            kp = 1.0
            kv = 0.4

        raw = kp * dist + kv * velErr
        scale = max(0.5, 1.0 - 0.5 * abs(car_velocity))
        raw = raw * scale
        action = max(-1.0, min(1.0, raw))

    else:
        # right side of the valley (position >= 0.0)
        dist = 0.45 - car_position
        velErr = -car_velocity

        if dist <= 0.02:
            kp = 3.0
            kv = 0.9
        elif dist <= 0.05:
            kp = 2.0
            kv = 0.6
        else:
            kp = 1.0
            kv = 0.3

        raw = kp * dist + kv * velErr

        if car_position > 0.30 and car_velocity > 0.02:
            brake = -min(0.4, 0.8 * car_velocity)
            raw = raw + brake

        scale = max(0.5, 1.0 - 0.4 * abs(car_velocity))
        raw = raw * scale
        action = max(-1.0, min(1.0, raw))

    if action is None:
        return random.uniform(-1, 1)
    return action
