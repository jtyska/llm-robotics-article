### 2️⃣ New / Refined strategy (call it **MountainCar‑V2**)

```pseudo
// ------------------------------------------------------------
// 1. Goal reached
IF position >= 0.45 THEN
    action = 0.0
    RETURN

// 2. Strong backward braking – keep the car from sliding left
IF velocity < -0.001 THEN
    action = -1.0
    RETURN

// 3. Build momentum on the left side
//    (hard push until we have enough speed to climb the right hill)
IF position < -0.30 OR ABS(velocity) < 0.05 THEN
    // stay at max forward thrust while we are still low‑energy
    action = 1.0
    RETURN

// 4. Fine‑grained PD control for the final climb
//    Use a low‑gain PD so the action stays small (low penalty)
dist      = 0.45 - position            // > 0 while left of the goal
vel_err   = -velocity                  // we want a positive velocity

// gain schedule – only two zones are needed
IF dist <= 0.05 THEN
    kp = 2.0          // very close to the top – a bit more aggressive
    kv = 0.5
ELSE
    kp = 0.5          // far from the top – stay gentle
    kv = 0.1
END IF

raw = kp * dist + kv * vel_err

// clamp to the admissible action range
IF raw > 1.0 THEN
    action = 1.0
ELSE IF raw < -1.0 THEN
    action = -1.0
ELSE
    action = raw
END IF
```

