        else:
            return 0.30  # Further decrease force for fine-tuning
    elif position >= 0.4:
        if velocity < 0:
            return 0.20  # Reduce force as the cart is already far right
        else:
            return 0.10  # Minimal force to maintain balance
    else:
        return 0.0

    if abs(velocity) > 0.5:
        if position < -0.2:
            return 0.80  # Increase force for high velocity and far left position
        elif position > 0.2:
            return -0.80  # Decrease force for high velocity and far right position
