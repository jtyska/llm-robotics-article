def choose_action(car_position, car_velocity):
    if abs(car_position) > 0.3:
        if car_position < -0.3 and car_velocity > 0:
            return 1.0 + 0.2 * (car_velocity / 1.0)
        elif car_position > 0.3 and car_velocity < 0:
