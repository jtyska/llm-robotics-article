            if car_velocity > 0:
                return 0.5 + 0.3 * (car_velocity / 1.0)
            elif car_velocity < 0:
                return -0.5 - 0.3 * (car_velocity / 1.0)
        else:
            if car_position < -0.1 and car_velocity > 0:
                return 0.7 + 0.3 * (car_velocity / 1.0)
            elif car_position > 0.1 and car_velocity < 0:
                return -0.7 - 0.3 * (car_velocity / 1.0)
    if car_position < 0:
        return 0.2
    else:
        return -0.2
```

