    if abs(pole_angle) > 0.2:
        # If the pole angle is large, apply a strong action to correct it quickly
        return -1.0 if pole_angle < 0 else 1.0

    if car_position < -0.3 and car_velocity > 0:
        # If the cart is near the left edge and moving right, apply a moderate positive force
