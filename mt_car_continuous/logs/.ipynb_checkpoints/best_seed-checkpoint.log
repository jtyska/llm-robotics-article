def choose_action(car_position, car_velocity, max_velocity):
    if car_position < -0.5 and car_velocity < 0:
        action = 0.8  # Strong positive force to correct direction quickly
    elif car_position > 0.5 and car_velocity > 0:
        action = -0.8  # Strong negative force to correct direction quickly
