        action = 0.5 + 0.3 * (car_velocity / max_velocity)  # Maintain momentum towards the goal
    elif abs(car_position) < 0.1 and car_velocity > 0:
        action = 0.2 + 0.3 * (car_velocity / max_velocity)  # Keep stable and moving forward
    elif car_velocity > 0.5 and abs(car_position) > 0.1:
        action = 0.3 + 0.2 * (car_velocity / max_velocity)  # Control high velocity
    elif car_velocity < -0.5 and abs(car_position) > 0.1:
        action = -0.3 + 0.2 * (car_velocity / max_velocity)  # Control high negative velocity
    else:
        action = 0.1 + 0.1 * (car_velocity / max_velocity)  # Default moderate force
    
    return action
```

