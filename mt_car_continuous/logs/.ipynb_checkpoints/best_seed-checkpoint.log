    elif car_position > 0.3 and car_velocity < 0:
        # If the cart is near the right edge and moving left, apply a moderate negative force
        return -0.8

    if abs(car_position) < 0.1 and car_velocity > 0:
        # If the cart is near the center and moving right, apply a smaller positive force
        return 0.4 + 0.25 * (car_velocity / max_velocity)
    elif abs(car_position) < 0.1 and car_velocity < 0:
        # If the cart is near the center and moving left, apply a smaller negative force
        return -0.4 - 0.25 * (car_velocity / max_velocity)

    if car_velocity > 0.5 and abs(car_position) > 0.1:
        # If the cart has high positive velocity and is not near the center, apply a strong positive force
        return 0.6 + 0.3 * (car_velocity / max_velocity)
    elif car_velocity < -0.5 and abs(car_position) > 0.1:
