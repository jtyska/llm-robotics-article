    elif car_velocity < -0.5 and abs(car_position) > 0.1:
        action = -0.3 + 0.1 * (car_velocity / max_velocity)  # Reduced strength and proportionality
    else:
        action = 0.05 + 0.05 * (car_velocity / max_velocity)  # Reduced base force and proportionality
    return action
```

