import random

def get_action(car_position, car_velocity):
    max_velocity = 0.07 # Assuming a typical maximum velocity for this environment
    if car_position < -0.5 and car_velocity < 0:
        action = 1.0
    elif car_position > 0.5 and car_velocity > 0:
        action = -1.0
    elif car_position > 0 and car_velocity > 0:
        action = 0.6 + 0.3 * (car_velocity / max_velocity)
    elif abs(car_position) < 0.1 and car_velocity > 0:
        action = 0.4 + 0.25 * (car_velocity / max_velocity)
    elif car_velocity > 0.5 and abs(car_position) > 0.1:
        action = 0.5 + 0.2 * (car_velocity / max_velocity)
    elif car_velocity < -0.5 and abs(car_position) > 0.1:
        action = -0.5 + 0.2 * (car_velocity / max_velocity)
    elif car_position < -0.3 and car_velocity > 0:
        action = 0.8
    elif car_position > 0.3 and car_velocity < 0:
        action = -0.8
    else:
        action = 0.2 + 0.1 * (car_velocity / max_velocity)
    return action if -1 <= action <= 1 else random.uniform(-1, 1)

