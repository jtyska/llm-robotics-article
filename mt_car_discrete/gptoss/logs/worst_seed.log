import math, random

def get_action(car_position, car_velocity):
    # Constants
    GOAL_POS = 0.5
    GRAVITY = 0.0025
    EPS = 0.02
    BRAKE_EPS = 0.01
    WIGGLE_POS = -0.5
    WIGGLE_RAD = 0.03
    WIGGLE_VEL = 0.02

    # Helper
    def v_needed(p):
        delta_h = math.sin(3 * GOAL_POS) - math.sin(3 * p)
        if delta_h <= 0:
            return 0.0
        return math.sqrt(2 * GRAVITY * delta_h)

    # Decision rules
    if car_position >= GOAL_POS:
        return 1

    elif abs(car_position - WIGGLE_POS) < WIGGLE_RAD and abs(car_velocity) < WIGGLE_VEL:
        return 0

    elif car_position < 0:
        if car_velocity < 0:
            return 0
        else:
            v_req = v_needed(car_position)
            if car_velocity < v_req - EPS:
                return 2
            elif car_velocity > v_req + EPS:
                return 0
            else:
                return 1

    else:
        v_req = v_needed(car_position)

        if car_position > 0.45 and car_velocity > v_req + BRAKE_EPS:
            return 0
        elif car_velocity < v_req - EPS:
            return 2
        elif car_velocity > v_req + EPS:
            return 0
        else:
            return 1

    # Default random action
    return random.randint(0, 2)
