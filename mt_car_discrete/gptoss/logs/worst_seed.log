def get_action(car_position, car_velocity):
    import math, random
    def v_needed(pos):
        delta = math.sin(3*0.5) - math.sin(3*pos)
        if delta <= 0:
            return 0.0
        return math.sqrt(2 * 0.0025 * delta)
    if car_position >= 0.5:
        return 1
    elif car_position < -0.55:
        return 0
    elif car_position < 0:
        if car_velocity < -0.02:
            return 0
        elif abs(car_velocity) < 0.001:
            if v_needed(car_position) > 0:
                return 2
            else:
                return 0
        elif car_velocity < v_needed(car_position):
            return 2
        elif car_position > 0.45 and car_velocity > v_needed(car_position) + 0.02:
            return 0
        else:
            return 1
    else:
        if car_velocity < v_needed(car_position):
            return 2
        elif car_position > 0.45 and car_velocity > v_needed(car_position) + 0.02:
            return 0
        else:
            return 1
    return random.randint(0, 2)
