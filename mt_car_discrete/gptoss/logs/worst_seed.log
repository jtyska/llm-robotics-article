# --------------------------------------------------------------
#   MountainCar “Bang‑Bang’’ controller
#   0 = accelerate left   (push downhill to the left)
#   1 = no acceleration   (coast)
#   2 = accelerate right  (push uphill to the right)
# --------------------------------------------------------------

def choose_action(position, velocity):
    # 1️⃣  Goal reached – stay idle
    if position >= 0.5:
        return 1                       # we are done, no more thrust

    # 2️⃣  Very far left – we must build momentum by pushing left
    #    The classic optimal policy pushes left until x ≈ -0.55
    if position < -0.55:
        return 0                       # hard left thrust

    # 3️⃣  Still moving left (negative velocity) – keep pushing left
    #    This guarantees that we will eventually cross the bottom
    if velocity < 0.0:
        return 0                       # keep accelerating left

    # 4️⃣  We are on the right side of the valley (position > -0.2)
    #    and already have a decent positive speed.
    #    When we are close to the goal and fast enough, we can coast.
    if position > 0.3 and velocity > 0.04:
        return 1                       # coast – avoid overshooting

    # 5️⃣  Default case – push right.
    #    This covers:
    #       * the bottom region (‑0.55 ≤ x < -0.2) once we have positive speed
    #       * the middle region (‑0.2 ≤ x < 0.3) where we still need thrust
    return 2
```

