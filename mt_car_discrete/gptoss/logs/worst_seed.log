    # Good rightward momentum – push right to climb the hill.
    action = 2

ELSE IF velocity > 0               # small positive speed
    # We are already moving right but not fast enough to climb.
    # Keep accelerating right, but only after we have passed the valley bottom.
    IF position > -0.1
        action = 2
    ELSE
        # Still near the bottom – a tiny push is enough, otherwise we waste time.
        action = 1
    ENDIF

