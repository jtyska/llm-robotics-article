import math, random

def v_needed(pos):
    delta = math.sin(3*0.5) - math.sin(3*pos)
    if delta <= 0:
        return 0.0
    return math.sqrt(2 * 0.0025 * delta)

def get_action(car_position, car_velocity):
    # Rule: if goal reached
    if car_position >= 0.5:
        return 1

    # Position left of origin
    if car_position < 0:
        if car_position <= -0.55:
            return 0
        elif car_velocity < -0.02:
            return 0
        elif car_velocity < v_needed(car_position) - 0.02:
            return 2
        else:
            return 1

    # Position between 0 and 0.5
    if car_velocity < v_needed(car_position) - 0.02:
        return 2
    elif car_position > 0.45 and car_velocity > v_needed(car_position) + 0.015:
        return 0
    else:
        return 1

    # Default random action (should not be reached)
    return random.randint(0, 2)
