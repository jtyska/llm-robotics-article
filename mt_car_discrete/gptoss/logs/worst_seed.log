import math, random

def get_action(car_position, car_velocity):
    GOAL_POS = 0.5
    LEFT_LIMIT = -0.55
    LEFT_VEL_THR = -0.02
    V_TOL = 0.02
    BRAKE_EPS = 0.015
    GRAVITY = 0.0025

    def v_needed(pos):
        delta = math.sin(3 * GOAL_POS) - math.sin(3 * pos)
        if delta <= 0:
            return 0.0
        return math.sqrt(2 * GRAVITY * delta)

    action = None

    if car_position >= GOAL_POS:
        action = 1
    elif car_position < 0:
        if car_position > LEFT_LIMIT and car_velocity > LEFT_VEL_THR:
            action = 0
        else:
            if car_velocity < v_needed(car_position) - V_TOL:
                action = 2
            else:
                action = 1
    else:
        if car_velocity < v_needed(car_position) - V_TOL:
            action = 2
        elif car_position > 0.45 and car_velocity > v_needed(car_position) + BRAKE_EPS:
            action = 0
        else:
            action = 1

    if action is None:
        action = random.randint(0, 2)

    return action
