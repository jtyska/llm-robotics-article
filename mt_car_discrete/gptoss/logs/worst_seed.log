import math, random

GOAL_POS = 0.5
GRAVITY = 0.0025
LEFT_PUSH_POS = -0.55
LEFT_PUSH_VEL = -0.02
GOAL_ZONE = 0.45
HYST_HIGH = 0.015

def v_needed(pos):
    delta = math.sin(3 * GOAL_POS) - math.sin(3 * pos)
    if delta <= 0:
        return 0.0
    return math.sqrt(2 * GRAVITY * delta)

def get_action(car_position, car_velocity):
    if car_position >= GOAL_POS:
        return 1
    elif car_position < LEFT_PUSH_POS:
        return 0
    elif car_position < 0:
        if car_velocity < LEFT_PUSH_VEL:
            return 0
        elif car_velocity < v_needed(car_position):
            return 2
        elif car_position > GOAL_ZONE and car_velocity > v_needed(car_position) + HYST_HIGH:
            return 0
        else:
            return 1
    else:
        if car_velocity < v_needed(car_position):
            return 2
        elif car_position > GOAL_ZONE and car_velocity > v_needed(car_position) + HYST_HIGH:
            return 0
        else:
            return 1
    return random.randint(0, 2)
