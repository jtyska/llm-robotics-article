import math, random

def get_action(car_position, car_velocity):
    if car_position >= 0.5:
        return 1
    elif car_position <= -0.5 and abs(car_velocity) < 0.02:
        return 2
    else:
        v_req = math.sqrt(max(0, 2 * 0.0025 * (math.sin(3 * 0.5) - math.sin(3 * car_position))))
        if car_position < 0:
            if car_velocity < -0.03:
                return 0
            elif car_velocity < v_req - 0.01:
                return 2
            elif car_velocity > v_req + 0.01:
                return 0
            else:
                return 1
        else:  # 0 <= car_position < 0.5
            if car_velocity < v_req - 0.01:
                return 2
            elif car_velocity > v_req + 0.01:
                return 0
            else:
                return 1
    return random.randint(0, 2)
