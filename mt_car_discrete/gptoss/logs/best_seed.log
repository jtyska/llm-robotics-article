ELSE IF p < -0.55           THEN a = 0                 # far left – must keep accelerating left to gain energy
ELSE IF v > 0               THEN a = 2                 # positive speed on the flat centre → push right
ELSE IF v < 0               THEN a = 0                 # negative speed on the flat centre → push left
ELSE                         a = 1                     # default (should rarely be reached)
```

