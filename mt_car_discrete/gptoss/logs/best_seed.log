    #     make it over the hill without further thrust (empirically ≈ 0.04).
    #   * If we already have that speed we can coast; otherwise we accelerate right.
    v_right_min = 0.04
    if velocity > v_right_min:
        # enough speed → coast, let gravity do the rest
        return 1
    elif velocity > 0.0:
        # positive but not enough → give a little push
        return 2

    # ------------------------------------------------------------------
    # 5. Near the summit (position between 0.4 and 0.5) – gentle right thrust
    # ------------------------------------------------------------------
    #   * When we are already close to the goal we only need a tiny nudge.
    if position >= 0.40:
