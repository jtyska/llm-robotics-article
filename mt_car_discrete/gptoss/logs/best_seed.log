ELIF position >= 0.5 - 0.01                THEN action = 2   # extra right thrust right at the top
ELIF velocity > 0                           THEN action = 2
ELIF velocity < -0.1                        THEN action = 0   # strong left pump when moving fast left
ELIF position < -0.55 AND velocity < 0      THEN action = 0
