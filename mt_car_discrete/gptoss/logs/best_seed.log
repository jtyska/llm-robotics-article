ELIF position >= -0.2 AND velocity <= 0   → action = 2   # still accelerate right

# 3. Left‑hill region (position < -0.2)
   # 3a – we are still sliding left, need a stronger left push to climb the left hill
ELIF position < -0.55 AND velocity < -0.04 → action = 0   # push left harder
   # 3b – we have enough negative velocity, start pushing right to climb out
ELIF position < -0.55 AND velocity >= -0.04 → action = 2   # accelerate right
   # 3c – we are a bit right of the deepest point but still moving left
ELIF position >= -0.55 AND position < -0.2 AND velocity < 0 → action = 2   # turn right ASAP
   # 3d – otherwise (still left of centre, moving right) keep accelerating right
