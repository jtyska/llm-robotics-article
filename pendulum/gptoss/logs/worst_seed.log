import math, random

def get_action(cos_theta, sin_theta, angular_velocity):
    g = 9.81
    theta_switch = 0.25
    theta_dot_thr = 0.8
    kE = 1.5
    kP_bal = 8.0
    kD_bal = 2.0
    torque_max = 2.0

    theta = math.atan2(sin_theta, cos_theta)
    theta_dot = angular_velocity

    E = 0.5 * theta_dot**2 - g * cos_theta
    delta_E = E + g

    action = None
    if abs(theta) > theta_switch or abs(theta_dot) > theta_dot_thr:
        prod = delta_E * theta_dot
        if prod > 0:
            s = 1.0
        elif prod < 0:
            s = -1.0
        else:
            s = 0.0
        action = kE * s
    else:
        action = -kP_bal * theta - kD_bal * theta_dot

    if action is None:
        action = random.uniform(-2.0, 2.0)

    return max(-torque_max, min(action, torque_max))
