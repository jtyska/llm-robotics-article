import math, random

def get_action(cos_theta, sin_theta, angular_velocity):
    theta = math.atan2(sin_theta, cos_theta)
    theta_dot = angular_velocity

    E = 0.5 * theta_dot**2 - 9.81 * cos_theta
    E_up = -9.81
    delta_E = E_up - E

    if (abs(theta) > 0.4) or (abs(theta_dot) > 1.0) or (abs(delta_E) > 1.0):
