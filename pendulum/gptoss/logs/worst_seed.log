def get_action(cos_theta, sin_theta, angular_velocity):
    import math, random
    # Constants
    g = 9.81
    max_torque = 2.0
    k_e = 1.5
    k_bal_p = 10.0
    k_bal_d = 3.0
    theta_sw = 0.6
    omega_sw = 1.2
    blend_gain = 8.0
    scale_thr = 1.8

    # Observation unpacking
    theta = math.atan2(sin_theta, cos_theta)          # angle in [-π, π]
    omega = angular_velocity

    # Energy terms
    E_cur = 0.5 * omega**2 - g * cos_theta
    E_des = -g
    E_err = E_cur - E_des

    # Swing‑up torque
    if omega > 0:
        sign_omega = 1.0
    elif omega < 0:
        sign_omega = -1.0
    else:
        sign_omega = 0.0
    tau_sw = -k_e * E_err * sign_omega

    # Balance torque (PD + gravity compensation)
    tau_bal = -k_bal_p * theta - k_bal_d * omega + g * sin_theta

    # Blend factors
    alpha_theta = 1.0 / (1.0 + math.exp(-blend_gain * (theta_sw - abs(theta))))
    alpha_omega = 1.0 / (1.0 + math.exp(-blend_gain * (omega_sw - abs(omega))))
    alpha = alpha_theta * alpha_omega

    # Combined torque before scaling
    tau_raw = (1.0 - alpha) * tau_sw + alpha * tau_bal

    # Optional scaling to avoid hard actuator limits
    if abs(tau_raw) > scale_thr:
        tau_raw = scale_thr * tau_raw / abs(tau_raw)

    # Final torque clipping
    if tau_raw > max_torque:
        torque = max_torque
    elif tau_raw < -max_torque:
        torque = -max_torque
    else:
        torque = tau_raw

    # Default random action fallback (should never be reached)
    if torque is None:
        return random.uniform(-2.0, 2.0)
    return torque
