import math, random

def get_action(cos_theta, sin_theta, angular_velocity):
    g = 9.81
    k_e = 1.0
    k_p = 6.0
    k_d = 1.5
    theta_thr = 0.25
    omega_thr = 0.8
    max_torque = 2.0
    scale_thr = 1.8

    theta = math.atan2(sin_theta, cos_theta)
    theta_dot = angular_velocity

    E = 0.5 * theta_dot ** 2 - g * math.cos(theta)
    E_err = E + g
    if theta_dot > 0:
        s = 1.0
    elif theta_dot < 0:
        s = -1.0
    else:
        s = 0.0
    tau_sw = -k_e * E_err * s

    tau_bal = -k_p * theta - k_d * theta_dot + g * math.sin(theta)

    if abs(theta) < theta_thr and abs(theta_dot) < omega_thr:
        a_theta = 1 - (abs(theta) / theta_thr) ** 2
        a_omega = 1 - (abs(theta_dot) / omega_thr) ** 2
        alpha = a_theta * a_omega
        tau_raw = (1 - alpha) * tau_sw + alpha * tau_bal
    else:
        tau_raw = tau_sw

    if abs(tau_raw) > scale_thr:
        tau_raw = scale_thr * tau_raw / abs(tau_raw)

    if tau_raw > max_torque:
        torque = max_torque
    elif tau_raw < -max_torque:
        torque = -max_torque
    else:
        torque = tau_raw

    return torque

