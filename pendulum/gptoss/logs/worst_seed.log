import math, random

def get_action(cos_theta, sin_theta, angular_velocity):
    theta = math.atan2(sin_theta, cos_theta)
    if abs(theta) < 0.02 and abs(angular_velocity) < 0.15:
        kI = 1.0
        if not hasattr(get_action, "_theta_int"):
            get_action._theta_int = 0.0
        get_action._theta_int += theta
        return -kI * get_action._theta_int
    return random.uniform(-2, 2)
