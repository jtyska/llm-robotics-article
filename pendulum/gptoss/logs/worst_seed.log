import math, random

def get_action(cos_theta, sin_theta, angular_velocity):
    g = 9.81
    k_e = 1.5
    k_p = 6.0
    k_d = 1.5
    theta_switch = 0.30
    w = 0.20

    theta = math.atan2(sin_theta, cos_theta)
    theta_abs = abs(theta)
    theta_dot = angular_velocity

    E = 0.5 * theta_dot ** 2 + g * (1 - math.cos(theta))
    E_err = -E

    sign_val = math.copysign(1, theta_dot * math.cos(theta)) if theta_dot * math.cos(theta) != 0 else 0
    tau_up = k_e * E_err * sign_val

    tau_bal = -k_p * theta - k_d * theta_dot + g * math.sin(theta)

    if theta_abs >= theta_switch + w / 2:
        tau_raw = tau_up
    elif theta_abs <= theta_switch - w / 2:
        tau_raw = tau_bal
    else:
        weight = 0.5 * (1 + math.cos(math.pi * (theta_abs - (theta_switch - w / 2)) / w))
        tau_raw = weight * tau_up + (1 - weight) * tau_bal

    torque = max(-2.0, min(2.0, tau_raw))
    return torque if 'tau_raw' in locals() else random.uniform(-2, 2)
