ΔE        ← target_E - E_current   # we want ΔE > 0 while the pole is down

kE        ← 1.5                    # gain for the energy term (tuned)
torque_raw← kE * ΔE * sign(ω * cos(θ))

# -------------------------------------------------
# 4️⃣  Linear (LQR‑like) controller for the near‑upright region
# -------------------------------------------------
# Activate only when the pole is already close **and** moving slowly
