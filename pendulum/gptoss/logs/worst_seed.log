import math, random

def get_action(cos_theta, sin_theta, angular_velocity):
    theta = math.atan2(sin_theta, cos_theta)
    omega = angular_velocity
    E_err = 0.5 * omega * omega + 9.81 * (1 - math.cos(theta))
    sgn = 1 if omega * math.cos(theta) >= 0 else -1

    if abs(theta) < 0.25 and abs(omega) < 0.8:
        torque = 2 * math.tanh((-8.0 * theta - 2.5 * omega + 9.81 * math.sin(theta)) / 2.0)
        return torque
    elif True:
        torque = 2 * math.tanh((-2.0 * E_err * sgn) / 2.0)
        return torque

    return random.uniform(-2, 2)
