import math, random

def get_action(cos_theta, sin_theta, angular_velocity):
    theta = math.atan2(sin_theta, cos_theta)  # range [-π, π]
    abs_theta = abs(theta)

    # Select gains and feed‑forward term
    if abs_theta > 2.0:
        k_angle = 2.0
        k_vel = 0.3
        feed = 0.5 * (-1 if theta > 0 else (1 if theta < 0 else 0))
    elif abs_theta > 1.0:
        k_angle = 1.2
        k_vel = 0.5
        feed = 0.2 * (-1 if theta > 0 else (1 if theta < 0 else 0))
    elif abs_theta > 0.5:
        k_angle = 0.8
        k_vel = 0.7
        feed = 0.0
    else:
        k_angle = 0.5
        k_vel = 1.0
        feed = 0.0

    # Compute raw torque
    torque_raw = -(k_angle * theta) - (k_vel * angular_velocity) + feed

    # Clip to allowed action range
    if torque_raw > 2.0:
        torque = 2.0
    elif torque_raw < -2.0:
        torque = -2.0
    else:
        torque = torque_raw

    return torque if torque is not None else random.uniform(-2, 2)
