import math, random

def get_action(cos_theta, sin_theta, angular_velocity):
    theta = math.atan2(sin_theta, cos_theta)
    torque = None

    if abs(theta) < 0.2:
        # Stabilisation mode
        k_p = 2.0
        k_d = 0.5
        ff = 0.5 * math.sin(theta)  # gravity feed‑forward
        torque_raw = -(k_p * theta) - (k_d * angular_velocity) + ff
        torque = torque_raw
    else:
        # Swing‑up mode (energy shaping)
        k_e = 1.5
        E = (1 - math.cos(theta)) + 0.5 * angular_velocity * angular_velocity
        E_err = -E
        prod = angular_velocity * math.cos(theta)
        if prod > 0:
            sgn = 1
        elif prod < 0:
            sgn = -1
        else:
            sgn = 0
