import math, random

def get_action(cos_theta, sin_theta, angular_velocity):
    theta = math.atan2(sin_theta, cos_theta)
    theta_dot = angular_velocity
    E = -9.81 * math.cos(theta) + 0.5 * theta_dot ** 2
    delta_E = E - 9.81

    torque = None

    if abs(theta) > 0.30:
        sign = 0
        if theta_dot > 0:
            sign = 1
        elif theta_dot < 0:
            sign = -1
        torque = -1.2 * delta_E * sign
    elif abs(theta) <= 0.30 and abs(theta_dot) <= 1.0:
        torque = -8.0 * theta - 2.0 * theta_dot
    else:
        torque = 0.0

    if torque is None:
        return random.uniform(-2.0, 2.0)

    torque = max(min(torque, 2.0), -2.0)
    return torque
