def get_action(cos_theta, sin_theta, angular_velocity):
    import math, random
    theta = math.atan2(sin_theta, cos_theta)
    if abs(theta) <= 0.25 and abs(angular_velocity) <= 0.8:
        tau_raw = -8.0 * theta - 2.0 * angular_velocity
    else:
        E = -9.81 * math.cos(theta) + 0.5 * angular_velocity ** 2
        delta_E = E - 9.81
        sign = 1 if angular_velocity >= 0 else -1
        tau_raw = -2.5 * delta_E * sign
    tau = max(-2.0, min(tau_raw, 2.0))
    return tau
