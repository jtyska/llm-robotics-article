def get_action(cos_theta, sin_theta, angular_velocity):
    import math, random
    g = 9.81
    E_target = g
    kE = 2.0
    kP = 8.0
    kD = 2.0
    theta_switch = 0.20
    theta_dot_thr = 1.0
    torque_limit = 2.0

    theta = math.atan2(sin_theta, cos_theta)
    E = g * (1 - cos_theta) + 0.5 * angular_velocity ** 2

    if abs(theta) > theta_switch:
        sign = 1.0 if angular_velocity * math.cos(theta) >= 0 else -1.0
        torque = kE * (E_target - E) * sign
    else:
        torque = -kP * theta - kD * angular_velocity

    if torque > torque_limit:
        torque = torque_limit
    elif torque < -torque_limit:
        torque = -torque_limit

    if -torque_limit <= torque <= torque_limit:
        return torque
    return random.uniform(-2, 2)
