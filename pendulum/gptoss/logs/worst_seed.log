def get_action(cos_theta, sin_theta, angular_velocity):
    import math, random
    theta = math.atan2(sin_theta, cos_theta)
    theta_dot = angular_velocity
    g = 9.81
    if abs(theta) > 0.25 or abs(theta_dot) > 0.8:
        # Energy‑pump regime
        E_target = g
        E_current = 0.5 * theta_dot**2 + g * (1 - math.cos(theta))
        deltaE = E_target - E_current
        sgn = 1 if (theta_dot * math.cos(theta) >= 0) else -1
        tau_raw = 1.5 * deltaE * sgn
        tau = 2.0 * math.tanh(tau_raw / 1.0)  # soft_clip_alpha = 0.5 → divisor = 2*0.5 = 1
        return tau
    else:
        # Linear PD regime
        tau_raw = (-5.0 * theta) + (-1.5 * theta_dot) + (g * math.sin(theta))
        tau = 2.0 * math.tanh(tau_raw / 1.0)
        return tau
    # Fallback (should never reach here)
    return random.uniform(-2.0, 2.0)
