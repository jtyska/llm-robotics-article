    kd ← 0.5                      # derivative gain
    torque_raw ← -kp * θ - kd * ω   # classic PD law

# -------------------------------------------------
# 5️⃣  Saturate to the admissible torque range
# -------------------------------------------------
torque ← max(-2.0 , min(2.0 , torque_raw))

# -------------------------------------------------
# 6️⃣  Output torque
# -------------------------------------------------
return torque
```

