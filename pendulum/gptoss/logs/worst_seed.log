import math, random

def get_action(cos_theta, sin_theta, angular_velocity):
    # Constants
    g = 9.81
    kE = 0.5
    kP_bal = 8.0
    kD_bal = 2.5
    theta_switch = 0.20
    theta_dot_thr = 0.6
    torque_max = 2.0

    # Compute angle
    theta = math.atan2(sin_theta, cos_theta)

    # Balance controller (PD) near upright
    if abs(theta) < theta_switch and abs(angular_velocity) < theta_dot_thr:
        torque = -(kP_bal * theta + kD_bal * angular_velocity)
    else:
        # Energy shaping swing‑up controller
        # Assume pendulum mass m=1, length l=1
        current_energy = g * (1 - cos_theta) + 0.5 * angular_velocity ** 2
        desired_energy = g  # energy at upright (θ = 0)
        energy_error = desired_energy - current_energy
        sign_term = math.copysign(1, angular_velocity * cos_theta) if angular_velocity * cos_theta != 0 else 0
        torque = kE * energy_error * sign_term

    # Clamp torque to limits
    if torque > torque_max:
        torque = torque_max
    elif torque < -torque_max:
        torque = -torque_max

    # If torque is NaN (unlikely), fallback to random
    if math.isnan(torque):
        torque = random.uniform(-torque_max, torque_max)

    return torque
