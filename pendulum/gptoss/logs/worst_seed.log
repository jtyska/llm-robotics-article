import math, random

def get_action(cos_theta, sin_theta, angular_velocity):
    # Constants
    g = 9.81
    L = 1.0
    theta_switch = 0.30
    delta_theta = 0.10
    omega_brake = 1.0
    tau_min = -2.0
    tau_max = 2.0
    kE = 2.5
    kD_swing = 0.7
    k_brake = 5.0
    kP_bal = 12.0
    kD_bal = 3.0

    # State extraction
    theta = math.atan2(sin_theta, cos_theta)
    omega = angular_velocity
    E = -g * math.cos(theta) + 0.5 * omega * omega
    E0 = -g
    delta_E = E - E0
    sign = 1 if omega >= 0 else -1

    # Control logic
    if abs(theta) <= theta_switch and abs(omega) > omega_brake:
        tau_raw = -k_brake * omega
    else:
        w = 1.0 / (1.0 + math.exp(-(abs(theta) - theta_switch) / delta_theta))
        tau_swing = kE * delta_E * sign - kD_swing * omega
        tau_bal = -kP_bal * theta - kD_bal * omega
        tau_raw = w * tau_swing + (1.0 - w) * tau_bal

    # Clip to action bounds
    tau = max(tau_min, min(tau_raw, tau_max))

    # Default random action fallback (should never be reached)
    if tau is None:
        tau = random.uniform(-2.0, 2.0)

    return tau
