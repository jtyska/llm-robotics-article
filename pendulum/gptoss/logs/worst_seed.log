import math, random

def get_action(cos_theta, sin_theta, angular_velocity):
    # Constants
    kE = 1.5          # energy‑swing‑up gain
    kP = 6.0          # proportional gain (upright)
    kD = 1.5          # derivative gain (upright)
    kB = 1.0          # gentle brake gain
    theta_switch = 0.20   # rad, switch between swing‑up and upright control
    omega_brake  = 1.0    # rad/s, threshold for braking

    # Helper to clip torque within limits
    def clip(val, low, high):
        return max(low, min(high, val))

    # Compute angle from cos and sin
    theta = math.atan2(sin_theta, cos_theta)  # angle in [-π, π]
    omega = angular_velocity

    # Rule 1: Energy‑based swing‑up
    if abs(theta) > theta_switch:
        sign_omega = 1.0 if omega >= 0 else -1.0
        tau_raw = kE * (1 + math.cos(theta)) * sign_omega
        return clip(tau_raw, -2.0, 2.0)

    # Rule 2: Gentle brake near upright
    elif abs(theta) <= theta_switch and abs(omega) > omega_brake:
        tau_raw = -kB * omega
        return clip(tau_raw, -2.0, 2.0)

    # Rule 3: Low‑gain PD controller
    else:
        tau_raw = -kP * theta - kD * omega
        return clip(tau_raw, -2.0, 2.0)

    # Default random action (should not be reached)
    return random.uniform(-2.0, 2.0)
