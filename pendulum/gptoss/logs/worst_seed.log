        tau_raw = -3.0 * term * sgn
    else:
        tau_raw = -8.0 * theta - 2.5 * omega + 9.81 * sin_theta - 0.3 * omega
    torque = 2.0 * math.tanh(tau_raw / 2.0)
    if -2.0 <= torque <= 2.0:
        return torque
    return random.uniform(-2, 2)
