import math, random

def get_action(cos_theta, sin_theta, angular_velocity):
    theta = math.atan2(sin_theta, cos_theta)
    theta_dot = angular_velocity

    if cos_theta >= 0:
        sign = 1 if theta_dot > 0 else -1 if theta_dot < 0 else 0
    else:
        sign = - (1 if theta_dot > 0 else -1 if theta_dot < 0 else 0)

    tau_up = 3.0 * (9.81 - (0.5 * theta_dot**2 + 9.81 * (1 - cos_theta))) * sign

    kp = 5.0
    kd = 2.0
    tau_bal = -kp * theta - kd * theta_dot + 9.81 * math.sin(theta)

    w_win = 0.4
    w_raw = abs(theta) / w_win

    if w_raw > 1:
        w = 0.0
    else:
        w = 0.5 * (1 + math.cos(math.pi * w_raw))

    tau_raw = w * tau_up + (1 - w) * tau_bal
    torque = max(-2.0, min(2.0, tau_raw))

    return torque if isinstance(torque, (int, float)) else random.uniform(-2, 2)
