```python
# ------------------------------------------------------------------
# CONSTANTS
g      = 9.81          # gravity (m/s^2)
l      = 1.0           # length (m) – not needed explicitly, assume m=l=1
torque_max = 2.0
kE     = 1.8           # energy shaping gain
kP_bal = 8.0           # proportional gain for balance
kD_bal = 2.0           # derivative gain for balance
theta_switch = 0.30   # rad  (≈17°)
theta_dot_thr = 1.0   # rad/s
E_target = g * l       # potential energy at upright (m=l=1)

# ------------------------------------------------------------------
def controller(observation):
    x, y, theta_dot = observation          # x = cosθ, y = sinθ
    theta = math.atan2(y, x)               # signed angle ∈ (‑π,π]

    # ---- 1. compute current mechanical energy --------------------
    E_curr = 0.5 * (theta_dot**2) - g * math.cos(theta)   # m=l=1

    # ---- 2. decide which mode we are in -------------------------
    if abs(theta) < theta_switch and abs(theta_dot) < theta_dot_thr:
        # ----- BALANCE MODE (PD around upright) -----------------
        tau = -kP_bal * theta - kD_bal * theta_dot
    else:
        # ----- SWING‑UP MODE (energy shaping) -------------------
        energy_error = E_target - E_curr
        tau = kE * math.copysign(1.0, theta_dot) * energy_error

    # ---- 3. clip torque (soft clipping) -------------------------
    tau = max(-torque_max, min(torque_max, tau))
    # optional soft clipping:
    # tau = math.tanh(tau/torque_max) * torque_max

    return tau
```

