def get_action(cos_theta, sin_theta, angular_velocity):
    import math, random
    theta = math.atan2(sin_theta, cos_theta)
    if abs(theta) < 0.30 and abs(angular_velocity) < 1.0:
        torque = -8.0 * theta - 2.0 * angular_velocity
    else:
        if angular_velocity > 0:
            sign = 1.0
        elif angular_velocity < 0:
            sign = -1.0
        else:
            sign = 0.0
        torque = 1.8 * sign * (9.81 - (0.5 * angular_velocity**2 - 9.81 * math.cos(theta)))
    if torque > 2.0:
        torque = 2.0
    elif torque < -2.0:
        torque = -2.0
    if torque is None:
        return random.uniform(-2.0, 2.0)
    return torque
