import math, random

def get_action(cos_theta, sin_theta, angular_velocity):
    theta = math.atan2(sin_theta, cos_theta)
    omega = angular_velocity
    if abs(theta) < 0.02 and abs(omega) < 0.15:
        return 0.0
    if abs(theta) > 0.30:
        E = 9.81 * (1 - math.cos(theta)) + 0.5 * omega * omega
        delta_E = -E
        torque = max(-2.0, min(2.0, delta_E))
        return torque
    return random.uniform(-2.0, 2.0)
