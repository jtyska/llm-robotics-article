import math, random

def get_action(cos_theta, sin_theta, angular_velocity):
    theta = math.atan2(sin_theta, cos_theta)
    omega = angular_velocity

    # Rule 1
    if abs(theta) < 0.02 and abs(omega) < 0.20:
        return 0.0

    # Rule 2
    delta_E = 9.81 * (1 - math.cos(theta)) + 0.5 * omega * omega
    sign = 1 if omega >= 0 else -1
    tau_swing = 1.2 * delta_E * sign - 0.6 * omega

    # Rule 3
    w = 1 / (1 + math.exp(-(abs(theta) - 0.25) / 0.15))

    # Rule 4
    tau_bal = -7.5 * theta - 2.0 * omega

    # Rule 5
    tau_raw = (1 - w) * tau_swing + w * tau_bal

    # Rule 6
    if tau_raw > 2.0:
        tau = 2.0
    elif tau_raw < -2.0:
        tau = -2.0
    else:
        tau = tau_raw

    return tau

    # Default random action (should never be reached)
    return random.uniform(-2.0, 2.0)
