## 3. Full pseudocode (ready to copy into the agent)

```python
def policy(observation):
    x, y, theta_dot = observation          # x = cosθ, y = sinθ
    theta = math.atan2(y, x)               # –π … +π

    # ---- parameters -------------------------------------------------
    g      = 9.81
    k_e    = 1.0       # energy‑shaping gain
    k_p    = 6.0       # proportional gain for balance
    k_d    = 1.5       # derivative gain for balance
    theta_thr  = 0.25  # rad  (balance region angle)
    omega_thr  = 0.8   # rad/s (balance region angular velocity)

    # ---- swing‑up (energy shaping) ----------------------------------
    E      = 0.5 * theta_dot**2 - g * math.cos(theta)
    E_des  = -g
    E_err  = E - E_des
    tau_sw = -k_e * E_err * math.copysign(1.0, theta_dot)

    # ---- balance (PD + gravity compensation) -----------------------
    tau_bal = -k_p * theta - k_d * theta_dot + g * math.sin(theta)

    # ---- smooth blending --------------------------------------------
    a_theta = max(0.0, 1 - (abs(theta) / theta_thr) ** 2)
    a_omega = max(0.0, 1 - (abs(theta_dot) / omega_thr) ** 2)
    alpha   = a_theta * a_omega                # 0 → swing‑up, 1 → balance

    tau_raw = (1 - alpha) * tau_sw + alpha * tau_bal

    # ---- optional scaling to avoid hard clipping --------------------
    if abs(tau_raw) > 1.8:
        tau_raw = 1.8 * tau_raw / abs(tau_raw)

    # ---- final clipping (environment limit) -------------------------
    torque = max(-2.0, min(2.0, tau_raw))
    return torque
```

