import math, random

def get_action(cos_theta, sin_theta, angular_velocity):
    theta = math.atan2(sin_theta, cos_theta)
    theta_dot = angular_velocity

    # swing‑up regime
    if abs(theta) > 0.35 or abs(theta_dot) > 1.2:
        # energy terms
        g = 9.81
        E = 0.5 * theta_dot**2 + g * (1 - cos_theta)          # current energy (relative to bottom)
        E_up = 2 * g                                          # energy needed to reach upright
        delta_E = E_up - E

        if abs(cos_theta) > 0.1:
            sign_term = math.copysign(1.0, theta_dot * cos_theta) if theta_dot * cos_theta != 0 else 0.0
        else:
            sign_term = math.copysign(1.0, theta_dot) if theta_dot != 0 else 0.0

        torque_raw = 2.5 * delta_E * sign_term
    else:
        # balance regime
        torque_raw = -6.0 * theta - 2.0 * theta_dot + 9.81 * math.sin(theta)
        torque_raw = max(-1.8, min(1.8, torque_raw))

    torque = max(-2.0, min(2.0, torque_raw))

    # fallback random action (should never be reached with current rules)
    if torque is None:
        torque = random.uniform(-2.0, 2.0)

    return torque
