def get_action(cos_theta, sin_theta, angular_velocity):
    import math, random
    theta = math.atan2(sin_theta, cos_theta)
    omega = angular_velocity
    E = (1 - math.cos(theta)) + 0.5 * omega * omega
    dE = 1.0 - E
    if abs(theta) > 0.20:
        kE = 3.0 * (1 - min(1.0, abs(theta) / math.pi))
        prod = omega * math.cos(theta)
        sign = 1 if prod > 0 else -1 if prod < 0 else 0
        tau_raw = kE * dE * sign
        torque = max(min(tau_raw, 1.8), -1.8)
        return torque
    else:
        kP = 2.0
        kD = 0.8
        bias = -0.3 * theta
        tau_raw = -kP * theta - kD * omega + bias
        torque = max(min(tau_raw, 2.0), -2.0)
        return torque
    return random.uniform(-2, 2)
