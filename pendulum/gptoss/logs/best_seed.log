```text
# ----- 1. Compute the physical state ---------------------------------
θ   ← atan2(y, x)                     # angle, 0 = upright, range [-π, π]
ω   ← angular_velocity                # already given (θ̇)

# ----- 2. Helper quantities -----------------------------------------
E   ← (1 - cos(θ)) + 0.5 * ω * ω      # current mechanical energy (target = 1)
ΔE  ← 1.0 - E                         # energy error (positive → need more energy)

# Adaptive energy‑shaping gain: larger when we are far from the top
kE  ← 4.0 * (1.0 - min(1.0, abs(θ) / π))   # 0 < kE ≤ 4.0

# ----- 3. Decide which regime we are in ------------------------------
if abs(θ) > 0.30:                     # ---- far from upright (swing‑up) ----
    # sign(ω·cosθ) tells us whether the current motion is helping or hurting
    s   ← sign( ω * cos(θ) )
    # small angle bias pushes the pole toward the top without saturating
    bias ← -0.8 * θ
    τ_raw ← kE * ΔE * s + bias

elif abs(θ) < 0.15:                   # ---- close to upright (stabilise) ---
    # dead‑zone on angular velocity
    if abs(ω) < 0.02:
        τ_raw ← 0.0
    else:
        # PD controller – stronger damping on ω
        τ_raw ← -8.0 * θ - 3.0 * ω
    end

else:                                 # ---- intermediate region ------------
    # Blend a gentle PD with the energy term so we do not lose momentum
    bias ← -0.6 * θ
    τ_raw ← kE * ΔE * sign( ω * cos(θ) ) + bias
end

# ----- 4. Clip to the admissible torque range ------------------------
torque ← max(-2.0, min(2.0, τ_raw))
