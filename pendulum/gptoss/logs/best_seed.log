    k_p = 8.0
    k_d = 2.5
    torque_raw = -k_p * theta - k_d * theta_dot
else:
    # Energy‑shaping swing‑up
    #   sign = +1 when the pendulum is moving *towards* the upright,
    #          –1 when it is moving away.
    direction = 1.0 if theta_dot * math.cos(theta) >= 0.0 else -1.0

    # Energy error (positive → we need more energy, negative → we have too much)
    delta_E = E_target - E_current

    # Gain that is large enough to overcome friction but respects torque limits
    k_e = 5.0          # proportional to the energy error
