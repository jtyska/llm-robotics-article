def get_action(cos_theta, sin_theta, angular_velocity):
    import math, random
    theta = math.atan2(sin_theta, cos_theta)
    omega = angular_velocity
    E = (1 - math.cos(theta)) + 0.5 * omega * omega
    dE = 1.0 - E
    if (abs(theta) > 0.25) or (abs(omega) > 1.0):
        kE = 4.0 * (1.0 - min(1.0, abs(theta) / math.pi))
        kd = 0.5 * math.tanh(abs(omega))
        prod = omega * math.cos(theta)
        sign = 1.0 if prod > 0 else (-1.0 if prod < 0 else 0.0)
        tau_raw = kE * dE * sign
        tau_raw = tau_raw - kd * omega
        tau_raw = tau_raw + 0.6 * (-theta)
    else:
        tau_raw = -9.0 * theta - 3.0 * omega
    torque = max(-2.0, min(2.0, tau_raw))
    return torque if torque is not None else random.uniform(-2, 2)
