def get_action(cos_theta, sin_theta, angular_velocity):
    import math, random
    theta = math.atan2(sin_theta, cos_theta)
    if abs(theta) > 0.25:
        delta_E = 1.0 - ((1 - math.cos(theta)) + 0.5 * angular_velocity ** 2)
        prod = angular_velocity * math.cos(theta)
        if prod > 0:
            direction = 1
        elif prod < 0:
            direction = -1
        else:
            direction = 0
        torque = 3.0 * delta_E * direction
        torque = max(min(torque, 2.0), -2.0)
        return torque
    else:
        if abs(theta) < 0.02 and abs(angular_velocity) < 0.05:
            return 0.0
        else:
            torque = -6.0 * theta - 2.0 * angular_velocity
            torque = max(min(torque, 2.0), -2.0)
            return torque
    return random.uniform(-2.0, 2.0)
