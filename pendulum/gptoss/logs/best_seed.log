import math, random

def get_action(cos_theta, sin_theta, angular_velocity):
    theta = math.atan2(sin_theta, cos_theta)  # angle in [-π, π]
    omega = angular_velocity

    # mechanical energy and error
    E = (1 - math.cos(theta)) + 0.5 * omega * omega
    dE = 1.0 - E

    # sign function for omega
    if omega > 0:
        sgn = 1.0
    elif omega < 0:
        sgn = -1.0
    else:
        sgn = 0.0

    if abs(theta) > 0.30:
        kE = 8.0 * (1 - min(1.0, abs(theta) / math.pi))  # adaptive gain
        tau_raw = kE * dE * sgn + 0.4 * (-theta)
    else:
        if abs(theta) < 0.02 and abs(omega) < 0.02:
            tau_raw = 0.0
        else:
            tau_raw = -9.0 * theta - 3.0 * omega

    # clip to admissible torque range
    tau = max(-2.0, min(2.0, tau_raw))

    # fallback (should not be reached)
    if tau is None:
        return random.uniform(-2.0, 2.0)
    return tau
