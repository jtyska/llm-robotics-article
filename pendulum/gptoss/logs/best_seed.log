import math, random

def get_action(cos_theta, sin_theta, angular_velocity):
    theta = math.atan2(sin_theta, cos_theta)
    tau = None
    if abs(theta) > 0.25:
        E = (1 - math.cos(theta)) + 0.5 * angular_velocity * angular_velocity
        delta_E = 1.25 - E
        gain = 2.0 + (5.0 - 2.0) * (1 - min(1.0, abs(theta) / math.pi))
        prod = angular_velocity * math.cos(theta)
        if prod > 0:
            s = 1.0
        elif prod < 0:
            s = -1.0
        else:
            s = 0.0
        tau_raw = gain * delta_E * s - 0.30 * theta
        tau = max(-2.0, min(2.0, tau_raw))
    else:
        tau_raw = -12.0 * theta - 3.0 * angular_velocity
        tau = max(-2.0, min(2.0, tau_raw))
    if tau is None:
        return random.uniform(-2.0, 2.0)
    return tau
