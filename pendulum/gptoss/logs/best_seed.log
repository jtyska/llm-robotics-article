import math, random

def get_action(cos_theta, sin_theta, angular_velocity):
    # Helper functions
    def sign(v):
        if v > 0:
            return 1
        elif v < 0:
            return -1
        else:
            return 0

    def clamp(v, lo, hi):
        return lo if v < lo else hi if v > hi else v

    # Parameters
    θ_sw = 0.20       # switch angle (rad)
    θ_dead = 0.015    # dead‑zone angle (rad)
    ω_dead = 0.05     # dead‑zone angular velocity
    Kp_bal = 7.0      # proportional gain (balance)
    Kd_bal = 2.0      # derivative gain (balance)
    E_target = 1.0    # desired mechanical energy
    kE_max = 5.0      # max energy‑shaping gain
    bias_gain = 0.5   # bias toward upright

    # 1️⃣ Decode state
    θ = math.atan2(sin_theta, cos_theta)   # angle, 0 = upright
    ω = angular_velocity

    # 2️⃣ Rule set
    if abs(θ) > θ_sw:
        # ENERGY‑SHAPING (swing‑up)
        E = (1 - math.cos(θ)) + 0.5 * ω * ω
        ΔE = E_target - E
        dir = sign(ω * sin_theta)
        kE = kE_max * (1 - min(1.0, abs(θ) / math.pi))
        τ_raw = kE * ΔE * dir + bias_gain * (-θ)
        torque = clamp(τ_raw, -2.0, 2.0)
    else:
        # BALANCE (PD)
        if abs(θ) < θ_dead and abs(ω) < ω_dead:
            torque = 0.0
        else:
            τ_raw = -Kp_bal * θ - Kd_bal * ω
            torque = clamp(τ_raw, -2.0, 2.0)

    # Default fallback (should not be reached)
    if torque is None:
        torque = random.uniform(-2.0, 2.0)

    return torque
