    τ_raw ← kE * ΔE * sign(ω * cos(θ))

    # Because the bound is ±2, we keep a safety margin (0.9*2)
    τ_raw ← clip(τ_raw, -1.8, 1.8)

# -----------------------------------------------------------------
# 2️⃣  BALANCING PHASE  (|θ| ≤ θ_switch)
# -----------------------------------------------------------------
ELSE
    # Linear PD controller tuned for the torque limit.
    # Gains are chosen so that the *raw* command stays inside [-2,2]
