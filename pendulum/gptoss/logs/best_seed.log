# -------------------------------------------------------------
#  Pendulum control – hybrid swing‑up / balance
# -------------------------------------------------------------
#  Input  : obs = [x, y, theta_dot]   # x = cosθ , y = sinθ
#  Output : torque ∈ [‑2.0, +2.0]
# -------------------------------------------------------------

import math

# ----- 1. Helper ------------------------------------------------
def angle_from_xy(x, y):
    """θ ∈ [‑π, π]  (0 = upright)"""
    return math.atan2(y, x)

# ----- 2. Parameters --------------------------------------------
# Switch between swing‑up and balance
THETA_SWITCH      = 0.25          # rad
OMEGA_SWITCH      = 1.0           # rad/s  (extra guard for swing‑up)

# Swing‑up (energy‑pump) gains
E_TARGET          = 2.0           # desired total energy (potential+kinetic)
K_E               = 5.0           # base energy gain
K_E_LOW           = 2.0           # reduced gain near the switch point
K_DAMP            = 0.2           # velocity damping term

# Balance (PD+I) gains
Kp                = 8.0           # angle gain (negative feedback)
Kd                = 2.5           # angular‑velocity gain
Ki                = 0.5           # tiny integral gain (only active inside balance)

# Integral state – persistent across calls
integral_error    = 0.0

# ----- 3. Main controller ---------------------------------------
def controller(obs):
    global integral_error

    x, y, theta_dot = obs
    theta = angle_from_xy(x, y)                # θ = 0 ⇢ upright
    cos_theta = math.cos(theta)

    # ---------------------------------------------------------
    # 3.1  Decide which mode we are in
    # ---------------------------------------------------------
    if abs(theta) > THETA_SWITCH or abs(theta_dot) > OMEGA_SWITCH:
        # ------------------- SWING‑UP MODE --------------------
        # Total mechanical energy (potential + kinetic) – the pendulum has unit length & unit mass
        #   E = (1 - cosθ) + 0.5·θ̇²
        energy = (1.0 - cos_theta) + 0.5 * theta_dot * theta_dot
        dE     = E_TARGET - energy               # energy error (positive → need more energy)

        # Reduce the gain when we are already close to the switch point,
        # otherwise the torque would constantly hit the ±2 limit.
        gain = K_E if abs(theta) > 0.5 else K_E_LOW

        # Direction of the torque: we want to add energy when θ̇·cosθ > 0
        sign = 1.0 if (theta_dot * cos_theta) >= 0.0 else -1.0

        # Raw torque = gain·ΔE·sign  –  damping·θ̇
        torque_raw = gain * dE * sign - K_DAMP * theta_dot

        # No integral term in swing‑up (avoid wind‑up)
        integral_error = 0.0

    else:
        # ------------------- BALANCE MODE --------------------
        # PD term
        torque_pd = -Kp * theta - Kd * theta_dot

        # Integral term – only accumulate when we are inside the balance region
        integral_error += theta * 0.02               # 0.02 s ≈ simulation step
        torque_i = -Ki * integral_error

        torque_raw = torque_pd + torque_i

    # ---------------------------------------------------------
    # 3.2  Clip to the admissible torque range
    # ---------------------------------------------------------
    torque = max(-2.0, min(2.0, torque_raw))
    return torque
```

