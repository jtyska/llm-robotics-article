```
# -----------------------------------------------------------------
# 0.  Helper quantities
θ   = atan2(y, x)                 # angle in [-π, π]   (θ = 0 → upright)
ω   = angular_velocity            # theta_dot
E   = (1 - cos(θ)) + 0.5*ω**2     # current mechanical energy
E*  = 1.0                         # target energy for upright (potential + 0 kinetic)
ΔE  = E* - E                      # energy error (positive → need more energy)

# -----------------------------------------------------------------
# 1.  Swing‑up region   (|θ| > θ_sw)   – use aggressive energy shaping
θ_sw = 0.30                       # switch angle (rad)
if abs(θ) > θ_sw:
    # Adaptive gain – larger when we are far from the top
    kE = 8.0 * (1 - min(1.0, abs(θ)/π))   # 0 < kE ≤ 8
    # Torque that always pushes in the direction of motion
    τ_raw = kE * ΔE * sign(ω)            # pure energy‑shaping term
    # Small angle‑bias to start turning the pole towards the upright side
    τ_raw += 0.4 * (-θ)                  # weaker than the PD bias used later
else:
    # -----------------------------------------------------------------
    # 2.  Near‑upright region   (|θ| ≤ θ_sw) – PD controller
    kp = 9.0          # proportional gain
    kd = 3.0          # derivative (damping) gain
    # Dead‑band to avoid jitter when we are already very close
    if abs(θ) < 0.02 and abs(ω) < 0.02:
        τ_raw = 0.0
    else:
        τ_raw = -kp * θ - kd * ω
# -----------------------------------------------------------------
# 3.  Clip to admissible torque range
τ = max(-2.0, min(2.0, τ_raw))
apply torque τ
```

