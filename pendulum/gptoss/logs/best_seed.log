def get_action(cos_theta, sin_theta, angular_velocity):
    import math, random
    # initialize persistent integral error
    if not hasattr(get_action, "int_error"):
        get_action.int_error = 0.0
    theta = math.atan2(sin_theta, cos_theta)          # angle in [-π, π]
    cos_theta_val = math.cos(theta)
    # Energy calculations
    E = (1 - cos_theta_val) + 0.5 * angular_velocity * angular_velocity
    E_target = 2.0
    # Mode thresholds
    theta_switch = 0.25
    omega_switch = 1.0
    if abs(theta) > theta_switch or abs(angular_velocity) > omega_switch:
        # ---------- SWING‑UP ----------
        delta_E = E_target - E
        sign = 1.0 if (angular_velocity * cos_theta_val) >= 0 else -1.0
        tau_raw = 5.0 * delta_E * sign - 0.2 * angular_velocity
        torque = max(-2.0, min(2.0, tau_raw))
        return torque
    else:
        # ---------- BALANCE ----------
        tau_pd = -8.0 * theta - 2.5 * angular_velocity
        if abs(theta) < 0.1:
            get_action.int_error += theta * 0.02  # simulation step ≈0.02 s
            tau_int = -0.5 * get_action.int_error
        else:
            tau_int = 0.0
        tau_raw = tau_pd + tau_int
        torque = max(-2.0, min(2.0, tau_raw))
        return torque
    # fallback (should never reach)
    return random.uniform(-2.0, 2.0)
