```python
def pendulum_policy(obs):
    # obs = [x, y, theta_dot]   where x = cosθ, y = sinθ
    x, y, theta_dot = obs
    theta = math.atan2(y, x)                     # raw angle
    # wrap to [-π,π]
    theta = (theta + math.pi) % (2*math.pi) - math.pi

    # ----- mode selection -----
    if abs(theta) > 0.25:                        # swing‑up
        # mechanical energy (m=g=l=1)
        E = (1 - math.cos(theta)) + 0.5 * theta_dot**2
        E_target = 0.2
        dE = E_target - E
        kE = 5.0
        torque_raw = kE * dE * math.copysign(1.0, theta_dot * math.cos(theta))
    else:                                        # LQR stabilisation
        k_theta   = -8.0
        k_theta_d = -2.5
        torque_raw = k_theta * theta + k_theta_d * theta_dot

    # ----- saturation -----
    torque = max(-2.0, min(2.0, torque_raw))
    return torque
```

