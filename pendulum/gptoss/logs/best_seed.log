// ---- 2.  decide which controller to use ----------------------------
if (abs(θ) > 0.20) {                     // ---- ENERGY SHAPING ----
    // mechanical energy (potential + kinetic)
    E   = (1.0 - cos(θ)) + 0.5 * ω * ω
    ΔE  = 1.0 - E                       // target upright energy = 1.0
    // adaptive gain, larger when the pole is far from the top
    kE  = 6.0 * (1.0 - min(1.0, abs(θ) / π))   // 0 < kE ≤ 6
    // sign term: we want to add energy only when it pushes the pendulum
    // in the direction it is already moving.
    s   = (ω * cos(θ) >= 0) ? 1.0 : -1.0
    τ_raw = kE * ΔE * s
}
else {                                   // ---- PD NEAR UPRIGHT ----
    Kp = 12.0
    Kd = 3.0
    τ_raw = -Kp * θ - Kd * ω
