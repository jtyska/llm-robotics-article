import math, random

def get_action(cos_theta, sin_theta, angular_velocity):
    theta = math.atan2(sin_theta, cos_theta)
    omega = angular_velocity
    E = (1 - math.cos(theta)) + 0.5 * omega * omega
    target = 1.0
    delta_E = target - E

    if abs(theta) > 0.30:
        kE = 8.0 * (1 - min(1.0, abs(theta) / math.pi))
        tau_raw = kE * delta_E * (1 if omega >= 0 else -1) + 0.6 * (-theta)
    else:
        if abs(theta) < 0.02 and abs(omega) < 0.02:
            tau_raw = 0.0
        else:
            tau_raw = -8.0 * theta - 2.5 * omega + 0.5 * math.sin(theta)

    tau = max(-2.0, min(2.0, tau_raw))
    return tau

    # fallback (should never be reached)
    return random.uniform(-2, 2)
