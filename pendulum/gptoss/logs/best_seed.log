def get_action(cos_theta, sin_theta, angular_velocity):
    import math, random
    theta = math.atan2(sin_theta, cos_theta)
    omega = angular_velocity
    abs_theta = abs(theta)
    if abs_theta > 0.30:
        E = (1 - cos_theta) + 0.5 * omega * omega
        delta_E = 1.0 - E
        kE = 5.0 * (1 - min(1.0, abs_theta / math.pi))
        prod = omega * cos_theta
        s = 1.0 if prod > 0 else (-1.0 if prod < 0 else 0.0)
        bias = -0.6 * theta
        tau_raw = kE * delta_E * s + bias
    elif abs_theta < 0.25:
        tau_raw = 0.0
    else:
        tau_raw = -6.0 * theta - 1.8 * omega
    tau = max(-2.0, min(2.0, tau_raw))
    if tau is None:  # fallback, should never happen
        return random.uniform(-2.0, 2.0)
    return tau
