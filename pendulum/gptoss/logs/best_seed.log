def policy(obs):
    x, y, thdot = obs
    theta = math.atan2(y, x)                # angle ∈ [‑π, π]
    E_cur = (1 - math.cos(theta)) + 0.5*thdot**2
    E_target = 2.0                           # energy of upright

    if abs(theta) > 0.20:                    # swing‑up
        dE = E_target - E_cur
        sgn = math.copysign(1.0, thdot * math.cos(theta))
