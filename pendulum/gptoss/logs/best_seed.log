```text
# ------------------------------------------------------------------
#  INPUT : observation = (x, y, theta_dot)
#  OUTPUT: torque  ∈ [‑2.0 , 2.0]   (Nm)
# ------------------------------------------------------------------

θ      ← atan2(y, x)                     # angle in [‑π, π]
ω      ← theta_dot                       # angular velocity

# ----- 1.  ENERGY SHAPING (used when |θ| is large) -------------
if abs(θ) > 0.30:                         # swing‑up region (wider than before)
    # mechanical energy of the pendulum (mass = length = g = 1)
    E      ← (1 - cos(θ)) + 0.5 * ω * ω   # current total energy
    E_target ← 1.0                        # energy of the upright equilibrium

    ΔE    ← E_target - E                  # we want ΔE → 0

    # Adaptive gain: larger when we are far from the goal
    kE    ← 5.0 * (1.0 - min(1.0, abs(θ) / π))   # kE ∈ (0,5]

    # Small angle‑bias that points the torque toward the upright direction
    kθ    ← 0.8

    # Desired torque before clipping
    τ_raw ← kE * ΔE * sign(ω * cos(θ))  +  kθ * (‑θ)

else:
    # ----- 2.  LINEAR‑QUADRATIC REGULATOR (near upright) -------
    # PD gains tuned for fast damping without overshoot
    kP    ← 8.0
    kD    ← 2.5
    τ_raw ←  ‑kP * θ  ‑ kD * ω

# ----- 3.  SATURATION --------------------------------------------
torque ← max(‑2.0, min(2.0, τ_raw))

return torque
```

