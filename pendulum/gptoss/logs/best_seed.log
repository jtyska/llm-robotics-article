def get_action(cos_theta, sin_theta, angular_velocity):
    import math, random
    x = cos_theta
    y = sin_theta
    theta = math.atan2(y, x)
    omega = angular_velocity
    if abs(theta) > 0.20 or abs(omega) > 0.5:
        E = (1.0 - x) + 0.5 * omega * omega
        dE = 2.0 - E
        kE = 6.0 * (1.0 - min(1.0, abs(theta) / math.pi))
        prod = omega * x
        if prod > 0:
            s = 1.0
        elif prod < 0:
            s = -1.0
        else:
            s = 0.0
        tau_e = kE * dE * s
        kd = 0.2 * math.tanh(abs(omega))
        tau_d = -kd * omega
        tau_g = -0.8 * theta
        torque = tau_e + tau_d + tau_g
        if torque > 2.0:
            torque = 2.0
        elif torque < -2.0:
            torque = -2.0
        return torque
    else:
        tau_pd = -12.0 * theta - 4.5 * omega
        tau_gc = math.sin(theta)
        torque = tau_pd + tau_gc
        if torque > 2.0:
            torque = 2.0
        elif torque < -2.0:
            torque = -2.0
        return torque
    return random.uniform(-2.0, 2.0)
