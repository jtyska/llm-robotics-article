import math, random

def get_action(cos_theta, sin_theta, angular_velocity):
    theta = math.atan2(sin_theta, cos_theta)          # angle in [-π, π]
    omega = angular_velocity                           # angular velocity

    # Energy terms
    E = (1 - math.cos(theta)) + 0.5 * omega * omega
    delta_E = 1.0 - E                                   # energy error (target energy = 1)

    # Mode selection
    if abs(theta) > 0.25:
        # Swing‑up mode
