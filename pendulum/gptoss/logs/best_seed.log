def get_action(cos_theta, sin_theta, angular_velocity):
    import math, random
    theta = math.atan2(sin_theta, cos_theta)
    if abs(theta) > 0.25:
        E = (1 - math.cos(theta)) + 0.5 * angular_velocity * angular_velocity
        deltaE = 1.0 - E
        kE = 9.0 * (1 - min(1.0, abs(theta) / math.pi))
        s = 1 if angular_velocity * math.cos(theta) >= 0 else -1
        tau_raw = kE * deltaE * s
    else:
        tau_raw = -12.0 * theta - 3.0 * angular_velocity + math.sin(theta)
    tau = max(-2.0, min(2.0, tau_raw))
    return tau if tau is not None else random.uniform(-2, 2)
