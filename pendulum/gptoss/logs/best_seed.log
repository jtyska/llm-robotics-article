def get_action(cos_theta, sin_theta, angular_velocity):
    import math, random
    theta = math.atan2(sin_theta, cos_theta)
    theta = (theta + math.pi) % (2 * math.pi) - math.pi
    torque = None
    if abs(theta) > 0.2:
        delta_E = (1 - math.cos(theta)) + 0.5 * angular_velocity ** 2
        sign = 1.0 if angular_velocity * math.cos(theta) >= 0 else -1.0
        torque_raw = 0.5 * delta_E * sign
    else:
        torque_raw = -2.0 * theta - 0.5 * angular_velocity
    torque = max(-2.0, min(2.0, torque_raw))
    if torque is None:
        return random.uniform(-2, 2)
    return torque
