def get_action(cos_theta, sin_theta, angular_velocity):
    import math, random
    theta = math.atan2(sin_theta, cos_theta)
    if abs(theta) > 0.30:
        omega = angular_velocity
        E = (1 - math.cos(theta)) + 0.5 * omega ** 2
        deltaE = 1 - E
        kE = 4.0 * (1 - min(1.0, abs(theta) / math.pi))
        torque = kE * deltaE * (1 if omega >= 0 else -1)
        torque = max(-2.0, min(2.0, torque))
        return torque
    return random.uniform(-2, 2)
