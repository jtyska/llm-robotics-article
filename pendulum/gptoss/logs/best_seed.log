def get_action(cos_theta, sin_theta, angular_velocity):
    import math, random
    theta = math.atan2(sin_theta, cos_theta)
    torque = None
    if abs(theta) < 0.15 and abs(angular_velocity) < 1.0:
        torque = -8.0 * theta - 2.5 * angular_velocity
    else:
        prod = angular_velocity * cos_theta
        sign = 1.0 if prod > 0 else (-1.0 if prod < 0 else 0.0)
        torque = 1.2 * (0.5 * angular_velocity * angular_velocity + (1 - cos_theta)) * sign
    if torque is not None:
        torque = max(-2.0, min(2.0, torque))
        return torque
    return random.uniform(-2, 2)
