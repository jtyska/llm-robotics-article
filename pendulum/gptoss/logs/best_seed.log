import math, random

def get_action(cos_theta, sin_theta, angular_velocity):
    theta = math.atan2(sin_theta, cos_theta)
    torque = None

    if abs(theta) > 1.0:
        delta_E_target = 0.8 * (math.pi - abs(theta))
        E_cur = (1 - math.cos(theta)) + 0.5 * angular_velocity ** 2
        err = delta_E_target - E_cur
        torque_raw = math.copysign(min(1.0, abs(err)), err)
        torque = torque_raw
    else:
        torque_raw = -2.0 * theta - 0.5 * angular_velocity
        torque = torque_raw

    if torque is None:
        torque = random.uniform(-2.0, 2.0)

    torque = max(-2.0, min(2.0, torque))
    return torque
