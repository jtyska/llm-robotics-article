θdot   = angular_velocity                # third observation component
cosθ   = x
sinθ   = y

# ---- 2. Parameters -------------------------------------------------------
θ_bal   = 0.15          # rad, balance window
ω_bal   = 1.0           # rad/s, speed window
k_p     = 8.0
k_d     = 2.5
k_E     = 1.2           # energy‑shaping gain
torque_limit = 2.0

# ---- 3. Energy‑based swing‑up --------------------------------------------
E_pot   = 1.0 - cosθ                     # potential (0 at upright)
E_kin   = 0.5 * θdot * θdot
ΔE      = E_kin + E_pot                 # excess energy (target = 0)

