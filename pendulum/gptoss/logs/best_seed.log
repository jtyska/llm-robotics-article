import math, random

def get_action(cos_theta, sin_theta, angular_velocity):
    theta = math.atan2(sin_theta, cos_theta)
    omega = angular_velocity
    torque = None

    if abs(theta) <= 0.25:
        if abs(theta) < 0.02 and abs(omega) < 0.04:
            torque = 0.0
        else:
            torque = -5.0 * theta - 1.5 * omega
    else:
        E = (1.0 - cos_theta) + 0.5 * omega * omega
        dE = 1.0 - E
        dir_sign = 0.0
        prod = omega * cos_theta
        if prod > 0:
            dir_sign = 1.0
        elif prod < 0:
            dir_sign = -1.0
        kE = 5.0 * (1.0 - min(1.0, abs(theta) / math.pi))
        torque = kE * dE * dir_sign + 0.8 * (-theta)

    if torque is None:
        torque = random.uniform(-2.0, 2.0)

    torque = max(-2.0, min(2.0, torque))
    return torque
