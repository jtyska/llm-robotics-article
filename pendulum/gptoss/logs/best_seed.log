import math, random

def get_action(cos_theta, sin_theta, angular_velocity):
    theta = math.atan2(sin_theta, cos_theta)
    theta_dot = angular_velocity
    E = 0.5 * theta_dot ** 2 + (1 - cos_theta)
    torque = None

    if abs(theta) <= 0.20 and abs(theta_dot) <= 1.0:
        torque_raw = -8.0 * theta - 2.5 * theta_dot
        torque = max(-2.0, min(2.0, torque_raw))
    elif abs(theta) <= 0.25 and E > 1.5:
        torque_raw = -1.5 * theta_dot - 0.5 * theta
        torque = max(-2.0, min(2.0, torque_raw))
    else:
        delta_E = 2.0 - E
        direction = 1.0 if (theta_dot * cos_theta >= 0) else -1.0
        torque_raw = 3.0 * delta_E * direction
        torque = max(-2.0, min(2.0, torque_raw))

    if torque is None:
        torque = random.uniform(-2.0, 2.0)
    return torque
