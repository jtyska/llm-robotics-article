### 3. Proposed rule‑based strategy  

```python
# ----- 1.  Compute convenient state variables -----------------
theta      = atan2(y, x)                 # [-π, π]  (0 = upright)
theta_dot  = angular_velocity            # third observation

# Mechanical energy (non‑dimensional, m=g=l=1)
E          = (1 - cos(theta)) + 0.5 * theta_dot**2
E_target   = 2.0                         # energy of upright (potential = 2, kinetic = 0)

# ----- 2.  Mode thresholds (hysteresis) --------------------
#   swing‑up  ->  brake   when |θ| < 0.6 rad  AND  E > 1.5
#   brake    ->  balance when |θ| < 0.25 rad AND |θ̇| < 1.2
#   balance  ->  swing‑up when |θ| > 0.3 rad  OR  |θ̇| > 1.5
THETA_SWING   = 0.6
THETA_BRAKE   = 0.25
THETA_BALANCE = 0.20

OMEGA_BRAKE   = 1.2
OMEGA_BALANCE = 1.5

# ----- 3.  Mode selection (persistent state) ---------------
#   `mode` is kept between steps (initially "swing")
if mode == "balance":
    if abs(theta) > THETA_BALANCE or abs(theta_dot) > OMEGA_BALANCE:
        mode = "swing"
elif mode == "brake":
    if abs(theta) < THETA_BALANCE and abs(theta_dot) < OMEGA_BRAKE:
        mode = "balance"
    elif abs(theta) > THETA_SWING:
        mode = "swing"
else:   # mode == "swing"
    if abs(theta) < THETA_SWING and E > 1.5:
        mode = "brake"

# ----- 4.  Torque law for each mode -------------------------
if mode == "swing":
    # Energy‑shaping: add energy when we are moving *with* the gravity torque
    delta_E   = E_target - E                # positive → need more energy
    direction = 1.0 if theta_dot * cos(theta) >= 0 else -1.0
    # Gain chosen so that raw command stays within [-2,2] most of the time
    torque_raw = 3.0 * delta_E * direction
