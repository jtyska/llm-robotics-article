        sign_omega = math.copysign(1, omega) if omega != 0 else 0
        tau_raw = kE * delta_E * sign_omega + 0.6 * (-theta)
    else:
        # Balancing mode
        tau_raw = -10.0 * theta - 2.5 * omega + math.sin(theta)

    # Torque saturation
    tau = max(-2.0, min(2.0, tau_raw))

    # Default fallback (should not be reached)
    if tau is None:
        return random.uniform(-2, 2)
    return tau
