import math, random

def get_action(cos_theta, sin_theta, angular_velocity):
    theta = math.atan2(sin_theta, cos_theta)  # angle in [-π, π]
    if abs(theta) > 0.30:  # Swing‑up mode
        delta_E = 1.0 - ((1 - cos_theta) + 0.5 * angular_velocity * angular_velocity)
        kE = 5.0 * (1.0 - min(1.0, abs(theta) / math.pi))
        prod = angular_velocity * cos_theta
        sign_term = 0.0 if prod == 0 else math.copysign(1.0, prod)
        tau_raw = kE * delta_E * sign_term - 0.8 * theta
    elif True:  # Balancing mode
        tau_raw = -8.0 * theta - 2.5 * angular_velocity
    else:
        return random.uniform(-2.0, 2.0)
    tau = max(-2.0, min(2.0, tau_raw))
    return tau
