def get_action(cos_theta, sin_theta, angular_velocity):
    import math, random
    def sign(v):
        return 1 if v > 0 else -1 if v < 0 else 0
    x, y, ω = cos_theta, sin_theta, angular_velocity
    θ = math.atan2(y, x)
    if abs(θ) > 0.35:
        E = (1 - math.cos(θ)) + 0.5 * ω * ω
        dE = 1.0 - E
        kE = 5.5 * (1 - min(1, abs(θ) / math.pi))
        s = sign(ω) * sign(math.cos(θ))
        τ_raw = kE * dE * s + 0.9 * (-θ)
    else:
        if abs(θ) < 0.04 and abs(ω) < 0.05:
            τ_raw = 0.0
        else:
            τ_raw = -7.0 * θ - 2.2 * ω
    τ = max(-2.0, min(2.0, τ_raw))
    return τ if not (math.isnan(τ) or math.isinf(τ)) else random.uniform(-2, 2)
