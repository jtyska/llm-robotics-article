        tau_raw = kE * delta_E * s + bias
    else:
        tau_raw = -6.5 * theta - 1.8 * angular_velocity
    if tau_raw > 2.0:
        tau = 2.0
    elif tau_raw < -2.0:
        tau = -2.0
    else:
        tau = tau_raw
    return tau
    return random.uniform(-2, 2)
