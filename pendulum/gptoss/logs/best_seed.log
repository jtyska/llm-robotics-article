import math, random

def get_action(cos_theta, sin_theta, angular_velocity):
    # Rule 1: compute state variables
    theta = math.atan2(sin_theta, cos_theta)          # angle in [-π, π]
    omega = angular_velocity

    # Rule 2: parameters
    theta_sw = 0.30
    theta_hyst = 0.05
    theta_bal = 0.02
    Kp = 10.0
    Kd = 2.5

    def sign(x):
        return 1 if x > 0 else -1 if x < 0 else 0

    torque_raw = None

    # Rule 3: Energy-shaping when |θ| > θ_sw
    if abs(theta) > theta_sw:
        E = (1.0 - math.cos(theta)) + 0.5 * omega * omega
        dE = 1.0 - E
        direction = sign(omega * sin_theta)
        kE = 5.0 * (1.0 - min(1.0, abs(theta) / math.pi))
        torque_raw = kE * dE * direction + 0.5 * (-theta)

    # Rule 4: Near-upright regime
    elif abs(theta) <= theta_sw:
        if abs(theta) < (theta_sw - theta_hyst):
            # inside hysteresis → balance mode
            if abs(theta) < theta_bal and abs(omega) < 0.05:
                torque_raw = 0.0
            else:
                torque_raw = -Kp * theta - Kd * omega
        else:
            # still in hysteresis band → keep shaping
            E = (1.0 - math.cos(theta)) + 0.5 * omega * omega
            dE = 1.0 - E
            direction = sign(omega * sin_theta)
            kE = 5.0 * (1.0 - min(1.0, abs(theta) / math.pi))
            torque_raw = kE * dE * direction + 0.5 * (-theta)

    # Rule 5: Torque saturation
    if torque_raw is not None:
        torque = max(-2.0, min(2.0, torque_raw))
        return torque

    # Default random action
    return random.uniform(-2.0, 2.0)
