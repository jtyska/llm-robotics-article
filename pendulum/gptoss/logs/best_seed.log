def get_action(cos_theta, sin_theta, angular_velocity):
    import math, random
    theta = math.atan2(sin_theta, cos_theta)
    if abs(theta) > 0.20:
        E = (1 - math.cos(theta)) + 0.5 * angular_velocity * angular_velocity
        delta_E = 1.0 - E
