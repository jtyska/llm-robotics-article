    torque_raw = -1.5 * theta_dot - 0.5 * theta
else:   # mode == "balance"
    # LQR‑like PD (tuned for the linearised inverted pendulum)
    Kp = 8.0
    Kd = 2.5
    torque_raw = -Kp * theta - Kd * theta_dot

# ----- 5.  Saturate to the admissible action range ------------
torque = max(-2.0, min(2.0, torque_raw))
```

