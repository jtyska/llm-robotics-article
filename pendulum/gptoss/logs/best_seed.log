import math, random

def get_action(cos_theta, sin_theta, angular_velocity):
    theta = math.atan2(sin_theta, cos_theta)
    omega = angular_velocity
    if abs(theta) > 0.20:
        E = (1 - math.cos(theta)) + 0.5 * omega * omega
        dE = 1.20 - E
        kE = 4.5 * (1 - min(1, abs(theta) / math.pi))
        sign_term = math.copysign(1, omega * math.cos(theta))
        tau_raw = kE * dE * sign_term - 0.15 * theta
        action = max(min(tau_raw, 1.9), -1.9)
    else:
        tau_raw = -9.0 * theta - 2.5 * omega
        action = max(min(tau_raw, 2.0), -2.0)
    return action if 'action' in locals() else random.uniform(-2, 2)
