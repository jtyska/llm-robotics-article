def get_action(cos_theta, sin_theta, angular_velocity):
    import math, random
    theta = math.atan2(sin_theta, cos_theta)
    omega = angular_velocity
    E = (1 - math.cos(theta)) + 0.5 * omega * omega
    dE = 1.0 - E
    kE = 10.0 * (1 - min(1.0, abs(theta) / math.pi))
    if abs(theta) > 0.30:
        prod = omega * cos_theta
        sign = math.copysign(1, prod) if prod != 0 else 0
        tau = kE * dE * sign + 0.5 * (-theta)
        return max(-2.0, min(2.0, tau))
    elif abs(theta) < 0.02 and abs(omega) < 0.02:
        return 0.0
    else:
        tau = -12.0 * theta - 3.0 * omega + 0.3 * math.sin(theta)
        return max(-2.0, min(2.0, tau))
    return random.uniform(-2, 2)
