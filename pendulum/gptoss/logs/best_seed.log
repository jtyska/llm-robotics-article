import math, random

def get_action(cos_theta, sin_theta, angular_velocity):
    theta = math.atan2(sin_theta, cos_theta)
    theta_dot = angular_velocity
    E = (1.0 - cos_theta) + 0.5 * theta_dot * theta_dot
    delta_E = 2.0 - E
    direction = 1.0 if theta_dot * cos_theta >= 0.0 else -1.0

    torque_raw = None

    if abs(theta) < 0.20 and abs(theta_dot) < 1.0:
        torque_raw = -12.0 * theta - 3.0 * theta_dot
    elif abs(theta) < 0.35 and abs(theta_dot) > 1.5:
        torque_raw = -4.0 * theta_dot
    else:
        torque_raw = 5.5 * delta_E * direction

    if torque_raw is None:
        return random.uniform(-2.0, 2.0)

    torque = max(-2.0, min(2.0, torque_raw))
    return torque
