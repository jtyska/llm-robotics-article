def get_action(cos_theta, sin_theta, angular_velocity):
    import math, random
    theta = math.atan2(sin_theta, cos_theta)
    omega = angular_velocity
    E = (1 - math.cos(theta)) + 0.5 * omega * omega
    delta_E = 1.0 - E
    gain_E = 2.0 + (6.0 - 2.0) * (1 - min(1, abs(theta) / math.pi))
    def sign(v):
        if v > 0:
            return 1
        if v < 0:
            return -1
        return 0
    if abs(theta) > 0.30:
        s = sign(omega * math.cos(theta))
        tau_raw = gain_E * delta_E * s + 0.6 * (-theta)
    else:
        tau_raw = -12.0 * theta - 3.5 * omega
        if abs(theta) < 0.02 and abs(omega) < 0.05:
            tau_raw = 0.0
    torque = max(-2.0, min(2.0, tau_raw))
    return torque if torque is not None else random.uniform(-2, 2)
