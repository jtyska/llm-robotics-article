        elif angular_velocity < 0:  # Moving counterclockwise
            torque = min(2.0, max(-2.0, 1.0 * abs(angular_velocity) - 0.1 * theta))
        else:
            torque = 0.1 * theta  # Small bias based on angle
    
    return torque
```

