            torque = min(2.0, max(-2.0, -1.2 * abs(angular_velocity)))
        else:  # Moving counterclockwise
            torque = min(2.0, max(-2.0, 1.2 * abs(angular_velocity)))
    else:
        # Apply small corrective torque to maintain balance
        torque = 0.5 * angular_velocity
    
    return torque
```

