            torque = min(2.0, max(-2.0, -0.8 * abs(angular_velocity)))  # Slightly reduced proportional factor
        else:  # Moving counterclockwise
            torque = min(2.0, max(-2.0, 0.8 * abs(angular_velocity)))  # Slightly reduced proportional factor
    else:
        if angular_velocity > 0:  # Moving clockwise
            torque = -0.3  # Reduced default torque for smoother control
        elif angular_velocity < 0:  # Moving counterclockwise
            torque = 0.3  # Reduced default torque for smoother control
        else:
            torque = 0.0
    
    return torque
```

