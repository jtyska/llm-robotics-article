    # Define thresholds for different states
    lean_threshold = math.pi / 4
    small_lean_threshold = math.pi / 8
    
    # Determine the torque based on the state of the pole
    if abs(theta) > lean_threshold:
        if cos_theta < 0:  # Leaning left
            torque = min(2.0, max(-2.0, 1.5 + angular_velocity))
        else:  # Leaning right
            torque = min(2.0, max(-2.0, -1.5 - angular_velocity))
    elif abs(theta) > small_lean_threshold:
        if cos_theta < 0:  # Slightly leaning left
            torque = min(2.0, max(-2.0, 0.75 + angular_velocity))
        else:  # Slightly leaning right
            torque = min(2.0, max(-2.0, -0.75 - angular_velocity))
    else:
        if angular_velocity > 0:  # Moving clockwise
            torque = min(2.0, max(-2.0, -1.0 * abs(angular_velocity) + 0.1))
        elif angular_velocity < 0:  # Moving counterclockwise
            torque = min(2.0, max(-2.0, 1.0 * abs(angular_velocity) - 0.1))
        else:
            torque = 0.0  # Small corrective torque to keep it balanced
    
    return torque
