import math
import random

def get_action(cos_theta, sin_theta, angular_velocity):
    if abs(math.acos(cos_theta) * (1 if sin_theta >= 0 else -1)) > math.pi / 6:
        if cos_theta < 0:
            torque = min(2.0, max(-2.0, 1.5 + angular_velocity))
        else:
            torque = min(2.0, max(-2.0, -1.5 - angular_velocity))
    elif abs(angular_velocity) > 0.3:
        if angular_velocity > 0:
            torque = min(2.0, max(-2.0, -1.0 * abs(angular_velocity)))
        else:
            torque = min(2.0, max(-2.0, 1.0 * abs(angular_velocity)))
    else:
        if angular_velocity > 0:
            torque = -0.5
        elif angular_velocity < 0:
            torque = 0.5
        else:
            torque = 0.0
    return torque if torque is not None else random.uniform(-2, 2)

