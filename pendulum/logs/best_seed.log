import math
import random

def get_action(cos_theta, sin_theta, angular_velocity):
    theta = math.atan2(sin_theta, cos_theta)
    
    if abs(theta) > math.pi / 4:
        if cos_theta < 0:  # pendulum leaning left
            torque = min(2.0, 1.5 * abs(cos_theta) + 0.5 * angular_velocity)
        elif cos_theta > 0:  # pendulum leaning right
            torque = max(-2.0, -1.5 * abs(cos_theta) - 0.5 * angular_velocity)
    else:
        if angular_velocity > 0:  # pendulum moving clockwise
            torque = max(-2.0, -1.0 * angular_velocity)
        elif angular_velocity < 0:  # pendulum moving counterclockwise
            torque = min(2.0, 1.0 * abs(angular_velocity))
        else:
            if cos_theta < 0:  # pendulum slightly leaning left
                torque = min(2.0, 0.5 * abs(cos_theta))
            elif cos_theta > 0:  # pendulum slightly leaning right
                torque = max(-2.0, -0.5 * abs(cos_theta))
    return torque if torque is not None else random.uniform(-2, 2)

