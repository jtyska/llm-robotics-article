def get_action(cos_theta, sin_theta, angular_velocity):
    theta = math.atan2(sin_theta, cos_theta)
    
    if abs(theta) > math.pi / 4:
        # High torque for large angles
        if cos_theta < 0:
            torque = min(1.7 * abs(cos_theta), 2.0)
        elif cos_theta > 0:
            torque = max(-1.7 * abs(cos_theta), -2.0)
        else:
            torque = 0.0
    elif abs(theta) > math.pi / 16:
        # Moderate torque for medium angles
        if angular_velocity > 0:
            torque = max(-0.8 * angular_velocity, -2.0)
        elif angular_velocity < 0:
            torque = min(0.8 * abs(angular_velocity), 2.0)
        else:
            if cos_theta < 0:
                torque = min(0.15 * abs(cos_theta), 2.0)
            elif cos_theta > 0:
                torque = max(-0.15 * abs(cos_theta), -2.0)
            else:
                torque = 0.0
    else:
        # Small torque for small angles
        if angular_velocity > 0:
            torque = max(-0.4 * angular_velocity, -2.0)
        elif angular_velocity < 0:
            torque = min(0.4 * abs(angular_velocity), 2.0)
        else:
            torque = 0.0
    
    return torque
```

