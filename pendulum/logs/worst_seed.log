def get_action(cos_theta, sin_theta, angular_velocity):
    theta = math.atan2(sin_theta, cos_theta)
    
    if abs(theta) > math.pi / 4:
        torque = min(1.5 * abs(cos_theta), 2.0) if cos_theta < 0 else max(-1.5 * abs(cos_theta), -2.0)
    elif abs(theta) > math.pi / 16:
        torque = max(-0.6 * angular_velocity, -2.0) if angular_velocity > 0 else min(0.6 * abs(angular_velocity), 2.0)
    else:
        torque = max(-0.5 * angular_velocity, -2.0) if angular_velocity > 0 else min(0.5 * abs(angular_velocity), 2.0)
    
    # Damping factor to reduce oscillations
    damping_factor = 0.8
    torque *= damping_factor
    
    return torque
```

