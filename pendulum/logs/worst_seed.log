def get_action(cos_theta, sin_theta, angular_velocity):
    theta = math.atan2(sin_theta, cos_theta)
    
    if abs(theta) > math.pi / 4:
        if cos_theta < 0:
            torque = min(1.2 * abs(cos_theta), 2.0)
        elif cos_theta > 0:
            torque = max(-1.2 * abs(cos_theta), -2.0)
        else:
            torque = 0.0
    elif abs(theta) > math.pi / 16:
        if angular_velocity > 0:
            torque = max(-0.7 * angular_velocity, -2.0)
        elif angular_velocity < 0:
            torque = min(0.7 * abs(angular_velocity), 2.0)
        else:
            if cos_theta < 0:
                torque = min(0.2 * abs(cos_theta), 2.0)
            elif cos_theta > 0:
                torque = max(-0.2 * abs(cos_theta), -2.0)
            else:
                torque = 0.0
    else:
        if angular_velocity > 0:
            torque = max(-0.5 * angular_velocity, -2.0) + 0.1 * cos_theta
        elif angular_velocity < 0:
            torque = min(0.5 * abs(angular_velocity), 2.0) - 0.1 * cos_theta
        else:
            torque = 0.0
    
    return torque
```

