                torque = min(0.12 * abs(cos_theta), 2.0)  # Slightly increase fine-tuning
            elif cos_theta > 0:
                torque = max(-0.12 * abs(cos_theta), -2.0)
            else:
                torque = 0.0
    else:
        if angular_velocity > 0:
            torque = max(-0.35 * angular_velocity, -2.0)  # Increase sensitivity to angular velocity
        elif angular_velocity < 0:
            torque = min(0.35 * abs(angular_velocity), 2.0)
        else:
            torque = 0.0
    
    return torque
```

