def get_action(cos_theta, sin_theta, angular_velocity):
    theta = math.atan2(sin_theta, cos_theta)
    
    if abs(theta) > math.pi / 4:
        # Higher torque for large angles to quickly correct the position
        if cos_theta < 0:
            torque = min(1.6 * abs(cos_theta), 2.0)
        else:
            torque = max(-1.6 * abs(cos_theta), -2.0)
