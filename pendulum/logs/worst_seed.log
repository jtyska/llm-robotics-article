        torque = -0.7 * (theta + 0.25 * angular_velocity)  # Adjusted coefficients
    else:
        torque = -0.4 * angular_velocity  # Reduced coefficient for very small angles
    
    torque = max(min(torque, 2), -2)
    
    return torque
```

