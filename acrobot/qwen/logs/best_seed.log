def choose_action(state):
    angle_1, _, angle_2, _, ang_vel_1, ang_vel_2 = state

    # Define thresholds
    angle_threshold = 0.3
    ang_vel_threshold = 1.5

    if abs(angle_1) > angle_threshold or abs(ang_vel_1) > ang_vel_threshold:
        if angle_1 > 0 and ang_vel_1 > 0:
            return 2  # Apply negative torque
        elif angle_1 < 0 and ang_vel_1 < 0:
            return 0  # Apply positive torque
    if abs(angle_2) > angle_threshold or abs(ang_vel_2) > ang_vel_threshold:
        if angle_2 > 0 and ang_vel_2 > 0:
            return 2  # Apply negative torque
        elif angle_2 < 0 and ang_vel_2 < 0:
            return 0  # Apply positive torque

    return 1  # No torque

