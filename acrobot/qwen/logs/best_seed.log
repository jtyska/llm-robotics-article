```python
def new_strategy(observation):
    angle1, angle2, angular_velocity1, angular_velocity2 = observation[:4]

    # Define thresholds for angles and angular velocities
    angle_threshold = 0.2
    velocity_threshold = 2.0

    # Calculate the combined effect of angles and velocities
    combined_effect1 = abs(angle1) + abs(angular_velocity1)
    combined_effect2 = abs(angle2) + abs(angular_velocity2)

    # Apply torque if any pole is significantly deviating or has high velocity
    if combined_effect1 > angle_threshold + velocity_threshold:
        return 2  # Apply torque to the first pole
    elif combined_effect2 > angle_threshold + velocity_threshold:
        return 1  # Apply torque to the second pole
    else:
        return 0  # No torque

