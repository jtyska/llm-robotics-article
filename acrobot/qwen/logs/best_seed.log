def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    # Convert cosine and sine to angles
    angle1 = np.arctan2(sin_theta1, cos_theta1)
    angle2 = np.arctan2(sin_theta2, cos_theta2)

    # Define thresholds for significant tilt and high angular velocity
    angle_threshold = 0.3  # Radians (adjust as needed)
    velocity_threshold = 5.0  # Adjust as needed

    # Additional conditions to handle edge cases
    if abs(angle1) > angle_threshold:
        if ang_vel_theta1 > 0:
            return 2  # Apply torque in the opposite direction of motion
        else:
            return 0  # Apply torque in the direction of motion
    elif abs(angle2) > angle_threshold:
        if ang_vel_theta2 > 0:
            return 0  # Apply torque in the opposite direction of motion
        else:
            return 2  # Apply torque in the direction of motion
    elif abs(ang_vel_theta1) > velocity_threshold:
        if ang_vel_theta1 > 0:
            return 2  # Apply torque to slow down
        else:
            return 0  # Apply torque to speed up
    elif abs(ang_vel_theta2) > velocity_threshold:
        if ang_vel_theta2 > 0:
            return 0  # Apply torque to slow down
        else:
            return 2  # Apply torque to speed up
    else:
        return 1  # No significant tilt or high velocity, maintain balance

# Example usage
