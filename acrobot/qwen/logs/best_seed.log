def updated_strategy(observation):
    cart_position, cart_velocity, pole_angle, pole_angular_velocity, _, _ = observation
    
    # Define thresholds for different states
    cart_pos_threshold = 0.5
    cart_vel_threshold = 1.0
    pole_angle_threshold = 0.2
    pole_angular_velocity_threshold = 1.0
    
    # Determine the action based on multiple factors
    if abs(cart_position) > cart_pos_threshold:
        if cart_position < 0:  # Cart is too far left
            return 2  # Apply right torque
        else:  # Cart is too far right
            return 0  # Apply left torque
    
    if abs(cart_velocity) > cart_vel_threshold:
        if cart_velocity < 0:  # Cart moving to the left too fast
            return 2  # Apply right torque
        else:  # Cart moving to the right too fast
            return 0  # Apply left torque
    
    if abs(pole_angle) > pole_angle_threshold:
        if pole_angle < 0:  # Pole tilting to the left
            return 0  # Apply left torque
        else:  # Pole tilting to the right
            return 2  # Apply right torque
    
    if abs(pole_angular_velocity) > pole_angular_velocity_threshold:
        if pole_angular_velocity < 0:  # Pole rotating counterclockwise too fast
            return 0  # Apply left torque
        else:  # Pole rotating clockwise too fast
            return 2  # Apply right torque
    
    # If none of the conditions are met, no torque is applied
    return 1

