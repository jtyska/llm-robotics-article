import random

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    angle_1 = math.acos(cos_theta1)
    angle_2 = math.acos(cos_theta2)
    
    if abs(angle_1) > 0.3 or abs(ang_vel_theta1) > 1.5:
        if angle_1 > 0 and ang_vel_theta1 > 0:
            return 2
        elif angle_1 < 0 and ang_vel_theta1 < 0:
            return 0
    if abs(angle_2) > 0.3 or abs(ang_vel_theta2) > 1.5:
        if angle_2 > 0 and ang_vel_theta2 > 0:
            return 2
        elif angle_2 < 0 and ang_vel_theta2 < 0:
            return 0
    return random.randint(0, 2)

