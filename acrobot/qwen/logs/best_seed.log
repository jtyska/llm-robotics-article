import random

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    angle1 = math.acos(cos_theta1) if sin_theta1 >= 0 else -math.acos(cos_theta1)
    if -cos_theta1 - cos_theta2 * cos_theta1 + sin_theta2 * sin_theta1 > 1.0:
        return 1
    elif (angle1 * 0.5 + ang_vel_theta1 * 0.1) > 0.5:
        return 2
    elif (angle1 * 0.5 + ang_vel_theta1 * 0.1) < -0.5:
        return 0
    else:
        return 1
    return random.randint(0, 2)

