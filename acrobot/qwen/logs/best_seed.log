def choose_action(θ, ω):
    # Define thresholds for angle and angular velocity
    small_angle = 0.05
    moderate_angle = 0.2
    large_angle = 0.4
    
    small_angular_velocity = 0.1
    moderate_angular_velocity = 0.5
    large_angular_velocity = 1.0

    # Apply force based on angle
    if abs(θ) < small_angle:
        action = 0  # No force
    elif abs(θ) < moderate_angle:
        action = -np.sign(θ) * 1  # Small force to counteract the angle
    elif abs(θ) >= moderate_angle:
        action = -np.sign(θ) * 2  # Larger force to counteract the angle

    # Apply additional force based on angular velocity
    if abs(ω) < small_angular_velocity:
        pass  # No additional force
    elif abs(ω) < moderate_angular_velocity:
        action += -np.sign(ω) * 1  # Small additional force to counteract the angular velocity
    elif abs(ω) >= moderate_angular_velocity:
        action += -np.sign(ω) * 2  # Larger additional force to counteract the angular velocity

    return np.clip(action, -2, 2)  # Ensure the force is within a reasonable range
```

