def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    Kp_theta = 10.0
    Kp_x = 2.0

    error_theta1 = math.atan2(sin_theta1, cos_theta1)
    error_theta2 = math.atan2(sin_theta2, cos_theta2)

    torque = Kp_theta * error_theta1 + Kp_x * error_theta2

    if torque > 0.1:
        action = 2
    elif torque < -0.1:
        action = 1
    else:
        action = 0

    return action if action is not None else random.randint(0, 2)

