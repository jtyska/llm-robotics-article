import numpy as np
import random

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    # Calculate angles from cos and sin values
    theta1 = np.arctan2(sin_theta1, cos_theta1)
    theta2 = np.arctan2(sin_theta2, cos_theta2)

    # Define thresholds for angle and angular velocity
    angle_threshold = 0.1
    angular_velocity_threshold = 0.5

    if abs(theta1) < angle_threshold:
        if abs(ang_vel_theta1) < angular_velocity_threshold:
            return 1  # No torque (action 1)
        else:
            if ang_vel_theta1 > 0:
                return 0  # Apply left torque (action 0)
            else:
                return 2  # Apply right torque (action 2)
    else:
        if theta1 < 0:
            return 0  # Apply left torque (action 0)
        else:
            return 2  # Apply right torque (action 2)
    
    # Default random action
    return random.randint(0, 2)

