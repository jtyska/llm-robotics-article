import math
import random

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    # Define thresholds for balancing
    pole_angle_threshold = 0.1
    angular_velocity_threshold1 = 1.0
    angular_velocity_threshold2 = 1.0

    # Calculate the angles from sine and cosine values
    theta1 = math.acos(cos_theta1) if sin_theta1 >= 0 else -math.acos(cos_theta1)
    theta2 = math.acos(cos_theta2) if sin_theta2 >= 0 else -math.acos(cos_theta2)

    # Check if the pole is balanced and angular velocities are within bounds
    if abs(theta1 + theta2) < pole_angle_threshold and abs(ang_vel_theta1) < angular_velocity_threshold1 and abs(ang_vel_theta2) < angular_velocity_threshold2:
        return 1  # No torque (neutral action)
    
    # Apply torque to correct balance based on pole angle and angular velocities
    if theta1 + theta2 > 0:
        if ang_vel_theta1 > 0 or ang_vel_theta2 > 0:
            return 2  # Torque to the right
        else:
            return 0  # Torque to the left
    else:
        if ang_vel_theta1 < 0 or ang_vel_theta2 < 0:
            return 0  # Torque to the left
        else:
            return 2  # Torque to the right
    
    # Default random action
    return random.randint(0, 2)

