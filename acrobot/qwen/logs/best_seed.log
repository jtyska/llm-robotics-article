            return 0  # Apply left torque
    if abs(angle2) > angle_threshold:
        if angle2 > 0:
            return 2  # Apply right torque
        else:
            return 0  # Apply left torque
    
    # Angular velocity-based correction
    if abs(ang_vel1) > angular_velocity_threshold:
        if ang_vel1 > 0:
            return 0  # Apply left torque to slow down
        else:
            return 2  # Apply right torque to speed up
    if abs(ang_vel2) > angular_velocity_threshold:
        if ang_vel2 > 0:
            return 0  # Apply left torque to slow down
        else:
            return 2  # Apply right torque to speed up
    
