```python
import math

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    # Calculate angles from sine and cosine values
    theta1 = math.atan2(sin_theta1, cos_theta1)
    theta2 = math.atan2(sin_theta2, cos_theta2)

    # Initial strong torque to start the swinging motion
    if abs(theta1) < 0.1 and abs(ang_vel_theta1) < 0.5:
        return 2  # Apply maximum positive torque

    # Adjust torques based on angles and velocities
    if theta1 > 0:
        if ang_vel_theta1 < -0.5:
            return 2  # Apply positive torque to increase speed
        elif ang_vel_theta1 > 0.5:
            return 0  # Apply negative torque to reduce speed
        else:
            return 1  # No torque for steady motion
    else:
        if ang_vel_theta1 < -0.5:
            return 0  # Apply negative torque to increase speed in the opposite direction
        elif ang_vel_theta1 > 0.5:
            return 2  # Apply positive torque to reduce speed in the opposite direction
        else:
            return 1  # No torque for steady motion

    # Default action if none of the conditions are met
    return 1

# Example usage
