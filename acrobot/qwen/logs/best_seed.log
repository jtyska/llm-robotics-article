def new_strategy(observation):
    angle = observation[2]
    angular_velocity = observation[3]
    cart_position = observation[0]
    cart_velocity = observation[1]

    # Define thresholds for angle and angular velocity
    angle_threshold = 0.2
    angular_velocity_threshold = 1.0

    # Define proportional gains
    angle_gain = 1.5
    angular_velocity_gain = 1.0
    cart_position_gain = 0.5

    # Calculate the desired torque based on proportional control
    torque = (angle * angle_gain + angular_velocity * angular_velocity_gain + cart_position * cart_position_gain)

    # Determine the action based on the calculated torque
    if torque > 0.5:
        return 1  # Apply positive torque
    elif torque < -0.5:
        return 0  # Apply negative torque
    else:
        return 1  # No torque (or maintain current state)

