import numpy as np
import random

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    theta1 = np.arctan2(sin_theta1, cos_theta1)
    theta2 = np.arctan2(sin_theta2, cos_theta2)
    
    angle_threshold = 0.2
    velocity_threshold = 5.0
    
    if (theta1 + theta2 < -angle_threshold or ang_vel_theta1 > velocity_threshold):
        action = 0  # Apply left torque
    elif (theta1 + theta2 > angle_threshold or ang_vel_theta1 < -velocity_threshold):
        action = 2  # Apply right torque
    else:
        action = 1  # No torque
    
    return action

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    theta1 = np.arctan2(sin_theta1, cos_theta1)
    theta2 = np.arctan2(sin_theta2, cos_theta2)
    
