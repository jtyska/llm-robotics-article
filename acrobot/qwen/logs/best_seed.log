def advanced_rule_based_strategy(state):
    x1, v1, theta1, omega1, x2, v2, theta2, omega2 = state
    
    # Angle control
    if abs(theta1) > 0.5:
        action = -np.sign(theta1)
    elif abs(theta1) > 0.2:
        action = -0.5 * np.sign(theta1)
    else:
        action = 0.1 * -np.sign(theta1)
    
    # Velocity control
    if abs(omega1) > 1:
        action += -0.3 * np.sign(omega1)
    
    # Position control
    if abs(x1) > 1:
        action += 0.2 * -np.sign(x1)
    
    # Final action
    return np.clip(action, -1, 1)
```

