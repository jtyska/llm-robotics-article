import random

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    cart_position = cos_theta1  # Using cosine of theta1 as a proxy for position
    angle = sin_theta1  # Using sine of theta1 as a proxy for angle
    angular_velocity = ang_vel_theta2

    # Define thresholds for angles and velocities
    angle_threshold = 0.2
    angular_velocity_threshold = 1.0
    position_threshold = 1.0

    if abs(cart_position) > position_threshold:
        if cart_position < -position_threshold:
            return 0  # Apply torque to the left to move the cart right
        else:
            return 2  # Apply torque to the right to move the cart left

    if abs(angle) > angle_threshold or abs(angular_velocity) > angular_velocity_threshold:
        if angle < -angle_threshold:
            return 2  # Apply torque to the right
        else:
            return 0  # Apply torque to the left
    else:
        return 1  # No torque

    return random.randint(0, 2)  # Default action: random torque

