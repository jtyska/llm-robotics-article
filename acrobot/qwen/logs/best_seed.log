    score_right = -weight_angle1 * angle1 - weight_angle2 * angle2 - weight_ang_vel1 * ang_vel1 - weight_ang_vel2 * ang_vel2
    
    if score_left > score_right:
        return 0  # Push left
    elif score_right > score_left:
        return 2  # Push right
    else:
        return 1  # No action

