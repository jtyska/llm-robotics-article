def choose_action(observation):
    angle1, _, angle2, _, ang_vel1, ang_vel2 = observation
    
    # Weights for each feature
    weight_angle1 = 0.5
    weight_angle2 = 0.5
    weight_ang_vel1 = 0.3
    weight_ang_vel2 = 0.3
    
    # Compute a score for each action
