import math, random

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    w2 = ang_vel_theta2
    if abs(w2) > 20:
        return 2 if w2 > 0 else 0

    # compute angles from cos/sin
    theta1 = math.atan2(sin_theta1, cos_theta1)
    theta2 = math.atan2(sin_theta2, cos_theta2)

    h = -math.cos(theta1) - math.cos(theta1 + theta2)

    if h <= 1.0:  # energy‑pump
        if w2 > 0.05:
            return 2
        elif w2 < -0.05:
            return 0
        else:
            return 1
    else:  # energy‑dump
        if w2 > 0.05:
            return 0
        elif w2 < -0.05:
            return 2
        else:
            return 1

    # fallback random action (should not be reached)
    return random.randint(0, 2)
