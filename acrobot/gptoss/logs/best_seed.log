    err   = wrap(φ - π)           # angle error to the upright position
    u     = 1.5 * err + 0.7 * dφ   # PD gains tuned on‑line
    if u > 0.07:   action = 2
    elif u < -0.07: action = 0
    else:          action = 1
# --------------------------------------------------------------
#  4️⃣  BALANCE PHASE  (h ≥ 1.15) – keep the tip above the pivot
else:
