if abs(w2) > W2_MAXCUT:
    action = 0 if w2 > 0 else 2          # brake opposite to motion
elif abs(w1) > W1_MAXCUT:
    action = 0 if w1 > 0 else 2
else:
    # 2) early‑stage first‑link stabilisation (only when the first link is far from vertical)
    if abs(theta1) > 0.6:                # ~34°
        action = 0 if w1 > 0 else 2
    else:
        # 3) pump / dump based on height
        if h < PUMP_LOW:                 # still low → pump
            # apply torque in the *direction* of the current angular velocity
            if w2 > W2_BIAS:
                action = 2               # torque right → accelerate further
            elif w2 < -W2_BIAS:
                action = 0               # torque left
            else:
                # w2 ≈ 0 → give a small bias to start moving
                action = 2               # arbitrary bias (right)
        elif h > DUMP_HIGH:              # already high → dump
            if w2 > W2_BIAS:
                action = 0               # brake
            elif w2 < -W2_BIAS:
                action = 2
            else:
