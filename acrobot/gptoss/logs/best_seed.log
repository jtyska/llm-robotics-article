import math, random

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    w1 = ang_vel_theta1
    w2 = ang_vel_theta2

    # Safety rule
    if abs(w1) > 25.0 or abs(w2) > 25.0:
        return 1

    # Recover angles
    theta1 = math.atan2(sin_theta1, cos_theta1)
    theta2 = math.atan2(sin_theta2, cos_theta2)

    # Height of the tip
    h = -math.cos(theta1) - math.cos(theta1 + theta2)

