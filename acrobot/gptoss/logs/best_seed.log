import math, random

def wrap_to_pi(angle):
    return (angle + math.pi) % (2 * math.pi) - math.pi

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    c1, s1, c2, s2, w1, w2 = cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2

    theta1 = math.atan2(s1, c1)                 # angle of link 1 from vertical
    theta2 = math.atan2(s2, c2)                 # relative joint angle
    alpha = theta1 + theta2                     # absolute angle of the free end
    h = -math.cos(theta1) - math.cos(alpha)     # tip height

    E_kin = 0.5 * w2 ** 2
    E_pot = 9.81 * (h + 2.0)                     # shifted potential
    E = E_kin + E_pot

    E_target = 9.81 * (1.0 + 2.0)                # target energy (height = 1)
    delta_E = 1.0

    err = wrap_to_pi(alpha - math.pi)           # angle error w.r.t. upright

    # Rule 1: safety clamp
    if abs(w2) > 30.0:
        return 1

    # Rule 2: balance phase
    if abs(w2) < 1.0 and abs(err) < 0.2:
        u = 5.0 * err + 1.0 * w2
        if u > 0.03:
            return 2
        elif u < -0.03:
            return 0
        else:
            return 1

    # Rule 3: swing‑up phase
    if E < E_target:
        if alpha * w2 > 0:
            return 2
        else:
            return 0

    # Rule 4: braking phase
    if E_target <= E < E_target + delta_E:
        if w2 > 0.2:
            return 0
        elif w2 < -0.2:
            return 2
        else:
            return 1

    # Rule 5: default action from rule set
    return 1

    # Fallback random action (should never be reached)
    # return random.randint(0, 2)
