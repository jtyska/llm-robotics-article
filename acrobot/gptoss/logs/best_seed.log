def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    import math, random
    c1, s1 = cos_theta1, sin_theta1
    c2, s2 = cos_theta2, sin_theta2
    w1, w2 = ang_vel_theta1, ang_vel_theta2

    theta1 = math.atan2(s1, c1)                 # –π … π   (down = 0)
    theta2 = math.atan2(s2, c2)                 # –π … π   (relative)
    h = -c1 - math.cos(theta1 + theta2)         # tip height
    sin_sum = math.sin(theta1 + theta2)         # direction that raises tip
    phi = theta1 + theta2                       # angle of free end
    dphi = w1 + w2

    # 1. extreme‑velocity safety (overrides everything)
    if abs(w1) > 30 and abs(w2) > 30:
        return 1

    # 2. phase selection
    if h < 0.9:                     # ---- SWING‑UP ----
        E = 0.5 * (w1 ** 2 + w2 ** 2) - (c1 + math.cos(theta1 + theta2))
        deltaE = 2.0 - E

        if abs(w2) < 5.0:
            if sin_sum > 0:
                return 2
            else:
                return 0
        else:
            if deltaE < 0:                     # overshoot → brake
                if w2 > 0:
                    return 0
                else:
                    return 2
            else:
                if sin_sum > 0:
                    return 2
                else:
                    return 0

    elif h < 1.2:                 # ---- TRANSITION ----
        u = -1.0 * phi - 0.2 * dphi
        if u > 0.1:
            return 2
        elif u < -0.1:
            return 0
        else:
            return 1

    else:                         # ---- BALANCING ----
        err1 = theta1 - math.pi
        if err1 > math.pi:
            err1 -= 2 * math.pi
        if err1 < -math.pi:
            err1 += 2 * math.pi
        err2 = theta2                         # second link target = 0

        u = 2.0 * err1 + 0.5 * w1 + 1.5 * err2 + 0.4 * w2
        if u > 0.12:
            return 2
        elif u < -0.12:
            return 0
        else:
            return 1

    # default random action if no rule applied
    return random.randint(0, 2)
