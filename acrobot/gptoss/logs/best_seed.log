# helper functions
sign(x)  =  1  if x > 0.05
          = -1  if x < -0.05
          =  0  otherwise
height   = -cos(theta1) - cos(theta1 + theta2)   # > 1  means tip above target

# ---------------------------------------------------------
# 1.  VERY LARGE velocity brake (optional safety)
if abs(w2) > 20.0:
    # apply a torque opposite to the motion for ONE step
    action = 2 if w2 > 0 else 0          # right torque if w2>0, left otherwise
    # (the next step the normal logic will take over)
else:
    # 2.  Main swing‑up / balance logic
    if height <= 1.0:                     # tip still below the target
        # energy‑pump: torque in direction of motion
        torque_dir = sign(w2)            # 1 → right, -1 → left, 0 → neutral
    else:                                 # tip already above the target
        # energy‑dump: torque opposite to motion
        torque_dir = -sign(w2)

    # map torque_dir to discrete action
    if torque_dir ==  1:  action = 2      # right torque
    elif torque_dir == -1: action = 0    # left torque
    else:                action = 1      # no torque
