import math, random

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    c1, s1, c2, s2, w1, w2 = cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2
    theta1 = math.atan2(s1, c1)
    theta2 = math.atan2(s2, c2)
    h = -c1 - math.cos(theta1 + theta2)
    action = None

    # 1. Emergency brake on joint 2
    if abs(w2) > 15:
        action = 0 if w2 > 0 else 2

    # 2. Emergency brake on joint 1
    elif abs(w1) > 8:
        action = 0 if w1 > 0 else 2

    # 3. Strong correction of the first link
    elif abs(theta1) > 0.7:
        action = 0 if theta1 > 0 else 2

    # 4. Gentle centring of the first link (when it is nearly still)
    elif abs(theta1) > 0.35 and abs(w1) < 0.1:
        action = 0 if theta1 > 0 else 2

    # 5. Pump phase (below target height)
    elif h < 0.95:
        if w2 > 0.1:
            action = 2
        elif w2 < -0.1:
            action = 0
        else:
            action = 2

    # 6. Dump phase (above target height)
    elif h > 1.05:
        if w2 > 0.1:
            action = 0
        elif w2 < -0.1:
            action = 2
        else:
            action = 1

    # 7. Hold‑around‑target (within hysteresis band)
    elif abs(h - 1.0) <= 0.05:
        if w2 > 0.1:
            action = 0
        elif w2 < -0.1:
            action = 2
        else:
            action = 1

    # 8. Default: no torque
    else:
        action = 1

    if action is None:
        action = random.randint(0, 2)

    return action
