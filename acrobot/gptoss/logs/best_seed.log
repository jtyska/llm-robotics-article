import math, random

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    # derived variables
    theta1 = math.atan2(sin_theta1, cos_theta1)
    theta2 = math.atan2(sin_theta2, cos_theta2)
    h = -cos_theta1 - math.cos(theta1 + theta2)

    # Rule 1: First-link stabiliser
    if abs(theta1) > 0.523:
        if ang_vel_theta1 > 0:
            return 0
        else:
            return 2

    # Rule 2: Emergency high-velocity cut-off
    if abs(ang_vel_theta2) > 20.0:
        if ang_vel_theta2 > 0:
            return 0
        else:
            return 2

    # Rule 3: Select target angular velocity for joint 2
    w_target = 8.0 if h <= 1.0 else 0.0

    # Rule 4: Compute error
    error = ang_vel_theta2 - w_target
    abs_err = abs(error)

    # Rule 5: Proportional dead-zone
    if abs_err > 12.0 or abs_err > 6.0 or abs_err > 2.0:
        return 2 if error < 0 else 0
    else:
        return 1

    # Default random action (should never be reached)
    return random.randint(0, 2)
