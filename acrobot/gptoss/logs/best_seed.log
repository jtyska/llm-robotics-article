import math, random

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    # compute angles
    theta1 = math.atan2(sin_theta1, cos_theta1)
    theta2 = math.atan2(sin_theta2, cos_theta2)
    # height metric
    h = -cos_theta1 - math.cos(theta1 + theta2)

    # thresholds
    THETA_DOWN = 0.2          # radians
    VEL_SMALL = 0.05
    H_GOAL = 1.0
    H_TOL = 0.03

    # Rule 1: goal reached above tolerance
    if h > H_GOAL + H_TOL:
        return 1

    # Rule 2: below goal, need energy
    if h < H_GOAL:
        if abs(theta1) < THETA_DOWN and ang_vel_theta1 > VEL_SMALL:
            return 2
        elif abs(theta1 - math.pi) < THETA_DOWN and ang_vel_theta1 < -VEL_SMALL:
            return 0
        elif ang_vel_theta2 > VEL_SMALL:
            return 2
        elif ang_vel_theta2 < -VEL_SMALL:
            return 0
        else:
            return 1

    # Rule 3: slightly above goal, dump excess energy
    # (H_GOAL <= h <= H_GOAL + H_TOL)
    if ang_vel_theta2 > VEL_SMALL:
        return 0
    elif ang_vel_theta2 < -VEL_SMALL:
        return 2
    else:
        return 1

    # default random action (should never reach here)
    return random.randint(0, 2)
