        return 1
    elif h > 1.0:
        return 1
    elif abs_v2 < 0.02:
        return 1
    elif h < -0.95 and v2 == 0:
        return 2
    elif h <= 1.0:
        if v2 > 0.05:
            return 2
        elif v2 < -0.05:
            return 0
        else:
            return 1
    else:
        return 1

    # default random action (should not be reached)
    return random.randint(0, 2)
