def get_action(cos_theta1,sin_theta1,cos_theta2,sin_theta2,ang_vel_theta1,ang_vel_theta2):
    import math, random
    theta1 = math.atan2(sin_theta1, cos_theta1)
    theta2 = math.atan2(sin_theta2, cos_theta2)
    phi = theta1 + theta2
    w1 = ang_vel_theta1
    w2 = ang_vel_theta2
    h = -cos_theta1 - math.cos(theta1 + theta2)
    if abs(w1) > 30 or abs(w2) > 30:
        return 1
    elif h < 0.95:
        s = 1 if math.sin(phi) > 0 else (-1 if math.sin(phi) < 0 else 0)
        torque = s + 0.2 * w2
        if torque > 0.3:
            return 2
        elif torque < -0.3:
            return 0
        else:
            return 1
    elif 1.10 <= h < 1.20:
        if w2 > 0.5:
            return 0
        elif w2 < -0.5:
            return 2
        else:
            return 1
    elif h >= 1.0:  # balance phase
        err = phi - math.pi
        err = (err + math.pi) % (2 * math.pi) - math.pi
        u = 2.0 * err + 0.8 * w2
        if u > 0.12:
            return 2
        elif u < -0.12:
            return 0
        else:
            return 1
    return random.randint(0, 2)
