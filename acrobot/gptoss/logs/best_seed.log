import math, random

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    # compute derived quantities
    h = -cos_theta1 - (cos_theta1 * cos_theta2 - sin_theta1 * sin_theta2)
    alpha = math.atan2(sin_theta2, cos_theta2)

    # rule: high angular velocity
    if abs(ang_vel_theta2) > 12.0:
        action = 1
    else:
        if h < 0.9:
            if alpha * ang_vel_theta2 > 0:
                action = 2
            else:
                action = 0
        else:
            # wrap function to keep angle within [-pi, pi]
            err = math.pi - alpha
            while err > math.pi:
                err -= 2 * math.pi
            while err < -math.pi:
                err += 2 * math.pi
            u = 5.0 * err + 1.0 * ang_vel_theta2
            if u > 0.03:
                action = 2
            elif u < -0.03:
                action = 0
            else:
                action = 1

    # final override rule
    if abs(ang_vel_theta2) > 15.0:
        action = 1

    # default random action if somehow not set
    if action not in (0, 1, 2):
        action = random.randint(0, 2)
    return action
