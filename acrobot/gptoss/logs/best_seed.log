def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    # helper quantities
    h = -cos_theta1 - (cos_theta1 * cos_theta2 - sin_theta1 * sin_theta2)  # -cos(theta1) - cos(theta1+theta2)
    v2 = ang_vel_theta2
    abs_v2 = abs(v2)

    # rule set
