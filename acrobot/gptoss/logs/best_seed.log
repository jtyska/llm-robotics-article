import math, random

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    theta1 = math.atan2(sin_theta1, cos_theta1)
    theta2 = math.atan2(sin_theta2, cos_theta2)
    h = -cos_theta1 - math.cos(theta1 + theta2)

    # Rule 1: Safety cut‑off on joint‑2 velocity
    if abs(ang_vel_theta2) > 12:
        if ang_vel_theta2 > 0:
            return 0
        else:
            return 2

    # Rule 2: Safety cut‑off on joint‑1 velocity
    if abs(ang_vel_theta1) > 6:
        if ang_vel_theta1 > 0:
            return 0
        else:
            return 2

    # Rule 3: First‑link stabilisation
    if abs(theta1) > 0.6:
        if ang_vel_theta1 > 0:
            return 0
        else:
            return 2

    # Rule 4: Pump phase
    if h < 0.9:
        if ang_vel_theta2 > 0.1:
            return 2
        elif ang_vel_theta2 < -0.1:
            return 0
        else:
            return 2

    # Rule 5: Dump phase
    if h > 1.1:
        if ang_vel_theta2 > 0.1:
            return 0
        elif ang_vel_theta2 < -0.1:
            return 2
        else:
            return 1

    # Rule 6: Hold‑around‑target phase
    if 0.9 <= h <= 1.1:
        if ang_vel_theta2 > 0.1:
            return 0
        elif ang_vel_theta2 < -0.1:
            return 2
        else:
            return 1

    # Default random action
    return random.randint(0, 2)
