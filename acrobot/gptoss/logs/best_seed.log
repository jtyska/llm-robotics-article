import random

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    # helper quantities
    h = -cos_theta1 - (cos_theta1 * cos_theta2 - sin_theta1 * sin_theta2)
    v1 = ang_vel_theta1
    v2 = ang_vel_theta2
    abs_v1 = abs(v1)
    abs_v2 = abs(v2)

    # 1. Safety stop – very fast motion
    if abs_v2 > 25 or abs_v1 > 25:
        return 1

    # 2. Hold when just above the goal
    if h > 1.0 and abs(h - 1.0) < 0.04:
        return 1

    # 3. Pumping phase – below the goal
    if h <= 1.0:
        if abs_v2 >= abs_v1:
            if v2 > 0.2:
                return 2
            elif v2 < -0.2:
                return 0
            else:
                if v1 > 0.2:
                    return 2
                elif v1 < -0.2:
                    return 0
                else:
                    return 1
        else:  # |v1| > |v2|
            if v1 > 0.2:
                return 2
            elif v1 < -0.2:
                return 0
            else:
                if v2 > 0.2:
                    return 2
                elif v2 < -0.2:
                    return 0
                else:
                    return 1

    # 4. Braking phase – above the goal
    if h > 1.0:
        if abs_v2 >= abs_v1:
            if v2 > 0.2:
                return 0
            elif v2 < -0.2:
                return 2
            else:
                return 1
        else:  # |v1| > |v2|
            if v1 > 0.2:
                return 0
            elif v1 < -0.2:
                return 2
            else:
                return 1

    # default random action
    return random.randint(0, 2)
