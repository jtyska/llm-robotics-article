def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    import math, random
    # unpack
    c1 = cos_theta1
    s1 = sin_theta1
    c2 = cos_theta2
    s2 = sin_theta2
    w2 = ang_vel_theta2

    # angles
    theta1 = math.atan2(s1, c1)
    theta2 = math.atan2(s2, c2)
    alpha = theta1 + theta2

    # tip height
    h = -c1 - math.cos(alpha)

    # constants
    H_SWITCH = 1.0
    V_MAX = 20.0
    DEADBAND_U = 0.05
    Kp_bal = 4.0
    Kd_bal = 1.2
    pi = math.pi

    # 1. HIGH‑SPEED COAST
    if abs(w2) > V_MAX:
        return 1

    # 2. SWING‑UP PHASE (tip low)
    elif h < H_SWITCH:
        if w2 > 0:
            return 2
        elif w2 < 0:
            return 0
        else:  # w2 == 0 (rare)
            if s2 < 0:
                return 2
            else:
                return 0

    # 3. BALANCE PHASE (tip high enough)
    else:
        err = ((alpha - pi) + pi) % (2 * pi) - pi
        u = Kp_bal * err + Kd_bal * w2
        if u > DEADBAND_U:
            return 2
        elif u < -DEADBAND_U:
            return 0
        else:
            return 1

    # default random action (should never reach here)
    return random.randint(0, 2)
