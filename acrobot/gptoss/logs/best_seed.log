import math, random

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    # Helper calculations
    theta1 = math.atan2(sin_theta1, cos_theta1)          # first link absolute angle
    theta2 = math.atan2(sin_theta2, cos_theta2)          # second link relative angle
    alpha = theta1 + theta2                               # tip absolute angle
    h = -cos_theta1 - math.cos(alpha)                     # tip height
    w2 = ang_vel_theta2                                   # angular velocity of joint 2

    # Constants
    V_COAST = 15.0
    H_BALANCE = 1.00
    Kp_bal = 8.0
    Kd_bal = 3.0
    DEAD_U = 0.04
    pi = math.pi

    # Rule set
    if abs(w2) > V_COAST:
        return 1  # coast

    elif h < (H_BALANCE - 0.10):  # swing‑up phase (h < 0.90)
        if w2 > 0:
            return 2  # torque right
        elif w2 < 0:
            return 0  # torque left
        else:  # w2 ≈ 0
            if sin_theta2 < 0:
                return 2
            else:
                return 0

    elif h < H_BALANCE:  # transition zone (0.90 ≤ h < 1.00)
        return 1  # coast

    else:  # balance phase (h ≥ 1.00)
        err = ((alpha - pi) + pi) % (2 * pi) - pi          # angle error to upright, wrapped to (‑π, π]
        u = Kp_bal * err + Kd_bal * w2

        if u > DEAD_U:
            return 2  # torque right
        elif u < -DEAD_U:
            return 0  # torque left
        else:
            if abs(w2) < 2.0 and abs(err) > 0.02:
                return 0 if err > 0 else 2               # small corrective push
            else:
                return 1                                   # coast

    # Default random action (should not be reached)
    return random.randint(0, 2)
