def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    import math, random
    c1 = cos_theta1
    s1 = sin_theta1
    c2 = cos_theta2
    s2 = sin_theta2
    w1 = ang_vel_theta1
    w2 = ang_vel_theta2

    theta1 = math.atan2(s1, c1)          # –π … π   (down = 0)
    theta2 = math.atan2(s2, c2)          # –π … π   (relative)

    phi = theta1 + theta2                # absolute angle of the free end
    h = -c1 - math.cos(phi)              # tip height (target: h > 1.0)

    dphi = w1 + w2                       # derivative of φ
    E = 0.5 * w2 * w2 - math.cos(phi)    # mechanical energy of link 2
    dE = 1.0 - E                         # energy error (target E = 1.0)

    # safety: do nothing if velocities too high
    if abs(w1) > 6.0 or abs(w2) > 30.0:
        return 1

    # swing‑up phase
    if h < 0.95:
        if dE > 0.02:
            if dphi >= 0:
                return 2
            else:
                return 0
        else:
            return 1

    # transition zone
    elif 0.95 <= h < 1.10:
        u = 1.2 * (math.pi - phi) + 0.4 * dphi
        if u > 0.08:
            return 2
        elif u < -0.08:
            return 0
        else:
            return 1

    # balance phase
    else:
        err = phi - math.pi
        if err > math.pi:
            err -= 2 * math.pi
        if err < -math.pi:
            err += 2 * math.pi
        u = 2.0 * err + 0.8 * dphi
        if u > 0.08:
            return 2
        elif u < -0.08:
            return 0
        else:
            return 1

    # default random action (should not be reached)
    return random.randint(0, 2)
