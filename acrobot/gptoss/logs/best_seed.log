import math, random

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    # compute angles
    theta1 = math.atan2(sin_theta1, cos_theta1)
    theta2 = math.atan2(sin_theta2, cos_theta2)
    total_angle = theta1 + theta2

    # height metric used in rules
    height = -cos_theta1 - math.cos(total_angle)

    v2 = ang_vel_theta2
    s2 = sin_theta2
    alpha = total_angle

    # Rule 1
    if abs(v2) > 22.0:
        return 1

    # Rule 2
    if height < 0.88:
        if v2 > 0:
            return 2
        elif v2 < 0:
            return 0
        else:  # v2 == 0 (or |v2| ≤ 0.5 as comment)
            return 2 if s2 < 0 else 0

    # Rule 3
    if 0.88 <= height < 0.95:
        if v2 > 4.0:
            return 0
        elif v2 < -4.0:
            return 2
        else:
            return 1

    # Rule 4
    if height >= 0.95 and abs(v2) < 12.0:
        err = ((alpha - math.pi + math.pi) % (2 * math.pi)) - math.pi  # wrap to [-π,π]
        u = 6.2 * err + 2.7 * v2
        if u > 0.05:
            return 2
        elif u < -0.05:
            return 0
        else:
            return 1

    # Rule 5
    if True:
        return 1

    # default random action (should not be reached)
    return random.randint(0, 2)
