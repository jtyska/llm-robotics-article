import math, random

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    c1, s1 = cos_theta1, sin_theta1
    c2, s2 = cos_theta2, sin_theta2
    w1, w2 = ang_vel_theta1, ang_vel_theta2

    theta1 = math.atan2(s1, c1)
    theta2 = math.atan2(s2, c2)
    phi = theta1 + theta2
    h = -c1 - math.cos(phi)

    # safety clamp
    if abs(w1) > 20.0 or abs(w2) > 20.0:
        return 1

    # swing‑up
    if h < 1.0:
        def sign(x):
            return 1 if x > 0 else -1 if x < 0 else 0
        dir_ = sign(math.sin(phi))
        torque_pref = dir_ + 0.1 * w2
        if torque_pref > 0.2:
            return 2
        elif torque_pref < -0.2:
            return 0
        else:
            return 1

    # balancing
    theta1_des = math.pi
    theta2_des = 0.0

    err1 = theta1 - theta1_des
    if err1 > math.pi:
        err1 -= 2 * math.pi
    if err1 < -math.pi:
        err1 += 2 * math.pi
    err2 = theta2 - theta2_des

    u = 2.5 * err1 + 0.6 * w1 + 1.8 * err2 + 0.4 * w2

    if u > 0.12:
        return 2
    elif u < -0.12:
        return 0
    else:
        return 1

    # default random action (should never reach here)
    return random.randint(0, 2)
