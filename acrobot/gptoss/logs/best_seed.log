def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    import math, random
    c1 = cos_theta1
    s1 = sin_theta1
    c2 = cos_theta2
    s2 = sin_theta2
    w1 = ang_vel_theta1
    w2 = ang_vel_theta2

    theta1 = math.atan2(s1, c1)
    theta2 = math.atan2(s2, c2)

    h = -c1 - math.cos(theta1 + theta2)
    sin_sum = math.sin(theta1 + theta2)

    action = None

    if abs(w1) > 20.0 or abs(w2) > 20.0:
        action = 1
    elif h < 0.9:
        prod = w2 * sin_sum
        if prod < -0.03:
            action = 2
        elif prod > 0.03:
            action = 0
        else:
            action = 2 if sin_sum > 0 else 0
    else:
        err1 = theta1 - math.pi
        if err1 > math.pi:
            err1 -= 2 * math.pi
        if err1 < -math.pi:
            err1 += 2 * math.pi
        err2 = theta2

        u = (2.0 * err1 + 0.5 * w1) + (1.5 * err2 + 0.4 * w2)

        if u > 0.12:
            action = 2
        elif u < -0.12:
            action = 0
        else:
            action = 1

    if action is None:
        action = random.randint(0, 2)

    return action
