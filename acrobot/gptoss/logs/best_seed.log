def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    import math, random
    omega1 = ang_vel_theta1
    omega2 = ang_vel_theta2
    theta2 = math.atan2(sin_theta2, cos_theta2)
    cos_sum = cos_theta1 * cos_theta2 - sin_theta1 * sin_theta2
    if abs(omega2) > 30 or abs(omega1) > 30:
        return 1
    if cos_theta2 < 0 and abs(omega2) < 0.1:
        if theta2 > 0:
            return 2
        else:
            return 0
    if -cos_theta1 - cos_sum <= 1.0:
        if omega2 > 0.05:
            return 2
        elif omega2 < -0.05:
            return 0
        else:
            return 1
    if -cos_theta1 - cos_sum > 0.9:
        if omega2 > 0.05:
            return 0
        elif omega2 < -0.05:
            return 2
        else:
            return 1
    return random.randint(0, 2)
