def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    import math, random
    c1 = cos_theta1
    s1 = sin_theta1
    c2 = cos_theta2
    s2 = sin_theta2
    w1 = ang_vel_theta1
    w2 = ang_vel_theta2

    theta1 = math.atan2(s1, c1)          # –π … π   (down = 0)
    theta2 = math.atan2(s2, c2)          # –π … π   (relative)

    phi = theta1 + theta2                # absolute angle of the free end
    h = -c1 - math.cos(phi)              # tip height
    sinphi = math.sin(phi)               # direction that raises the tip
    dphi = w1 + w2                       # derivative of φ

    if abs(w1) > 30 or abs(w2) > 30:
        action = 1
    elif h < 1.0:
        action = 2 if sinphi > 0 else 0
    elif (h >= 1.0) and (h < 1.2) and (dphi > 0):
        action = 0 if sinphi > 0 else 2
    else:
        # PD balancing (above the height threshold)
        theta1_des = math.pi
        theta2_des = 0.0

        err1 = theta1 - theta1_des
        if err1 > math.pi:
            err1 -= 2 * math.pi
        if err1 < -math.pi:
            err1 += 2 * math.pi
        err2 = theta2 - theta2_des

        u = 2.0 * err1 + 0.5 * w1 + 1.5 * err2 + 0.3 * w2

        if u > 0.12:
            action = 2
        elif u < -0.12:
            action = 0
        else:
            action = 1

    # default random action if somehow no rule applied
    if action not in (0, 1, 2):
        action = random.randint(0, 2)

    return action
