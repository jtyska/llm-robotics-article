def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    import math, random
    c1, s1 = cos_theta1, sin_theta1
    c2, s2 = cos_theta2, sin_theta2
    w2 = ang_vel_theta2

    theta1 = math.atan2(s1, c1)
    theta2 = math.atan2(s2, c2)
    alpha = theta1 + theta2
    h = -math.cos(theta1) - math.cos(alpha)

    action = None

    if h < 0.85:
        if abs(w2) > 20:
            action = 1
        else:
            if s2 < 0:
                action = 2
            else:
                action = 0
    elif 0.85 <= h < 1.0:
        if abs(w2) < 5:
            action = 1
        else:
            if s2 < 0:
                action = 2
            else:
                action = 0
    else:
        err_angle = ((alpha - math.pi) + math.pi) % (2 * math.pi) - math.pi
        u = 0.4 * err_angle + 0.25 * w2
        if u > 0.15:
            action = 2
        elif u < -0.15:
            action = 0
        else:
            action = 1

    if action is None:
        action = random.randint(0, 2)

    return action
