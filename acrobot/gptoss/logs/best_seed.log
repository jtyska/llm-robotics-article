import math, random

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    # compute derived quantities
    h = -cos_theta1 - (cos_theta1 * cos_theta2 - sin_theta1 * sin_theta2)
    w2 = ang_vel_theta2
    # rule set
    if h < 0.85:
        if w2 > 0.05:
            return 0
        elif w2 < -0.05:
            return 2
        else:
            return 0 if w2 >= 0 else 2
    elif 0.85 <= h < 0.95:
        if cos_theta1 > 0:
            return 2 if w2 > 0 else 0
        else:
            if w2 > 0.02:
                return 0
            elif w2 < -0.02:
                return 2
            else:
                return 1
    elif h >= 0.95:
        alpha = math.atan2(sin_theta1, cos_theta1)
        err = ((alpha - math.pi) + math.pi) % (2 * math.pi) - math.pi
        u = 3.0 * err + 1.0 * w2
        if u > 0.07:
            return 0
        elif u < -0.07:
            return 2
        else:
            return 1
    # default random action
    return random.randint(0, 2)
