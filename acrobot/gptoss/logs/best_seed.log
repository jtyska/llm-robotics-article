import math, random

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    # compute combined expression -cosθ1 - cos(θ1+θ2) using trig identities
    expr = -cos_theta1 - (cos_theta1 * cos_theta2 - sin_theta1 * sin_theta2)
    # compute theta1 for the |θ1| condition
    theta1 = math.atan2(sin_theta1, cos_theta1)

