import math, random

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    # compute h = -cos(theta1) - cos(theta2 + theta1)
    cos_sum = cos_theta1 * cos_theta2 - sin_theta1 * sin_theta2  # cos(theta1+theta2)
    h = -cos_theta1 - cos_sum

    if abs(ang_vel_theta2) > 20 and ang_vel_theta2 > 0:
        return 2
    elif abs(ang_vel_theta2) > 20 and ang_vel_theta2 < 0:
        return 0
    elif h < 0.94:
        if ang_vel_theta2 > 0.04:
            return 2
        elif ang_vel_theta2 < -0.04:
            return 0
        elif ang_vel_theta1 > 0.04:
            return 2
        elif ang_vel_theta1 < -0.04:
            return 0
        else:
            return 1
    elif h > 1.06:
        if ang_vel_theta2 > 0.04:
            return 0
        elif ang_vel_theta2 < -0.04:
            return 2
        elif ang_vel_theta1 > 0.04:
            return 0
        elif ang_vel_theta1 < -0.04:
            return 2
        else:
            return 1
    else:  # 0.94 ≤ h ≤ 1.06
        if ang_vel_theta2 > 0.04:
            return 0
        elif ang_vel_theta2 < -0.04:
            return 2
        else:
            return 1
    # fallback random action
    return random.randint(0, 2)
