Kd1 = 0.6
Kp2 = 1.8      # second joint (directly actuated)
Kd2 = 0.4

u = Kp1*err1 + Kd1*w1 + Kp2*err2 + Kd2*w2   # continuous control signal

# Map continuous signal to discrete actions
DEAD = 0.12
IF u >  DEAD THEN
    action = 2                     # torque to the right
ELSEIF u < -DEAD THEN
    action = 0                     # torque to the left
ELSE
    action = 1                     # coast
END IF
