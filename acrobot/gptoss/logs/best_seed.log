import math, random

def wrap_to_pi(x):
    return ((x + math.pi) % (2 * math.pi)) - math.pi

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    theta1 = math.atan2(sin_theta1, cos_theta1)
    theta2 = math.atan2(sin_theta2, cos_theta2)
    alpha = theta1 + theta2
    h = -cos_theta1 - math.cos(alpha)
    w2 = ang_vel_theta2

    # 1. Coast when the second joint is fast
    if abs(w2) > 20.0:
        return 1

    # 2. Energy‑pump (swing‑up) while the tip is low
    if h < 0.90:
        if w2 > 0:
            return 2
        elif w2 < 0:
            return 0
        else:  # w2 ≈ 0
            if sin_theta2 < 0:
                return 2
            else:
                return 0

    # 3. Balance with PD when the tip is high and slow
    if h >= 0.95 and abs(w2) < 10.0:
        err = wrap_to_pi(alpha - math.pi)
        u = 6.0 * err + 2.5 * w2
        if u > 0.03:
            return 2
        elif u < -0.03:
            return 0
        else:
            return 1

    # 4. Transition zone – coast
    if True:
        return 1

    # default random action (should never reach here)
    return random.randint(0, 2)
