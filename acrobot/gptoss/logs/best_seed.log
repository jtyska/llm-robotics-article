def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    import math, random
    h = -cos_theta1 - (cos_theta1 * cos_theta2 - sin_theta1 * sin_theta2)
    omega2 = ang_vel_theta2
    action = None
    if omega2 > 20 or omega2 < -20:
        action = 1
    elif h >= 1.0 and -12 < omega2 < 12:
        alpha = math.atan2(sin_theta1, cos_theta1) + math.atan2(sin_theta2, cos_theta2)
        err = ((alpha - math.pi) + math.pi) % (2 * math.pi) - math.pi
        u = 6.0 * err + 2.0 * omega2
        if u > 0.1:
            action = 0
        elif u < -0.1:
            action = 2
        else:
            action = 1
    else:
        if h < 0.95:
            action = 2 if sin_theta2 < 0 else 0
        elif h > 1.05:
            action = 0 if sin_theta2 < 0 else 2
        else:
            action = 1
    if action is None:
        action = random.randint(0, 2)
    return action
