# ----- parameters (tuned from the analysis) -----
PUMP_LOW   = 0.9      # start dumping a little before the termination height
DUMP_HIGH  = 1.1      # start pumping again if we overshoot
W2_BIAS    = 0.1      # dead‑zone width for w2
