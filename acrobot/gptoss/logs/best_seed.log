    ELSE
        IF abs(w2) < 2.0 AND abs(err) > 0.02 THEN
            ACTION = 0 IF err > 0 ELSE 2        # small corrective push
        ELSE
            ACTION = 1                           # coast
        ENDIF
    ENDIF
ENDIF
