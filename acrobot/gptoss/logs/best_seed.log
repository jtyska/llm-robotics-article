import math, random

def wrap(x):
    while x > math.pi:
        x -= 2 * math.pi
    while x < -math.pi:
        x += 2 * math.pi
    return x

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    theta1 = math.atan2(sin_theta1, cos_theta1)
    theta2 = math.atan2(sin_theta2, cos_theta2)
    phi = wrap(theta1 + theta2)
    dphi = ang_vel_theta1 + ang_vel_theta2
    h = -cos_theta1 - math.cos(phi)
    E = 0.5 * ang_vel_theta2 ** 2 - math.cos(phi)
    deltaE = 1.0 - E

    if abs(ang_vel_theta1) > 8.0 or abs(ang_vel_theta2) > 25.0:
        return 1

    if h < 1.0:
        if deltaE > 0.015:
            return 2 if dphi >= 0 else 0
        else:
            return 1

    if h < 1.15:
        err = wrap(phi - math.pi)
        u = 1.5 * err + 0.7 * dphi
        if u > 0.07:
            return 2
        elif u < -0.07:
            return 0
        else:
            return 1

    err = wrap(phi - math.pi)
    u = 2.5 * err + 1.0 * dphi
    if u > 0.06:
        return 2
    elif u < -0.06:
        return 0
    else:
        return 1

    return random.randint(0, 2)
