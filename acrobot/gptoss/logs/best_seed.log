def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    import math, random
    def wrap(x):
        return (x + math.pi) % (2 * math.pi) - math.pi
    if abs(ang_vel_theta1) > 9.0 or abs(ang_vel_theta2) > 28.0:
        return 1
    theta1 = math.atan2(sin_theta1, cos_theta1)
    theta2 = math.atan2(sin_theta2, cos_theta2)
    phi = wrap(theta1 + theta2)
    h = -cos_theta1 - math.cos(phi)
    dphi = ang_vel_theta1 + ang_vel_theta2
    E = 0.5 * ang_vel_theta2 * ang_vel_theta2 - math.cos(phi)
    dE = 1.0 - E
    if h < 0.95:
        if dE > 0.015:
            if dphi >= 0:
                return 2
            else:
                return 0
        else:
            return 1
    elif h < 1.10:
        err = wrap(math.pi - phi)
        u = 1.2 * err + 0.35 * dphi
        if u > 0.07:
            return 2
        elif u < -0.07:
            return 0
        else:
            return 1
    else:
        err = wrap(math.pi - phi)
        u = 2.0 * err + 0.8 * dphi
        if u > 0.06:
            return 2
        elif u < -0.06:
            return 0
        else:
            return 1
    return random.randint(0, 2)
