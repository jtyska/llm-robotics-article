import math, random

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    c1 = cos_theta1
    s1 = sin_theta1
    c2 = cos_theta2
    s2 = sin_theta2
    w1 = ang_vel_theta1
    w2 = ang_vel_theta2

    theta1 = math.atan2(s1, c1)          # –π … π   (down = 0)
    theta2 = math.atan2(s2, c2)          # –π … π   (relative)

    phi = theta1 + theta2                # absolute angle of the free end
    h = -c1 - math.cos(phi)              # tip height
    dphi = w1 + w2                       # derivative of φ
    sinphi = math.sin(phi)

    E = 0.5 * w2 * w2 - math.cos(phi)    # mechanical energy of second link
    E_target = 1.0
    dE = E_target - E                    # energy error

    # Rule hierarchy
    if abs(w1) > 8:
        return 1

    elif h < 1.0:                        # swing‑up phase
        if dE > 0.05:
            if dphi > 0:
                return 2
            else:
                return 0
        elif abs(w2) < 0.2:
            if sinphi > 0:
                if dphi >= 0:
                    return 2
                else:
                    return 0
            else:
                if dphi >= 0:
                    return 0
                else:
                    return 2
        else:
            return 1

    elif 1.0 <= h < 1.15:                # transition zone
        if dphi > 0.5:
            return 0
        elif dphi < -0.5:
            return 2
        else:
            return 1

    else:                                # balance phase (h ≥ 1.15)
        err = phi - math.pi               # target φ = π
        if err > math.pi:
            err -= 2 * math.pi
        if err < -math.pi:
            err += 2 * math.pi

        u = 1.0 * err + 0.3 * dphi        # PD control signal
        if u > 0.12:
            return 2
        elif u < -0.12:
            return 0
        else:
            return 1

    # Default random action
    return random.randint(0, 2)
