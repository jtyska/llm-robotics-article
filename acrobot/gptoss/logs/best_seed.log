err2 = θ2                           # relative angle should be 0

# PD control torques (continuous values)
torque1 = Kp1 * err1 + Kd1 * (-w1)   # negative w1 damps the motion
torque2 = Kp2 * err2 + Kd2 * (-w2)

# Because only the second joint is actuated, we use torque2 to decide.
# Map continuous torque to discrete action:
if torque2 >  0.2:
    action = 2          # right torque
elif torque2 < -0.2:
    action = 0          # left torque
else:
    action = 1          # no torque
return action
```

