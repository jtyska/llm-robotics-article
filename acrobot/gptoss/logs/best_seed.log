import math, random

def wrap_to_pi(angle):
    return (angle + math.pi) % (2 * math.pi) - math.pi

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    # compute angles
    theta1 = math.atan2(sin_theta1, cos_theta1)
    theta2 = math.atan2(sin_theta2, cos_theta2)
    alpha = theta1 + theta2
    h = -math.cos(theta1) - math.cos(alpha)
    err = wrap_to_pi(alpha - math.pi)
    u = 4.0 * err + 1.2 * ang_vel_theta2
    dead = 0.2

    if h > 1.0:
        return 1
    elif abs(ang_vel_theta2) > 28.0:
        return 1
    elif u > dead:
        return 0
    elif u < -dead:
        return 2
    else:
        return 1

    # fallback random action (should never be reached)
    return random.randint(0, 2)
