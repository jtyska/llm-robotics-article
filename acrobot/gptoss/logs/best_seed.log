## 4. Updated rule set (pseudo‑code)

```python
# ----------------------------------------------------------------------
# Helper extraction (same for every step)
c1 = obs[0]; s1 = obs[1]
c2 = obs[2]; s2 = obs[3]
w1 = obs[4]; w2 = obs[5]

theta1 = math.atan2(s1, c1)               # –π … π   (down = 0)
theta2 = math.atan2(s2, c2)               # –π … π   (relative)

h       = -c1 - math.cos(theta1 + theta2) # tip height
sin_sum = math.sin(theta1 + theta2)       # direction that raises tip
phi     = theta1 + theta2                  # angle of free end
dphi    = w1 + w2

# ----------------------------------------------------------------------
# Phase selection
if h < 0.9:                     # ------------------- SWING‑UP -------------------
    # Energy of the system (potential + kinetic)
    E   = 0.5*(w1**2 + w2**2) - (c1 + math.cos(theta1+theta2))
    dE  = 2.0 - E                # we would like E ≈ 2 (upright)

    # Desired direction of torque
    dir = 1 if sin_sum > 0 else -1

    if abs(w2) < 5.0:           # still need help
        action = 2 if dir > 0 else 0
    else:
        # we already have enough speed – only brake if we have too much energy
        if dE < 0:              # overshoot → brake
            action = 0 if w2 > 0 else 2
        else:
            action = 2 if dir > 0 else 0

elif h < 1.2:                   # ------------------- TRANSITION ---------------
    # PD on the sum‑angle (phi)
    k_p = 1.0
    k_d = 0.2
    u   = -k_p*phi - k_d*dphi
    if u > 0.1:   action = 2
    elif u < -0.1:action = 0
    else:         action = 1

else:                           # ------------------- BALANCING ----------------
    # wrap error for theta1 around π (upright)
    err1 = theta1 - math.pi
    if err1 >  math.pi: err1 -= 2*math.pi
    if err1 < -math.pi: err1 += 2*math.pi
    err2 = theta2                # target 0

    # PD gains (hand‑tuned)
    K1, K2, K3, K4 = 2.0, 0.5, 1.5, 0.4
    u = K1*err1 + K2*w1 + K3*err2 + K4*w2

    if u > 0.12:   action = 2
    elif u < -0.12:action = 0
    else:          action = 1

# ----------------------------------------------------------------------
# Extreme‑velocity safety (almost never triggered)
if abs(w1) > 30.0 and abs(w2) > 30.0:
    action = 1
```

