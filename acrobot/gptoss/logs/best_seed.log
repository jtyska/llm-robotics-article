import random

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    # Fast‑swing stabilisation (joint 2)
    if abs(ang_vel_theta2) > 10.0:
        return 2 if ang_vel_theta2 > 0 else 0

    # Fast‑swing stabilisation (joint 1)
    if abs(ang_vel_theta1) > 10.0:
        return 2 if ang_vel_theta1 > 0 else 0

    # Compute height metric h
    h = -cos_theta1 - (cos_theta1 * cos_theta2 - sin_theta1 * sin_theta2)

    # Hold when at goal
    if h > 1.0 and abs(h - 1.0) < 0.04:
        return 1

    # Pump (below goal)
    if h <= 1.0:
        if ang_vel_theta2 > 0.05:
            return 2
        elif ang_vel_theta2 < -0.05:
            return 0
        elif ang_vel_theta1 > 0.05:
            return 2
        elif ang_vel_theta1 < -0.05:
            return 0
        else:
            return 1

    # Dump (above goal) and not in hold condition
    if h > 1.0:
        if abs(ang_vel_theta2) >= abs(ang_vel_theta1):
            if ang_vel_theta2 > 0.05:
                return 0
            elif ang_vel_theta2 < -0.05:
