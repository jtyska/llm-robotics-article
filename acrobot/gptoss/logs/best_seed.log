import math, random

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    # Rule 1 – Safety
    if abs(ang_vel_theta1) > 8 or abs(ang_vel_theta2) > 8:
        return 1

    # compute angles from sin/cos
    theta1 = math.atan2(sin_theta1, cos_theta1)
    theta2 = math.atan2(sin_theta2, cos_theta2)
    theta_sum = theta1 + theta2

    # height measure
    h = -cos_theta1 - math.cos(theta_sum)

    # Rule 2 – Swing‑up (height below threshold)
    if h < 1.0:
        E = 0.5 * (ang_vel_theta1 ** 2 + ang_vel_theta2 ** 2) - (cos_theta1 + math.cos(theta_sum))
        delta_E = 2.0 - E
        s = 1 if math.sin(theta_sum) > 0 else (-1 if math.sin(theta_sum) < 0 else 0)
        if delta_E * s > 0:
            return 2  # apply right torque
        elif delta_E * s < 0:
            return 0  # apply left torque
        else:
            return 1  # no torque

    # default random action
    return random.randint(0, 2)
