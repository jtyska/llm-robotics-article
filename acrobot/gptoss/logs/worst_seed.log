import random

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    obs0 = cos_theta1
    obs1 = sin_theta1
    obs2 = cos_theta2
    obs3 = sin_theta2
    obs4 = ang_vel_theta1
    obs5 = ang_vel_theta2

    term = -obs0 - (obs0 * obs2 - obs1 * obs3)

    # Rule 1
    if term > 1.0:
        return 1
    # Rule 2
    elif term > 0.95 and abs(obs5) < 0.35:
        return 1
    # Rule 3
    elif obs0 > 0.0:
        thr_vel = 0.30 + 0.10 * (1.0 - term)
        if obs5 > thr_vel:
            return 2
        elif obs5 < -thr_vel:
            return 0
        else:
            return 2 if obs3 > 0.0 else 0
    else:
        thr_vel = 0.30 + 0.10 * (1.0 - term)
        if abs(obs5) > thr_vel:
            if obs5 * obs3 < 0.0:
                return 0 if obs5 > 0.0 else 2
            else:
                return 2 if obs5 > 0.0 else 0
        else:
            torque = -0.7 * obs3 - 0.3 * obs5 - 0.1 * obs4
            if torque > 0.2:
                return 2
            elif torque < -0.2:
                return 0
            else:
                return 1

    # Default random action (should not be reached)
    return random.randint(0, 2)
