    # error terms
    e_h  = 1.0 - h          # positive when tip is too low
    e_v2 = -v2              # we want v2 → 0
    e_v1 = -v1              # we also want v1 → 0 (helps the first link)

    tau = PD_GAIN_H*e_h + PD_GAIN_V2*e_v2 + PD_GAIN_V1*e_v1

    # clip torque to the range that can be expressed by the three actions
    if tau >  PD_MAX_TAU: tau =  PD_MAX_TAU
    if tau < -PD_MAX_TAU: tau = -PD_MAX_TAU

    if   tau >  0.12: action = 2          # right torque
    elif tau < -0.12: action = 0          # left torque
    else:            action = 1          # no torque
    # -----------------------------------------------------------------
    #  Note: the PD controller is only active in this narrow band.
    # -----------------------------------------------------------------
else:
    # --------------------------------------------------------------
