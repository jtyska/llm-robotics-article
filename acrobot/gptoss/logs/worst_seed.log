def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    import random
    # compute height condition h = -cos(theta1) - cos(theta1+theta2)
    cos_sum = cos_theta1 * cos_theta2 - sin_theta1 * sin_theta2
    h = -cos_theta1 - cos_sum

    # rule 1
    if h > 1.0:
        return 1

    # rule 2
    elif 0.92 < h <= 1.0:
        torque = -0.8 * sin_theta2 - 0.4 * ang_vel_theta2
        if torque > 0.2:
            return 2
        elif torque < -0.2:
            return 0
        else:
            return 1

    # rule 3
    elif cos_theta1 > 0:  # first link below vertical
        total = ang_vel_theta1 + ang_vel_theta2
        if total > 0.1:
            return 2
        elif total < -0.1:
            return 0
        elif sin_theta2 > 0:
            return 2
        elif sin_theta2 < 0:
            return 0
        else:
            return 1

    # rule 4 (c1 <= 0)
    else:
        if abs(ang_vel_theta2) > 0.35:
            if ang_vel_theta2 * sin_theta2 < 0:
                if ang_vel_theta2 > 0:
                    return 0
                else:
                    return 2
            else:
                if ang_vel_theta2 > 0:
                    return 2
                else:
                    return 0
        else:
            torque = -0.8 * sin_theta2 - 0.4 * ang_vel_theta2
            if torque > 0.2:
                return 2
            elif torque < -0.2:
                return 0
            else:
                return 1

    # default random action (should not be reached)
    return random.randint(0, 2)
