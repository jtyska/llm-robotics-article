import random

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    c1 = cos_theta1
    s1 = sin_theta1
    c2 = cos_theta2
    s2 = sin_theta2
    v1 = ang_vel_theta1
    v2 = ang_vel_theta2

    # compute h = -cos(theta1) - cos(theta2 + theta1)
    cos_sum = c1 * c2 - s1 * s2
    h = -c1 - cos_sum

    if h > 0.97:
        expr = (-1.2 * s2) - (0.8 * v2)
        if expr > 0.2:
            return 2
        elif expr < -0.2:
            return 0
        else:
            return 1
    elif c1 > 0:
        if v2 > 0.1:
            return 2
        elif v2 < -0.1:
            return 0
        elif s2 > 0:
            return 2
        else:
            return 0
    else:  # c1 <= 0
        if h < 0.92:
            tau = 1.5 * (0.95 - h) - 0.4 * v2
            if tau > 0.2:
                return 2
            elif tau < -0.2:
                return 0
            else:
                return 1
        else:  # 0.92 <= h <= 0.97
            expr = (-1.2 * s2) - (0.8 * v2)
            if expr > 0.2:
                return 2
            elif expr < -0.2:
                return 0
            else:
                return 1

    # default random action if none of the above conditions are met
    return random.randint(0, 2)
