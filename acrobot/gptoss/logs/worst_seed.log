def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    c1 = cos_theta1
    s1 = sin_theta1
    c2 = cos_theta2
    s2 = sin_theta2
    v1 = ang_vel_theta1
    v2 = ang_vel_theta2

    if (-c1 - (c1 * c2 - s1 * s2)) > 1.0:
        return 1
    elif (-c1 - (c1 * c2 - s1 * s2)) > 0.98 and (v1 + v2) > 0:
        return 2
    elif (-c1 - (c1 * c2 - s1 * s2)) > 0.98 and (v1 + v2) <= 0:
        return 0
    elif c1 > 0 and v2 > 0.2:
        return 2
    elif c1 > 0 and v2 < -0.2:
        return 0
    elif c1 > 0 and s2 > 0:
        return 2
    elif c1 > 0 and s2 < 0:
        return 0
    elif c1 > 0:
        return 1
    elif abs(v2) < 0.12 and s2 > 0:
        return 2
    elif abs(v2) < 0.12 and s2 <= 0:
        return 0
    elif (v2 * s2) > 0.05 and v2 > 0:
        return 2
    elif (v2 * s2) > 0.05 and v2 <= 0:
        return 0
    elif (v2 * s2) < -0.05 and v2 > 0:
        return 0
    elif (v2 * s2) < -0.05 and v2 <= 0:
        return 2
    elif s2 > 0.08:
        return 2
    elif s2 < -0.08:
        return 0
    elif True:
        return 1
    return random.randint(0, 2)
