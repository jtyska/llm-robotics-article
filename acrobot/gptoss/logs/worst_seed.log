def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    import random
    c1 = cos_theta1
    s1 = sin_theta1
    c2 = cos_theta2
    s2 = sin_theta2
    v2 = ang_vel_theta2
    expr = -c1 - (c1 * c2 - s1 * s2)
    if expr > 1.0:
        return 1
    elif expr > 0.85:
        return 1
    elif c1 > 0:
        if expr < 0.6:
            if v2 > 0.2 and s2 < -0.02:
                return 2
            elif v2 < -0.2 and s2 > 0.02:
                return 0
            else:
                return 1
        else:
            return 1
    else:
        if abs(v2) > 0.15:
            if v2 > 0:
                return 2
            else:
                return 0
        else:
            if s2 > 0.02:
                return 2
            elif s2 < -0.02:
                return 0
            else:
                return 1
    return random.randint(0, 2)
