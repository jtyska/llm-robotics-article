        else:
            return 0  # push left
    # 4. SWING‑UP PHASE (first link at/above vertical)
    else:
        # high kinetic energy (preserve momentum)
        if e2 > 2.0:
            if v2 * s2 < 0:  # moving toward vertical → brake
                return 0 if v2 > 0 else 2
            else:  # moving away → coast
