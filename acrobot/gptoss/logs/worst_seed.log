```python
# --------------------------------------------------------------
#  Double‑pendulum swing‑up / balance controller
# --------------------------------------------------------------
#  obs = [c1, s1, c2, s2, v1, v2]

c1, s1, c2, s2, v1, v2 = obs
h = -c1 - (c1 * c2 - s1 * s2)          # tip‑height indicator

# --------------------------------------------------------------
# 1) Goal / near‑goal
# --------------------------------------------------------------
#   • If we are already above the target → do nothing.
#   • If we are just below the target (0.92 < h < 1.0) apply a *tiny*
#     corrective torque in the direction that would increase the height.
if h > 1.0:
    action = 1                                   # already solved
elif h > 0.92:
    # small corrective push (same sign as s2)
    if s2 > 0.02:
        action = 2                               # right torque
    elif s2 < -0.02:
        action = 0                               # left torque
    else:
        action = 1
    # (the torque is tiny – we keep the same discrete actions,
    #  but the rule makes the controller *prefer* the torque that
    #  would raise the tip)

# --------------------------------------------------------------
# 2) Priming phase – first link still below the pivot (c1 > 0)
# --------------------------------------------------------------
elif c1 > 0.0:
    # When the second link is almost still, give it a big kick
    if abs(v2) < 0.2 and abs(s2) > 0.1:
        action = 2 if s2 > 0 else 0
    # Otherwise follow the sign of s2 (move the link forward)
    elif s2 > 0.05:
        action = 2
    elif s2 < -0.05:
        action = 0
    # If s2 is near zero, use the velocity of the *first* joint to decide
    elif v1 > 0.5:
        action = 2
    elif v1 < -0.5:
        action = 0
    else:
        action = 1

# --------------------------------------------------------------
# 3) Swing‑up / balancing phase (c1 ≤ 0)
# --------------------------------------------------------------
else:
    # ---- 3a) Energy‑direction rule (primary) ----
    # v2 * s2 > 0  → the link is moving *away* from the upright position,
    #                so we *add* energy (torque in the same direction as v2).
    # v2 * s2 < 0  → the link is moving *towards* the upright position,
    #                so we *remove* energy (torque opposite to v2) to avoid
    #                overshooting.
    if abs(v2) > 0.15:
        if v2 * s2 > 0:                     # moving away → accelerate
            action = 2 if v2 > 0 else 0
        else:                               # moving towards → decelerate
            action = 0 if v2 > 0 else 2

    # ---- 3b) Low‑speed rescue (fallback) ----
    # When the second link is almost still we can still use the first joint
    # to pump energy into the system.
    elif abs(v2) <= 0.15:
        if abs(v1) > 0.8:                   # strong motion in joint 1
            # Pump energy in the direction that will increase s2
            action = 2 if (v1 * s2) > 0 else 0
        else:
            # Small corrective torque based on the sign of s2
            if s2 > 0.03:
                action = 2
            elif s2 < -0.03:
                action = 0
            else:
                action = 1

# --------------------------------------------------------------
#  Return the chosen discrete action (0 = left, 1 = none, 2 = right)
# --------------------------------------------------------------
return action
