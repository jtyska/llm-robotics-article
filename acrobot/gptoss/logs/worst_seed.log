        return 1
    elif abs(v1) < 0.05 and abs(v2) < 0.05:
        return 2 if s2 > 0 else 0
    elif h > 0.94:
        return 0 if p > 0 else 2
    elif h > 0.85:
        return 0 if p > 0 else 2
    elif E < 2.30:
        return 2 if p > 0 else 0
    else:
        return 0 if p > 0 else 2

    # fallback random action (should not be reached)
    return random.randint(0, 2)
