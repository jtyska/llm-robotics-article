import random

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    c1 = cos_theta1
    s1 = sin_theta1
    c2 = cos_theta2
    s2 = sin_theta2
    v1 = ang_vel_theta1
    v2 = ang_vel_theta2

    if -c1 - (c1 * c2 - s1 * s2) > 1.0:
        return 1
    elif c1 > 0.0:
        if v2 > 0.5:
            return 2
        elif v2 < -0.5:
            return 0
        else:
            if v1 < 0:
                return 2
            else:
                return 0
    else:  # c1 <= 0
        if abs(v2) > 0.2:
            if v2 > 0:
                return 2
            else:
                return 0
        else:
            if s2 > 0.1:
                return 2
            elif s2 < -0.1:
                return 0
            else:
                return 1
    # Default random action (should not be reached)
    return random.randint(0, 2)
