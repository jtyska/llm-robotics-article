    elif expr > 0.92 and abs(ang_vel_theta2) < 0.30:
        return 1
    elif cos_theta1 > 0.0:  # priming phase
        if ang_vel_theta2 > 0.25:
            return 2
        elif ang_vel_theta2 < -0.25:
            return 0
        else:
            if sin_theta2 > 0:
                return 2
            elif sin_theta2 < 0:
                return 0
            else:
                return 1
