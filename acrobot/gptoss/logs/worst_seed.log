def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    import random
    c1, s1, c2, s2, v1, v2 = cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2

    def sign(x):
        return 1 if x > 0 else -1 if x < 0 else 0

    h = -c1 - (c1 * c2 - s1 * s2)

    # Rule 1
    if h > 1.0:
        return 1
    # Rule 2
    elif h > 0.92 and abs(v2) < 0.4:
        return 1
    # Rule 3
    elif c1 > 0.0:
        if v2 > 0.20:
            return 2
        elif v2 < -0.20:
            return 0
        elif s2 > 0:
            return 2
        else:
            return 0
    # Rule 4 (c1 <= 0)
    else:
        E = 0.5 * v2 * v2 + (1.0 - c2)
        energy_error = E - 1.0

        if h < 0.4:
            if energy_error < -0.2:
                torque = 0.45 * sign(v2)
            else:
                torque = -0.45 * sign(v2)
        else:  # h >= 0.4
            torque = -0.70 * s2 - 0.55 * v2 + 0.08 * v1
            if abs(v2) > 0.35:
                if v2 * s2 < 0:
                    torque = -0.30 * sign(v2)
                else:
                    torque = 0.30 * sign(v2)

        # Clamp torque
        if abs(torque) > 0.45:
            torque = 0.45 * sign(torque)

        # Map torque to discrete action
        if torque > 0.12:
            return 2
        elif torque < -0.12:
            return 0
        else:
            return 1

    # Default random action (should not be reached)
    return random.randint(0, 2)
