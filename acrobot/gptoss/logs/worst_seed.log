def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    import random
    expr = -cos_theta1 - (cos_theta1 * cos_theta2 - sin_theta1 * sin_theta2)
    if expr > 1.0:
        return 1
    elif expr > 0.92 and abs(ang_vel_theta2) < 0.20:
        return 1
    elif cos_theta1 > 0.0:
        if sin_theta2 * ang_vel_theta2 > 0:
            if ang_vel_theta2 > 0.25:
                return 2
            else:
                return 0
        else:
            if abs(ang_vel_theta2) > 0.25:
                if ang_vel_theta2 > 0:
                    return 0
                else:
                    return 2
            else:
                return 1
    else:
        torque = 0.8 * sin_theta2 + 0.35 * ang_vel_theta2 + 0.05 * ang_vel_theta1
        if torque > 0.20:
            return 2
        elif torque < -0.20:
            return 0
        else:
            return 1
    # default fallback
    return random.randint(0, 2)
