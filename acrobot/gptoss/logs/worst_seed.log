        e_v2 = -v2
        e_v1 = -v1
        tau = 0.45 * e_h + 0.30 * e_v2 + 0.08 * e_v1
        if tau > 0.12:
            return 2
        elif tau < -0.12:
            return 0
        else:
            return 1
    else:
        if c1 > 0.0:
            if v2 > 0.25:
                return 2
            elif v2 < -0.25:
                return 0
            elif s2 > 0.0:
                return 2
            elif s2 < 0.0:
                return 0
            else:
