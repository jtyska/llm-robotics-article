import random
import math

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    c1 = cos_theta1
    s1 = sin_theta1
    c2 = cos_theta2
    s2 = sin_theta2
    v1 = ang_vel_theta1
    v2 = ang_vel_theta2

    h = -c1 - (c1 * c2 - s1 * s2)  # tip‑height indicator

    # Rule 1
    if h > 1.0:
        return 1
    # Rule 2
    if h > 0.92 and abs(v2) < 0.35:
        return 1
    # Priming phase
    if c1 > 0.0:
        if v2 > 0.20:
            return 2
        elif v2 < -0.20:
            return 0
        elif s2 > 0:
            return 2
        elif s2 < 0:
            return 0
        else:
            return 1
    # Swing‑up / Balancing phase (c1 <= 0)
    if abs(v2) > 0.40:
        Kp_h = 0.25
        Kp_v2 = 0.35
        Kp_v1 = 0.05
        bias = 0.0
    else:
        Kp_h = 0.45
        Kp_v2 = 0.30
        Kp_v1 = 0.10
        bias = 0.05 * h

    e_h = 1.0 - h
    e_v2 = -v2
    e_v1 = -v1
    tau = Kp_h * e_h + Kp_v2 * e_v2 + Kp_v1 * e_v1 + bias

    tau = max(min(tau, 0.6), -0.6)

    if tau > 0.12:
        return 2
    elif tau < -0.12:
        return 0
    else:
        return 1

    # Fallback (should not be reached)
    return random.randint(0, 2)
