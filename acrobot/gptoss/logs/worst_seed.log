def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    import random
    c1 = cos_theta1
    s1 = sin_theta1
    c2 = cos_theta2
    s2 = sin_theta2
    v1 = ang_vel_theta1
    v2 = ang_vel_theta2

    height = -c1 - (c1 * c2 - s1 * s2)
    E_est = height + 0.5 * (v1 ** 2 + v2 ** 2)

    if height > 1.0:
        return 1
    elif E_est < 0.8:
        if v1 > 0.0:
            return 0
        elif v1 < 0.0:
            return 2
        else:
            if v2 > 0.0:
                return 2
            else:
                return 0
    elif c1 <= 0.0:
        if v2 > 0.5:
            return 2
        elif v2 < -0.5:
            return 0
        else:
            if s2 > 0.0:
                return 2
            else:
                return 0
    elif height > 0.8:
        if s2 > 0.05:
            return 2
        elif s2 < -0.05:
            return 0
        else:
            return 1
    else:
        return 1
    return random.randint(0, 2)
