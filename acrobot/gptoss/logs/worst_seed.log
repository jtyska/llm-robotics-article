def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    import random
    c1 = cos_theta1
    s1 = sin_theta1
    c2 = cos_theta2
    s2 = sin_theta2
    v1 = ang_vel_theta1
    v2 = ang_vel_theta2

    term = -c1 - (c1 * c2 - s1 * s2)
    expr = s1 * v1 + v1 * (s1 * c2 + c1 * s2) + v2 * (c1 * s2 + s1 * c2)

    if term > 1.0:
        return 1
    elif term > 0.85:
        if expr > 0.01:
            return 1
        elif expr > 0:
            return 2
        else:
            return 0
    elif c1 > 0.0:
        if term < 0.4:
            if abs(v1) < 0.2 and abs(v2) < 0.2:
                if s2 > 0:
                    return 2
                elif s2 < 0:
                    return 0
                else:
                    return 1
            else:
                if v2 > 0:
                    return 2
                elif v2 < 0:
                    return 0
                else:
                    return 1
        else:
            if expr < -0.02:
                if v2 < 0:
                    return 2
                elif v2 > 0:
                    return 0
                else:
                    return 1
            else:
                return 1
    else:  # c1 <= 0.0
        if term < 0.85:
            if abs(v2) < 0.15:
                if s2 > 0:
                    return 2
                elif s2 < 0:
                    return 0
                else:
                    return 1
            else:
                if v2 > 0:
                    return 2
                elif v2 < 0:
                    return 0
                else:
                    return 1
        else:
            if expr < -0.01:
                if v2 < 0:
                    return 2
                elif v2 > 0:
                    return 0
                else:
                    return 1
            else:
                return 1
    return random.randint(0, 2)
