import random

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    c1 = cos_theta1
    s1 = sin_theta1
    c2 = cos_theta2
    s2 = sin_theta2
    v1 = ang_vel_theta1
    v2 = ang_vel_theta2

    h = -c1 - (c1 * c2 - s1 * s2)

    # 1️⃣ Goal / near‑goal
    if h > 1.0:
        return 1
    elif h > 0.92 and -0.1 < v2 < 0.3:
        return 1

    # 2️⃣ Priming phase – first link still below vertical
    elif c1 > 0.0:
        if v2 > 0.25:
            return 2
        elif v2 < -0.25:
            return 0
        else:
            return 2 if s2 > 0 else 0

    # 3️⃣ Swing‑up / balancing phase – first link already above vertical
    else:
        if abs(v2) > 0.20:
            prod = v2 * s2
            if prod < 0:
                return 0 if v2 > 0 else 2
            else:
                return 2 if v2 > 0 else 0
        else:
            if s2 > 0.12:
                return 2
            elif s2 < -0.12:
                return 0
            else:
                return 1

    # default random action
    return random.randint(0, 2)
