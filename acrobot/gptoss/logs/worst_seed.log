def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    import random
    expr = -cos_theta1 - (cos_theta1 * cos_theta2 - sin_theta1 * sin_theta2)
    # Rule 1: Goal reached
    if expr > 1.0:
        return 1
    # Rule 2: Coast near goal
    if expr > 0.95 and abs(ang_vel_theta2) < 0.8:
        return 1
    # Rule 3: Priming phase (first link still down)
    if cos_theta1 > 0.0:
        if ang_vel_theta2 > 0.2:
            return 2
        elif ang_vel_theta2 < -0.2:
            return 0
        elif sin_theta2 > 0:
            return 2
        else:
            return 0
    # Rule 4: Swing‑up phase, enough kinetic energy
    if cos_theta1 <= 0.0 and 0.5 * ang_vel_theta2 * ang_vel_theta2 > 2.0:
        if ang_vel_theta2 * sin_theta2 < 0:
            if ang_vel_theta2 > 0:
                return 0
            else:
                return 2
        else:
            return 1
    # Rule 5: Swing‑up phase, not enough kinetic energy
    if cos_theta1 <= 0.0 and 0.5 * ang_vel_theta2 * ang_vel_theta2 <= 2.0:
        if ang_vel_theta2 * sin_theta2 > 0:
            if ang_vel_theta2 > 0:
                return 2
            else:
                return 0
        else:
            if ang_vel_theta2 > 0:
                if ang_vel_theta1 > 2.0:
                    return 2
                else:
                    return 0
            else:
                if ang_vel_theta1 < -2.0:
                    return 0
                else:
                    return 2
    # Default random action
    return random.randint(0, 2)
