import random

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    c1 = cos_theta1
    s1 = sin_theta1
    c2 = cos_theta2
    s2 = sin_theta2
    v2 = ang_vel_theta2

    h = -c1 - (c1 * c2 - s1 * s2)

    if h > 1.0:
        return 1
    elif h > 0.94:
        err_h = 1.0 - h
        tau = 0.45 * err_h - 0.30 * v2
        if tau > 0.12:
            return 2
        elif tau < -0.12:
            return 0
        else:
            return 1
    elif c1 > 0.0:
        if v2 > 0.25:
            return 2
        elif v2 < -0.25:
            return 0
        elif s2 > 0:
            return 2
        elif s2 < 0:
            return 0
        else:
            return 1
    else:
        if abs(v2) > 0.35:
            if v2 * s2 < 0:
                if v2 < 0:
                    return 2
                else:
                    return 0
            else:
                if v2 < 0:
                    return 0
                else:
                    return 2
        else:
            kin_energy = 0.5 * v2 * v2
            err_E = 7.0 - kin_energy
            tau = 0.45 * err_E - 0.30 * v2
            if tau > 0.12:
                return 2
            elif tau < -0.12:
                return 0
            elif s2 > 0.12:
                return 2
            elif s2 < -0.12:
                return 0
            else:
                return 1
    return random.randint(0, 2)
