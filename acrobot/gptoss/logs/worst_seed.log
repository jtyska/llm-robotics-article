import random
import math

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    # compute height metric h = -cos(theta1) - cos(theta1+theta2)
    cos_theta1_plus_theta2 = cos_theta1 * cos_theta2 - sin_theta1 * sin_theta2
    h = -cos_theta1 - cos_theta1_plus_theta2

    v2 = ang_vel_theta2
    s2 = sin_theta2
    c1 = cos_theta1

    if h > 1.0:
        return 1
    elif h > 0.92 and abs(v2) < 0.45:
        return 1
    elif c1 > 0.0:
        if v2 * s2 > 0:
            if abs(v2) < 0.6:
                if v2 > 0:
                    return 2
                else:
                    return 0
            else:
                return 1
        else:
            if v2 > 0:
                return 0
            else:
                return 2
    else:
        if v2 * s2 > 0 and abs(v2) > 0.7:
            return 1
        elif v2 * s2 > 0 and abs(v2) <= 0.7:
            if v2 > 0:
                return 2
            else:
                return 0
        else:
            if v2 > 0:
                return 0
            else:
                return 2

    # default random action (should never be reached)
    return random.randint(0, 2)
