H_NEAR      = 0.94          # start balancing a little before the exact goal
V2_BIG      = 0.35          # “fast swing” threshold
S2_DEADZONE = 0.12          # narrower dead‑zone for the final balance
PD_GAIN_H   = 0.45          # proportional gain on height error (when near goal)
PD_GAIN_V2  = 0.30          # derivative gain on v2 (when near goal)
PD_GAIN_V1  = 0.08          # small contribution of the first‑joint velocity
PD_MAX_TAU  = 0.6           # clip the PD torque to keep it in the action range

# --------------------------------------------------------------
