import random

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    c1 = cos_theta1
    s1 = sin_theta1
    c2 = cos_theta2
    s2 = sin_theta2
    v1 = ang_vel_theta1
    v2 = ang_vel_theta2

    h = -c1 - (c1 * c2 - s1 * s2)          # tip height
    v_tip = v1 + v2                        # total tip angular velocity
    prod = v2 * s2                         # moving‑toward‑top indicator

    # Rule set
    if h > 1.0:
        return 1
    elif h > 0.94 and v_tip > 0:
        return 2
    elif h > 0.94 and v_tip < 0:
        return 0
    elif c1 > 0:
