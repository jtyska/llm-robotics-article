def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    import random
    c1 = cos_theta1
    s1 = sin_theta1
    c2 = cos_theta2
    s2 = sin_theta2
    v1 = ang_vel_theta1
    v2 = ang_vel_theta2

    h = -c1 - (c1 * c2 - s1 * s2)

    if h > 1.0:
        return 1
    elif h > 0.92 and abs(v2) < 0.35:
        return 1
    elif c1 > 0.0:  # priming phase
        if v2 > 0.10:
            return 2
        elif v2 < -0.10:
            return 0
        elif s2 > 0.0:
            return 2
        elif s2 < 0.0:
            return 0
        else:
            return 1
    else:  # c1 ≤ 0 : swing‑up / balancing phase
        if abs(v2) > 0.40:
            if v2 * s2 > 0.0:
                return 2 if v2 > 0 else 0
            else:
                return 0 if v2 > 0 else 2
        elif abs(v2) > 0.20:
            if v2 * s2 > 0.0:
                return 2 if v2 > 0 else 0
            else:
                if abs(v1) > 1.0:
                    return 1
                else:
                    return 0 if v2 > 0 else 2
        else:  # |v2| ≤ 0.20
            if s2 > 0.08:
                return 2
            elif s2 < -0.08:
                return 0
            else:
                if v1 > 0.5:
                    return 2
                elif v1 < -0.5:
                    return 0
                else:
                    return 1
    return random.randint(0, 2)
