import random

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    expr = -cos_theta1 - (cos_theta1 * cos_theta2 - sin_theta1 * sin_theta2)
    sum_vel = ang_vel_theta1 + ang_vel_theta2

    if expr > 1.0:
        return 1
    elif expr > 0.96 and abs(sum_vel) < 0.25:
        return 1
    elif expr > 0.96 and sum_vel > 0:
        return 2 if sin_theta2 > 0 else 0
    elif expr > 0.96 and sum_vel < 0:
        return 2 if sin_theta2 < 0 else 0
    elif cos_theta1 > 0:
        if abs(ang_vel_theta2) > 0.2:
            return 2 if ang_vel_theta2 > 0 else 0
        elif abs(sin_theta2) > 0.1:
            return 2 if sin_theta2 > 0 else 0
        else:
            return 1
    else:  # first link already above vertical (cos_theta1 <= 0)
        if abs(ang_vel_theta2) > 0.3:
            return 2 if (ang_vel_theta2 * sin_theta2) > 0 else 0
        elif abs(sin_theta2) > 0.2:
            return 2 if sin_theta2 > 0 else 0
        elif abs(sum_vel) > 0.15:
            return 2 if sum_vel > 0 else 0
        else:
            return 1

    # fallback random action (should not be reached)
    return random.randint(0, 2)
