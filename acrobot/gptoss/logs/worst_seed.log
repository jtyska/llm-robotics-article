# total tip angular velocity
v_tip = v1 + v2
# -------------------------------------------------
#  1.  Goal / near‑goal region
if h > 1.0:                         # already solved
    action = 1                     # do nothing
elif h > 0.96:                     # we are above the top, just keep it steady
    if v_tip < -0.2:               # still falling → give a right push
        action = 2
    elif v_tip >  0.2:            # still rising too fast → brake with left push
        action = 0
    else:
