            # We still respect the sign of s2 but add a tiny dead‑zone to avoid
            # jitter when the second link is almost vertical.
            if   s2 >  S2_DEADZONE: action = 2
            elif s2 < -S2_DEADZONE: action = 0
            else:                    action = 1
