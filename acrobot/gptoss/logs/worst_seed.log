### 3️⃣  Updated rule set (pseudo‑code)

```python
# ------------------------------------------------------------------
#  Helper variables
c1 = obs[0]          # cos(theta1)
s1 = obs[1]          # sin(theta1)
c2 = obs[2]          # cos(theta2)
s2 = obs[3]          # sin(theta2)
v1 = obs[4]          # angular velocity of joint 1
v2 = obs[5]          # angular velocity of joint 2

# tip‑height indicator (same as before)
h  = -c1 - (c1*c2 - s1*s2)

# tip angular velocity (sum of the two joint rates)
v_tip = v1 + v2
# ------------------------------------------------------------------

# 1. Goal / near‑goal ------------------------------------------------
if h > 1.0:
    action = 1                                 # already succeeded, do nothing
elif h > 0.88:                                 # “almost there’’
    # keep torque in the direction of the second link as long as the tip is still moving up
    if v_tip > 0.0:
        action = 2 if s2 > 0 else 0
    else:
        action = 1                             # tip already descending → stop
    # --------------------------------------------------------------

# 2. Priming phase – first link still below vertical -----------------
elif c1 > 0.0:                                 # theta1 in (-π/2 , +π/2)
    # push the second joint hard enough to give the whole chain energy
    if v2 > 0.30:
        action = 2
    elif v2 < -0.30:
        action = 0
    else:
        # if we have almost no velocity, use the sign of s2 as a crude “pump’’
        action = 2 if s2 > 0 else (0 if s2 < 0 else 1)

# 3. Swing‑up / balancing phase (first link already above vertical) --
else:                                          # c1 <= 0
    # a) high speed – keep torque aligned with the direction of motion
    if abs(v2) > 0.35:
        # if torque and link orientation have opposite sign we are “braking’’,
        # otherwise we are “accelerating’’ – accelerate
        if v2 * s2 > 0:
            action = 2 if v2 > 0 else 0
        else:
            action = 0 if v2 > 0 else 2

    # b) moderate speed – use tip‑velocity to decide whether to keep pushing
    elif abs(v2) > 0.15:
        if v_tip > 0.2:                         # tip still climbing
            action = 2 if s2 > 0 else 0
        else:                                   # tip already slowing down
            action = 1

    # c) low speed – rely on the sign of s2 but add a tiny dead‑zone
    else:
        if s2 > 0.07:
            action = 2
        elif s2 < -0.07:
            action = 0
        else:
            action = 1
# ------------------------------------------------------------------
```

