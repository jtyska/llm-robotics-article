import math, random

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    # compute height = -cos(theta1) - cos(theta1+theta2)
    height = -cos_theta1 - (cos_theta1 * cos_theta2 - sin_theta1 * sin_theta2)
    if height > 1.0:
        # termination condition; return a neutral action
        return 1
    elif height > 0.8:
        return 1
    elif abs(sin_theta2) < 0.15 and ang_vel_theta1 < -2.0:
        return 2
    elif abs(sin_theta2) < 0.15 and ang_vel_theta1 > 2.0:
        return 0
    elif sin_theta2 > 0.3 and ang_vel_theta2 < 0:
        return 2
    elif sin_theta2 < -0.3 and ang_vel_theta2 > 0:
        return 0
    elif cos_theta1 > -0.2 and ang_vel_theta1 < -0.5:
        return 2
    elif cos_theta1 > -0.2 and ang_vel_theta1 > 0.5:
        return 0
    elif abs(cos_theta1) > 0.9 and abs(ang_vel_theta2) < 0.3:
        return 2 if ang_vel_theta2 > 0 else 0
    else:
        return random.randint(0, 2)
