import random

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    c1 = cos_theta1
    s1 = sin_theta1
    c2 = cos_theta2
    s2 = sin_theta2
    v1 = ang_vel_theta1
    v2 = ang_vel_theta2

    term = -c1 - (c1 * c2 - s1 * s2)

    # Rule 1
    if term > 1.0:
        return 1

    # Rule 2
    if term > 0.9 and (abs(v1) + abs(v2)) < 0.3:
        return 1

    # Rule 3
    if abs(v1) < 0.05 and abs(v2) < 0.05 and term < 0.5:
        if s1 > 0:
            return 2
        else:
            return 0

    # Rule 4
    if term < 0.7:
        if (v1 + v2) > 0.2:
            return 2
        elif (v1 + v2) < -0.2:
            return 0
        else:
            return 1

    # Rule 5
    if v2 > 0.2 and s2 > 0:
        return 2
    elif v2 > 0.2 and s2 <= 0:
        return 0
    elif v2 < -0.2 and s2 < 0:
        return 0
    elif v2 < -0.2 and s2 >= 0:
        return 2
    else:
        return 1

    # Default random action (should not be reached)
    return random.randint(0, 2)
