```python
def policy(obs):
    # ----- unpack observation -------------------------------------------------
    c1, s1, c2, s2, v1, v2 = obs          # cosθ1, sinθ1, cosθ2, sinθ2, ω1, ω2

    # ----- tip‑height indicator (same as termination condition) -------------
    h = -c1 - (c1 * c2 - s1 * s2)        # = -cosθ1 - cos(θ1+θ2)

    # ----- parameters ---------------------------------------------------------
    # swing‑up torque direction is decided by total angular momentum
    total_vel = v1 + v2
    # proportional / derivative gains for the balancing phase
    Kp = 0.8      # torque magnitude for angle error
    Kd = 0.4      # torque magnitude for angular velocity

    # ----- 1️⃣  Goal / near‑goal -----------------------------------------------
    if h > 1.0:                         # already above the target height
        return 1                       # coast – episode will terminate

    # near‑goal: start damping, keep the tip high but do not overshoot
    if 0.92 < h <= 1.0:
        # continuous torque (may be -1, 0, +1); we later map to {0,1,2}
        torque = -Kp * s2 - Kd * v2
        # discretise
        if torque > 0.2:   return 2      # right torque
        if torque < -0.2:  return 0      # left torque
        return 1                        # small torque → coast

    # ----- 2️⃣  Priming / energy‑building phase (first link still down) -------
    if c1 > 0.0:                        # first link below vertical
        # Use total angular momentum to decide direction
        if total_vel > 0.1:
            return 2                  # push right
        if total_vel < -0.1:
            return 0                  # push left

        # If the chain is almost still, use the sign of the second link angle
        if s2 > 0:
            return 2
        if s2 < 0:
            return 0
        return 1                      # perfectly vertical → coast

    # ----- 3️⃣  Swing‑up / balancing phase (first link already up) ------------
    # At this point c1 <= 0 (first link above vertical)
    # --------------------------------------------------------------
    # a) strong motion – keep feeding energy in the *same* direction
    if abs(v2) > 0.35:
        # If the velocity is *away* from the upright (v2 and s2 have opposite sign)
        if v2 * s2 < 0:
            # reverse torque to bring it back
            return 0 if v2 > 0 else 2
        else:
            # torque *with* the motion to keep building energy
            return 2 if v2 > 0 else 0

    # b) weak motion – start damping, but keep a small corrective push
    #    (this is the classic linear controller)
    torque = -Kp * s2 - Kd * v2
    if torque > 0.2:
        return 2
    if torque < -0.2:
        return 0
    return 1
```

