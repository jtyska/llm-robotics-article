    # Balancing phase – first link already above vertical
    torque_sign = - (1 if s2 > 0 else -1) - 0.5 * v2
    if torque_sign > 0.2:
        return 2
    elif torque_sign < -0.2:
        return 0
    else:
        return 1
    # Default random action (should not be reached)
    return random.randint(0, 2)
