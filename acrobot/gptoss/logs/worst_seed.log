import math, random

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    # helper values
    v1 = ang_vel_theta1
    v2 = ang_vel_theta2
    c1 = cos_theta1
    s2 = sin_theta2

    # compute height h = -cos(theta1) - cos(theta1+theta2)
    h = -cos_theta1 - (cos_theta1 * cos_theta2 - sin_theta1 * sin_theta2)

    # approximate total mechanical energy (potential + kinetic)
    potential = -cos_theta1 - (cos_theta1 * cos_theta2 - sin_theta1 * sin_theta2)
    kinetic = 0.5 * (ang_vel_theta1 ** 2 + ang_vel_theta2 ** 2)
    E = potential + kinetic

    # Rule 1
    if h > 1.0:
        return 1

    # Rule 2
    elif h > 0.94:
        err_h = 1.0 - h
        tau = 0.70 * err_h - 0.25 * v2 - 0.10 * v1
        if tau > 0.08:
            return 2
        elif tau < -0.08:
            return 0
        else:
            return 1

    # Rule 3
    elif c1 > 0.0:
        if v2 > 0.30:
            return 2
        elif v2 < -0.30:
            return 0
        elif s2 > 0.0:
            return 2
        elif s2 < 0.0:
            return 0
        else:
            return 1

    # Rule 4
    elif abs(v2) > 0.35 or E > 6.0:
        if v2 * s2 < 0:  # moving opposite to its current angle
            if v2 > 0:
                return 0
            else:
                return 2
        else:  # moving towards zero
            if v2 > 0:
                return 2
            else:
                return 0

    # Rule 5 (low‑energy region)
    else:
        err_angle = 1.0 - s2
        tau = 0.45 * err_angle - 0.20 * v2
        if tau > 0.06:
            return 2
        elif tau < -0.06:
            return 0
        else:
            return 1

    # default random action (should not be reached)
    return random.randint(0, 2)
