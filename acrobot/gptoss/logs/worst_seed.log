        torque = (-0.45) * (ang_vel_theta2 * sin_theta2) + 0.12 * ang_vel_theta1 - 0.20 * ang_vel_theta2 + 0.15 * cos_theta2
        if abs(sin_theta2) < 0.10:
            torque = 0.5 * torque + 0.2 * (-sin_theta2)
        if torque > 0.25:
            return 2
        elif torque < -0.25:
            return 0
        else:
            return 1
    return random.randint(0, 2)
