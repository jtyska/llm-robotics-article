def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    import random
    c1 = cos_theta1
    s1 = sin_theta1
    c2 = cos_theta2
    s2 = sin_theta2
    v1 = ang_vel_theta1
    v2 = ang_vel_theta2
    h = -c1 - (c1 * c2 - s1 * s2)
