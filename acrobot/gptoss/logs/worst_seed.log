import random

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    obs0 = cos_theta1
    obs1 = sin_theta1
    obs2 = cos_theta2
    obs3 = sin_theta2
    obs4 = ang_vel_theta1
    obs5 = ang_vel_theta2

    action = None

    h = -obs0 - (obs0 * obs2 - obs1 * obs3)

    if h > 1.0:
        action = 1
    elif h > 0.92 and abs(obs5) < 0.25:
        action = 1
    elif obs0 > 0.0:
        if obs5 > 0.20:
            action = 2
        elif obs5 < -0.20:
            action = 0
        else:
            if obs3 > 0:
                action = 2
            elif obs3 < 0:
                action = 0
            else:
                action = 1
    else:
        e_h = 1.0 - h
        e_v = -obs5
        e_f = -obs4
        torque = 0.45 * e_h + 0.30 * e_v + 0.10 * e_f
        if abs(e_h) > 0.15:
            torque += 0.20 * obs3
        if torque > 0.6:
            torque = 0.6
        if torque < -0.6:
            torque = -0.6
        if torque > 0.18:
            action = 2
        elif torque < -0.18:
            action = 0
        else:
            action = 1

    if action is None:
        action = random.randint(0, 2)

    return action
