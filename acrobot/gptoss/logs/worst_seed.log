        elif v2 < 0.0:
            if s2 < 0.0:
                return 0
            else:
                return 1
        else:  # v2 approx 0
            if s2 > 0.0:
                return 2
            else:
                return 0

    # 3. Swing‑up / balancing phase – first link already above vertical
    if abs(v2) >= 0.45:
        if v2 * s2 > 0.0:  # moving outward
            return 2 if v2 > 0.0 else 0
        else:               # moving inward
            return 0 if v2 > 0.0 else 2
    elif abs(v2) >= 0.15:
        if abs(s2) > 0.3:
            return 2 if v2 > 0.0 else 0
        else:
            if v2 * s2 > 0.0:
                return 1
            else:
                return 0 if v2 > 0.0 else 2
    else:  # abs(v2) < 0.15 (slow regime)
        if s2 > 0.0:
            return 2
        elif s2 < 0.0:
            return 0
        else:
            return 1

    # default random action
    return random.randint(0, 2)
