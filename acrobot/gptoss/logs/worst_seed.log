        # low/medium kinetic energy (pump swing)
        else:
            if v2 * s2 > 0:  # moving away from vertical → push further
                return 2 if v2 > 0 else 0
            else:  # moving toward vertical → apply opposite torque
                return 0 if v2 > 0 else 2

    # default random action
    return random.randint(0, 2)
