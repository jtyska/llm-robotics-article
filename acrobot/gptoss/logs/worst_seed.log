    elif s12 < -0.8 and v1 > 2.0:
        return 0
    elif s12 > 0.2 and v12 > 0.5:
        return 2
    elif s12 > 0.2 and v12 < -0.5:
        return 0
    elif abs(v12) < 0.4 and abs(s12) < 0.4:
        return 1
    else:
