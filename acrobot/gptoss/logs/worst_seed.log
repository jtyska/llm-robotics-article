def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    # compute derived quantities
    # height term h = -cos(theta1) - cos(theta1+theta2)
    cos_theta12 = cos_theta1 * cos_theta2 - sin_theta1 * sin_theta2
    h = -cos_theta1 - cos_theta12

    v1 = ang_vel_theta1
    v2 = ang_vel_theta2

    s2 = sin_theta2

    # use angular velocity of second joint as p (sign variable)
    p = ang_vel_theta2

