# Helper extraction
c1 = obs[0]          # cos(theta1)
s1 = obs[1]          # sin(theta1)
c2 = obs[2]          # cos(theta2)
s2 = obs[3]          # sin(theta2)
v1 = obs[4]          # angular velocity of joint 1 (unused)
v2 = obs[5]          # angular velocity of joint 2 (actuated)

