def new_strategy(observation):
    # Unpack the observation
    x1, theta1, x2, theta2, dtheta1, dtheta2 = observation

    # Define thresholds for angles and angular velocities
    angle_threshold = 0.2
    angular_velocity_threshold = 5.0

    # Determine actions based on the state of each pole
    action1 = 0 if (abs(theta1) > angle_threshold or dtheta1 > angular_velocity_threshold) else 1
    action2 = 0 if (abs(theta2) > angle_threshold or dtheta2 > angular_velocity_threshold) else 1

    # Combine actions for both poles
    if action1 == 0 and action2 == 0:
        return 0  # Move left
    elif action1 == 1 and action2 == 1:
        return 2  # Move right
    else:
        return 1  # Do nothing (stay still)

# Example usage
