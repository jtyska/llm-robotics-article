    theta2 = np.arctan2(sin_theta2, cos_theta2)
    
    # Heuristic rules based on the angles and angular velocities
    if abs(theta1) > 0.2 or abs(theta2) > 0.2:
        # If either pole is significantly tilted, apply a force to counteract it
        if theta1 < -0.2:
            return 1  # Push right
        elif theta1 > 0.2:
            return 0  # Push left
        elif theta2 < -0.2:
            return 1  # Push right
        else:
            return 0  # Push left
    else:
        # If the poles are relatively stable, apply a force to counteract angular velocity
        if theta_dot1 > 0.5 or theta_dot2 > 0.5:
            return 0  # Push left
        elif theta_dot1 < -0.5 or theta_dot2 < -0.5:
            return 1  # Push right
        else:
            # Introduce a small random perturbation to avoid getting stuck in local minima
            if np.random.rand() < 0.1:
                return np.random.choice([0, 1])
            else:
                return 0  # Default action

