def updated_strategy(state):
    cart_pos, cart_vel, pole1_angle, pole1_angular_vel, pole2_angle, pole2_angular_vel = state
    
    # Define thresholds for angles and angular velocities
    angle_threshold = 0.3
    angular_vel_threshold = 5.0
    
