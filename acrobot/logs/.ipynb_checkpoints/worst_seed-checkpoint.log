def new_strategy(observation):
    cos_theta1, sin_theta1, cos_theta2, sin_theta2, cart_velocity, angular_velocity1, angular_velocity2 = observation
    
    # Convert to angles in radians
    theta1 = np.arctan2(sin_theta1, cos_theta1)
    theta2 = np.arctan2(sin_theta2, cos_theta2)
    
    # Determine the direction and magnitude of tilt for each pole
    tilt1 = np.abs(theta1)
    tilt2 = np.abs(theta2)
    
    # Determine if poles are moving fast (high angular velocity)
    fast_motion1 = np.abs(angular_velocity1) > 0.5
    fast_motion2 = np.abs(angular_velocity2) > 0.5
    
    # Rule-based decision-making
    if tilt1 > 0.3 or fast_motion1:
        if theta1 < 0:  # Pole tilting to the right
            return 2  # Push cart to the right
        else:  # Pole tilting to the left
            return 0  # Push cart to the left
    
    if tilt2 > 0.3 or fast_motion2:
        if theta2 < 0:  # Pole tilting to the right
            return 2  # Push cart to the right
        else:  # Pole tilting to the left
            return 0  # Push cart to the left
    
    # If neither pole is in a critical state, use a simple heuristic
    if cart_velocity < -0.5:
        return 2  # Push cart to the right
    elif cart_velocity > 0.5:
        return 0  # Push cart to the left
    else:
        return 1  # Do nothing (or choose randomly between 0 and 2)
```

