def improved_strategy(observation):
    cos_theta1, sin_theta1, cos_theta2, sin_theta2, theta_dot1, theta_dot2 = observation

    # Calculate angles from cosine and sine values
    angle1 = np.arctan2(sin_theta1, cos_theta1)
    angle2 = np.arctan2(sin_theta2, cos_theta2)

    # Define thresholds for angular velocities and angles
    vel_threshold = 5.0
    angle_threshold = np.pi / 4

    # Check if the poles are close to falling
    if abs(angle1) > angle_threshold or abs(theta_dot1) > vel_threshold:
        return 2 if angle1 < 0 else 0
    if abs(angle2) > angle_threshold or abs(theta_dot2) > vel_threshold:
        return 2 if angle2 < 0 else 0

    # Fallback to a simple balancing rule
    if theta_dot1 + theta_dot2 > 0.5:
        return 2  # Move right
    elif theta_dot1 + theta_dot2 < -0.5:
        return 0  # Move left
    else:
        return 1  # No action

# Example usage
