import numpy as np

def new_strategy(observation):
    # Extract observations
    x1, theta1, x2, theta2, dtheta1, dtheta2 = observation
    
    # Weights for angles and angular velocities
    angle_weight = 0.5
    velocity_weight = 0.5
    
    # Combined state
    combined_state = (angle_weight * (theta1 + theta2) + velocity_weight * (dtheta1 + dtheta2))
    
    # Dynamic thresholding
    if combined_state > 0.3:
        action = 0  # Push left
    elif combined_state < -0.3:
        action = 2  # Push right
    else:
        action = 1  # Do nothing
    
    return action
```

