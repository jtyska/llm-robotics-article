def updated_strategy(observation):
    cos_theta1, sin_theta1, cos_theta2, sin_theta2, x_dot, theta1_dot, theta2_dot = observation

    # Calculate the angles in radians
    theta1 = math.atan2(sin_theta1, cos_theta1)
    theta2 = math.atan2(sin_theta2, cos_theta2)

    # Define thresholds for angle and velocity
    angle_threshold = 0.2
    velocity_threshold = 1.0

    # Check the angles of both poles
    if abs(theta1) > angle_threshold or abs(theta2) > angle_threshold:
        # If either pole is significantly tilted, take action to balance it
        if theta1 < -angle_threshold and theta2 < -angle_threshold:
            return 2  # Move Right
        elif theta1 > angle_threshold and theta2 > angle_threshold:
            return 0  # Move Left

    # Check the velocities
    if abs(x_dot) > velocity_threshold or abs(theta1_dot) > velocity_threshold or abs(theta2_dot) > velocity_threshold:
        # If the cart or poles are moving too fast, take action to slow down
        if x_dot < -velocity_threshold or theta1_dot < -velocity_threshold or theta2_dot < -velocity_threshold:
            return 2  # Move Right
        elif x_dot > velocity_threshold or theta1_dot > velocity_threshold or theta2_dot > velocity_threshold:
            return 0  # Move Left

    # If the angles and velocities are within acceptable limits, do nothing (or maintain current direction)
    return 1  # Do Nothing

