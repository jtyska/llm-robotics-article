def new_strategy(observation):
    angle = observation[1]
    angular_velocity = observation[4]
    cart_position = observation[0]
    
    # Define thresholds for strong and mild actions
    angle_threshold = 0.2
    angular_velocity_threshold = 1.0
    
    if abs(cart_position) > 2.5:  # Limit cart movement to avoid extreme positions
        return 1 if cart_position < 0 else 2
    
    if angle > angle_threshold:
        if angular_velocity > angular_velocity_threshold:
            return 2  # Strong move right
        elif angular_velocity < -angular_velocity_threshold:
            return 1  # Milder move left
        else:
            return 2  # Move right
    elif angle < -angle_threshold:
        if angular_velocity > angular_velocity_threshold:
            return 1  # Milder move right
        elif angular_velocity < -angular_velocity_threshold:
            return 2  # Strong move left
        else:
            return 1  # Move left
    else:
        # If the angle is within a small range, maintain balance with milder actions
        if angular_velocity > 0.5:
            return 2  # Milder move right
        elif angular_velocity < -0.5:
            return 1  # Milder move left
        else:
            return 1  # Neutral action, do nothing or small adjustment

