import math
import random

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    # Define thresholds for angles and angular velocities
    angle_threshold = 0.2
    velocity_threshold = 2.0

    # Calculate the angles from sine and cosine values
    theta1 = math.atan2(sin_theta1, cos_theta1)
    theta2 = math.atan2(sin_theta2, cos_theta2)

    # Determine the action based on the current state
    if abs(theta1) > angle_threshold or abs(ang_vel_theta1) > velocity_threshold:
        if theta1 > 0:
            return 0  # Move left
        else:
            return 2  # Move right
    elif abs(theta2) > angle_threshold or abs(ang_vel_theta2) > velocity_threshold:
        if theta2 > 0:
            return 0  # Move left
        else:
            return 2  # Move right
    else:
        return 1  # No movement

    return random.randint(0, 2)

