def updated_strategy(observation):
    cart_position, cart_velocity, pole_angle, pole_angular_velocity, _, _ = observation
    
    # Define thresholds for decision-making
    angle_threshold = 0.15
    angular_velocity_threshold = 1.0
    
    if pole_angle > angle_threshold:
        action = 0  # Move cart to the left
    elif pole_angle < -angle_threshold:
        action = 2  # Move cart to the right
    else:
        if pole_angular_velocity > angular_velocity_threshold:
            action = 0  # Move cart to the left
        elif pole_angular_velocity < -angular_velocity_threshold:
            action = 2  # Move cart to the right
        else:
            if cart_velocity > 1.5:
                action = 0  # Move cart to the left
            elif cart_velocity < -1.5:
                action = 2  # Move cart to the right
            else:
                action = 1  # Do nothing (default action)
    
    return action
```

