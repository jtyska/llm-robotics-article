import math
import random

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    theta1 = math.atan2(sin_theta1, cos_theta1)
    theta2 = math.atan2(sin_theta2, cos_theta2)

    angle_threshold = 0.2
    angular_velocity_threshold = 1.5

    if abs(theta1) > angle_threshold or abs(ang_vel_theta1) > angular_velocity_threshold:
        if theta1 < 0:
            action = 2
        else:
            action = 0
    elif abs(theta2) > angle_threshold or abs(ang_vel_theta2) > angular_velocity_threshold:
        if theta2 < 0:
            action = 2
        else:
            action = 0
    else:
        action = 1

    return action if action is not None else random.randint(0, 2)

