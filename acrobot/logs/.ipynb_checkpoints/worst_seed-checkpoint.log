        # High positive angular velocity, move in the opposite direction
        return 0 if cart_velocity < 0 else 2
    
    if pole1_angular_velocity < -angular_velocity_threshold or pole2_angular_velocity < -angular_velocity_threshold:
        # High negative angular velocity, move in the same direction
        return 0 if cart_velocity > 0 else 2
    
    # Check for significant tilt
