def updated_strategy(observation):
    cart_position, cart_velocity, pole_angle_1, pole_angle_2, pole_angular_velocity_1, pole_angular_velocity_2 = observation

    # Define thresholds for angle and angular velocity
    angle_threshold_1 = 0.2
    angle_threshold_2 = 0.2
    angular_velocity_threshold_1 = 1.0
