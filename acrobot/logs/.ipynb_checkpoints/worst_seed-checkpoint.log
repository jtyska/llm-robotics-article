def updated_strategy(observation):
    cart_position, cart_velocity, pole_angle, pole_angular_velocity = observation[:4]
    
    # Define thresholds for decision-making
    angle_threshold = 0.2
    angular_velocity_threshold = 1.0
    
    # Check if the pole is nearly upright and stable
    if abs(pole_angle) < angle_threshold and abs(pole_angular_velocity) < angular_velocity_threshold:
        return 1  # Do nothing to maintain balance
    
    # Check if the pole is tilting to the right
    if pole_angle > angle_threshold or (pole_angle > 0 and pole_angular_velocity > angular_velocity_threshold):
        return 0  # Move cart to the right
    
    # Check if the pole is tilting to the left
    if pole_angle < -angle_threshold or (pole_angle < 0 and pole_angular_velocity < -angular_velocity_threshold):
        return 2  # Move cart to the left
    
    # If the cart is too far to the right, move it to the left
    if cart_position > 1.0:
        return 2  # Move cart to the left
    
    # If the cart is too far to the left, move it to the right
    if cart_position < -1.0:
        return 0  # Move cart to the right
    
    # Default action: do nothing
    return 1

