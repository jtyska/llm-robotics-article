def new_strategy(observation):
    cart_position, cart_velocity, pole_angle, pole_velocity_at_tip = observation

    if abs(pole_angle) < 0.05 and abs(cart_velocity) < 0.2:
        action = 0 if pole_angle > 0 else 1
    elif abs(pole_angle) > 0.15:
        action = 0 if pole_angle > 0 else 1
    elif cart_velocity > 0.5:
        action = 0
    elif cart_velocity < -0.5:
        action = 1
    else:
        action = 0 if pole_angle > 0 else 1

    return action
```

