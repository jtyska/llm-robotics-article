def improved_strategy(observation):
    # Unpack the observation
    cart_position, cart_velocity, pole_angle, pole_angular_velocity, _ = observation

    # Define thresholds for different states
    angle_threshold = 0.2
    velocity_threshold = 1.0
    position_threshold = 2.4

    # Rule-based actions
    if abs(pole_angle) > angle_threshold:
        # Pole is leaning too much to the left or right
        return 0 if pole_angular_velocity > 0 else 2
    elif abs(cart_position) > position_threshold:
        # Cart is moving too far to the left or right
        return 0 if cart_position > 0 else 2
    elif abs(cart_velocity) > velocity_threshold:
        # Cart velocity is too high
        return 0 if cart_velocity > 0 else 2
    else:
        # Maintain balance with small adjustments
        return 0 if pole_angular_velocity > 0 else 2

