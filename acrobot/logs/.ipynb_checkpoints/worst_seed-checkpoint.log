    if abs(pole_angle_1) > angle_threshold_1 or abs(pole_angular_velocity_1) > angular_velocity_threshold_1:
        if pole_angle_1 > 0 and pole_angular_velocity_1 < -angular_velocity_threshold_1:
            action = 2  # Move cart to the left
        elif pole_angle_1 < 0 and pole_angular_velocity_1 > angular_velocity_threshold_1:
