```python
def new_strategy(observation):
    cart_position, pole1_angle, pole2_angle, cart_velocity, pole1_angular_velocity, pole2_angular_velocity = observation
    
    # Define thresholds for angles and angular velocities
    angle_threshold = 0.2
    angular_velocity_threshold = 5.0
    
    # Check if the poles are within a stable range
    if abs(pole1_angle) < angle_threshold and abs(pole2_angle) < angle_threshold:
        # Poles are balanced, no need to move
        return 1  # Do nothing (middle action)
    
    # Check for high angular velocities
    if pole1_angular_velocity > angular_velocity_threshold or pole2_angular_velocity > angular_velocity_threshold:
        # High positive angular velocity, move in the opposite direction
        return 0 if cart_velocity < 0 else 2
    
    if pole1_angular_velocity < -angular_velocity_threshold or pole2_angular_velocity < -angular_velocity_threshold:
        # High negative angular velocity, move in the same direction
        return 0 if cart_velocity > 0 else 2
    
    # Check for significant tilt
    if pole1_angle > angle_threshold or pole2_angle > angle_threshold:
        # Tilted to the right, move left
        return 0
    
    if pole1_angle < -angle_threshold or pole2_angle < -angle_threshold:
        # Tilted to the left, move right
        return 2
    
    # Default action (do nothing)
    return 1

# Example usage
observation = [0.811, 0.585, 0.783, -0.622, 1.021, -9.611]
