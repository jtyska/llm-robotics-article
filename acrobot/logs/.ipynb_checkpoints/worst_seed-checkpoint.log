def new_strategy(observation):
    cos_theta1, sin_theta1, cos_theta2, sin_theta2, theta_dot1, theta_dot2 = observation

    # Calculate angles from sine and cosine values
    angle1 = np.arctan2(sin_theta1, cos_theta1)
    angle2 = np.arctan2(sin_theta2, cos_theta2)

    # Define dynamic thresholds based on the current state
    angle_threshold = 0.3 * (1 + abs(theta_dot1) / 10)
    velocity_threshold = 5

    # Weighted decision-making
    weighted_angle1 = angle1 * (1 + abs(theta_dot1) / 10)
    weighted_angle2 = angle2 * (1 + abs(theta_dot2) / 10)

    if weighted_angle1 > angle_threshold or weighted_angle2 > angle_threshold:
        return 2  # Move cart to the left
    elif weighted_angle1 < -angle_threshold or weighted_angle2 < -angle_threshold:
        return 0  # Move cart to the right
    else:
        # If within thresholds, use velocity to make a decision
        if theta_dot1 > velocity_threshold or theta_dot2 > velocity_threshold:
            return 2  # Move cart to the left
        elif theta_dot1 < -velocity_threshold or theta_dot2 < -velocity_threshold:
            return 0  # Move cart to the right
        else:
            return 1  # No action (neutral)

# Example usage
