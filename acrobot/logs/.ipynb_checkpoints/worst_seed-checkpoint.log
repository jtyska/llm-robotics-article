    # Define thresholds for different conditions
    angle_threshold = 0.3
    velocity_threshold = 0.5
    
    if abs(theta1) > angle_threshold or abs(theta2) > angle_threshold:
        if theta1 < 0 and theta2 < 0:
            return 2  # Move right
        else:
            return 0  # Move left
    elif cart_velocity > velocity_threshold:
        return 2  # Move right to slow down
    elif cart_velocity < -velocity_threshold:
        return 0  # Move left to speed up
    elif pole_angular_velocity > 1.5:
        if theta1 < 0 and theta2 < 0:
            return 2  # Move right to counteract high angular velocity
        else:
            return 0  # Move left
    else:
        if cart_velocity >= 0:
            return 0  # Move left to balance
        else:
            return 2  # Move right to balance

