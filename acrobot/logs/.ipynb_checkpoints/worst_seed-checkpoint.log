import numpy as np

def improved_strategy(observation):
    cos_theta1, sin_theta1, cos_theta2, sin_theta2, angular_velocity1, angular_velocity2 = observation

    theta1 = np.arctan2(sin_theta1, cos_theta1)
    theta2 = np.arctan2(sin_theta2, cos_theta2)

    # Define thresholds for angles and angular velocities
    angle_threshold = 0.1
    angular_velocity_threshold = 0.5

    # Check if either pole is significantly tilted or moving quickly
    if (abs(theta1) > angle_threshold or abs(angular_velocity1) > angular_velocity_threshold):
        if theta1 > 0:
            action = 2  # Move right to correct positive tilt/velocity
        else:
            action = 0  # Move left to correct negative tilt/velocity
    elif (abs(theta2) > angle_threshold or abs(angular_velocity2) > angular_velocity_threshold):
        if theta2 > 0:
            action = 2  # Move right to correct positive tilt/velocity
        else:
            action = 0  # Move left to correct negative tilt/velocity
    else:
        action = 1  # No action (maintain balance)

    return action
```

