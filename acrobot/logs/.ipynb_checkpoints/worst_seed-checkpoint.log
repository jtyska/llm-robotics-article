def new_balancing_strategy(observation):
    cart_position, cart_velocity, pole_angle, pole_angular_velocity = observation
    
    # Define thresholds for angle and angular velocity
    small_angle_threshold = 0.15
    large_angle_threshold = 0.3
    angular_velocity_threshold = 1.0
    
    # Angle-based control
    if abs(pole_angle) > large_angle_threshold:
        return 2 if pole_angle < 0 else 0  # Strong correction for large angles
    elif abs(pole_angle) > small_angle_threshold:
        return 2 if pole_angle < 0 else 0  # Mild correction for small angles
    
    # Velocity-based adjustments
    if abs(pole_angular_velocity) > angular_velocity_threshold:
        return 2 if pole_angular_velocity < 0 else 0  # Adjust based on velocity
    
    # Default action to maintain balance
    return 1  # Do nothing or a mild correction

