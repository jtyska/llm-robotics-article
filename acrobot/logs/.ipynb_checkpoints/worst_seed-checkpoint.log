import random

def get_action(cos_theta1, sin_theta1, cos_theta2, sin_theta2, ang_vel_theta1, ang_vel_theta2):
    angle_threshold = 0.4
    velocity_threshold = 1.5
    cart_velocity_threshold = 1.0
    
    theta1 = math.acos(cos_theta1) if sin_theta1 >= 0 else -math.acos(cos_theta1)
    theta2 = math.acos(cos_theta2) if sin_theta2 >= 0 else -math.acos(cos_theta2)
    
    if abs(theta1) > angle_threshold or abs(ang_vel_theta1) > velocity_threshold:
        action = 2 if theta1 < 0 else 0
    elif abs(theta2) > angle_threshold or abs(ang_vel_theta2) > velocity_threshold:
        action = 2 if theta2 < 0 else 0
    elif abs(ang_vel_theta1) + abs(ang_vel_theta2) > 2 * velocity_threshold:
        action = 2 if (ang_vel_theta1 < 0 and ang_vel_theta2 < 0) else 0
    elif cos_theta1 < -cart_velocity_threshold or cos_theta2 < -cart_velocity_threshold:
        action = 2
    elif cos_theta1 > cart_velocity_threshold or cos_theta2 > cart_velocity_threshold:
        action = 0
    else:
        action = 1
    
    return action if action is not None else random.randint(0, 2)

