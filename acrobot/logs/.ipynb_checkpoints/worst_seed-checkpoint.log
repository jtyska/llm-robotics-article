    force2 = -Kp2 * angle2 - Kd2 * theta_dot2
    
    # Combine forces (assuming they are additive)
    total_force = force1 + force2
    
    # Apply heuristic adjustments
    if abs(angle1) > 0.2 or abs(angle2) > 0.2:
        total_force *= 1.5  # Increase force for large angles
    
    if abs(theta_dot1) > 5 or abs(theta_dot2) > 5:
        total_force /= 1.5  # Reduce force for high angular velocities to prevent overshooting
    
    # Determine action based on total force
    if total_force < -0.1:
        return 0  # Move right
    elif total_force > 0.1:
        return 2  # Move left
    else:
        return 1  # Do nothing

