def updated_strategy(observation):
    cos_theta1, sin_theta1, cos_theta2, sin_theta2, cart_velocity, pole_angular_velocity = observation
    
    # Convert angles from sine and cosine values
    theta1 = math.atan2(sin_theta1, cos_theta1)
